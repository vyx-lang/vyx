        };
    }

    fn invalidate_materialization_resolution_caches(self) {
        self.raw_class_miss_cache = hir_name_id_map_dispose(self.raw_class_miss_cache);
        self.member_decl_miss_cache = hir_pair_id_map_dispose(self.member_decl_miss_cache);
        self.concrete_method_decl_miss_static = hir_pair_id_map_dispose(self.concrete_method_decl_miss_static);
        self.concrete_method_decl_miss_instance = hir_pair_id_map_dispose(self.concrete_method_decl_miss_instance);
        self.interface_decl_cache = hir_raw_name_map_dispose(self.interface_decl_cache);
        self.interface_decl_miss_cache = hir_name_id_map_dispose(self.interface_decl_miss_cache);
        self.raw_method_call_decl_cache = hir_pair_raw_map_dispose(self.raw_method_call_decl_cache);
        self.raw_method_call_decl_miss_cache = hir_pair_id_map_dispose(self.raw_method_call_decl_miss_cache);
        self.raw_method_overload_count_cache = hir_pair_id_map_dispose(self.raw_method_overload_count_cache);
        self.owner_method_overload_cache = hir_pair_id_map_dispose(self.owner_method_overload_cache);
        self.raw_method_lookup_cache = hir_pair_raw_map_dispose(self.raw_method_lookup_cache);
        self.raw_method_lookup_miss_cache = hir_pair_id_map_dispose(self.raw_method_lookup_miss_cache);
        self.dyn_trait_impl_materialized_cache = hir_pair_id_map_dispose(self.dyn_trait_impl_materialized_cache);
        self.dyn_trait_satisfaction_cache = hir_pair_id_map_dispose(self.dyn_trait_satisfaction_cache);
    }

    public fn reset_materialization_scoped_caches(self) {
        self.invalidate_materialization_resolution_caches();
        vyx_rt_heap_trim();
    }

    public fn release_codegen_state(self) {
        self.reset_materialization_scoped_caches();
        self.decl_map = hir_pointer_map_dispose(self.decl_map);
        self.class_instances = hir_decl_instance_map_dispose(self.class_instances);
        self.field_instances = hir_decl_instance_map_dispose(self.field_instances);
        self.variant_instances = hir_decl_instance_map_dispose(self.variant_instances);
        self.member_value_instances = hir_decl_instance_map_dispose(self.member_value_instances);
        self.function_instances = hir_decl_instance_map_dispose(self.function_instances);
        self.type_ref_env_ids = hir_decl_instance_map_dispose(self.type_ref_env_ids);
        self.concrete_type_ready = hir_string_set_dispose(self.concrete_type_ready);
        self.raw_class_exact = hir_raw_name_map_dispose(self.raw_class_exact);
        self.raw_class_template = hir_raw_name_map_dispose(self.raw_class_template);
        self.raw_class_concrete = hir_raw_name_map_dispose(self.raw_class_concrete);
        self.raw_class_scan_cache = hir_raw_name_map_dispose(self.raw_class_scan_cache);
        self.raw_class_scan_stamp = hir_name_id_map_dispose(self.raw_class_scan_stamp);
        self.raw_template_scan_cache = hir_raw_name_map_dispose(self.raw_template_scan_cache);
        self.raw_template_scan_stamp = hir_name_id_map_dispose(self.raw_template_scan_stamp);
        self.registered_type_atoms = hir_string_set_dispose(self.registered_type_atoms);
        self.method_function_index = hir_pair_id_map_dispose(self.method_function_index);
        self.field_index = hir_pair_id_map_dispose(self.field_index);
        self.free_function_index = hir_name_id_map_dispose(self.free_function_index);
        self.value_item_index = hir_name_id_map_dispose(self.value_item_index);
        self.closed_method_instance_index = hir_pair_id_map_dispose(self.closed_method_instance_index);
        self.owner_method_overload_cache = hir_pair_id_map_dispose(self.owner_method_overload_cache);
        self.raw_method_call_decl_cache = hir_pair_raw_map_dispose(self.raw_method_call_decl_cache);
        self.raw_method_call_decl_miss_cache = hir_pair_id_map_dispose(self.raw_method_call_decl_miss_cache);
        self.raw_method_overload_count_cache = hir_pair_id_map_dispose(self.raw_method_overload_count_cache);
        self.raw_method_lookup_cache = hir_pair_raw_map_dispose(self.raw_method_lookup_cache);
        self.raw_method_lookup_miss_cache = hir_pair_id_map_dispose(self.raw_method_lookup_miss_cache);
        self.dyn_trait_impl_materialized_cache = hir_pair_id_map_dispose(self.dyn_trait_impl_materialized_cache);
        self.dyn_trait_satisfaction_cache = hir_pair_id_map_dispose(self.dyn_trait_satisfaction_cache);
        self.interface_decl_cache = hir_raw_name_map_dispose(self.interface_decl_cache);
        self.interface_decl_miss_cache = hir_name_id_map_dispose(self.interface_decl_miss_cache);
        self.type_alias_decl_cache = hir_raw_name_map_dispose(self.type_alias_decl_cache);
        self.type_alias_decl_miss_cache = hir_name_id_map_dispose(self.type_alias_decl_miss_cache);
        self.function_open_cache = hir_i32_array_map_dispose(self.function_open_cache);
        self.type_id_open_no_env_cache = hir_i32_array_map_dispose(self.type_id_open_no_env_cache);
        self.function_type_cache = hir_int_id_map_dispose(self.function_type_cache);
        self.zero_arg_function_type_cache = hir_int_id_map_dispose(self.zero_arg_function_type_cache);
        self.type_text_id_cache = hir_name_id_map_dispose(self.type_text_id_cache);
        self.type_ref_close_cache = hir_decl_instance_map_dispose(self.type_ref_close_cache);
        self.template_body_cache = hir_raw_int_map_dispose(self.template_body_cache);
        self.template_members_cache = hir_raw_int_map_dispose(self.template_members_cache);
        self.template_param_cache = hir_decl_instance_map_dispose(self.template_param_cache);
        self.callable_borrow_cache = hir_raw_int_map_dispose(self.callable_borrow_cache);
        self.decl_self_member_call_cache = hir_raw_int_map_dispose(self.decl_self_member_call_cache);
        self.class_inherits_cache = hir_raw_pair_int_map_dispose(self.class_inherits_cache);
        self.class_parent_cache = hir_raw_owner_map_dispose(self.class_parent_cache);
        self.method_owner_decl_cache = hir_raw_pair_raw_map_dispose(self.method_owner_decl_cache);
        self.direct_method_function_cache = hir_raw_pair_int_map_dispose(self.direct_method_function_cache);
        self.param_raw_move_cache = hir_decl_instance_map_dispose(self.param_raw_move_cache);
        self.materialized_type_ids = hir_int_id_map_dispose(self.materialized_type_ids);
        self.materialized_function_ids = hir_int_id_map_dispose(self.materialized_function_ids);
        self.scheduled_function_ids = hir_int_id_map_dispose(self.scheduled_function_ids);
        self.codegen_body_done_ids = hir_int_id_map_dispose(self.codegen_body_done_ids);
        self.decl_owner_map = hir_raw_owner_map_dispose(self.decl_owner_map);
        self.type_ref_ids = hir_raw_type_id_map_dispose(self.type_ref_ids);
        self.locals = hir_local_scope_dispose(self.locals);
        self.pack_bindings = hir_pack_bindings_dispose(self.pack_bindings);
        self.capture_source_head = null;
        self.body_building_head = null;
        self.reachable_body_queue_head = null;
        self.reachable_body_queue_tail = null;
        self.current_generic_params = "";
        self.current_generic_args = "";
        self.source_unit = null;
        vyx_rt_heap_trim();
    }

    fn body_building(self, fn_id: i32) -> bool {
        if (fn_id == hir_id_invalid()) { return false; }
        var cur = self.body_building_head;
        while (cur != null) {
            if (ast_read_i32(ptr_offset(cur, 8)) == fn_id) { return true; }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return false;
    }

    fn push_body_building(self, d: rawptr, fn_id: i32) {
        let node = hir_profile_malloc(24);
        if (node == null) { return; }
        memset(node, 0, 24);
        ast_write_rawptr(node, d);
        ast_write_i32(ptr_offset(node, 8), fn_id);
        ast_write_rawptr(ptr_offset(node, 16), self.body_building_head);
        self.body_building_head = node;
    }

    fn concrete_type_ref(self, ty: rawptr) -> rawptr {
        self.profile_concrete_type_ref_calls = self.profile_concrete_type_ref_calls + 1;
        if (ty == null) { return null; }
        if (self.current_generic_params.len == 0 || self.current_generic_args.len == 0) {
            return ty;
        }
        let inferred = self.inference_type_text_from_ref_env(ty,
                                                             self.current_generic_params,
                                                             self.current_generic_args);
        if (inferred.len > 0) {
            let self_binding = self.current_generic_binding("Self");
            if (self_binding.len > 0
                && policy_generic_call_args(self_binding).len > 0
                && policy_generic_call_args(inferred).len == 0
                && policy_type_name_equal(inferred, policy_generic_call_base(self_binding))) {
                return self.type_ref_from_text(self_binding);
            }
            return self.type_ref_from_text(inferred);
        }
        let concrete = sema_substitute_type_with_args(ty,
                                                     self.current_generic_params,
                                                     self.current_generic_args);
        if (concrete != null && tref_get_kind(concrete) == ty_CLASS()) {
            let name = tref_get_name(concrete);
            let self_binding = self.current_generic_binding("Self");
            if (self_binding.len > 0
                && policy_generic_call_args(self_binding).len > 0
                && policy_generic_call_args(name).len == 0
                && policy_type_name_equal(name, policy_generic_call_base(self_binding))) {
                return tref_alloc(ty_CLASS(), self_binding);
            }
        }
        return concrete;
    }

    fn type_ref_closes_in_current_env(self, ty: rawptr) -> bool {
        if (ty == null) { return true; }
        var key = hir_builder_env_key(self.current_generic_params, self.current_generic_args);
        if (key.len == 0) { key = "#"; }
        let cached = hir_decl_instance_map_item(self.type_ref_close_cache,ty, key);
        if (cached == 1) { return false; }
        if (cached == 2) { return true; }
        let concrete_text = self.type_text_from_ref_env(ty, self.current_generic_params, self.current_generic_args);
        var out = false;
        if (concrete_text.len > 0) {
            out = !self.type_text_has_open_template_atom(concrete_text);
        } else {
            let concrete = self.concrete_type_ref(ty);
            out = !hir_builder_type_ref_has_template_atom(concrete);
        }
        if (out) {
            self.type_ref_close_cache = hir_decl_instance_map_put(self.type_ref_close_cache,ty, key, 2, hir_id_invalid());
        } else {
            self.type_ref_close_cache = hir_decl_instance_map_put(self.type_ref_close_cache,ty, key, 1, hir_id_invalid());
        }
        return out;
    }

    fn generic_expr_name_closes_in_current_env(self, name: string) -> bool {
        if (name.len == 0) { return true; }
        let args = policy_generic_call_args(name.clone());
        if (args.len == 0) {
            return !self.type_text_has_open_template_atom(name);
        }
        var i: i32 = 0;
        while (i < 64) {
            let raw_arg = policy_generic_arg_at(args, i);
            if (raw_arg.len == 0) { return true; }
            let resolved_arg = self.resolve_type_text_in_current_env(raw_arg);
            if (resolved_arg.len == 0 || self.type_text_has_open_template_atom(resolved_arg)) {
                return false;
            }
            i = i + 1;
        }
        return true;
    }

    fn expr_is_variadic_pack_ident(self, e: rawptr) -> bool {
        if (e == null || expr_get_kind(e) != ex_IDENT()) { return false; }
        return expr_get_name(e).len > 0;
    }

    fn expr_is_variadic_pack_fold(self, e: rawptr) -> bool {
        if (e == null || expr_get_kind(e) != ex_IDENT()) { return false; }
        return self.pack_fold_op(expr_get_name(e)) != 0;
    }

    fn expr_is_variadic_pack_member(self, e: rawptr) -> bool {
        if (e == null || expr_get_kind(e) != ex_MEMBER()) { return false; }
        let member = expr_get_name(e);
        if (member != "len" && member != "length" && member != "size") { return false; }
        return self.expr_is_variadic_pack_ident(expr_get_lhs(e));
    }

    fn expr_is_variadic_pack_index(self, e: rawptr) -> bool {
        if (e == null || expr_get_kind(e) != ex_INDEX()) { return false; }
        return self.expr_is_variadic_pack_ident(expr_get_lhs(e));
    }

    fn expr_types_close_in_current_env(self, e: rawptr) -> bool {
        if (e == null) { return true; }
        if (self.expr_is_variadic_pack_fold(e)) { return true; }
        if (self.expr_is_variadic_pack_member(e)) { return true; }
        if (self.expr_is_variadic_pack_index(e)) { return true; }
        if (!self.type_ref_closes_in_current_env(expr_get_ty(e))) { return false; }
        if (!self.generic_expr_name_closes_in_current_env(expr_get_name(e))) { return false; }
        let k = expr_get_kind(e);
        if (k == ex_BIN() || k == ex_ASSIGN() || k == ex_TERNARY()) {
            if (!self.expr_types_close_in_current_env(expr_get_lhs(e))) { return false; }
            if (!self.expr_types_close_in_current_env(expr_get_rhs(e))) { return false; }
            return self.expr_types_close_in_current_env(expr_get_args(e));
        }
        if (k == ex_UNARY()
            || k == ex_ADDR_OF()
            || k == ex_DEREF()
            || k == ex_CAST()
            || k == ex_AWAIT()
            || k == ex_COMPTIME()
            || k == ex_FAIL()) {
            return self.expr_types_close_in_current_env(expr_get_lhs(e));
        }
        if (k == ex_CALL()) {
            if (!self.expr_types_close_in_current_env(expr_get_lhs(e))) { return false; }
            return self.stmt_chain_types_close_in_current_env(expr_get_args(e));
        }
        if (k == ex_MEMBER()) {
            return self.expr_types_close_in_current_env(expr_get_lhs(e));
        }
        if (k == ex_INDEX()) {
            if (!self.expr_types_close_in_current_env(expr_get_lhs(e))) { return false; }
            return self.expr_types_close_in_current_env(expr_get_rhs(e));
        }
        if (k == ex_STRUCT_INIT()
            || k == ex_FSTRING()
            || k == ex_TUPLE_LIT()
            || k == ex_INLINE_ASM()) {
            return self.stmt_chain_types_close_in_current_env(expr_get_args(e));
        }
        if (k == ex_ARRAY_LIT()) {
            if (!self.stmt_chain_types_close_in_current_env(expr_get_args(e))) { return false; }
            return self.expr_types_close_in_current_env(expr_get_captures(e));
        }
        if (k == ex_CLOSURE()) {
            if (!self.stmt_chain_types_close_in_current_env(expr_get_captures(e))) { return false; }
            if (!self.stmt_chain_types_close_in_current_env(expr_get_lhs(e))) { return false; }
            return self.type_ref_closes_in_current_env(expr_get_rhs(e));
        }
        if (k == ex_IF_EXPR() || k == ex_MATCH_EXPR()) {
            if (!self.expr_types_close_in_current_env(expr_get_lhs(e))) { return false; }
            if (k == ex_IF_EXPR()) {
                if (!self.stmt_chain_types_close_in_current_env(expr_get_rhs(e))) { return false; }
                let else_part = expr_get_args(e);
                if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
                    return self.expr_types_close_in_current_env(else_part);
                }
                return self.stmt_chain_types_close_in_current_env(else_part);
            }
            return self.stmt_chain_types_close_in_current_env(expr_get_args(e));
        }
        return true;
    }

    fn stmt_types_close_in_current_env(self, s: rawptr) -> bool {
        if (s == null) { return true; }
        let k = stmt_get_kind(s);
        if (k == st_EXPR()) {
            return self.expr_types_close_in_current_env(stmt_get_init(s));
        }
        if (k == st_LET() || k == st_VAR()) {
            if (!self.type_ref_closes_in_current_env(stmt_get_ty(s))) { return false; }
            return self.expr_types_close_in_current_env(stmt_get_init(s));
        }
        if (k == st_RETURN()) {
            return self.expr_types_close_in_current_env(stmt_get_init(s));
        }
        if (k == st_IF()) {
            if (!self.expr_types_close_in_current_env(stmt_get_cond(s))) { return false; }
            if (!self.stmt_types_close_in_current_env(stmt_get_then_blk(s))) { return false; }
            return self.stmt_types_close_in_current_env(stmt_get_else_blk(s));
        }
        if (k == st_WHILE()) {
            if (!self.expr_types_close_in_current_env(stmt_get_cond(s))) { return false; }
            return self.stmt_types_close_in_current_env(stmt_get_body(s));
        }
        if (k == st_BLOCK()) {
            return self.stmt_chain_types_close_in_current_env(stmt_get_body(s));
        }
        if (k == st_FOR()) {
            if (!self.stmt_types_close_in_current_env(stmt_get_init(s))) { return false; }
            if (!self.expr_types_close_in_current_env(stmt_get_cond(s))) { return false; }
            if (!self.stmt_types_close_in_current_env(stmt_get_then_blk(s))) { return false; }
            return self.stmt_types_close_in_current_env(stmt_get_body(s));
        }
        if (k == st_FOREACH()) {
            if (!self.type_ref_closes_in_current_env(stmt_get_ty(s))) { return false; }
            if (!self.expr_types_close_in_current_env(stmt_get_cond(s))) { return false; }
            return self.stmt_types_close_in_current_env(stmt_get_body(s));
        }
        if (k == st_MATCH()) {
            if (!self.expr_types_close_in_current_env(stmt_get_init(s))) { return false; }
            var arm = stmt_get_body(s);
            while (arm != null) {
                if (!self.expr_types_close_in_current_env(stmt_get_init(arm))) { return false; }
                if (!self.expr_types_close_in_current_env(stmt_get_cond(arm))) { return false; }
                if (!self.stmt_types_close_in_current_env(stmt_get_body(arm))) { return false; }
                arm = stmt_get_next(arm);
            }
            return true;
        }
        if (k == st_DEFER()) {
            return self.stmt_types_close_in_current_env(stmt_get_init(s));
        }
        if (k == st_STATIC_ASSERT()) {
            return self.expr_types_close_in_current_env(stmt_get_cond(s));
        }
        return true;
    }

    fn stmt_chain_types_close_in_current_env(self, head: rawptr) -> bool {
        var cur = head;
        while (cur != null) {
            if (!self.stmt_types_close_in_current_env(cur)) { return false; }
            cur = stmt_get_next(cur);
        }
        return true;
    }

    fn decl_body_types_close_in_current_env_uncached(self, d: rawptr) -> bool {
        if (d == null) { return true; }
        if (!self.type_ref_closes_in_current_env(decl_get_ty(d))) { return false; }
        var param = decl_get_params(d);
        while (param != null) {
            if (hir_builder_variadic_param(param)) {
                let pack_name = hir_builder_param_pack_type_name(param);
                if (self.current_pack_count(pack_name) > 0
                    && !self.type_ref_closes_in_current_env(decl_get_ty(param))) {
                    return false;
                }
            } else if (!self.type_ref_closes_in_current_env(decl_get_ty(param))) {
                return false;
            }
            param = decl_get_next(param);
        }
        return self.stmt_chain_types_close_in_current_env(decl_get_body(d));
    }

    fn decl_body_types_close_in_current_env(self, d: rawptr) -> bool {
        if (d == null) { return true; }
        var key = hir_builder_env_key(self.current_generic_params, self.current_generic_args);
        if (key.len == 0) { key = "#"; }
        let cached = hir_decl_instance_map_item(self.decl_body_close_cache,d, key);
        if (cached == 1) { return false; }
        if (cached == 2) { return true; }
        let out = self.decl_body_types_close_in_current_env_uncached(d);
        if (out) {
            self.decl_body_close_cache = hir_decl_instance_map_put(self.decl_body_close_cache,d, key, 2, hir_id_invalid());
        } else {
            self.decl_body_close_cache = hir_decl_instance_map_put(self.decl_body_close_cache,d, key, 1, hir_id_invalid());
        }
        return out;
    }

    fn decl_body_has_template_type(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        let cached = hir_raw_int_map_get(self.template_body_cache,d);
        if (cached == 1) { return false; }
        if (cached == 2) { return true; }
        let out = hir_builder_decl_body_has_template_type(d);
        if (out) {
            self.template_body_cache = hir_raw_int_map_put(self.template_body_cache,d, 2);
        } else {
            self.template_body_cache = hir_raw_int_map_put(self.template_body_cache,d, 1);
        }
        return out;
    }

    fn decl_contains_template_param(self, d: rawptr, param: string) -> bool {
        if (d == null || param.len == 0) { return false; }
        let cached = hir_decl_instance_map_item(self.template_param_cache,d, param);
        if (cached == 1) { return false; }
        if (cached == 2) { return true; }
        let out = hir_builder_decl_contains_template_param(d, param);
        if (out) {
            self.template_param_cache = hir_decl_instance_map_put(self.template_param_cache,d, param, 2, hir_id_invalid());
        } else {
            self.template_param_cache = hir_decl_instance_map_put(self.template_param_cache,d, param, 1, hir_id_invalid());
        }
        return out;
    }

    fn decl_signature_has_template_type(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        if (hir_builder_decl_template_head(d)) { return true; }
        if (hir_builder_type_ref_has_template_atom(decl_get_ty(d))) { return true; }
        var param = decl_get_params(d);
        while (param != null) {
            if (hir_builder_type_ref_has_template_atom(decl_get_ty(param))) { return true; }
            param = decl_get_next(param);
        }
        let k = decl_get_kind(d);
        if (k == de_CLASS() || k == de_ENUM()) {
            return self.decl_members_have_template_type(d);
        }
        return false;
    }

    fn decl_effectively_imported(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        if (hir_builder_decl_imported(d)) { return true; }
        var owner = hir_raw_owner_map_get(self.decl_owner_map,d);
        while (owner != null) {
            if (hir_builder_decl_imported(owner)) { return true; }
            owner = hir_raw_owner_map_get(self.decl_owner_map,owner);
        }
        return false;
    }

    fn decl_effectively_from_std_module(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        if (hir_builder_decl_from_std_module(d)) { return true; }
        var owner = hir_raw_owner_map_get(self.decl_owner_map,d);
        while (owner != null) {
            if (hir_builder_decl_from_std_module(owner)) { return true; }
            owner = hir_raw_owner_map_get(self.decl_owner_map,owner);
        }
        return false;
    }

    fn decl_effectively_project_local(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        if (hir_builder_string_contains(decl_get_meta(d), "|project-local")) { return true; }
        var owner = hir_raw_owner_map_get(self.decl_owner_map,d);
        while (owner != null) {
            if (hir_builder_string_contains(decl_get_meta(owner), "|project-local")) { return true; }
            owner = hir_raw_owner_map_get(self.decl_owner_map,owner);
        }
        return false;
    }

    fn decl_is_foreign_import(self, d: rawptr) -> bool {
        return self.decl_effectively_imported(d) && !self.decl_effectively_project_local(d);
    }

    fn imported_body_should_materialize(self, d: rawptr, body_decl: rawptr) -> bool {
        if (!self.materialize_imported_bodies) { return false; }
        if (hir_builder_decl_template_artifact(d)
            || hir_builder_decl_template_artifact(body_decl)) {
            // The artifact was hash-verified by sema before being admitted to
            // the imported declaration graph.  Its body is the only complete
            // definition available to a consumer and must be materialized.
            return true;
        }
        if (!self.export_root_bodies) { return true; }
        if (self.decl_effectively_project_local(d)
            || self.decl_effectively_project_local(body_decl)) {
            return true;
        }
        if (self.decl_effectively_from_std_module(d)) { return true; }
        if (self.decl_effectively_from_std_module(body_decl)) { return true; }
        return false;
    }

    fn export_root_name_allowed(self, name: string) -> bool {
        if (!self.export_root_names_specified) { return true; }
        if (name.len == 0) { return false; }
        return hir_builder_string_contains("|" + self.export_root_names + "|",
                                           "|" + name + "|");
    }

    fn export_root_base_matches_name(self, root_name: string, name: string) -> bool {
        if (root_name.len == 0 || name.len == 0) { return false; }
        if (root_name == name) { return true; }
        let base = policy_generic_call_base(root_name.clone());
        if (base == name) { return true; }
        return hir_builder_last_path_segment(base) == hir_builder_last_path_segment(name);
    }

    fn export_root_decl_template_params(self, d: rawptr) -> string {
        if (d == null) { return ""; }
        var params = hir_builder_decl_template_params(d);
        if (params.len > 0) { return params; }
        let body_decl = self.raw_function_body_decl_for(d);
        if (body_decl != null
            && (decl_get_kind(body_decl) == de_FN()
                || decl_get_kind(body_decl) == de_METHOD())) {
            params = hir_builder_decl_template_params(body_decl);
        }
        if (params.len > 0) { return params; }
        return hir_builder_inferred_decl_template_params_except(d, "");
    }

    fn materialize_exported_generic_root_instances_for_decl(self, d: rawptr) {
        if (!self.export_root_names_specified || d == null) { return; }
        let kind = decl_get_kind(d);
        if (kind != de_FN() && kind != de_METHOD()) { return; }
        if (decl_get_body(d) == null) {
            let body_decl = self.raw_function_body_decl_for(d);
            if (body_decl == null || decl_get_body(body_decl) == null) { return; }
        }
        let name = decl_get_name(d);
        let owner_decl = hir_raw_owner_map_get(self.decl_owner_map,d);
        var owner_type = "";
        if (owner_decl != null) {
            owner_type = decl_get_name(owner_decl);
        }
        var start: i32 = 0;
        var i: i32 = 0;
        while (i <= self.export_root_names.len) {
            if (i == self.export_root_names.len || self.export_root_names.charAt(i) == 124) {
                let root_name = self.export_root_names.substring(start, i);
                let root_args = policy_generic_call_args(root_name.clone());
                if (root_args.len > 0 && self.export_root_base_matches_name(root_name, name)) {
                    let params = self.export_root_decl_template_params(d);
                    if (params.len > 0) {
                        let fn_id = self.ensure_function_instance(d, owner_decl, owner_type, params, root_args);
                        if (fn_id != hir_id_invalid()) {
                            self.unit.add_function_flags(fn_id, hir_function_flag_codegen_root());
                        }
                    }
                }
                start = i + 1;
            }
            i = i + 1;
        }
    }

    fn decl_members_have_template_type(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        let cached = hir_raw_int_map_get(self.template_members_cache,d);
        if (cached == 1) { return false; }
        if (cached == 2) { return true; }
        var member = decl_get_members(d);
        while (member != null) {
            if (self.decl_signature_has_template_type(member)) {
                self.template_members_cache = hir_raw_int_map_put(self.template_members_cache,d, 2);
                return true;
            }
            member = decl_get_next(member);
        }
        self.template_members_cache = hir_raw_int_map_put(self.template_members_cache,d, 1);
        return false;
    }

    fn remember_type_ref_id(self, ty: rawptr, env_key: string, type_id: i32) -> i32 {
        if (ty == null || type_id == hir_id_invalid()) { return type_id; }
        if (env_key.len == 0) {
            self.type_ref_ids = hir_raw_type_id_map_put(self.type_ref_ids,ty, type_id);
        } else {
            self.type_ref_env_ids = hir_decl_instance_map_put(self.type_ref_env_ids,ty, env_key, type_id, hir_id_invalid());
        }
        return type_id;
    }

    fn cached_type_ref_id(self, ty: rawptr, env_key: string) -> i32 {
        if (ty == null) { return hir_id_invalid(); }
        if (env_key.len == 0) {
            return hir_raw_type_id_map_get(self.type_ref_ids,ty);
        }
        return hir_decl_instance_map_item(self.type_ref_env_ids,ty, env_key);
    }

    fn type_id_from_applied_alias(self, alias_decl: rawptr, applied_name: string) -> i32 {
        if (alias_decl == null) { return hir_id_invalid(); }
        let target = decl_get_ty(alias_decl);
        if (target == null) { return hir_id_invalid(); }
        let gp = hir_builder_generic_head(decl_get_generic_params(alias_decl));
        let args = policy_generic_call_args(applied_name.clone());
        if (gp.len > 0 && args.len > 0) {
            return self.type_id_from_ref_env(target, gp, args);
        }
        return self.type_id_from_ref(target);
    }

    fn type_id_from_ref(self, ty: rawptr) -> i32 {
        self.profile_type_id_ref_calls = self.profile_type_id_ref_calls + 1;
        if (ty == null) { return hir_id_invalid(); }
        let env_key = hir_builder_env_key(self.current_generic_params, self.current_generic_args);
        let cached_id = self.cached_type_ref_id(ty, env_key);
        if (cached_id != hir_id_invalid()) { return cached_id; }
        if (self.current_generic_params.len > 0 && self.current_generic_args.len > 0) {
            let inferred = self.inference_type_text_from_ref_env(ty,
                                                                  self.current_generic_params,
                                                                  self.current_generic_args);
            if (inferred.len > 0) {
                let self_binding = self.current_generic_binding("Self");
                if (self_binding.len > 0
                    && policy_generic_call_args(self_binding).len > 0
                    && policy_generic_call_args(inferred).len == 0
                    && policy_type_name_equal(inferred, policy_generic_call_base(self_binding))) {
                    return self.remember_type_ref_id(ty, env_key, self.type_id_from_text(self_binding));
                }
                return self.remember_type_ref_id(ty, env_key, self.type_id_from_text(inferred));
            }
        }
        if (tref_get_kind(ty) == ty_CLASS()) {
            let name = tref_get_name(ty);
            let resolved = self.resolve_type_text_in_current_env(name);
            if (resolved.len > 0 && resolved != name) {
                let resolved_alias = self.find_type_alias_decl(resolved);
                if (resolved_alias != null && decl_get_ty(resolved_alias) != null) {
                    return self.remember_type_ref_id(ty, env_key, self.type_id_from_applied_alias(resolved_alias, resolved));
                }
                return self.remember_type_ref_id(ty, env_key, self.type_id_from_text(resolved));
            }
            let alias_decl_fast = self.find_type_alias_decl(name);
            if (alias_decl_fast != null && decl_get_ty(alias_decl_fast) != null) {
                let alias_text_fast = self.type_name_for_ref(decl_get_ty(alias_decl_fast));
                if (alias_text_fast.len > 0 && alias_text_fast != name) {
                    return self.remember_type_ref_id(ty, env_key, self.type_id_from_applied_alias(alias_decl_fast, name));
                }
            }
        }
        let concrete = self.concrete_type_ref(ty);
        var out_id = hir_id_invalid();
        if (concrete != null && tref_get_kind(concrete) == ty_CLASS()) {
            let name = tref_get_name(concrete);
            let resolved = self.resolve_type_text_in_current_env(name);
            if (resolved.len > 0 && resolved != name) {
                let resolved_alias = self.find_type_alias_decl(resolved);
                if (resolved_alias != null && decl_get_ty(resolved_alias) != null) {
                    out_id = self.type_id_from_applied_alias(resolved_alias, resolved);
                    return self.remember_type_ref_id(ty, env_key, out_id);
                }
                out_id = self.type_id_from_text(resolved);
                return self.remember_type_ref_id(ty, env_key, out_id);
            }
            let alias_decl = self.find_type_alias_decl(name);
            if (alias_decl != null && decl_get_ty(alias_decl) != null) {
                let alias_text = self.type_name_for_ref(decl_get_ty(alias_decl));
                if (alias_text.len > 0 && alias_text != name) {
                    out_id = self.type_id_from_applied_alias(alias_decl, name);
                    return self.remember_type_ref_id(ty, env_key, out_id);
                }
            }
            let canonical_name = self.canonical_type_text_for_lookup(name, 0);
            if (canonical_name.len > 0 && canonical_name != name) {
                out_id = self.type_id_from_text(canonical_name);
                return self.remember_type_ref_id(ty, env_key, out_id);
            }
        }
        out_id = self.unit.types.intern_type_ref(concrete);
        return self.remember_type_ref_id(ty, env_key, out_id);
    }

    fn fn_type_text_close_paren(self, text: string, open_idx: i32) -> i32 {
        if (open_idx < 0 || open_idx >= text.len || text.charAt(open_idx) != 40) { return -1; }
        var depth: i32 = 0;
        var i: i32 = open_idx;
        while (i < text.len) {
            let c = text.charAt(i);
            if (c == 40) {
                depth = depth + 1;
            } elif (c == 41) {
                depth = depth - 1;
                if (depth == 0) { return i; }
                if (depth < 0) { return -1; }
            }
            i = i + 1;
        }
        return -1;
    }

    fn function_type_ref_from_text(self, text: string) -> rawptr {
        if (text.len < 6) { return null; }
        var open_idx: i32 = -1;
        var c_abi: bool = false;
        if (text.len >= 3 && text.substring(0, 3) == "fn(") {
            open_idx = 2;
        } elif (text.len >= 4 && text.substring(0, 4) == "cfn(") {
            open_idx = 3;
            c_abi = true;
        } elif (text.len >= 10 && text.substring(0, 10) == "unsafe fn(") {
            open_idx = 9;
            c_abi = true;
        }
        if (open_idx < 0) { return null; }
        let close_idx = self.fn_type_text_close_paren(text, open_idx);
        if (close_idx < 0 || close_idx + 2 >= text.len) { return null; }
        if (text.charAt(close_idx + 1) != 45 || text.charAt(close_idx + 2) != 62) { return null; }
        let params_text = text.substring(open_idx + 1, close_idx);
        let ret_text = text.substring(close_idx + 3, text.len);
        var count: i32 = 0;
        if (params_text.len > 0) {
            while (count < 256) {
                let arg = policy_generic_arg_at(params_text, count);
                if (arg.len == 0) { break; }
                count = count + 1;
            }
        }
        var buf: rawptr = null;
        if (count > 0) {
            buf = hir_profile_malloc((count * 8) as u64);
            if (buf == null) { return null; }
            memset(buf, 0, (count * 8) as u64);
            var idx: i32 = 0;
            while (idx < count) {
                let arg_text = policy_generic_arg_at(params_text, idx);
                ast_write_rawptr(ptr_offset(buf, idx * 8), self.type_ref_from_text(arg_text));
                idx = idx + 1;
            }
        }
        let params_ref = tref_alloc_tuple(buf, count as i64);
        let ret_ref = self.type_ref_from_text(ret_text);
        if (c_abi) { return tref_alloc_c_fn(params_ref, ret_ref); }
        return tref_alloc_fn(params_ref, ret_ref);
    }

    fn array_size_text_to_i64(self, size_text: string) -> i64 {
        var clean = hir_builder_trim(size_text);
        if (hir_builder_string_is_i64_lit(clean.clone())) {
            return hir_builder_parse_i64_lit(clean);
        }
        if (clean.len >= 2
            && clean.charAt(0) == 40
            && clean.charAt((clean.len - 1) as i32) == 41) {
            clean = hir_builder_trim(clean.substring(1, (clean.len - 1) as i32));
        }
        if (clean.startsWith("int ")) {
            var start: i32 = 4;
            while (start < clean.len) {
                let ch_space = clean.charAt(start);
                if (ch_space != 32 && ch_space != 9 && ch_space != 10 && ch_space != 13) { break; }
                start = start + 1;
            }
            var end = start;
            if (end < clean.len && clean.charAt(end) == 45) { end = end + 1; }
            while (end < clean.len) {
                let ch = clean.charAt(end);
                if (ch < 48 || ch > 57) {
                    return hir_builder_parse_i64_lit(clean.substring(start, end));
                }
                end = end + 1;
            }
            if (end > start) {
                let lit = clean.substring(start, end);
                if (hir_builder_string_is_i64_lit(lit.clone())) {
                    return hir_builder_parse_i64_lit(lit);
                }
            }
        }
        return -1;
    }

    fn array_type_ref_from_text(self, text: string) -> rawptr {
        let clean = hir_builder_trim(text);
        if (clean.len < 5) { return null; }
        if (clean.charAt(0) != 91 || clean.charAt((clean.len - 1) as i32) != 93) { return null; }
        var depth: i32 = 0;
        var split: i32 = -1;
        var i: i32 = 1;
        while (i < clean.len - 1) {
            let ch = clean.charAt(i);
            if (ch == 91) {
                depth = depth + 1;
            } else if (ch == 93) {
                if (depth > 0) { depth = depth - 1; }
            } else if (ch == 59 && depth == 0) {
                split = i;
                i = clean.len as i32;
            }
            i = i + 1;
        }
        if (split <= 1 || split >= clean.len - 2) { return null; }
        let elem_text = hir_builder_trim(clean.substring(1, split));
        let size_text = hir_builder_trim(clean.substring(split + 1, (clean.len - 1) as i32));
        let arr_size = self.array_size_text_to_i64(size_text.clone());
        if (elem_text.len == 0 || arr_size < 0) { return null; }
        let elem_ref = self.type_ref_from_text(elem_text);
        if (elem_ref == null) { return null; }
        return tref_alloc_array(elem_ref, arr_size);
    }

    fn canonical_array_type_text_for_lookup(self, text: string, depth: i32) -> string {
        let clean = hir_builder_trim(text);
        if (clean.len < 5) { return ""; }
        if (clean.charAt(0) != 91 || clean.charAt((clean.len - 1) as i32) != 93) { return ""; }
        var nested: i32 = 0;
        var split: i32 = -1;
        var i: i32 = 1;
        while (i < clean.len - 1) {
            let ch = clean.charAt(i);
            if (ch == 91) {
                nested = nested + 1;
            } else if (ch == 93) {
                if (nested > 0) { nested = nested - 1; }
            } else if (ch == 59 && nested == 0) {
                split = i;
                i = clean.len as i32;
            }
            i = i + 1;
        }
        if (split <= 1 || split >= clean.len - 2) { return ""; }
        let elem_text = hir_builder_trim(clean.substring(1, split));
        let size_text = hir_builder_trim(clean.substring(split + 1, (clean.len - 1) as i32));
        if (elem_text.len == 0 || size_text.len == 0) { return ""; }
        return "[" + self.canonical_type_text_for_lookup(elem_text, depth + 1)
            + ";" + size_text + "]";
    }

    fn generic_text_with_args_like(self, original: string, base: string, args: string) -> string {
        if (args.len == 0) { return base; }
        let original_base = policy_generic_call_base(original);
        if (original_base.len > 0
            && original.len > original_base.len + 1
            && original.substring(original_base.len as i32, (original_base.len + 2) as i32) == "::") {
            return base + "::<" + args + ">";
        }
        return base + "<" + args + ">";
    }

    fn canonical_type_text_for_lookup(self, text: string, depth: i32) -> string {
        if (text.len == 0 || depth > 64) { return text; }
        if (hir_builder_is_primitive_str_name(text)) { return "str"; }
        let fn_open = self.function_type_open_index(text);
        if (fn_open >= 0) {
            let fn_close = self.fn_type_text_close_paren(text, fn_open);
            if (fn_close > fn_open
                && fn_close + 2 < text.len
                && text.charAt(fn_close + 1) == 45
                && text.charAt(fn_close + 2) == 62) {
                let prefix = text.substring(0, fn_open + 1);
                let params_text = text.substring(fn_open + 1, fn_close);
                let ret_text = text.substring(fn_close + 3, text.len);
                var out_params = "";
                var idx: i32 = 0;
                while (idx < 256) {
                    let part = policy_generic_arg_at(params_text.clone(), idx);
                    if (part.len == 0) { break; }
                    out_params = hir_builder_append_csv(out_params,
                                                        self.canonical_type_text_for_lookup(part, depth + 1));
                    idx = idx + 1;
                }
                return prefix + out_params + ")->"
                    + self.canonical_type_text_for_lookup(ret_text, depth + 1);
            }
        }
        let array_text = self.canonical_array_type_text_for_lookup(text, depth + 1);
        if (array_text.len > 0) { return array_text; }
        if (policy_generic_call_has_args(text) != 0) {
            let base = policy_generic_call_base(text);
            let raw_args = policy_generic_call_args(text);
            var out_args = "";
            var arg_idx: i32 = 0;
            while (arg_idx < 256) {
                let raw_arg = policy_generic_arg_at(raw_args.clone(), arg_idx);
                if (raw_arg.len == 0) { break; }
                out_args = hir_builder_append_csv(out_args,
                                                  self.canonical_type_text_for_lookup(raw_arg, depth + 1));
                arg_idx = arg_idx + 1;
            }
            var canonical_base = base;
            let owner_decl = self.raw_class_decl_for_type_text(text);
            if (owner_decl != null) {
                let owner_name = decl_get_name(owner_decl);
                let owner_base = policy_generic_call_base(owner_name);
                if (owner_base.len > 0) { canonical_base = owner_base; }
                else if (owner_name.len > 0) { canonical_base = owner_name; }
            }
            return self.generic_text_with_args_like(text, canonical_base, out_args);
        }
        let raw_owner = self.raw_class_decl_for_type_text(text);
        if (raw_owner != null) {
            let raw_name = decl_get_name(raw_owner);
            let raw_base = policy_generic_call_base(raw_name);
            if (raw_base.len > 0) { return raw_base; }
            if (raw_name.len > 0) { return raw_name; }
        }
        return text;
    }

    fn pointer_type_ref_from_text(self, text: string) -> rawptr {
        if (policy_generic_call_has_args(text) == 0) { return null; }
        let base = policy_generic_call_base(text);
        var kind = hir_type_unknown();
        if (base == "ptr") {
            kind = ty_PTR();
        } elif (base == "ref") {
            kind = ty_REF();
        } elif (base == "mutref") {
            kind = ty_MUTREF();
        } else {
            return null;
        }
        let args = policy_generic_call_args(text);
        let pointee_text = policy_generic_arg_at(args, 0);
        if (pointee_text.len == 0 || policy_generic_arg_at(args, 1).len > 0) {
            return null;
        }
        let pointee = self.type_ref_from_text(pointee_text);
        if (pointee == null) { return null; }
        return tref_alloc_ptr_like(kind, pointee);
    }

    fn type_ref_from_text(self, text: string) -> rawptr {
        // Bounded fixed-point canonicalization: the previous self-recursion
        // had no depth cap, so a non-converging canonical form (e.g. alias
        // oscillation) recursed forever while allocating on every level.
        var canonical = text;
        var canon_round: i32 = 0;
        while (canon_round < 8) {
            let next_canonical = self.canonical_type_text_for_lookup(canonical, 0);
            if (next_canonical == canonical) { break; }
            canonical = next_canonical;
            canon_round = canon_round + 1;
        }
        if (canonical == "i32") { return tref_alloc(ty_I32(), ""); }
        if (canonical == "i64") { return tref_alloc(ty_I64(), ""); }
        if (canonical == "bool") { return tref_alloc(ty_BOOL(), ""); }
        if (canonical == "char") { return tref_alloc(ty_CHAR(), ""); }
        if (hir_builder_is_primitive_str_name(canonical)) { return tref_alloc(ty_STRING(), ""); }
        if (canonical == "rawptr") { return tref_alloc(ty_RAWPTR(), ""); }
        if (canonical == "void") { return tref_alloc(ty_VOID(), ""); }
        if (canonical == "f32") { return tref_alloc(ty_F32(), ""); }
        if (canonical == "f64") { return tref_alloc(ty_F64(), ""); }
        if (canonical == "i8") { return tref_alloc(ty_I8(), ""); }
        if (canonical == "i16") { return tref_alloc(ty_I16(), ""); }
        if (canonical == "u8") { return tref_alloc(ty_U8(), ""); }
        if (canonical == "u16") { return tref_alloc(ty_U16(), ""); }
        if (canonical == "u32") { return tref_alloc(ty_U32(), ""); }
        if (canonical == "u64") { return tref_alloc(ty_U64(), ""); }
        if (canonical == "isize") { return tref_alloc(ty_ISIZE(), ""); }
        if (canonical == "usize") { return tref_alloc(ty_USIZE(), ""); }
        let pointer_ref = self.pointer_type_ref_from_text(canonical);
        if (pointer_ref != null) { return pointer_ref; }
        let fn_ref = self.function_type_ref_from_text(canonical);
        if (fn_ref != null) { return fn_ref; }
        let array_ref = self.array_type_ref_from_text(canonical);
        if (array_ref != null) { return array_ref; }
        return tref_alloc(ty_CLASS(), canonical);
    }

    fn type_id_from_text(self, text: string) -> i32 {
        self.profile_type_id_text_calls = self.profile_type_id_text_calls + 1;
        if (text.len == 0) { return hir_id_invalid(); }
        let cached_text = hir_name_id_map_get(self.type_text_id_cache,text);
        if (cached_text != hir_id_invalid()) { return cached_text; }
        let canonical = self.canonical_type_text_for_lookup(text, 0);
        let cached = hir_name_id_map_get(self.type_text_id_cache,canonical);
        if (cached != hir_id_invalid()) { return cached; }
        let out = self.unit.types.intern_type_ref(self.type_ref_from_text(canonical));
        if (out != hir_id_invalid()) {
            self.type_text_id_cache = hir_name_id_map_put(self.type_text_id_cache,canonical, out);
            if (canonical != text) {
                self.type_text_id_cache = hir_name_id_map_put(self.type_text_id_cache,text, out);
            }
        }
        return out;
    }

    fn generic_param_index(self, name: string) -> i32 {
        if (name.len == 0) { return -1; }
        var i: i32 = 0;
        while (i < 256) {
            let p = hir_builder_generic_param_at(self.current_generic_params, i);
            if (p.len == 0) { return -1; }
            if (p == name) { return i; }
            i = i + 1;
        }
        return -1;
    }

    fn current_pack_count(self, pack_name: string) -> i32 {
        let pack_index = self.generic_param_index(pack_name);
        if (pack_index < 0) { return 0; }
        let param_count = hir_builder_generic_param_count(self.current_generic_params);
        let arg_count = hir_builder_generic_arg_count(self.current_generic_args);
        let trailing_params = param_count - pack_index - 1;
        let count = arg_count - pack_index - trailing_params;
        if (count < 0) { return 0; }
        return count;
    }

    fn current_pack_arg_text(self, pack_name: string, idx: i32) -> string {
        let pack_index = self.generic_param_index(pack_name);
        if (pack_index < 0 || idx < 0) { return ""; }
        if (idx >= self.current_pack_count(pack_name)) { return ""; }
        return policy_generic_arg_at(self.current_generic_args, pack_index + idx);
    }

    fn pack_index_type_text_in_current_env(self, text: string) -> string {
        if (text.len < 4) { return ""; }
        if (self.current_generic_params.len == 0 || self.current_generic_args.len == 0) { return ""; }
        if (text.charAt((text.len - 1) as i32) != 93) { return ""; }
        var open_idx: i32 = -1;
        var i: i32 = 0;
        while (i < text.len) {
            let ch = text.charAt(i);
            if (ch == 91) {
                if (open_idx >= 0) { return ""; }
                open_idx = i;
            } elif (ch == 93 && i != text.len - 1) {
                return "";
            }
            i = i + 1;
        }
        if (open_idx <= 0 || open_idx >= text.len - 2) { return ""; }
        let pack_name = text.substring(0, open_idx);
        if (self.generic_param_index(pack_name) < 0) { return ""; }
        let index_text = hir_builder_trim(text.substring(open_idx + 1, (text.len - 1) as i32));
        var resolved_index = index_text;
        let bound_index = self.current_generic_binding(index_text);
        if (bound_index.len > 0) { resolved_index = bound_index; }
        if (!hir_builder_string_is_i64_lit(resolved_index)) { return ""; }
        let idx_value = hir_builder_parse_i64_lit(resolved_index);
        if (idx_value < 0 || idx_value > 2147483647) { return ""; }
        let arg_text = self.current_pack_arg_text(pack_name, idx_value as i32);
        if (arg_text.len == 0) { return ""; }
        return self.resolve_type_text_in_current_env(arg_text);
    }

    fn type_id_from_expr(self, expr: rawptr) -> i32 {
        if (expr == null) { return hir_id_invalid(); }
        return self.type_id_from_ref(expr_get_ty(expr));
    }

    fn reflect_method_value_type_id_from_name(self, raw_name: string) -> i32 {
        let base = policy_generic_call_base(raw_name);
        if (base != "reflect_method_value") { return hir_id_invalid(); }
        let args = policy_generic_call_args(raw_name);
        let target_text = policy_generic_arg_at(args, 0);
        if (target_text.len == 0) { return hir_id_invalid(); }
        let resolved = self.canonical_type_text_in_current_env(target_text);
        if (resolved.len == 0) { return hir_id_invalid(); }
        return self.type_id_from_text(resolved);
    }

    fn local_type_id_from_expr(self, expr: rawptr) -> i32 {
        if (expr == null) { return hir_id_invalid(); }
        let target = expr_get_semantic_target(expr);
        let local_id = hir_local_scope_lookup_target(self.locals, target);
        if (local_id != hir_id_invalid()) { return self.unit.local_type(local_id); }
        let local_by_name = hir_local_scope_lookup(self.locals, expr_get_name(expr));
        if (local_by_name != hir_id_invalid()) { return self.unit.local_type(local_by_name); }
        let captured_id = self.ensure_capture_local(target);
        if (captured_id != hir_id_invalid()) { return self.unit.local_type(captured_id); }
        let captured_by_name = self.ensure_capture_local_by_name(expr_get_name(expr), target);
        if (captured_by_name != hir_id_invalid()) { return self.unit.local_type(captured_by_name); }
        return hir_id_invalid();
    }

    fn builtin_return_type_id(self, e: rawptr, sem_kind: i32) -> i32 {
        if (e == null || sem_kind != expr_sem_BUILTIN()) { return hir_id_invalid(); }
        let raw_name = self.builtin_name_for_expr(e);
        let name = policy_generic_call_base(raw_name.clone());
        self.note_reflection_builtin_use(name);
        if (self.builtin_string_constructor_name_recognized(name)) {
            return self.builtin_str_type_id();
        }
        let string_member_type = self.string_builtin_member_type_id(name);
        if (string_member_type != hir_id_invalid()) { return string_member_type; }
        if (name == "int_to_string" || name == "bool_to_string") {
            return self.builtin_str_type_id();
        }
        if (name == "hash" || name == "sizeof" || name == "repr_sizeof") {
            return self.type_id_from_text("i64");
        }
        if (name == "operator_eq" || name == "operator==") {
            return self.type_id_from_text("bool");
        }
        if (name == "compare") {
            return self.type_id_from_text("i32");
        }
        if (name == "argCount") {
            return self.type_id_from_text("i32");
        }
        if (name == "getArg") {
            return self.builtin_str_type_id();
        }
        if (name == "panic") {
            return self.unit.types.intern_type_ref(null);
        }
        if (name == "assert" || name == "assert_eq") {
            return self.unit.types.intern_type_ref(null);
        }
        if (name == "typeof" || name == "typeinfo" || name == "type_name"
            || name == "reflect_manifest" || name == "reflect_name") {
            return self.builtin_str_type_id();
        }
        if (name == "alignof") {
            return self.type_id_from_text("i64");
        }
        if (name == "construct") {
            let type_args = policy_generic_call_args(raw_name.clone());
            let target_type = policy_generic_arg_at(type_args, 0);
            if (target_type.len > 0) {
                let concrete_type = self.resolve_type_text_in_current_env(target_type);
                if (concrete_type.len > 0) {
                    return self.type_id_from_text(concrete_type);
                }
            }
            return hir_id_invalid();
        }
        if (name == "field_count") {
            return self.type_id_from_text("i32");
        }
        if (name == "field_name" || name == "field_type") {
            return self.builtin_str_type_id();
        }
        if (name == "reflect_method_value") {
            let value_type = self.reflect_method_value_type_id_from_name(raw_name);
            if (value_type != hir_id_invalid()) { return value_type; }
            return self.type_id_from_text("rawptr");
        }
        if (name == "reflect_method_ptr_by_id") {
            return self.type_id_from_text("rawptr");
        }
        if (name == "strlen") {
            return self.type_id_from_text("i64");
        }
        if (name == "memcmp") {
            return self.type_id_from_text("i32");
        }
        if (name == "free" || name == "ptr_write_i32" || name == "ptr_write_i64" || name == "memcpy") {
            return self.unit.types.intern_type_ref(null);
        }
        if (name == "memmove" || name == "memset" || name == "alloc" || name == "realloc" || name == "transmute") {
            return self.type_id_from_text("rawptr");
        }
        if (name == "dealloc") {
            return self.unit.types.intern_type_ref(null);
        }
        return hir_id_invalid();
    }

    fn type_id_from_expr_semantic(self, expr: rawptr, sem_kind: i32) -> i32 {
        if (sem_kind == expr_sem_LOCAL()) {
            let local_type = self.local_type_id_from_expr(expr);
            if (local_type != hir_id_invalid()) { return local_type; }
        }
        let builtin_type = self.builtin_return_type_id(expr, sem_kind);
        if (builtin_type != hir_id_invalid()) { return builtin_type; }
        return self.type_id_from_expr(expr);
    }

    fn type_id_from_ref_env(self, ty: rawptr, params: string, args: string) -> i32 {
        if (ty == null) { return hir_id_invalid(); }
        let key = hir_builder_env_key(params, args);
        if (key.len > 0) {
            let cached = hir_decl_instance_map_item(self.type_ref_env_ids,ty, key);
            if (cached != hir_id_invalid()) { return cached; }
        }
        let saved_params = self.current_generic_params;
        let saved_args = self.current_generic_args;
        self.current_generic_params = params;
        self.current_generic_args = args;
        let out = self.type_id_from_ref(ty);
        self.current_generic_params = saved_params;
        self.current_generic_args = saved_args;
        if (key.len > 0 && out != hir_id_invalid()) {
            self.type_ref_env_ids = hir_decl_instance_map_put(self.type_ref_env_ids,ty, key, out, hir_id_invalid());
        }
        return out;
    }

    fn concrete_type_ref_from_env(self, ty: rawptr, params: string, args: string) -> rawptr {
        let saved_params = self.current_generic_params;
        let saved_args = self.current_generic_args;
        self.current_generic_params = params;
        self.current_generic_args = args;
        let out = self.concrete_type_ref(ty);
        self.current_generic_params = saved_params;
        self.current_generic_args = saved_args;
        return out;
    }

    fn canonical_function_return_type_id_from_env(self, d: rawptr, params: string, args: string) -> i32 {
        var ret_type = self.type_id_from_ref_env(decl_get_ty(d), params, args);
        if (ret_type == hir_id_invalid()) {
            ret_type = self.unit.types.intern_type_ref(null);
        }
        if (!hir_builder_decl_is_task_callable(d)) { return ret_type; }
        let ret_text = hir_type_table_text(self.unit.types, ret_type);
        if (hir_builder_type_text_is_awaitable(ret_text)) { return ret_type; }
        return self.type_id_from_text(hir_builder_task_type_text_for_payload(ret_text));
    }

    fn canonical_function_return_type_id(self, d: rawptr) -> i32 {
        return self.canonical_function_return_type_id_from_env(d, "", "");
    }

    fn function_decl_needs_task_return_ready(self, d: rawptr, fn_id: i32) -> bool {
        if (d == null || fn_id == hir_id_invalid()) { return false; }
        if (!hir_builder_decl_is_task_callable(d)) { return false; }
        let ret_type = self.unit.function_return_type(fn_id);
        let ret_text = hir_type_table_text(self.unit.types, ret_type);
        if (!hir_builder_type_text_is_awaitable(ret_text)) { return false; }
        let declared_ret_type = self.type_id_from_ref(decl_get_ty(d));
        var declared_ret_text = "";
        if (declared_ret_type != hir_id_invalid()) {
            declared_ret_text = hir_type_table_text(self.unit.types, declared_ret_type);
        } else {
            declared_ret_text = "void";
        }
        return !hir_builder_type_text_is_awaitable(declared_ret_text);
    }

    fn ensure_task_ready_for_function_return(self, d: rawptr, fn_id: i32) {
        if (!self.function_decl_needs_task_return_ready(d, fn_id)) { return; }
        let ret_text = hir_type_table_text(self.unit.types, self.unit.function_return_type(fn_id));
        if (ret_text.len == 0) { return; }
        self.ensure_static_method_instance_for_type_text(ret_text, "ready");
    }

    fn ensure_async_runtime_methods_for_task_return(self, fn_id: i32) {
        if (fn_id == hir_id_invalid()) { return; }
        if ((hir_unit_function_flags(self.unit, fn_id) & hir_function_flag_async_task()) == 0) { return; }
        let ret_text = hir_type_table_text(self.unit.types, self.unit.function_return_type(fn_id));
        if (ret_text.len == 0 || !hir_builder_type_text_is_awaitable(ret_text)) { return; }
        self.ensure_static_method_instance_for_type_text(ret_text, "ready");
        self.ensure_method_instance_for_type_text(ret_text, "await_value");
        self.ensure_method_instance_for_type_text(ret_text, "resolve");
        self.ensure_method_instance_for_type_text(ret_text, "drop");
    }

    fn type_text_from_ref_env(self, ty: rawptr, params: string, args: string) -> string {
        let id = self.type_id_from_ref_env(ty, params, args);
        if (id == hir_id_invalid()) { return ""; }
        return hir_type_table_text(self.unit.types, id);
    }

    fn inference_type_text_from_ref(self, ty: rawptr) -> string {
        if (ty == null) { return ""; }
        let k = tref_get_kind(ty);
        if (k == ty_CLASS()) {
            let name = tref_get_name(ty);
            let resolved = self.resolve_type_text_in_current_env(name);
            if (resolved.len > 0) { return resolved; }
            return name;
        }
        if (k == ty_STRING()) { return "str"; }
        if (k == ty_I32()) { return "i32"; }
        if (k == ty_I64()) { return "i64"; }
        if (k == ty_BOOL()) { return "bool"; }
        if (k == ty_CHAR()) { return "char"; }
        if (k == ty_RAWPTR()) { return "rawptr"; }
        if (k == ty_VOID()) { return "void"; }
        if (k == ty_F32()) { return "f32"; }
        if (k == ty_F64()) { return "f64"; }
        if (k == ty_I8()) { return "i8"; }
        if (k == ty_I16()) { return "i16"; }
        if (k == ty_U8()) { return "u8"; }
        if (k == ty_U16()) { return "u16"; }
        if (k == ty_U32()) { return "u32"; }
        if (k == ty_U64()) { return "u64"; }
        if (k == ty_ISIZE()) { return "isize"; }
        if (k == ty_USIZE()) { return "usize"; }
        if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()) {
            var prefix = "ptr";
            if (k == ty_REF()) { prefix = "ref"; }
            if (k == ty_MUTREF()) { prefix = "mutref"; }
            return prefix + "<" + self.inference_type_text_from_ref(tref_pointee(ty)) + ">";
        }
        if (k == ty_ARRAY()) {
            let size_e = tref_array_size_expr(ty);
            var size_text = "";
            if (hir_builder_const_expr_known(size_e, self.current_generic_params, self.current_generic_args)) {
                size_text = policy_i64_to_string(hir_builder_const_expr_value(size_e,
                                                                               self.current_generic_params,
                                                                               self.current_generic_args));
            } else {
                size_text = hir_builder_type_expr_text(size_e);
            }
            if (size_text.len == 0) { size_text = policy_i64_to_string(tref_array_size(ty)); }
            return "[" + self.inference_type_text_from_ref(tref_array_elem(ty))
                + ";" + size_text + "]";
        }
        if (k == ty_TUPLE()) {
            var tuple_text = "";
            var ti: i64 = 0;
            while (ti < tref_tuple_count(ty)) {
                if (tuple_text.len > 0) { tuple_text = tuple_text + ","; }
                tuple_text = tuple_text + self.inference_type_text_from_ref(tref_tuple_elem_at(ty, ti));
                ti = ti + 1;
            }
            return "(" + tuple_text + ")";
        }
        if (k == ty_FN() || k == ty_CFN()) {
            var fn_text = "fn(";
            if (k == ty_CFN()) { fn_text = "cfn("; }
            let params_ref = tref_fn_params(ty);
            if (params_ref != null && tref_get_kind(params_ref) == ty_TUPLE()) {
                var pi: i64 = 0;
                while (pi < tref_tuple_count(params_ref)) {
                    if (pi > 0) { fn_text = fn_text + ","; }
                    fn_text = fn_text + self.inference_type_text_from_ref(tref_tuple_elem_at(params_ref, pi));
                    pi = pi + 1;
                }
            }
            return fn_text + ")->" + self.inference_type_text_from_ref(tref_fn_ret(ty));
        }
        return tref_get_name(ty);
    }

    fn inference_type_text_from_ref_env(self, ty: rawptr, params: string, args: string) -> string {
        if (ty == null) { return ""; }
        let saved_params = self.current_generic_params;
        let saved_args = self.current_generic_args;
        self.current_generic_params = params;
        self.current_generic_args = args;
        // Inference only needs the substituted TEXT; walking the raw tref and
        // resolving leaf names through the cached text-level env lookup avoids
        // cloning the whole tref tree (concrete_type_ref ->
        // sema_substitute_type_with_args) on every call.
        let out = self.inference_type_text_from_ref(ty);
        self.current_generic_params = saved_params;
        self.current_generic_args = saved_args;
        return out;
    }

    fn type_text_from_expr(self, expr: rawptr) -> string {
        let id = self.type_id_from_expr_semantic(expr, expr_get_semantic_kind(expr));
        if (id == hir_id_invalid()) { return ""; }
        return hir_type_table_text(self.unit.types, id);
    }

    fn register_decl_chain_with_owner(self, head: rawptr, owner_item_id: i32, owner_decl: rawptr) -> i32 {
        var cur = head;
        var first_member = hir_id_invalid();
        var last_member = hir_id_invalid();
        while (cur != null) {
            // First-wins: an `impl` block decl shares (and reaches) the target
            // class's spliced member chain; re-walking it must not steal
            // ownership from the class decl registered earlier.
            if (owner_decl != null
                && hir_raw_owner_map_get(self.decl_owner_map,cur) == null) {
                self.decl_owner_map = hir_raw_owner_map_put(self.decl_owner_map,cur, owner_decl);
            }
            let item_id = self.register_decl(cur, owner_item_id);
            if (item_id != hir_id_invalid()) {
                if (first_member == hir_id_invalid()) {
                    first_member = item_id;
                }
                if (last_member != hir_id_invalid()) {
                    self.unit.set_item_next_sibling(last_member, item_id);
                }
                last_member = item_id;
            }
            cur = decl_get_next(cur);
        }
        return first_member;
    }

    fn register_decl_chain(self, head: rawptr, owner_item_id: i32) -> i32 {
        return self.register_decl_chain_with_owner(head, owner_item_id, null);
    }

    // A constructor keeps its identity after instantiation, but the closed
    // instance is filed under the mangled `mir2$…` item name, so the plain
    // name test only ever matches the un-instantiated declaration. The
    // function-level flag is what carries "is a constructor" across
    // instantiation; the name test stays as the pre-flag fallback.
    fn function_is_constructor_abi(self, fn_id: i32) -> bool {
        if (fn_id == hir_id_invalid()) { return false; }
        if ((self.unit.function_flags(fn_id) & hir_function_flag_constructor()) != 0) { return true; }
        return self.unit.function_name(fn_id) == "constructor";
    }

    fn local_is_constructor_abi_self(self, fn_id: i32, local_id: i32) -> bool {
        if (fn_id == hir_id_invalid() || local_id == hir_id_invalid()) { return false; }
        if (!self.function_is_constructor_abi(fn_id)) { return false; }
        if ((self.unit.local_flags(local_id) & hir_local_flag_self_receiver()) == 0) { return false; }
        return self.unit.local_name(local_id) == "self";
    }

    fn function_has_self_receiver_param(self, fn_id: i32) -> bool {
        var local_id = self.unit.function_first_local(fn_id);
        while (local_id != hir_id_invalid()) {
            if ((self.unit.local_flags(local_id) & hir_local_flag_self_receiver()) != 0) { return true; }
            local_id = self.unit.local_next(local_id);
        }
        return false;
    }

    fn ensure_constructor_abi_self_param(self, fn_id: i32, owner_type_name: string) {
        if (fn_id == hir_id_invalid() || owner_type_name.len == 0) { return; }
        if (!self.function_is_constructor_abi(fn_id)) { return; }
        if (self.function_has_self_receiver_param(fn_id)) { return; }
        var self_type_id = self.unit.function_return_type(fn_id);
        if (!self.type_id_is_valid(self_type_id)) {
            self_type_id = self.type_id_from_text(owner_type_name);
        }
        if (!self.type_id_is_valid(self_type_id)) { return; }
        self.unit.add_local(fn_id,
                           "self",
                           self_type_id,
                           hir_local_flag_param()
                               | hir_local_flag_self_receiver()
                               | hir_local_flag_self_compat());
    }

    fn add_function_param_locals_with_owner(self, fn_id: i32, d: rawptr, owner_type_name: string) {
        if (fn_id == hir_id_invalid() || d == null) { return; }
        if (!hir_builder_decl_is_foreign_dci_native(d)) {
            self.ensure_constructor_abi_self_param(fn_id, owner_type_name);
        }
        var param = decl_get_params(d);
        while (param != null) {
            if (hir_builder_c_varargs_param(param)) {
                param = decl_get_next(param);
            } elif (hir_builder_variadic_param(param)) {
                let pack_name = hir_builder_param_pack_type_name(param);
                let pack_count = self.current_pack_count(pack_name);
                if (pack_count > 0) {
                    var i: i32 = 0;
                    while (i < pack_count) {
                        let arg_text = self.current_pack_arg_text(pack_name, i);
                        let arg_type = self.type_id_from_text(arg_text);
                        var arg_flags: i32 = 1;
                        if (self.param_type_id_should_move_arg(d, param, arg_type)) {
                            arg_flags = arg_flags | 16;
                        }
                        let arg_local = self.unit.add_local(fn_id,
                                                           decl_get_name(param) + "$" + policy_i64_to_string(i as i64),
                                                           arg_type,
                                                           arg_flags);
                        i = i + 1;
                    }
                }
            } else {
                var param_type = self.type_id_from_ref(decl_get_ty(param));
                if (owner_type_name.len > 0 && decl_get_name(param) == "self") {
                    param_type = self.type_id_from_text(owner_type_name);
                }
                if (decl_get_name(param) == "self") {
                    let self_binding = self.current_generic_binding("Self");
                    if (self_binding.len > 0) {
                        param_type = self.type_id_from_text(self_binding);
                    }
                }
                var param_flags: i32 = 1;
                if (decl_get_name(param) == "self") {
                    param_flags = param_flags
                        | hir_local_flag_self_receiver()
                        | hir_builder_self_receiver_mode_flags(param);
                }
                // Mark move-receiving params at registration time, not only at
                // body-build time (refresh_function_param_drop_metadata): the
                // lazy codegen pipeline MIR-builds callers before the callee's
                // body is materialized, and the caller's drop deactivation
                // (deactivate_call_moved_args_from) reads this flag. Without it
                // a moved argument would still be dropped by the caller
                // (use-after-free / double-release on container push).
                if (self.param_type_id_should_move_arg(d, param, param_type)) {
                    param_flags = param_flags | hir_local_flag_move_arg();
                } else if ((param_flags & hir_local_flag_move_arg()) != 0) {
                    param_flags = param_flags - hir_local_flag_move_arg();
                    param_flags = param_flags | hir_local_flag_self_compat();
                }
                let param_local = self.unit.add_local(fn_id, decl_get_name(param), param_type, param_flags);
            }
            param = decl_get_next(param);
        }
    }

    fn add_function_param_locals(self, fn_id: i32, d: rawptr) {
        self.add_function_param_locals_with_owner(fn_id, d, "");
    }

    fn bind_function_param_scope(self, fn_id: i32, d: rawptr) {
        if (fn_id == hir_id_invalid() || d == null) { return; }
        var local_id = self.unit.function_first_local(fn_id);
        // A zero-length variadic parameter has no HIR local, but still needs
        // an empty pack binding so `args.len` materializes as the constant 0.
        // Only a function with neither a local nor an AST parameter list has
        // no scope work at all.
        if (local_id == hir_id_invalid() && decl_get_params(d) == null) { return; }
        var param = decl_get_params(d);
        if (local_id != hir_id_invalid()
            && self.local_is_constructor_abi_self(fn_id, local_id)
            && (param == null || decl_get_name(param) != "self")) {
            self.locals = hir_local_scope_push(self.locals,
                                 "self",
                                 local_id,
                                 self.unit.local_type(local_id),
                                 fn_id,
                                 null);
            local_id = self.unit.local_next(local_id);
        }
        while (param != null) {
            if (hir_builder_c_varargs_param(param)) {
                param = decl_get_next(param);
            } elif (hir_builder_variadic_param(param)) {
                let pack_name = hir_builder_param_pack_type_name(param);
                let pack_count = self.current_pack_count(pack_name);
                var locals_buf: rawptr = null;
                if (pack_count > 0) {
                    locals_buf = hir_profile_malloc((pack_count * 4) as u64);
                    if (locals_buf != null) { memset(locals_buf, 0, (pack_count * 4) as u64); }
                }
                var i: i32 = 0;
                while (i < pack_count && local_id != hir_id_invalid()) {
                    if ((self.unit.local_flags(local_id) & hir_local_flag_param()) != 0) {
                        if (locals_buf != null) { ast_write_i32(ptr_offset(locals_buf, i * 4), local_id); }
                        self.locals = hir_local_scope_push(self.locals,
                                             self.unit.local_name(local_id),
                                             local_id,
                                             self.unit.local_type(local_id),
                                             fn_id,
                                             decl_get_semantic_target(param));
                        i = i + 1;
                    }
                    local_id = self.unit.local_next(local_id);
                }
                self.pack_bindings = hir_pack_bindings_bind(self.pack_bindings, decl_get_name(param), locals_buf, pack_count);
                param = decl_get_next(param);
            } else if (local_id != hir_id_invalid() && (self.unit.local_flags(local_id) & hir_local_flag_param()) != 0) {
                self.locals = hir_local_scope_push(self.locals,
                                     decl_get_name(param),
                                     local_id,
                                     self.unit.local_type(local_id),
                                     fn_id,
                                     decl_get_semantic_target(param));
                param = decl_get_next(param);
                local_id = self.unit.local_next(local_id);
            } else if (local_id != hir_id_invalid()) {
                local_id = self.unit.local_next(local_id);
            } else {
                return;
            }
        }
    }

    fn seed_bindings_from_args(self, bindings: &mut HirGenericBindingMap, params: string, args: string) {
        var i: i32 = 0;
        while (i < 64) {
            let p = hir_builder_generic_param_at(params, i);
            if (p.len == 0) { return; }
            let a = policy_generic_arg_at(args, i);
            if (a.len > 0) { bindings.bind(p, a); }
            i = i + 1;
        }
    }

    fn infer_name_bindings(self,
                                  pattern: string,
                                  actual: string,
                                  allowed_params: string,
                                  locked_params: string,
                                  bindings: &mut HirGenericBindingMap) {
        if (pattern.len == 0 || actual.len == 0) { return; }
        if (hir_builder_generic_contains(allowed_params, pattern)) {
            if (bindings.lookup(pattern).len > 0) {
                return;
            }
            bindings.bind(pattern, actual);
            return;
        }
        let pattern_base = policy_generic_call_base(pattern);
        let pattern_args = policy_generic_call_args(pattern);
        let actual_base = policy_generic_call_base(actual);
        let actual_args = policy_generic_call_args(actual);
        if (pattern_args.len == 0 || actual_args.len == 0) { return; }
        if (!policy_type_name_equal(pattern_base, actual_base)) { return; }
        var i: i32 = 0;
        while (i < 64) {
            let pa = policy_generic_arg_at(pattern_args, i);
            let aa = policy_generic_arg_at(actual_args, i);
            if (pa.len == 0 || aa.len == 0) { return; }
            self.infer_name_bindings(pa, aa, allowed_params, locked_params, bindings);
            i = i + 1;
        }
    }

    fn infer_type_bindings_from_text(self,
                                            param_text: string,
                                            actual_text: string,
                                            allowed_params: string,
                                            locked_params: string,
                                            bindings: &mut HirGenericBindingMap) {
        if (param_text.len == 0 || actual_text.len == 0) { return; }
        self.infer_name_bindings(param_text, actual_text, allowed_params, locked_params, bindings);
        self.infer_function_type_bindings_from_text(param_text, actual_text, allowed_params, locked_params, bindings);
        let param_base = hir_builder_last_path_segment(policy_generic_call_base(param_text));
        let actual_base = hir_builder_last_path_segment(policy_generic_call_base(actual_text));
        if ((param_base == "ptr" || param_base == "ref")
            && (actual_base == "ptr" || actual_base == "ref")) {
            let param_args = policy_generic_call_args(param_text);
            let actual_args = policy_generic_call_args(actual_text);
            let param_elem = policy_generic_arg_at(param_args, 0);
            let actual_elem = policy_generic_arg_at(actual_args, 0);
            if (param_elem.len > 0 && actual_elem.len > 0) {
                self.infer_name_bindings(param_elem, actual_elem, allowed_params, locked_params, bindings);
            }
        }
    }

    fn function_type_open_index(self, text: string) -> i32 {
        if (text.len >= 3 && text.substring(0, 3) == "fn(") { return 2; }
        if (text.len >= 4 && text.substring(0, 4) == "cfn(") { return 3; }
        if (text.len >= 10 && text.substring(0, 10) == "unsafe fn(") { return 9; }
        return -1;
    }

    fn infer_function_type_bindings_from_text(self,
                                                     param_text: string,
                                                     actual_text: string,
                                                     allowed_params: string,
                                                     locked_params: string,
                                                     bindings: &mut HirGenericBindingMap) {
        let param_open = self.function_type_open_index(param_text);
        let actual_open = self.function_type_open_index(actual_text);
        if (param_open < 0 || actual_open < 0) { return; }
        let param_close = self.fn_type_text_close_paren(param_text, param_open);
        let actual_close = self.fn_type_text_close_paren(actual_text, actual_open);
        if (param_close < 0 || actual_close < 0) { return; }
        if (param_close + 2 >= param_text.len || actual_close + 2 >= actual_text.len) { return; }
        if (param_text.charAt(param_close + 1) != 45 || param_text.charAt(param_close + 2) != 62) { return; }
        if (actual_text.charAt(actual_close + 1) != 45 || actual_text.charAt(actual_close + 2) != 62) { return; }
        let param_args = param_text.substring(param_open + 1, param_close);
        let actual_args = actual_text.substring(actual_open + 1, actual_close);
        var idx: i32 = 0;
        while (idx < 256) {
            let param_arg = policy_generic_arg_at(param_args, idx);
            let actual_arg = policy_generic_arg_at(actual_args, idx);
            if (param_arg.len == 0 && actual_arg.len == 0) { break; }
            if (param_arg.len == 0 || actual_arg.len == 0) { return; }
            self.infer_type_bindings_from_text(param_arg,
                                               actual_arg,
                                               allowed_params,
                                               locked_params,
                                               bindings);
            idx = idx + 1;
        }
        let param_ret = param_text.substring(param_close + 3, param_text.len);
        let actual_ret = actual_text.substring(actual_close + 3, actual_text.len);
        self.infer_type_bindings_from_text(param_ret,
                                           actual_ret,
                                           allowed_params,
                                           locked_params,
                                           bindings);
    }

    fn infer_call_bindings(self,
                                  call_expr: rawptr,
                                  target_decl: rawptr,
                                  owner_params: string,
                                  owner_args: string,
                                  method_params: string,
                                  explicit_method_args: string) -> HirGenericBindingMap {
        if (vyx_bootstrap_profile_level() > 2) {
            var target_name = "";
            if (target_decl != null) { target_name = decl_get_name(target_decl); }
            print("[hir-infer-call] enter target=" + target_name
                  + " owner_params=" + owner_params
                  + " owner_args=" + owner_args
                  + " method_params=" + method_params
                  + " explicit=" + explicit_method_args);
        }
        var bindings = HirGenericBindingMap.create();
        self.seed_bindings_from_args(&mut bindings, owner_params, owner_args);
        self.seed_bindings_from_args(&mut bindings, method_params, explicit_method_args);
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-infer-call] seeded");
        }
        let allowed = hir_builder_append_csv(owner_params, method_params);
        var locked = hir_builder_params_with_args(owner_params, owner_args);
        locked = hir_builder_append_csv(locked, hir_builder_params_with_args(method_params, explicit_method_args));
        var env_params = owner_params;
        var env_args = owner_args;
        if (explicit_method_args.len > 0) {
            env_params = hir_builder_append_csv(env_params, method_params);
            env_args = hir_builder_append_csv(env_args, explicit_method_args);
        }
        var arg_cell: rawptr = null;
        if (call_expr != null && expr_get_kind(call_expr) == ex_CALL()) {
            arg_cell = expr_get_args(call_expr);
        }
        var param = decl_get_params(target_decl);
        if (param != null && decl_get_name(param) == "self") {
            param = decl_get_next(param);
        }
        while (param != null && arg_cell != null) {
            let arg_expr = stmt_get_init(arg_cell);
            if (vyx_bootstrap_profile_level() > 2) {
                print("[hir-infer-call] arg-enter param=" + decl_get_name(param)
                      + " arg_kind=" + self.i32_text(expr_get_kind(arg_expr))
                      + " arg_name=" + expr_get_name(arg_expr));
            }
            let param_text = self.inference_type_text_from_ref_env(decl_get_ty(param), env_params, env_args);
            if (vyx_bootstrap_profile_level() > 2) {
                print("[hir-infer-call] param-text=" + param_text);
            }
            let actual_text = self.inference_type_text_from_ref_env(expr_get_ty(arg_expr),
                                                                    self.current_generic_params,
                                                                    self.current_generic_args);
            if (vyx_bootstrap_profile_level() > 2) {
                print("[hir-infer-call] actual-text=" + actual_text);
            }
            self.infer_type_bindings_from_text(param_text, actual_text, allowed, locked, &mut bindings);
            if (vyx_bootstrap_profile_level() > 2) {
                print("[hir-infer-call] arg-leave param=" + decl_get_name(param));
            }
            param = decl_get_next(param);
            arg_cell = stmt_get_next(arg_cell);
        }
        // Return-position inference is only meaningful when some generic
        // params are still unbound; when explicit args already cover every
        // param the branch previously fed the callee's own fn-type text
        // (fn(..)->..) as the "actual" result type, producing junk bindings.
        var need_return_inference: bool = call_expr != null;
        if (need_return_inference
            && hir_builder_env_args_cover_params(owner_params, owner_args)
            && hir_builder_env_args_cover_params(method_params, explicit_method_args)) {
            need_return_inference = false;
        }
        if (need_return_inference) {
            if (vyx_bootstrap_profile_level() > 2) {
                print("[hir-infer-call] return-enter");
            }
            let return_pattern = self.inference_type_text_from_ref_env(decl_get_ty(target_decl), env_params, env_args);
            if (vyx_bootstrap_profile_level() > 2) {
                print("[hir-infer-call] return-pattern=" + return_pattern);
            }
            // expr_get_ty(call_expr) carries the callee's function type, not
            // the call result; match the return position against the fn
            // type's return slot instead of the whole fn(..)->.. text.
            var return_actual_ty = expr_get_ty(call_expr);
            if (return_actual_ty != null) {
                let return_actual_kind = tref_get_kind(return_actual_ty);
                if (return_actual_kind == ty_FN() || return_actual_kind == ty_CFN()) {
                    return_actual_ty = tref_fn_ret(return_actual_ty);
                }
            }
            if (return_actual_ty != null) {
                let return_actual = self.inference_type_text_from_ref_env(return_actual_ty,
                                                                          self.current_generic_params,
                                                                          self.current_generic_args);
                if (vyx_bootstrap_profile_level() > 2) {
                    print("[hir-infer-call] return-actual=" + return_actual);
                }
                self.infer_type_bindings_from_text(return_pattern, return_actual, allowed, locked, &mut bindings);
            }
        }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-infer-call] leave");
        }
        return bindings;
    }

    // Semantic lowering occasionally resolves a method after its source
    // expression has already been built (assignment and index operators).
    // Treat those forms as a one-argument call over the stable HIR child
    // rather than reconstructing an untyped temporary AST call.
    fn hir_method_call_first_arg(self, expr_id: i32) -> i32 {
        if (expr_id == hir_id_invalid()) { return hir_id_invalid(); }
        let kind = self.unit.expr_kind(expr_id);
        if (kind == ex_CALL()) { return self.unit.expr_first_arg(expr_id); }
        if (kind == ex_ASSIGN() || kind == ex_INDEX()) { return self.unit.expr_rhs(expr_id); }
        return hir_id_invalid();
    }

    fn hir_method_call_next_arg(self, call_expr_id: i32, arg_id: i32) -> i32 {
        if (call_expr_id == hir_id_invalid() || arg_id == hir_id_invalid()) {
            return hir_id_invalid();
        }
        if (self.unit.expr_kind(call_expr_id) == ex_CALL()) {
            return self.unit.expr_next_arg(arg_id);
        }
        return hir_id_invalid();
    }

    fn infer_hir_call_bindings(self,
                                      call_expr_id: i32,
                                      target_decl: rawptr,
                                      owner_params: string,
                                      owner_args: string,
                                      method_params: string,
                                      explicit_method_args: string) -> HirGenericBindingMap {
        var bindings = HirGenericBindingMap.create();
        self.seed_bindings_from_args(&mut bindings, owner_params, owner_args);
        self.seed_bindings_from_args(&mut bindings, method_params, explicit_method_args);
        let allowed = hir_builder_append_csv(owner_params, method_params);
        var locked = hir_builder_params_with_args(owner_params, owner_args);
        locked = hir_builder_append_csv(locked, hir_builder_params_with_args(method_params, explicit_method_args));
        var env_params = owner_params;
        var env_args = owner_args;
        if (explicit_method_args.len > 0) {
            env_params = hir_builder_append_csv(env_params, method_params);
            env_args = hir_builder_append_csv(env_args, explicit_method_args);
        }
        var arg_id = self.hir_method_call_first_arg(call_expr_id);
        var param = decl_get_params(target_decl);
        if (param != null && decl_get_name(param) == "self") {
            param = decl_get_next(param);
        }
        while (param != null && arg_id != hir_id_invalid()) {
            let param_text = self.inference_type_text_from_ref_env(decl_get_ty(param), env_params, env_args);
            let actual_type_id = self.unit.expr_type(arg_id);
            var actual_text = "";
            if (self.type_id_is_valid(actual_type_id)) {
                actual_text = hir_type_table_text(self.unit.types, actual_type_id);
            }
            self.infer_type_bindings_from_text(param_text, actual_text, allowed, locked, &mut bindings);
            param = decl_get_next(param);
            arg_id = self.hir_method_call_next_arg(call_expr_id, arg_id);
        }
        if (call_expr_id != hir_id_invalid() && self.unit.expr_kind(call_expr_id) == ex_CALL()) {
            let return_pattern = self.inference_type_text_from_ref_env(decl_get_ty(target_decl), env_params, env_args);
            let return_type_id = self.unit.expr_type(call_expr_id);
            var return_actual = "";
            if (self.type_id_is_valid(return_type_id)) {
                return_actual = hir_type_table_text(self.unit.types, return_type_id);
            }
            self.infer_type_bindings_from_text(return_pattern, return_actual, allowed, locked, &mut bindings);
        }
        return bindings;
    }

    fn args_for_params(self,
                              params: string,
                              explicit_args: string,
                              bindings: HirGenericBindingMap) -> string {
        var out = "";
        var i: i32 = 0;
        while (i < 64) {
            let p = hir_builder_generic_param_at(params, i);
            if (p.len == 0) { return out.clone(); }
            var a = policy_generic_arg_at(explicit_args, i);
            if (a.len == 0) { a = bindings.lookup(p); }
            if (a.len > 0) { a = self.resolve_type_text_in_current_env(a); }
            if (a.len == 0) { return out.clone(); }
            out = hir_builder_append_csv(out, a);
            i = i + 1;
        }
        return out.clone();
    }

    fn variadic_pack_arg_texts_for_call(self, call_expr: rawptr, target_decl: rawptr, pack_name: string) -> string {
        if (call_expr == null || expr_get_kind(call_expr) != ex_CALL() || target_decl == null || pack_name.len == 0) {
            return "";
        }
        var arg_cell = expr_get_args(call_expr);
        var param = decl_get_params(target_decl);
        if (param != null && decl_get_name(param) == "self") {
            param = decl_get_next(param);
        }
        while (param != null && !hir_builder_variadic_param(param)) {
            if (arg_cell != null) { arg_cell = stmt_get_next(arg_cell); }
            param = decl_get_next(param);
        }
        if (param == null) { return ""; }
        var out = "";
        while (arg_cell != null) {
            let arg_expr = stmt_get_init(arg_cell);
            let actual_text = self.type_text_from_ref_env(expr_get_ty(arg_expr),
                                                          self.current_generic_params,
                                                          self.current_generic_args);
            if (actual_text.len == 0) { return ""; }
            out = hir_builder_append_csv(out, actual_text);
            arg_cell = stmt_get_next(arg_cell);
        }
        return out.clone();
    }

    fn variadic_pack_arg_texts_for_hir_call(self,
                                                   call_expr_id: i32,
                                                   target_decl: rawptr,
                                                   pack_name: string) -> string {
        if (call_expr_id == hir_id_invalid()
            || target_decl == null
            || pack_name.len == 0) {
            return "";
        }
        var arg_id = self.hir_method_call_first_arg(call_expr_id);
        var param = decl_get_params(target_decl);
        if (param != null && decl_get_name(param) == "self") {
            param = decl_get_next(param);
        }
        while (param != null && !hir_builder_variadic_param(param)) {
            if (arg_id != hir_id_invalid()) { arg_id = self.hir_method_call_next_arg(call_expr_id, arg_id); }
            param = decl_get_next(param);
        }
        if (param == null) { return ""; }
        var out = "";
        while (arg_id != hir_id_invalid()) {
            let actual_type_id = self.unit.expr_type(arg_id);
            if (!self.type_id_is_valid(actual_type_id)) { return ""; }
            var actual_text = hir_type_table_text(self.unit.types, actual_type_id);
            if (actual_text.len == 0) { return ""; }
            let resolved = self.resolve_type_text_in_current_env(actual_text);
            if (resolved.len > 0) { actual_text = resolved; }
            if (actual_text.len == 0) { return ""; }
            out = hir_builder_append_csv(out, actual_text);
            arg_id = self.hir_method_call_next_arg(call_expr_id, arg_id);
        }
        return out.clone();
    }

    fn args_for_call_params(self,
                                   call_expr: rawptr,
                                   target_decl: rawptr,
                                   params: string,
                                   explicit_args: string,
                                   bindings: HirGenericBindingMap) -> string {
        var pack_name = "";
        var param = decl_get_params(target_decl);
        while (param != null && pack_name.len == 0) {
            if (hir_builder_variadic_param(param)) {
                pack_name = hir_builder_param_pack_type_name(param);
            }
            param = decl_get_next(param);
        }
        if (pack_name.len == 0) {
            return self.args_for_params(params, explicit_args, bindings);
        }
        let pack_args = self.variadic_pack_arg_texts_for_call(call_expr, target_decl, pack_name);
        var out = "";
        var i: i32 = 0;
        while (i < 256) {
            let p = hir_builder_generic_param_at(params, i);
            if (p.len == 0) { return out.clone(); }
            if (p == pack_name) {
                if (pack_args.len > 0) {
                    out = hir_builder_append_csv(out, pack_args);
                }
            } else {
                var a = policy_generic_arg_at(explicit_args, i);
                if (a.len == 0) { a = bindings.lookup(p); }
                if (a.len > 0) { a = self.resolve_type_text_in_current_env(a); }
                if (a.len == 0) { return out.clone(); }
                out = hir_builder_append_csv(out, a);
            }
            i = i + 1;
        }
        return out.clone();
    }

    fn args_for_hir_call_params(self,
                                       call_expr_id: i32,
                                       target_decl: rawptr,
                                       params: string,
                                       explicit_args: string,
                                       bindings: HirGenericBindingMap) -> string {
        var pack_name = "";
        var param = decl_get_params(target_decl);
        while (param != null && pack_name.len == 0) {
            if (hir_builder_variadic_param(param)) {
                pack_name = hir_builder_param_pack_type_name(param);
            }
            param = decl_get_next(param);
        }
        if (pack_name.len == 0) {
            return self.args_for_params(params, explicit_args, bindings);
        }
        let pack_args = self.variadic_pack_arg_texts_for_hir_call(call_expr_id, target_decl, pack_name);
        var out = "";
        var explicit_index: i32 = 0;
        var i: i32 = 0;
        while (i < 256) {
            let p = hir_builder_generic_param_at(params, i);
            if (p.len == 0) { return out.clone(); }
            if (p == pack_name) {
                if (pack_args.len > 0) {
                    out = hir_builder_append_csv(out, pack_args);
                }
            } else {
                var a = policy_generic_arg_at(explicit_args, explicit_index);
                explicit_index = explicit_index + 1;
                if (a.len == 0) { a = bindings.lookup(p); }
                if (a.len > 0) { a = self.resolve_type_text_in_current_env(a); }
                if (a.len == 0) { return out.clone(); }
                out = hir_builder_append_csv(out, a);
            }
            i = i + 1;
        }
        return out.clone();
    }

    fn receiver_expr_for_call(self, e: rawptr) -> rawptr {
        if (e == null) { return null; }
        if (expr_get_kind(e) == ex_CALL()) {
            let callee = expr_get_lhs(e);
            if (callee != null && expr_get_kind(callee) == ex_MEMBER()) {
                return expr_get_lhs(callee);
            }
            return null;
        }
        if (expr_get_kind(e) == ex_MEMBER()) {
            return expr_get_lhs(e);
        }
        return null;
    }

    fn decl_has_variadic_param(self, d: rawptr) -> bool {
        var param = decl_get_params(d);
        while (param != null) {
            if (hir_builder_variadic_param(param)) { return true; }
            param = decl_get_next(param);
        }
        return false;
    }

    fn env_args_cover_params_for_decl(self, d: rawptr, params: string, args: string) -> bool {
        if (hir_builder_env_args_cover_params(params, args)) { return true; }
        if (d == null || params.len == 0) { return false; }
        var pack_name = "";
        var param = decl_get_params(d);
        while (param != null && pack_name.len == 0) {
            if (hir_builder_variadic_param(param)) {
                pack_name = hir_builder_param_pack_type_name(param);
            }
            param = decl_get_next(param);
        }
        if (pack_name.len == 0) { return false; }
        var pack_index: i32 = -1;
        var param_count: i32 = 0;
        while (param_count < 256) {
            let p = hir_builder_generic_param_at(params, param_count);
            if (p.len == 0) { break; }
            if (p == pack_name) { pack_index = param_count; }
            param_count = param_count + 1;
        }
        if (pack_index < 0) { return false; }
        let arg_count = hir_builder_generic_arg_count(args);
        let trailing_params = param_count - pack_index - 1;
        if (arg_count < pack_index + trailing_params) { return false; }
        var i: i32 = 0;
        while (i < pack_index) {
            if (policy_generic_arg_at(args, i).len == 0) { return false; }
            i = i + 1;
        }
        var tail: i32 = 0;
        while (tail < trailing_params) {
            if (policy_generic_arg_at(args, arg_count - trailing_params + tail).len == 0) {
                return false;
            }
            tail = tail + 1;
        }
        return true;
    }

    fn env_args_are_closed(self, args: string) -> bool {
        if (args.len == 0) { return true; }
        var idx: i32 = 0;
        while (idx < 256) {
            let arg = policy_generic_arg_at(args, idx);
            if (arg.len == 0) { return true; }
            if (self.type_text_has_open_template_atom(arg)) { return false; }
            idx = idx + 1;
        }
        return false;
    }

    fn env_args_reference_params(self, params: string, args: string) -> bool {
        if (params.len == 0 || args.len == 0) { return false; }
        var arg_idx: i32 = 0;
        while (arg_idx < 256) {
            let arg = policy_generic_arg_at(args, arg_idx);
            if (arg.len == 0) { return false; }
            var param_idx: i32 = 0;
            while (param_idx < 256) {
                let param = hir_builder_generic_param_at(params, param_idx);
                if (param.len == 0) { break; }
                if (hir_builder_type_text_contains_template_param(arg, param)) {
                    return true;
                }
                param_idx = param_idx + 1;
            }
            arg_idx = arg_idx + 1;
        }
        return false;
    }

    fn explicit_generic_args_for_call(self, e: rawptr) -> string {
        if (e == null) { return ""; }
        var source = e;
        if (expr_get_kind(e) == ex_CALL() && expr_get_lhs(e) != null) {
            source = expr_get_lhs(e);
        }
        return policy_generic_call_args(expr_get_name(source));
    }

    fn resolve_explicit_generic_args_for_call(self, e: rawptr) -> string {
        let raw_args = self.explicit_generic_args_for_call(e);
        if (raw_args.len == 0) { return ""; }
        var out = "";
        var i: i32 = 0;
        while (i < 64) {
            let raw_arg = policy_generic_arg_at(raw_args, i);
            if (raw_arg.len == 0) { return out; }
            let resolved_arg = self.canonical_type_text_in_current_env(raw_arg);
            if (resolved_arg.len == 0) { return ""; }
            out = hir_builder_append_csv(out, resolved_arg);
            i = i + 1;
        }
        return out;
    }

    fn resolve_explicit_generic_args_for_hir_call(self, call_expr_id: i32) -> string {
        if (call_expr_id == hir_id_invalid() || self.unit.expr_kind(call_expr_id) != ex_CALL()) { return ""; }
        let callee_expr_id = self.unit.expr_lhs(call_expr_id);
        if (callee_expr_id == hir_id_invalid()) { return ""; }
        let raw_args = policy_generic_call_args(self.unit.expr_name(callee_expr_id).clone());
        if (raw_args.len == 0) { return ""; }
        var out = "";
        var i: i32 = 0;
        while (i < 64) {
            let raw_arg = policy_generic_arg_at(raw_args, i);
            if (raw_arg.len == 0) { return out; }
            let resolved_arg = self.canonical_type_text_in_function_env(raw_arg,
                                                                        self.unit.expr_function(call_expr_id));
            if (resolved_arg.len == 0) { return ""; }
            out = hir_builder_append_csv(out, resolved_arg);
            i = i + 1;
        }
        return out;
    }

    fn resolve_explicit_generic_args_for_hir_member_expr(self, member_expr_id: i32) -> string {
        if (member_expr_id == hir_id_invalid() || self.unit.expr_kind(member_expr_id) != ex_MEMBER()) { return ""; }
        let raw_args = policy_generic_call_args(self.unit.expr_name(member_expr_id).clone());
        if (raw_args.len == 0) { return ""; }
        var out = "";
        var i: i32 = 0;
        while (i < 64) {
            let raw_arg = policy_generic_arg_at(raw_args, i);
            if (raw_arg.len == 0) { return out; }
            let resolved_arg = self.canonical_type_text_in_function_env(raw_arg,
                                                                        self.unit.expr_function(member_expr_id));
            if (resolved_arg.len == 0) { return ""; }
            out = hir_builder_append_csv(out, resolved_arg);
            i = i + 1;
        }
        return out;
    }

    fn current_generic_binding(self, name: string) -> string {
        if (name.len == 0) { return ""; }
        var i: i32 = 0;
        while (i < 64) {
            let p = hir_builder_generic_param_at(self.current_generic_params, i);
            if (p.len == 0) { return ""; }
            if (p == name) {
                return policy_generic_arg_at(self.current_generic_args, i);
            }
            i = i + 1;
        }
        return "";
    }

    fn type_text_needs_current_env(self, text: string) -> bool {
        if (text.len == 0) { return false; }
        if (self.current_generic_params.len == 0 && self.current_generic_args.len == 0) { return false; }
        var i: i32 = 0;
        while (i < text.len) {
            let c = text.charAt(i);
            if (!hir_builder_identifier_char(c)) {
                i = i + 1;
            } else {
                let start = i;
                i = i + 1;
                while (i < text.len && hir_builder_identifier_char(text.charAt(i))) {
                    i = i + 1;
                }
                let token = text.substring(start, i);
                if (token == "Self") { return true; }
                if (hir_builder_generic_contains(self.current_generic_params, token)) { return true; }
            }
        }
        return false;
    }

    fn generic_arg_for_param(self, params: string, args: string, name: string) -> string {
        if (params.len == 0 || args.len == 0 || name.len == 0) { return ""; }
        var i: i32 = 0;
        while (i < 64) {
            let p = hir_builder_generic_param_at(params, i);
            if (p.len == 0) { return ""; }
            if (p == name) { return policy_generic_arg_at(args, i); }
            i = i + 1;
        }
        return "";
    }

    fn associated_type_text_in_current_env(self, text: string) -> string {
        let sep = hir_builder_assoc_separator_index(text);
        if (sep < 0) { return ""; }
        let sep_len = hir_builder_assoc_separator_len(text, sep);
        if (sep + sep_len >= text.len) { return ""; }
        let owner_raw = text.substring(0, sep);
        let member_name = text.substring(sep + sep_len, text.len);
        if (owner_raw.len == 0 || member_name.len == 0) { return ""; }
        if (policy_generic_call_has_args(member_name.clone()) != 0) { return ""; }
        let owner_text = self.resolve_type_text_in_current_env(owner_raw);
        if (owner_text.len == 0 || owner_text == text) { return ""; }
        let owner_decl = self.raw_class_decl_for_type_text(owner_text);
        if (owner_decl == null) { return ""; }
        let member = self.raw_member_decl_for_type_text(owner_text, member_name);
        if (member == null) { return ""; }
        let member_kind = decl_get_kind(member);
        if (member_kind != de_TYPE_ALIAS() && member_kind != de_FIELD()) { return ""; }
        let member_ty = decl_get_ty(member);
        if (member_ty == null) { return ""; }
        let owner_params = hir_builder_decl_template_params(owner_decl);
        let owner_args = hir_builder_owner_args_for_params(owner_params, owner_text);
        let member_text = self.type_text_from_ref_env(member_ty, owner_params, owner_args);
        if (member_text.len == 0 || member_text == text) { return ""; }
        return self.resolve_type_text_in_current_env(member_text);
    }

    fn resolve_type_text_in_current_env(self, text: string) -> string {
        self.profile_resolve_type_calls = self.profile_resolve_type_calls + 1;
        var hot_start: i64 = 0;
        let hot_timing = hir_builder_env_enabled("VYX_HIR_HOT_TIMING");
        if (hot_timing) { hot_start = vyx_bootstrap_now_ms(); }
        if (text.len == 0) { return ""; }
        var out = "";
        let needs_env = self.type_text_needs_current_env(text);
        if (!needs_env) {
            if (hir_builder_is_primitive_str_name(text)) {
                out = "str";
                if (hot_timing) { self.profile_ms_resolve_type = self.profile_ms_resolve_type + (vyx_bootstrap_now_ms() - hot_start); }
                return out;
            }
            if (!hir_builder_type_text_needs_env_resolution(text)) {
                out = text;
                if (hot_timing) { self.profile_ms_resolve_type = self.profile_ms_resolve_type + (vyx_bootstrap_now_ms() - hot_start); }
                return out;
            }
        }
        var cache_key = text;
        if (needs_env) {
            let env_key = hir_builder_env_key(self.current_generic_params, self.current_generic_args);
            if (env_key.len > 0) { cache_key = env_key + "=>" + text; }
        }
        let cached = self.resolved_type_text_cache.lookup(cache_key);
        if (cached.len > 0) {
            if (hot_timing) { self.profile_ms_resolve_type = self.profile_ms_resolve_type + (vyx_bootstrap_now_ms() - hot_start); }
            return cached;
        }
        out = self.resolve_type_text_in_current_env_uncached(text);
        if (out.len > 0) { self.resolved_type_text_cache.bind(cache_key, out); }
        if (hot_timing) { self.profile_ms_resolve_type = self.profile_ms_resolve_type + (vyx_bootstrap_now_ms() - hot_start); }
        return out;
    }

    fn resolve_type_text_in_current_env_uncached(self, text: string) -> string {
        if (text.len == 0) { return ""; }
        if (hir_builder_is_primitive_str_name(text)) { return "str"; }
        let pack_index_type = self.pack_index_type_text_in_current_env(text);
        if (pack_index_type.len > 0) { return pack_index_type; }
        if (policy_generic_call_has_args(text) != 0) {
            let base = policy_generic_call_base(text);
            let raw_args = policy_generic_call_args(text);
            var out_args = "";
            var i: i32 = 0;
            while (i < 64) {
                let raw_arg = policy_generic_arg_at(raw_args, i);
                if (raw_arg.len == 0) {
                    if (out_args.len == 0) { return base; }
                    return base + "::<" + out_args + ">";
                }
                out_args = hir_builder_append_csv(out_args, self.resolve_type_text_in_current_env(raw_arg));
                i = i + 1;
            }
            return base + "::<" + out_args + ">";
        }
        let bound = self.current_generic_binding(text);
        if (bound.len > 0 && bound != text) {
            return self.resolve_type_text_in_current_env(bound);
        }
        let associated = self.associated_type_text_in_current_env(text);
        if (associated.len > 0 && associated != text) { return associated; }
        return text;
    }

    fn canonical_type_text_in_current_env(self, text: string) -> string {
        let resolved = self.resolve_type_text_in_current_env(text);
        if (resolved.len == 0) { return ""; }
        let use_target = self.use_alias_target_type_text(resolved.clone());
        if (use_target.len > 0 && use_target != resolved) {
            return self.resolve_type_text_in_current_env(use_target);
        }
        let alias_decl = self.find_type_alias_decl(resolved);
        if (alias_decl != null && decl_get_ty(alias_decl) != null) {
            let alias_text = self.type_name_for_ref(decl_get_ty(alias_decl));
            if (alias_text.len > 0 && alias_text != resolved) {
                return self.resolve_type_text_in_current_env(alias_text);
            }
        }
        return resolved;
    }

    fn use_alias_target_type_text(self, text: string) -> string {
        if (self.source_unit == null || text.len == 0) { return ""; }
        let base = policy_generic_call_base(text.clone());
        let args = policy_generic_call_args(text.clone());
        var cur = unit_get_decls(self.source_unit);
        while (cur != null) {
            if (decl_get_kind(cur) == de_USE()) {
                let meta = decl_get_meta(cur);
                var alias = meta;
                let marker = meta.indexOf("|");
                if (marker == 0) { alias = ""; }
                else if (marker > 0) { alias = meta.substring(0, marker); }
                if (alias.len > 0 && alias == base) {
                    let target = decl_get_name(cur);
                    if (target.len == 0) { return ""; }
                    if (args.len > 0) { return target + "::<" + args + ">"; }
                    return target;
                }
            }
            cur = decl_get_next(cur);
        }
        return "";
    }

    fn canonical_type_text_in_function_env(self, text: string, fn_id: i32) -> string {
        if (text.len == 0) { return ""; }
        if (fn_id == hir_id_invalid()) {
            return self.canonical_type_text_in_current_env(text);
        }
        let saved_params = self.current_generic_params;
        let saved_args = self.current_generic_args;
        self.current_generic_params = hir_unit_function_generic_params(self.unit, fn_id);
        self.current_generic_args = hir_unit_function_generic_args(self.unit, fn_id);
        let out = self.canonical_type_text_in_current_env(text);
        self.current_generic_params = saved_params;
        self.current_generic_args = saved_args;
        return out;
    }

    fn concrete_owner_type_name_from_env(self, owner_decl: rawptr) -> string {
        if (owner_decl == null) { return ""; }
        let self_binding = self.current_generic_binding("Self");
        let owner_params = hir_builder_decl_template_params(owner_decl);
        if (self_binding.len > 0
            && self.owner_decl_accepts_owner_type(owner_decl, self_binding)
            && (owner_params.len == 0 || policy_generic_call_args(self_binding.clone()).len > 0)) {
            return self_binding;
        }
        if (owner_params.len == 0) { return ""; }
        var owner_args = "";
        var i: i32 = 0;
        while (i < 64) {
            let p = hir_builder_generic_param_at(owner_params, i);
            if (p.len == 0) {
                if (owner_args.len == 0) { return ""; }
                return policy_generic_call_base(decl_get_name(owner_decl)) + "::<" + owner_args + ">";
            }
            let a = self.current_generic_binding(p);
            if (a.len == 0) { return ""; }
            owner_args = hir_builder_append_csv(owner_args, a);
            i = i + 1;
        }
        if (self_binding.len > 0 && self.owner_decl_accepts_owner_type(owner_decl, self_binding)) {
            return self_binding;
        }
        return "";
    }

    fn concrete_owner_type_name(self, e: rawptr, owner_decl: rawptr) -> string {
        if (owner_decl == null) { return ""; }
        let owner_params = hir_builder_decl_template_params(owner_decl);
        let receiver = self.receiver_expr_for_call(e);
        if (receiver != null) {
            let explicit_receiver = self.resolve_type_text_in_current_env(expr_get_name(receiver));
            if (explicit_receiver.len > 0
                && self.raw_class_decl_for_type_text(explicit_receiver) != null
                && self.owner_decl_accepts_owner_type(owner_decl, explicit_receiver)
                && (owner_params.len == 0 || policy_generic_call_args(explicit_receiver.clone()).len > 0)) {
                return explicit_receiver;
            }
        }
        let receiver_text = self.type_text_from_expr(receiver);
        let receiver_owner = self.receiver_type_text_for_owner_decl(receiver_text, owner_decl);
        if (receiver_owner.len > 0
            && (owner_params.len == 0 || policy_generic_call_args(receiver_owner.clone()).len > 0)) {
            return receiver_owner;
        }
        let owner_name = decl_get_name(owner_decl);
        let owner_args = policy_generic_call_args(owner_name.clone());
        if (owner_args.len > 0) { return owner_name; }
        let env_owner = self.concrete_owner_type_name_from_env(owner_decl);
        if (env_owner.len > 0) { return env_owner; }
        return owner_name;
    }

    fn receiver_type_text_for_owner_decl(self, receiver_text: string, owner_decl: rawptr) -> string {
        if (receiver_text.len == 0 || owner_decl == null) { return ""; }
        let direct = self.resolve_type_text_in_current_env(receiver_text);
        if (direct.len == 0) { return ""; }
        if (self.owner_decl_matches_concrete_type(owner_decl, direct)) { return direct; }
        let payload = self.heap_indirect_payload_type_text(direct);
        if (payload.len > 0 && self.owner_decl_matches_concrete_type(owner_decl, payload)) {
            return payload;
        }
        return "";
    }

    fn type_text_is_box_lang_item(self, type_text: string) -> bool {
        let cd = self.raw_class_decl_for_type_text(type_text);
        if (cd == null) { return false; }
        if (hir_builder_decl_has_attr(cd, "lang_item(\"box\")")) { return true; }
        return hir_builder_type_base_name(type_text) == "Box";
    }

    fn type_text_is_heap_indirect_lang_item(self, type_text: string) -> bool {
        return self.type_text_is_ref_lang_item(type_text) || self.type_text_is_box_lang_item(type_text);
    }

    fn heap_indirect_payload_type_text(self, type_text: string) -> string {
        if (type_text.len == 0) { return ""; }
        let resolved = self.resolve_type_text_in_current_env(type_text);
        if (resolved.len == 0) { return ""; }
        if (!self.type_text_is_heap_indirect_lang_item(resolved)) { return ""; }
        let args = policy_generic_call_args(resolved.clone());
        let payload = policy_generic_arg_at(args, 0);
        if (payload.len == 0) { return ""; }
        return self.resolve_type_text_in_current_env(payload);
    }

    fn heap_indirect_member_owner_type_text(self, owner_type_name: string, member_name: string) -> string {
        if (owner_type_name.len == 0 || member_name.len == 0) { return ""; }
        let payload = self.heap_indirect_payload_type_text(owner_type_name);
        if (payload.len == 0) { return ""; }
        if (self.raw_member_decl_for_type_text(payload, member_name) != null) { return payload; }
        if (self.method_function_target_by_owner_type_and_method(payload, member_name) != hir_id_invalid()) {
            return payload;
        }
        return "";
    }

    fn variant_payload_types_text_from_env(self, variant_decl: rawptr, params: string, args: string) -> string {
        var out = "";
        var param = decl_get_params(variant_decl);
        while (param != null) {
            var param_ty = decl_get_ty(param);
            if (param_ty == null) { param_ty = tref_alloc(ty_VOID(), ""); }
            let type_id = self.type_id_from_ref_env(param_ty, params, args);
            let text = hir_type_table_text(self.unit.types, type_id);
            out = hir_builder_append_csv(out, text);
            param = decl_get_next(param);
        }
        return out;
    }

    fn variant_payload_count(self, variant_decl: rawptr) -> i32 {
        var count: i32 = 0;
        var param = decl_get_params(variant_decl);
        while (param != null) {
            count = count + 1;
            param = decl_get_next(param);
        }
        return count;
    }

    /// Mark a type id as structurally open when its text is known to mention
    /// an unbound template atom (env-aware check, so multi-character params
    /// such as `TKey` bound in the current env are recognized too).
    fn mark_type_open_if_text_open(self, type_id: i32, text: string) {
        if (type_id == hir_id_invalid() || text.len == 0) { return; }
        if (self.type_text_has_open_template_atom(text)
            || hir_builder_generic_contains(self.current_generic_params, text)) {
            self.unit.types.add_flags(type_id, hir_type_flag_open());
        }
    }

    /// Build the structured (ID-level) generic env row for a function
    /// instance: param names intern as open type atoms, args/owner intern as
    /// regular types. CSV on the function record remains a compatibility
    /// snapshot written first so re-entrant lookup sees a closed instance.
    fn set_structured_generic_env(self, fn_id: i32, params: string, args: string, owner_type_name: string) {
        if (fn_id == hir_id_invalid()) { return; }
        if (params.len == 0 && args.len == 0 && owner_type_name.len == 0) { return; }
        var param_head = hir_id_invalid();
        var param_tail = hir_id_invalid();
        var i: i32 = 0;
        while (i < 256) {
            let p = hir_builder_generic_param_at(params, i);
            if (p.len == 0) { break; }
            // Template parameters are atoms of this declaration, not module
            // type lookups.  Resolving `A` through type_id_from_text would
            // canonicalize it to a same-named class from another file of the
            // same multi-file module (e.g. `class A<T>` in a sibling unit),
            // poisoning the env params with the class's qualified name; the
            // cover check against the decl's raw parameter names then never
            // closes and the instance body is never built (deferred retries
            // exhausted).  Intern the bare atom instead.
            let param_type = self.unit.types.intern_name(p);
            if (param_type != hir_id_invalid()) {
                self.unit.types.add_flags(param_type, hir_type_flag_open());
                let node = self.unit.add_type_list_node(param_type);
                if (param_head == hir_id_invalid()) { param_head = node; }
                if (param_tail != hir_id_invalid()) {
                    self.unit.set_type_list_next(param_tail, node);
                }
                param_tail = node;
            }
            i = i + 1;
        }
        var arg_head = hir_id_invalid();
        var arg_tail = hir_id_invalid();
        var j: i32 = 0;
        while (j < 256) {
            let a = policy_generic_arg_at(args, j);
            if (a.len == 0) { break; }
            let arg_type = self.type_id_from_text(a);
            if (arg_type != hir_id_invalid()) {
                self.mark_type_open_if_text_open(arg_type, a);
                let node = self.unit.add_type_list_node(arg_type);
                if (arg_head == hir_id_invalid()) { arg_head = node; }
                if (arg_tail != hir_id_invalid()) {
                    self.unit.set_type_list_next(arg_tail, node);
                }
                arg_tail = node;
            }
            j = j + 1;
        }
        var owner_type_id = hir_id_invalid();
        if (owner_type_name.len > 0) {
            owner_type_id = self.type_id_from_text(owner_type_name);
            self.mark_type_open_if_text_open(owner_type_id, owner_type_name);
        }
        let env_id = self.unit.add_generic_env(param_head, arg_head, owner_type_id);
        self.unit.set_function_generic_env_id(fn_id, env_id);
        // Structured genv is the only truth once the row exists.
        self.unit.clear_function_generic_env_strings(fn_id);
    }

    /// Assign field_index/variant_tag ordinals over a completed member chain
    /// (chain order; inherited parent layout fields come first by
    /// construction, so indices match layout positions).
    fn assign_member_ordinals(self, class_item: i32) {
        if (class_item == hir_id_invalid()) { return; }
        var member = self.unit.item_first_member(class_item);
        var field_index: i32 = 0;
        var variant_tag: i32 = 0;
        var guard: i32 = 0;
        let guard_limit: i32 = self.unit.item_count + 2;
        while (member != hir_id_invalid() && guard < guard_limit) {
            let member_kind = self.unit.item_kind(member);
            // An impl borrows the target's member chain. Its fields keep the
            // ordinals assigned by their owning class, including inherited
            // fields that are absent from the impl's own chain.
            if (member_kind == hir_item_field() && self.unit.item_owner(member) == class_item) {
                self.unit.set_item_field_index(member, field_index);
                field_index = field_index + 1;
            } else if (member_kind == hir_item_variant() && self.unit.item_owner(member) == class_item) {
                self.unit.set_item_variant_tag(member, variant_tag);
                variant_tag = variant_tag + 1;
            }
            member = self.unit.item_next_sibling(member);
            guard = guard + 1;
        }
    }

    /// Record the folded const value when the item's init chain is a single
    /// statement holding a literal int/bool/char expression.
    fn record_folded_const_value(self, item_id: i32) {
        if (item_id == hir_id_invalid()) { return; }
        let init_stmt = self.unit.item_init(item_id);
        if (init_stmt == hir_id_invalid()) { return; }
        if (self.unit.stmt_next(init_stmt) != hir_id_invalid()) { return; }
        let init_expr = self.unit.stmt_expr(init_stmt);
        if (init_expr == hir_id_invalid()) { return; }
        let k = self.unit.expr_kind(init_expr);
        if (k == ex_INT_LIT() || k == ex_BOOL_LIT() || k == ex_CHAR_LIT()) {
            self.unit.set_item_const_value_i64(item_id, self.unit.expr_int_value(init_expr));
        }
    }

    fn variant_payload_type_list_from_env(self, variant_decl: rawptr, params: string, args: string) -> i32 {
        var head = hir_id_invalid();
        var tail = hir_id_invalid();
        var param = decl_get_params(variant_decl);
        while (param != null) {
            var param_ty = decl_get_ty(param);
            if (param_ty == null) { param_ty = tref_alloc(ty_VOID(), ""); }
            let type_id = self.type_id_from_ref_env(param_ty, params, args);
            let node = self.unit.add_type_list_node(type_id);
            if (head == hir_id_invalid()) { head = node; }
            if (tail != hir_id_invalid()) {
                self.unit.set_type_list_next(tail, node);
            }
            tail = node;
            param = decl_get_next(param);
        }
        return head;
    }

    fn set_variant_payload_metadata(self, variant_item: i32, variant_decl: rawptr, params: string, args: string) {
        if (variant_item == hir_id_invalid() || variant_decl == null) { return; }
        if (decl_get_kind(variant_decl) != de_VARIANT()) { return; }
        self.unit.set_item_variant_payloads(variant_item,
                                           self.variant_payload_types_text_from_env(variant_decl, params, args),
                                           self.variant_payload_count(variant_decl));
        self.unit.set_item_variant_payload_type_list(variant_item,
                                                    self.variant_payload_type_list_from_env(variant_decl, params, args));
    }

    fn canonical_owner_type_text_for_decl(self, owner_decl: rawptr, owner_type_name: string) -> string {
        if (owner_type_name.len == 0) { return ""; }
        var canonical = self.canonical_type_text_for_lookup(owner_type_name, 0);
        if (owner_decl == null) { return canonical; }
        let concrete_decl = self.raw_class_decl_for_type_text(canonical);
        if (concrete_decl != null
            && concrete_decl != owner_decl
            && self.class_decl_is_or_inherits(concrete_decl, owner_decl, 0)) {
            return canonical;
        }
        let owner_raw_name = decl_get_name(owner_decl);
        if (owner_raw_name.len == 0) { return canonical; }
        var owner_base = policy_generic_call_base(owner_raw_name);
        if (owner_base.len == 0) { owner_base = owner_raw_name; }
        if (owner_base.len == 0) { return canonical; }
        let args = policy_generic_call_args(canonical);
        if (args.len > 0) {
            return self.generic_text_with_args_like(canonical, owner_base, args);
        }
        return owner_base;
    }

    fn canonical_type_args_csv(self, args: string) -> string {
        if (args.len == 0) { return ""; }
        var out = "";
        var idx: i32 = 0;
        while (idx < 256) {
            let part = policy_generic_arg_at(args.clone(), idx);
            if (part.len == 0) { return out.clone(); }
            // Instance keys are created while lowering another generic body.
            // Close every explicit argument in that lexical environment before
            // canonical lookup, otherwise `callee::<T>` from `outer::<A>` is
            // cached as an open `T` instance instead of the concrete `A` one.
            let resolved = self.canonical_type_text_in_current_env(part);
            if (resolved.len == 0) { return ""; }
            out = hir_builder_append_csv(out,
                                         self.canonical_type_text_for_lookup(resolved, 0));
            idx = idx + 1;
        }
        return out.clone();
    }

    fn alias_class_instance_key(self,
                                       owner_decl: rawptr,
                                       alias_key: string,
                                       canonical_key: string,
                                       class_item: i32) {
        if (owner_decl == null
            || alias_key.len == 0
            || canonical_key.len == 0
            || alias_key == canonical_key
            || class_item == hir_id_invalid()) {
            return;
        }
        self.class_instances = hir_decl_instance_map_put(self.class_instances,
                                                         owner_decl,
                                                         alias_key,
                                                         class_item,
                                                         hir_id_invalid());
        var member = decl_get_members(owner_decl);
        while (member != null) {
            let mk = decl_get_kind(member);
            if (mk == de_FIELD()) {
                let field_item = hir_decl_instance_map_item(self.field_instances,member, canonical_key);
                if (field_item != hir_id_invalid()) {
                    self.field_instances = hir_decl_instance_map_put(self.field_instances,
                                                                     member,
                                                                     alias_key,
                                                                     field_item,
                                                                     hir_id_invalid());
                }
            } else if (mk == de_VARIANT()) {
                let variant_item = hir_decl_instance_map_item(self.variant_instances,member, canonical_key);
                if (variant_item != hir_id_invalid()) {
                    self.variant_instances = hir_decl_instance_map_put(self.variant_instances,
                                                                       member,
                                                                       alias_key,
                                                                       variant_item,
                                                                       hir_id_invalid());
                }
            } else if (mk == de_CONST() || mk == de_GLOBAL_VAR()) {
                let value_item = hir_decl_instance_map_item(self.member_value_instances,member, canonical_key);
                if (value_item != hir_id_invalid()) {
                    self.member_value_instances = hir_decl_instance_map_put(self.member_value_instances,
                                                                           member,
                                                                           alias_key,
                                                                           value_item,
                                                                           hir_id_invalid());
                }
            }
            member = decl_get_next(member);
        }
    }

    fn ensure_class_instance(self,
                                    owner_decl: rawptr,
                                    owner_type_name: string,
                                    owner_params: string,
                                    owner_args: string) -> i32 {
        if (owner_decl == null || owner_type_name.len == 0) { return hir_id_invalid(); }
        let owner_key = self.canonical_owner_type_text_for_decl(owner_decl, owner_type_name);
        if (owner_key.len == 0) { return hir_id_invalid(); }
        if (owner_params.len == 0 || owner_args.len == 0) {
            return hir_pointer_map_item(self.decl_map,owner_decl);
        }
        let existing = hir_decl_instance_map_item(self.class_instances,owner_decl, owner_key);
        if (existing != hir_id_invalid()) {
            self.alias_class_instance_key(owner_decl, owner_type_name, owner_key, existing);
            return existing;
        }
        let owner_type_id = self.type_id_from_text(owner_key);
        if (hir_builder_decl_is_value_type_record(owner_decl)) {
            self.unit.types.add_flags(owner_type_id, hir_type_flag_value_struct());
        }
        if (hir_builder_decl_is_foreign_dci(owner_decl)) {
            self.unit.types.add_flags(owner_type_id, hir_type_flag_foreign_dci());
        }
        if (hir_builder_decl_has_repr_c(owner_decl) || hir_builder_decl_is_packed(owner_decl)) {
            self.unit.types.add_flags(owner_type_id, hir_type_flag_repr_c());
        }
        if (hir_builder_decl_is_packed(owner_decl)) {
            self.unit.types.add_flags(owner_type_id, hir_type_flag_repr_packed());
        }
        let owner_repr_align = hir_builder_decl_repr_align(owner_decl);
        if (owner_repr_align > 0) {
            self.unit.types.add_flags(owner_type_id, hir_type_flag_repr_align(owner_repr_align as i32));
        }
        let class_item = self.unit.add_item(hir_builder_item_kind_from_decl(owner_decl),
                                           owner_key,
                                           owner_type_id,
                                           hir_id_invalid());
        if (hir_builder_decl_is_foreign_dci(owner_decl)) {
            self.unit.add_item_flags(class_item, hir_item_flag_foreign_dci());
        }
        self.index_registered_type_atom(hir_builder_item_kind_from_decl(owner_decl), owner_key);
        self.class_instances = hir_decl_instance_map_put(self.class_instances,owner_decl, owner_key, class_item, hir_id_invalid());
        var first_member = hir_id_invalid();
        var last_member = hir_id_invalid();
        var member = decl_get_members(owner_decl);
        while (member != null) {
            let mk = decl_get_kind(member);
            if (mk == de_FIELD() || mk == de_VARIANT() || mk == de_CONST() || mk == de_GLOBAL_VAR()) {
                var item_kind = hir_builder_item_kind_from_decl(member);
                // Register every closed type reachable through the concrete
                // member layout before method bodies inspect that layout.
                // A variant's own type is its enclosing enum; its payload
                // types live in its parameter declarations and must be walked
                // separately.
                if (mk == de_VARIANT()) {
                    var payload = decl_get_params(member);
                    while (payload != null) {
                        self.ensure_concrete_type_ref_ready(decl_get_ty(payload), owner_params, owner_args);
                        payload = decl_get_next(payload);
                    }
                } else {
                    self.ensure_concrete_type_ref_ready(decl_get_ty(member), owner_params, owner_args);
                }
                let member_type = self.type_id_from_ref_env(decl_get_ty(member), owner_params, owner_args);
                let member_item = self.unit.add_item(item_kind,
                                                    decl_get_name(member),
                                                    member_type,
                                                    class_item);
                if (item_kind == hir_item_field()) {
                    self.field_instances = hir_decl_instance_map_put(self.field_instances,member, owner_key, member_item, hir_id_invalid());
                    self.index_field_item(item_kind,
                                          class_item,
                                          decl_get_name(member),
                                          member_item,
                                          member);
                } else if (item_kind == hir_item_variant()) {
                    self.variant_instances = hir_decl_instance_map_put(self.variant_instances,member, owner_key, member_item, hir_id_invalid());
                    self.set_variant_payload_metadata(member_item, member, owner_params, owner_args);
                } else if (item_kind == hir_item_const() || item_kind == hir_item_global()) {
                    self.member_value_instances = hir_decl_instance_map_put(self.member_value_instances,member, owner_key, member_item, hir_id_invalid());
                    self.build_value_item_init_for_env(member, member_item, owner_params, owner_args);
                }
                if (first_member == hir_id_invalid()) { first_member = member_item; }
                if (last_member != hir_id_invalid()) {
                    self.unit.set_item_next_sibling(last_member, member_item);
                }
                last_member = member_item;
            }
            member = decl_get_next(member);
        }
        self.unit.set_item_first_member(class_item, first_member);
        self.assign_member_ordinals(class_item);
        self.alias_class_instance_key(owner_decl, owner_type_name, owner_key, class_item);
        // A *generic* stub class closes its foreign base here, not at its
        // declaration: `class VyxSink<T> : native.SinkG<T>` only has a base
        // (`native.SinkG<i32>`) once `T` is known.  Record the instance so the
        // stub spec list and the closed overrides exist before lowering.  This
        // runs after the `class_instances` put above, so a re-entrant lookup of
        // the same key returns early and cannot recurse.
        if (owner_params.len > 0 && owner_args.len > 0
            && self.class_decl_requires_dci_stub(owner_decl, 0)) {
            self.record_dci_stub_class_instance(owner_decl, owner_key, owner_params, owner_args);
        }
        return class_item;
    }

    fn build_value_item_init_for_env(self,
                                           value_decl: rawptr,
                                           item_id: i32,
                                           params: string,
                                           args: string) {
        if (value_decl == null || item_id == hir_id_invalid()) { return; }
        if (self.unit.item_init(item_id) != hir_id_invalid()) { return; }
        let saved_function = self.current_function_id;
        let saved_item = self.current_item_id;
        let saved_params = self.current_generic_params;
        let saved_args = self.current_generic_args;
        let saved_locals = self.locals.head;
        let saved_pack_bindings = self.pack_bindings.head;
        self.current_function_id = hir_id_invalid();
        self.current_item_id = item_id;
        self.current_generic_params = params;
        self.current_generic_args = args;
        self.locals = hir_local_scope_restore(self.locals, null);
        self.pack_bindings = hir_pack_bindings_restore(self.pack_bindings, null);
        let init_chain = self.build_stmt_chain(decl_get_body(value_decl));
        self.unit.set_item_init(item_id, init_chain.first);
        self.record_folded_const_value(item_id);
        self.locals = hir_local_scope_drop_to(self.locals, saved_locals);
        self.pack_bindings = hir_pack_bindings_drop_to(self.pack_bindings, saved_pack_bindings);
        self.current_generic_params = saved_params;
        self.current_generic_args = saved_args;
        self.current_item_id = saved_item;
        self.current_function_id = saved_function;
    }

    fn concrete_field_target(self, e: rawptr, raw_target: rawptr) -> i32 {
        if (raw_target == null) { return hir_id_invalid(); }
        var owner_decl = expr_get_semantic_owner(e);
        if (owner_decl == null) {
            owner_decl = hir_raw_owner_map_get(self.decl_owner_map,raw_target);
        }
        if (owner_decl == null) { return hir_pointer_map_item(self.decl_map,raw_target); }
        let owner_type_name = self.concrete_owner_type_name(e, owner_decl);
        let owner_params = self.owner_template_params_for_type_text(owner_decl, owner_type_name);
        let owner_args = self.owner_template_args_for_type_text(owner_params, owner_type_name);
        if (owner_params.len == 0 || owner_args.len == 0) {
            return hir_pointer_map_item(self.decl_map,raw_target);
        }
        self.ensure_class_instance(owner_decl, owner_type_name, owner_params, owner_args);
        let field_item = hir_decl_instance_map_item(self.field_instances,raw_target, owner_type_name);
        if (field_item != hir_id_invalid()) { return field_item; }
        return hir_pointer_map_item(self.decl_map,raw_target);
    }

    fn concrete_field_target_for_type_text(self, raw_target: rawptr, owner_decl: rawptr, owner_type_name: string) -> i32 {
        if (raw_target == null || owner_decl == null || owner_type_name.len == 0) { return hir_id_invalid(); }
        let owner_params = self.owner_template_params_for_type_text(owner_decl, owner_type_name);
        let owner_args = self.owner_template_args_for_type_text(owner_params, owner_type_name);
        var checked_concrete_owner = false;
        if (owner_params.len > 0 && owner_args.len > 0 && self.env_args_are_closed(owner_args)) {
            self.ensure_class_instance(owner_decl, owner_type_name, owner_params, owner_args);
            let concrete_field_item = hir_decl_instance_map_item(self.field_instances,raw_target, owner_type_name);
            if (concrete_field_item != hir_id_invalid()) { return concrete_field_item; }
            checked_concrete_owner = true;
        }
        let owner_type_id = self.type_id_from_text(owner_type_name);
        let layout_field = self.field_id_for_type_and_name(owner_type_id, decl_get_name(raw_target));
        if (layout_field != hir_id_invalid()) { return layout_field; }
        if (!checked_concrete_owner && owner_params.len > 0 && owner_args.len > 0 && self.env_args_are_closed(owner_args)) {
            self.ensure_class_instance(owner_decl, owner_type_name, owner_params, owner_args);
            let field_item = hir_decl_instance_map_item(self.field_instances,raw_target, owner_type_name);
            if (field_item != hir_id_invalid()) { return field_item; }
        }
        return hir_pointer_map_item(self.decl_map,raw_target);
    }

    fn concrete_member_value_target_for_type_text(self,
                                                        raw_target: rawptr,
                                                        owner_decl: rawptr,
                                                        owner_type_name: string) -> i32 {
        if (raw_target == null || owner_decl == null || owner_type_name.len == 0) { return hir_id_invalid(); }
        let owner_params = hir_builder_decl_template_params(owner_decl);
        let owner_args = hir_builder_owner_args_for_params(owner_params, owner_type_name);
        if (owner_params.len == 0 || owner_args.len == 0) {
            return hir_pointer_map_item(self.decl_map,raw_target);
        }
        self.ensure_class_instance(owner_decl, owner_type_name, owner_params, owner_args);
        let item_id = hir_decl_instance_map_item(self.member_value_instances,raw_target, owner_type_name);
        if (item_id != hir_id_invalid()) { return item_id; }
        return hir_pointer_map_item(self.decl_map,raw_target);
    }

    fn concrete_variant_target(self, e: rawptr, raw_target: rawptr) -> i32 {
        if (raw_target == null) { return hir_id_invalid(); }
        var owner_decl = expr_get_semantic_owner(e);
        if (owner_decl == null) {
            owner_decl = hir_raw_owner_map_get(self.decl_owner_map,raw_target);
        }
        if (owner_decl == null) { return hir_pointer_map_item(self.decl_map,raw_target); }
        let owner_type_name = self.concrete_owner_type_name(e, owner_decl);
        let owner_params = self.owner_template_params_for_type_text(owner_decl, owner_type_name);
        let owner_args = self.owner_template_args_for_type_text(owner_params, owner_type_name);
        if (owner_params.len == 0 || owner_args.len == 0) {
            return hir_pointer_map_item(self.decl_map,raw_target);
        }
        self.ensure_class_instance(owner_decl, owner_type_name, owner_params, owner_args);
        let variant_item = hir_decl_instance_map_item(self.variant_instances,raw_target, owner_type_name);
        if (variant_item != hir_id_invalid()) { return variant_item; }
        return hir_pointer_map_item(self.decl_map,raw_target);
    }

    fn concrete_variant_target_for_type_text(self, raw_target: rawptr, owner_decl: rawptr, owner_type_name: string) -> i32 {
        if (raw_target == null || owner_decl == null || owner_type_name.len == 0) { return hir_id_invalid(); }
        let owner_params = self.owner_template_params_for_type_text(owner_decl, owner_type_name);
        let owner_args = self.owner_template_args_for_type_text(owner_params, owner_type_name);
        if (owner_params.len == 0 || owner_args.len == 0) {
            return hir_pointer_map_item(self.decl_map,raw_target);
        }
        self.ensure_class_instance(owner_decl, owner_type_name, owner_params, owner_args);
        let variant_item = hir_decl_instance_map_item(self.variant_instances,raw_target, owner_type_name);
        if (variant_item != hir_id_invalid()) { return variant_item; }
        return hir_pointer_map_item(self.decl_map,raw_target);
    }

    fn variant_constructor_type_id_for_type_text(self, raw_target: rawptr, owner_decl: rawptr, owner_type_name: string) -> i32 {
        if (raw_target == null || owner_decl == null || owner_type_name.len == 0) { return hir_id_invalid(); }
        let owner_params = self.owner_template_params_for_type_text(owner_decl, owner_type_name);
        let owner_args = self.owner_template_args_for_type_text(owner_params, owner_type_name);
        let owner_type_id = self.type_id_from_text(owner_type_name);
        var count: i32 = 0;
        var param = decl_get_params(raw_target);
        while (param != null) {
            count = count + 1;
            param = decl_get_next(param);
        }
        if (count == 0) {
            return owner_type_id;
        }
        var buf: rawptr = null;
        if (count > 0) {
            buf = hir_profile_malloc((count * 8) as u64);
            if (buf != null) { memset(buf, 0, (count * 8) as u64); }
        }
        var idx: i32 = 0;
        param = decl_get_params(raw_target);
        while (param != null) {
            if (buf != null) {
                var param_ty = decl_get_ty(param);
                if (param_ty == null) { param_ty = tref_alloc(ty_VOID(), ""); }
                ast_write_rawptr(ptr_offset(buf, idx * 8),
                                 self.concrete_type_ref_from_env(param_ty, owner_params, owner_args));
            }
            idx = idx + 1;
            param = decl_get_next(param);
        }
        let concrete_ret = self.type_ref_from_type_id(owner_type_id);
        return self.unit.types.intern_type_ref(tref_alloc_fn(tref_alloc_tuple(buf, count as i64), concrete_ret));
    }

    fn raw_decl_owner_name(self, d: rawptr) -> string {
        if (d == null) { return ""; }
        let owner = hir_raw_owner_map_get(self.decl_owner_map,d);
        if (owner == null) { return ""; }
        return decl_get_name(owner);
    }

    fn raw_function_body_decl_for(self, d: rawptr) -> rawptr {
        if (d == null) { return null; }
        if (hir_builder_decl_is_foreign_dci_native(d)) { return null; }
        if (decl_get_body(d) != null) { return d; }
        let owner_name = self.raw_decl_owner_name(d);
        var cur = self.decl_map.head;
        while (cur != null) {
            let candidate = ast_read_rawptr(cur);
            if (candidate != null
                && candidate != d
                && decl_get_body(candidate) != null
                && hir_builder_type_owner_names_match(self.raw_decl_owner_name(candidate), owner_name)
                && hir_builder_decl_signature_matches(d, candidate)) {
                return candidate;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return null;
    }

    fn decl_signature_matches_in_env(self, concrete_decl: rawptr, template_decl: rawptr, params: string, args: string) -> bool {
        if (concrete_decl == null || template_decl == null) { return false; }
        if (params.len == 0 || args.len == 0) { return false; }
        if (decl_get_kind(concrete_decl) != decl_get_kind(template_decl)) { return false; }
        if (decl_get_name(concrete_decl) != decl_get_name(template_decl)) { return false; }
        if (hir_builder_decl_param_count(concrete_decl) != hir_builder_decl_param_count(template_decl)) {
            return false;
        }
        let concrete_ret = self.type_text_from_ref_env(decl_get_ty(concrete_decl), params, args);
        let template_ret = self.type_text_from_ref_env(decl_get_ty(template_decl), params, args);
        if (concrete_ret != template_ret) { return false; }
        var cp = decl_get_params(concrete_decl);
        var tp = decl_get_params(template_decl);
        while (cp != null && tp != null) {
            let concrete_param = self.type_text_from_ref_env(decl_get_ty(cp), params, args);
            let template_param = self.type_text_from_ref_env(decl_get_ty(tp), params, args);
            if (concrete_param != template_param) { return false; }
            cp = decl_get_next(cp);
            tp = decl_get_next(tp);
        }
        return cp == null && tp == null;
    }

    fn imported_impl_matches_trait_requirement(self,
                                                implementation: rawptr,
                                                requirement: rawptr,
                                                owner_type: string) -> bool {
        if (implementation == null || requirement == null || owner_type.len == 0
            || decl_get_kind(implementation) != de_METHOD()
            || decl_get_kind(requirement) != de_METHOD()
            || decl_get_name(implementation) != decl_get_name(requirement)
            || decl_get_is_static(implementation) != decl_get_is_static(requirement)) {
            return false;
        }
        // The receiver belongs to two different owners: the concrete type
        // and the interface. Compare the value parameters after substituting
        // Self, while requiring both declarations to have a receiver.
        var concrete_param = decl_get_params(implementation);
        var required_param = decl_get_params(requirement);
        if (concrete_param == null || required_param == null
            || decl_get_name(concrete_param) != "self"
            || decl_get_name(required_param) != "self") {
            return false;
        }
        concrete_param = decl_get_next(concrete_param);
        required_param = decl_get_next(required_param);
        while (concrete_param != null && required_param != null) {
            let concrete_type = self.type_text_from_ref_env(decl_get_ty(concrete_param), "Self", owner_type);
            let required_type = self.type_text_from_ref_env(decl_get_ty(required_param), "Self", owner_type);
            if (concrete_type != required_type) { return false; }
            concrete_param = decl_get_next(concrete_param);
            required_param = decl_get_next(required_param);
        }
        if (concrete_param != null || required_param != null) { return false; }
        return self.type_text_from_ref_env(decl_get_ty(implementation), "Self", owner_type)
            == self.type_text_from_ref_env(decl_get_ty(requirement), "Self", owner_type);
    }

    fn raw_function_body_decl_for_env(self, d: rawptr, params: string, args: string) -> rawptr {
        let exact = self.raw_function_body_decl_for(d);
        if (exact != null) { return exact; }
        if (d == null || params.len == 0 || args.len == 0) { return null; }
        let owner_name = self.raw_decl_owner_name(d);
        var cur = self.decl_map.head;
        while (cur != null) {
            let candidate = ast_read_rawptr(cur);
            if (candidate != null
                && candidate != d
                && decl_get_body(candidate) != null
                && hir_builder_type_owner_names_match(self.raw_decl_owner_name(candidate), owner_name)
                && self.decl_signature_matches_in_env(d, candidate, params, args)) {
                return candidate;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return null;
    }

    fn method_body_decl_for_instance(self, method_decl: rawptr) -> rawptr {
        let body_decl = self.raw_function_body_decl_for(method_decl);
        if (body_decl != null) { return body_decl; }
        return method_decl;
    }

    fn method_env_is_exact_self_owner(self,
                                              owner_type_name: string,
                                              params: string,
                                              args: string) -> bool {
        if (owner_type_name.len == 0) { return false; }
        if (hir_builder_generic_param_count(params) != 1) { return false; }
        if (hir_builder_generic_arg_count(args) != 1) { return false; }
        if (hir_builder_generic_param_at(params, 0) != "Self") { return false; }
        let self_arg = policy_generic_arg_at(args, 0);
        if (self_arg == owner_type_name) { return true; }
        return policy_type_name_equal(self_arg, owner_type_name);
    }

    fn method_receiver_env_can_use_direct_owner_body(self,
                                                     method_decl: rawptr,
                                                     owner_decl: rawptr,
                                                     receiver_type_name: string,
                                                     params: string,
                                                     args: string) -> bool {
        if (method_decl == null
            || owner_decl == null
            || receiver_type_name.len == 0
            || decl_get_kind(method_decl) != de_METHOD()) {
            return false;
        }
        if (hir_builder_decl_template_params(owner_decl).len > 0) { return false; }
        if (hir_builder_decl_template_params(method_decl).len > 0) { return false; }
        if (self.decl_body_has_template_type(method_decl)) { return false; }
        if (policy_generic_call_args(receiver_type_name.clone()).len > 0) { return false; }
        if (params.len == 0 && args.len == 0) { return true; }
        if (hir_builder_generic_param_count(params) != 1) { return false; }
        if (hir_builder_generic_arg_count(args) != 1) { return false; }
        if (hir_builder_generic_param_at(params, 0) != "Self") { return false; }
        let self_arg = policy_generic_arg_at(args, 0);
        if (self_arg.len == 0) { return false; }
        let method_owner = hir_raw_owner_map_get(self.decl_owner_map,method_decl);
        if (method_owner == null) { return false; }
        var receiver_decl = self.raw_class_decl_for_type_text(self_arg);
        if (receiver_decl == null) { receiver_decl = self.raw_class_decl_for_type_text(receiver_type_name); }
        if (receiver_decl == null) { return false; }
        if (receiver_decl == method_owner) { return true; }
        if (!self.class_decl_is_or_inherits(receiver_decl, method_owner, 0)) { return false; }
        let body_decl = self.method_body_decl_for_instance(method_decl);
        return !self.decl_body_has_self_member_call_cached(body_decl);
    }

    fn decl_body_has_self_member_call_cached(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        let cached = hir_raw_int_map_get(self.decl_self_member_call_cache,d);
        if (cached == 2) { return true; }
        if (cached == 1) { return false; }
        let out = hir_builder_decl_body_has_self_member_call(d);
        if (out) {
            self.decl_self_member_call_cache = hir_raw_int_map_put(self.decl_self_member_call_cache,d, 2);
        } else {
            self.decl_self_member_call_cache = hir_raw_int_map_put(self.decl_self_member_call_cache,d, 1);
        }
        return out;
    }

    fn direct_closed_method_function_if_no_instance_env(self,
                                                               method_decl: rawptr,
                                                               owner_decl: rawptr,
                                                               owner_type_name: string,
                                                               params: string,
                                                              args: string) -> i32 {
        let timing_enabled = hir_builder_env_enabled("VYX_HIR_DIRECT_METHOD_TIMING");
        var timing_start: i64 = 0;
        var timing_mark: i64 = 0;
        var timing_receiver_ms: i64 = 0;
        var timing_owner_ms: i64 = 0;
        var timing_generic_ms: i64 = 0;
        var timing_body_ms: i64 = 0;
        var timing_function_ms: i64 = 0;
        if (timing_enabled) {
            timing_start = vyx_bootstrap_now_ms();
            timing_mark = timing_start;
        }
        if (method_decl == null || decl_get_kind(method_decl) != de_METHOD()) {
            return hir_id_invalid();
        }
        let exact_self_owner_env = self.method_env_is_exact_self_owner(owner_type_name, params, args);
        if (params.len != 0 || args.len != 0) {
            if (!exact_self_owner_env
                && !self.method_receiver_env_can_use_direct_owner_body(method_decl,
                                                                       owner_decl,
                                                                       owner_type_name,
                                                                       params,
                                                                       args)) {
                return hir_id_invalid();
            }
        }
        if (timing_enabled) {
            let now_receiver = vyx_bootstrap_now_ms();
            timing_receiver_ms = now_receiver - timing_mark;
            timing_mark = now_receiver;
        }
        let method_owner_decl = hir_raw_owner_map_get(self.decl_owner_map,method_decl);
        var receiver_decl_for_owner: rawptr = null;
        if (method_owner_decl != null && owner_type_name.len > 0) {
            receiver_decl_for_owner = self.raw_class_decl_for_type_text(owner_type_name);
        }
        if (receiver_decl_for_owner != null) {
            let cached_direct_fn = hir_raw_pair_int_map_get(self.direct_method_function_cache,
                                                            receiver_decl_for_owner,
                                                            method_decl);
            if (cached_direct_fn > 0 && cached_direct_fn != hir_id_invalid()) {
                return cached_direct_fn;
            }
        }
        if (method_owner_decl != null && owner_type_name.len > 0) {
            if (receiver_decl_for_owner != method_owner_decl) {
                var inherited_owner = false;
                if (receiver_decl_for_owner != null
                    && self.class_decl_is_or_inherits(receiver_decl_for_owner, method_owner_decl, 0)) {
                    inherited_owner = true;
                }
                if (inherited_owner) {
                    let body_decl = self.method_body_decl_for_instance(method_decl);
                    if (self.decl_body_has_self_member_call_cached(body_decl)) {
                        return hir_id_invalid();
                    }
                } else if (!self.raw_owner_decl_matches_type_exact(method_owner_decl, owner_type_name)
                           && !hir_builder_str_lang_owner_names_match(decl_get_name(method_owner_decl),
                                                                      owner_type_name)) {
                    return hir_id_invalid();
                }
            }
        }
        if (timing_enabled) {
            let now_owner = vyx_bootstrap_now_ms();
            timing_owner_ms = now_owner - timing_mark;
            timing_mark = now_owner;
        }
        let exact_non_generic_owner_env = owner_type_name.len > 0
            && params.len == 0
            && args.len == 0
            && method_owner_decl != null
            && receiver_decl_for_owner == method_owner_decl
            && hir_builder_decl_template_params(method_owner_decl).len == 0
            && policy_generic_call_args(owner_type_name.clone()).len == 0;
        if (timing_enabled) {
            let now_generic = vyx_bootstrap_now_ms();
            timing_generic_ms = now_generic - timing_mark;
            timing_mark = now_generic;
        }
        if (method_owner_decl != null
            && owner_decl != null
            && method_owner_decl != owner_decl
            && (decl_get_generic_flags(method_owner_decl) & 2) != 0) {
            return hir_id_invalid();
        }
        if (owner_decl != null && hir_builder_decl_template_params(owner_decl).len > 0) {
            return hir_id_invalid();
        }
        if (owner_type_name.len > 0 && policy_generic_call_args(owner_type_name.clone()).len > 0) {
            return hir_id_invalid();
        }
        let method_body_has_template = self.decl_body_has_template_type(method_decl);
        if (method_body_has_template && !exact_self_owner_env && !exact_non_generic_owner_env) {
            return hir_id_invalid();
        }
        if (timing_enabled) {
            let now_body = vyx_bootstrap_now_ms();
            timing_body_ms = now_body - timing_mark;
            timing_mark = now_body;
        }
        let direct_fn = hir_pointer_map_function(self.decl_map,method_decl);
        if (direct_fn == hir_id_invalid()) {
            return hir_id_invalid();
        }
        let direct_fn_known_closed = !method_body_has_template
            && method_owner_decl != null
            && hir_builder_decl_template_params(method_owner_decl).len == 0
            && hir_builder_decl_template_params(method_decl).len == 0
            && owner_type_name.len > 0
            && policy_generic_call_args(owner_type_name.clone()).len == 0;
        if (!direct_fn_known_closed && self.function_has_open_template_types(direct_fn)) {
            return hir_id_invalid();
        }
        self.ensure_reachable_function_body(method_decl, direct_fn, false);
        if (receiver_decl_for_owner != null) {
            self.direct_method_function_cache = hir_raw_pair_int_map_put(self.direct_method_function_cache,
                                                                         receiver_decl_for_owner,
                                                                         method_decl,
                                                                         direct_fn);
        }
        if (timing_enabled) {
            timing_function_ms = vyx_bootstrap_now_ms() - timing_mark;
            let total = vyx_bootstrap_now_ms() - timing_start;
            if (total >= hir_builder_slow_expr_threshold_ms()) {
                print("[hir-direct-method] owner=" + owner_type_name
                      + " method=" + decl_get_name(method_decl)
                      + " total=" + policy_i64_to_string(total)
                      + " receiver=" + policy_i64_to_string(timing_receiver_ms)
                      + " ownercheck=" + policy_i64_to_string(timing_owner_ms)
                      + " generic=" + policy_i64_to_string(timing_generic_ms)
                      + " body=" + policy_i64_to_string(timing_body_ms)
                      + " function=" + policy_i64_to_string(timing_function_ms)
                      + " fn=" + self.i32_text(direct_fn));
            }
        }
        return direct_fn;
    }

    fn generic_owner_decl_for_method_body(self, method_decl: rawptr, default_owner: rawptr) -> rawptr {
        if (method_decl != null) {
            let body_decl = self.method_body_decl_for_instance(method_decl);
            let body_owner = hir_raw_owner_map_get(self.decl_owner_map,body_decl);
            if (body_owner != null
                && hir_builder_decl_template_params(body_owner).len > 0) {
                return body_owner;
            }
            let direct_owner = hir_raw_owner_map_get(self.decl_owner_map,method_decl);
            if (direct_owner != null
                && hir_builder_decl_template_params(direct_owner).len > 0) {
                return direct_owner;
            }
        }
        return default_owner;
    }

    fn ensure_function_instance(self,
                                       fn_decl: rawptr,
                                       owner_decl: rawptr,
                                       owner_type_name: string,
                                       params: string,
                                       args: string) -> i32 {
        if (fn_decl == null) { return hir_id_invalid(); }
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
            print("[hir-progress] ensure-instance fn=" + decl_get_name(fn_decl)
                  + " params_in=" + params
                  + " decl_params=" + hir_builder_decl_template_params(fn_decl)
                  + " args=" + args);
        }
        // A generic caller's environment is lexical context, not an implicit
        // template list for every callee.  Reusing it for an ordinary free
        // function creates a bodyless `mir2$helper::T=>...` symbol even though
        // the declared helper has one stable, non-generic ABI identity.
        // Methods stay on the instance path because synthetic `Self` and a
        // generic owner can legitimately specialize their bodies.
        if (decl_get_kind(fn_decl) == de_FN()
            && hir_builder_decl_template_params(fn_decl).len == 0) {
            let direct_fn = hir_pointer_map_function(self.decl_map,fn_decl);
            if (direct_fn != hir_id_invalid()) {
                self.ensure_reachable_function_body(fn_decl, direct_fn, false);
                return direct_fn;
            }
            return hir_id_invalid();
        }
        // Foreign DCI declarations name a concrete native ABI entrypoint.
        // They are never language templates, even if a derived receiver
        // contributes a synthetic `Self` environment during method lookup.
        // Reusing the declaration target preserves the original DCI owner so
        // LLVM can perform any required base-subobject adjustment. Creating a
        // specialized shell here instead changes that owner to the derived
        // type and silently corrupts non-primary C++ base calls.
        // Constructors are overload-selected before instantiation (for
        // example A() versus A(i32)); retain that resolver path so argument
        // shape remains part of the selection. Ordinary native methods have
        // no language specialization semantics and can use their declaration
        // target directly.
        // DCI *open generic* declarations (`fn f<T>(...) -> T;` inside
        // `extern "dci"`) are the exception: each call site closes `T` and
        // the Active Adapter materializes the concrete native entrypoint, so
        // they must fall through to the instance machinery below.
        //
        // A method of a *generic record* is the second exception, and for the
        // same reason: `struct Pair2<A, B> { fn get_first() const -> A; }` has
        // no template parameters of its own, but both its `self` receiver and
        // its signature stay open until the owner's arguments are substituted.
        // Reusing the declaration target would hand back a function whose
        // receiver is the bare `Pair2` and whose return type is the unbound
        // `A`; the caller rejects it as still-open and the call site ends up
        // with no callee at all.  Falling through builds the concrete owner
        // class instance plus a bodiless `foreign_dci | declaration_only`
        // method closed to `Pair2::<f64,i32> -> f64`, which is the shape the
        // contract's per-instance `kind=method` symbol links against.
        //
        // The guard is deliberately narrow: it fires only when the owner is a
        // template *and* the receiver names concrete arguments, so plain DCI
        // records (`Vec2::norm1`) and non-primary base-subobject adjustment
        // keep the original declaration-target behaviour untouched.
        let owner_needs_instance = owner_decl != null
            && hir_builder_decl_template_params(owner_decl).len > 0
            && policy_generic_call_args(owner_type_name.clone()).len > 0;
        if (hir_builder_decl_is_foreign_dci_native(fn_decl)
            && hir_builder_decl_template_params(fn_decl).len == 0
            && !hir_builder_decl_is_foreign_dci_ctor(fn_decl)
            && !owner_needs_instance) {
            let direct_fn = hir_pointer_map_function(self.decl_map,fn_decl);
            if (direct_fn != hir_id_invalid()) {
                self.ensure_reachable_function_body(fn_decl, direct_fn, false);
                return direct_fn;
            }
            return hir_id_invalid();
        }
        let timing_enabled = hir_builder_env_enabled("VYX_HIR_FUNCTION_INSTANCE_TIMING");
        var timing_start: i64 = 0;
        var timing_mark: i64 = 0;
        var timing_key_ms: i64 = 0;
        var timing_checks_ms: i64 = 0;
        var timing_owner_ms: i64 = 0;
        var timing_shell_ms: i64 = 0;
        var timing_ret_ms: i64 = 0;
        var timing_async_ms: i64 = 0;
        var timing_params_ms: i64 = 0;
        var timing_locals_ready_ms: i64 = 0;
        var timing_schedule_ms: i64 = 0;
        if (timing_enabled) {
            timing_start = vyx_bootstrap_now_ms();
            timing_mark = timing_start;
        }
        var owner_key = owner_type_name;
        // Like explicit arguments, a receiver owner can carry an outer
        // template atom (`Self`, `T`, or `Box::<T>`).  Resolve it at the
        // instance sink before deriving the ABI/cache identity.
        let resolved_owner = self.canonical_type_text_in_current_env(owner_key);
        if (resolved_owner.len > 0) {
            owner_key = resolved_owner;
        }
        if (owner_key.len > 0) {
            owner_key = self.canonical_owner_type_text_for_decl(owner_decl, owner_key);
        }
        let args_key = self.canonical_type_args_csv(args);
        self.profile_function_instance_phase("enter-instance", fn_decl, owner_key, params, args_key);
        if (timing_enabled) {
            let now_key = vyx_bootstrap_now_ms();
            timing_key_ms = now_key - timing_mark;
            timing_mark = now_key;
        }
        if (!self.owner_type_covers_owner_decl(owner_decl, owner_key)) {
            return hir_id_invalid();
        }
        let key = hir_builder_env_key(params, args_key);
        if (key.len == 0) {
            let direct_fn = hir_pointer_map_function(self.decl_map,fn_decl);
            self.ensure_reachable_function_body(fn_decl, direct_fn, false);
            self.profile_function_instance_phase("direct-instance", fn_decl, owner_key, params, args_key);
            return direct_fn;
        }
        if (!self.env_args_cover_params_for_decl(fn_decl, params, args_key)) {
            return hir_id_invalid();
        }
        if (!self.env_args_closed_for_decl(fn_decl, params, args_key)) {
            return hir_id_invalid();
        }
        if (owner_key.len > 0) {
            self.ensure_concrete_type_text_known(owner_key);
        }
        if (timing_enabled) {
            let now_checks = vyx_bootstrap_now_ms();
            timing_checks_ms = now_checks - timing_mark;
            timing_mark = now_checks;
        }
        let existing = hir_decl_instance_map_function(self.function_instances,fn_decl, key);
        if (existing != hir_id_invalid()) {
            self.ensure_reachable_function_body(fn_decl, existing, false);
            self.profile_function_instance_phase("reuse-instance", fn_decl, owner_key, params, args_key);
            return existing;
        }
        var owner_item = hir_id_invalid();
        let owner_params = hir_builder_decl_template_params(owner_decl);
        let owner_args = hir_builder_owner_args_for_params(owner_params, owner_key);
        if (owner_decl != null && owner_params.len > 0 && owner_args.len > 0) {
            owner_item = self.ensure_class_instance(owner_decl, owner_key, owner_params, owner_args);
        } else if (owner_decl != null) {
            owner_item = hir_pointer_map_item(self.decl_map,owner_decl);
        }
        if (timing_enabled) {
            let now_owner = vyx_bootstrap_now_ms();
            timing_owner_ms = now_owner - timing_mark;
            timing_mark = now_owner;
        }
        // Register the instance shell in the cache BEFORE the heavy
        // re-materialization steps (return type, param locals, body). Those
        // steps can re-enter ensure_function_instance with the same key;
        // without the early registration each re-entry missed the cache and
        // built a fresh duplicate instance, recursing without a floor.
        var item_name = hir_builder_function_instance_name(decl_get_name(fn_decl), owner_key, params, args_key);
        if (hir_builder_decl_is_foreign_dci(fn_decl)
            && hir_builder_decl_template_params(fn_decl).len > 0) {
            // Open-generic DCI instances keep a flat, linkable name: the
            // Active Adapter exports the native entrypoint under exactly
            // this symbol, so it must never wear the `mir2$` mask.
            item_name = hir_builder_foreign_dci_instance_name(decl_get_name(fn_decl), args_key);
        }
        let item_id = self.unit.add_item(hir_builder_item_kind_from_decl(fn_decl),
                                        item_name,
                                        hir_id_invalid(),
                                        owner_item);
        let fn_id = self.unit.add_function(item_id, item_name, hir_id_invalid());
        self.unit.set_function_symbol_discriminator(fn_id,
            hir_builder_decl_symbol_discriminator(fn_decl, owner_decl));
        // The instance is registered under its mangled name, so carry the
        // "is a value constructor" fact on the function itself. Without it
        // `add_function_param_locals_with_owner` never synthesized the hidden
        // `self` receiver and every `self.field = …` in the body resolved to
        // no place at all, silently dropping the whole constructor body.
        // Foreign DCI constructors own their ABI; leave them untouched.
        if (decl_get_name(fn_decl) == "constructor"
            && !hir_builder_decl_is_foreign_dci(fn_decl)) {
            self.unit.add_function_flags(fn_id, hir_function_flag_constructor());
        }
        self.apply_function_codegen_attr_flags(fn_decl, fn_id);
        self.unit.set_function_generic_env(fn_id, params, args_key, owner_key);
        // Publish the reverse provenance as soon as the textual environment is
        // available. Type interning while constructing the structured env can
        // re-enter generic lookup; it must observe this closed instance rather
        // than treating its fresh FunctionId as an unbound declaration shell.
        self.function_instances = hir_decl_instance_map_put(self.function_instances,
                                                             fn_decl,
                                                             key,
                                                             item_id,
                                                             fn_id);
        self.set_structured_generic_env(fn_id, params, args_key, owner_key);
        self.unit.clear_function_generic_env_strings(fn_id);
        if (self.env_args_closed_for_decl(fn_decl, params, args_key)
            && (owner_key.len == 0
                || !self.type_text_has_open_template_atom_without_env(owner_key))) {
            self.unit.add_function_flags(fn_id, hir_function_flag_closed_generic_env());
        }
        if (self.decl_is_foreign_import(fn_decl) || self.decl_is_foreign_import(owner_decl)) {
            self.unit.add_function_flags(fn_id, hir_function_flag_imported_body());
        }
        if (hir_builder_decl_is_task_callable(fn_decl)) {
            self.unit.add_function_flags(fn_id, hir_function_flag_async_task());
        }
            if (hir_builder_decl_is_foreign_dci_native(fn_decl)) {
                self.unit.add_function_flags(fn_id,
                                            hir_function_flag_foreign_dci()
                                            | hir_function_flag_declaration_only());
                if (hir_builder_decl_is_foreign_dci_ctor(fn_decl)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_ctor());
                }
                if (hir_builder_decl_is_foreign_dci_dtor(fn_decl)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_dtor());
                }
                if (hir_builder_decl_is_foreign_dci_const_method(fn_decl)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_const_method());
                }
                if (hir_builder_decl_is_foreign_dci_virtual_method(fn_decl)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_virtual_method());
                }
                if (hir_builder_decl_is_foreign_dci_override_method(fn_decl)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_override_method());
                }
                if (hir_builder_decl_is_foreign_dci_final_method(fn_decl)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_final_method());
                }
            }
            if (hir_builder_decl_is_foreign_dci(fn_decl)) {
                if (hir_builder_decl_is_foreign_dci_virtual_method(fn_decl)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_virtual_method());
                }
                if (hir_builder_decl_is_foreign_dci_override_method(fn_decl)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_override_method());
                }
                if (hir_builder_decl_is_foreign_dci_final_method(fn_decl)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_final_method());
                }
            }
            if (owner_decl != null && self.class_decl_requires_dci_stub(owner_decl, 0)) {
                if (hir_builder_decl_has_marker(fn_decl, "virtual")) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_virtual_method());
                }
                if (hir_builder_decl_has_marker(fn_decl, "override")) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_override_method());
                }
                if (hir_builder_decl_has_marker(fn_decl, "final")) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_final_method());
                }
            }
        if (timing_enabled) {
            let now_shell = vyx_bootstrap_now_ms();
            timing_shell_ms = now_shell - timing_mark;
            timing_mark = now_shell;
        }
        var ret_type = self.canonical_function_return_type_id_from_env(fn_decl, params, args_key);
        if (ret_type != hir_id_invalid()) {
            self.ensure_concrete_type_text_known(hir_type_table_text(self.unit.types, ret_type));
        }
        let item_rec = self.unit.item_record(item_id);
        if (item_rec != null) { ast_write_i32(ptr_offset(item_rec, 8), ret_type); }
        let fn_rec = self.unit.function_record(fn_id);
        if (fn_rec != null) { ast_write_i32(ptr_offset(fn_rec, 8), ret_type); }
        self.index_free_function(hir_builder_item_kind_from_decl(fn_decl), item_name, fn_id);
        if (timing_enabled) {
            let now_ret = vyx_bootstrap_now_ms();
            timing_ret_ms = now_ret - timing_mark;
            timing_mark = now_ret;
        }
        self.ensure_async_runtime_methods_for_task_return(fn_id);
        if (timing_enabled) {
            let now_async = vyx_bootstrap_now_ms();
            timing_async_ms = now_async - timing_mark;
            timing_mark = now_async;
        }
        if (hir_builder_item_kind_from_decl(fn_decl) == hir_item_method()
            && hir_builder_decl_template_params(fn_decl).len == 0) {
            self.note_closed_method_instance(owner_key, decl_get_name(fn_decl), fn_id);
        }
        let saved_params = self.current_generic_params;
        let saved_args = self.current_generic_args;
        self.current_generic_params = params;
        self.current_generic_args = args_key;
        self.add_function_param_locals_with_owner(fn_id, fn_decl, owner_key);
        if (timing_enabled) {
            let now_params = vyx_bootstrap_now_ms();
            timing_params_ms = now_params - timing_mark;
            timing_mark = now_params;
        }
        var local_id = self.unit.function_first_local(fn_id);
        while (local_id != hir_id_invalid()) {
            self.ensure_concrete_type_text_known(hir_type_table_text(self.unit.types, self.unit.local_type(local_id)));
            local_id = self.unit.local_next(local_id);
        }
        if (timing_enabled) {
            let now_locals = vyx_bootstrap_now_ms();
            timing_locals_ready_ms = now_locals - timing_mark;
            timing_mark = now_locals;
        }
        self.ensure_reachable_function_body(fn_decl, fn_id, false);
        self.current_generic_params = saved_params;
        self.current_generic_args = saved_args;
        if (timing_enabled) {
            timing_schedule_ms = vyx_bootstrap_now_ms() - timing_mark;
        }
        self.profile_function_instance_phase("leave-instance", fn_decl, owner_key, params, args_key);
        if (timing_enabled) {
            let total = vyx_bootstrap_now_ms() - timing_start;
            if (total >= hir_builder_slow_expr_threshold_ms()) {
                print("[hir-function-instance] fn=" + decl_get_name(fn_decl)
                      + " owner=" + owner_key
                      + " total=" + policy_i64_to_string(total)
                      + " key=" + policy_i64_to_string(timing_key_ms)
                      + " checks=" + policy_i64_to_string(timing_checks_ms)
                      + " owner_item=" + policy_i64_to_string(timing_owner_ms)
                      + " shell=" + policy_i64_to_string(timing_shell_ms)
                      + " ret=" + policy_i64_to_string(timing_ret_ms)
                      + " async=" + policy_i64_to_string(timing_async_ms)
                      + " params=" + policy_i64_to_string(timing_params_ms)
                      + " locals_ready=" + policy_i64_to_string(timing_locals_ready_ms)
                      + " schedule=" + policy_i64_to_string(timing_schedule_ms)
                      + " id=" + self.i32_text(fn_id));
            }
        }
        return fn_id;
    }

    fn owner_type_covers_owner_decl(self, owner_decl: rawptr, owner_type_name: string) -> bool {
        if (owner_decl == null) { return true; }
        if (owner_type_name.len > 0 && !self.owner_decl_accepts_owner_type(owner_decl, owner_type_name)) {
            return false;
        }
        let owner_params = hir_builder_decl_template_params(owner_decl);
        if (owner_params.len == 0) { return true; }
        if (owner_type_name.len == 0) { return false; }
        let owner_args = hir_builder_owner_args_for_params(owner_params, owner_type_name);
        return hir_builder_env_args_cover_params(owner_params, owner_args);
    }

    fn build_function_instance_body_if_ready(self,
                                                   fn_decl: rawptr,
                                                   fn_id: i32,
                                                   item_id: i32,
                                                   params: string,
                                                   args: string) {
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
            var fn_name_dbg = "";
            if (fn_decl != null) { fn_name_dbg = decl_get_name(fn_decl); }
            print("[hir-progress] instance-body-enter fn="
                  + fn_name_dbg
                  + " id=" + self.i32_text(fn_id)
                  + " params=" + params
                  + " args=" + args);
        }
        if (fn_decl == null || fn_id == hir_id_invalid()) { return; }
        if (self.unit.function_body(fn_id) != hir_id_invalid()) { return; }
        if (self.body_building(fn_id)) {
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
                print("[hir-progress] instance-body-exit reason=body_building id=" + self.i32_text(fn_id));
            }
            return;
        }
        if (!self.env_args_are_closed(args)) {
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
                print("[hir-progress] instance-body-exit reason=args_open id=" + self.i32_text(fn_id) + " args=" + args);
            }
            return;
        }
        let body_decl = self.raw_function_body_decl_for_env(fn_decl, params, args);
        if (body_decl == null) {
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
                print("[hir-progress] instance-body-exit reason=no_body_decl id=" + self.i32_text(fn_id) + " params=" + params);
            }
            return;
        }
        // A `@[discard]` tombstone never owns a body in any instantiation
        // (see `hir_builder_decl_is_discarded`): publish the terminal
        // decision instead of building an empty body or leaving the request
        // retryable for MIR to trip over later.
        if (hir_builder_decl_is_discarded(fn_decl)
            || hir_builder_decl_is_discarded(body_decl)) {
            self.unit.add_function_flags(fn_id, hir_function_flag_declaration_only());
            self.close_function_body_request(fn_id);
            return;
        }
        let saved_params = self.current_generic_params;
        let saved_args = self.current_generic_args;
        let saved_body_building = self.body_building_head;
        self.current_generic_params = params;
        self.current_generic_args = args;
        if (self.function_has_open_template_types(fn_id)) {
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
                print("[hir-progress] instance-body-exit reason=fn_open_template_types id=" + self.i32_text(fn_id) + " params=" + params);
            }
            self.current_generic_params = saved_params;
            self.current_generic_args = saved_args;
            self.body_building_head = saved_body_building;
            return;
        }
        if (!self.decl_body_types_close_in_current_env(body_decl)) {
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
                print("[hir-progress] instance-body-exit reason=body_types_open id=" + self.i32_text(fn_id) + " params=" + params);
            }
            self.current_generic_params = saved_params;
            self.current_generic_args = saved_args;
            self.body_building_head = saved_body_building;
            return;
        }
        let saved_function = self.current_function_id;
        let saved_item = self.current_item_id;
        let saved_locals = self.locals.head;
        let saved_pack_bindings = self.pack_bindings.head;
        self.push_body_building(body_decl, fn_id);
        self.profile_body_phase("enter-instance", body_decl, fn_id);
        self.current_function_id = fn_id;
        self.current_item_id = item_id;
        self.locals = hir_local_scope_restore(self.locals, null);
        self.pack_bindings = hir_pack_bindings_restore(self.pack_bindings, null);
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
            print("[hir-progress] instance-body-before-params id=" + self.i32_text(fn_id));
        }
        self.refresh_function_param_drop_metadata(fn_id, body_decl);
        self.bind_function_param_scope(fn_id, body_decl);
        self.ensure_task_ready_for_function_return(body_decl, fn_id);
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
            print("[hir-progress] instance-body-before-stmts id=" + self.i32_text(fn_id));
        }
        let body_chain = self.build_stmt_chain(decl_get_body(body_decl));
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
            print("[hir-progress] instance-body-after-stmts id=" + self.i32_text(fn_id)
                  + " first=" + self.i32_text(body_chain.first)
                  + " count=" + self.i32_text(body_chain.count));
        }
        self.unit.set_function_body(fn_id, body_chain.first, body_chain.count);
        self.locals = hir_local_scope_drop_to(self.locals, saved_locals);
        self.pack_bindings = hir_pack_bindings_drop_to(self.pack_bindings, saved_pack_bindings);
        self.current_item_id = saved_item;
        self.current_function_id = saved_function;
        self.current_generic_params = saved_params;
        self.current_generic_args = saved_args;
        self.body_building_head = saved_body_building;
        self.profile_body_phase("leave-instance", body_decl, fn_id);
    }

    fn owner_item_matches_type(self, owner_item: i32, owner_type_name: string) -> bool {
        if (owner_item == hir_id_invalid() || owner_type_name.len == 0) { return false; }
        let item_name = self.unit.item_name(owner_item);
        if (item_name.len == 0) { return false; }
        let owner_base = policy_generic_call_base(owner_type_name);
        if (item_name == owner_base) { return true; }
        if (hir_builder_last_path_segment(item_name) == hir_builder_last_path_segment(owner_base)) { return true; }
        if (hir_builder_type_owner_names_match(item_name, owner_type_name)) { return true; }
        return false;
    }

    fn owner_item_matches_type_exact(self, owner_item: i32, owner_type_name: string) -> bool {
        if (owner_item == hir_id_invalid() || owner_type_name.len == 0) { return false; }
        let item_name = self.unit.item_name(owner_item);
        if (item_name.len == 0) { return false; }
        if (item_name == owner_type_name || policy_type_name_equal(item_name, owner_type_name)) { return true; }
        let owner_base = policy_generic_call_base(owner_type_name);
        if (owner_base.len > 0 && (item_name == owner_base || policy_type_name_equal(item_name, owner_base))) {
            return true;
        }
        return false;
    }

    fn function_candidate_has_exact_owner_type(self, fn_id: i32, owner_type_name: string) -> bool {
        if (fn_id == hir_id_invalid() || owner_type_name.len == 0) { return false; }
        let function_owner_type = hir_unit_function_owner_type(self.unit, fn_id);
        if (function_owner_type.len > 0) {
            if (function_owner_type == owner_type_name) { return true; }
            return policy_type_name_equal(function_owner_type, owner_type_name);
        }
        let item_id = self.unit.function_item(fn_id);
        if (item_id == hir_id_invalid()) { return false; }
        return self.owner_item_matches_type_exact(self.unit.item_owner(item_id), owner_type_name);
    }

    fn function_candidate_covers_owner_type(self, fn_id: i32, owner_type_name: string) -> bool {
        if (fn_id == hir_id_invalid() || owner_type_name.len == 0) { return true; }
        let owner_args = policy_generic_call_args(owner_type_name.clone());
        if (owner_args.len == 0) { return true; }
        let function_owner_type = hir_unit_function_owner_type(self.unit, fn_id);
        if (function_owner_type.len > 0) {
            if (function_owner_type == owner_type_name) { return true; }
            if (policy_type_name_equal(function_owner_type, owner_type_name)) { return true; }
            return false;
        }
        let item_id = self.unit.function_item(fn_id);
        if (item_id == hir_id_invalid()) { return false; }
        let owner_item = self.unit.item_owner(item_id);
        if (owner_item == hir_id_invalid()) { return true; }
        let owner_item_name = self.unit.item_name(owner_item);
        if (policy_generic_call_args(owner_item_name.clone()).len > 0) {
            return owner_item_name == owner_type_name || policy_type_name_equal(owner_item_name, owner_type_name);
        }
        let owner_raw = hir_pointer_map_raw_for_item(self.decl_map,owner_item);
        if (owner_raw != null && hir_builder_decl_template_params(owner_raw).len > 0) {
            return false;
        }
        return true;
    }

    fn env_args_closed_for_decl(self, d: rawptr, params: string, args: string) -> bool {
        if (!self.env_args_cover_params_for_decl(d, params, args)) { return false; }
        if (self.env_args_reference_params(params, args)) { return false; }
        return self.env_args_are_closed(args);
    }

    // The function environment may contain an unrelated owner or synthetic
    // `Self` binding. Closure for a raw generic declaration requires every
    // parameter declared by that declaration to be bound concretely, rather
    // than merely treating an empty environment as vacuously closed.
    fn decl_template_params_closed_in_function_env(self,
                                                   d: rawptr,
                                                   env_params: string,
                                                   env_args: string) -> bool {
        let required_params = hir_builder_decl_template_params(d);
        if (required_params.len == 0) { return true; }
        // `...args: Ts` is represented by one template parameter but zero or
        // more flattened environment arguments.  In particular, `f()` for
        // `fn f<...Ts>(...args: Ts)` has `params=Ts,args=""`: that is a
        // closed empty pack, not an unbound ordinary generic parameter.
        // First validate the complete parameter shape, then map trailing
        // parameters around a pack back to their actual flattened arguments.
        if (!self.env_args_cover_params_for_decl(d, env_params, env_args)) {
            return false;
        }
        var pack_name = "";
        var raw_param = decl_get_params(d);
        while (raw_param != null && pack_name.len == 0) {
            if (hir_builder_variadic_param(raw_param)) {
                pack_name = hir_builder_param_pack_type_name(raw_param);
            }
            raw_param = decl_get_next(raw_param);
        }
        var env_param_count: i32 = 0;
        var pack_index: i32 = -1;
        while (env_param_count < 64) {
            let env_param = hir_builder_generic_param_at(env_params, env_param_count);
            if (env_param.len == 0) { break; }
            if (env_param == pack_name) { pack_index = env_param_count; }
            env_param_count = env_param_count + 1;
        }
        let arg_count = hir_builder_generic_arg_count(env_args);
        let trailing_params = if (pack_index >= 0) {
            env_param_count - pack_index - 1
        } else {
            0
        };
        var idx: i32 = 0;
        while (idx < 64) {
            let required = hir_builder_generic_param_at(required_params, idx);
            if (required.len == 0) { return true; }
            var env_index: i32 = 0;
            while (env_index < env_param_count
                   && hir_builder_generic_param_at(env_params, env_index) != required) {
                env_index = env_index + 1;
            }
            if (env_index >= env_param_count) { return false; }
            if (pack_index >= 0 && env_index == pack_index) {
                // Empty is a valid closed pack.  A non-empty pack is closed
                // only when every flattened member is concrete.
                var pack_arg_index = pack_index;
                let pack_arg_end = arg_count - trailing_params;
                while (pack_arg_index < pack_arg_end) {
                    let bound_pack_arg = policy_generic_arg_at(env_args, pack_arg_index);
                    if (bound_pack_arg.len == 0
                        || self.type_text_has_open_template_atom_without_env(bound_pack_arg)) {
                        return false;
                    }
                    pack_arg_index = pack_arg_index + 1;
                }
            } else {
                var arg_index = env_index;
                if (pack_index >= 0 && env_index > pack_index) {
                    arg_index = arg_count - trailing_params + (env_index - pack_index - 1);
                }
                let bound = policy_generic_arg_at(env_args, arg_index);
                if (bound.len == 0 || self.type_text_has_open_template_atom_without_env(bound)) {
                    return false;
                }
            }
            idx = idx + 1;
        }
        return false;
    }

    fn concrete_impl_method_decl(self, method_name: string, owner_type_name: string) -> rawptr {
        if (method_name.len == 0 || owner_type_name.len == 0) { return null; }
        var item_id: i32 = 1;
        while (item_id <= self.unit.item_count) {
            if (self.unit.item_kind(item_id) == hir_item_method()
                && self.unit.item_name(item_id) == method_name
                && self.owner_item_matches_type(self.unit.item_owner(item_id), owner_type_name)) {
                let raw_decl = hir_pointer_map_raw_for_item(self.decl_map,item_id);
                if (raw_decl != null) {
                    let body_decl = self.raw_function_body_decl_for(raw_decl);
                    if (body_decl != null
                        && (hir_builder_body_resolved(body_decl) || decl_get_body(body_decl) != null)) {
                        return body_decl;
                    }
                }
            }
            item_id = item_id + 1;
        }
        return null;
    }

    fn concrete_impl_method_decl_for_call(self,
                                           method_name: string,
                                           owner_type_name: string,
                                           call_expr: rawptr,
                                           call_expr_id: i32) -> rawptr {
        if (method_name.len == 0
            || owner_type_name.len == 0
            || call_expr_id == hir_id_invalid()) {
            return null;
        }
        var best: rawptr = null;
        var best_score: i32 = -1;
        var tied = false;
        var item_id: i32 = 1;
        while (item_id <= self.unit.item_count) {
            if (self.unit.item_kind(item_id) == hir_item_method()
                && self.unit.item_name(item_id) == method_name
                && self.owner_item_matches_type(self.unit.item_owner(item_id), owner_type_name)) {
                let raw_decl = hir_pointer_map_raw_for_item(self.decl_map,item_id);
                let body_decl = self.raw_function_body_decl_for(raw_decl);
                if (raw_decl != null
                    && body_decl != null
                    && hir_builder_body_resolved(body_decl)
                    && hir_builder_method_decl_matches_static_use(raw_decl, false)) {
                    let score = self.method_decl_score_for_call(call_expr,
                                                                call_expr_id,
                                                                raw_decl,
                                                                owner_type_name);
                    if (score > best_score) {
                        best = body_decl;
                        best_score = score;
                        tied = false;
                    } else if (score == best_score && score >= 0 && body_decl != best) {
                        tied = true;
                    }
                }
            }
            item_id = item_id + 1;
        }
        if (best_score < 0 || tied) { return null; }
        return best;
    }

    fn concrete_impl_owner_decl(self, impl_decl: rawptr) -> rawptr {
        if (impl_decl == null) { return null; }
        let owner_item = hir_pointer_map_item(self.decl_map,impl_decl);
        if (owner_item == hir_id_invalid()) { return hir_raw_owner_map_get(self.decl_owner_map,impl_decl); }
        return hir_pointer_map_raw_for_item(self.decl_map,self.unit.item_owner(owner_item));
    }

    fn imported_impl_method_for_requirement(self,
                                            requirement: rawptr,
                                            owner_type: string) -> rawptr {
        if (requirement == null || owner_type.len == 0) { return null; }
        let trait_owner = hir_raw_owner_map_get(self.decl_owner_map,requirement);
        if (trait_owner == null || (decl_get_generic_flags(trait_owner) & 2) == 0) {
            return null;
        }
        let trait_name = decl_get_name(trait_owner);
        let method_name = decl_get_name(requirement);
        var found: rawptr = null;
        var item_id: i32 = 1;
        while (item_id <= self.unit.item_count) {
            if (self.unit.item_kind(item_id) == hir_item_method()
                && self.unit.item_name(item_id) == method_name
                && self.owner_item_matches_type(self.unit.item_owner(item_id), owner_type)) {
                let method = hir_pointer_map_raw_for_item(self.decl_map,item_id);
                let impl_owner = self.concrete_impl_owner_decl(method);
                if (method != null && self.decl_is_foreign_import(method)
                    && decl_get_body(method) == null
                    && self.raw_function_body_decl_for(method) == null
                    && hir_builder_decl_template_params(method).len == 0
                    && impl_owner != null
                    && hir_builder_string_contains(decl_get_generic_params(impl_owner), "|kind:impl")
                    && decl_get_name(impl_owner) == owner_type
                    && hir_builder_trait_names_match(
                        hir_builder_impl_trait_at(decl_get_generic_params(impl_owner), 0),
                        trait_name)
                    && self.imported_impl_matches_trait_requirement(method,
                                                                     requirement,
                                                                     owner_type)) {
                    if (found != null && found != method) { return null; }
                    found = method;
                }
            }
            item_id = item_id + 1;
        }
        return found;
    }

    fn type_atom_is_registered_item(self, name: string) -> bool {
        if (name.len == 0) { return false; }
        if (hir_string_set_contains(self.registered_type_atoms,name)) { return true; }
        return false;
    }

    fn type_name_is_open_template_atom_in_current_env(self, name: string) -> bool {
        if (name.len == 0) { return false; }
        if (name == "Self") {
            let self_bound = self.current_generic_binding(name);
            if (self_bound.len == 0 || self_bound == name) { return true; }
            return self.type_text_has_open_template_atom(self_bound);
        }
        let bound = self.current_generic_binding(name);
        if (bound.len > 0 && bound != name) {
            return self.type_text_has_open_template_atom(bound);
        }
        if (hir_builder_generic_contains(self.current_generic_params, name)) {
            return true;
        }
        if (self.type_atom_is_registered_item(name)) { return false; }
        if (name.len == 1) {
            let c = name.charAt(0);
            if (c >= 65 && c <= 90) { return true; }
        }
        return false;
    }

    fn type_text_open_simple_no_env(self, text: string) -> bool {
        if (text.len == 0) { return false; }
        if (text == "Self") { return true; }
        if (self.type_atom_is_registered_item(text)) { return false; }
        if (text.len == 1) {
            let c = text.charAt(0);
            if (c >= 65 && c <= 90) { return true; }
        }
        return false;
    }

    fn type_text_has_open_template_atom(self, text: string) -> bool {
        self.profile_type_open_calls = self.profile_type_open_calls + 1;
        if (text.len == 0) { return false; }
        let needs_env = self.type_text_needs_current_env(text);
        if (!needs_env && !hir_builder_type_text_needs_env_resolution(text)) {
            return self.type_text_open_simple_no_env(text);
        }
        var cache_key = text;
        if (needs_env) {
            let env_key = hir_builder_env_key(self.current_generic_params, self.current_generic_args);
            if (env_key.len > 0) { cache_key = env_key + "=>" + text; }
        }
        let cached = hir_name_id_map_get(self.type_text_open_cache,cache_key);
        if (cached != hir_id_invalid()) { return cached == 2; }
        let open = self.type_text_has_open_template_atom_uncached(text);
        if (open) {
            self.type_text_open_cache = hir_name_id_map_put(self.type_text_open_cache,cache_key, 2);
        } else {
            self.type_text_open_cache = hir_name_id_map_put(self.type_text_open_cache,cache_key, 1);
        }
        return open;
    }

    fn type_text_has_open_template_atom_uncached(self, text: string) -> bool {
        if (text.len == 0) { return false; }
        let resolved_text = self.resolve_type_text_in_current_env(text);
        if (resolved_text.len == 0) { return false; }
        if (policy_generic_call_has_args(resolved_text) != 0) {
            let base = policy_generic_call_base(resolved_text);
            if (self.type_name_is_open_template_atom_in_current_env(base)) { return true; }
            let raw_args = policy_generic_call_args(resolved_text);
            var arg_index: i32 = 0;
            while (arg_index < 64) {
                let arg = policy_generic_arg_at(raw_args, arg_index);
                if (arg.len == 0) { return false; }
                if (self.type_text_has_open_template_atom(arg)) { return true; }
                arg_index = arg_index + 1;
            }
            return false;
        }
        if (self.type_name_is_open_template_atom_in_current_env(resolved_text)) { return true; }
        let sep = hir_builder_assoc_separator_index(resolved_text);
        if (sep >= 0) {
            if (resolved_text.charAt(sep) == 46) { return false; }
            let sep_len = hir_builder_assoc_separator_len(resolved_text, sep);
            if (sep > 0 && sep + sep_len < resolved_text.len) {
                let owner_text = resolved_text.substring(0, sep);
                let member_text = resolved_text.substring(sep + sep_len, resolved_text.len);
                if (self.type_text_has_open_template_atom(owner_text)) { return true; }
                if (self.type_name_is_open_template_atom_in_current_env(member_text)) { return true; }
            }
        }
        return false;
    }

    fn function_owner_decl_for_open_check(self, fn_id: i32) -> rawptr {
        if (fn_id == hir_id_invalid()) { return null; }
        let raw_fn = hir_pointer_map_raw_for_function(self.decl_map,fn_id);
        if (raw_fn != null) {
            let raw_owner = hir_raw_owner_map_get(self.decl_owner_map,raw_fn);
            if (raw_owner != null) { return raw_owner; }
        }
        let item_id = self.unit.function_item(fn_id);
        if (item_id == hir_id_invalid()) { return null; }
        let owner_item = self.unit.item_owner(item_id);
        if (owner_item == hir_id_invalid()) { return null; }
        return hir_pointer_map_raw_for_item(self.decl_map,owner_item);
    }

    fn function_owner_type_text_for_open_check(self, fn_id: i32) -> string {
        if (fn_id == hir_id_invalid()) { return ""; }
        let owner_type = hir_unit_function_owner_type(self.unit, fn_id);
        if (owner_type.len > 0) { return owner_type; }
        let item_id = self.unit.function_item(fn_id);
        if (item_id == hir_id_invalid()) { return ""; }
        let owner_item = self.unit.item_owner(item_id);
        if (owner_item == hir_id_invalid()) { return ""; }
        return self.unit.item_name(owner_item);
    }

    fn function_owner_type_has_unbound_template_params(self, fn_id: i32) -> bool {
        let owner_decl = self.function_owner_decl_for_open_check(fn_id);
        if (owner_decl == null) { return false; }
        let owner_params = hir_builder_decl_template_params(owner_decl);
        if (owner_params.len == 0) { return false; }
        let owner_type = self.function_owner_type_text_for_open_check(fn_id);
        if (owner_type.len == 0) { return true; }
        if (self.type_text_has_open_template_atom_without_env(owner_type)) { return true; }
        if (policy_generic_call_args(owner_type.clone()).len > 0) { return false; }
        let owner_base = hir_builder_type_base_name(owner_type);
        let decl_base = hir_builder_type_base_name(decl_get_name(owner_decl));
        if (owner_base.len == 0 || decl_base.len == 0) { return true; }
        return hir_builder_type_owner_names_match(owner_base, decl_base);
    }

    fn type_text_has_open_template_atom_without_env(self, text: string) -> bool {
        let saved_params = self.current_generic_params;
        let saved_args = self.current_generic_args;
        self.current_generic_params = "";
        self.current_generic_args = "";
        let out = self.type_text_has_open_template_atom(text);
        self.current_generic_params = saved_params;
        self.current_generic_args = saved_args;
        return out;
    }

    fn type_id_has_template_atom_without_env(self, type_id: i32) -> bool {
        if (!self.type_id_is_valid(type_id)) { return false; }
        let cached = hir_i32_array_map_get(self.type_id_open_no_env_cache,type_id);
        if (cached >= 0) { return cached != 0; }
        let open = self.type_text_has_open_template_atom_without_env(hir_type_table_text(self.unit.types, type_id));
        if (open) {
            self.type_id_open_no_env_cache = hir_i32_array_map_put(self.type_id_open_no_env_cache,type_id, 1);
        } else {
            self.type_id_open_no_env_cache = hir_i32_array_map_put(self.type_id_open_no_env_cache,type_id, 0);
        }
        return open;
    }

    fn function_has_open_template_types(self, fn_id: i32) -> bool {
        self.profile_function_open_calls = self.profile_function_open_calls + 1;
        if (fn_id == hir_id_invalid()) { return false; }
        if (fn_id <= 0 || fn_id > self.unit.function_count) { return true; }
        let cached = hir_i32_array_map_get(self.function_open_cache,fn_id);
        if (cached >= 0) { return cached != 0; }
        var is_open = false;
        // Closed instances deliberately do not overwrite decl_map: their
        // concrete FunctionId is keyed in the reverse instance map.  Use that
        // provenance first so the template's required parameters are checked
        // against this instance environment rather than treating it as a
        // parameterless declaration.
        var raw_decl = self.function_instances.decl_for_function(fn_id);
        if (raw_decl == null) {
            raw_decl = hir_pointer_map_raw_for_function(self.decl_map,fn_id);
        }
        let raw_params = hir_builder_decl_template_params(raw_decl);
        if (raw_params.len > 0) {
            let env_params = hir_unit_function_generic_params(self.unit, fn_id);
            let env_args = hir_unit_function_generic_args(self.unit, fn_id);
            if (!self.decl_template_params_closed_in_function_env(raw_decl,
                                                                 env_params,
                                                                 env_args)) {
                is_open = true;
            }
        }
        if (!is_open) {
            if (self.function_owner_type_has_unbound_template_params(fn_id)) {
                is_open = true;
            } else {
                let ret_type = self.unit.function_return_type(fn_id);
                if (self.type_id_has_template_atom_without_env(ret_type)) {
                    is_open = true;
                } else {
                    var local_id = self.unit.function_first_local(fn_id);
                    while (local_id != hir_id_invalid() && !is_open) {
                        let local_type = self.unit.local_type(local_id);
                        if (self.type_id_has_template_atom_without_env(local_type)) {
                            is_open = true;
                        }
                        local_id = self.unit.local_next(local_id);
                    }
                }
            }
        }
        if (is_open) {
            self.function_open_cache = hir_i32_array_map_put(self.function_open_cache,fn_id, 1);
        } else {
            self.function_open_cache = hir_i32_array_map_put(self.function_open_cache,fn_id, 0);
        }
        return is_open;
    }

    fn function_name_matches_method_direct(self, function_name: string, method_name: string) -> bool {
        if (function_name.len == 0 || method_name.len == 0) { return false; }
        if (function_name == method_name) { return true; }
        if (hir_builder_string_contains(function_name, "::" + method_name)) { return true; }
        if (hir_builder_string_contains(function_name, "_3A_3A" + method_name + "_3A_3A")) { return true; }
        let encoded_method = hir_builder_symbol_segment_for_name(method_name);
        if (encoded_method != method_name) {
            return hir_builder_string_contains(function_name, "_3A_3A" + encoded_method + "_3A_3A");
        }
        return false;
    }

    fn function_name_matches_method(self, function_name: string, method_name: string) -> bool {
        if (self.function_name_matches_method_direct(function_name, method_name)) { return true; }
        let legacy = policy_operator_legacy_method_name(method_name);
        if (legacy.len > 0 && self.function_name_matches_method_direct(function_name, legacy)) { return true; }
        let symbol = policy_operator_symbol_method_name(method_name);
        if (symbol.len > 0 && self.function_name_matches_method_direct(function_name, symbol)) { return true; }
        return false;
    }

    fn function_candidate_matches_method_name(self, fn_id: i32, method_name: string) -> bool {
        if (fn_id == hir_id_invalid() || method_name.len == 0) { return false; }
        if (method_name != "drop"
            && (hir_unit_function_flags(self.unit, fn_id) & hir_function_flag_foreign_dci_dtor()) != 0) {
            return false;
        }
        let item_id = self.unit.function_item(fn_id);
        if (item_id != hir_id_invalid()) {
            let item_name = self.unit.item_name(item_id);
            if (item_name == method_name || self.function_name_matches_method(item_name, method_name)) {
                return true;
            }
        }
        return self.function_name_matches_method(self.unit.function_name(fn_id), method_name);
    }

    fn method_function_target_by_owner_type_and_method(self,
                                                              owner_type_name: string,
                                                              method_name: string) -> i32 {
        self.profile_method_target_calls = self.profile_method_target_calls + 1;
        if (owner_type_name.len == 0 || method_name.len == 0) { return hir_id_invalid(); }
        let early_iface_member = self.raw_interface_method_decl_on_trait(self.raw_interface_decl_for_trait_name(owner_type_name),
                                                                         method_name,
                                                                         0);
        if (early_iface_member != null) {
            let early_iface_fn = hir_pointer_map_function(self.decl_map,early_iface_member);
            if (early_iface_fn != hir_id_invalid()
                && self.function_candidate_matches_method_name(early_iface_fn, method_name)
                && !self.function_has_open_template_types(early_iface_fn)) {
                return early_iface_fn;
            }
        }
        if (self.owner_method_name_is_overloaded(owner_type_name, method_name)) {
            return hir_id_invalid();
        }
        let closed_cached = self.closed_method_instance_for_owner_method(owner_type_name, method_name);
        if (closed_cached != hir_id_invalid()) { return closed_cached; }
        let owner_base = hir_builder_type_base_name(owner_type_name);
        if (owner_base.len > 0) {
            let indexed = hir_pair_id_map_get(self.method_function_index,owner_base, method_name);
            if (indexed != hir_id_invalid()
                && self.function_candidate_matches_method_name(indexed, method_name)
                && self.function_candidate_covers_owner_type(indexed, owner_type_name)
                && !self.function_has_open_template_types(indexed)) {
                return indexed;
            }
            let owner_last = hir_builder_last_path_segment(owner_base);
            if (owner_last.len > 0) {
                let indexed_last = hir_pair_id_map_get(self.method_function_index,owner_last, method_name);
                if (indexed_last != hir_id_invalid()
                    && self.function_candidate_matches_method_name(indexed_last, method_name)
                    && self.function_candidate_covers_owner_type(indexed_last, owner_type_name)
                    && !self.function_has_open_template_types(indexed_last)) {
                    return indexed_last;
                }
            }
        }
        let indexed_exact = hir_pair_id_map_get(self.method_function_index,owner_type_name, method_name);
        if (indexed_exact != hir_id_invalid()
            && self.function_candidate_matches_method_name(indexed_exact, method_name)
            && self.function_candidate_covers_owner_type(indexed_exact, owner_type_name)
            && !self.function_has_open_template_types(indexed_exact)) {
            return indexed_exact;
        }
        if (policy_generic_call_args(owner_type_name.clone()).len > 0) {
            return hir_id_invalid();
        }
        var first_match = hir_id_invalid();
        var item_id: i32 = 1;
        while (item_id <= self.unit.item_count) {
            if (self.unit.item_kind(item_id) == hir_item_method()
                && self.unit.item_name(item_id) == method_name
                && self.owner_item_matches_type(self.unit.item_owner(item_id), owner_type_name)) {
                let fn_id = self.unit.item_function(item_id);
                if (fn_id != hir_id_invalid()) {
                    if (self.function_candidate_covers_owner_type(fn_id, owner_type_name)) {
                        if (first_match == hir_id_invalid()) { first_match = fn_id; }
                        if (!self.function_has_open_template_types(fn_id)) { return fn_id; }
                    }
                }
            }
            item_id = item_id + 1;
        }
        if (first_match == hir_id_invalid() && method_name == "clone") {
            return self.method_function_target_by_owner_type_and_method(owner_type_name, "dup");
        }
        return first_match;
    }

    // A concrete, non-generic method already has a stable ABI symbol in its
    // owner partition. Generic body materialization may reach it through an
    // interface requirement and create a synthetic `Self` shell instead;
    // recover the direct symbol before that shell escapes into MIR.
    fn direct_method_function_for_closed_receiver(self,
                                                   owner_type_name: string,
                                                   method_name: string,
                                                   call_expr_id: i32,
                                                   callee_expr_id: i32) -> i32 {
        if (owner_type_name.len == 0 || method_name.len == 0) {
            return hir_id_invalid();
        }
        var project_local = hir_id_invalid();
        var fallback = hir_id_invalid();
        var fn_id: i32 = 1;
        while (fn_id <= self.unit.function_count) {
            let name = self.unit.function_name(fn_id);
            let raw_decl = hir_pointer_map_raw_for_function(self.decl_map, fn_id);
            if (!name.startsWith("mir2$")
                && raw_decl != null
                && decl_get_kind(raw_decl) == de_METHOD()
                && hir_builder_decl_template_params(raw_decl).len == 0
                && self.function_candidate_matches_method_name(fn_id, method_name)) {
                let raw_owner = hir_raw_owner_map_get(self.decl_owner_map, raw_decl);
                if (raw_owner != null
                    && hir_builder_decl_template_params(raw_owner).len == 0
                    && self.raw_owner_decl_matches_type_exact(raw_owner, owner_type_name)) {
                    let call_matches = call_expr_id == hir_id_invalid()
                        || self.hir_function_arg_score_for_call(call_expr_id,
                                                                callee_expr_id,
                                                                fn_id) >= 0;
                    if (call_matches) {
                        if (self.decl_effectively_project_local(raw_decl)) {
                            if (project_local != hir_id_invalid()
                                && project_local != fn_id) {
                                return hir_id_invalid();
                            }
                            project_local = fn_id;
                        } else if (fallback == hir_id_invalid()) {
                            fallback = fn_id;
                        }
                    }
                }
            }
            fn_id = fn_id + 1;
        }
        if (project_local != hir_id_invalid()) { return project_local; }
        return fallback;
    }
    fn note_closed_method_instance(self, owner_type_name: string, method_name: string, fn_id: i32) {
        if (owner_type_name.len == 0 || method_name.len == 0 || fn_id == hir_id_invalid()) { return; }
        if (!self.function_candidate_matches_method_name(fn_id, method_name)) { return; }
        if (self.function_has_open_template_types(fn_id)) { return; }
        if (self.owner_method_name_is_overloaded(owner_type_name, method_name)) { return; }
        var canonical_fn = fn_id;
        if (self.unit.function_name(fn_id).startsWith("mir2$")) {
            let direct_fn = self.direct_method_function_for_closed_receiver(
                owner_type_name,
                method_name,
                hir_id_invalid(),
                hir_id_invalid());
            if (direct_fn != hir_id_invalid()) { canonical_fn = direct_fn; }
        }
        self.closed_method_instance_index = hir_pair_id_map_put(self.closed_method_instance_index,owner_type_name, method_name, canonical_fn);
    }

    fn closed_method_instance_for_owner_method(self, owner_type_name: string, method_name: string) -> i32 {
        if (owner_type_name.len == 0 || method_name.len == 0) { return hir_id_invalid(); }
        if (self.owner_method_name_is_overloaded(owner_type_name, method_name)) { return hir_id_invalid(); }
        let cached = hir_pair_id_map_get(self.closed_method_instance_index,owner_type_name, method_name);
        if (cached != hir_id_invalid()
            && self.function_candidate_matches_method_name(cached, method_name)
            && self.function_candidate_covers_owner_type(cached, owner_type_name)
            && !self.function_has_open_template_types(cached)) {
            return cached;
        }
        return hir_id_invalid();
    }

    fn prefer_closed_function_instance_for_owner_method(self,
                                                              owner_type_name: string,
                                                              method_name: string,
                                                              current_fn: i32) -> i32 {
        if (current_fn == hir_id_invalid()
            || owner_type_name.len == 0
            || method_name.len == 0) {
            return current_fn;
        }
        if (!self.function_has_open_template_types(current_fn)) {
            let current_owner_type = hir_unit_function_owner_type(self.unit, current_fn);
            if (self.function_candidate_matches_method_name(current_fn, method_name)
                && (current_owner_type.len == 0 || current_owner_type == owner_type_name)) {
                return current_fn;
            }
            if (self.function_candidate_matches_method_name(current_fn, method_name)
                && self.unit.function_body(current_fn) != hir_id_invalid()) {
                return current_fn;
            }
        }
        let cached = self.closed_method_instance_for_owner_method(owner_type_name, method_name);
        if (cached != hir_id_invalid() && cached != current_fn) { return cached; }
        return current_fn;
    }

    fn raw_owner_decl_matches_type_base(self, owner_decl: rawptr, type_text: string) -> bool {
        if (owner_decl == null || type_text.len == 0) { return false; }
        let owner_kind = decl_get_kind(owner_decl);
        if (owner_kind != de_CLASS() && owner_kind != de_ENUM()) { return false; }
        let wanted_base = hir_builder_type_base_name(type_text);
        let owner_base = hir_builder_type_base_name(decl_get_name(owner_decl));
        if (wanted_base.len == 0 || owner_base.len == 0) { return false; }
        return hir_builder_type_owner_names_match(owner_base, wanted_base);
    }

    fn raw_owner_decl_matches_type_exact(self, owner_decl: rawptr, type_text: string) -> bool {
        if (owner_decl == null || type_text.len == 0) { return false; }
        let owner_kind = decl_get_kind(owner_decl);
        if (owner_kind != de_CLASS() && owner_kind != de_ENUM()) { return false; }
        let raw_owner_name = decl_get_name(owner_decl);
        if (raw_owner_name == type_text) { return true; }
        if (policy_generic_call_args(type_text.clone()).len == 0
            && policy_generic_call_args(raw_owner_name.clone()).len == 0) {
            let owner_last = hir_builder_last_path_segment(raw_owner_name);
            if (owner_last.len > 0 && owner_last == type_text) { return true; }
            let type_last = hir_builder_last_path_segment(type_text);
            if (type_last.len > 0 && raw_owner_name == type_last) { return true; }
            if (owner_last.len > 0 && type_last.len > 0 && owner_last == type_last) { return true; }
        }
        var wanted = policy_generic_call_base(type_text);
        if (wanted.len == 0) { wanted = type_text; }
        var owner_name = policy_generic_call_base(raw_owner_name);
        if (owner_name.len == 0) { owner_name = raw_owner_name; }
        return owner_name == wanted || policy_type_name_equal(owner_name, wanted);
    }

    fn raw_registered_class_decl_for_type_exact(self, type_text: string) -> rawptr {
        if (type_text.len == 0) { return null; }
        var wanted = policy_generic_call_base(type_text);
        if (wanted.len == 0) { wanted = type_text; }
        let indexed = hir_raw_name_map_get(self.raw_class_exact,wanted);
        if (indexed != null && (decl_get_kind(indexed) == de_CLASS() || decl_get_kind(indexed) == de_ENUM())) {
            return indexed;
        }
        var item_id: i32 = 1;
        while (item_id <= self.unit.item_count) {
            let item_kind = self.unit.item_kind(item_id);
            if ((item_kind == hir_item_class() || item_kind == hir_item_enum())
                && self.unit.item_name(item_id) == wanted) {
                let raw = hir_pointer_map_raw_for_item(self.decl_map,item_id);
                if (raw != null && (decl_get_kind(raw) == de_CLASS() || decl_get_kind(raw) == de_ENUM())) {
                    return raw;
                }
            }
            item_id = item_id + 1;
        }
        return null;
    }

    fn raw_template_class_decl_for_type_text(self, type_text: string) -> rawptr {
        if (type_text.len == 0) { return null; }
        // The scan below never consults the generic env, so its result is
        // shared across envs and only re-validated when a class registers.
        if (hir_name_id_map_get(self.raw_template_scan_stamp,type_text) == self.raw_class_index_version) {
            return hir_raw_name_map_get(self.raw_template_scan_cache,type_text);
        }
        let out = self.raw_template_class_decl_for_type_text_scan(type_text);
        self.raw_template_scan_stamp = hir_name_id_map_put(self.raw_template_scan_stamp,type_text, self.raw_class_index_version);
        if (out != null) {
            self.raw_template_scan_cache = hir_raw_name_map_put(self.raw_template_scan_cache,type_text, out);
        }
        return out;
    }

    fn raw_template_class_decl_for_type_text_scan(self, type_text: string) -> rawptr {
        if (type_text.len == 0) { return null; }
        let wanted_base = hir_builder_type_base_name(type_text);
        if (wanted_base.len == 0) { return null; }
        let concrete_args = policy_generic_call_args(type_text.clone());
        let concrete_arg_count = hir_builder_generic_arg_count(concrete_args);
        let indexed_template = hir_raw_name_map_get(self.raw_class_template,wanted_base);
        if (indexed_template != null) {
            let indexed_params = hir_builder_decl_template_params(indexed_template);
            let indexed_param_count = hir_builder_generic_param_count(indexed_params);
            if (concrete_arg_count == 0 || indexed_param_count == concrete_arg_count) {
                return indexed_template;
            }
        }
        var exact_first_generic: rawptr = null;
        var exact_cur = self.decl_map.head;
        while (exact_cur != null) {
            let exact_candidate = ast_read_rawptr(exact_cur);
            if (exact_candidate != null
                && (decl_get_kind(exact_candidate) == de_CLASS() || decl_get_kind(exact_candidate) == de_ENUM())
                && self.raw_owner_decl_matches_type_exact(exact_candidate, type_text)) {
                let exact_params = hir_builder_decl_template_params(exact_candidate);
                let exact_param_count = hir_builder_generic_param_count(exact_params);
                if (concrete_arg_count > 0) {
                    if (exact_param_count == concrete_arg_count
                        && exact_params != concrete_args) {
                        return exact_candidate;
                    }
                    if (exact_first_generic == null
                        && exact_param_count > 0
                        && exact_params != concrete_args) {
                        exact_first_generic = exact_candidate;
                    }
                } else if (exact_param_count == 0) {
                    return exact_candidate;
                } else if (exact_first_generic == null
                          && exact_params.len > 0) {
                    exact_first_generic = exact_candidate;
                }
            }
            exact_cur = ast_read_rawptr(ptr_offset(exact_cur, 24));
        }
        if (exact_first_generic != null) { return exact_first_generic; }
        let exact_item_raw = self.raw_registered_class_decl_for_type_exact(type_text);
        if (exact_item_raw != null) { return exact_item_raw; }
        var first_generic: rawptr = null;
        var cur = self.decl_map.head;
        while (cur != null) {
            let candidate = ast_read_rawptr(cur);
            if (candidate != null
                && (decl_get_kind(candidate) == de_CLASS() || decl_get_kind(candidate) == de_ENUM())
                && self.raw_owner_decl_matches_type_base(candidate, type_text)) {
                let candidate_params = hir_builder_decl_template_params(candidate);
                let candidate_param_count = hir_builder_generic_param_count(candidate_params);
                if (concrete_arg_count > 0) {
                    if (candidate_param_count == concrete_arg_count
                        && candidate_params != concrete_args) {
                        return candidate;
                    }
                    if (first_generic == null
                        && candidate_param_count > 0
                        && candidate_params != concrete_args) {
                        first_generic = candidate;
                    }
                } else if (candidate_param_count == 0) {
                    return candidate;
                } else if (first_generic == null
                          && candidate_params.len > 0) {
                    first_generic = candidate;
                }
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return first_generic;
    }

    fn raw_template_method_decl_for_type_text(self,
                                                    type_text: string,
                                                    method_name: string,
                                                    want_static: bool) -> rawptr {
        if (type_text.len == 0 || method_name.len == 0) { return null; }
        let cd = self.raw_template_class_decl_for_type_text(type_text);
        if (cd == null) { return null; }
        var member = decl_get_members(cd);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && hir_builder_method_name_matches_lookup(decl_get_name(member), method_name)
                && hir_builder_method_decl_matches_static_use(member, want_static)) {
                return member;
            }
            member = decl_get_next(member);
        }
        return self.raw_method_decl_from_layout_parents(cd, method_name, want_static, 0);
    }

    fn raw_template_method_decl_for_call_type_text(self,
                                                          type_text: string,
                                                          method_name: string,
                                                          want_static: bool,
                                                          call_expr: rawptr,
                                                          call_expr_id: i32) -> rawptr {
        if (type_text.len == 0 || method_name.len == 0) { return null; }
        let owner_args = policy_generic_call_args(type_text.clone());
        let owner_arg_count = hir_builder_generic_arg_count(owner_args);
        let template_owner = self.raw_template_class_decl_for_type_text(type_text);
        if (template_owner != null) {
            let direct = self.raw_method_decl_for_call_on_class_tree(template_owner,
                                                                     method_name,
                                                                     want_static,
                                                                     call_expr,
                                                                     call_expr_id,
                                                                     type_text,
                                                                     0);
            if (direct != null) { return direct; }
        }
        let wanted_base = hir_builder_type_base_name(type_text);
        if (wanted_base.len == 0) { return null; }
        var cur = self.decl_map.head;
        while (cur != null) {
            let candidate_owner = ast_read_rawptr(cur);
            if (candidate_owner != null
                && (decl_get_kind(candidate_owner) == de_CLASS() || decl_get_kind(candidate_owner) == de_ENUM())
                && self.raw_owner_decl_matches_type_base(candidate_owner, type_text)) {
                let candidate_params = hir_builder_decl_template_params(candidate_owner);
                let candidate_param_count = hir_builder_generic_param_count(candidate_params);
                var accepts_owner = false;
                if (owner_arg_count > 0) {
                    accepts_owner = candidate_param_count == owner_arg_count
                        && candidate_params != owner_args;
                } else {
                    accepts_owner = candidate_param_count == 0 || candidate_params.len > 0;
                }
                if (accepts_owner) {
                    let picked = self.raw_method_decl_for_call_on_class_tree(candidate_owner,
                                                                             method_name,
                                                                             want_static,
                                                                             call_expr,
                                                                             call_expr_id,
                                                                             type_text,
                                                                             0);
                    if (picked != null) { return picked; }
                }
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return null;
    }

    fn raw_concrete_class_decl_for_type_text(self, type_text: string) -> rawptr {
        if (type_text.len == 0) { return null; }
        let concrete_args = policy_generic_call_args(type_text.clone());
        if (concrete_args.len == 0) { return null; }
        if (self.type_text_has_open_template_atom(type_text)) { return null; }
        var indexed_concrete = hir_raw_name_map_get(self.raw_class_concrete,type_text);
        if (indexed_concrete == null) {
            let concrete_base = hir_builder_type_base_name(type_text);
            if (concrete_base.len > 0) {
                indexed_concrete = hir_raw_name_map_get(self.raw_class_concrete,concrete_base + "::<" + concrete_args + ">");
            }
        }
        if (indexed_concrete != null
            && (decl_get_kind(indexed_concrete) == de_CLASS() || decl_get_kind(indexed_concrete) == de_ENUM())
            && !self.decl_members_have_template_type(indexed_concrete)) {
            return indexed_concrete;
        }
        var exact_cur = self.decl_map.head;
        while (exact_cur != null) {
            let exact_candidate = ast_read_rawptr(exact_cur);
            if (exact_candidate != null
                && (decl_get_kind(exact_candidate) == de_CLASS() || decl_get_kind(exact_candidate) == de_ENUM())
                && self.raw_owner_decl_matches_type_exact(exact_candidate, type_text)
                && hir_builder_generic_head(decl_get_generic_params(exact_candidate)) == concrete_args
                && !self.decl_members_have_template_type(exact_candidate)) {
                return exact_candidate;
            }
            exact_cur = ast_read_rawptr(ptr_offset(exact_cur, 24));
        }
        var cur = self.decl_map.head;
        while (cur != null) {
            let candidate = ast_read_rawptr(cur);
            if (candidate != null
                && (decl_get_kind(candidate) == de_CLASS() || decl_get_kind(candidate) == de_ENUM())
                && self.raw_owner_decl_matches_type_base(candidate, type_text)
                && hir_builder_generic_head(decl_get_generic_params(candidate)) == concrete_args
                && !self.decl_members_have_template_type(candidate)) {
                return candidate;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return null;
    }

    fn raw_concrete_method_decl_for_type_text(self,
                                                    type_text: string,
                                                    method_name: string,
                                                    want_static: bool) -> rawptr {
        if (type_text.len == 0
            || method_name.len == 0
            || self.type_text_has_open_template_atom(type_text)) {
            return null;
        }
        var cached: rawptr = null;
        if (want_static) {
            cached = hir_pair_raw_map_get(self.concrete_method_decl_cache_static,type_text, method_name);
        } else {
            cached = hir_pair_raw_map_get(self.concrete_method_decl_cache_instance,type_text, method_name);
        }
        if (cached != null) { return cached; }
        if (want_static) {
            if (hir_pair_id_map_get(self.concrete_method_decl_miss_static,type_text, method_name) != hir_id_invalid()) { return null; }
        } else {
            if (hir_pair_id_map_get(self.concrete_method_decl_miss_instance,type_text, method_name) != hir_id_invalid()) { return null; }
        }
        let concrete_args = policy_generic_call_args(type_text.clone());
        if (concrete_args.len == 0) {
            if (want_static) {
                self.concrete_method_decl_miss_static = hir_pair_id_map_put(self.concrete_method_decl_miss_static,type_text, method_name, 1);
            } else {
                self.concrete_method_decl_miss_instance = hir_pair_id_map_put(self.concrete_method_decl_miss_instance,type_text, method_name, 1);
            }
            return null;
        }
        var exact_cur = self.decl_map.head;
        while (exact_cur != null) {
            let exact_candidate = ast_read_rawptr(exact_cur);
            if (exact_candidate != null
                && decl_get_kind(exact_candidate) == de_METHOD()
                && hir_builder_method_name_matches_lookup(decl_get_name(exact_candidate), method_name)
                && hir_builder_method_decl_matches_static_use(exact_candidate, want_static)) {
                let exact_owner = hir_raw_owner_map_get(self.decl_owner_map,exact_candidate);
                if (self.raw_owner_decl_matches_type_exact(exact_owner, type_text)
                    && hir_builder_generic_head(decl_get_generic_params(exact_owner)) == concrete_args
                    && !self.decl_body_has_template_type(exact_candidate)) {
                    if (want_static) {
                        self.concrete_method_decl_cache_static = hir_pair_raw_map_put(self.concrete_method_decl_cache_static,type_text, method_name, exact_candidate);
                    } else {
                        self.concrete_method_decl_cache_instance = hir_pair_raw_map_put(self.concrete_method_decl_cache_instance,type_text, method_name, exact_candidate);
                    }
                    return exact_candidate;
                }
            }
            exact_cur = ast_read_rawptr(ptr_offset(exact_cur, 24));
        }
        var cur = self.decl_map.head;
        while (cur != null) {
            let candidate = ast_read_rawptr(cur);
            if (candidate != null
                && decl_get_kind(candidate) == de_METHOD()
                && hir_builder_method_name_matches_lookup(decl_get_name(candidate), method_name)
                && hir_builder_method_decl_matches_static_use(candidate, want_static)) {
                let owner_decl = hir_raw_owner_map_get(self.decl_owner_map,candidate);
                if (self.raw_owner_decl_matches_type_base(owner_decl, type_text)
                    && hir_builder_generic_head(decl_get_generic_params(owner_decl)) == concrete_args
                    && !self.decl_body_has_template_type(candidate)) {
                    if (want_static) {
                        self.concrete_method_decl_cache_static = hir_pair_raw_map_put(self.concrete_method_decl_cache_static,type_text, method_name, candidate);
                    } else {
                        self.concrete_method_decl_cache_instance = hir_pair_raw_map_put(self.concrete_method_decl_cache_instance,type_text, method_name, candidate);
                    }
                    return candidate;
                }
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        if (want_static) {
            self.concrete_method_decl_miss_static = hir_pair_id_map_put(self.concrete_method_decl_miss_static,type_text, method_name, 1);
        } else {
            self.concrete_method_decl_miss_instance = hir_pair_id_map_put(self.concrete_method_decl_miss_instance,type_text, method_name, 1);
        }
        return null;
    }

    fn concrete_function_target(self, e: rawptr, raw_target: rawptr) -> i32 {
        if (raw_target == null) { return hir_id_invalid(); }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] enter raw=" + decl_get_name(raw_target)
                  + " expr=" + expr_get_name(e)
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        var owner_decl = hir_raw_owner_map_get(self.decl_owner_map,raw_target);
        if (owner_decl == null) {
            owner_decl = expr_get_semantic_owner(e);
        }
        if (decl_get_kind(raw_target) == de_METHOD()) {
            owner_decl = self.generic_owner_decl_for_method_body(raw_target, owner_decl);
            raw_target = self.method_body_decl_for_instance(raw_target);
        }
        var owner_type_name = self.concrete_owner_type_name(e, owner_decl);
        let constructor_explicit_owner_args = self.resolve_explicit_generic_args_for_call(e);
        var type_call_explicit_owner_args: bool = false;
        if (owner_decl != null && constructor_explicit_owner_args.len > 0) {
            var explicit_source = e;
            if (explicit_source != null && expr_get_kind(explicit_source) == ex_CALL()) {
                explicit_source = expr_get_lhs(explicit_source);
            }
            if (explicit_source != null && expr_get_kind(explicit_source) == ex_IDENT()) {
                let explicit_base = hir_builder_last_path_segment(policy_generic_call_base(expr_get_name(explicit_source).clone()));
                let owner_base = hir_builder_last_path_segment(policy_generic_call_base(decl_get_name(owner_decl).clone()));
                type_call_explicit_owner_args = explicit_base.len > 0
                    && owner_base.len > 0
                    && explicit_base == owner_base;
            }
        }
        if (decl_get_kind(raw_target) == de_METHOD()
            && (decl_get_name(raw_target) == "constructor"
                || (decl_get_name(raw_target) == "new" && type_call_explicit_owner_args))
            && owner_decl != null
            && constructor_explicit_owner_args.len > 0) {
            let ctor_owner_params = hir_builder_decl_template_params(owner_decl);
            if (ctor_owner_params.len > 0
                && hir_builder_generic_param_count(ctor_owner_params) == hir_builder_generic_arg_count(constructor_explicit_owner_args)) {
                owner_type_name = policy_generic_call_base(decl_get_name(owner_decl).clone())
                    + "::<" + constructor_explicit_owner_args + ">";
            }
        }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] owner raw=" + decl_get_name(raw_target)
                  + " owner=" + owner_type_name
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        if (owner_type_name.len > 0 && decl_get_kind(raw_target) == de_METHOD()) {
            let canonical_method = self.canonical_method_decl_for_owner_type(raw_target,
                                                                             owner_type_name);
            if (canonical_method != null && canonical_method != raw_target) {
                raw_target = canonical_method;
                owner_decl = self.method_owner_decl_for_type_text(raw_target, owner_type_name, owner_decl);
                raw_target = self.method_body_decl_for_instance(raw_target);
                owner_type_name = self.concrete_owner_type_name(e, owner_decl);
            }
        }
        var owner_params = hir_builder_decl_template_params(owner_decl);
        if (owner_type_name.len > 0 && policy_generic_call_args(owner_type_name.clone()).len > 0) {
            let template_owner = self.raw_template_class_decl_for_type_text(owner_type_name);
            if (template_owner != null) {
                let template_params = hir_builder_decl_template_params(template_owner);
                if (template_params.len > 0) { owner_params = template_params; }
            }
        }
        var method_params = hir_builder_decl_template_params(raw_target);
        let owner_type_args = policy_generic_call_args(owner_type_name.clone());
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let ret_owner_params = hir_builder_template_params_matching_owner_text(hir_builder_type_ref_name(decl_get_ty(raw_target)),
                                                                                  owner_type_name);
            if (ret_owner_params.len > 0
                && hir_builder_generic_param_count(ret_owner_params) == hir_builder_generic_arg_count(owner_type_args)
                && !hir_builder_generic_contains(ret_owner_params, "Self")) {
                owner_params = ret_owner_params;
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0 && method_params.len > 0) {
            let owner_arg_count = hir_builder_generic_arg_count(owner_type_args);
            let derived_owner_params = hir_builder_generic_params_prefix(method_params, owner_arg_count);
            if (hir_builder_generic_param_count(derived_owner_params) == owner_arg_count
                && !hir_builder_generic_contains(derived_owner_params, "Self")) {
                owner_params = derived_owner_params;
                method_params = hir_builder_generic_params_after(method_params, owner_arg_count);
            }
        }
        if (method_params.len == 0) {
            method_params = hir_builder_inferred_decl_template_params_except(raw_target, owner_params);
        }
        var owner_args = hir_builder_owner_args_for_params(owner_params, owner_type_name);
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] params raw=" + decl_get_name(raw_target)
                  + " owner_params=" + owner_params
                  + " method_params=" + method_params
                  + " owner_args=" + owner_args);
        }
        var explicit_method_args = self.resolve_explicit_generic_args_for_call(e);
        if (decl_get_kind(raw_target) == de_METHOD()
            && (decl_get_name(raw_target) == "constructor"
                || (decl_get_name(raw_target) == "new" && type_call_explicit_owner_args))
            && constructor_explicit_owner_args.len > 0
            && policy_generic_call_args(owner_type_name.clone()).len > 0) {
            explicit_method_args = "";
        }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] explicit raw=" + decl_get_name(raw_target)
                  + " explicit=" + explicit_method_args
                  + " owner_args=" + owner_args);
        }
        let bindings = self.infer_call_bindings(e,
                                                raw_target,
                                                owner_params,
                                                owner_args,
                                                method_params,
                                                explicit_method_args);
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] bindings raw=" + decl_get_name(raw_target)
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        let method_args = self.args_for_call_params(e, raw_target, method_params, explicit_method_args, bindings);
        bindings.dispose();
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] method-args raw=" + decl_get_name(raw_target)
                  + " method_args=" + method_args
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        var params = owner_params;
        var args = owner_args;
        params = hir_builder_append_csv(params, method_params);
        args = hir_builder_append_csv(args, method_args);
        if (self.decl_body_has_template_type(raw_target)) {
            var env_index: i32 = 0;
            while (env_index < 64) {
                let env_param = hir_builder_generic_param_at(self.current_generic_params, env_index);
                if (env_param.len == 0) { break; }
                let env_arg = policy_generic_arg_at(self.current_generic_args, env_index);
                if (env_param != "Self"
                    && env_arg.len > 0
                    && self.decl_contains_template_param(raw_target, env_param)
                    && !hir_builder_generic_contains(params, env_param)) {
                    params = hir_builder_append_csv(params, env_param);
                    args = hir_builder_append_csv(args, env_arg);
                }
                env_index = env_index + 1;
            }
        }
        let direct_closed_target = self.direct_closed_method_function_if_no_instance_env(raw_target,
                                                                                        owner_decl,
                                                                                        owner_type_name,
                                                                                        params,
                                                                                        args);
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] direct-instance raw=" + decl_get_name(raw_target)
                  + " id=" + self.i32_text(direct_closed_target)
                  + " params=" + params
                  + " args=" + args);
        }
        if (direct_closed_target != hir_id_invalid()) { return direct_closed_target; }
        if (owner_type_name.len > 0 && !hir_builder_generic_contains(params, "Self")) {
            params = hir_builder_append_csv(params, "Self");
            args = hir_builder_append_csv(args, owner_type_name);
        }
        if (decl_get_body(raw_target) == null && owner_type_name.len > 0) {
            let impl_decl = self.concrete_impl_method_decl(decl_get_name(raw_target), owner_type_name);
            if (impl_decl != null && impl_decl != raw_target) {
                var impl_owner_decl = self.method_owner_decl_for_type_text(impl_decl,
                                                                           owner_type_name,
                                                                           self.concrete_impl_owner_decl(impl_decl));
                if (impl_owner_decl == null) { impl_owner_decl = owner_decl; }
                var impl_owner_params = hir_builder_decl_template_params(impl_owner_decl);
                var impl_method_params = hir_builder_decl_template_params(impl_decl);
                let impl_owner_type_args = policy_generic_call_args(owner_type_name.clone());
                if (impl_owner_params.len == 0 && impl_owner_type_args.len > 0) {
                    let impl_ret_owner_params = hir_builder_template_params_matching_owner_text(hir_builder_type_ref_name(decl_get_ty(impl_decl)),
                                                                                                owner_type_name);
                    if (impl_ret_owner_params.len > 0
                        && hir_builder_generic_param_count(impl_ret_owner_params) == hir_builder_generic_arg_count(impl_owner_type_args)
                        && !hir_builder_generic_contains(impl_ret_owner_params, "Self")) {
                        impl_owner_params = impl_ret_owner_params;
                    }
                }
                if (impl_owner_params.len == 0 && impl_owner_type_args.len > 0 && impl_method_params.len > 0) {
                    let impl_owner_arg_count = hir_builder_generic_arg_count(impl_owner_type_args);
                    let impl_derived_owner_params = hir_builder_generic_params_prefix(impl_method_params, impl_owner_arg_count);
                    if (hir_builder_generic_param_count(impl_derived_owner_params) == impl_owner_arg_count
                        && !hir_builder_generic_contains(impl_derived_owner_params, "Self")) {
                        impl_owner_params = impl_derived_owner_params;
                        impl_method_params = hir_builder_generic_params_after(impl_method_params, impl_owner_arg_count);
                    }
                }
                let impl_owner_args = hir_builder_owner_args_for_params(impl_owner_params, owner_type_name);
                let impl_bindings = self.infer_call_bindings(e,
                                                             impl_decl,
                                                             impl_owner_params,
                                                             impl_owner_args,
                                                             impl_method_params,
                                                             explicit_method_args);
                let impl_method_args = self.args_for_call_params(e, impl_decl, impl_method_params, explicit_method_args, impl_bindings);
                impl_bindings.dispose();
                var impl_params = impl_owner_params;
                var impl_args = impl_owner_args;
                impl_params = hir_builder_append_csv(impl_params, impl_method_params);
                impl_args = hir_builder_append_csv(impl_args, impl_method_args);
                // A trait requirement can resolve to a concrete implementation
                // after the enclosing generic body is closed. Do not turn an
                // already concrete implementation into a synthetic `Self`
                // instance: that changes its ABI symbol to `mir2$...` without
                // emitting a matching definition in the owner partition.
                let impl_direct_closed_target = self.direct_closed_method_function_if_no_instance_env(
                    impl_decl,
                    impl_owner_decl,
                    owner_type_name,
                    impl_params,
                    impl_args);
                if (impl_direct_closed_target != hir_id_invalid()) {
                    return impl_direct_closed_target;
                }
                let impl_direct_fn = hir_pointer_map_function(self.decl_map,impl_decl);
                if (impl_direct_fn != hir_id_invalid()
                    && hir_builder_decl_template_params(impl_decl).len == 0) {
                    self.ensure_reachable_function_body(impl_decl, impl_direct_fn, false);
                    return impl_direct_fn;
                }
                if (owner_type_name.len > 0 && !hir_builder_generic_contains(impl_params, "Self")) {
                    impl_params = hir_builder_append_csv(impl_params, "Self");
                    impl_args = hir_builder_append_csv(impl_args, owner_type_name);
                }
                if (impl_params.len > 0 && impl_args.len > 0) {
                    return self.ensure_function_instance(impl_decl,
                                                         impl_owner_decl,
                                                         owner_type_name,
                                                         impl_params,
                                                         impl_args);
                }
                if (impl_direct_fn != hir_id_invalid()) {
                    self.ensure_reachable_function_body(impl_decl, impl_direct_fn, false);
                    return impl_direct_fn;
                }
            }
        }
        let zero_variadic_instance = e != null
            && expr_get_kind(e) == ex_CALL()
            && self.decl_has_variadic_param(raw_target)
            && params.len > 0
            && args.len == 0;
        if (params.len == 0 || (args.len == 0 && !zero_variadic_instance)) {
            let direct_fn = hir_pointer_map_function(self.decl_map,raw_target);
            self.ensure_reachable_function_body(raw_target, direct_fn, false);
            return direct_fn;
        }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] ensure-instance raw=" + decl_get_name(raw_target)
                  + " params=" + params
                  + " args=" + args);
        }
        return self.ensure_function_instance(raw_target, owner_decl, owner_type_name, params, args);
    }

    fn direct_closed_raw_function_target(self, raw_target: rawptr) -> i32 {
        if (raw_target == null) { return hir_id_invalid(); }
        let kind = decl_get_kind(raw_target);
        if (kind != de_FN() && kind != de_METHOD() && kind != de_EXTERN_FN()) {
            return hir_id_invalid();
        }
        if (hir_builder_decl_template_head(raw_target) || self.decl_body_has_template_type(raw_target)) {
            return hir_id_invalid();
        }
        let raw_owner = hir_raw_owner_map_get(self.decl_owner_map,raw_target);
        if (raw_owner != null && hir_builder_decl_template_head(raw_owner)) {
            return hir_id_invalid();
        }
        let direct_fn = hir_pointer_map_function(self.decl_map,raw_target);
        if (direct_fn == hir_id_invalid()) { return hir_id_invalid(); }
        self.ensure_reachable_function_body(raw_target, direct_fn, false);
        return direct_fn;
    }

    fn free_decl_score_for_call(self,
                                       call_expr_id: i32,
                                       free_decl: rawptr,
                                       params: string,
                                       args: string) -> i32 {
        if (call_expr_id == hir_id_invalid()
            || free_decl == null
            || decl_get_kind(free_decl) != de_FN()
            || self.unit.expr_kind(call_expr_id) != ex_CALL()) {
            return -1;
        }
        var param = decl_get_params(free_decl);
        var arg_id = self.unit.expr_first_arg(call_expr_id);
        var score: i32 = 0;
        while (param != null) {
            if (hir_builder_variadic_param(param)) { return score; }
            if (arg_id == hir_id_invalid()) { return -1; }
            let param_type_id = self.type_id_from_ref_env(decl_get_ty(param), params, args);
            let actual_type_id = self.unit.expr_type(arg_id);
            if (!self.type_id_is_valid(param_type_id) || !self.type_id_is_valid(actual_type_id)) { return -1; }
            let part = self.call_type_id_match_score(param_type_id, actual_type_id);
            if (part < 0) { return -1; }
            score = score + part;
            param = decl_get_next(param);
            arg_id = self.unit.expr_next_arg(arg_id);
        }
        if (arg_id != hir_id_invalid()) { return -1; }
        return score;
    }

    fn best_explicit_free_template_call_target(self,
                                                      e: rawptr,
                                                      call_expr_id: i32,
                                                      callee_base: string,
                                                      explicit_args: string) -> i32 {
        if (callee_base.len == 0 || explicit_args.len == 0) { return hir_id_invalid(); }
        var best_candidate: rawptr = null;
        var best_params = "";
        var best_args = "";
        var best_score: i32 = -1;
        var tied: bool = false;
        var cur = self.decl_map.head;
        while (cur != null) {
            let candidate = ast_read_rawptr(cur);
            if (candidate != null
                && (decl_get_kind(candidate) == de_FN()
                    || decl_get_kind(candidate) == de_EXTERN_FN())
                && policy_generic_call_base(decl_get_name(candidate).clone()) == callee_base
                && hir_builder_decl_template_params(candidate).len > 0) {
                let params = hir_builder_decl_template_params(candidate);
                let bindings = self.infer_call_bindings(e,
                                                        candidate,
                                                        "",
                                                        "",
                                                        params,
                                                        explicit_args);
                let args = self.args_for_call_params(e, candidate, params, explicit_args, bindings);
                bindings.dispose();
                if (self.env_args_closed_for_decl(candidate, params, args)) {
                    var closed = true;
                    var i: i32 = 0;
                    while (i < 256 && closed) {
                        let param = hir_builder_generic_param_at(params, i);
                        if (param.len == 0) { break; }
                        let arg = policy_generic_arg_at(args, i);
                        if (arg.len == 0 || self.type_text_has_open_template_atom(arg)) { closed = false; }
                        i = i + 1;
                    }
                    if (closed) {
                        let score = self.free_decl_score_for_call(call_expr_id, candidate, params, args);
                        if (score > best_score) {
                            best_score = score;
                            best_candidate = candidate;
                            best_params = params;
                            best_args = args;
                            tied = false;
                        } else if (score == best_score && score >= 0) {
                            tied = true;
                        }
                    }
                }
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        if (best_score < 0 || tied || best_candidate == null) { return hir_id_invalid(); }
        return self.ensure_function_instance(best_candidate, null, "", best_params, best_args);
    }

    // Imported template artifacts intentionally clear raw semantic pointers.
    // A qualified free call therefore arrives here as a BUILTIN-shaped member
    // with only its module/name identity.  Recover the declaration by the
    // validated artifact module stamp before generic instance materialization.
    // Matching the module as well as the short function name prevents two
    // imported modules that both export `same_name` from becoming ambiguous.
    fn qualified_free_function_target_for_call(self,
                                                e: rawptr,
                                                call_expr_id: i32,
                                                callee_expr_id: i32) -> i32 {
        if (call_expr_id == hir_id_invalid()
            || callee_expr_id == hir_id_invalid()) { return hir_id_invalid(); }
        var raw_callee = e;
        if (expr_get_kind(raw_callee) == ex_CALL()) { raw_callee = expr_get_lhs(raw_callee); }
        var module_name = "";
        if (raw_callee != null && expr_get_kind(raw_callee) == ex_MEMBER()) {
            module_name = expr_get_name(expr_get_lhs(raw_callee));
            if (module_name.len == 0) {
                let owner_id = self.unit.expr_lhs(callee_expr_id);
                if (owner_id != hir_id_invalid()) { module_name = self.unit.expr_name(owner_id); }
            }
        } elif (self.unit.expr_kind(callee_expr_id) == ex_MEMBER()) {
            // Expected-type recovery may invoke this routine after the raw
            // AST has been discarded. The HIR member owner still preserves
            // the fully qualified module name.
            let owner_id = self.unit.expr_lhs(callee_expr_id);
            if (owner_id != hir_id_invalid()) { module_name = self.unit.expr_name(owner_id); }
        } else {
            var current_raw = hir_pointer_map_raw_for_item(self.decl_map,
                                                            self.current_item_id);
            if (current_raw == null) {
                current_raw = hir_pointer_map_raw_for_function(self.decl_map,
                                                               self.current_function_id);
            }
            module_name = hir_builder_decl_source_module(current_raw);
            if (module_name.len == 0 && self.current_function_id != hir_id_invalid()) {
                let disc = self.unit.function_symbol_discriminator(self.current_function_id);
                let marker = "source=";
                let at = disc.indexOf(marker);
                if (at >= 0) {
                    let start = at + marker.len;
                    var end = start;
                    while (end < disc.len && disc.charAt(end) != 124) { end = end + 1; }
                    if (end > start) { module_name = disc.substring(start, end); }
                }
            }
        }
        let base = policy_generic_call_base(self.unit.expr_name(callee_expr_id).clone());
        if (base.len == 0) { return hir_id_invalid(); }
        // A materialized function instance may no longer carry the raw
        // source item that stamped its module.  Recover an unqualified call's
        // module only when the exported short name is unique across the
        // imported declaration set.  Ambiguous names remain fail-closed.
        if (module_name.len == 0) {
            var inferred_module = "";
            var inferred_ambiguous = false;
            var infer_cur = self.decl_map.head;
            while (infer_cur != null) {
                let infer_candidate = ast_read_rawptr(infer_cur);
                if (infer_candidate != null
                    && (decl_get_kind(infer_candidate) == de_FN()
                        || decl_get_kind(infer_candidate) == de_EXTERN_FN())
                    && policy_generic_call_base(decl_get_name(infer_candidate).clone()) == base) {
                    let infer_source = hir_builder_decl_source_module(infer_candidate);
                    if (infer_source.len > 0) {
                        let normalized = policy_module_base(infer_source.clone());
                        if (inferred_module.len == 0) {
                            inferred_module = normalized;
                        } elif (inferred_module != normalized) {
                            inferred_ambiguous = true;
                        }
                    }
                }
                infer_cur = ast_read_rawptr(ptr_offset(infer_cur, 24));
            }
            if (inferred_ambiguous || inferred_module.len == 0) { return hir_id_invalid(); }
            module_name = inferred_module;
        }
        let wanted_module = policy_module_base(module_name.clone());
        let explicit_args = self.resolve_explicit_generic_args_for_call(e);
        var best: rawptr = null;
        var best_score: i32 = -1;
        var tied = false;
        var candidate_count: i32 = 0;
        var cur = self.decl_map.head;
        while (cur != null) {
            let candidate = ast_read_rawptr(cur);
            if (candidate != null
                && (decl_get_kind(candidate) == de_FN()
                    || decl_get_kind(candidate) == de_EXTERN_FN())
                && policy_generic_call_base(decl_get_name(candidate).clone()) == base) {
                let source_module = hir_builder_decl_source_module(candidate);
                if (source_module.len > 0
                    && policy_module_base(source_module.clone()) == wanted_module) {
                    candidate_count = candidate_count + 1;
                    let params = hir_builder_decl_template_params(candidate);
                    var score = -1;
                    if (params.len == 0) {
                        score = self.free_decl_score_for_call(call_expr_id, candidate, "", "");
                    } else {
                        let bindings = self.infer_hir_call_bindings(call_expr_id,
                                                                    candidate,
                                                                    "",
                                                                    "",
                                                                    params,
                                                                    explicit_args);
                        let args = self.args_for_hir_call_params(call_expr_id,
                                                                  candidate,
                                                                  params,
                                                                  explicit_args,
                                                                  bindings);
                        score = self.free_decl_score_for_call(call_expr_id, candidate, params, args);
                        bindings.dispose();
                    }
                    if (score > best_score) {
                        best_score = score;
                        best = candidate;
                        tied = false;
                    } elif (score >= 0 && score == best_score) {
                        tied = true;
                    }
                }
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        // An explicitly typed, fully qualified generic call has a single
        // declaration identity even when its argument expression is still a
        // provisional artifact value.  Permit that unique candidate through
        // to instance materialization; overload sets still require the
        // ordinary type score and remain fail-closed on ties.
        if (best == null || tied
            || (best_score < 0 && (candidate_count != 1 || explicit_args.len == 0))) {
            return hir_id_invalid();
        }
        let params = hir_builder_decl_template_params(best);
        if (params.len > 0) {
            let out = self.concrete_free_function_target_for_call_expr(e,
                                                                       call_expr_id,
                                                                       callee_expr_id,
                                                                       best);
            return out;
        }
        let direct_fn = hir_pointer_map_function(self.decl_map, best);
        if (direct_fn != hir_id_invalid()) {
            self.ensure_reachable_function_body(best, direct_fn, false);
        }
        return direct_fn;
    }

    fn best_explicit_free_concrete_spec_call_target(self,
                                                           call_expr_id: i32,
                                                           callee_base: string,
                                                           explicit_args: string) -> i32 {
        if (callee_base.len == 0 || explicit_args.len == 0) { return hir_id_invalid(); }
        var best_candidate: rawptr = null;
        var best_score: i32 = -1;
        var tied: bool = false;
        var cur = self.decl_map.head;
        while (cur != null) {
            let candidate = ast_read_rawptr(cur);
            if (candidate != null
                && decl_get_kind(candidate) == de_FN()
                && policy_generic_call_base(decl_get_name(candidate).clone()) == callee_base
                && hir_builder_decl_concrete_spec_args(candidate) == explicit_args) {
                let score = self.free_decl_score_for_call(call_expr_id, candidate, "", "");
                if (score > best_score) {
                    best_score = score;
                    best_candidate = candidate;
                    tied = false;
                } else if (score == best_score && score >= 0) {
                    tied = true;
                }
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        if (best_score < 0 || tied || best_candidate == null) { return hir_id_invalid(); }
        let direct_fn = hir_pointer_map_function(self.decl_map,best_candidate);
        if (direct_fn == hir_id_invalid()) { return hir_id_invalid(); }
        if (self.function_has_open_template_types(direct_fn)) { return hir_id_invalid(); }
        self.ensure_reachable_function_body(best_candidate, direct_fn, false);
        return direct_fn;
    }

    fn concrete_free_function_target_for_call_expr(self,
                                                          e: rawptr,
                                                          call_expr_id: i32,
                                                          callee_expr_id: i32,
                                                          raw_target: rawptr) -> i32 {
        if (callee_expr_id == hir_id_invalid()
            || call_expr_id == hir_id_invalid()
            || raw_target == null) {
            return hir_id_invalid();
        }
        // DCI open-generic extern declarations instantiate like free
        // templates; the instance shell ends up declaration-only.
        if (decl_get_kind(raw_target) != de_FN()
            && decl_get_kind(raw_target) != de_EXTERN_FN()) {
            return hir_id_invalid();
        }
        if (decl_get_kind(raw_target) == de_EXTERN_FN()
            && !hir_builder_decl_is_foreign_dci(raw_target)) {
            return hir_id_invalid();
        }
        var template_decl = raw_target;
        var params = hir_builder_decl_template_params(template_decl);
        if (params.len == 0) {
            let body_decl = self.raw_function_body_decl_for(raw_target);
            if (body_decl != null && decl_get_kind(body_decl) == de_FN()) {
                let body_params = hir_builder_decl_template_params(body_decl);
                if (body_params.len > 0) {
                    template_decl = body_decl;
                    params = body_params;
                }
            }
        }
        if (params.len == 0) {
            params = hir_builder_inferred_decl_template_params_except(template_decl, "");
        }
        if (params.len == 0) { return hir_id_invalid(); }
        var explicit_args = self.resolve_explicit_generic_args_for_call(e);
        if (explicit_args.len == 0) {
            explicit_args = self.resolve_explicit_generic_args_for_hir_call(call_expr_id);
        }
        let bindings = self.infer_hir_call_bindings(call_expr_id,
                                                    template_decl,
                                                    "",
                                                    "",
                                                    params,
                                                    explicit_args);
        let args = self.args_for_hir_call_params(call_expr_id,
                                                 template_decl,
                                                 params,
                                                 explicit_args,
                                                 bindings);
        bindings.dispose();
        if (!self.env_args_closed_for_decl(template_decl, params, args)) {
            return hir_id_invalid();
        }
        let out_fn = self.ensure_function_instance(template_decl, null, "", params, args);
        if (out_fn == hir_id_invalid() || self.function_has_open_template_types(out_fn)) {
            return hir_id_invalid();
        }
        return out_fn;
    }

    fn concrete_explicit_free_function_call_target(self,
                                                          e: rawptr,
                                                          call_expr_id: i32,
                                                          callee_expr_id: i32,
                                                          raw_target: rawptr) -> i32 {
        if (callee_expr_id == hir_id_invalid() || raw_target == null) { return hir_id_invalid(); }
        if (decl_get_kind(raw_target) != de_FN()
            && !(decl_get_kind(raw_target) == de_EXTERN_FN()
                 && hir_builder_decl_is_foreign_dci(raw_target))) {
            return hir_id_invalid();
        }
        let callee_name = self.unit.expr_name(callee_expr_id);
        let explicit_args = self.resolve_explicit_generic_args_for_call(e);
        if (explicit_args.len == 0) { return hir_id_invalid(); }
        let callee_base = policy_generic_call_base(callee_name.clone());
        let best_concrete_spec = self.best_explicit_free_concrete_spec_call_target(call_expr_id,
                                                                                  callee_base,
                                                                                  explicit_args);
        if (best_concrete_spec != hir_id_invalid()) { return best_concrete_spec; }
        let hir_template = self.concrete_free_function_target_for_call_expr(e,
                                                                            call_expr_id,
                                                                            callee_expr_id,
                                                                            raw_target);
        if (hir_template != hir_id_invalid()) { return hir_template; }
        let best_template = self.best_explicit_free_template_call_target(e,
                                                                         call_expr_id,
                                                                         callee_base,
                                                                         explicit_args);
        if (best_template != hir_id_invalid()) { return best_template; }
        var template_decl = raw_target;
        var params = hir_builder_decl_template_params(template_decl);
        if (params.len == 0) {
            let body_decl = self.raw_function_body_decl_for(raw_target);
            if (body_decl != null && decl_get_kind(body_decl) == de_FN()) {
                let body_params = hir_builder_decl_template_params(body_decl);
                if (body_params.len > 0) {
                    template_decl = body_decl;
                    params = body_params;
                }
            }
        }
        if (params.len == 0) { return hir_id_invalid(); }
        let bindings = self.infer_call_bindings(e,
                                                template_decl,
                                                "",
                                                "",
                                                params,
                                                explicit_args);
        let args = self.args_for_call_params(e, template_decl, params, explicit_args, bindings);
        bindings.dispose();
        if (!self.env_args_cover_params_for_decl(template_decl, params, args)) { return hir_id_invalid(); }
        var i: i32 = 0;
        while (i < 256) {
            let param = hir_builder_generic_param_at(params, i);
            if (param.len == 0) { break; }
            let arg = policy_generic_arg_at(args, i);
            if (arg.len == 0 || self.type_text_has_open_template_atom(arg)) {
                return hir_id_invalid();
            }
            i = i + 1;
        }
        return self.ensure_function_instance(template_decl, null, "", params, args);
    }

    fn raw_class_lookup_key(self, type_text: string) -> string {
        if (type_text.len == 0) { return ""; }
        if (!self.type_text_needs_current_env(type_text)) { return type_text; }
        let env_key = hir_builder_env_key(self.current_generic_params, self.current_generic_args);
        if (env_key.len == 0) { return type_text; }
        return env_key + "=>" + type_text;
    }

    fn remember_raw_class_decl_lookup(self, type_text: string, raw: rawptr) -> rawptr {
        if (type_text.len == 0) { return raw; }
        let cache_key = self.raw_class_lookup_key(type_text);
        if (cache_key.len == 0) { return raw; }
        if (raw != null) {
            self.raw_class_lookup_cache = hir_raw_name_map_put(self.raw_class_lookup_cache,cache_key, raw);
        } else {
            self.raw_class_miss_cache = hir_name_id_map_put(self.raw_class_miss_cache,
                                                             cache_key, self.raw_class_index_version);
        }
        // Share the result across generic envs: everything recorded here is
        // raw-text deterministic (the env-sensitive open-atom early-out never
        // reaches this function). A stale hit cannot turn into a miss because
        // the registered class set only grows; stamp mismatches force rescans.
        self.raw_class_scan_stamp = hir_name_id_map_put(self.raw_class_scan_stamp,type_text, self.raw_class_index_version);
        if (raw != null) {
            self.raw_class_scan_cache = hir_raw_name_map_put(self.raw_class_scan_cache,type_text, raw);
        }
        return raw;
    }

    fn raw_class_decl_for_type_text(self, type_text: string) -> rawptr {
        self.profile_raw_class_calls = self.profile_raw_class_calls + 1;
        var hot_start: i64 = 0;
        let hot_timing = hir_builder_env_enabled("VYX_HIR_HOT_TIMING");
        if (hot_timing) { hot_start = vyx_bootstrap_now_ms(); }
        if (type_text.len == 0) { return null; }
        if (policy_primitive_type_kind(type_text) != 0 || hir_builder_is_primitive_str_name(type_text)) {
            if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
            return null;
        }
        let cache_key = self.raw_class_lookup_key(type_text);
        let cached_lookup = hir_raw_name_map_get(self.raw_class_lookup_cache,cache_key);
        if (cached_lookup != null) {
            if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
            return cached_lookup;
        }
        if (hir_name_id_map_get(self.raw_class_miss_cache,cache_key) == self.raw_class_index_version) {
            if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
            return null;
        }
        let concrete_args = policy_generic_call_args(type_text.clone());
        let base = hir_builder_type_base_name(type_text);
        if (concrete_args.len == 0) {
            let indexed_exact = hir_raw_name_map_get(self.raw_class_exact,type_text);
            if (indexed_exact != null
                && (decl_get_kind(indexed_exact) == de_CLASS() || decl_get_kind(indexed_exact) == de_ENUM())) {
                let out_exact = self.remember_raw_class_decl_lookup(type_text, indexed_exact);
                if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
                return out_exact;
            }
            if (base.len > 0 && base != type_text) {
                let indexed_base_exact = hir_raw_name_map_get(self.raw_class_exact,base);
                if (indexed_base_exact != null
                    && (decl_get_kind(indexed_base_exact) == de_CLASS() || decl_get_kind(indexed_base_exact) == de_ENUM())) {
                    let out_base_exact = self.remember_raw_class_decl_lookup(type_text, indexed_base_exact);
                    if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
                    return out_base_exact;
                }
            }
        }
        if (self.type_text_has_open_template_atom(type_text)) {
            if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
            return null;
        }
        // Past the env-sensitive early-out the outcome is raw-text
        // deterministic; reuse scans done under any other generic env.
        if (hir_name_id_map_get(self.raw_class_scan_stamp,type_text) == self.raw_class_index_version) {
            let out_scan = self.remember_raw_class_decl_lookup(type_text,
                                                               hir_raw_name_map_get(self.raw_class_scan_cache,type_text));
            if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
            return out_scan;
        }
        let concrete_class = self.raw_concrete_class_decl_for_type_text(type_text);
        if (concrete_class != null) {
            let out_concrete = self.remember_raw_class_decl_lookup(type_text, concrete_class);
            if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
            return out_concrete;
        }
        let exact_item_raw = self.raw_registered_class_decl_for_type_exact(type_text);
        if (exact_item_raw != null) {
            let out_item = self.remember_raw_class_decl_lookup(type_text, exact_item_raw);
            if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
            return out_item;
        }
        if (base.len == 0) {
            let out_null_base = self.remember_raw_class_decl_lookup(type_text, null);
            if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
            return out_null_base;
        }
        let indexed_base = hir_raw_name_map_get(self.raw_class_exact,base);
        if (indexed_base != null
            && (decl_get_kind(indexed_base) == de_CLASS() || decl_get_kind(indexed_base) == de_ENUM())) {
            let out_indexed = self.remember_raw_class_decl_lookup(type_text, indexed_base);
            if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
            return out_indexed;
        }
        if (concrete_args.len > 0) {
            var spec_item_id: i32 = 1;
            while (spec_item_id <= self.unit.item_count) {
                let spec_item_kind = self.unit.item_kind(spec_item_id);
                if ((spec_item_kind == hir_item_class() || spec_item_kind == hir_item_enum())
                    && hir_builder_last_path_segment(self.unit.item_name(spec_item_id)) == base) {
                    let spec_raw = hir_pointer_map_raw_for_item(self.decl_map,spec_item_id);
                    if (spec_raw != null
                        && (decl_get_kind(spec_raw) == de_CLASS() || decl_get_kind(spec_raw) == de_ENUM())
                        && hir_builder_generic_head(decl_get_generic_params(spec_raw)) == concrete_args
                        && !self.decl_members_have_template_type(spec_raw)) {
                        let out_spec = self.remember_raw_class_decl_lookup(type_text, spec_raw);
                        if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
                        return out_spec;
                    }
                }
                spec_item_id = spec_item_id + 1;
            }
        }
        var item_id: i32 = 1;
        while (item_id <= self.unit.item_count) {
            let item_kind = self.unit.item_kind(item_id);
            if ((item_kind == hir_item_class() || item_kind == hir_item_enum())
                && hir_builder_type_owner_names_match(self.unit.item_name(item_id), base)) {
                let raw = hir_pointer_map_raw_for_item(self.decl_map,item_id);
                if (raw != null && (decl_get_kind(raw) == de_CLASS() || decl_get_kind(raw) == de_ENUM())) {
                    let out_raw = self.remember_raw_class_decl_lookup(type_text, raw);
                    if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
                    return out_raw;
                }
            }
            item_id = item_id + 1;
        }
        let out_miss = self.remember_raw_class_decl_lookup(type_text, null);
        if (hot_timing) { self.profile_ms_raw_class = self.profile_ms_raw_class + (vyx_bootstrap_now_ms() - hot_start); }
        return out_miss;
    }

    fn raw_drop_decl_for_type_text(self, type_text: string) -> rawptr {
        let cd = self.raw_class_decl_for_type_text(type_text);
        if (cd == null) { return null; }
        var member = decl_get_members(cd);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && decl_get_name(member) == "drop"
                && !decl_get_is_static(member)) {
                return member;
            }
            member = decl_get_next(member);
        }
        return null;
    }

    fn raw_method_decl_for_type_text(self, type_text: string, method_name: string) -> rawptr {
        if (method_name.len == 0) { return null; }
        let concrete_method = self.raw_concrete_method_decl_for_type_text(type_text, method_name, false);
        if (concrete_method != null) { return concrete_method; }
        let cd = self.raw_class_decl_for_type_text(type_text);
        if (cd == null) { return null; }
        var member = decl_get_members(cd);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && hir_builder_method_name_matches_lookup(decl_get_name(member), method_name)
                && !decl_get_is_static(member)) {
                return member;
            }
            member = decl_get_next(member);
        }
        let inherited = self.raw_method_decl_from_layout_parents(cd,
                                                                   method_name,
                                                                   false,
                                                                   0);
        if (inherited != null) { return inherited; }
        return self.raw_interface_default_method_decl_for_type_text(type_text, method_name);
    }

    fn raw_direct_method_decl_for_type_text(self,
                                                  type_text: string,
                                                  method_name: string,
                                                  want_static: bool) -> rawptr {
        if (type_text.len == 0 || method_name.len == 0) { return null; }
        let cd = self.raw_class_decl_for_type_text(type_text);
        if (cd == null) { return null; }
        var member = decl_get_members(cd);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && hir_builder_method_name_matches_lookup(decl_get_name(member), method_name)
                && hir_builder_method_decl_matches_static_use(member, want_static)) {
                return member;
            }
            member = decl_get_next(member);
        }
        return null;
    }

    fn raw_method_decl_on_class_tree(self,
                                           class_decl: rawptr,
                                           method_name: string,
                                           want_static: bool,
                                           depth: i32) -> rawptr {
        if (class_decl == null || method_name.len == 0 || depth > 32) { return null; }
        var member = decl_get_members(class_decl);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && hir_builder_method_name_matches_lookup(decl_get_name(member), method_name)
                && hir_builder_method_decl_matches_static_use(member, want_static)) {
                return member;
            }
            member = decl_get_next(member);
        }
        return self.raw_method_decl_from_layout_parents(class_decl,
                                                         method_name,
                                                         want_static,
                                                         depth + 1);
    }

    fn raw_method_decl_from_layout_parents(self,
                                                   class_decl: rawptr,
                                                   method_name: string,
                                                   want_static: bool,
                                                   depth: i32) -> rawptr {
        if (class_decl == null || method_name.len == 0 || depth > 32) { return null; }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(class_decl, parent_i);
            if (parent_decl == null) { return null; }
            let found = self.raw_method_decl_on_class_tree(parent_decl,
                                                            method_name,
                                                            want_static,
                                                            depth);
            if (found != null) { return found; }
            parent_i = parent_i + 1;
        }
        return null;
    }

    fn raw_method_name_count_on_class_tree(self,
                                                 class_decl: rawptr,
                                                 method_name: string,
                                                 depth: i32) -> i32 {
        if (class_decl == null || method_name.len == 0 || depth > 32) { return 0; }
        var count: i32 = 0;
        var member = decl_get_members(class_decl);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && hir_builder_method_name_matches_lookup(decl_get_name(member), method_name)) {
                count = count + 1;
            }
            member = decl_get_next(member);
        }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(class_decl, parent_i);
            if (parent_decl == null) { break; }
            count = count + self.raw_method_name_count_on_class_tree(parent_decl,
                                                                      method_name,
                                                                      depth + 1);
            parent_i = parent_i + 1;
        }
        return count;
    }

    fn owner_method_name_is_overloaded(self, owner_type_name: string, method_name: string) -> bool {
        if (owner_type_name.len == 0 || method_name.len == 0) { return false; }
        let cached = hir_pair_id_map_get(self.owner_method_overload_cache,owner_type_name, method_name);
        if (cached == 2) { return true; }
        if (cached == 1) { return false; }
        var count: i32 = 0;
        let class_decl = self.raw_class_decl_for_type_text(owner_type_name);
        if (class_decl != null) {
            count = count + self.raw_method_name_count_on_class_tree(class_decl, method_name, 0);
            if (count > 1) {
                self.owner_method_overload_cache = hir_pair_id_map_put(self.owner_method_overload_cache,owner_type_name, method_name, 2);
                return true;
            }
        }
        let template_decl = self.raw_template_class_decl_for_type_text(owner_type_name);
        if (template_decl != null && template_decl != class_decl) {
            count = count + self.raw_method_name_count_on_class_tree(template_decl, method_name, 0);
            if (count > 1) {
                self.owner_method_overload_cache = hir_pair_id_map_put(self.owner_method_overload_cache,owner_type_name, method_name, 2);
                return true;
            }
        }
        self.owner_method_overload_cache = hir_pair_id_map_put(self.owner_method_overload_cache,owner_type_name, method_name, 1);
        return false;
    }

    fn raw_interface_decl_for_trait_name(self, trait_name: string) -> rawptr {
        if (trait_name.len == 0) { return null; }
        let cached = hir_raw_name_map_get(self.interface_decl_cache,trait_name);
        if (cached != null) { return cached; }
        if (hir_name_id_map_get(self.interface_decl_miss_cache,trait_name) != hir_id_invalid()) { return null; }
        let direct = self.find_class_decl(trait_name);
        if (direct != null
            && (((decl_get_generic_flags(direct) & 2) != 0)
                || hir_builder_string_contains(decl_get_generic_params(direct), "|kind:interface"))) {
            self.interface_decl_cache = hir_raw_name_map_put(self.interface_decl_cache,trait_name, direct);
            return direct;
        }
        var cur = self.decl_map.head;
        while (cur != null) {
            let candidate = ast_read_rawptr(cur);
            if (candidate != null
                && decl_get_kind(candidate) == de_CLASS()
                && (((decl_get_generic_flags(candidate) & 2) != 0)
                    || hir_builder_string_contains(decl_get_generic_params(candidate), "|kind:interface"))
                && hir_builder_trait_names_match(decl_get_name(candidate), trait_name)) {
                self.interface_decl_cache = hir_raw_name_map_put(self.interface_decl_cache,trait_name, candidate);
                return candidate;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        self.interface_decl_miss_cache = hir_name_id_map_put(self.interface_decl_miss_cache,trait_name, 1);
        return null;
    }

    fn raw_interface_default_method_decl_on_trait(self,
                                                        trait_decl: rawptr,
                                                        method_name: string,
                                                        depth: i32) -> rawptr {
        if (trait_decl == null || method_name.len == 0 || depth > 8) { return null; }
        if ((decl_get_generic_flags(trait_decl) & 2) == 0) { return null; }
        var member = decl_get_members(trait_decl);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && hir_builder_method_name_matches_lookup(decl_get_name(member), method_name)
                && !decl_get_is_static(member)
                && self.raw_function_body_decl_for(member) != null) {
                return member;
            }
            member = decl_get_next(member);
        }
        let gp = decl_get_generic_params(trait_decl);
        var idx: i32 = 0;
        while (idx < 64) {
            let super_name = hir_builder_impl_trait_at(gp, idx);
            if (super_name.len == 0) { break; }
            let super_decl = self.raw_interface_decl_for_trait_name(super_name);
            if (super_decl != null && super_decl != trait_decl) {
                let inherited = self.raw_interface_default_method_decl_on_trait(super_decl,
                                                                                method_name,
                                                                                depth + 1);
                if (inherited != null) { return inherited; }
            }
            idx = idx + 1;
        }
        return null;
    }

    fn raw_interface_default_method_decl_for_type_text(self,
                                                              type_text: string,
                                                              method_name: string) -> rawptr {
        if (type_text.len == 0 || method_name.len == 0) { return null; }
        let cd = self.raw_class_decl_for_type_text(type_text);
        if (cd == null || ((decl_get_generic_flags(cd) & 64) == 0)) { return null; }
        let gp = decl_get_generic_params(cd);
        var idx: i32 = 0;
        while (idx < 64) {
            let trait_name = hir_builder_impl_trait_at(gp, idx);
            if (trait_name.len == 0) { break; }
            let trait_decl = self.raw_interface_decl_for_trait_name(trait_name);
            if (trait_decl != null) {
                let method_decl = self.raw_interface_default_method_decl_on_trait(trait_decl,
                                                                                  method_name,
                                                                                  0);
                if (method_decl != null) { return method_decl; }
            }
            idx = idx + 1;
        }
        return null;
    }

    fn raw_static_method_decl_for_type_text(self, type_text: string, method_name: string) -> rawptr {
        if (method_name.len == 0) { return null; }
        let concrete_method = self.raw_concrete_method_decl_for_type_text(type_text, method_name, true);
        if (concrete_method != null) { return concrete_method; }
        let cd = self.raw_class_decl_for_type_text(type_text);
        if (cd == null) { return null; }
        var member = decl_get_members(cd);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && hir_builder_method_name_matches_lookup(decl_get_name(member), method_name)
                && hir_builder_method_decl_matches_static_use(member, true)) {
                return member;
            }
            member = decl_get_next(member);
        }
        return self.raw_method_decl_from_layout_parents(cd,
                                                         method_name,
                                                         true,
                                                         0);
    }

    fn canonical_method_decl_for_owner_type(self,
                                                  method_decl: rawptr,
                                                  owner_type_name: string) -> rawptr {
        if (method_decl == null
            || owner_type_name.len == 0
            || decl_get_kind(method_decl) != de_METHOD()) {
            return method_decl;
        }
        let owner_args = policy_generic_call_args(owner_type_name.clone());
        let direct_owner = hir_raw_owner_map_get(self.decl_owner_map,method_decl);
        if (owner_args.len == 0
            && direct_owner != null
            && hir_builder_decl_template_params(direct_owner).len == 0
            && !self.decl_body_has_template_type(method_decl)) {
            return method_decl;
        }
        if (self.type_text_has_open_template_atom(owner_type_name)) {
            return method_decl;
        }
        var concrete: rawptr = null;
        var templ: rawptr = null;
        if (decl_get_is_static(method_decl)) {
            concrete = self.raw_concrete_method_decl_for_type_text(owner_type_name,
                                                                   decl_get_name(method_decl),
                                                                   true);
            templ = self.raw_template_method_decl_for_type_text(owner_type_name,
                                                                decl_get_name(method_decl),
                                                                true);
        } else {
            concrete = self.raw_concrete_method_decl_for_type_text(owner_type_name,
                                                                   decl_get_name(method_decl),
                                                                   false);
            templ = self.raw_template_method_decl_for_type_text(owner_type_name,
                                                                decl_get_name(method_decl),
                                                                false);
        }
        if (concrete == method_decl) {
            return method_decl;
        }
        if (concrete != null
            && hir_builder_decl_specialization_shape_matches(method_decl, concrete)) {
            if (self.raw_function_body_decl_for(concrete) != null) { return concrete; }
        }
        if (templ == method_decl) {
            return method_decl;
        }
        if (concrete != null
            && !self.decl_body_has_template_type(method_decl)
            && !self.decl_body_has_template_type(concrete)
            && !hir_builder_decl_signature_matches(method_decl, concrete)) {
            concrete = null;
        }
        if (templ != null
            && !self.decl_body_has_template_type(method_decl)
            && !self.decl_body_has_template_type(templ)
            && !hir_builder_decl_signature_matches(method_decl, templ)) {
            templ = null;
        }
        if (concrete != null && self.raw_function_body_decl_for(concrete) != null) { return concrete; }
        if (templ != null && self.raw_function_body_decl_for(templ) != null) { return templ; }
        if (concrete != null) { return concrete; }
        if (templ != null) { return templ; }
        return method_decl;
    }

    fn owner_decl_matches_concrete_type(self, owner_decl: rawptr, type_text: string) -> bool {
        if (owner_decl == null || type_text.len == 0) { return false; }
        let k = decl_get_kind(owner_decl);
        if (k != de_CLASS() && k != de_ENUM()) { return false; }
        let concrete_decl = self.raw_class_decl_for_type_text(type_text);
        if (concrete_decl != null
            && self.class_decl_is_or_inherits(concrete_decl, owner_decl, 0)) {
            return true;
        }
        return self.raw_owner_decl_matches_type_base(owner_decl, type_text);
    }

    fn class_decl_is_or_inherits(self, class_decl: rawptr, ancestor_decl: rawptr, depth: i32) -> bool {
        if (class_decl == null || ancestor_decl == null || depth > 32) { return false; }
        if (depth == 0) {
            let cached = hir_raw_pair_int_map_get(self.class_inherits_cache,class_decl, ancestor_decl);
            if (cached == 2) { return true; }
            if (cached == 1) { return false; }
        }
        if (class_decl == ancestor_decl) { return true; }
        var out = false;
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(class_decl, parent_i);
            if (parent_decl == null) { break; }
            if (self.class_decl_is_or_inherits(parent_decl, ancestor_decl, depth + 1)) {
                out = true;
                break;
            }
            parent_i = parent_i + 1;
        }
        if (depth == 0) {
            if (out) {
                self.class_inherits_cache = hir_raw_pair_int_map_put(self.class_inherits_cache,class_decl, ancestor_decl, 2);
            } else {
                self.class_inherits_cache = hir_raw_pair_int_map_put(self.class_inherits_cache,class_decl, ancestor_decl, 1);
            }
        }
        return out;
    }

    fn interface_decl_extends_trait_name(self, interface_decl: rawptr, trait_name: string, depth: i32) -> bool {
        if (interface_decl == null || trait_name.len == 0 || depth > 16) { return false; }
        if ((decl_get_generic_flags(interface_decl) & 2) == 0) { return false; }
        if (hir_builder_trait_names_match(decl_get_name(interface_decl), trait_name)) { return true; }
        let gp = decl_get_generic_params(interface_decl);
        var idx: i32 = 0;
        while (idx < 64) {
            let super_name = hir_builder_impl_trait_at(gp, idx);
            if (super_name.len == 0) { break; }
            if (hir_builder_trait_names_match(super_name, trait_name)) { return true; }
            let super_decl = self.raw_interface_decl_for_trait_name(super_name);
            if (super_decl != null && super_decl != interface_decl) {
                if (self.interface_decl_extends_trait_name(super_decl, trait_name, depth + 1)) {
                    return true;
                }
            }
            idx = idx + 1;
        }
        return false;
    }

    fn class_decl_implements_trait_name(self, class_decl: rawptr, trait_name: string, depth: i32) -> bool {
        if (class_decl == null || trait_name.len == 0 || depth > 32) { return false; }
        let gp = decl_get_generic_params(class_decl);
        var idx: i32 = 0;
        while (idx < 64) {
            let item = hir_builder_impl_trait_at(gp, idx);
            if (item.len == 0) { break; }
            let interface_decl = self.raw_interface_decl_for_trait_name(item);
            if (interface_decl != null) {
                if (hir_builder_trait_names_match(item, trait_name)
                    || self.interface_decl_extends_trait_name(interface_decl, trait_name, 0)) {
                    return true;
                }
            }
            idx = idx + 1;
        }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(class_decl, parent_i);
            if (parent_decl == null) { return false; }
            if (self.class_decl_implements_trait_name(parent_decl, trait_name, depth + 1)) {
                return true;
            }
            parent_i = parent_i + 1;
        }
        return false;
    }

    fn type_text_satisfies_dyn_trait(self, actual_type: string, trait_name: string) -> bool {
        if (actual_type.len == 0 || trait_name.len == 0) { return false; }
        let cached = hir_pair_id_map_get(self.dyn_trait_satisfaction_cache,actual_type, trait_name);
        if (cached == 2) { return true; }
        if (cached == 1) { return false; }
        var out = false;
        if (hir_builder_trait_names_match(actual_type, trait_name)) {
            out = true;
            self.dyn_trait_satisfaction_cache = hir_pair_id_map_put(self.dyn_trait_satisfaction_cache,actual_type, trait_name, 2);
            return out;
        }
        let actual_dyn_trait = self.dyn_interface_name_from_type_text(actual_type);
        if (actual_dyn_trait.len > 0) {
            if (hir_builder_trait_names_match(actual_dyn_trait, trait_name)) {
                self.dyn_trait_satisfaction_cache = hir_pair_id_map_put(self.dyn_trait_satisfaction_cache,actual_type, trait_name, 2);
                return true;
            }
            let actual_iface = self.raw_interface_decl_for_trait_name(actual_dyn_trait);
            if (actual_iface != null) {
                out = self.interface_decl_extends_trait_name(actual_iface, trait_name, 0);
                if (out) {
                    self.dyn_trait_satisfaction_cache = hir_pair_id_map_put(self.dyn_trait_satisfaction_cache,actual_type, trait_name, 2);
                } else {
                    self.dyn_trait_satisfaction_cache = hir_pair_id_map_put(self.dyn_trait_satisfaction_cache,actual_type, trait_name, 1);
                }
                return out;
            }
            self.dyn_trait_satisfaction_cache = hir_pair_id_map_put(self.dyn_trait_satisfaction_cache,actual_type, trait_name, 1);
            return false;
        }
        let class_decl = self.raw_class_decl_for_type_text(actual_type);
        if (class_decl == null) {
            self.dyn_trait_satisfaction_cache = hir_pair_id_map_put(self.dyn_trait_satisfaction_cache,actual_type, trait_name, 1);
            return false;
        }
        if ((decl_get_generic_flags(class_decl) & 2) != 0) {
            out = self.interface_decl_extends_trait_name(class_decl, trait_name, 0);
        } else {
            out = self.class_decl_implements_trait_name(class_decl, trait_name, 0);
        }
        if (out) {
            self.dyn_trait_satisfaction_cache = hir_pair_id_map_put(self.dyn_trait_satisfaction_cache,actual_type, trait_name, 2);
        } else {
            self.dyn_trait_satisfaction_cache = hir_pair_id_map_put(self.dyn_trait_satisfaction_cache,actual_type, trait_name, 1);
        }
        return out;
    }

    fn owner_decl_accepts_owner_type(self, owner_decl: rawptr, owner_type_name: string) -> bool {
        if (owner_decl == null) { return true; }
        if (owner_type_name.len == 0) { return true; }
        if (self.owner_decl_matches_concrete_type(owner_decl, owner_type_name)) { return true; }
        if ((decl_get_generic_flags(owner_decl) & 2) != 0) {
            let class_decl = self.raw_class_decl_for_type_text(owner_type_name);
            if (class_decl == null) { return true; }
            return self.class_decl_implements_trait_name(class_decl, decl_get_name(owner_decl), 0);
        }
        return false;
    }

    fn method_owner_decl_for_type_text(self,
                                             method_decl: rawptr,
                                             type_text: string,
                                             default_owner: rawptr) -> rawptr {
        if (method_decl == null) { return default_owner; }
        let can_cache = default_owner != null
            && type_text.len > 0
            && policy_generic_call_args(type_text.clone()).len == 0
            && !self.type_text_has_open_template_atom(type_text);
        if (can_cache) {
            let cached_owner = hir_raw_pair_raw_map_get(self.method_owner_decl_cache,method_decl, default_owner);
            if (cached_owner != null) { return cached_owner; }
        }
        let method_owner = hir_raw_owner_map_get(self.decl_owner_map,method_decl);
        if (can_cache
            && method_owner != null
            && hir_builder_decl_template_params(method_owner).len == 0
            && (default_owner == method_owner
                || self.class_decl_is_or_inherits(default_owner, method_owner, 0))) {
            let out_fast = self.generic_owner_decl_for_method_body(method_decl, method_owner);
            if (out_fast != null) {
                self.method_owner_decl_cache = hir_raw_pair_raw_map_put(self.method_owner_decl_cache,method_decl, default_owner, out_fast);
                return out_fast;
            }
        }
        var owner_decl = self.raw_template_class_decl_for_type_text(type_text);
        if (self.owner_decl_matches_concrete_type(method_owner, type_text)) {
            owner_decl = method_owner;
        }
        if (owner_decl == null) { owner_decl = default_owner; }
        if (owner_decl == null) { owner_decl = method_owner; }
        if (owner_decl == null) { owner_decl = self.raw_class_decl_for_type_text(type_text); }
        let out = self.generic_owner_decl_for_method_body(method_decl, owner_decl);
        if (can_cache && out != null) {
            self.method_owner_decl_cache = hir_raw_pair_raw_map_put(self.method_owner_decl_cache,method_decl, default_owner, out);
        }
        return out;
    }

    fn raw_method_decl_matches_closed_receiver(self,
                                                     method_decl: rawptr,
                                                     owner_type_name: string,
                                                     method_name: string,
                                                     want_static: bool) -> bool {
        if (method_decl == null
            || owner_type_name.len == 0
            || method_name.len == 0
            || decl_get_kind(method_decl) != de_METHOD()
            || !hir_builder_method_name_matches_lookup(decl_get_name(method_decl), method_name)
            || !hir_builder_method_decl_matches_static_use(method_decl, want_static)) {
            return false;
        }
        let owner_decl = hir_raw_owner_map_get(self.decl_owner_map,method_decl);
        if (owner_decl == null) { return true; }
        if (self.owner_decl_accepts_owner_type(owner_decl, owner_type_name)) { return true; }
        let template_owner = self.raw_template_class_decl_for_type_text(owner_type_name);
        if (template_owner != null && template_owner == owner_decl) { return true; }
        return false;
    }

    fn semantic_method_decl_for_member_ast(self,
                                                 member_expr: rawptr,
                                                 owner_type_name: string,
                                                 method_name: string,
                                                 want_static: bool) -> rawptr {
        if (member_expr == null || expr_get_kind(member_expr) != ex_MEMBER()) { return null; }
        let raw_target = expr_get_semantic_target(member_expr);
        if (self.raw_method_decl_matches_closed_receiver(raw_target,
                                                         owner_type_name,
                                                         method_name,
                                                         want_static)) {
            return raw_target;
        }
        if (self.raw_method_overload_count_for_type_text(owner_type_name,
                                                         method_name,
                                                         want_static) > 1) {
            return null;
        }
        if (!self.raw_method_decl_matches_closed_receiver(raw_target,
                                                          owner_type_name,
                                                          method_name,
                                                          want_static)) {
            return null;
        }
        let raw_owner = hir_raw_owner_map_get(self.decl_owner_map,raw_target);
        if (raw_owner != null
            && !self.raw_owner_decl_matches_type_exact(raw_owner, owner_type_name)) {
            let direct_method = self.raw_direct_method_decl_for_type_text(owner_type_name,
                                                                          method_name,
                                                                          want_static);
            if (direct_method != null && direct_method != raw_target) {
                return null;
            }
        }
        return raw_target;
    }

    fn raw_versioned_method_decl_for_call(self,
                                          owner_type_name: string,
                                          method_name: string,
                                          selected_name: string,
                                          want_static: bool,
                                          call_expr: rawptr,
                                          call_expr_id: i32) -> rawptr {
        if (owner_type_name.len == 0
            || method_name.len == 0
            || policy_module_selector_index(selected_name) < 0) {
            return null;
        }
        let wanted_version = policy_module_version(selected_name);
        let wanted_variant = policy_module_variant(selected_name);
        if (wanted_version.len == 0) { return null; }
        var best: rawptr = null;
        var best_score: i32 = -1;
        // The pointer-map linked list is a registration index, not an
        // authoritative function order.  Migration merges append cloned
        // members late and can make them shadow the original declaration in
        // that chain.  FunctionId -> raw declaration preserves every
        // registered implementation, including the historical original.
        var candidate_fn: i32 = 1;
        while (candidate_fn <= self.unit.function_count) {
            let candidate = hir_pointer_map_raw_for_function(self.decl_map,
                                                              candidate_fn);
            if (candidate != null
                && decl_get_kind(candidate) == de_METHOD()
                && hir_builder_method_name_matches_lookup(
                    decl_get_name(candidate),
                    method_name.clone())
                && hir_builder_method_decl_matches_static_use(candidate,
                                                               want_static)) {
                let source_module = hir_builder_decl_source_module(candidate);
                let source_variant = policy_module_variant(source_module);
                let variant_matches = wanted_variant.len == 0
                    || source_variant == wanted_variant;
                let owner_decl = hir_raw_owner_map_get(self.decl_owner_map,
                                                       candidate);
                let owner_module = hir_builder_decl_source_module(owner_decl);
                let owner_version = policy_module_version(owner_module);
                let owner_variant = policy_module_variant(owner_module);
                // A migration merge keeps historical method clones under the
                // newest class owner.  The clone's member metadata still says
                // `from:old-version`, so source-only matching would bind an
                // explicit `method@old-version` call to the newest body.
                // For a version selector the declaration owner must also be
                // from that version (or have no module provenance at all).
                let owner_module_matches = owner_module.len == 0
                    || (owner_version == wanted_version
                        && (wanted_variant.len == 0
                            || owner_variant == wanted_variant));
                let source_version_matches = policy_module_version(source_module)
                    == wanted_version;
                let owner_type_matches = self.owner_decl_accepts_owner_type(owner_decl,
                                                                             owner_type_name);
                if (source_version_matches
                    && variant_matches
                    && owner_module_matches
                    && owner_type_matches) {
                    let score = self.method_decl_score_for_call(call_expr,
                                                                call_expr_id,
                                                                candidate,
                                                                owner_type_name);
                    if (score > best_score) {
                        best = candidate;
                        best_score = score;
                    }
                }
            }
            candidate_fn = candidate_fn + 1;
        }
        return best;
    }

    fn raw_method_overload_count_on_class_tree(self,
                                                     class_decl: rawptr,
                                                     method_name: string,
                                                     want_static: bool,
                                                     depth: i32) -> i32 {
        if (class_decl == null || method_name.len == 0 || depth > 32) { return 0; }
        var count: i32 = 0;
        var member = decl_get_members(class_decl);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && hir_builder_method_name_matches_lookup(decl_get_name(member), method_name)
                && hir_builder_method_decl_matches_static_use(member, want_static)) {
                count = count + 1;
            }
            member = decl_get_next(member);
        }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(class_decl, parent_i);
            if (parent_decl == null) { break; }
            count = count + self.raw_method_overload_count_on_class_tree(parent_decl,
                                                                       method_name,
                                                                       want_static,
                                                                       depth + 1);
            parent_i = parent_i + 1;
        }
        return count;
    }

    fn raw_method_overload_count_for_type_text(self,
                                                     type_text: string,
                                                     method_name: string,
                                                     want_static: bool) -> i32 {
        if (type_text.len == 0 || method_name.len == 0) { return 0; }
        var cache_key = method_name;
        if (want_static) {
            cache_key = cache_key + "|static=1";
        } else {
            cache_key = cache_key + "|static=0";
        }
        let cached = hir_pair_id_map_get(self.raw_method_overload_count_cache,type_text, cache_key);
        if (cached != hir_id_invalid()) { return cached; }
        let cd = self.raw_class_decl_for_type_text(type_text);
        if (cd == null) {
            self.raw_method_overload_count_cache = hir_pair_id_map_put(self.raw_method_overload_count_cache,type_text, cache_key, 0);
            return 0;
        }
        let out = self.raw_method_overload_count_on_class_tree(cd, method_name, want_static, 0);
        self.raw_method_overload_count_cache = hir_pair_id_map_put(self.raw_method_overload_count_cache,type_text, cache_key, out);
        return out;
    }

    fn closed_method_target_for_type_text(self,
                                                 owner_type_name: string,
                                                 method_name: string,
                                                 call_expr: rawptr,
                                                 call_expr_id: i32,
                                                 method_decl: rawptr,
                                                 want_static: bool) -> i32 {
        if (owner_type_name.len == 0
            || method_name.len == 0
            || self.type_text_has_open_template_atom(owner_type_name)) {
            return hir_id_invalid();
        }
        if (method_decl == null
            && call_expr_id == hir_id_invalid()
            && call_expr == null
            && self.owner_method_name_is_overloaded(owner_type_name, method_name)) {
            return hir_id_invalid();
        }
        var selected_decl = method_decl;
        if (!self.raw_method_decl_matches_closed_receiver(selected_decl,
                                                          owner_type_name,
                                                          method_name,
                                                          want_static)) {
            selected_decl = null;
        }
        // A shallow interface may describe both a trait requirement and an
        // exact, non-generic implementation in another object. Bind the
        // latter by its imported ABI identity after checking the complete
        // signature with Self substituted. It has no body to instantiate.
        if (!want_static && selected_decl != null
            && self.raw_function_body_decl_for(selected_decl) == null) {
            let imported_impl = self.imported_impl_method_for_requirement(selected_decl,
                                                                          owner_type_name);
            if (imported_impl != null) {
                let imported_fn = hir_pointer_map_function(self.decl_map,imported_impl);
                if (imported_fn != hir_id_invalid()
                    && !self.function_has_open_template_types(imported_fn)) {
                    return imported_fn;
                }
            }
        }
        // Sema deliberately keeps a trait requirement as the provenance of a
        // generic call. Once the receiver is closed that declaration is only
        // a signature, not a body source. Resolve the receiver's concrete impl
        // before publishing an instance shell for the bodyless requirement.
        if (selected_decl != null
            && !want_static
            && !hir_builder_decl_is_foreign_dci_native(selected_decl)
            && self.raw_function_body_decl_for(selected_decl) == null) {
            var concrete_impl = self.concrete_impl_method_decl_for_call(method_name,
                                                                        owner_type_name,
                                                                        call_expr,
                                                                        call_expr_id);
            if (concrete_impl == null && call_expr_id == hir_id_invalid()) {
                concrete_impl = self.concrete_impl_method_decl(method_name,
                                                                owner_type_name);
            }
            if (concrete_impl != null
                && concrete_impl != selected_decl
                && self.raw_method_decl_matches_closed_receiver(concrete_impl,
                                                                 owner_type_name,
                                                                 method_name,
                                                                 false)) {
                selected_decl = concrete_impl;
            }
        }
        // Generic-bound member expressions initially carry the interface
        // prototype selected by Sema. That prototype does not belong to the
        // now-concrete receiver, so recover the implementation from the
        // receiver class before instance creation. Otherwise a synthetic
        // `Self` declaration is emitted for a bodyless requirement.
        if (selected_decl == null && !want_static) {
            let receiver_decl = self.raw_class_decl_for_type_text(owner_type_name);
            let receiver_method = self.raw_method_decl_for_call_on_class_tree(
                receiver_decl,
                method_name,
                false,
                call_expr,
                call_expr_id,
                owner_type_name,
                0);
            if (receiver_method != null
                && self.raw_method_decl_matches_closed_receiver(receiver_method,
                                                                 owner_type_name,
                                                                 method_name,
                                                                 false)) {
                selected_decl = receiver_method;
            }
        }
        // A foreign DCI method keeps the ABI owner that declared it.  In
        // particular, an inherited non-primary C++ base method must remain an
        // `A` target when invoked through `RightDerived`: LLVM then adjusts
        // the receiver to the A base subobject before issuing the native
        // call.  Instantiating it as a synthetic RightDerived::method loses
        // that owner and passes the complete-object address to the C++ ABI.
        // Resolve a concrete foreign declaration before receiver-closure or
        // instance creation; the latter is only valid for language bodies.
        var direct_foreign_decl = selected_decl;
        if (direct_foreign_decl == null && call_expr_id != hir_id_invalid()) {
            let call_callee_expr_id = self.unit.expr_lhs(call_expr_id);
            direct_foreign_decl = self.raw_method_decl_for_call_expr(call_expr,
                                                                      call_expr_id,
                                                                      call_callee_expr_id);
        }
        if (direct_foreign_decl == null
            && !self.owner_method_name_is_overloaded(owner_type_name, method_name)) {
            direct_foreign_decl = self.raw_method_decl_for_type_text(owner_type_name,
                                                                      method_name);
        }
        if (direct_foreign_decl != null
            && hir_builder_decl_is_foreign_dci_native(direct_foreign_decl)) {
            let direct_foreign_fn = hir_pointer_map_function(self.decl_map,direct_foreign_decl);
            if (direct_foreign_fn != hir_id_invalid()
                && self.function_candidate_matches_method_name(direct_foreign_fn, method_name)
                && !self.function_has_open_template_types(direct_foreign_fn)) {
                return direct_foreign_fn;
            }
        }
        var out_fn = hir_id_invalid();
        if (call_expr_id != hir_id_invalid() || selected_decl != null) {
            out_fn = self.ensure_method_instance_for_call(owner_type_name,
                                                          method_name,
                                                          call_expr,
                                                          call_expr_id,
                                                          selected_decl,
                                                          want_static);
        }
        if (out_fn == hir_id_invalid() && call_expr_id != hir_id_invalid()) {
            var template_decl = self.raw_template_method_decl_for_call_type_text(owner_type_name,
                                                                                 method_name,
                                                                                 want_static,
                                                                                 call_expr,
                                                                                 call_expr_id);
            if (template_decl == null) {
                template_decl = self.raw_template_method_decl_for_type_text(owner_type_name,
                                                                            method_name,
                                                                            want_static);
            }
            if (template_decl != null && template_decl != selected_decl) {
                out_fn = self.ensure_method_instance_for_call(owner_type_name,
                                                              method_name,
                                                              call_expr,
                                                              call_expr_id,
                                                              template_decl,
                                                              want_static);
            }
        }
        if (out_fn == hir_id_invalid()) {
            if (want_static) {
                out_fn = self.ensure_static_method_instance_for_type_text(owner_type_name, method_name);
            } else {
                out_fn = self.ensure_method_instance_for_type_text(owner_type_name, method_name);
            }
        }
        if (out_fn == hir_id_invalid()) {
            out_fn = self.method_function_target_by_owner_type_and_method(owner_type_name, method_name);
        }
        if (out_fn != hir_id_invalid() && !want_static) {
            let callee_expr_id = if (call_expr_id != hir_id_invalid()) {
                self.unit.expr_lhs(call_expr_id)
            } else {
                hir_id_invalid()
            };
            // A version family can register several ABI-identical direct
            // methods under the same canonical owner name.  The owner/name
            // scan below is intentionally unordered and therefore must not
            // replace Sema's authoritative version/overload declaration with
            // the first historical function it encounters.  Preserve an
            // already closed, call-compatible semantic declaration; only use
            // the direct receiver scan to replace synthetic/open instances.
            let selected_direct_fn = hir_pointer_map_function(self.decl_map,
                                                               selected_decl);
            let selected_direct_matches = selected_direct_fn != hir_id_invalid()
                && !self.function_has_open_template_types(selected_direct_fn)
                && self.function_candidate_matches_method_name(selected_direct_fn,
                                                                 method_name)
                && (call_expr_id == hir_id_invalid()
                    || self.hir_function_arg_score_for_call(call_expr_id,
                                                             callee_expr_id,
                                                             selected_direct_fn) >= 0);
            // An inherited language body that invokes another member through
            // `self` must be closed for the concrete receiver.  Replacing
            // that closed A2::greet instance with A1::greet here freezes all
            // nested `self.kind()` dispatches at the base implementation.
            // Foreign methods returned above retain their ABI owner; this
            // rule is solely for Vyx method bodies.
            var selected_direct_reusable = true;
            if (selected_decl != null
                && !hir_builder_decl_is_foreign_dci_native(selected_decl)) {
                let selected_owner = hir_raw_owner_map_get(self.decl_owner_map,
                                                            selected_decl);
                let receiver_owner = self.raw_class_decl_for_type_text(owner_type_name);
                if (selected_owner != null
                    && receiver_owner != null
                    && receiver_owner != selected_owner
                    && self.class_decl_is_or_inherits(receiver_owner,
                                                       selected_owner,
                                                       0)) {
                    let selected_body = self.method_body_decl_for_instance(selected_decl);
                    if (self.decl_body_has_self_member_call_cached(selected_body)) {
                        selected_direct_reusable = false;
                    }
                }
            }
            if (selected_direct_matches && selected_direct_reusable) {
                out_fn = selected_direct_fn;
            } else if (!selected_direct_matches) {
                let direct_fn = self.direct_method_function_for_closed_receiver(
                    owner_type_name,
                    method_name,
                    call_expr_id,
                    callee_expr_id);
                if (direct_fn != hir_id_invalid()) { out_fn = direct_fn; }
            }
        }        if (out_fn == hir_id_invalid() || self.function_has_open_template_types(out_fn)) {
            return hir_id_invalid();
        }
        if (!self.function_candidate_matches_method_name(out_fn, method_name)) {
            return hir_id_invalid();
        }
        // Owner/name instance indexes intentionally erase overload shape.  A
        // selected declaration is therefore not allowed to degrade to a
        // cached sibling merely because both methods share the same owner and
        // name.  Validate the emitted target against the actual call before
        // returning it, then retain the compatible semantic declaration when
        // the cache supplied an incompatible overload.
        if (call_expr_id != hir_id_invalid()) {
            let callee_expr_id = self.unit.expr_lhs(call_expr_id);
            let out_score = self.hir_function_arg_score_for_call(call_expr_id,
                                                                  callee_expr_id,
                                                                  out_fn);
            if (out_score < 0) {
                let selected_fn = hir_pointer_map_function(self.decl_map,
                                                            selected_decl);
                if (selected_fn != hir_id_invalid()
                    && !self.function_has_open_template_types(selected_fn)
                    && self.function_candidate_matches_method_name(selected_fn,
                                                                     method_name)
                    && self.hir_function_arg_score_for_call(call_expr_id,
                                                             callee_expr_id,
                                                             selected_fn) >= 0) {
                    self.ensure_reachable_function_body_by_id(selected_fn);
                    return selected_fn;
                }
                return hir_id_invalid();
            }
        }
        self.ensure_reachable_function_body_by_id(out_fn);
        return out_fn;
    }

    fn raw_member_decl_on_class_tree(self,
                                            class_decl: rawptr,
                                            member_name: string,
                                            depth: i32) -> rawptr {
        if (class_decl == null || member_name.len == 0 || depth > 32) { return null; }
        var member = decl_get_members(class_decl);
        while (member != null) {
            if (decl_get_name(member) == member_name) { return member; }
            member = decl_get_next(member);
        }
        // Exact current names win.  Only after that, resolve an old spelling
        // to the current migrated field declaration so HIR receives the
        // canonical field type/index rather than the historical declaration.
        member = decl_get_members(class_decl);
        while (member != null) {
            if (decl_get_kind(member) == de_FIELD()
                && hir_builder_field_migrate_from_field(member) == member_name) {
                return member;
            }
            member = decl_get_next(member);
        }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(class_decl, parent_i);
            if (parent_decl == null) { return null; }
            let found = self.raw_member_decl_on_class_tree(parent_decl, member_name, depth + 1);
            if (found != null) { return found; }
            parent_i = parent_i + 1;
        }
        return null;
    }

    fn raw_member_decl_for_type_text(self, type_text: string, member_name: string) -> rawptr {
        if (type_text.len == 0 || member_name.len == 0) { return null; }
        let cached = hir_pair_raw_map_get(self.member_decl_cache,type_text, member_name);
        if (cached != null) { return cached; }
        if (hir_pair_id_map_get(self.member_decl_miss_cache,type_text, member_name) != hir_id_invalid()) { return null; }
        let cd = self.raw_class_decl_for_type_text(type_text);
        if (cd == null) {
            return null;
        }
        let out = self.raw_member_decl_on_class_tree(cd, member_name, 0);
        if (out != null) {
            self.member_decl_cache = hir_pair_raw_map_put(self.member_decl_cache,type_text, member_name, out);
        } else {
            self.member_decl_miss_cache = hir_pair_id_map_put(self.member_decl_miss_cache,type_text, member_name, 1);
        }
        return out;
    }

    fn call_type_match_score(self, param_type: string, actual_type: string) -> i32 {
        if (param_type.len == 0 || actual_type.len == 0) { return -1; }
        if (param_type == actual_type || policy_type_name_equal(param_type, actual_type)) { return 8; }
        let param_dyn_trait = self.dyn_interface_name_from_type_text(param_type);
        if (param_dyn_trait.len > 0
            && self.type_text_satisfies_dyn_trait(actual_type, param_dyn_trait)) {
            return 5;
        }
        let param_base = hir_builder_type_base_name(param_type);
        let actual_base = hir_builder_type_base_name(actual_type);
        if (param_base.len > 0
            && actual_base.len > 0
            && param_base == actual_base
            && policy_generic_call_args(param_type.clone()) == policy_generic_call_args(actual_type.clone())) {
            return 6;
        }
        if ((param_type == "i64" && actual_type == "i32")
            || (param_type == "i32" && actual_type == "i64")
            || (param_type == "u64" && actual_type == "u32")
            || (param_type == "u32" && actual_type == "u64")) {
            return 2;
        }
        if (hir_builder_is_primitive_str_name(param_type)
            && hir_builder_is_primitive_str_name(actual_type)) {
            return 6;
        }
        return -1;
    }

    fn method_decl_score_for_call(self,
                                         call_expr: rawptr,
                                         call_expr_id: i32,
                                         method_decl: rawptr,
                                         owner_type_name: string) -> i32 {
        if (call_expr_id == hir_id_invalid()
            || method_decl == null
            || owner_type_name.len == 0
            || decl_get_kind(method_decl) != de_METHOD()) {
            return -1;
        }
        var owner_decl = self.method_owner_decl_for_type_text(method_decl,
                                                              owner_type_name,
                                                              self.raw_class_decl_for_type_text(owner_type_name));
        if (owner_decl == null) { return -1; }
        var owner_params = hir_builder_decl_template_params(owner_decl);
        var method_params = hir_builder_decl_template_params(method_decl);
        let owner_type_args = policy_generic_call_args(owner_type_name.clone());
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let template_owner = self.raw_template_class_decl_for_type_text(owner_type_name);
            if (template_owner != null) {
                let template_params = hir_builder_decl_template_params(template_owner);
                if (template_params.len > 0) { owner_params = template_params; }
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let ret_owner_params = hir_builder_template_params_matching_owner_text(hir_builder_type_ref_name(decl_get_ty(method_decl)),
                                                                                  owner_type_name);
            if (ret_owner_params.len > 0
                && hir_builder_generic_param_count(ret_owner_params) == hir_builder_generic_arg_count(owner_type_args)
                && !hir_builder_generic_contains(ret_owner_params, "Self")) {
                owner_params = ret_owner_params;
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0 && method_params.len > 0) {
            let owner_arg_count = hir_builder_generic_arg_count(owner_type_args);
            let derived_owner_params = hir_builder_generic_params_prefix(method_params, owner_arg_count);
            if (hir_builder_generic_param_count(derived_owner_params) == owner_arg_count
                && !hir_builder_generic_contains(derived_owner_params, "Self")) {
                owner_params = derived_owner_params;
                method_params = hir_builder_generic_params_after(method_params, owner_arg_count);
            }
        }
        if (method_params.len == 0) {
            method_params = hir_builder_inferred_decl_template_params_except(method_decl, owner_params);
        }
        let owner_args = hir_builder_owner_args_for_params(owner_params, owner_type_name);
        var explicit_method_args = self.resolve_explicit_generic_args_for_call(call_expr);
        if (explicit_method_args.len == 0) {
            explicit_method_args = self.resolve_explicit_generic_args_for_hir_call(call_expr_id);
        }
        let bindings = self.infer_hir_call_bindings(call_expr_id,
                                                    method_decl,
                                                    owner_params,
                                                    owner_args,
                                                    method_params,
                                                    explicit_method_args);
        let method_args = self.args_for_hir_call_params(call_expr_id,
                                                        method_decl,
                                                        method_params,
                                                        explicit_method_args,
                                                        bindings);
        bindings.dispose();
        var env_params = owner_params;
        var env_args = owner_args;
        env_params = hir_builder_append_csv(env_params, method_params);
        env_args = hir_builder_append_csv(env_args, method_args);
        var param = decl_get_params(method_decl);
        if (param != null && decl_get_name(param) == "self") {
            param = decl_get_next(param);
        }
        var arg_id = self.hir_method_call_first_arg(call_expr_id);
        var score: i32 = 0;
        while (param != null) {
            if (hir_builder_variadic_param(param)) { return score; }
            if (arg_id == hir_id_invalid()) { return -1; }
            let param_type_id = self.type_id_from_ref_env(decl_get_ty(param), env_params, env_args);
            let actual_type_id = self.unit.expr_type(arg_id);
            if (!self.type_id_is_valid(param_type_id) || !self.type_id_is_valid(actual_type_id)) { return -1; }
            let param_text = hir_type_table_text(self.unit.types, param_type_id);
            let actual_text = hir_type_table_text(self.unit.types, actual_type_id);
            let part = self.call_type_match_score(param_text, actual_text);
            if (part < 0) { return -1; }
            score = score + part;
            param = decl_get_next(param);
            arg_id = self.hir_method_call_next_arg(call_expr_id, arg_id);
        }
        if (arg_id != hir_id_invalid()) { return -1; }
        return score;
    }

    fn call_type_id_match_score(self, param_type_id: i32, actual_type_id: i32) -> i32 {
        if (!self.type_id_is_valid(param_type_id) || !self.type_id_is_valid(actual_type_id)) {
            return -1;
        }
        let param_text = hir_type_table_text(self.unit.types, param_type_id);
        let actual_text = hir_type_table_text(self.unit.types, actual_type_id);
        return self.call_type_match_score(param_text, actual_text);
    }

    fn hir_function_arg_score_for_call(self,
                                             call_expr_id: i32,
                                             callee_expr_id: i32,
                                             function_id: i32) -> i32 {
        if (call_expr_id == hir_id_invalid()
            || callee_expr_id == hir_id_invalid()
            || function_id == hir_id_invalid()
            || self.unit.expr_kind(call_expr_id) != ex_CALL()) {
            return -1;
        }
        var param_local = self.next_source_param_local(self.unit.function_first_local(function_id));
        if (self.local_is_constructor_abi_self(function_id, param_local)) {
            param_local = self.next_source_param_local(self.unit.local_next(param_local));
        } else if (self.unit.expr_kind(callee_expr_id) == ex_MEMBER()
            && param_local != hir_id_invalid()
            && (self.unit.local_flags(param_local) & hir_local_flag_self_receiver()) != 0) {
            let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
            if (owner_expr_id != hir_id_invalid()
                && self.unit.expr_sem_kind(owner_expr_id) != expr_sem_CLASS()) {
                param_local = self.next_source_param_local(self.unit.local_next(param_local));
            }
        }
        var arg_id = self.unit.expr_first_arg(call_expr_id);
        var score: i32 = 0;
        while (arg_id != hir_id_invalid()) {
            if (param_local == hir_id_invalid()) { return -1; }
            let part = self.call_type_id_match_score(self.unit.local_type(param_local),
                                                     self.unit.expr_type(arg_id));
            if (part < 0) { return -1; }
            score = score + part;
            arg_id = self.unit.expr_next_arg(arg_id);
            param_local = self.next_source_param_local(self.unit.local_next(param_local));
        }
        if (param_local != hir_id_invalid()) { return -1; }
        return score;
    }

    fn ensure_reachable_function_body_by_id(self, function_id: i32) {
        if (function_id == hir_id_invalid()) { return; }
        if (self.unit.function_body(function_id) != hir_id_invalid()) { return; }
        var raw_decl = hir_pointer_map_raw_for_function(self.decl_map,function_id);
        if (raw_decl == null) {
            raw_decl = self.function_instances.decl_for_function(function_id);
        }
        if (raw_decl != null) {
            self.ensure_reachable_function_body(raw_decl, function_id, false);
        }
    }

    // A package interface can be reached through more than one import path.
    // Those AST declarations have distinct addresses, but represent one ABI
    // declaration when their source module, owner, signature, and symbol
    // discriminator agree. Keep real source overloads and versioned imports
    // distinct; only collapse duplicate imported interface shells here.
    fn imported_method_candidates_share_abi(self,
                                            left_fn: i32,
                                            right_fn: i32,
                                            owner_type_name: string) -> bool {
        if (left_fn == hir_id_invalid()
            || right_fn == hir_id_invalid()
            || owner_type_name.len == 0) {
            return false;
        }
        let left_decl = hir_pointer_map_raw_for_function(self.decl_map, left_fn);
        let right_decl = hir_pointer_map_raw_for_function(self.decl_map, right_fn);
        if (left_decl == null
            || right_decl == null
            || !self.decl_effectively_imported(left_decl)
            || !self.decl_effectively_imported(right_decl)
            || decl_get_is_static(left_decl) != decl_get_is_static(right_decl)
            || !hir_builder_decl_signature_matches(left_decl, right_decl)) {
            return false;
        }
        let left_owner = hir_raw_owner_map_get(self.decl_owner_map, left_decl);
        let right_owner = hir_raw_owner_map_get(self.decl_owner_map, right_decl);
        if (left_owner == null
            || right_owner == null
            || !self.raw_owner_decl_matches_type_exact(left_owner, owner_type_name)
            || !self.raw_owner_decl_matches_type_exact(right_owner, owner_type_name)) {
            return false;
        }
        let left_module = hir_builder_decl_source_module(left_decl);
        let right_module = hir_builder_decl_source_module(right_decl);
        // Shallow project interfaces do not carry a `from:` marker.  Two
        // empty source markers therefore still identify the same ABI once
        // owner, signature, and discriminator have matched above. Distinct
        // non-empty module/version markers remain distinct candidates.
        if (left_module != right_module) { return false; }
        return hir_builder_decl_symbol_discriminator(left_decl, left_owner)
            == hir_builder_decl_symbol_discriminator(right_decl, right_owner);
    }

    fn best_hir_method_function_for_call_with_static_mode(self,
                                                          owner_type_name: string,
                                                          method_name: string,
                                                          call_expr_id: i32,
                                                          callee_expr_id: i32,
                                                          filter_static: bool,
                                                          want_static: bool) -> i32 {
        if (owner_type_name.len == 0
            || method_name.len == 0
            || call_expr_id == hir_id_invalid()
            || callee_expr_id == hir_id_invalid()) {
            return hir_id_invalid();
        }
        let cached = self.closed_method_instance_for_owner_method(owner_type_name, method_name);
        if (cached != hir_id_invalid()) {
            self.ensure_reachable_function_body_by_id(cached);
            // Owner/name caches intentionally erase overload and parameter-pack
            // shape. Reuse the cached instance only when it matches this exact
            // call; otherwise continue scoring the closed sibling instances.
            if (self.hir_function_arg_score_for_call(call_expr_id,
                                                     callee_expr_id,
                                                     cached) >= 0) {
                return cached;
            }
        }
        if (policy_generic_call_args(owner_type_name.clone()).len > 0) {
            return hir_id_invalid();
        }
        var best_fn = hir_id_invalid();
        var best_score: i32 = -1;
        var tied: bool = false;
        var item_id: i32 = 1;
        while (item_id <= self.unit.item_count) {
            if (self.unit.item_kind(item_id) == hir_item_method()
                && self.owner_item_matches_type(self.unit.item_owner(item_id), owner_type_name)
                && self.function_name_matches_method(self.unit.item_name(item_id), method_name)) {
                let fn_id = self.unit.item_function(item_id);
                let static_mode_matches = !filter_static
                    || self.hir_function_matches_static_use(fn_id, want_static);
                if (fn_id != hir_id_invalid()
                    && static_mode_matches
                    && self.function_candidate_has_exact_owner_type(fn_id, owner_type_name)
                    && self.function_candidate_covers_owner_type(fn_id, owner_type_name)
                    && !self.function_has_open_template_types(fn_id)) {
                    let score = self.hir_function_arg_score_for_call(call_expr_id,
                                                                     callee_expr_id,
                                                                     fn_id);
                    if (score > best_score) {
                        best_score = score;
                        best_fn = fn_id;
                        tied = false;
                    } else if (score == best_score && score >= 0) {
                        let candidate_decl =
                            hir_pointer_map_raw_for_function(self.decl_map,
                                                             fn_id);
                        let best_decl =
                            hir_pointer_map_raw_for_function(self.decl_map,
                                                             best_fn);
                        if (self.imported_method_candidates_share_abi(fn_id,
                                                                     best_fn,
                                                                     owner_type_name)) {
                            item_id = item_id + 1;
                            continue;
                        }
                        let candidate_module =
                            hir_builder_decl_source_module(candidate_decl);
                        let best_module =
                            hir_builder_decl_source_module(best_decl);
                        if (policy_module_base(candidate_module)
                                == policy_module_base(best_module)
                            && policy_module_variant(candidate_module)
                                == policy_module_variant(best_module)
                            && policy_module_version(candidate_module).len > 0
                            && policy_module_version(best_module).len > 0) {
                            let version_cmp = policy_semver_compare(
                                policy_module_version(candidate_module),
                                policy_module_version(best_module));
                            if (version_cmp > 0) {
                                best_fn = fn_id;
                                tied = false;
                            } else if (version_cmp == 0
                                && candidate_decl != best_decl) {
                                tied = true;
                            }
                        } else {
                            tied = true;
                        }
                    }
                }
            }
            item_id = item_id + 1;
        }
        if (best_score < 0 || tied) { return hir_id_invalid(); }
        self.ensure_reachable_function_body_by_id(best_fn);
        return best_fn;
    }

    fn best_hir_method_function_for_call(self,
                                               owner_type_name: string,
                                               method_name: string,
                                               call_expr_id: i32,
                                               callee_expr_id: i32) -> i32 {
        return self.best_hir_method_function_for_call_with_static_mode(owner_type_name,
                                                                        method_name,
                                                                        call_expr_id,
                                                                        callee_expr_id,
                                                                        false,
                                                                        false);
    }

    fn best_hir_static_method_function_for_call(self,
                                                      owner_type_name: string,
                                                      method_name: string,
                                                      call_expr_id: i32,
                                                      callee_expr_id: i32) -> i32 {
        return self.best_hir_method_function_for_call_with_static_mode(owner_type_name,
                                                                        method_name,
                                                                        call_expr_id,
                                                                        callee_expr_id,
                                                                        true,
                                                                        true);
    }

    fn hir_function_matches_static_use(self, fn_id: i32, want_static: bool) -> bool {
        if (fn_id == hir_id_invalid()) { return false; }
        let raw_decl = hir_pointer_map_raw_for_function(self.decl_map, fn_id);
        if (raw_decl != null && decl_get_kind(raw_decl) == de_METHOD()) {
            return hir_builder_method_decl_matches_static_use(raw_decl, want_static);
        }
        var local_id = self.unit.function_first_local(fn_id);
        while (local_id != hir_id_invalid()) {
            if ((self.unit.local_flags(local_id) & hir_local_flag_param()) != 0
                && self.unit.local_name(local_id) == "self") {
                return !want_static;
            }
            local_id = self.unit.local_next(local_id);
        }
        return want_static;
    }

    // Sema can preserve a value-initialization `new` builtin when class layout
    // preparation makes the raw inherited member chain incomplete.  A direct
    // owner with one registered static candidate is nevertheless unambiguous;
    // recover that stable HIR identity and let its normal body scheduling path
    // materialize the declaration.
    fn unique_registered_direct_static_method_function(self,
                                                             owner_type_name: string,
                                                             method_name: string) -> i32 {
        if (owner_type_name.len == 0 || method_name.len == 0) {
            return hir_id_invalid();
        }
        var candidate = hir_id_invalid();
        var item_id: i32 = 1;
        while (item_id <= self.unit.item_count) {
            if (self.unit.item_kind(item_id) == hir_item_method()
                && self.function_name_matches_method(self.unit.item_name(item_id), method_name)
                && self.owner_item_matches_type_exact(self.unit.item_owner(item_id), owner_type_name)) {
                let fn_id = self.unit.item_function(item_id);
                if (fn_id != hir_id_invalid()
                    && self.hir_function_matches_static_use(fn_id, true)
                    && self.function_candidate_has_exact_owner_type(fn_id, owner_type_name)
                    && self.function_candidate_covers_owner_type(fn_id, owner_type_name)
                    && !self.function_has_open_template_types(fn_id)) {
                    if (candidate != hir_id_invalid() && candidate != fn_id) {
                        return hir_id_invalid();
                    }
                    candidate = fn_id;
                }
            }
            item_id = item_id + 1;
        }
        if (candidate != hir_id_invalid()) {
            self.ensure_reachable_function_body_by_id(candidate);
        }
        return candidate;
    }

    fn raw_best_method_decl_in_class_for_call(self,
                                                     class_decl: rawptr,
                                                     method_name: string,
                                                     want_static: bool,
                                                     call_expr: rawptr,
                                                     call_expr_id: i32,
                                                     owner_type_name: string) -> rawptr {
        if (class_decl == null || method_name.len == 0) { return null; }
        var best: rawptr = null;
        var best_score: i32 = -1;
        var member = decl_get_members(class_decl);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && hir_builder_method_name_matches_lookup(decl_get_name(member), method_name)
                && hir_builder_method_decl_matches_static_use(member, want_static)) {
                let score = self.method_decl_score_for_call(call_expr,
                                                            call_expr_id,
                                                            member,
                                                            owner_type_name);
                if (score > best_score) {
                    best_score = score;
                    best = member;
                }
            }
            member = decl_get_next(member);
        }
        return best;
    }

    fn raw_method_decl_for_call_on_class_tree(self,
                                                    class_decl: rawptr,
                                                    method_name: string,
                                                    want_static: bool,
                                                    call_expr: rawptr,
                                                    call_expr_id: i32,
                                                    owner_type_name: string,
                                                    depth: i32) -> rawptr {
        if (class_decl == null || method_name.len == 0 || depth > 32) { return null; }
        let direct = self.raw_best_method_decl_in_class_for_call(class_decl,
                                                                 method_name,
                                                                 want_static,
                                                                 call_expr,
                                                                 call_expr_id,
                                                                 owner_type_name);
        if (direct != null) { return direct; }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(class_decl, parent_i);
            if (parent_decl == null) { return null; }
            let found = self.raw_method_decl_for_call_on_class_tree(parent_decl,
                                                                      method_name,
                                                                      want_static,
                                                                      call_expr,
                                                                      call_expr_id,
                                                                      owner_type_name,
                                                                      depth + 1);
            if (found != null) { return found; }
            parent_i = parent_i + 1;
        }
        return null;
    }

    fn raw_method_decl_for_call_by_owner_item_scan(self,
                                                          owner_type_name: string,
                                                          method_name: string,
                                                          want_static: bool,
                                                          call_expr: rawptr,
                                                          call_expr_id: i32) -> rawptr {
        if (owner_type_name.len == 0 || method_name.len == 0 || call_expr_id == hir_id_invalid()) {
            return null;
        }
        var best: rawptr = null;
        var best_score: i32 = -1;
        var tied: bool = false;
        var item_id: i32 = 1;
        while (item_id <= self.unit.item_count) {
            if (self.unit.item_kind(item_id) == hir_item_method()
                && self.unit.item_name(item_id) == method_name
                && self.owner_item_matches_type(self.unit.item_owner(item_id), owner_type_name)) {
                let raw = hir_pointer_map_raw_for_item(self.decl_map,item_id);
                if (raw != null
                    && decl_get_kind(raw) == de_METHOD()
                    && hir_builder_method_decl_matches_static_use(raw, want_static)) {
                    let score = self.method_decl_score_for_call(call_expr,
                                                                call_expr_id,
                                                                raw,
                                                                owner_type_name);
                    if (score > best_score) {
                        best_score = score;
                        best = raw;
                        tied = false;
                    } else if (score == best_score && score >= 0) {
                        tied = true;
                    }
                }
            }
            item_id = item_id + 1;
        }
        if (best_score < 0 || tied) { return null; }
        return best;
    }

    fn raw_method_decl_scan_cache_key(self,
                                             method_name: string,
                                             want_static: bool,
                                             call_expr_id: i32) -> string {
        return self.method_call_target_cache_key(method_name,
                                                 want_static,
                                                 "",
                                                 call_expr_id);
    }

    fn raw_method_decl_for_call_by_owner_item_scan_cached(self,
                                                                 owner_type_name: string,
                                                                 method_name: string,
                                                                 want_static: bool,
                                                                 call_expr: rawptr,
                                                                 call_expr_id: i32) -> rawptr {
        let cache_key = self.raw_method_decl_scan_cache_key(method_name,
                                                            want_static,
                                                            call_expr_id);
        if (cache_key.len > 0) {
            let cached = hir_pair_raw_map_get(self.raw_method_call_decl_cache,owner_type_name, cache_key);
            if (cached != null) { return cached; }
            if (hir_pair_id_map_get(self.raw_method_call_decl_miss_cache,owner_type_name, cache_key) != hir_id_invalid()) {
                return null;
            }
        }
        let out = self.raw_method_decl_for_call_by_owner_item_scan(owner_type_name,
                                                                   method_name,
                                                                   want_static,
                                                                   call_expr,
                                                                   call_expr_id);
        if (cache_key.len > 0) {
            if (out != null) {
                self.raw_method_call_decl_cache = hir_pair_raw_map_put(self.raw_method_call_decl_cache,owner_type_name, cache_key, out);
            } else {
                self.raw_method_call_decl_miss_cache = hir_pair_id_map_put(self.raw_method_call_decl_miss_cache,owner_type_name, cache_key, 1);
            }
        }
        return out;
    }

    fn raw_method_decl_for_call_expr(self, call_expr: rawptr, call_expr_id: i32, callee_expr_id: i32) -> rawptr {
        var hot_start: i64 = 0;
        let hot_timing = hir_builder_env_enabled("VYX_HIR_HOT_TIMING");
        if (hot_timing) { hot_start = vyx_bootstrap_now_ms(); }
        if (call_expr_id == hir_id_invalid()
            || callee_expr_id == hir_id_invalid()
            || self.unit.expr_kind(callee_expr_id) != ex_MEMBER()) {
            return null;
        }
        let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
        if (owner_expr_id == hir_id_invalid()) { return null; }
        var raw_callee = call_expr;
        if (call_expr != null && expr_get_kind(call_expr) == ex_CALL()) {
            raw_callee = expr_get_lhs(call_expr);
        }
        let owner_type_name = self.member_owner_type_name(raw_callee, owner_expr_id);
        if (owner_type_name.len == 0 || self.type_text_has_open_template_atom(owner_type_name)) { return null; }
        let member_name = policy_versioned_generic_call_base(self.unit.expr_name(callee_expr_id).clone());
        if (member_name.len == 0) { return null; }
        var want_static: bool = false;
        if (self.unit.expr_sem_kind(owner_expr_id) == expr_sem_CLASS()) { want_static = true; }
        let dyn_iface_name = self.dyn_interface_name_from_type_text(owner_type_name);
        if (!want_static && dyn_iface_name.len > 0) {
            let iface_member = self.raw_interface_method_decl_on_trait(self.raw_interface_decl_for_trait_name(dyn_iface_name),
                                                                       member_name,
                                                                       0);
            if (iface_member != null) {
                if (hot_timing) { self.profile_ms_raw_method_call = self.profile_ms_raw_method_call + (vyx_bootstrap_now_ms() - hot_start); }
                return iface_member;
            }
        }
        if (raw_callee != null && expr_get_kind(raw_callee) == ex_MEMBER()) {
            let semantic_method = self.semantic_method_decl_for_member_ast(raw_callee,
                                                                           owner_type_name,
                                                                           member_name,
                                                                           want_static);
            if (semantic_method != null) {
                if (hot_timing) { self.profile_ms_raw_method_call = self.profile_ms_raw_method_call + (vyx_bootstrap_now_ms() - hot_start); }
                return semantic_method;
            }
            let versioned_method = self.raw_versioned_method_decl_for_call(
                owner_type_name,
                member_name,
                expr_get_name(raw_callee),
                want_static,
                call_expr,
                call_expr_id);
            if (versioned_method != null) {
                if (hot_timing) {
                    self.profile_ms_raw_method_call =
                        self.profile_ms_raw_method_call
                        + (vyx_bootstrap_now_ms() - hot_start);
                }
                return versioned_method;
            }
        }
        let class_decl = self.raw_class_decl_for_type_text(owner_type_name);
        let method_decl = self.raw_method_decl_for_call_on_class_tree(class_decl,
                                                                      member_name,
                                                                      want_static,
                                                                      call_expr,
                                                                      call_expr_id,
                                                                      owner_type_name,
                                                                      0);
        if (method_decl != null) {
            if (hot_timing) { self.profile_ms_raw_method_call = self.profile_ms_raw_method_call + (vyx_bootstrap_now_ms() - hot_start); }
            return method_decl;
        }
        let item_scanned_method = self.raw_method_decl_for_call_by_owner_item_scan_cached(owner_type_name,
                                                                                          member_name,
                                                                                          want_static,
                                                                                          call_expr,
                                                                                          call_expr_id);
        if (item_scanned_method != null) {
            if (hot_timing) { self.profile_ms_raw_method_call = self.profile_ms_raw_method_call + (vyx_bootstrap_now_ms() - hot_start); }
            return item_scanned_method;
        }
        let template_method_decl = self.raw_template_method_decl_for_call_type_text(owner_type_name,
                                                                                   member_name,
                                                                                   want_static,
                                                                                   call_expr,
                                                                                   call_expr_id);
        if (template_method_decl != null) {
            if (hot_timing) { self.profile_ms_raw_method_call = self.profile_ms_raw_method_call + (vyx_bootstrap_now_ms() - hot_start); }
            return template_method_decl;
        }
        let impl_method_decl = self.concrete_impl_method_decl(member_name, owner_type_name);
        if (impl_method_decl != null
            && hir_builder_method_decl_matches_static_use(impl_method_decl, want_static)) {
            if (hot_timing) { self.profile_ms_raw_method_call = self.profile_ms_raw_method_call + (vyx_bootstrap_now_ms() - hot_start); }
            return impl_method_decl;
        }
        if (!want_static) {
            let iface_default = self.raw_interface_default_method_decl_for_type_text(owner_type_name, member_name);
            if (hot_timing) { self.profile_ms_raw_method_call = self.profile_ms_raw_method_call + (vyx_bootstrap_now_ms() - hot_start); }
            return iface_default;
        }
        if (hot_timing) { self.profile_ms_raw_method_call = self.profile_ms_raw_method_call + (vyx_bootstrap_now_ms() - hot_start); }
        return null;
    }

    fn type_text_has_instance_drop(self, type_text: string) -> bool {
        return self.raw_drop_decl_for_type_text(type_text) != null;
    }

    fn type_text_has_instance_dup(self, type_text: string) -> bool {
        let cd = self.raw_class_decl_for_type_text(type_text);
        if (cd == null) { return false; }
        var member = decl_get_members(cd);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && decl_get_name(member) == "dup"
                && !decl_get_is_static(member)) {
                return true;
            }
            if (decl_get_kind(member) == de_METHOD()
                && decl_get_name(member) == "destroy"
                && !decl_get_is_static(member)) {
                return true;
            }
            member = decl_get_next(member);
        }
        return false;
    }

    fn type_text_requires_dci_stub_drop(self, type_text: string) -> bool {
        if (type_text.len == 0) { return false; }
        let cd = self.raw_class_decl_for_type_text(type_text);
        if (cd == null) { return false; }
        return self.class_decl_requires_dci_stub(cd, 0);
    }

    fn type_text_is_ref_lang_item(self, type_text: string) -> bool {
        let cd = self.raw_class_decl_for_type_text(type_text);
        if (cd == null) { return false; }
        if (hir_builder_decl_has_attr(cd, "lang_item(\"ref\")")) { return true; }
        return hir_builder_type_base_name(type_text) == "Ref";
    }

    fn type_text_is_string_like(self, type_text: string) -> bool {
        let base = hir_builder_type_base_name(type_text);
        return hir_builder_is_primitive_str_name(base);
    }

    // `str` owns its buffer when its ABI ownership tag says so.  Unlike class
    // values, its destructor is the language-level free function `str_drop`.
    // Keep this lookup exact: unrelated same-named methods/functions are not
    // a primitive-string lifecycle contract.
    fn primitive_str_drop_function(self) -> i32 {
        var fn_id: i32 = 1;
        while (fn_id <= self.unit.function_count) {
            if (self.unit.function_record(fn_id) != null
                && self.unit.function_name(fn_id) == "str_drop"
                && self.unit.function_owner_type(fn_id).len == 0
                && hir_type_table_kind(self.unit.types, self.unit.function_return_type(fn_id)) == ty_VOID()) {
                let param = self.unit.function_first_local(fn_id);
                if (param != hir_id_invalid()
                    && hir_type_table_kind(self.unit.types, self.unit.local_type(param)) == ty_STRING()
                    && self.unit.local_next(param) == hir_id_invalid()) {
                    // This lookup runs while lazy generic bodies are being
                    // materialized. It establishes only the lifecycle
                    // contract; recursively materializing str_drop here can
                    // mutate the same HIR tables and invalidates the active
                    // builder state. The normal call/drop reachability path
                    // schedules its body after this local is recorded.
                    return fn_id;
                }
            }
            fn_id = fn_id + 1;
        }
        return hir_id_invalid();
    }

    fn callable_consumes_primitive_str(self, callable: rawptr, param: rawptr, type_id: i32) -> bool {
        if (callable == null || param == null || type_id == hir_id_invalid()) { return false; }
        if (decl_get_name(callable) != "str_drop") { return false; }
        if (decl_get_params(callable) != param || decl_get_next(param) != null) { return false; }
        return hir_type_table_kind(self.unit.types, type_id) == ty_STRING();
    }

    // A local can carry a lexical `str_drop` only when its initializer is a
    // distinct result or a tag-safe literal/interpolation value. Parameters,
    // fields, indexing and arbitrary calls may be aliases of an owner outside
    // this scope, so they are not positive evidence for automatic destruction.
    fn primitive_str_init_is_fresh_owned_value(self, init_e: rawptr) -> bool {
        if (init_e == null) { return false; }
        let kind = expr_get_kind(init_e);
        // The primitive ABI carries an explicit allocator-domain tag. Calling
        // str_drop on a literal/view is therefore a no-op, while an
        // interpolated string releases its runtime buffer. Both are safe
        // lexical values; the aliasing gate below remains responsible for
        // rejecting copies of an existing owning local.
        if (kind == ex_STR_LIT() || kind == ex_FSTRING()) { return true; }
        if (kind == ex_BIN() && expr_get_op(init_e) == tk_PLUS()) { return true; }
        if (kind != ex_CALL()) { return false; }
        let callee = expr_get_lhs(init_e);
        if (callee == null) { return false; }
        if (expr_get_kind(callee) == ex_MEMBER()) {
            let name = policy_generic_call_base(expr_get_name(callee));
            return name == "toUpper" || name == "toLower"
                || name == "to_upper" || name == "to_lower"
                || name == "trim" || name == "replace"
                || name == "substring" || name == "repeat"
                || name == "clone";
        }
        if (expr_get_kind(callee) != ex_IDENT()) { return false; }
        let name = policy_generic_call_base(expr_get_name(callee));
        return name == "int_to_string" || name == "bool_to_string"
            || name == "float_to_string" || name == "str_concat"
            || name == "str_dup" || name == "from_cstr_len"
            || name == "readFile";
    }

    // Primitive str values have an explicit ownership tag.  A fresh
    // initializer alone is not enough to schedule str_drop: later code may
    // return a borrowed alias, pass the value to an unknown callee, take its
    // address, aggregate it, or capture it.  Those paths cannot prove that a
    // lexical drop remains valid, so they conservatively reject auto-drop.
    //
    // This is intentionally an AST-side gate while HIR is being materialized.
    // Sema symbols can be rebuilt for a lazy generic body, so the same source
    // binding need not retain pointer identity here. Matching the name makes
    // the proof more conservative under shadowing, never less conservative.
    fn primitive_str_expr_mentions_target(self, e: rawptr, target: string) -> bool {
        if (e == null || target.len == 0) { return false; }
        if (expr_get_kind(e) == ex_IDENT() && expr_get_name(e) == target) {
            return true;
        }
        let k = expr_get_kind(e);
        if (k == ex_BIN() || k == ex_ASSIGN() || k == ex_INDEX()) {
            return self.primitive_str_expr_mentions_target(expr_get_lhs(e), target)
                || self.primitive_str_expr_mentions_target(expr_get_rhs(e), target);
        }
        if (k == ex_UNARY() || k == ex_ADDR_OF() || k == ex_DEREF()
            || k == ex_COMPTIME() || k == ex_FAIL() || k == ex_AWAIT() || k == ex_CAST()
            || k == ex_MEMBER()) {
            return self.primitive_str_expr_mentions_target(expr_get_lhs(e), target);
        }
        if (k == ex_CALL()) {
            return self.primitive_str_expr_mentions_target(expr_get_lhs(e), target)
                || self.primitive_str_stmt_chain_mentions_target(expr_get_args(e), target);
        }
        if (k == ex_STRUCT_INIT() || k == ex_FSTRING() || k == ex_TUPLE_LIT()
            || k == ex_INLINE_ASM()) {
            return self.primitive_str_stmt_chain_mentions_target(expr_get_args(e), target);
        }
        if (k == ex_ARRAY_LIT()) {
            return self.primitive_str_stmt_chain_mentions_target(expr_get_args(e), target)
                || self.primitive_str_expr_mentions_target(expr_get_captures(e), target);
        }
        if (k == ex_TERNARY()) {
            return self.primitive_str_expr_mentions_target(expr_get_lhs(e), target)
                || self.primitive_str_expr_mentions_target(expr_get_rhs(e), target)
                || self.primitive_str_expr_mentions_target(expr_get_args(e), target);
        }
        if (k == ex_CLOSURE()) {
            return self.primitive_str_stmt_chain_mentions_target(expr_get_lhs(e), target)
                || self.primitive_str_stmt_chain_mentions_target(expr_get_captures(e), target);
        }
        if (k == ex_IF_EXPR() || k == ex_MATCH_EXPR()) {
            if (self.primitive_str_expr_mentions_target(expr_get_lhs(e), target)) { return true; }
            if (k == ex_IF_EXPR()) {
                return self.primitive_str_stmt_mentions_target(expr_get_rhs(e), target)
                    || self.primitive_str_stmt_chain_mentions_target(expr_get_args(e), target);
            }
            var match_arm = expr_get_args(e);
            while (match_arm != null) {
                if (self.primitive_str_expr_mentions_target(stmt_get_init(match_arm), target)
                    || self.primitive_str_expr_mentions_target(stmt_get_cond(match_arm), target)
                    || self.primitive_str_stmt_chain_mentions_target(stmt_get_body(match_arm), target)) {
                    return true;
                }
                match_arm = stmt_get_next(match_arm);
            }
            return false;
        }
        return false;
    }

    fn primitive_str_stmt_mentions_target(self, s: rawptr, target: string) -> bool {
        if (s == null || target.len == 0) { return false; }
        let k = stmt_get_kind(s);
        if (k == st_EXPR() || k == st_LET() || k == st_VAR() || k == st_RETURN()) {
            return self.primitive_str_expr_mentions_target(stmt_get_init(s), target);
        }
        if (k == st_BLOCK()) {
            return self.primitive_str_stmt_chain_mentions_target(stmt_get_body(s), target);
        }
        if (k == st_IF()) {
            return self.primitive_str_expr_mentions_target(stmt_get_cond(s), target)
                || self.primitive_str_stmt_mentions_target(stmt_get_then_blk(s), target)
                || self.primitive_str_stmt_mentions_target(stmt_get_else_blk(s), target);
        }
        if (k == st_WHILE() || k == st_FOREACH()) {
            return self.primitive_str_expr_mentions_target(stmt_get_cond(s), target)
                || self.primitive_str_stmt_mentions_target(stmt_get_body(s), target);
        }
        if (k == st_FOR()) {
            return self.primitive_str_stmt_mentions_target(stmt_get_init(s), target)
                || self.primitive_str_expr_mentions_target(stmt_get_cond(s), target)
                || self.primitive_str_stmt_mentions_target(stmt_get_body(s), target)
                || self.primitive_str_stmt_mentions_target(stmt_get_then_blk(s), target);
        }
        if (k == st_MATCH()) {
            return self.primitive_str_expr_mentions_target(stmt_get_init(s), target)
                || self.primitive_str_stmt_chain_mentions_target(stmt_get_body(s), target);
        }
        if (k == st_DEFER()) {
            return self.primitive_str_stmt_mentions_target(stmt_get_init(s), target);
        }
        if (k == st_STATIC_ASSERT()) {
            return self.primitive_str_expr_mentions_target(stmt_get_cond(s), target);
        }
        return false;
    }

    fn primitive_str_stmt_chain_mentions_target(self, head: rawptr, target: string) -> bool {
        var cur = head;
        while (cur != null) {
            if (self.primitive_str_stmt_mentions_target(cur, target)) { return true; }
            cur = stmt_get_next(cur);
        }
        return false;
    }

    fn primitive_str_member_call_is_non_escaping(self, name: string) -> bool {
        let base = policy_generic_call_base(name);
        return base == "len" || base == "length" || base == "size" || base == "count"
            || base == "charAt" || base == "char_at"
            || base == "startsWith" || base == "starts_with"
            || base == "endsWith" || base == "ends_with"
            || base == "contains" || base == "indexOf" || base == "index_of"
            || base == "toUpper" || base == "toLower"
            || base == "to_upper" || base == "to_lower"
            || base == "trim" || base == "replace" || base == "substring"
            || base == "repeat" || base == "clone";
    }

    fn primitive_str_direct_call_is_non_escaping(self, name: string) -> bool {
        let base = policy_generic_call_base(name);
        return base == "str_concat" || base == "str_equals"
            || base == "str_length" || base == "str_trim" || base == "str_replace"
            || base == "str_to_upper" || base == "str_to_lower"
            || base == "str_index_of" || base == "str_starts_with" || base == "str_ends_with"
            || base == "str_drop";
    }

    fn primitive_str_member_call_returns_independent_scalar(self, name: string) -> bool {
        let base = policy_generic_call_base(name);
        return base == "len" || base == "length" || base == "size" || base == "count"
            || base == "charAt" || base == "char_at"
            || base == "startsWith" || base == "starts_with"
            || base == "endsWith" || base == "ends_with"
            || base == "contains" || base == "indexOf" || base == "index_of";
    }

    fn primitive_str_let_init_is_independent(self, init_e: rawptr, target: string) -> bool {
        if (init_e == null || !self.primitive_str_expr_mentions_target(init_e, target)) {
            return true;
        }
        // Fresh string producers copy the source bytes; the new local owns a
        // distinct tagged result and cannot keep the source allocation alive.
        if (self.primitive_str_init_is_fresh_owned_value(init_e)) {
            return !self.primitive_str_expr_has_unsafe_use(init_e, target);
        }
        if (expr_get_kind(init_e) != ex_CALL()) { return false; }
        let callee = expr_get_lhs(init_e);
        if (callee == null || expr_get_kind(callee) != ex_MEMBER()
            || !self.primitive_str_expr_mentions_target(expr_get_lhs(callee), target)
            || !self.primitive_str_member_call_returns_independent_scalar(expr_get_name(callee))) {
            return false;
        }
        return !self.primitive_str_expr_has_unsafe_use(init_e, target);
    }

    // Primitive str arguments to a language free function are borrowed by the
    // calling ABI. A callee that needs to retain bytes must create an explicit
    // owned copy; raw/foreign entrypoints have no such language contract and
    // remain an escape barrier. This admits normal helper calls in a lexical
    // owner proof without treating a return, aggregate, address or indirect
    // call as non-escaping.
    fn primitive_str_language_free_call_borrows_args(self, e: rawptr) -> bool {
        if (e == null || expr_get_kind(e) != ex_CALL()) { return false; }
        let callee = expr_get_lhs(e);
        if (callee == null || expr_get_kind(callee) != ex_IDENT()) { return false; }
        var target = expr_get_semantic_target(callee);
        if (target == null) { target = expr_get_semantic_target(e); }
        if (target == null || decl_get_kind(target) != de_FN()) { return false; }
        return !hir_builder_decl_is_foreign_dci(target);
    }

    fn primitive_str_expr_has_unsafe_use(self, e: rawptr, target: string) -> bool {
        if (!self.primitive_str_expr_mentions_target(e, target)) { return false; }
        let k = expr_get_kind(e);
        if (k == ex_IDENT()) { return false; }
        if (k == ex_BIN()) {
            return self.primitive_str_expr_has_unsafe_use(expr_get_lhs(e), target)
                || self.primitive_str_expr_has_unsafe_use(expr_get_rhs(e), target);
        }
        if (k == ex_ASSIGN()) {
            // `text = text + suffix` is the one reassignment form whose
            // lowering preserves a single ownership slot: it either grows the
            // existing allocation in place or replaces and releases it before
            // storing the new tagged value. Other assignments can copy an
            // external owner into this local and remain rejected.
            let lhs = expr_get_lhs(e);
            let rhs = expr_get_rhs(e);
            if (lhs != null && rhs != null
                && expr_get_kind(lhs) == ex_IDENT()
                && expr_get_name(lhs) == target
                && expr_get_kind(rhs) == ex_BIN()
                && expr_get_op(rhs) == tk_PLUS()
                && expr_get_lhs(rhs) != null
                && expr_get_kind(expr_get_lhs(rhs)) == ex_IDENT()
                && expr_get_name(expr_get_lhs(rhs)) == target
                && !self.primitive_str_expr_mentions_target(expr_get_rhs(rhs), target)) {
                return false;
            }
            // Assigning a fresh concat/transform result to some other owner
            // only reads this local's bytes. The destination receives an
            // independent tagged allocation; a direct `dest = source` copy is
            // not fresh and therefore still fails this gate.
            if (lhs != null && rhs != null
                && !self.primitive_str_expr_mentions_target(lhs, target)
                && self.primitive_str_init_is_fresh_owned_value(rhs)) {
                return self.primitive_str_expr_has_unsafe_use(rhs, target);
            }
            return true;
        }
        if (k == ex_CALL()) {
            let callee = expr_get_lhs(e);
            if (callee == null) { return true; }
            var allowed = self.primitive_str_language_free_call_borrows_args(e);
            if (expr_get_kind(callee) == ex_MEMBER()) {
                if (self.primitive_str_expr_mentions_target(expr_get_lhs(callee), target)) {
                    allowed = self.primitive_str_member_call_is_non_escaping(expr_get_name(callee));
                }
            } else if (!allowed && expr_get_kind(callee) == ex_IDENT()) {
                allowed = self.primitive_str_direct_call_is_non_escaping(expr_get_name(callee));
            }
            if (!allowed) { return true; }
            return self.primitive_str_expr_has_unsafe_use(expr_get_lhs(callee), target)
                || self.primitive_str_stmt_chain_has_unsafe_use(expr_get_args(e), target);
        }
        if (k == ex_MEMBER()) {
            let name = policy_generic_call_base(expr_get_name(e));
            if (name != "len" && name != "length" && name != "size" && name != "count"
                && name != "cap" && name != "owned") { return true; }
            return self.primitive_str_expr_has_unsafe_use(expr_get_lhs(e), target);
        }
        if (k == ex_FSTRING()) {
            return self.primitive_str_stmt_chain_has_unsafe_use(expr_get_args(e), target);
        }
        // Address/raw-pointer extraction, indexing, casts, aggregates, closure
        // capture and branch-result forwarding all need a later ownership
        // proof. They are barriers for this lexical auto-drop contract.
        return true;
    }

    fn primitive_str_stmt_has_unsafe_use(self, s: rawptr, target: string) -> bool {
        if (s == null) { return false; }
        let k = stmt_get_kind(s);
        if (k == st_EXPR()) {
            return self.primitive_str_expr_has_unsafe_use(stmt_get_init(s), target);
        }
        if (k == st_RETURN()) {
            // MIR return lowering deactivates the source local before it emits
            // the function-exit drops. A direct return therefore transfers this
            // local rather than causing a double release. Composite/unknown
            // return expressions still pass through the normal escape gate.
            return self.primitive_str_expr_has_unsafe_use(stmt_get_init(s), target);
        }
        if (k == st_LET() || k == st_VAR()) {
            // Direct copies such as `let alias = owner` remain an escape.
            // Proven fresh string producers and scalar read-only queries do
            // not retain a view into the source allocation.
            return !self.primitive_str_let_init_is_independent(stmt_get_init(s), target);
        }
        if (k == st_IF()) {
            return self.primitive_str_expr_has_unsafe_use(stmt_get_cond(s), target)
                || self.primitive_str_stmt_has_unsafe_use(stmt_get_then_blk(s), target)
                || self.primitive_str_stmt_has_unsafe_use(stmt_get_else_blk(s), target);
        }
        if (k == st_WHILE() || k == st_FOREACH()) {
            return self.primitive_str_expr_has_unsafe_use(stmt_get_cond(s), target)
                || self.primitive_str_stmt_has_unsafe_use(stmt_get_body(s), target);
        }
        if (k == st_FOR()) {
            return self.primitive_str_stmt_has_unsafe_use(stmt_get_init(s), target)
                || self.primitive_str_expr_has_unsafe_use(stmt_get_cond(s), target)
                || self.primitive_str_stmt_has_unsafe_use(stmt_get_body(s), target)
                || self.primitive_str_stmt_has_unsafe_use(stmt_get_then_blk(s), target);
        }
        if (k == st_BLOCK()) {
            return self.primitive_str_stmt_chain_has_unsafe_use(stmt_get_body(s), target);
        }
        if (k == st_MATCH() || k == st_DEFER()) {
            return self.primitive_str_stmt_mentions_target(s, target);
        }
        return false;
    }

    fn primitive_str_stmt_chain_has_unsafe_use(self, head: rawptr, target: string) -> bool {
        var cur = head;
        while (cur != null) {
            if (self.primitive_str_stmt_has_unsafe_use(cur, target)) { return true; }
            cur = stmt_get_next(cur);
        }
        return false;
    }

    fn primitive_str_local_has_proven_non_escaping_uses(self, s: rawptr) -> bool {
        if (s == null) { return false; }
        let target = stmt_get_name(s);
        if (target.len == 0) { return false; }
        return !self.primitive_str_stmt_chain_has_unsafe_use(stmt_get_next(s), target);
    }

    fn type_text_should_transfer_by_value(self, type_text: string) -> bool {
        if (type_text.len == 0 || self.type_text_is_string_like(type_text)) { return false; }
        return self.type_text_has_instance_drop(type_text);
    }

    fn method_decl_structurally_borrows_args(self, d: rawptr) -> bool {
        if (d == null || decl_get_kind(d) != de_METHOD()) { return false; }
        if (decl_get_name(d) != "of") { return false; }
        let ret_text = self.type_text_from_ref_env(decl_get_ty(d),
                                                   self.current_generic_params,
                                                   self.current_generic_args);
        let first_param = decl_get_params(d);
        if (first_param == null) { return false; }
        let first_text = self.type_text_from_ref_env(decl_get_ty(first_param),
                                                     self.current_generic_params,
                                                     self.current_generic_args);
        let ret_base = hir_builder_type_base_name(ret_text);
        let first_base = hir_builder_type_base_name(first_text);
        if (ret_base.len == 0 || first_base.len == 0 || first_base == ret_base) { return false; }
        return first_base == "Ref" || first_base == "Scope";
    }

    fn callable_borrows_args(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        let cached = hir_raw_int_map_get(self.callable_borrow_cache,d);
        if (cached == 1) { return false; }
        if (cached == 2) { return true; }
        let out = hir_builder_decl_has_attr(d, "borrow_args")
            || self.method_decl_readonly_contract_borrows_args(d)
            || self.method_decl_structurally_borrows_args(d);
        if (out) {
            self.callable_borrow_cache = hir_raw_int_map_put(self.callable_borrow_cache,d, 2);
        } else {
            self.callable_borrow_cache = hir_raw_int_map_put(self.callable_borrow_cache,d, 1);
        }
        return out;
    }

    fn method_decl_readonly_contract_borrows_args(self, d: rawptr) -> bool {
        if (d == null || decl_get_kind(d) != de_METHOD()) { return false; }
        let name = decl_get_name(d);
        return name == "operator_eq" || name == "operator==" || name == "compare" || name == "hash";
    }

    fn expr_is_to_rawptr_addr_of_ident(self, e: rawptr, name: string) -> bool {
        if (e == null || name.len == 0 || expr_get_kind(e) != ex_CALL()) { return false; }
        let callee = expr_get_lhs(e);
        if (callee == null || expr_get_kind(callee) != ex_IDENT()) { return false; }
        if (policy_generic_call_base_equals(expr_get_name(callee), "to_rawptr") == 0) { return false; }
        let args = expr_get_args(e);
        if (args == null) { return false; }
        let arg = stmt_get_init(args);
        if (arg == null || expr_get_kind(arg) != ex_ADDR_OF()) { return false; }
        let inner = expr_get_lhs(arg);
        if (inner == null || expr_get_kind(inner) != ex_IDENT()) { return false; }
        return expr_get_name(inner) == name;
    }

    fn expr_moves_param_to_raw_storage(self, e: rawptr, name: string) -> bool {
        if (e == null || name.len == 0) { return false; }
        let k = expr_get_kind(e);
        if (k == ex_CLOSURE()) {
            return self.stmt_moves_param_to_raw_storage(expr_get_lhs(e), name);
        }
        if (k == ex_CALL()) {
            let callee = expr_get_lhs(e);
            if (callee != null && expr_get_kind(callee) == ex_IDENT()) {
                let cname = policy_generic_call_base(expr_get_name(callee));
                if (cname == "memcpy" || cname == "memmove") {
                    let src_e = hir_builder_arg_expr_at(expr_get_args(e), 1);
                    if (self.expr_is_to_rawptr_addr_of_ident(src_e, name)) { return true; }
                }
            }
            var arg = expr_get_args(e);
            while (arg != null) {
                if (self.expr_moves_param_to_raw_storage(stmt_get_init(arg), name)) { return true; }
                arg = stmt_get_next(arg);
            }
        }
        if (self.expr_moves_param_to_raw_storage(expr_get_lhs(e), name)) { return true; }
        if (self.expr_moves_param_to_raw_storage(expr_get_rhs(e), name)) { return true; }
        return false;
    }

    fn stmt_moves_param_to_raw_storage(self, s: rawptr, name: string) -> bool {
        if (s == null || name.len == 0) { return false; }
        let k = stmt_get_kind(s);
        if (self.expr_moves_param_to_raw_storage(stmt_get_init(s), name)) { return true; }
        if (self.expr_moves_param_to_raw_storage(stmt_get_cond(s), name)) { return true; }
        if (k == st_BLOCK()) {
            var cur = stmt_get_body(s);
            while (cur != null) {
                if (self.stmt_moves_param_to_raw_storage(cur, name)) { return true; }
                cur = stmt_get_next(cur);
            }
        }
        if (k == st_IF()) {
            if (self.stmt_moves_param_to_raw_storage(stmt_get_then_blk(s), name)) { return true; }
            if (self.stmt_moves_param_to_raw_storage(stmt_get_else_blk(s), name)) { return true; }
        }
        if (k == st_WHILE() || k == st_FOR() || k == st_FOREACH()) {
            if (self.stmt_moves_param_to_raw_storage(stmt_get_body(s), name)) { return true; }
        }
        return false;
    }

    fn param_moves_to_raw_storage(self, callable: rawptr, name: string) -> bool {
        if (callable == null || name.len == 0) { return false; }
        let cached = hir_decl_instance_map_item(self.param_raw_move_cache,callable, name);
        if (cached == 1) { return false; }
        if (cached == 2) { return true; }
        let out = self.stmt_moves_param_to_raw_storage(decl_get_body(callable), name);
        if (out) {
            self.param_raw_move_cache = hir_decl_instance_map_put(self.param_raw_move_cache,callable, name, 2, hir_id_invalid());
        } else {
            self.param_raw_move_cache = hir_decl_instance_map_put(self.param_raw_move_cache,callable, name, 1, hir_id_invalid());
        }
        return out;
    }

    fn ensure_drop_instance_for_type_text(self, type_text: string) -> i32 {
        if (type_text.len == 0 || self.type_text_has_open_template_atom(type_text)) { return hir_id_invalid(); }
        var drop_decl = self.raw_template_method_decl_for_type_text(type_text, "drop", false);
        if (drop_decl == null) { drop_decl = self.raw_drop_decl_for_type_text(type_text); }
        if (drop_decl == null) { return hir_id_invalid(); }
        var owner_decl = self.raw_template_class_decl_for_type_text(type_text);
        if (owner_decl == null) { owner_decl = self.raw_class_decl_for_type_text(type_text); }
        if (owner_decl == null) { return hir_id_invalid(); }
        owner_decl = self.method_owner_decl_for_type_text(drop_decl, type_text, owner_decl);
        drop_decl = self.method_body_decl_for_instance(drop_decl);
        var owner_params = hir_builder_decl_template_params(owner_decl);
        var method_params = hir_builder_decl_template_params(drop_decl);
        let owner_type_args = policy_generic_call_args(type_text.clone());
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let template_owner = self.raw_template_class_decl_for_type_text(type_text);
            if (template_owner != null) {
                let template_params = hir_builder_decl_template_params(template_owner);
                if (template_params.len > 0) { owner_params = template_params; }
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let ret_owner_params = hir_builder_template_params_matching_owner_text(hir_builder_type_ref_name(decl_get_ty(drop_decl)),
                                                                                  type_text);
            if (ret_owner_params.len > 0
                && hir_builder_generic_param_count(ret_owner_params) == hir_builder_generic_arg_count(owner_type_args)
                && !hir_builder_generic_contains(ret_owner_params, "Self")) {
                owner_params = ret_owner_params;
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0 && method_params.len > 0) {
            let owner_arg_count = hir_builder_generic_arg_count(owner_type_args);
            let derived_owner_params = hir_builder_generic_params_prefix(method_params, owner_arg_count);
            if (hir_builder_generic_param_count(derived_owner_params) == owner_arg_count
                && !hir_builder_generic_contains(derived_owner_params, "Self")) {
                owner_params = derived_owner_params;
                method_params = hir_builder_generic_params_after(method_params, owner_arg_count);
            }
        }
        let owner_args = hir_builder_owner_args_for_params(owner_params, type_text);
        var params = owner_params;
        var args = owner_args;
        params = hir_builder_append_csv(params, method_params);
        let method_args = self.args_for_params(method_params, "", HirGenericBindingMap.create());
        args = hir_builder_append_csv(args, method_args);
        if (self.decl_body_has_template_type(drop_decl)) {
            var env_index: i32 = 0;
            while (env_index < 64) {
                let env_param = hir_builder_generic_param_at(self.current_generic_params, env_index);
                if (env_param.len == 0) { break; }
                let env_arg = policy_generic_arg_at(self.current_generic_args, env_index);
                if (env_param != "Self"
                    && env_arg.len > 0
                    && self.decl_contains_template_param(drop_decl, env_param)
                    && !hir_builder_generic_contains(params, env_param)) {
                    params = hir_builder_append_csv(params, env_param);
                    args = hir_builder_append_csv(args, env_arg);
                }
                env_index = env_index + 1;
            }
        }
        let direct_closed_drop = self.direct_closed_method_function_if_no_instance_env(drop_decl,
                                                                                       owner_decl,
                                                                                       type_text,
                                                                                       params,
                                                                                       args);
        if (direct_closed_drop != hir_id_invalid()) { return direct_closed_drop; }
        if (type_text.len > 0 && !hir_builder_generic_contains(params, "Self")) {
            params = hir_builder_append_csv(params, "Self");
            args = hir_builder_append_csv(args, type_text);
        }
        if (params.len == 0 || args.len == 0) {
            let direct_fn = hir_pointer_map_function(self.decl_map,drop_decl);
            if (direct_fn != hir_id_invalid()) {
                self.ensure_reachable_function_body(drop_decl, direct_fn, false);
                return direct_fn;
            }
        }
        return self.ensure_function_instance(drop_decl, owner_decl, type_text, params, args);
    }

    fn ensure_method_instance_for_explicit_member_expr(self,
                                                             type_text: string,
                                                             method_name: string,
                                                             member_expr_id: i32,
                                                             want_static: bool) -> i32 {
        if (type_text.len == 0
            || method_name.len == 0
            || member_expr_id == hir_id_invalid()
            || self.type_text_has_open_template_atom(type_text)) {
            return hir_id_invalid();
        }
        let explicit_method_args = self.resolve_explicit_generic_args_for_hir_member_expr(member_expr_id);
        if (explicit_method_args.len == 0) { return hir_id_invalid(); }
        var method_decl: rawptr = null;
        if (want_static) {
            method_decl = self.raw_static_method_decl_for_type_text(type_text, method_name);
        } else {
            method_decl = self.raw_method_decl_for_type_text(type_text, method_name);
        }
        if (method_decl == null) {
            method_decl = self.raw_template_method_decl_for_type_text(type_text, method_name, want_static);
        }
        if (method_decl == null || decl_get_kind(method_decl) != de_METHOD()) {
            return hir_id_invalid();
        }
        method_decl = self.canonical_method_decl_for_owner_type(method_decl, type_text);
        var owner_decl = self.method_owner_decl_for_type_text(method_decl,
                                                              type_text,
                                                              self.raw_class_decl_for_type_text(type_text));
        if (owner_decl == null) { return hir_id_invalid(); }
        let declaration_method_params = hir_builder_decl_template_params(method_decl);
        method_decl = self.method_body_decl_for_instance(method_decl);
        var owner_params = hir_builder_decl_template_params(owner_decl);
        var method_params = hir_builder_decl_template_params(method_decl);
        if (method_params.len == 0 && declaration_method_params.len > 0) {
            method_params = declaration_method_params;
        }
        let owner_type_args = policy_generic_call_args(type_text.clone());
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let template_owner = self.raw_template_class_decl_for_type_text(type_text);
            if (template_owner != null) {
                let template_params = hir_builder_decl_template_params(template_owner);
                if (template_params.len > 0) { owner_params = template_params; }
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let ret_owner_params = hir_builder_template_params_matching_owner_text(hir_builder_type_ref_name(decl_get_ty(method_decl)),
                                                                                  type_text);
            if (ret_owner_params.len > 0
                && hir_builder_generic_param_count(ret_owner_params) == hir_builder_generic_arg_count(owner_type_args)
                && !hir_builder_generic_contains(ret_owner_params, "Self")) {
                owner_params = ret_owner_params;
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0 && method_params.len > 0) {
            let owner_arg_count = hir_builder_generic_arg_count(owner_type_args);
            let derived_owner_params = hir_builder_generic_params_prefix(method_params, owner_arg_count);
            if (hir_builder_generic_param_count(derived_owner_params) == owner_arg_count
                && !hir_builder_generic_contains(derived_owner_params, "Self")) {
                owner_params = derived_owner_params;
                method_params = hir_builder_generic_params_after(method_params, owner_arg_count);
            }
        }
        if (method_params.len == 0) {
            method_params = hir_builder_inferred_decl_template_params_except(method_decl, owner_params);
        }
        let owner_args = hir_builder_owner_args_for_params(owner_params, type_text);
        var bindings = HirGenericBindingMap.create();
        self.seed_bindings_from_args(&mut bindings, owner_params, owner_args);
        self.seed_bindings_from_args(&mut bindings, method_params, explicit_method_args);
        let method_args = self.args_for_params(method_params, explicit_method_args, bindings);
        bindings.dispose();
        var params = owner_params;
        var args = owner_args;
        params = hir_builder_append_csv(params, method_params);
        args = hir_builder_append_csv(args, method_args);
        if (self.decl_body_has_template_type(method_decl)) {
            var env_index: i32 = 0;
            while (env_index < 64) {
                let env_param = hir_builder_generic_param_at(self.current_generic_params, env_index);
                if (env_param.len == 0) { break; }
                let env_arg = policy_generic_arg_at(self.current_generic_args, env_index);
                if (env_param != "Self"
                    && env_arg.len > 0
                    && self.decl_contains_template_param(method_decl, env_param)
                    && !hir_builder_generic_contains(params, env_param)) {
                    params = hir_builder_append_csv(params, env_param);
                    args = hir_builder_append_csv(args, env_arg);
                }
                env_index = env_index + 1;
            }
        }
        var direct_closed_method = hir_id_invalid();
        if (method_params.len == 0) {
            direct_closed_method = self.direct_closed_method_function_if_no_instance_env(method_decl,
                                                                                           owner_decl,
                                                                                           type_text,
                                                                                           params,
                                                                                           args);
        }
        if (direct_closed_method != hir_id_invalid()) { return direct_closed_method; }
        if (type_text.len > 0 && !hir_builder_generic_contains(params, "Self")) {
            params = hir_builder_append_csv(params, "Self");
            args = hir_builder_append_csv(args, type_text);
        }
        let out_fn = self.ensure_function_instance(method_decl, owner_decl, type_text, params, args);
        if (out_fn == hir_id_invalid() || self.function_has_open_template_types(out_fn)) {
            return hir_id_invalid();
        }
        if (method_params.len == 0) {
            self.note_closed_method_instance(type_text, method_name, out_fn);
        }
        self.ensure_reachable_function_body_by_id(out_fn);
        return out_fn;
    }

    fn ensure_method_instance_for_type_text(self, type_text: string, method_name: string) -> i32 {
        let timing_enabled = hir_builder_env_enabled("VYX_HIR_METHOD_INSTANCE_TIMING");
        var timing_start: i64 = 0;
        var timing_mark: i64 = 0;
        var timing_open_ms: i64 = 0;
        var timing_cache_ms: i64 = 0;
        var timing_decl_ms: i64 = 0;
        var timing_owner_ms: i64 = 0;
        var timing_env_ms: i64 = 0;
        var timing_direct_ms: i64 = 0;
        var timing_instance_ms: i64 = 0;
        if (timing_enabled) {
            timing_start = vyx_bootstrap_now_ms();
            timing_mark = timing_start;
        }
        self.profile_ensure_method_calls = self.profile_ensure_method_calls + 1;
        if (type_text.len == 0 || method_name.len == 0 || self.type_text_has_open_template_atom(type_text)) {
            return hir_id_invalid();
        }
        if (timing_enabled) {
            let now_open = vyx_bootstrap_now_ms();
            timing_open_ms = now_open - timing_mark;
            timing_mark = now_open;
        }
        let cached = self.closed_method_instance_for_owner_method(type_text, method_name);
        if (cached != hir_id_invalid()) {
            // The owner/name cache records the canonical closed symbol, not
            // whether its body has been requested.  Dyn-trait vtable discovery
            // often reaches a concrete method only through this cache; returning
            // it without scheduling leaves a valid HIR/MIR shell with no body.
            self.ensure_reachable_function_body_by_id(cached);
            return cached;
        }
        if (timing_enabled) {
            let now_cache = vyx_bootstrap_now_ms();
            timing_cache_ms = now_cache - timing_mark;
            timing_mark = now_cache;
        }
        var method_decl = self.raw_method_decl_for_type_text(type_text, method_name);
        if (method_decl == null) { method_decl = self.raw_template_method_decl_for_type_text(type_text, method_name, false); }
        if (method_decl == null) { return hir_id_invalid(); }
        method_decl = self.canonical_method_decl_for_owner_type(method_decl, type_text);
        if (timing_enabled) {
            let now_decl = vyx_bootstrap_now_ms();
            timing_decl_ms = now_decl - timing_mark;
            timing_mark = now_decl;
        }
        var default_owner = hir_raw_owner_map_get(self.decl_owner_map,method_decl);
        if (default_owner == null
            || (policy_generic_call_args(type_text.clone()).len > 0
                && !self.owner_decl_matches_concrete_type(default_owner, type_text))) {
            default_owner = self.raw_class_decl_for_type_text(type_text);
        }
        var owner_decl = self.method_owner_decl_for_type_text(method_decl,
                                                              type_text,
                                                              default_owner);
        if (owner_decl == null) { return hir_id_invalid(); }
        method_decl = self.method_body_decl_for_instance(method_decl);
        if (timing_enabled) {
            let now_owner = vyx_bootstrap_now_ms();
            timing_owner_ms = now_owner - timing_mark;
            timing_mark = now_owner;
        }
        var owner_params = hir_builder_decl_template_params(owner_decl);
        var method_params = hir_builder_decl_template_params(method_decl);
        let owner_type_args = policy_generic_call_args(type_text.clone());
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let template_owner = self.raw_template_class_decl_for_type_text(type_text);
            if (template_owner != null) {
                let template_params = hir_builder_decl_template_params(template_owner);
                if (template_params.len > 0) { owner_params = template_params; }
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let ret_owner_params = hir_builder_template_params_matching_owner_text(hir_builder_type_ref_name(decl_get_ty(method_decl)),
                                                                                  type_text);
            if (ret_owner_params.len > 0
                && hir_builder_generic_param_count(ret_owner_params) == hir_builder_generic_arg_count(owner_type_args)
                && !hir_builder_generic_contains(ret_owner_params, "Self")) {
                owner_params = ret_owner_params;
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0 && method_params.len > 0) {
            let owner_arg_count = hir_builder_generic_arg_count(owner_type_args);
            let derived_owner_params = hir_builder_generic_params_prefix(method_params, owner_arg_count);
            if (hir_builder_generic_param_count(derived_owner_params) == owner_arg_count
                && !hir_builder_generic_contains(derived_owner_params, "Self")) {
                owner_params = derived_owner_params;
                method_params = hir_builder_generic_params_after(method_params, owner_arg_count);
            }
        }
        let owner_args = hir_builder_owner_args_for_params(owner_params, type_text);
        var params = owner_params;
        var args = owner_args;
        params = hir_builder_append_csv(params, method_params);
        let method_args = self.args_for_params(method_params, "", HirGenericBindingMap.create());
        args = hir_builder_append_csv(args, method_args);
        if (self.decl_body_has_template_type(method_decl)) {
            var env_index: i32 = 0;
            while (env_index < 64) {
                let env_param = hir_builder_generic_param_at(self.current_generic_params, env_index);
                if (env_param.len == 0) { break; }
                let env_arg = policy_generic_arg_at(self.current_generic_args, env_index);
                if (env_param != "Self"
                    && env_arg.len > 0
                    && self.decl_contains_template_param(method_decl, env_param)
                    && !hir_builder_generic_contains(params, env_param)) {
                    params = hir_builder_append_csv(params, env_param);
                    args = hir_builder_append_csv(args, env_arg);
                }
                env_index = env_index + 1;
            }
        }
        if (timing_enabled) {
            let now_env = vyx_bootstrap_now_ms();
            timing_env_ms = now_env - timing_mark;
            timing_mark = now_env;
        }
        let direct_closed_method = self.direct_closed_method_function_if_no_instance_env(method_decl,
                                                                                        owner_decl,
                                                                                        type_text,
                                                                                        params,
                                                                                        args);
        if (direct_closed_method != hir_id_invalid()) {
            if (method_params.len == 0) {
                self.note_closed_method_instance(type_text, method_name, direct_closed_method);
            }
            if (timing_enabled) {
                let now_direct_hit = vyx_bootstrap_now_ms();
                timing_direct_ms = now_direct_hit - timing_mark;
                let total = now_direct_hit - timing_start;
                if (total >= hir_builder_slow_expr_threshold_ms()) {
                    print("[hir-method-instance] type=" + type_text
                          + " method=" + method_name
                          + " total=" + policy_i64_to_string(total)
                          + " open=" + policy_i64_to_string(timing_open_ms)
                          + " cache=" + policy_i64_to_string(timing_cache_ms)
                          + " decl=" + policy_i64_to_string(timing_decl_ms)
                          + " owner=" + policy_i64_to_string(timing_owner_ms)
                          + " env=" + policy_i64_to_string(timing_env_ms)
                          + " direct=" + policy_i64_to_string(timing_direct_ms)
                          + " instance=0"
                          + " fn=" + self.i32_text(direct_closed_method));
                }
            }
            self.ensure_reachable_function_body_by_id(direct_closed_method);
            return direct_closed_method;
        }
        if (timing_enabled) {
            let now_direct = vyx_bootstrap_now_ms();
            timing_direct_ms = now_direct - timing_mark;
            timing_mark = now_direct;
        }
        if (type_text.len > 0 && !hir_builder_generic_contains(params, "Self")) {
            params = hir_builder_append_csv(params, "Self");
            args = hir_builder_append_csv(args, type_text);
        }
        if (params.len == 0 || args.len == 0) {
            let direct_fn = hir_pointer_map_function(self.decl_map,method_decl);
            if (direct_fn != hir_id_invalid()) {
                self.ensure_reachable_function_body(method_decl, direct_fn, false);
                if (method_params.len == 0) {
                    self.note_closed_method_instance(type_text, method_name, direct_fn);
                }
                return direct_fn;
            }
        }
        let out_fn = self.ensure_function_instance(method_decl, owner_decl, type_text, params, args);
        if (timing_enabled) {
            timing_instance_ms = vyx_bootstrap_now_ms() - timing_mark;
        }
        if (method_params.len == 0) {
            self.note_closed_method_instance(type_text, method_name, out_fn);
        }
        if (timing_enabled) {
            let total = vyx_bootstrap_now_ms() - timing_start;
            if (total >= hir_builder_slow_expr_threshold_ms()) {
                print("[hir-method-instance] type=" + type_text
                      + " method=" + method_name
                      + " total=" + policy_i64_to_string(total)
                      + " open=" + policy_i64_to_string(timing_open_ms)
                      + " cache=" + policy_i64_to_string(timing_cache_ms)
                      + " decl=" + policy_i64_to_string(timing_decl_ms)
                      + " owner=" + policy_i64_to_string(timing_owner_ms)
                      + " env=" + policy_i64_to_string(timing_env_ms)
                      + " direct=" + policy_i64_to_string(timing_direct_ms)
                      + " instance=" + policy_i64_to_string(timing_instance_ms)
                      + " fn=" + self.i32_text(out_fn));
            }
        }
        if (out_fn != hir_id_invalid()) {
            self.ensure_reachable_function_body_by_id(out_fn);
        }
        return out_fn;
    }

    fn ensure_method_instance_for_call(self,
                                             type_text: string,
                                             method_name: string,
                                             call_expr: rawptr,
                                             call_expr_id: i32,
                                             method_decl: rawptr,
                                             want_static: bool) -> i32 {
        self.profile_ensure_method_calls = self.profile_ensure_method_calls + 1;
        if (type_text.len == 0 || method_name.len == 0 || self.type_text_has_open_template_atom(type_text)) {
            if (hir_builder_env_enabled("VYX_DCI_MONO_TRACE")) {
                print("[dci-mono] reject=open-receiver type=" + type_text + " method=" + method_name);
            }
            return hir_id_invalid();
        }
        let has_preselected_decl = method_decl != null;
        var selected_decl = method_decl;
        if (selected_decl == null) {
            if (want_static) {
                selected_decl = self.raw_static_method_decl_for_type_text(type_text, method_name);
            } else {
                selected_decl = self.raw_method_decl_for_type_text(type_text, method_name);
            }
        }
        if (selected_decl == null) {
            selected_decl = self.raw_template_method_decl_for_type_text(type_text, method_name, want_static);
        }
        if (selected_decl == null || decl_get_kind(selected_decl) != de_METHOD()) {
            if (hir_builder_env_enabled("VYX_DCI_MONO_TRACE")) {
                print("[dci-mono] reject=no-method-decl type=" + type_text + " method=" + method_name);
            }
            return hir_id_invalid();
        }
        // Preserve the declaration identity selected by Sema for versioned
        // and overloaded calls; owner/name canonicalization is not exact.
        if (!has_preselected_decl) {
            selected_decl = self.canonical_method_decl_for_owner_type(selected_decl, type_text);
        }
        var owner_decl = self.method_owner_decl_for_type_text(selected_decl,
                                                              type_text,
                                                              self.raw_class_decl_for_type_text(type_text));
        if (owner_decl == null) {
            if (hir_builder_env_enabled("VYX_DCI_MONO_TRACE")) {
                print("[dci-mono] reject=no-owner-decl type=" + type_text + " method=" + method_name);
            }
            return hir_id_invalid();
        }
        let declaration_method_params = hir_builder_decl_template_params(selected_decl);
        selected_decl = self.method_body_decl_for_instance(selected_decl);
        var owner_params = hir_builder_decl_template_params(owner_decl);
        var method_params = hir_builder_decl_template_params(selected_decl);
        if (method_params.len == 0 && declaration_method_params.len > 0) {
            method_params = declaration_method_params;
        }
        let owner_type_args = policy_generic_call_args(type_text.clone());
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let template_owner = self.raw_template_class_decl_for_type_text(type_text);
            if (template_owner != null) {
                let template_params = hir_builder_decl_template_params(template_owner);
                if (template_params.len > 0) { owner_params = template_params; }
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let ret_owner_params = hir_builder_template_params_matching_owner_text(hir_builder_type_ref_name(decl_get_ty(selected_decl)),
                                                                                  type_text);
            if (ret_owner_params.len > 0
                && hir_builder_generic_param_count(ret_owner_params) == hir_builder_generic_arg_count(owner_type_args)
                && !hir_builder_generic_contains(ret_owner_params, "Self")) {
                owner_params = ret_owner_params;
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0 && method_params.len > 0) {
            let owner_arg_count = hir_builder_generic_arg_count(owner_type_args);
            let derived_owner_params = hir_builder_generic_params_prefix(method_params, owner_arg_count);
            if (hir_builder_generic_param_count(derived_owner_params) == owner_arg_count
                && !hir_builder_generic_contains(derived_owner_params, "Self")) {
                owner_params = derived_owner_params;
                method_params = hir_builder_generic_params_after(method_params, owner_arg_count);
            }
        }
        if (method_params.len == 0) {
            method_params = hir_builder_inferred_decl_template_params_except(selected_decl, owner_params);
        }
        let owner_args = hir_builder_owner_args_for_params(owner_params, type_text);
        var explicit_method_args = self.resolve_explicit_generic_args_for_call(call_expr);
        if (explicit_method_args.len == 0) {
            explicit_method_args = self.resolve_explicit_generic_args_for_hir_call(call_expr_id);
        }
        var bindings = HirGenericBindingMap.create();
        if (call_expr_id != hir_id_invalid()) {
            bindings = self.infer_hir_call_bindings(call_expr_id,
                                                    selected_decl,
                                                    owner_params,
                                                    owner_args,
                                                    method_params,
                                                    explicit_method_args);
        } else {
            bindings = self.infer_call_bindings(call_expr,
                                                selected_decl,
                                                owner_params,
                                                owner_args,
                                                method_params,
                                                explicit_method_args);
        }
        // A materialized generic caller still points at the template AST,
        // whose argument TypeRefs may contain the caller's open parameters.
        // The HIR call already carries the closed argument types, so it is the
        // authoritative source for method packs such as Box<T>::new<...Ts>.
        var method_args = "";
        if (call_expr_id != hir_id_invalid()) {
            method_args = self.args_for_hir_call_params(call_expr_id,
                                                        selected_decl,
                                                        method_params,
                                                        explicit_method_args,
                                                        bindings);
        } else {
            method_args = self.args_for_call_params(call_expr,
                                                    selected_decl,
                                                    method_params,
                                                    explicit_method_args,
                                                    bindings);
        }
        bindings.dispose();
        var params = owner_params;
        var args = owner_args;
        params = hir_builder_append_csv(params, method_params);
        args = hir_builder_append_csv(args, method_args);
        if (self.decl_body_has_template_type(selected_decl)) {
            var env_index: i32 = 0;
            while (env_index < 64) {
                let env_param = hir_builder_generic_param_at(self.current_generic_params, env_index);
                if (env_param.len == 0) { break; }
                let env_arg = policy_generic_arg_at(self.current_generic_args, env_index);
                if (env_param != "Self"
                    && env_arg.len > 0
                    && self.decl_contains_template_param(selected_decl, env_param)
                    && !hir_builder_generic_contains(params, env_param)) {
                    params = hir_builder_append_csv(params, env_param);
                    args = hir_builder_append_csv(args, env_arg);
                }
                env_index = env_index + 1;
            }
        }
        var direct_closed_method = hir_id_invalid();
        if (method_params.len == 0) {
            direct_closed_method = self.direct_closed_method_function_if_no_instance_env(selected_decl,
                                                                                           owner_decl,
                                                                                           type_text,
                                                                                           params,
                                                                                           args);
        }
        if (direct_closed_method != hir_id_invalid()) { return direct_closed_method; }
        if (type_text.len > 0 && !hir_builder_generic_contains(params, "Self")) {
            params = hir_builder_append_csv(params, "Self");
            args = hir_builder_append_csv(args, type_text);
        }
        let zero_variadic_instance = call_expr != null
            && expr_get_kind(call_expr) == ex_CALL()
            && self.decl_has_variadic_param(selected_decl)
            && params.len > 0
            && args.len == 0;
        if (params.len == 0 || (args.len == 0 && !zero_variadic_instance)) {
            let direct_fn = hir_pointer_map_function(self.decl_map,selected_decl);
            if (direct_fn != hir_id_invalid()) {
                self.ensure_reachable_function_body(selected_decl, direct_fn, false);
                if (method_params.len == 0) {
                    self.note_closed_method_instance(type_text, method_name, direct_fn);
                }
                return direct_fn;
            }
            return hir_id_invalid();
        }
        // Resolve a closed non-generic method before creating an instance
        // shell.  The instance path publishes its shell to the reachable-body
        // queue immediately; selecting the direct method only afterwards
        // leaves that abandoned shell observable by both streaming backends
        // as a bodyless reachable definition.  This is common for trait
        // dispatch on concrete primitive receivers, but the ordering rule is
        // general: a stable direct ABI identity wins before specialization.
        if (method_params.len == 0) {
            let direct_callee_expr_id = if (call_expr_id != hir_id_invalid()) {
                self.unit.expr_lhs(call_expr_id)
            } else {
                hir_id_invalid()
            };
            let direct_fn = self.direct_method_function_for_closed_receiver(
                type_text,
                method_name,
                call_expr_id,
                direct_callee_expr_id);
            if (direct_fn != hir_id_invalid()) {
                self.ensure_reachable_function_body_by_id(direct_fn);
                self.note_closed_method_instance(type_text, method_name, direct_fn);
                return direct_fn;
            }
        }
        let out_fn = self.ensure_function_instance(selected_decl, owner_decl, type_text, params, args);
        if (hir_builder_env_enabled("VYX_DCI_MONO_TRACE")) {
            var trace_name = "<invalid>";
            var trace_open = true;
            if (out_fn != hir_id_invalid()) {
                trace_name = self.unit.function_name(out_fn);
                trace_open = self.function_has_open_template_types(out_fn);
            }
            var trace_open_text = "0";
            if (trace_open) { trace_open_text = "1"; }
            print("[dci-mono] instance type=" + type_text + " method=" + method_name
                  + " fn=" + self.i32_text(out_fn)
                  + " name=" + trace_name
                  + " open=" + trace_open_text);
        }
        if (out_fn == hir_id_invalid() || self.function_has_open_template_types(out_fn)) {
            if (hir_builder_env_enabled("VYX_DCI_MONO_TRACE")) {
                print("[dci-mono] reject=instance-still-open type=" + type_text + " method=" + method_name);
            }
            return hir_id_invalid();
        }
        if (method_params.len == 0) {
            let callee_expr_id = if (call_expr_id != hir_id_invalid()) {
                self.unit.expr_lhs(call_expr_id)
            } else {
                hir_id_invalid()
            };
            let direct_fn = self.direct_method_function_for_closed_receiver(
                type_text,
                method_name,
                call_expr_id,
                callee_expr_id);
            if (direct_fn != hir_id_invalid()) {
                self.ensure_reachable_function_body_by_id(direct_fn);
                self.note_closed_method_instance(type_text, method_name, direct_fn);
                return direct_fn;
            }
            self.note_closed_method_instance(type_text, method_name, out_fn);
        }
        return out_fn;
    }

    fn ensure_static_method_instance_for_type_text(self, type_text: string, method_name: string) -> i32 {
        if (type_text.len == 0 || method_name.len == 0 || self.type_text_has_open_template_atom(type_text)) {
            return hir_id_invalid();
        }
        let cached = self.closed_method_instance_for_owner_method(type_text, method_name);
        if (cached != hir_id_invalid()) {
            self.ensure_reachable_function_body_by_id(cached);
            return cached;
        }
        var method_decl = self.raw_static_method_decl_for_type_text(type_text, method_name);
        if (method_decl == null) { method_decl = self.raw_template_method_decl_for_type_text(type_text, method_name, true); }
        if (method_decl == null) { return hir_id_invalid(); }
        method_decl = self.canonical_method_decl_for_owner_type(method_decl, type_text);
        var owner_decl = self.method_owner_decl_for_type_text(method_decl,
                                                              type_text,
                                                              self.raw_class_decl_for_type_text(type_text));
        if (owner_decl == null) { return hir_id_invalid(); }
        let declaration_method_params = hir_builder_decl_template_params(method_decl);
        method_decl = self.method_body_decl_for_instance(method_decl);
        var owner_params = hir_builder_decl_template_params(owner_decl);
        var method_params = hir_builder_decl_template_params(method_decl);
        if (method_params.len == 0 && declaration_method_params.len > 0) {
            method_params = declaration_method_params;
        }
        let owner_type_args = policy_generic_call_args(type_text.clone());
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let template_owner = self.raw_template_class_decl_for_type_text(type_text);
            if (template_owner != null) {
                let template_params = hir_builder_decl_template_params(template_owner);
                if (template_params.len > 0) { owner_params = template_params; }
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let ret_owner_params = hir_builder_template_params_matching_owner_text(hir_builder_type_ref_name(decl_get_ty(method_decl)),
                                                                                  type_text);
            if (ret_owner_params.len > 0
                && hir_builder_generic_param_count(ret_owner_params) == hir_builder_generic_arg_count(owner_type_args)
                && !hir_builder_generic_contains(ret_owner_params, "Self")) {
                owner_params = ret_owner_params;
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0 && method_params.len > 0) {
            let owner_arg_count = hir_builder_generic_arg_count(owner_type_args);
            let derived_owner_params = hir_builder_generic_params_prefix(method_params, owner_arg_count);
            if (hir_builder_generic_param_count(derived_owner_params) == owner_arg_count
                && !hir_builder_generic_contains(derived_owner_params, "Self")) {
                owner_params = derived_owner_params;
                method_params = hir_builder_generic_params_after(method_params, owner_arg_count);
            }
        }
        let owner_args = hir_builder_owner_args_for_params(owner_params, type_text);
        var params = owner_params;
        var args = owner_args;
        params = hir_builder_append_csv(params, method_params);
        let method_args = self.args_for_params(method_params, "", HirGenericBindingMap.create());
        args = hir_builder_append_csv(args, method_args);
        if (self.decl_body_has_template_type(method_decl)) {
            var env_index: i32 = 0;
            while (env_index < 64) {
                let env_param = hir_builder_generic_param_at(self.current_generic_params, env_index);
                if (env_param.len == 0) { break; }
                let env_arg = policy_generic_arg_at(self.current_generic_args, env_index);
                if (env_param != "Self"
                    && env_arg.len > 0
                    && self.decl_contains_template_param(method_decl, env_param)
                    && !hir_builder_generic_contains(params, env_param)) {
                    params = hir_builder_append_csv(params, env_param);
                    args = hir_builder_append_csv(args, env_arg);
                }
                env_index = env_index + 1;
            }
        }
        var direct_closed_static_method = hir_id_invalid();
        if (method_params.len == 0) {
            direct_closed_static_method = self.direct_closed_method_function_if_no_instance_env(method_decl,
                                                                                                  owner_decl,
                                                                                                  type_text,
                                                                                                  params,
                                                                                                  args);
        }
        if (direct_closed_static_method != hir_id_invalid()) { return direct_closed_static_method; }
        if (type_text.len > 0 && !hir_builder_generic_contains(params, "Self")) {
            params = hir_builder_append_csv(params, "Self");
            args = hir_builder_append_csv(args, type_text);
        }
        if (params.len == 0 || args.len == 0) {
            let direct_fn = hir_pointer_map_function(self.decl_map,method_decl);
            if (direct_fn != hir_id_invalid()) {
                self.ensure_reachable_function_body(method_decl, direct_fn, false);
                if (method_params.len == 0) {
                    self.note_closed_method_instance(type_text, method_name, direct_fn);
                }
                return direct_fn;
            }
        }
        let out_fn = self.ensure_function_instance(method_decl, owner_decl, type_text, params, args);
        if (method_params.len == 0) {
            self.note_closed_method_instance(type_text, method_name, out_fn);
        }
        return out_fn;
    }

    fn ensure_await_value_instance_for_type_id(self, type_id: i32) -> i32 {
        if (type_id == hir_id_invalid()) { return hir_id_invalid(); }
        let type_text = hir_type_table_text(self.unit.types, type_id);
        let base = hir_builder_type_base_name(type_text);
        if (base != "Task" && base != "Promise") { return hir_id_invalid(); }
        self.ensure_method_instance_for_type_text(type_text, "poll");
        return self.ensure_method_instance_for_type_text(type_text, "await_value");
    }

    fn local_type_id_should_auto_drop(self, type_id: i32) -> bool {
        if (type_id == hir_id_invalid()) { return false; }
        let text = hir_type_table_text(self.unit.types, type_id);
        if (self.type_text_has_instance_drop(text)) { return true; }
        return self.type_text_requires_dci_stub_drop(text);
    }

    fn param_type_id_should_move_arg(self, callable: rawptr, param: rawptr, type_id: i32) -> bool {
        if (param == null || type_id == hir_id_invalid()) { return false; }
        if (decl_get_name(param) == "self") {
            if (!hir_builder_self_receiver_is_owning(param)) { return false; }
            let markers = decl_get_generic_params(param);
            if (hir_builder_string_contains(markers, "|receiver:own_mut")) {
                let text = hir_type_table_text(self.unit.types, type_id);
                if (self.type_text_has_instance_dup(text)) { return false; }
            }
            return true;
        }
        if (self.callable_consumes_primitive_str(callable, param, type_id)) { return true; }
        if (self.callable_borrows_args(callable)) { return false; }
        if (self.param_moves_to_raw_storage(callable, decl_get_name(param))) { return true; }
        let text = hir_type_table_text(self.unit.types, type_id);
        if (self.type_text_is_ref_lang_item(text)) { return true; }
        return self.type_text_should_transfer_by_value(text);
    }

    fn param_type_id_should_auto_drop(self, callable: rawptr, param: rawptr, type_id: i32) -> bool {
        if (param == null || type_id == hir_id_invalid()) { return false; }
        if (decl_get_name(param) == "self") {
            return self.param_type_id_should_move_arg(callable, param, type_id)
                && self.local_type_id_should_auto_drop(type_id);
        }
        if (self.callable_borrows_args(callable)) { return false; }
        if (self.param_moves_to_raw_storage(callable, decl_get_name(param))) { return false; }
        let text = hir_type_table_text(self.unit.types, type_id);
        if (self.type_text_is_ref_lang_item(text)) { return true; }
        return false;
    }

    fn init_expr_returns_borrowed_container_element(self, init_e: rawptr) -> bool {
        if (init_e == null || expr_get_kind(init_e) != ex_CALL()) { return false; }
        let callee = expr_get_lhs(init_e);
        if (callee == null || expr_get_kind(callee) != ex_MEMBER()) { return false; }
        let method_name = policy_generic_call_base(expr_get_name(callee));
        let receiver = expr_get_lhs(callee);
        if (receiver == null) { return false; }
        let receiver_type_id = self.type_id_from_ref(expr_get_ty(receiver));
        if (receiver_type_id == hir_id_invalid()) { return false; }
        let base = hir_builder_type_base_name(hir_type_table_text(self.unit.types, receiver_type_id));
        if (base == "Vec") {
            return method_name == "get"
                || method_name == "get_unchecked"
                || method_name == "first"
                || method_name == "last";
        }
        if (base == "Dict"
            || base == "UnorderedMap"
            || base == "HashMap"
            || base == "StringMap"
            || base == "ConcurrentDict") {
            return method_name == "get" || method_name == "try_get";
        }
        return false;
    }

    fn local_stmt_is_raw_copy_view(self, s: rawptr, name: string) -> bool {
        if (s == null || name.len == 0) { return false; }
        // Ref::drop and Box::drop materialise an owning T with memcpy before
        // releasing the outer allocation. That local is an ownership transfer,
        // not a view: it must retain ordinary drop glue after monomorphisation.
        if (self.current_function_id != hir_id_invalid()
            && (self.function_candidate_matches_method_name(self.current_function_id, "drop")
                || self.function_candidate_matches_method_name(self.current_function_id, "set"))
            && (hir_builder_type_base_name(hir_unit_function_owner_type(self.unit,
                                                                         self.current_function_id)) == "Box"
                || hir_builder_type_base_name(hir_unit_function_owner_type(self.unit,
                                                                            self.current_function_id)) == "Ref")) {
            return false;
        }
        if (stmt_get_init(s) != null) { return false; }
        let next_stmt = stmt_get_next(s);
        if (next_stmt == null || stmt_get_kind(next_stmt) != st_EXPR()) { return false; }
        let e = stmt_get_init(next_stmt);
        if (e == null || expr_get_kind(e) != ex_CALL()) { return false; }
        let callee = expr_get_lhs(e);
        if (callee == null || expr_get_kind(callee) != ex_IDENT()) { return false; }
        let cname = policy_generic_call_base(expr_get_name(callee));
        if (cname != "memcpy" && cname != "memmove") { return false; }
        let dst_e = hir_builder_arg_expr_at(expr_get_args(e), 0);
        return self.expr_is_to_rawptr_addr_of_ident(dst_e, name);
    }

    fn set_local_drop_for_type(self, local_id: i32, type_id: i32) {
        if (local_id == hir_id_invalid() || type_id == hir_id_invalid()) { return; }
        if (hir_type_table_kind(self.unit.types, type_id) == ty_STRING()) {
            let drop_fn = self.primitive_str_drop_function();
            if (drop_fn != hir_id_invalid()) {
                self.unit.set_local_drop_function(local_id, drop_fn);
            }
            return;
        }
        let type_text = hir_type_table_text(self.unit.types, type_id);
        if (self.type_text_requires_dci_stub_drop(type_text)) { return; }
        let drop_fn = self.ensure_drop_instance_for_type_text(type_text);
        if (drop_fn != hir_id_invalid()) {
            self.unit.set_local_drop_function(local_id, drop_fn);
        }
    }

    fn mark_param_local_drop_if_needed(self, callable: rawptr, param: rawptr, local_id: i32) {
        if (callable == null || param == null || local_id == hir_id_invalid()) { return; }
        let flags = self.unit.local_flags(local_id);
        if ((flags & hir_local_flag_param()) == 0) { return; }
        let type_id = self.unit.local_type(local_id);
        var next_flags = flags;
        if (self.param_type_id_should_move_arg(callable, param, type_id)) {
            next_flags = next_flags | hir_local_flag_move_arg();
        }
        if (self.param_type_id_should_auto_drop(callable, param, type_id)) {
            next_flags = next_flags | hir_local_flag_auto_drop();
            self.set_local_drop_for_type(local_id, type_id);
        }
        if (next_flags != flags) {
            self.unit.set_local_flags(local_id, next_flags);
        }
    }

    fn refresh_function_param_drop_metadata(self, fn_id: i32, d: rawptr) {
        if (fn_id == hir_id_invalid() || d == null) { return; }
        var param = decl_get_params(d);
        var local_id = self.unit.function_first_local(fn_id);
        if (local_id != hir_id_invalid()
            && self.local_is_constructor_abi_self(fn_id, local_id)
            && (param == null || decl_get_name(param) != "self")) {
            local_id = self.unit.local_next(local_id);
        }
        while (param != null && local_id != hir_id_invalid()) {
            if (hir_builder_variadic_param(param)) {
                let pack_name = hir_builder_param_pack_type_name(param);
                let pack_count = self.current_pack_count(pack_name);
                var i: i32 = 0;
                while (i < pack_count && local_id != hir_id_invalid()) {
                    self.mark_param_local_drop_if_needed(d, param, local_id);
                    local_id = self.unit.local_next(local_id);
                    i = i + 1;
                }
                param = decl_get_next(param);
            } else {
                self.mark_param_local_drop_if_needed(d, param, local_id);
                local_id = self.unit.local_next(local_id);
                param = decl_get_next(param);
            }
        }
    }

    fn index_raw_class_decl(self, d: rawptr, item_name: string) {
        if (d == null) { return; }
        let k = decl_get_kind(d);
        if (k != de_CLASS() && k != de_ENUM()) { return; }
        // Any new class/enum registration may change raw-text scan results;
        // advance the version so the text-keyed scan caches re-validate.
        self.raw_class_index_version = self.raw_class_index_version + 1;
        self.invalidate_materialization_resolution_caches();
        let raw_name = decl_get_name(d);
        if (raw_name.len > 0) {
            self.index_raw_class_name_key(raw_name, d);
            let raw_base = hir_builder_type_base_name(raw_name);
            if (raw_base.len > 0) {
                self.index_raw_class_name_key(raw_base, d);
            }
        }
        if (item_name.len > 0) {
            self.index_raw_class_name_key(item_name, d);
            let item_base = hir_builder_type_base_name(item_name);
            if (item_base.len > 0) {
                self.index_raw_class_name_key(item_base, d);
            }
        }
        var base = hir_builder_type_base_name(item_name);
        if (base.len == 0) { base = hir_builder_type_base_name(raw_name); }
        if (base.len == 0) { return; }
        let params = hir_builder_decl_template_params(d);
        let item_args = policy_generic_call_args(item_name.clone());
        let raw_args = policy_generic_call_args(raw_name.clone());
        let members_have_template = self.decl_members_have_template_type(d);
        if (params.len > 0 && (members_have_template || (item_args.len == 0 && raw_args.len == 0))) {
            self.raw_class_template = hir_raw_name_map_put(self.raw_class_template,base, d);
        }
        if (!members_have_template) {
            if (item_args.len > 0) {
                self.raw_class_concrete = hir_raw_name_map_put(self.raw_class_concrete,item_name, d);
                self.raw_class_concrete = hir_raw_name_map_put(self.raw_class_concrete,base + "::<" + item_args + ">", d);
            }
            let head_args = hir_builder_generic_head(decl_get_generic_params(d));
            if (head_args.len > 0 && head_args != params) {
                self.raw_class_concrete = hir_raw_name_map_put(self.raw_class_concrete,base + "::<" + head_args + ">", d);
            }
        }
    }

    fn index_raw_class_name_key(self, key: string, d: rawptr) {
        if (key.len == 0 || d == null) { return; }
        let existing = hir_raw_name_map_get(self.raw_class_exact,key);
        if (existing == null || existing == d) {
            self.raw_class_exact = hir_raw_name_map_put(self.raw_class_exact,key, d);
            return;
        }
        if (hir_builder_decl_imported(existing) && hir_builder_decl_imported(d)) {
            let existing_layout_exact = string_contains(decl_get_meta(existing), "|layout-exact|");
            let new_layout_exact = string_contains(decl_get_meta(d), "|layout-exact|");
            if (new_layout_exact && !existing_layout_exact) {
                self.raw_class_exact = hir_raw_name_map_put(self.raw_class_exact,key, d);
                return;
            }
            if (existing_layout_exact && !new_layout_exact) { return; }
            if (existing_layout_exact && new_layout_exact) {
                // Sema only appends another exact declaration when it carries
                // a richer layout, so the later indexed declaration wins.
                self.raw_class_exact = hir_raw_name_map_put(self.raw_class_exact,key, d);
                return;
            }
        }
        let existing_priority = hir_builder_raw_decl_external_priority(existing);
        let new_priority = hir_builder_raw_decl_external_priority(d);
        if (new_priority < existing_priority) {
            self.raw_class_exact = hir_raw_name_map_put(self.raw_class_exact,key, d);
        }
    }

    fn index_registered_type_atom(self, item_kind: i32, item_name: string) {
        if (item_name.len == 0) { return; }
        if (item_kind != hir_item_class()
            && item_kind != hir_item_enum()
            && item_kind != hir_item_interface()
            && item_kind != hir_item_type_alias()) {
            return;
        }
        self.registered_type_atoms = hir_string_set_add(self.registered_type_atoms,item_name);
        let base = hir_builder_type_base_name(item_name);
        if (base.len > 0) {
            self.registered_type_atoms = hir_string_set_add(self.registered_type_atoms,base);
            let last_base = hir_builder_last_path_segment(base);
            if (last_base.len > 0) {
                self.registered_type_atoms = hir_string_set_add(self.registered_type_atoms,last_base);
            }
        }
        let last = hir_builder_last_path_segment(item_name);
        if (last.len > 0) {
            self.registered_type_atoms = hir_string_set_add(self.registered_type_atoms,last);
        }
    }

    fn preindex_raw_type_decls(self, head: rawptr) {
        var cur = head;
        while (cur != null) {
            let k = decl_get_kind(cur);
            if (k == de_CLASS() || k == de_ENUM()) {
                var item_name = decl_get_name(cur);
                let spec_args = hir_builder_decl_concrete_spec_args(cur);
                if (spec_args.len > 0 && policy_generic_call_has_args(item_name.clone()) == 0) {
                    item_name = item_name + "::<" + spec_args + ">";
                }
                self.index_raw_class_decl(cur, item_name);
                self.index_registered_type_atom(hir_builder_item_kind_from_decl(cur), item_name);
                self.preindex_raw_type_decls(decl_get_members(cur));
            } else if (k == de_EXTERN_FN()) {
                self.preindex_raw_type_decls(decl_get_members(cur));
            }
            cur = decl_get_next(cur);
        }
    }

    fn index_method_function(self, item_kind: i32, owner_item_id: i32, method_name: string, fn_id: i32) {
        if (item_kind != hir_item_method()
            || owner_item_id == hir_id_invalid()
            || method_name.len == 0
            || fn_id == hir_id_invalid()) {
            return;
        }
        let owner_name = self.unit.item_name(owner_item_id);
        if (owner_name.len == 0) { return; }
        self.method_function_index = hir_pair_id_map_put(self.method_function_index,owner_name, method_name, fn_id);
        let owner_base = hir_builder_type_base_name(owner_name);
        if (owner_base.len > 0) {
            self.method_function_index = hir_pair_id_map_put(self.method_function_index,owner_base, method_name, fn_id);
            let owner_last = hir_builder_last_path_segment(owner_base);
            if (owner_last.len > 0) {
                self.method_function_index = hir_pair_id_map_put(self.method_function_index,owner_last, method_name, fn_id);
            }
        }
        let last_name = hir_builder_last_path_segment(owner_name);
        if (last_name.len > 0) {
            self.method_function_index = hir_pair_id_map_put(self.method_function_index,last_name, method_name, fn_id);
        }
    }

    fn index_free_function(self, item_kind: i32, function_name: string, fn_id: i32) {
        if ((item_kind != hir_item_function() && item_kind != hir_item_extern_function())
            || function_name.len == 0
            || fn_id == hir_id_invalid()) {
            return;
        }
        self.free_function_index = hir_name_id_map_put_first(self.free_function_index,function_name, fn_id);
        let base = policy_generic_call_base(function_name.clone());
        if (base.len > 0) {
            self.free_function_index = hir_name_id_map_put_first(self.free_function_index,base, fn_id);
            let last_base = hir_builder_last_path_segment(base);
            if (last_base.len > 0) {
                self.free_function_index = hir_name_id_map_put_first(self.free_function_index,last_base, fn_id);
            }
        }
        let last = hir_builder_last_path_segment(function_name);
        if (last.len > 0) {
            self.free_function_index = hir_name_id_map_put_first(self.free_function_index,last, fn_id);
        }
    }

    fn index_value_item(self, item_kind: i32, item_name: string, item_id: i32) {
        if ((item_kind != hir_item_const() && item_kind != hir_item_global())
            || item_name.len == 0
            || item_id == hir_id_invalid()) {
            return;
        }
        self.value_item_index = hir_name_id_map_put_first(self.value_item_index,item_name, item_id);
        let base = policy_generic_call_base(item_name.clone());
        if (base.len > 0) {
            self.value_item_index = hir_name_id_map_put_first(self.value_item_index,base, item_id);
            let last_base = hir_builder_last_path_segment(base);
            if (last_base.len > 0) {
                self.value_item_index = hir_name_id_map_put_first(self.value_item_index,last_base, item_id);
            }
        }
        let last = hir_builder_last_path_segment(item_name);
        if (last.len > 0) {
            self.value_item_index = hir_name_id_map_put_first(self.value_item_index,last, item_id);
        }
    }

    fn index_field_item(self,
                        item_kind: i32,
                        owner_item_id: i32,
                        field_name: string,
                        field_item_id: i32,
                        raw_field: rawptr) {
        if (item_kind != hir_item_field()
            || owner_item_id == hir_id_invalid()
            || field_name.len == 0
            || field_item_id == hir_id_invalid()) {
            return;
        }
        let owner_name = self.unit.item_name(owner_item_id);
        if (owner_name.len == 0) { return; }
        self.field_index = hir_pair_id_map_put(self.field_index,owner_name, field_name, field_item_id);
        let owner_base = hir_builder_type_base_name(owner_name);
        if (owner_base.len > 0) {
            self.field_index = hir_pair_id_map_put(self.field_index,owner_base, field_name, field_item_id);
            let owner_last = hir_builder_last_path_segment(owner_base);
            if (owner_last.len > 0) {
                self.field_index = hir_pair_id_map_put(self.field_index,owner_last, field_name, field_item_id);
            }
        }
        let last_name = hir_builder_last_path_segment(owner_name);
        if (last_name.len > 0) {
            self.field_index = hir_pair_id_map_put(self.field_index,last_name, field_name, field_item_id);
        }
        let migrated_name = hir_builder_field_migrate_from_field(raw_field);
        if (migrated_name.len > 0 && migrated_name != field_name) {
            self.field_index = hir_pair_id_map_put(self.field_index,owner_name, migrated_name, field_item_id);
            if (owner_base.len > 0) {
                self.field_index = hir_pair_id_map_put(self.field_index,owner_base, migrated_name, field_item_id);
                let owner_last2 = hir_builder_last_path_segment(owner_base);
                if (owner_last2.len > 0) {
                    self.field_index = hir_pair_id_map_put(self.field_index,owner_last2, migrated_name, field_item_id);
                }
            }
            if (last_name.len > 0) {
                self.field_index = hir_pair_id_map_put(self.field_index,last_name, migrated_name, field_item_id);
            }
        }
    }

    fn append_interface_super_edges_for_decl(self, d: rawptr, item_name: string) {
        if (d == null || item_name.len == 0) { return; }
        if ((decl_get_generic_flags(d) & 2) == 0
            && !hir_builder_string_contains(decl_get_generic_params(d), "|kind:interface")) {
            return;
        }
        let gp = decl_get_generic_params(d);
        var idx: i32 = 0;
        var rows = hir_unit_interface_supers(self.unit);
        while (idx < 64) {
            let super_name = hir_builder_impl_trait_at(gp, idx);
            if (super_name.len == 0) { break; }
            rows = rows + item_name + ">" + super_name + ";";
            idx = idx + 1;
        }
        self.unit.set_interface_supers(rows);
    }

    fn apply_function_codegen_attr_flags(self, d: rawptr, fn_id: i32) {
        if (d == null || fn_id == hir_id_invalid()) { return; }
        if (hir_builder_decl_has_exact_attr(d, "inline")) {
            self.unit.add_function_flags(fn_id, hir_function_flag_inline_hint());
        }
        if (hir_builder_decl_has_exact_attr(d, "noinline")) {
            self.unit.add_function_flags(fn_id, hir_function_flag_noinline());
        }
        if (hir_builder_decl_has_exact_attr(d, "cold")) {
            self.unit.add_function_flags(fn_id, hir_function_flag_cold());
        }
        if (hir_builder_decl_has_exact_attr(d, "hot")) {
            self.unit.add_function_flags(fn_id, hir_function_flag_hot());
        }
        var exported = false;
        if (hir_builder_decl_has_exact_attr(d, "no_mangle")) {
            self.unit.add_function_flags(fn_id, hir_function_flag_no_mangle());
            exported = true;
        }
        if (hir_builder_decl_has_exact_attr(d, "export")
            || hir_builder_string_contains(decl_get_meta(d), "|marker:export")) {
            self.unit.add_function_flags(fn_id, hir_function_flag_no_mangle());
            exported = true;
        }
        // `dci_export` is an Effect-owned ABI export request.  Sema stamps
        // the declaration tree only after validating the handler and its
        // arguments; consuming that compiler-owned marker here gives the
        // request a concrete AOT boundary without treating the raw attribute
        // spelling as authorization.  DCI exports must be externally
        // addressable and reachable even when no Vyx call edge keeps them
        // alive, exactly like an ordinary C ABI export.
        if (hir_builder_string_contains(decl_get_meta(d), "|effect:dci_export|")) {
            self.unit.add_function_flags(fn_id, hir_function_flag_no_mangle());
            exported = true;
        }
        var c_symbol = hir_builder_strip_c_symbol_name(hir_builder_decl_attr_value(d, "link_name"));
        if (c_symbol.len == 0) {
            c_symbol = hir_builder_strip_c_symbol_name(hir_builder_decl_attr_value(d, "export_name"));
        }
        if (c_symbol.len == 0
            && hir_builder_string_contains(decl_get_meta(d), "|effect:dci_export|")) {
            // `symbol="..."` is the DCI export sidecar's declared external
            // name.  Carry the same validated value into the native symbol
            // discriminator so the artifact and the emitted AOT symbol do
            // not diverge.
            c_symbol = hir_builder_strip_c_symbol_name(
                hir_builder_decl_attr_value(d, "dci_export"));
        }
        if (c_symbol.len > 0) {
            self.unit.add_function_flags(fn_id, hir_function_flag_no_mangle());
            exported = true;
            let existing = self.unit.function_symbol_discriminator(fn_id);
            var disc = "csym:" + c_symbol;
            if (existing.len > 0 && !existing.startsWith("csym:")) {
                disc = disc + "|" + existing;
            }
            self.unit.set_function_symbol_discriminator(fn_id, disc);
        }
        if (exported && decl_get_body(d) != null) {
            self.unit.add_function_flags(fn_id, hir_function_flag_codegen_root());
        }
        // MOSP's `retain` effect is a real reachability contract.  Sema has
        // already validated the handler schema and argument policy; carrying
        // the compiler-owned authorization marker into HIR turns the result into
        // a code-generation root.  This is the lowering boundary that prevents
        // drop-aware DCE from discarding an otherwise uncalled function.
        if (hir_builder_string_contains(decl_get_meta(d), "|effect:retain|")
            && decl_get_body(d) != null) {
            self.unit.add_function_flags(fn_id, hir_function_flag_codegen_root());
        }
        if (hir_builder_decl_has_exact_attr(d, "cuda_kernel")) {
            self.unit.add_function_flags(fn_id, hir_function_flag_cuda_kernel());
        }
        if (hir_builder_decl_has_c_varargs(d)) {
            self.unit.add_function_flags(fn_id, hir_function_flag_c_varargs());
        }
    }

    fn register_decl(self, d: rawptr, owner_item_id: i32) -> i32 {
        if (d == null) { return hir_id_invalid(); }
        if (decl_get_kind(d) == de_EFFECT()) { return hir_id_invalid(); }
        let existing = hir_pointer_map_item(self.decl_map,d);
        if (existing != hir_id_invalid()) { return existing; }
        let item_kind = hir_builder_item_kind_from_decl(d);
        var item_name = decl_get_name(d);
        var type_id = self.type_id_from_ref(decl_get_ty(d));
        if (decl_get_kind(d) == de_CLASS() || decl_get_kind(d) == de_ENUM()) {
            let spec_args = hir_builder_decl_concrete_spec_args(d);
            if (spec_args.len > 0) {
                if (policy_generic_call_has_args(item_name.clone()) == 0) {
                    item_name = item_name + "::<" + spec_args + ">";
                }
                type_id = self.type_id_from_text(item_name);
            } else if (type_id == hir_id_invalid()) {
                type_id = self.type_id_from_text(item_name);
            }
            if (hir_builder_decl_is_value_type_record(d)) {
                self.unit.types.add_flags(type_id, hir_type_flag_value_struct());
            }
            if (hir_builder_decl_is_foreign_dci(d)) {
                self.unit.types.add_flags(type_id, hir_type_flag_foreign_dci());
            }
            if (hir_builder_decl_has_repr_c(d) || hir_builder_decl_is_packed(d)) {
                self.unit.types.add_flags(type_id, hir_type_flag_repr_c());
            }
            if (hir_builder_decl_is_packed(d)) {
                self.unit.types.add_flags(type_id, hir_type_flag_repr_packed());
            }
            let repr_align = hir_builder_decl_repr_align(d);
            if (repr_align > 0) {
                self.unit.types.add_flags(type_id, hir_type_flag_repr_align(repr_align as i32));
            }
        }
        if (decl_get_kind(d) == de_FN()
            || decl_get_kind(d) == de_METHOD()
            || decl_get_kind(d) == de_EXTERN_FN()) {
            type_id = self.canonical_function_return_type_id(d);
        }
        let item_id = self.unit.add_item(item_kind, item_name, type_id, owner_item_id);
        if (hir_builder_decl_is_foreign_dci(d)) {
            self.unit.add_item_flags(item_id, hir_item_flag_foreign_dci());
        }
        if (decl_get_kind(d) == de_CLASS()) {
            self.append_interface_super_edges_for_decl(d, item_name);
        }
        var fn_id = hir_id_invalid();
        if (decl_get_kind(d) == de_FN()
            || decl_get_kind(d) == de_METHOD()
            || decl_get_kind(d) == de_EXTERN_FN()) {
            var ret_type = type_id;
            if (ret_type == hir_id_invalid()) {
                ret_type = self.unit.types.intern_type_ref(null);
            }
            fn_id = self.unit.add_function(item_id, decl_get_name(d), ret_type);
            if (self.decl_is_foreign_import(d)) {
                self.unit.add_function_flags(fn_id, hir_function_flag_imported_body());
            }
            if (hir_builder_decl_is_task_callable(d)) {
                self.unit.add_function_flags(fn_id, hir_function_flag_async_task());
            }
            if (hir_builder_decl_is_foreign_dci_native(d)) {
                self.unit.add_function_flags(fn_id,
                                            hir_function_flag_foreign_dci()
                                            | hir_function_flag_declaration_only());
                if (hir_builder_decl_is_foreign_dci_ctor(d)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_ctor());
                }
                if (hir_builder_decl_is_foreign_dci_dtor(d)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_dtor());
                }
                if (hir_builder_decl_is_foreign_dci_const_method(d)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_const_method());
                }
                if (hir_builder_decl_is_foreign_dci_virtual_method(d)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_virtual_method());
                }
                if (hir_builder_decl_is_foreign_dci_override_method(d)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_override_method());
                }
                if (hir_builder_decl_is_foreign_dci_final_method(d)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_final_method());
                }
            }
            if (hir_builder_decl_is_foreign_dci(d)) {
                if (hir_builder_decl_is_foreign_dci_virtual_method(d)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_virtual_method());
                }
                if (hir_builder_decl_is_foreign_dci_override_method(d)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_override_method());
                }
                if (hir_builder_decl_is_foreign_dci_final_method(d)) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_final_method());
                }
            }
            let raw_owner_decl = hir_raw_owner_map_get(self.decl_owner_map,d);
            self.unit.set_function_symbol_discriminator(fn_id,
                hir_builder_decl_symbol_discriminator(d, raw_owner_decl));
            self.apply_function_codegen_attr_flags(d, fn_id);
            // A *generic* stub class is not a stub class at declaration level:
            // its base is only known once the class closes, and its overrides
            // keep the class's open parameters here (`consume(x: T) -> T`).
            // Marking them `codegen_root` at this point makes a function that
            // `hir_verify` must treat as closed while carrying an open `T`.
            // The closed override is materialized per instance instead
            // (`record_dci_stub_class_instance`).
            if (raw_owner_decl != null
                && hir_builder_decl_template_params(raw_owner_decl).len == 0
                && self.class_decl_requires_dci_stub(raw_owner_decl, 0)) {
                if (hir_builder_decl_has_marker(d, "virtual")) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_virtual_method());
                }
                if (hir_builder_decl_has_marker(d, "override")) {
                    self.unit.add_function_flags(fn_id,
                                                hir_function_flag_foreign_dci_override_method()
                                                | hir_function_flag_codegen_root());
                }
                if (hir_builder_decl_has_marker(d, "final")) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_foreign_dci_final_method());
                }
            }
            if (item_kind == hir_item_method() && owner_item_id != hir_id_invalid()) {
                self.add_function_param_locals_with_owner(fn_id, d, self.unit.item_name(owner_item_id));
            } else {
                self.add_function_param_locals(fn_id, d);
            }
        }
        var target_kind = hir_target_item();
        if (item_kind == hir_item_function()
            || item_kind == hir_item_method()
            || item_kind == hir_item_extern_function()) {
            target_kind = hir_target_function();
        } else if (item_kind == hir_item_field()) {
            target_kind = hir_target_field();
        } else if (item_kind == hir_item_variant()) {
            target_kind = hir_target_variant();
        }
        self.decl_map = hir_pointer_map_put(self.decl_map,d, item_id, fn_id, target_kind);
        self.index_registered_type_atom(item_kind, item_name);
        self.index_raw_class_decl(d, item_name);
        self.index_method_function(item_kind, owner_item_id, item_name, fn_id);
        self.index_free_function(item_kind, item_name, fn_id);
        self.index_value_item(item_kind, item_name, item_id);
        self.index_field_item(item_kind, owner_item_id, item_name, item_id, d);
        if (fn_id != hir_id_invalid()) {
            self.ensure_async_runtime_methods_for_task_return(fn_id);
        }
        if (item_kind == hir_item_variant()) {
            self.set_variant_payload_metadata(item_id, d, "", "");
        }
        if (item_kind == hir_item_const() || item_kind == hir_item_global()) {
            self.build_value_item_init_for_env(d, item_id, "", "");
        }
        if (decl_get_kind(d) == de_CLASS() || decl_get_kind(d) == de_ENUM()) {
            var first = hir_id_invalid();
            var last = hir_id_invalid();
            if (decl_get_kind(d) == de_CLASS()) {
                var parent_i: i32 = 0;
                while (parent_i < 16) {
                    let parent_decl = self.class_nth_layout_parent(d, parent_i);
                    if (parent_decl == null) { break; }
                    let parent_field_count = self.count_class_fields(parent_decl);
                    var parent_field_index: i32 = 0;
                    while (parent_field_index < parent_field_count) {
                        let inherited_field = self.class_layout_field_at(parent_decl, parent_field_index);
                        if (inherited_field != null && hir_builder_decl_is_layout_field(inherited_field)) {
                            let inherited_item = self.unit.add_item(hir_item_field(),
                                                                   decl_get_name(inherited_field),
                                                                   self.type_id_from_ref(decl_get_ty(inherited_field)),
                                                                   item_id);
                            self.index_field_item(hir_item_field(),
                                                  item_id,
                                                  decl_get_name(inherited_field),
                                                  inherited_item,
                                                  inherited_field);
                            if (first == hir_id_invalid()) { first = inherited_item; }
                            if (last != hir_id_invalid()) {
                                self.unit.set_item_next_sibling(last, inherited_item);
                            }
                            last = inherited_item;
                        }
                        parent_field_index = parent_field_index + 1;
                    }
                    parent_i = parent_i + 1;
                }
            }
            // `impl` blocks parse as de_CLASS decls whose members are spliced
            // into the target class's member chain by sema; walking that chain
            // with the impl decl as owner would mislabel every class member
            // (the impl decl is not a template head), breaking generic field
            // instance resolution. Register without claiming ownership.
            var member_owner_decl = d;
            if (hir_builder_string_contains(decl_get_generic_params(d), "|kind:impl")) {
                member_owner_decl = null;
            }
            let own_first = self.register_decl_chain_with_owner(decl_get_members(d), item_id, member_owner_decl);
            if (first == hir_id_invalid()) {
                first = own_first;
            } else if (last != hir_id_invalid() && own_first != hir_id_invalid()) {
                self.unit.set_item_next_sibling(last, own_first);
            }
            self.unit.set_item_first_member(item_id, first);
            self.assign_member_ordinals(item_id);
            // Mark fields of template-head classes so the verifier can reject
            // template-field bindings reached from closed generic contexts.
            // Impl-block decls are never template heads, so the shared spliced
            // member chain is only flagged once, by the real class decl.
            if (hir_builder_decl_template_head(d)) {
                var template_member = first;
                while (template_member != hir_id_invalid()) {
                    if (self.unit.item_kind(template_member) == hir_item_field()) {
                        self.unit.add_item_flags(template_member,
                                                hir_item_flag_template_member());
                    }
                    template_member = self.unit.item_next_sibling(template_member);
                }
                // Register the template params themselves as structurally
                // open type atoms (covers multi-character params that the
                // single-uppercase-letter text heuristic cannot see).
                let template_params = hir_builder_decl_template_params(d);
                var template_param_index: i32 = 0;
                while (template_param_index < 256) {
                    let template_param = hir_builder_generic_param_at(template_params, template_param_index);
                    if (template_param.len == 0) { break; }
                    let template_param_type = self.type_id_from_text(template_param);
                    if (template_param_type != hir_id_invalid()) {
                        self.unit.types.add_flags(template_param_type, hir_type_flag_open());
                    }
                    template_param_index = template_param_index + 1;
                }
            }
        } else if (decl_get_kind(d) == de_EXTERN_FN() && decl_get_members(d) != null) {
            self.register_decl_chain_with_owner(decl_get_members(d), hir_id_invalid(), null);
        }
        return item_id;
    }

    fn refresh_param_drop_metadata_for_decl_chain(self, head: rawptr, owner_template: bool) {
        var cur = head;
        while (cur != null) {
            let k = decl_get_kind(cur);
            if (k == de_FN() || k == de_METHOD() || k == de_EXTERN_FN()) {
                if (!owner_template && !hir_builder_decl_template_head(cur)) {
                    self.refresh_function_param_drop_metadata(hir_pointer_map_function(self.decl_map,cur), cur);
                }
            } else if (k == de_CLASS() || k == de_ENUM()) {
                let templ = owner_template
                    || hir_builder_decl_template_head(cur)
                    || self.decl_members_have_template_type(cur);
                self.refresh_param_drop_metadata_for_decl_chain(decl_get_members(cur), templ);
            }
            cur = decl_get_next(cur);
        }
    }

    fn decl_matches_function_param_locals(self, d: rawptr, fn_id: i32) -> bool {
        if (d == null || fn_id == hir_id_invalid()) { return false; }
        var param = decl_get_params(d);
        var local_id = self.unit.function_first_local(fn_id);
        if (local_id != hir_id_invalid()
            && self.local_is_constructor_abi_self(fn_id, local_id)
            && (param == null || decl_get_name(param) != "self")) {
            local_id = self.unit.local_next(local_id);
        }
        while (param != null) {
            while (local_id != hir_id_invalid()
                && (self.unit.local_flags(local_id) & hir_local_flag_param()) == 0) {
                local_id = self.unit.local_next(local_id);
            }
            if (local_id == hir_id_invalid()) { return false; }
            let param_name = decl_get_name(param);
            if (param_name.len > 0 && self.unit.local_name(local_id) != param_name) { return false; }
            let param_type = self.type_id_from_ref(decl_get_ty(param));
            let local_type = self.unit.local_type(local_id);
            if (self.type_id_is_valid(param_type) && self.type_id_is_valid(local_type)) {
                let param_text = hir_type_table_text(self.unit.types, param_type);
                let local_text = hir_type_table_text(self.unit.types, local_type);
                if (param_text != local_text && !policy_type_name_equal(param_text, local_text)) {
                    return false;
                }
            }
            param = decl_get_next(param);
            local_id = self.unit.local_next(local_id);
        }
        while (local_id != hir_id_invalid()) {
            if ((self.unit.local_flags(local_id) & hir_local_flag_param()) != 0
                && !self.local_is_constructor_abi_self(fn_id, local_id)) {
                return false;
            }
            local_id = self.unit.local_next(local_id);
        }
        return true;
    }

    fn function_body_source_decl(self, d: rawptr, fn_id: i32) -> rawptr {
        if (fn_id == hir_id_invalid()) { return null; }
        // A closed instance keeps its template declaration in the reverse
        // instance map.  Its local types have already substituted that
        // template's parameters, so comparing those locals to the raw
        // declaration (`ptr<A>` versus `ptr<T>`) is not a valid provenance
        // test.  The reverse map is keyed by the concrete function id and is
        // therefore the authoritative source for an instance body.
        let instance_decl = self.function_instances.decl_for_function(fn_id);
        if (instance_decl != null) {
            let instance_body = self.raw_function_body_decl_for(instance_decl);
            if (instance_body != null) { return instance_body; }
            var owner_type = hir_unit_function_owner_type(self.unit, fn_id);
            if (owner_type.len == 0) {
                let env_params = hir_unit_function_generic_params(self.unit, fn_id);
                let env_args = hir_unit_function_generic_args(self.unit, fn_id);
                if (hir_builder_generic_param_at(env_params, 0) == "Self") {
                    owner_type = policy_generic_arg_at(env_args, 0);
                }
            }
            if (owner_type.len > 0) {
                let impl_body = self.concrete_impl_method_decl(decl_get_name(instance_decl), owner_type);
                if (impl_body != null) { return impl_body; }
            }
            let env_body = self.raw_function_body_decl_for_env(
                instance_decl,
                hir_unit_function_generic_params(self.unit, fn_id),
                hir_unit_function_generic_args(self.unit, fn_id));
            if (env_body != null) { return env_body; }
        }
        // A caller-supplied declaration can be a stale overload/interface
        // target, so only accept it after checking its local signature.
        if (d != null && self.decl_matches_function_param_locals(d, fn_id)) {
            let direct_body = self.raw_function_body_decl_for(d);
            if (direct_body != null) { return direct_body; }
        }
        let mapped_decl = hir_pointer_map_raw_for_function(self.decl_map,fn_id);
        // `decl_map` is keyed by the exact HIR function id.  Unlike an
        // incoming semantic target it is not an overload guess, so it stays
        // authoritative even when a lazily-created method has not populated
        // every parameter-local record yet.  Requiring that transient local
        // shape here made valid compiler-internal methods look declaration
        // only to both MIR consumers and left dangling native symbols.
        if (mapped_decl != null) {
            let mapped_body = self.raw_function_body_decl_for(mapped_decl);
            if (mapped_body != null) { return mapped_body; }
        }
        return null;
    }

    fn function_body_is_scheduled(self, fn_id: i32) -> bool {
        if (fn_id == hir_id_invalid()) { return false; }
        return hir_int_id_map_get(self.scheduled_function_ids,fn_id) == 1;
    }

    fn function_body_request_is_closed(self, fn_id: i32) -> bool {
        if (fn_id == hir_id_invalid()) { return true; }
        if (self.unit.function_body(fn_id) != hir_id_invalid()) { return true; }
        return hir_int_id_map_get(self.scheduled_function_ids,fn_id) == 2;
    }

    fn function_body_codegen_is_done(self, fn_id: i32) -> bool {
        if (fn_id == hir_id_invalid()) { return true; }
        return hir_int_id_map_get(self.codegen_body_done_ids,fn_id) == 1;
    }

    public fn mark_function_body_codegen_done(self, fn_id: i32) {
        if (fn_id == hir_id_invalid()) { return; }
        self.codegen_body_done_ids = hir_int_id_map_put(self.codegen_body_done_ids,fn_id, 1);
        self.scheduled_function_ids = hir_int_id_map_put(self.scheduled_function_ids,fn_id, 2);
    }

    fn close_function_body_request(self, fn_id: i32) {
        if (fn_id == hir_id_invalid()) { return; }
        if (self.unit.function_body(fn_id) != hir_id_invalid()) {
            self.scheduled_function_ids = hir_int_id_map_put(self.scheduled_function_ids,fn_id, 0);
            return;
        }
        self.scheduled_function_ids = hir_int_id_map_put(self.scheduled_function_ids,fn_id, 2);
    }

    fn schedule_reachable_function_body(self, d: rawptr, fn_id: i32, owner_template: bool) {
        if (d == null || fn_id == hir_id_invalid()) { return; }
        if (self.function_body_codegen_is_done(fn_id)) { return; }
        if (self.unit.function_body(fn_id) != hir_id_invalid()) { return; }
        if (self.function_body_is_scheduled(fn_id) || self.function_body_request_is_closed(fn_id)) { return; }
        let body_decl = self.raw_function_body_decl_for(d);
        if (self.decl_effectively_imported(d) || self.decl_effectively_imported(body_decl)) {
            if (!self.imported_body_should_materialize(d, body_decl)) {
                self.unit.add_function_flags(fn_id, hir_function_flag_declaration_only());
                self.close_function_body_request(fn_id);
                return;
            }
        }
        self.scheduled_body_count = self.scheduled_body_count + 1;
        if (vyx_bootstrap_profile_level() > 0
            && (self.scheduled_body_count <= 24
                || (self.scheduled_body_count % 128) == 0)) {
            print("[hir-schedule] count=" + policy_i64_to_string(self.scheduled_body_count)
                  + " fn=" + self.i32_text(fn_id)
                  + " name=" + self.unit.function_name(fn_id)
                  + " raw=" + decl_get_name(d));
        }
        let node = hir_profile_malloc(32);
        if (node == null) { return; }
        memset(node, 0, 32);
        ast_write_rawptr(node, d);
        ast_write_i32(ptr_offset(node, 8), fn_id);
        if (owner_template) {
            ast_write_i32(ptr_offset(node, 12), 1);
        } else {
            ast_write_i32(ptr_offset(node, 12), 0);
        }
        ast_write_rawptr(ptr_offset(node, 16), null);
        if (self.reachable_body_queue_tail != null) {
            ast_write_rawptr(ptr_offset(self.reachable_body_queue_tail, 16), node);
        } else {
            self.reachable_body_queue_head = node;
        }
        self.reachable_body_queue_tail = node;
        self.scheduled_function_ids = hir_int_id_map_put(self.scheduled_function_ids,fn_id, 1);
    }

    fn ensure_reachable_function_body(self, d: rawptr, fn_id: i32, owner_template: bool) {
        self.schedule_reachable_function_body(d, fn_id, owner_template);
    }

    fn build_reachable_function_body_now(self, d: rawptr, fn_id: i32, owner_template: bool) {
        if (d == null || fn_id == hir_id_invalid()) { return; }
        if (self.unit.function_body(fn_id) != hir_id_invalid()) { return; }
        // Resolve the concrete source before the instance branch. A call can
        // retain an interface/prototype semantic declaration while targeting
        // a closed concrete method instance; passing that erased declaration
        // into build_function_instance_body_if_ready leaves the instance
        // bodyless and produces a dangling LLVM declaration.
        // A `@[discard]` tombstone is a removal notice, not a definition —
        // terminate BEFORE resolving the body source. `function_body_source_decl`
        // only returns declarations that can provide a body, so for a tombstone
        // it returns null and the early return below would leave the request
        // retryable forever (the spurious-I0100 machine).
        if (hir_builder_decl_is_discarded(d)) {
            self.unit.add_function_flags(fn_id, hir_function_flag_declaration_only());
            self.close_function_body_request(fn_id);
            return;
        }
        let body_decl = self.function_body_source_decl(d, fn_id);
        if (body_decl == null) { return; }
        // A `@[discard]`-ed symbol is a removal notice, not a definition: it
        // owns no body *by design* (see `hir_builder_decl_is_discarded`).
        // Publish that terminal decision here — BEFORE the instance/env
        // branch below — because a tombstone can never own a body in any
        // instantiation. A cross-version method reference (a ctor calling a
        // method that only the previous version defines) merges the class
        // versions and reaches this point with env params set, so a check
        // placed after the env branch would never run: MIR would defer the
        // tombstone round after round and finally manufacture a spurious
        // I0100 ("reachable function body was still unavailable") even though
        // nothing ever calls it.
        if (hir_builder_decl_is_discarded(d)
            || hir_builder_decl_is_discarded(body_decl)) {
            self.unit.add_function_flags(fn_id, hir_function_flag_declaration_only());
            self.close_function_body_request(fn_id);
            return;
        }
        let env_params = hir_unit_function_generic_params(self.unit, fn_id);
        let env_args = hir_unit_function_generic_args(self.unit, fn_id);
        if (env_params.len > 0 || env_args.len > 0) {
            self.build_function_instance_body_if_ready(body_decl,
                                                       fn_id,
                                                       self.unit.function_item(fn_id),
                                                       env_params,
                                                       env_args);
            return;
        }
        if (owner_template || hir_builder_decl_template_head(body_decl)) {
            // An unspecialized template never owns an executable body of its
            // own: closed instances are created on their own FunctionId and
            // take the env branch above.  Publish that terminal decision
            // instead of leaving the request retryable, otherwise MIR keeps
            // deferring the bodyless shell (a generic owner such as
            // `class Box<T>` leaves `hir_function_has_open_template_types`
            // false on the MIR side) until the streaming retry budget
            // manufactures a spurious I0100 at the first call site.
            self.unit.add_function_flags(fn_id, hir_function_flag_declaration_only());
            self.close_function_body_request(fn_id);
            return;
        }
        let raw_owner = hir_raw_owner_map_get(self.decl_owner_map,body_decl);
        if (raw_owner != null
            && hir_builder_decl_template_head(raw_owner)) {
            self.unit.add_function_flags(fn_id, hir_function_flag_declaration_only());
            self.close_function_body_request(fn_id);
            return;
        }
        // Safety net for any other body-less source declaration: it can never
        // acquire a body either, so an unresolved request here would only
        // resurface later as that same misleading I0100.
        if (decl_get_body(body_decl) == null && decl_get_body(d) == null) {
            self.unit.add_function_flags(fn_id, hir_function_flag_declaration_only());
            self.close_function_body_request(fn_id);
            return;
        }
        if (self.decl_effectively_imported(d) || self.decl_effectively_imported(body_decl)) {
            if (!self.imported_body_should_materialize(d, body_decl)) {
                self.unit.add_function_flags(fn_id, hir_function_flag_declaration_only());
                return;
            }
            self.build_function_body_core_for_function(body_decl, fn_id);
            return;
        }
        if (!hir_builder_body_resolved(body_decl)
            && !self.decl_body_types_close_in_current_env(body_decl)) {
            return;
        }
        self.build_function_body_core_for_function(body_decl, fn_id);
    }

    fn raw_function_target_for_call_expr(self, e: rawptr) -> rawptr {
        if (e == null) { return null; }
        if (expr_get_kind(e) != ex_CALL()) { return expr_get_semantic_target(e); }
        let callee = expr_get_lhs(e);
        if (callee != null && expr_get_kind(callee) == ex_MEMBER()) {
            return expr_get_semantic_target(callee);
        }
        var raw_target = expr_get_semantic_target(e);
        if (raw_target == null && callee != null) {
            raw_target = expr_get_semantic_target(callee);
        }
        return raw_target;
    }

    fn ensure_reachable_function_body_for_expr(self, e: rawptr, fn_id: i32) {
        if (e == null || fn_id == hir_id_invalid()) { return; }
        self.ensure_reachable_function_body(self.raw_function_target_for_call_expr(e), fn_id, false);
    }

    fn build_function_body_core_for_function(self, d: rawptr, fn_id: i32) {
        if (d == null || fn_id == hir_id_invalid()) { return; }
        if (self.unit.function_body(fn_id) != hir_id_invalid()) { return; }
        if (self.body_building(fn_id)) { return; }
        if (self.function_has_open_template_types(fn_id)) { return; }
        let saved_function = self.current_function_id;
        let saved_item = self.current_item_id;
        let saved_locals = self.locals.head;
        let saved_params = self.current_generic_params;
        let saved_args = self.current_generic_args;
        let saved_pack_bindings = self.pack_bindings.head;
        let saved_body_building = self.body_building_head;
        let saved_call_callee_ast = self.current_call_callee_ast;
        let timing_enabled = hir_builder_env_enabled("VYX_HIR_BODY_TIMING");
        var timing_total_start: i64 = 0;
        var timing_last: i64 = 0;
        var timing_refresh_ms: i64 = 0;
        var timing_bind_ms: i64 = 0;
        var timing_ready_ms: i64 = 0;
        var timing_stmts_ms: i64 = 0;
        var timing_finish_ms: i64 = 0;
        let timing_local_start = self.unit.local_count;
        let timing_stmt_start = self.unit.stmt_count;
        let timing_expr_start = self.unit.expr_count;
        let timing_type_open_start = self.profile_type_open_calls;
        let timing_resolve_start = self.profile_resolve_type_calls;
        let timing_raw_class_start = self.profile_raw_class_calls;
        let timing_ensure_method_start = self.profile_ensure_method_calls;
        let timing_method_target_start = self.profile_method_target_calls;
        let timing_field_start = self.profile_field_lookup_calls;
        let timing_fnopen_start = self.profile_function_open_calls;
        let timing_typeref_start = self.profile_type_id_ref_calls;
        let timing_concrete_start = self.profile_concrete_type_ref_calls;
        let timing_typetext_start = self.profile_type_id_text_calls;
        let timing_ms_resolve_start = self.profile_ms_resolve_type;
        let timing_ms_raw_class_start = self.profile_ms_raw_class;
        let timing_ms_raw_method_start = self.profile_ms_raw_method_call;
        let timing_ms_member_start = self.profile_ms_resolve_member;
        let timing_ms_call_start = self.profile_ms_resolve_call;
        if (timing_enabled) {
            timing_total_start = vyx_bootstrap_now_ms();
            timing_last = timing_total_start;
        }
        self.push_body_building(d, fn_id);
        self.profile_body_phase("enter", d, fn_id);
        self.current_generic_params = hir_unit_function_generic_params(self.unit, fn_id);
        self.current_generic_args = hir_unit_function_generic_args(self.unit, fn_id);
        self.current_function_id = fn_id;
        self.current_item_id = self.unit.function_item(fn_id);
        self.current_call_callee_ast = null;
        self.locals = hir_local_scope_restore(self.locals, null);
        self.pack_bindings = hir_pack_bindings_restore(self.pack_bindings, null);
        self.profile_body_phase("before-refresh", d, fn_id);
        self.refresh_function_param_drop_metadata(fn_id, d);
        if (timing_enabled) {
            let now_refresh = vyx_bootstrap_now_ms();
            timing_refresh_ms = now_refresh - timing_last;
            timing_last = now_refresh;
        }
        self.profile_body_phase("after-refresh", d, fn_id);
        self.bind_function_param_scope(fn_id, d);
        if (timing_enabled) {
            let now_bind = vyx_bootstrap_now_ms();
            timing_bind_ms = now_bind - timing_last;
            timing_last = now_bind;
        }
        self.profile_body_phase("after-bind-params", d, fn_id);
        if (timing_enabled) {
            let now_ready = vyx_bootstrap_now_ms();
            timing_ready_ms = now_ready - timing_last;
            timing_last = now_ready;
        }
        self.profile_body_phase("before-stmts", d, fn_id);
        let body_chain = self.build_stmt_chain(decl_get_body(d));
        if (timing_enabled) {
            let now_stmts = vyx_bootstrap_now_ms();
            timing_stmts_ms = now_stmts - timing_last;
            timing_last = now_stmts;
        }
        self.profile_body_phase("after-stmts", d, fn_id);
        self.unit.set_function_body(fn_id, body_chain.first, body_chain.count);
        self.locals = hir_local_scope_drop_to(self.locals, saved_locals);
        self.pack_bindings = hir_pack_bindings_drop_to(self.pack_bindings, saved_pack_bindings);
        self.current_generic_params = saved_params;
        self.current_generic_args = saved_args;
        self.current_item_id = saved_item;
        self.current_function_id = saved_function;
        self.current_call_callee_ast = saved_call_callee_ast;
        self.body_building_head = saved_body_building;
        if (timing_enabled) {
            let now_finish = vyx_bootstrap_now_ms();
            timing_finish_ms = now_finish - timing_last;
            let timing_total = now_finish - timing_total_start;
            if (timing_total >= hir_builder_slow_body_threshold_ms()) {
                print("[hir-body-timing] fn=" + self.unit.function_name(fn_id)
                      + " id=" + self.i32_text(fn_id)
                      + " total=" + policy_i64_to_string(timing_total)
                      + " refresh=" + policy_i64_to_string(timing_refresh_ms)
                      + " bind=" + policy_i64_to_string(timing_bind_ms)
                      + " ready=" + policy_i64_to_string(timing_ready_ms)
                      + " stmts=" + policy_i64_to_string(timing_stmts_ms)
                      + " finish=" + policy_i64_to_string(timing_finish_ms)
                      + " body_stmts=" + self.i32_text(body_chain.count)
                      + " locals_delta=" + self.i32_text(self.unit.local_count - timing_local_start)
                      + " stmts_delta=" + self.i32_text(self.unit.stmt_count - timing_stmt_start)
                      + " exprs_delta=" + self.i32_text(self.unit.expr_count - timing_expr_start)
                      + " open_delta=" + policy_i64_to_string(self.profile_type_open_calls - timing_type_open_start)
                      + " resolve_delta=" + policy_i64_to_string(self.profile_resolve_type_calls - timing_resolve_start)
                      + " rawclass_delta=" + policy_i64_to_string(self.profile_raw_class_calls - timing_raw_class_start)
                      + " ensuremeth_delta=" + policy_i64_to_string(self.profile_ensure_method_calls - timing_ensure_method_start)
                      + " methodtarget_delta=" + policy_i64_to_string(self.profile_method_target_calls - timing_method_target_start)
                      + " field_delta=" + policy_i64_to_string(self.profile_field_lookup_calls - timing_field_start)
                      + " fnopen_delta=" + policy_i64_to_string(self.profile_function_open_calls - timing_fnopen_start)
                      + " typeref_delta=" + policy_i64_to_string(self.profile_type_id_ref_calls - timing_typeref_start)
                      + " concrete_delta=" + policy_i64_to_string(self.profile_concrete_type_ref_calls - timing_concrete_start)
                      + " typetext_delta=" + policy_i64_to_string(self.profile_type_id_text_calls - timing_typetext_start)
                      + " ms_resolve=" + policy_i64_to_string(self.profile_ms_resolve_type - timing_ms_resolve_start)
                      + " ms_rawclass=" + policy_i64_to_string(self.profile_ms_raw_class - timing_ms_raw_class_start)
                      + " ms_rawmethod=" + policy_i64_to_string(self.profile_ms_raw_method_call - timing_ms_raw_method_start)
                      + " ms_member=" + policy_i64_to_string(self.profile_ms_resolve_member - timing_ms_member_start)
                      + " ms_call=" + policy_i64_to_string(self.profile_ms_resolve_call - timing_ms_call_start));
            }
        }
        self.profile_body_phase("leave", d, fn_id);
    }

    fn build_function_body_core(self, d: rawptr) {
        let fn_id = hir_pointer_map_function(self.decl_map,d);
        self.build_function_body_core_for_function(d, fn_id);
    }

    fn build_function_body(self, d: rawptr, owner_template: bool) {
        if (d == null) { return; }
        if (self.decl_effectively_imported(d)) { return; }
        if (owner_template || hir_builder_decl_template_head(d)) { return; }
        let raw_owner = hir_raw_owner_map_get(self.decl_owner_map,d);
        if (raw_owner != null
            && hir_builder_decl_template_head(raw_owner)) {
            return;
        }
        if (decl_get_body(d) == null) { return; }
        if (!hir_builder_body_resolved(d)
            && !self.decl_body_types_close_in_current_env(d)) {
            return;
        }
        self.build_function_body_core(d);
    }

    fn build_imported_function_body_if_reachable(self, d: rawptr, owner_template: bool) {
        if (d == null) { return; }
        let body_decl = self.raw_function_body_decl_for(d);
        if (body_decl == null) { return; }
        if (!self.decl_effectively_imported(d) && !self.decl_effectively_imported(body_decl)) { return; }
        if (!self.imported_body_should_materialize(d, body_decl)) { return; }
        if (owner_template || hir_builder_decl_template_head(body_decl)) { return; }
        let raw_owner = hir_raw_owner_map_get(self.decl_owner_map,body_decl);
        if (raw_owner != null
            && hir_builder_decl_template_head(raw_owner)) {
            return;
        }
        self.build_function_body_core_for_function(body_decl, hir_pointer_map_function(self.decl_map,d));
    }

    fn build_bodies_for_decl_chain(self, head: rawptr, owner_template: bool) {
        var cur = head;
        while (cur != null) {
            if (self.decl_effectively_imported(cur)) {
                cur = decl_get_next(cur);
                continue;
            }
            let k = decl_get_kind(cur);
            if (k == de_FN() || k == de_METHOD()) {
                self.build_function_body(cur, owner_template);
            } else if (k == de_CLASS() || k == de_ENUM()) {
                let templ = owner_template
                    || hir_builder_decl_template_head(cur)
                    || self.decl_members_have_template_type(cur);
                self.build_bodies_for_decl_chain(decl_get_members(cur), templ);
            } else if (k == de_CONST() || k == de_GLOBAL_VAR() || hir_builder_decl_is_assoc_const_member(cur)) {
                let fn_id_saved = self.current_function_id;
                let item_id_saved = self.current_item_id;
                self.current_function_id = hir_id_invalid();
                self.current_item_id = hir_pointer_map_item(self.decl_map,cur);
                let init_chain = self.build_stmt_chain(decl_get_body(cur));
                self.unit.set_item_init(self.current_item_id, init_chain.first);
                self.current_item_id = item_id_saved;
                self.current_function_id = fn_id_saved;
            }
            cur = decl_get_next(cur);
        }
    }

    fn materialize_reachable_function_bodies_once(self) -> bool {
        let node = self.reachable_body_queue_head;
        if (node == null) { return false; }
        let next = ast_read_rawptr(ptr_offset(node, 16));
        self.reachable_body_queue_head = next;
        if (next == null) { self.reachable_body_queue_tail = null; }
        let d = ast_read_rawptr(node);
        let fn_id = ast_read_i32(ptr_offset(node, 8));
        let owner_template = ast_read_i32(ptr_offset(node, 12)) != 0;
        self.scheduled_function_ids = hir_int_id_map_put(self.scheduled_function_ids,fn_id, 0);
        free(node);
        if (fn_id == hir_id_invalid() || d == null) { return true; }
        self.materialized_body_count = self.materialized_body_count + 1;
        if (vyx_bootstrap_profile_level() > 0
            && (self.materialized_body_count <= 24
                || (self.materialized_body_count % 128) == 0)) {
            print("[hir-drain-body] before count=" + policy_i64_to_string(self.materialized_body_count)
                  + " fn=" + self.i32_text(fn_id)
                  + " name=" + self.unit.function_name(fn_id)
                  + " raw=" + decl_get_name(d));
        }
        self.build_reachable_function_body_now(d, fn_id, owner_template);
        if (vyx_bootstrap_profile_level() > 0
            && (self.materialized_body_count <= 24
                || (self.materialized_body_count % 128) == 0)) {
            print("[hir-drain-body] after count=" + policy_i64_to_string(self.materialized_body_count)
                  + " fn=" + self.i32_text(fn_id)
                  + " body=" + self.i32_text(self.unit.function_body(fn_id))
                  + " stmts=" + self.i32_text(self.unit.stmt_count)
                  + " exprs=" + self.i32_text(self.unit.expr_count));
        }
        if (self.unit.function_body(fn_id) != hir_id_invalid()) {
            self.close_function_body_request(fn_id);
        } else {
            // A missing body can be recoverable after a later nested instance
            // registration; keep the request retryable instead of terminal.
            self.scheduled_function_ids = hir_int_id_map_put(self.scheduled_function_ids,fn_id, 0);
        }
        return true;
    }

    fn materialize_reachable_function_bodies(self) {
        var drained = self.materialize_reachable_function_bodies_once();
        while (drained) {
            drained = self.materialize_reachable_function_bodies_once();
        }
    }

    fn remove_scheduled_function_body_request(self, fn_id: i32, build_body: bool) -> bool {
        if (fn_id == hir_id_invalid()) { return false; }
        var prev: rawptr = null;
        var node = self.reachable_body_queue_head;
        while (node != null) {
            let next = ast_read_rawptr(ptr_offset(node, 16));
            if (ast_read_i32(ptr_offset(node, 8)) == fn_id) {
                if (prev != null) {
                    ast_write_rawptr(ptr_offset(prev, 16), next);
                } else {
                    self.reachable_body_queue_head = next;
                }
                if (self.reachable_body_queue_tail == node) {
                    self.reachable_body_queue_tail = prev;
                }
                let d = ast_read_rawptr(node);
                let owner_template = ast_read_i32(ptr_offset(node, 12)) != 0;
                self.scheduled_function_ids = hir_int_id_map_put(self.scheduled_function_ids,fn_id, 0);
                free(node);
                if (!build_body) { return true; }
                if (d == null) { return false; }
                self.materialized_body_count = self.materialized_body_count + 1;
                if (vyx_bootstrap_profile_level() > 0
                    && (self.materialized_body_count <= 24
                        || (self.materialized_body_count % 128) == 0)) {
                    print("[hir-drain-body] before count=" + policy_i64_to_string(self.materialized_body_count)
                          + " fn=" + self.i32_text(fn_id)
                          + " name=" + self.unit.function_name(fn_id)
                          + " raw=" + decl_get_name(d));
                }
                self.build_reachable_function_body_now(d, fn_id, owner_template);
                if (vyx_bootstrap_profile_level() > 0
                    && (self.materialized_body_count <= 24
                        || (self.materialized_body_count % 128) == 0)) {
                    print("[hir-drain-body] after count=" + policy_i64_to_string(self.materialized_body_count)
                          + " fn=" + self.i32_text(fn_id)
                          + " body=" + self.i32_text(self.unit.function_body(fn_id))
                          + " stmts=" + self.i32_text(self.unit.stmt_count)
                          + " exprs=" + self.i32_text(self.unit.expr_count));
                }
                if (self.unit.function_body(fn_id) != hir_id_invalid()) {
                    self.close_function_body_request(fn_id);
                } else {
                    self.scheduled_function_ids = hir_int_id_map_put(self.scheduled_function_ids,fn_id, 0);
                }
                return self.unit.function_body(fn_id) != hir_id_invalid();
            }
            prev = node;
            node = next;
        }
        return false;
    }

    public fn materialize_function_body_for_codegen(self, fn_id: i32) -> bool {
        if (fn_id == hir_id_invalid()) { return false; }
        if (self.unit.function_body(fn_id) != hir_id_invalid()) { return true; }
        let raw_target = hir_pointer_map_raw_for_function(self.decl_map,fn_id);
        // A `@[discard]` tombstone must terminate here: it is a removal
        // notice, not a definition (see `hir_builder_decl_is_discarded`).
        // `function_body_source_decl` below only resolves declarations that
        // can *provide a body*, so for a tombstone it always returns null and
        // the fallback treats the gap as retryable — MIR then defers round
        // after round and finally fails with a spurious I0100 even though
        // nothing calls the symbol. Publishing `declaration_only` here makes
        // both streaming consumers treat it as a valid declaration contract.
        if (hir_builder_decl_is_discarded(raw_target)) {
            self.unit.add_function_flags(fn_id, hir_function_flag_declaration_only());
            self.close_function_body_request(fn_id);
            return false;
        }
        let source_decl = self.function_body_source_decl(raw_target, fn_id);
        if (source_decl != null) {
            // A codegen demand may arrive after the reachable queue consumed its
            // node. Remove any stale node, then materialize from the instance
            // reverse map rather than relying on decl_map alone.
            self.remove_scheduled_function_body_request(fn_id, false);
            self.scheduled_function_ids = hir_int_id_map_put(self.scheduled_function_ids,fn_id, 0);
            self.build_reachable_function_body_now(source_decl, fn_id, false);
            if (self.unit.function_body(fn_id) != hir_id_invalid()) { return true; }
        }
        // Missing provenance/body is retryable: a nested closed instance may be
        // registered later in the same HIR/MIR reachability walk. Do not mark it
        // terminal and silently emit a declaration-only generic function.
        self.remove_scheduled_function_body_request(fn_id, false);
        self.scheduled_function_ids = hir_int_id_map_put(self.scheduled_function_ids,fn_id, 0);
        return false;
    }

    /// Whether `materialize_function_body_for_codegen` could rebuild this
    /// function's body *after* the body has been released.  The rebuild path is
    /// exactly `function_body_source_decl`: a source declaration, or a closed
    /// instance's reverse provenance.  A lambda's synthesized `closure$N`
    /// function has neither -- its body was built inline from the enclosing
    /// expression and never had a declaration of its own -- so once its body is
    /// discarded nothing can bring it back.  Consumers that release a body for
    /// memory and rebuild it later must consult this first.
    public fn function_body_is_recoverable(self, fn_id: i32) -> bool {
        if (fn_id == hir_id_invalid()) { return false; }
        let raw_target = hir_pointer_map_raw_for_function(self.decl_map,fn_id);
        return self.function_body_source_decl(raw_target, fn_id) != null;
    }

    fn materialize_function_body_by_name(self, name: string) {
        let fn_id = self.function_id_for_name(name);
        if (fn_id == hir_id_invalid()) { return; }
        if (self.unit.function_body(fn_id) != hir_id_invalid()) { return; }
        let raw_target = hir_pointer_map_raw_for_function(self.decl_map,fn_id);
        self.ensure_reachable_function_body(raw_target, fn_id, false);
    }

    fn materialize_language_lowering_roots(self) {
        self.materialize_function_body_by_name("__vio_await_yield");
    }

    fn build_stmt_chain(self, head: rawptr) -> HirStmtChain {
        var out = HirStmtChain.empty();
        var cur = head;
        let timing_enabled = hir_builder_env_enabled("VYX_HIR_STMT_TIMING");
        let timing_threshold = hir_builder_slow_stmt_threshold_ms();
        while (cur != null) {
            var timing_start: i64 = 0;
            if (timing_enabled) { timing_start = vyx_bootstrap_now_ms(); }
            let stmt_id = self.build_stmt(cur);
            if (timing_enabled) {
                let timing_elapsed = vyx_bootstrap_now_ms() - timing_start;
                if (timing_elapsed >= timing_threshold) {
                    var fn_name = "";
                    if (self.current_function_id != hir_id_invalid()) {
                        fn_name = self.unit.function_name(self.current_function_id);
                    }
                    print("[hir-stmt-timing] fn=" + fn_name
                          + " elapsed=" + policy_i64_to_string(timing_elapsed)
                          + " kind=" + self.i32_text(stmt_get_kind(cur))
                          + " name=" + stmt_get_name(cur)
                          + " line=" + self.i32_text(stmt_loc_line(cur))
                          + " col=" + self.i32_text(stmt_loc_col(cur))
                          + " stmt_id=" + self.i32_text(stmt_id)
                          + " stmts=" + self.i32_text(self.unit.stmt_count)
                          + " exprs=" + self.i32_text(self.unit.expr_count));
                }
            }
            if (stmt_id != hir_id_invalid()) {
                if (out.first == hir_id_invalid()) {
                    out.first = stmt_id;
                }
                if (out.last != hir_id_invalid()) {
                    self.unit.set_stmt_next(out.last, stmt_id);
                }
                out.last = stmt_id;
                var next_count: i32 = out.count;
                next_count = next_count + 1;
                out.count = next_count;
            }
            cur = stmt_get_next(cur);
        }
        return out;
    }

    fn type_id_has_open_template_atom(self, type_id: i32) -> bool {
        if (!self.type_id_is_valid(type_id)) { return false; }
        return self.type_text_has_open_template_atom(hir_type_table_text(self.unit.types, type_id));
    }

    fn closed_expr_type_for_local(self, expr_id: i32) -> i32 {
        if (expr_id == hir_id_invalid()) { return hir_id_invalid(); }
        if (self.unit.expr_target_kind(expr_id) == hir_target_field()) {
            let field_id = self.unit.expr_target_id(expr_id);
            let field_type = self.unit.item_type(field_id);
            if (self.type_id_is_valid(field_type)
                && !self.type_id_has_open_template_atom(field_type)) {
                return field_type;
            }
        }
        if (self.unit.expr_kind(expr_id) == ex_CALL()) {
            let callee_expr_id = self.unit.expr_lhs(expr_id);
            if (callee_expr_id != hir_id_invalid()
                && self.unit.expr_kind(callee_expr_id) == ex_MEMBER()
                && self.method_name_is_value_assign(self.unit.expr_name(callee_expr_id))) {
                let direct_text = hir_type_table_text(self.unit.types, self.unit.expr_type(expr_id));
                if (direct_text.len == 0 || direct_text == "void") {
                    let receiver_expr_id = self.unit.expr_lhs(callee_expr_id);
                    let receiver_type = self.unit.expr_type(receiver_expr_id);
                    if (self.type_id_is_valid(receiver_type)
                        && !self.type_id_has_open_template_atom(receiver_type)) {
                        return receiver_type;
                    }
                }
            }
        }
        let direct_type = self.unit.expr_type(expr_id);
        if (self.type_id_is_valid(direct_type) && !self.type_id_has_open_template_atom(direct_type)) {
            return direct_type;
        }
        if (self.unit.expr_target_kind(expr_id) == hir_target_function()) {
            let fn_id = self.unit.expr_target_id(expr_id);
            let ret_type = self.unit.function_return_type(fn_id);
            if (self.type_id_is_valid(ret_type) && !self.type_id_has_open_template_atom(ret_type)) {
                return ret_type;
            }
        }
        return direct_type;
    }

    fn add_local_from_stmt(self, stmt_id: i32, s: rawptr, init_expr_id: i32) {
        let name = stmt_get_name(s);
        var type_id = self.type_id_from_ref(stmt_get_ty(s));
        // A generic body is built again for each closed instance.  Locals
        // declared as `T` must use that concrete type here; keeping the open
        // template atom suppresses ownership/drop metadata and leaks nested
        // owners such as Box<Ref<U>>.
        let declared_type = stmt_get_ty(s);
        if (declared_type != null) {
            let concrete_text = self.type_text_from_ref_env(declared_type,
                                                             self.current_generic_params,
                                                             self.current_generic_args);
            if (concrete_text.len > 0 && !self.type_text_has_open_template_atom(concrete_text)) {
                type_id = self.type_id_from_text(concrete_text);
            }
        }
        if (init_expr_id != hir_id_invalid()) {
            let init_type = self.closed_expr_type_for_local(init_expr_id);
            if (type_id == hir_id_invalid()) {
                type_id = init_type;
            } else if (init_type != hir_id_invalid()
                       && self.unit.expr_sem_kind(init_expr_id) == expr_sem_BUILTIN()) {
                // A builtin whose recorded type is still void (e.g. a pointer
                // method resolved late in sema) must not clobber the declared
                // local type.
                if (hir_type_table_kind(self.unit.types, init_type) != ty_VOID()) {
                type_id = init_type;
                }
            }
        }
        var local_flags: i32 = 0;
        if ((stmt_get_semantic_flags(s) & stmt_flag_volatile_local()) != 0) {
            // `let volatile x = ...;` / `var volatile x = ...;`: carry the
            // qualifier into the HIR local record so MIR and both backends
            // see it through the shared flags word.
            local_flags = local_flags | hir_local_flag_volatile();
        }
        var can_auto_drop = self.local_type_id_should_auto_drop(type_id);
        if (hir_type_table_kind(self.unit.types, type_id) == ty_STRING()) {
            can_auto_drop = self.primitive_str_init_is_fresh_owned_value(stmt_get_init(s))
                && self.primitive_str_local_has_proven_non_escaping_uses(s);
        }
        if (can_auto_drop
            && !self.init_expr_returns_borrowed_container_element(stmt_get_init(s))
            && !self.local_stmt_is_raw_copy_view(s, name)) {
            local_flags = local_flags | hir_local_flag_auto_drop();
        }
        let local_id = self.unit.add_local(self.current_function_id, name, type_id, local_flags);
        if ((local_flags & hir_local_flag_auto_drop()) != 0) { self.set_local_drop_for_type(local_id, type_id); }
        self.unit.set_stmt_local(stmt_id, local_id);
        self.locals = hir_local_scope_push(self.locals,
                             name,
                             local_id,
                             type_id,
                             self.current_function_id,
                             stmt_get_semantic_target(s));
    }

    fn foreach_pack_name(self, s: rawptr) -> string {
        if (s == null || stmt_get_kind(s) != st_FOREACH()) { return ""; }
        let cond = stmt_get_cond(s);
        if (cond == null || expr_get_kind(cond) != ex_IDENT()) { return ""; }
        let pack_name = expr_get_name(cond);
        if (hir_pack_bindings_find(self.pack_bindings, pack_name) == null) { return ""; }
        return pack_name;
    }

    fn set_hir_stmt_loc_from_ast(self, stmt_id: i32, s: rawptr) {
        if (stmt_id == hir_id_invalid() || s == null) { return; }
        self.unit.set_stmt_loc(stmt_id,
                              stmt_loc_line(s),
                              stmt_loc_col(s),
                              stmt_loc_end_line(s),
                              stmt_loc_end_col(s));
    }

    fn set_hir_expr_loc_from_ast(self, expr_id: i32, e: rawptr) {
        if (expr_id == hir_id_invalid() || e == null) { return; }
        self.unit.set_expr_loc(expr_id,
                              expr_loc_line(e),
                              expr_loc_col(e),
                              expr_loc_end_line(e),
                              expr_loc_end_col(e));
    }

    fn build_pack_foreach_stmt(self, s: rawptr, pack_name: string) -> i32 {
        if (pack_name.len == 0) { return hir_id_invalid(); }
        let stmt_id = self.unit.add_stmt(self.current_function_id,
                                        hir_stmt_block(),
                                        "",
                                        hir_id_invalid());
        self.set_hir_stmt_loc_from_ast(stmt_id, s);
        self.unit.set_stmt_owner_item(stmt_id, self.current_item_id);
        var first_stmt = hir_id_invalid();
        var last_stmt = hir_id_invalid();
        let pack_count = hir_pack_bindings_count(self.pack_bindings, pack_name);
        var index: i32 = 0;
        while (index < pack_count) {
            let local_id = hir_pack_bindings_local_at(self.pack_bindings, pack_name, index);
            if (local_id != hir_id_invalid()) {
                let saved_each = self.locals.head;
                self.locals = hir_local_scope_push(self.locals,
                                     stmt_get_name(s),
                                     local_id,
                                     self.unit.local_type(local_id),
                                     self.current_function_id,
                                     stmt_get_semantic_target(s));
                let body_stmt = self.build_stmt(stmt_get_body(s));
                self.locals = hir_local_scope_drop_to(self.locals, saved_each);
                if (body_stmt != hir_id_invalid()) {
                    if (first_stmt == hir_id_invalid()) {
                        first_stmt = body_stmt;
                    }
                    if (last_stmt != hir_id_invalid()) {
                        self.unit.set_stmt_next(last_stmt, body_stmt);
                    }
                    last_stmt = body_stmt;
                }
            }
            index = index + 1;
        }
        self.unit.set_stmt_child(stmt_id, first_stmt);
        return stmt_id;
    }

    fn foreach_iter_type_id_from_cond(self, cond_expr_id: i32) -> i32 {
        if (cond_expr_id == hir_id_invalid()) { return hir_id_invalid(); }
        if (self.unit.expr_target_kind(cond_expr_id) == hir_target_builtin()
            && (self.unit.expr_name(cond_expr_id) == "fields"
                || self.unit.expr_name(cond_expr_id) == "methods")) {
            return self.builtin_i64_type_id();
        }
        if (self.unit.expr_kind(cond_expr_id) == ex_BIN()) {
            let op = self.unit.expr_op(cond_expr_id);
            if (op == tk_DOTDOT() || op == tk_DOTDOTEQ()) {
                return self.builtin_i64_type_id();
            }
        }
        let collection_type = self.unit.expr_type(cond_expr_id);
        if (!self.type_id_is_valid(collection_type)) { return hir_id_invalid(); }
        let collection_kind = hir_type_table_kind(self.unit.types, collection_type);
        if (collection_kind == ty_STRING()) { return self.type_id_from_text("char"); }
        if (collection_kind == ty_RANGE()) { return self.builtin_i64_type_id(); }
        if (collection_kind == ty_ARRAY()) {
            let elem_type = hir_type_table_elem(self.unit.types, collection_type);
            if (self.type_id_is_valid(elem_type)) { return elem_type; }
        }
        let collection_text = hir_type_table_text(self.unit.types, collection_type);
        let collection_base = hir_builder_last_path_segment(policy_generic_call_base(collection_text.clone()));
        if (collection_base == "Range") { return self.builtin_i64_type_id(); }
        if (collection_base == "StrBytes") { return self.type_id_from_text("u8"); }
        if (collection_base == "StrChars") { return self.type_id_from_text("char"); }
        if (collection_base == "String") { return self.type_id_from_text("char"); }
        let args = policy_generic_call_args(collection_text.clone());
        let first_arg = policy_generic_arg_at(args, 0);
        if (first_arg.len > 0) {
            let resolved_arg = self.resolve_type_text_in_current_env(first_arg);
            if (resolved_arg.len > 0) { return self.type_id_from_text(resolved_arg); }
        }
        return hir_id_invalid();
    }

    fn ensure_foreach_iterator_method_instances(self, iterator_type_id: i32) {
        if (!self.type_id_is_valid(iterator_type_id)) { return; }
        let iterator_kind = hir_type_table_kind(self.unit.types, iterator_type_id);
        let iterator_text = hir_type_table_text(self.unit.types, iterator_type_id);
        let iterator_base = hir_builder_last_path_segment(policy_generic_call_base(iterator_text.clone()));
        if (iterator_kind == ty_STRING() || iterator_base == "String") {
            self.ensure_method_instance_for_type_text(iterator_text, "iter");
            self.ensure_method_instance_for_type_text("StrChars", "has_next");
            self.ensure_method_instance_for_type_text("StrChars", "next");
            return;
        }
        if (iterator_kind != ty_CLASS()) { return; }
        let iterator_type = iterator_text;
        if (iterator_type.len == 0 || self.type_text_has_open_template_atom(iterator_type)) { return; }
        self.ensure_method_instance_for_type_text(iterator_type, "has_next");
        self.ensure_method_instance_for_type_text(iterator_type, "next");
    }

    fn build_stmt(self, s: rawptr) -> i32 {
        if (s == null) { return hir_id_invalid(); }
        let ast_kind = stmt_get_kind(s);
        if (ast_kind == st_FOREACH()) {
            let pack_name = self.foreach_pack_name(s);
            if (pack_name.len > 0) {
                return self.build_pack_foreach_stmt(s, pack_name);
            }
        }
        let hir_kind = hir_builder_stmt_kind_from_ast(ast_kind);
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-stmt-enter] kind=" + self.i32_text(ast_kind)
                  + " name=" + stmt_get_name(s)
                  + " fn=" + self.i32_text(self.current_function_id)
                  + " stmts=" + self.i32_text(self.unit.stmt_count)
                  + " exprs=" + self.i32_text(self.unit.expr_count)
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        let type_id = self.type_id_from_ref(stmt_get_ty(s));
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-stmt-type] kind=" + self.i32_text(ast_kind)
                  + " name=" + stmt_get_name(s)
                  + " type=" + self.i32_text(type_id)
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        let stmt_id = self.unit.add_stmt(self.current_function_id, hir_kind, stmt_get_name(s), type_id);
        self.set_hir_stmt_loc_from_ast(stmt_id, s);
        self.unit.set_stmt_owner_item(stmt_id, self.current_item_id);
        self.profile_stmt_trace("stmt", s, stmt_id);
        if (ast_kind == st_EXPR()) {
            self.unit.set_stmt_expr(stmt_id, self.build_expr(stmt_get_init(s)));
            return stmt_id;
        }
        if (ast_kind == st_LET() || ast_kind == st_VAR()) {
            let init_expr = stmt_get_init(s);
            let init_expr_id = self.build_expr(init_expr);
            if (self.type_id_is_valid(type_id)) {
                self.resolve_expected_variant_expr(init_expr_id, type_id);
                self.apply_expected_expr_type(init_expr_id, type_id);
            }
            self.unit.set_stmt_expr(stmt_id, init_expr_id);
            self.add_local_from_stmt(stmt_id, s, init_expr_id);
            return stmt_id;
        }
        if (ast_kind == st_RETURN()) {
            let ret_expr_id = self.build_expr(stmt_get_init(s));
            let return_type = self.unit.function_return_type(self.current_function_id);
            self.resolve_expected_variant_expr(ret_expr_id, return_type);
            self.apply_expected_expr_type(ret_expr_id, return_type);
            self.unit.set_stmt_expr(stmt_id, ret_expr_id);
            return stmt_id;
        }
        if (ast_kind == st_IF()) {
            self.unit.set_stmt_cond(stmt_id, self.build_expr(stmt_get_cond(s)));
            let saved_then = self.locals.head;
            self.unit.set_stmt_child(stmt_id, self.build_stmt(stmt_get_then_blk(s)));
            self.locals = hir_local_scope_drop_to(self.locals, saved_then);
            let saved_else = self.locals.head;
            self.unit.set_stmt_else(stmt_id, self.build_stmt(stmt_get_else_blk(s)));
            self.locals = hir_local_scope_drop_to(self.locals, saved_else);
            return stmt_id;
        }
        if (ast_kind == st_WHILE()) {
            self.unit.set_stmt_cond(stmt_id, self.build_expr(stmt_get_cond(s)));
            let saved = self.locals.head;
            self.unit.set_stmt_child(stmt_id, self.build_stmt(stmt_get_body(s)));
            self.locals = hir_local_scope_drop_to(self.locals, saved);
            return stmt_id;
        }
        if (ast_kind == st_BLOCK()) {
            let saved_block = self.locals.head;
            let chain = self.build_stmt_chain(stmt_get_body(s));
            self.unit.set_stmt_child(stmt_id, chain.first);
            self.locals = hir_local_scope_drop_to(self.locals, saved_block);
            if ((stmt_get_semantic_flags(s) & stmt_flag_unsafe_block()) != 0) {
                // `unsafe { ... }`: the block's aux slot is unused for plain
                // blocks, so it carries the unsafe marker into MIR building.
                self.unit.set_stmt_aux(stmt_id, stmt_flag_unsafe_block());
            }
            return stmt_id;
        }
        if (ast_kind == st_FOR()) {
            let saved_for = self.locals.head;
            self.unit.set_stmt_child(stmt_id, self.build_stmt(stmt_get_init(s)));
            self.unit.set_stmt_cond(stmt_id, self.build_expr(stmt_get_cond(s)));
            self.unit.set_stmt_aux(stmt_id, self.build_stmt(stmt_get_then_blk(s)));
            self.unit.set_stmt_else(stmt_id, self.build_stmt(stmt_get_body(s)));
            self.locals = hir_local_scope_drop_to(self.locals, saved_for);
            return stmt_id;
        }
        if (ast_kind == st_FOREACH()) {
            let saved_each = self.locals.head;
            let cond_expr_id = self.build_expr(stmt_get_cond(s));
            self.unit.set_stmt_cond(stmt_id, cond_expr_id);
            self.ensure_foreach_iterator_method_instances(self.unit.expr_type(cond_expr_id));
            var iter_type = type_id;
            if (!self.type_id_is_valid(iter_type)) {
                iter_type = self.foreach_iter_type_id_from_cond(cond_expr_id);
            }
            let local_id = self.unit.add_local(self.current_function_id, stmt_get_name(s), iter_type, 0);
            self.unit.set_stmt_local(stmt_id, local_id);
            self.locals = hir_local_scope_push(self.locals,
                                 stmt_get_name(s),
                                 local_id,
                                 iter_type,
                                 self.current_function_id,
                                 stmt_get_semantic_target(s));
            self.unit.set_stmt_child(stmt_id, self.build_stmt(stmt_get_body(s)));
            self.locals = hir_local_scope_drop_to(self.locals, saved_each);
            return stmt_id;
        }
        if (ast_kind == st_MATCH()) {
            let scrutinee_expr = self.build_expr(stmt_get_init(s));
            self.unit.set_stmt_expr(stmt_id, scrutinee_expr);
            let scrutinee_type = self.unit.expr_type(scrutinee_expr);
            var arm = stmt_get_body(s);
            var first_arm = hir_id_invalid();
            var last_arm = hir_id_invalid();
            while (arm != null) {
                let saved_arm = self.locals.head;
                let arm_stmt = self.unit.add_stmt(self.current_function_id, hir_stmt_expr(), "", hir_id_invalid());
                self.set_hir_stmt_loc_from_ast(arm_stmt, arm);
                self.unit.set_stmt_owner_item(arm_stmt, self.current_item_id);
                let pat = stmt_get_init(arm);
                self.push_pattern_binds_for_type(pat, scrutinee_type);
                let pat_expr = self.build_expr(pat);
                self.resolve_expected_variant_expr(pat_expr, scrutinee_type);
                self.unit.set_stmt_expr(arm_stmt, pat_expr);
                self.unit.set_stmt_cond(arm_stmt, self.build_expr(stmt_get_cond(arm)));
                self.unit.set_stmt_child(arm_stmt, self.build_stmt(stmt_get_body(arm)));
                self.locals = hir_local_scope_drop_to(self.locals, saved_arm);
                if (first_arm == hir_id_invalid()) {
                    first_arm = arm_stmt;
                }
                if (last_arm != hir_id_invalid()) {
                    self.unit.set_stmt_next(last_arm, arm_stmt);
                }
                last_arm = arm_stmt;
                arm = stmt_get_next(arm);
            }
            self.unit.set_stmt_child(stmt_id, first_arm);
            return stmt_id;
        }
        if (ast_kind == st_DEFER()) {
            self.unit.set_stmt_child(stmt_id, self.build_stmt(stmt_get_init(s)));
            return stmt_id;
        }
        if (ast_kind == st_STATIC_ASSERT()) {
            self.unit.set_stmt_cond(stmt_id, self.build_expr(stmt_get_cond(s)));
            return stmt_id;
        }
        return stmt_id;
    }

    fn variant_decl_for_type_id_and_name(self, type_id: i32, variant_name: string) -> rawptr {
        if (!self.type_id_is_valid(type_id) || variant_name.len == 0) { return null; }
        let owner_text = hir_type_table_text(self.unit.types, type_id);
        if (owner_text.len == 0 || self.type_text_has_open_template_atom(owner_text)) { return null; }
        let member = self.raw_member_decl_for_type_text(owner_text, policy_generic_call_base(variant_name.clone()));
        if (member == null || decl_get_kind(member) != de_VARIANT()) { return null; }
        return member;
    }

    fn owner_template_params_for_type_text(self, owner_decl: rawptr, owner_type_name: string) -> string {
        var owner_params = hir_builder_decl_template_params(owner_decl);
        let owner_args = policy_generic_call_args(owner_type_name.clone());
        if (owner_params.len == 0 && owner_args.len > 0) {
            let template_owner = self.raw_template_class_decl_for_type_text(owner_type_name);
            if (template_owner != null) {
                let template_params = hir_builder_decl_template_params(template_owner);
                if (template_params.len > 0
                    && hir_builder_generic_param_count(template_params) == hir_builder_generic_arg_count(owner_args)) {
                    owner_params = template_params;
                }
            }
        }
        return owner_params;
    }

    fn owner_template_args_for_type_text(self, owner_params: string, owner_type_name: string) -> string {
        var owner_args = hir_builder_owner_args_for_params(owner_params, owner_type_name);
        if (owner_args.len == 0 && owner_params.len > 0) {
            let type_args = policy_generic_call_args(owner_type_name.clone());
            if (type_args.len > 0
                && hir_builder_generic_arg_count(type_args) == hir_builder_generic_param_count(owner_params)) {
                owner_args = type_args;
            }
        }
        return owner_args;
    }

    fn variant_param_type_id_for_owner(self,
                                             owner_type_id: i32,
                                             variant_decl: rawptr,
                                             arg_index: i32) -> i32 {
        if (!self.type_id_is_valid(owner_type_id) || variant_decl == null || arg_index < 0) {
            return hir_id_invalid();
        }
        let owner_text = hir_type_table_text(self.unit.types, owner_type_id);
        if (owner_text.len == 0) { return hir_id_invalid(); }
        let owner_decl = self.raw_class_decl_for_type_text(owner_text);
        if (owner_decl == null) { return hir_id_invalid(); }
        let owner_params = self.owner_template_params_for_type_text(owner_decl, owner_text);
        let owner_args = self.owner_template_args_for_type_text(owner_params, owner_text);
        var param = decl_get_params(variant_decl);
        var index: i32 = 0;
        while (param != null) {
            if (index == arg_index) {
                return self.type_id_from_ref_env(decl_get_ty(param), owner_params, owner_args);
            }
            index = index + 1;
            param = decl_get_next(param);
        }
        return hir_id_invalid();
    }

    fn push_pattern_binds_for_type(self, pat: rawptr, scrutinee_type_id: i32) {
        if (pat == null) { return; }
        if (expr_get_kind(pat) == ex_IDENT()) {
            let name = expr_get_name(pat);
            if (name != "_" && self.variant_decl_for_type_id_and_name(scrutinee_type_id, name) == null) {
                var bind_type = scrutinee_type_id;
                if (bind_type == hir_id_invalid()) { bind_type = self.type_id_from_expr(pat); }
                let local_id = self.unit.add_local(self.current_function_id, name, bind_type, 0);
                self.locals = hir_local_scope_push(self.locals,
                                     name,
                                     local_id,
                                     bind_type,
                                     self.current_function_id,
                                     expr_get_semantic_target(pat));
            }
            return;
        }
        if (expr_get_kind(pat) != ex_CALL()) {
            self.push_pattern_binds(pat);
            return;
        }
        let callee = expr_get_lhs(pat);
        var variant_decl: rawptr = null;
        if (callee != null) {
            variant_decl = self.variant_decl_for_type_id_and_name(scrutinee_type_id, expr_get_name(callee));
        }
        var ac = expr_get_args(pat);
        var arg_index: i32 = 0;
        while (ac != null) {
            let arg = stmt_get_init(ac);
            if (arg != null && expr_get_kind(arg) == ex_IDENT()) {
                let name = expr_get_name(arg);
                if (name != "_") {
                    var type_id = self.variant_param_type_id_for_owner(scrutinee_type_id, variant_decl, arg_index);
                    if (type_id == hir_id_invalid()) { type_id = self.type_id_from_expr(arg); }
                    let local_id = self.unit.add_local(self.current_function_id, name, type_id, 0);
                    self.locals = hir_local_scope_push(self.locals,
                                         name,
                                         local_id,
                                         type_id,
                                         self.current_function_id,
                                         expr_get_semantic_target(arg));
                }
            }
            arg_index = arg_index + 1;
            ac = stmt_get_next(ac);
        }
    }

    fn push_pattern_binds(self, pat: rawptr) {
        if (pat == null) { return; }
        if (expr_get_kind(pat) == ex_CALL()) {
            var ac = expr_get_args(pat);
            while (ac != null) {
                let arg = stmt_get_init(ac);
                if (arg != null && expr_get_kind(arg) == ex_IDENT()) {
                    let name = expr_get_name(arg);
                    if (name != "_") {
                        let type_id = self.type_id_from_expr(arg);
                        let local_id = self.unit.add_local(self.current_function_id, name, type_id, 0);
                        self.locals = hir_local_scope_push(self.locals,
                                             name,
                                             local_id,
                                             type_id,
                                             self.current_function_id,
                                             expr_get_semantic_target(arg));
                    }
                }
                ac = stmt_get_next(ac);
            }
        }
    }

    fn target_kind_for_expr(self, e: rawptr, sem_kind: i32) -> i32 {
        if (sem_kind == expr_sem_LOCAL()) { return hir_target_local(); }
        if (sem_kind == expr_sem_CONST()) { return hir_target_item(); }
        if (sem_kind == expr_sem_GLOBAL()) { return hir_target_item(); }
        if (sem_kind == expr_sem_DIRECT_FN()) { return hir_target_function(); }
        if (sem_kind == expr_sem_METHOD()) { return hir_target_function(); }
        if (sem_kind == expr_sem_FIELD()) {
            if (e != null && expr_get_semantic_target(e) == null) { return hir_target_builtin(); }
            return hir_target_field();
        }
        if (sem_kind == expr_sem_VARIANT()) { return hir_target_variant(); }
        if (sem_kind == expr_sem_CLASS()) {
            if (e != null && expr_get_semantic_target(e) == null) { return hir_target_type(); }
            return hir_target_item();
        }
        if (sem_kind == expr_sem_BUILTIN()) { return hir_target_builtin(); }
        if (sem_kind == expr_sem_INDIRECT_FN()) {
            if (e != null && expr_get_semantic_target(e) != null) { return hir_target_local(); }
            return hir_target_none();
        }
        return hir_target_none();
    }

    fn builtin_name_for_expr(self, e: rawptr) -> string {
        if (e == null) { return ""; }
        let k = expr_get_kind(e);
        if (k == ex_CALL()) {
            let callee = expr_get_lhs(e);
            if (callee != null) { return expr_get_name(callee); }
        }
        return expr_get_name(e);
    }

    fn ensure_raw_class_decl_registered(self, type_text: string) -> i32 {
        if (type_text.len == 0) { return hir_id_invalid(); }
        let raw_class = self.raw_class_decl_for_type_text(type_text);
        if (raw_class == null) { return hir_id_invalid(); }
        let existing = hir_pointer_map_item(self.decl_map,raw_class);
        if (existing != hir_id_invalid()) { return existing; }
        return self.register_decl(raw_class, hir_id_invalid());
    }

    fn ensure_concrete_type_ref_ready(self, ty: rawptr, params: string, args: string) {
        if (ty == null) { return; }
        let kind = tref_get_kind(ty);
        if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
            self.ensure_concrete_type_ref_ready(tref_pointee(ty), params, args);
            return;
        }
        if (kind == ty_ARRAY()) {
            self.ensure_concrete_type_ref_ready(tref_array_elem(ty), params, args);
            return;
        }
        if (kind == ty_TUPLE()) {
            var tuple_index: i64 = 0;
            let tuple_count = tref_tuple_count(ty);
            while (tuple_index < tuple_count) {
                self.ensure_concrete_type_ref_ready(tref_tuple_elem_at(ty, tuple_index), params, args);
                tuple_index = tuple_index + 1;
            }
            return;
        }
        if (kind == ty_FN() || kind == ty_CFN()) {
            let fn_params = tref_fn_params(ty);
            if (fn_params != null) {
                var param_index: i64 = 0;
                let param_count = tref_tuple_count(fn_params);
                while (param_index < param_count) {
                    self.ensure_concrete_type_ref_ready(tref_tuple_elem_at(fn_params, param_index), params, args);
                    param_index = param_index + 1;
                }
            }
            self.ensure_concrete_type_ref_ready(tref_fn_ret(ty), params, args);
            return;
        }
        let concrete_text = self.type_text_from_ref_env(ty, params, args);
        if (concrete_text.len > 0 && !self.type_text_has_open_template_atom(concrete_text)) {
            self.ensure_concrete_type_text_ready(concrete_text);
        }
    }

    fn ensure_concrete_type_text_ready(self, text: string) -> i32 {
        if (text.len == 0) { return hir_id_invalid(); }
        var resolved = self.resolve_type_text_in_current_env(text);
        if (resolved.len == 0 || self.type_text_has_open_template_atom(resolved)) {
            return hir_id_invalid();
        }
        resolved = self.canonical_type_text_for_lookup(resolved, 0);
        self.profile_type_ready_phase("ready-enter", resolved);
        let type_id = self.type_id_from_text(resolved);
        self.ensure_raw_class_decl_registered(resolved);
        if (hir_string_set_contains(self.concrete_type_ready,resolved)) {
            self.profile_type_ready_phase("ready-reuse", resolved);
            return type_id;
        }
        self.concrete_type_ready = hir_string_set_add(self.concrete_type_ready,resolved);
        let args = policy_generic_call_args(resolved.clone());
        if (args.len > 0) {
            var i: i32 = 0;
            while (i < 64) {
                let arg = policy_generic_arg_at(args, i);
                if (arg.len == 0) { break; }
                self.ensure_concrete_type_text_ready(arg);
                i = i + 1;
            }
            let owner_decl = self.raw_class_decl_for_type_text(resolved);
            if (owner_decl != null) {
                let owner_params = hir_builder_decl_template_params(owner_decl);
                let owner_args = hir_builder_owner_args_for_params(owner_params, resolved);
                if (owner_params.len > 0 && owner_args.len > 0) {
                    self.ensure_class_instance(owner_decl, resolved, owner_params, owner_args);
                }
            }
        }
        return type_id;
    }

    fn ensure_concrete_type_text_known(self, text: string) -> i32 {
        if (text.len == 0) { return hir_id_invalid(); }
        var resolved = self.resolve_type_text_in_current_env(text);
        if (resolved.len == 0 || self.type_text_has_open_template_atom(resolved)) {
            return hir_id_invalid();
        }
        resolved = self.canonical_type_text_for_lookup(resolved, 0);
        let type_id = self.type_id_from_text(resolved);
        let args = policy_generic_call_args(resolved.clone());
        if (args.len > 0) {
            var i: i32 = 0;
            while (i < 64) {
                let arg = policy_generic_arg_at(args, i);
                if (arg.len == 0) { break; }
                self.ensure_concrete_type_text_known(arg);
                i = i + 1;
            }
        }
        self.profile_type_ready_phase("ready-leave", resolved);
        return type_id;
    }

    fn materialize_type_id_if_concrete_class(self, type_id: i32) {
        if (!self.type_id_is_valid(type_id)) { return; }
        if (hir_int_id_map_get(self.materialized_type_ids,type_id) == 1) { return; }
        self.materialized_type_ids = hir_int_id_map_put(self.materialized_type_ids,type_id, 1);
        if (hir_type_table_kind(self.unit.types, type_id) != ty_CLASS()) { return; }
        let type_text = hir_type_table_text(self.unit.types, type_id);
        if (type_text.len == 0) { return; }
        if (policy_generic_call_args(type_text.clone()).len == 0) { return; }
        if (self.type_text_has_open_template_atom(type_text)) { return; }
        self.profile_materialize_type(type_id, type_text);
        if (self.lazy_codegen) {
            self.ensure_concrete_type_text_known(type_text);
            return;
        }
        self.ensure_concrete_type_text_ready(type_text);
    }

    fn materialize_concrete_type_items_for_function(self, function_id: i32) {
        self.profile_build_phase("materialize-enter");
        if (self.unit.expr_count == 0 && self.unit.stmt_count == 0) {
            self.profile_build_phase("materialize-leave");
            return;
        }
        let expr_limit = self.unit.expr_count;
        let function_limit = self.unit.function_count;
        var expr_id: i32 = self.materialized_expr_count + 1;
        while (expr_id <= expr_limit) {
            self.materialize_type_id_if_concrete_class(self.unit.expr_type(expr_id));
            expr_id = expr_id + 1;
        }
        self.materialized_expr_count = expr_limit;
        if (function_id != hir_id_invalid()) {
            if (function_id <= function_limit
                && self.unit.function_body(function_id) != hir_id_invalid()
                && hir_int_id_map_get(self.materialized_function_ids,function_id) != 1) {
                self.materialize_concrete_type_items_for_function_signature(function_id);
            }
        } else {
            var fn_id: i32 = 1;
            while (fn_id <= function_limit) {
                if (self.unit.function_body(fn_id) != hir_id_invalid()
                    && hir_int_id_map_get(self.materialized_function_ids,fn_id) != 1) {
                    self.materialize_concrete_type_items_for_function_signature(fn_id);
                }
                fn_id = fn_id + 1;
            }
        }
        self.profile_build_phase("materialize-leave");
    }

    fn materialize_concrete_type_items_for_function_signature(self, fn_id: i32) {
        if (fn_id == hir_id_invalid()) { return; }
        self.materialized_function_ids = hir_int_id_map_put(self.materialized_function_ids,fn_id, 1);
        self.materialize_type_id_if_concrete_class(self.unit.function_return_type(fn_id));
        var local_id = self.unit.function_first_local(fn_id);
        while (local_id != hir_id_invalid()) {
            self.materialize_type_id_if_concrete_class(self.unit.local_type(local_id));
            local_id = self.unit.local_next(local_id);
        }
    }

    public fn materialize_concrete_type_items(self) {
        self.materialize_concrete_type_items_for_function(hir_id_invalid());
    }

    fn resolve_member_expr_from_hir(self, expr_id: i32) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        if (self.unit.expr_kind(expr_id) != ex_MEMBER()) { return false; }
        let existing_target_kind = self.unit.expr_target_kind(expr_id);
        if (existing_target_kind != hir_target_none()
            && existing_target_kind != hir_target_field()
            && existing_target_kind != hir_target_builtin()
            && existing_target_kind != hir_target_function()
            && existing_target_kind != hir_target_variant()) {
            return false;
        }
        // Initial AST semantic metadata represents a member without a raw
        // declaration target as a builtin.  Keep resolving that provisional
        // form: after generic instantiation its receiver can expose a real
        // field, associated value, or method.  Other resolved target kinds
        // are already authoritative.
        if (existing_target_kind != hir_target_none()
            && existing_target_kind != hir_target_builtin()
            && self.unit.expr_target_id(expr_id) != hir_id_invalid()) {
            return false;
        }
        // Preserve an already-registered builtin unless this pass can replace
        // it with a concrete field/value/method. Re-running builtin fallback
        // resolution reports a mutation on every fixed-point iteration, which
        // keeps HIR closure alive indefinitely for large modules.
        let builtin_needs_concrete_replacement = existing_target_kind == hir_target_builtin()
                                                 && self.unit.expr_target_id(expr_id) != hir_id_invalid();
        let lhs_expr_id = self.unit.expr_lhs(expr_id);
        if (lhs_expr_id == hir_id_invalid()) { return false; }
        let member_name = policy_generic_call_base(self.unit.expr_name(expr_id).clone());
        if (member_name.len == 0) { return false; }
        let owner_type_id = self.member_lookup_type_id(self.unit.expr_type(lhs_expr_id));
        if (!self.type_id_is_valid(owner_type_id)) { return false; }
        var owner_type_name = self.member_lookup_type_name(owner_type_id);
        if (owner_type_name.len == 0) { return false; }
        if (policy_generic_call_args(owner_type_name.clone()).len > 0
            && !self.type_text_has_open_template_atom(owner_type_name)) {
            self.ensure_concrete_type_text_ready(owner_type_name);
        }
        let member_value_item = self.member_value_item_id_for_type_and_name(owner_type_id, member_name);
        if (member_value_item != hir_id_invalid()) {
            self.unit.set_expr_type(expr_id, self.unit.item_type(member_value_item));
            let value_kind = self.unit.item_kind(member_value_item);
            var value_sem = expr_sem_CONST();
            if (value_kind == hir_item_global()) { value_sem = expr_sem_GLOBAL(); }
            self.unit.set_expr_semantic(expr_id,
                                       value_sem,
                                       hir_target_item(),
                                       member_value_item);
            return true;
        }
        var field_item = self.field_id_for_type_and_name(owner_type_id, member_name);
        if (field_item == hir_id_invalid()) {
            let resolved_owner_type = self.type_id_from_text(owner_type_name);
            if (resolved_owner_type != hir_id_invalid()) {
                field_item = self.field_id_for_type_and_name(resolved_owner_type, member_name);
            }
        }
        if (field_item == hir_id_invalid()
            && !self.type_text_has_open_template_atom(owner_type_name)) {
            // A concrete cross-module class reached only through a
            // declaration-only method shell may not have had its field layout
            // registered in this unit yet. Streaming body materialization no
            // longer eagerly registers such owners, so register the concrete
            // owner decl on demand and retry the field lookup before falling
            // back to a builtin member. Without this a `let x = obj.method()`
            // whose return type is an imported class leaves every `x.field`
            // access stuck as an unlowerable builtin.
            self.ensure_concrete_type_text_ready(owner_type_name);
            field_item = self.field_id_for_type_and_name(owner_type_id, member_name);
            if (field_item == hir_id_invalid()) {
                let reready_owner_type = self.type_id_from_text(owner_type_name);
                if (reready_owner_type != hir_id_invalid()) {
                    field_item = self.field_id_for_type_and_name(reready_owner_type, member_name);
                }
            }
        }
        if (field_item != hir_id_invalid()) {
            self.unit.set_expr_type(expr_id, self.unit.item_type(field_item));
            self.unit.set_expr_semantic(expr_id,
                                       expr_sem_FIELD(),
                                       hir_target_field(),
                                       field_item);
            return true;
        }
        let dyn_iface_name = self.dyn_interface_name_from_type_text(owner_type_name);
        if (dyn_iface_name.len > 0) {
            let dyn_method_fn = self.method_function_target_by_owner_type_and_method(dyn_iface_name, member_name);
            if (dyn_method_fn != hir_id_invalid()) {
                self.unit.set_expr_type(expr_id, self.function_type_id(dyn_method_fn));
                self.unit.set_expr_semantic(expr_id, expr_sem_METHOD(), hir_target_function(), dyn_method_fn);
                return true;
            }
        }
        if (self.resolve_tuple_builtin_member_expr(expr_id, owner_type_id, member_name)) { return true; }
        var method_owner_type = owner_type_name;
        var method_fn = hir_id_invalid();
        let want_static = self.unit.expr_sem_kind(lhs_expr_id) == expr_sem_CLASS();
        method_fn = self.ensure_method_instance_for_explicit_member_expr(method_owner_type,
                                                                         member_name,
                                                                         expr_id,
                                                                         want_static);
        if (method_fn == hir_id_invalid()) {
            method_fn = self.closed_method_target_for_type_text(method_owner_type,
                                                                member_name,
                                                                null,
                                                                hir_id_invalid(),
                                                                null,
                                                                want_static);
        }
        if (method_fn == hir_id_invalid()) {
            let payload_owner_type = self.heap_indirect_member_owner_type_text(owner_type_name, member_name);
            if (payload_owner_type.len > 0) {
                var payload_method_fn = self.closed_method_target_for_type_text(payload_owner_type,
                                                                                member_name,
                                                                                null,
                                                                                hir_id_invalid(),
                                                                                null,
                                                                                false);
                if (payload_method_fn != hir_id_invalid()) {
                    method_owner_type = payload_owner_type;
                    method_fn = payload_method_fn;
                }
            }
        }
        if (method_fn != hir_id_invalid()) {
            self.unit.set_expr_type(expr_id, self.function_type_id(method_fn));
            self.unit.set_expr_semantic(expr_id, expr_sem_METHOD(), hir_target_function(), method_fn);
            return true;
        }
        if (builtin_needs_concrete_replacement) { return false; }
        if (self.resolve_default_new_member_expr(expr_id, owner_type_name, member_name)) { return true; }
        if (self.resolve_string_builtin_member_expr(expr_id, owner_type_name, member_name)) { return true; }
        if (self.resolve_primitive_builtin_member_expr(expr_id, owner_type_name, member_name)) { return true; }
        return false;
    }

    public fn resolve_deferred_member_exprs_once(self) -> bool {
        var changed = false;
        let expr_limit = self.unit.expr_count;
        // Expression records are allocated before their children. Resolve in
        // reverse ID order so a member/call observes its freshly resolved
        // receiver and arguments during the same convergence round.
        var expr_id: i32 = expr_limit;
        while (expr_id >= 1) {
            if (self.resolve_member_expr_from_hir(expr_id)) { changed = true; }
            expr_id = expr_id - 1;
        }
        expr_id = expr_limit;
        while (expr_id >= 1) {
            if (self.resolve_call_expr_from_hir(expr_id)) { changed = true; }
            expr_id = expr_id - 1;
        }
        if (self.refresh_deferred_match_patterns_once()) { changed = true; }
        if (self.refresh_inferred_local_types_once()) { changed = true; }
        return changed;
    }

    // A match scrutinee can be a direct call whose concrete return type is
    // closed only after deferred call resolution. The first body build must
    // still create the arm scopes, so revisit those arms once the scrutinee is
    // typed and repair both the variant target and payload-binding local type.
    // This keeps lazy body materialization independent of the order in which
    // a call target and its result type become available.
    fn refresh_deferred_match_pattern_bind_types(self,
                                                 pattern_expr_id: i32,
                                                 subject_type_id: i32) -> bool {
        if (pattern_expr_id == hir_id_invalid() || !self.type_id_is_valid(subject_type_id)) {
            return false;
        }
        let subject_type_text = hir_type_table_text(self.unit.types, subject_type_id);
        if (subject_type_text.len == 0 || self.type_text_has_open_template_atom(subject_type_text)) {
            return false;
        }
        let pattern_kind = self.unit.expr_kind(pattern_expr_id);
        if (pattern_kind != ex_CALL()) { return false; }
        let variant_expr_id = self.unit.expr_lhs(pattern_expr_id);
        if (variant_expr_id == hir_id_invalid()
            || self.unit.expr_target_kind(variant_expr_id) != hir_target_variant()) {
            return false;
        }
        let variant_name = policy_generic_call_base(self.unit.expr_name(variant_expr_id).clone());
        if (variant_name.len == 0) { return false; }
        let variant_decl = self.raw_member_decl_for_type_text(subject_type_text, variant_name);
        if (variant_decl == null || decl_get_kind(variant_decl) != de_VARIANT()) { return false; }
        var changed = false;
        var arg_expr_id = self.unit.expr_first_arg(pattern_expr_id);
        var arg_index: i32 = 0;
        while (arg_expr_id != hir_id_invalid()) {
            let param_type = self.variant_param_type_id_for_owner(subject_type_id,
                                                                    variant_decl,
                                                                    arg_index);
            if (self.type_id_is_valid(param_type)) {
                if (self.unit.expr_type(arg_expr_id) != param_type) {
                    self.unit.set_expr_type(arg_expr_id, param_type);
                    changed = true;
                }
                if (self.unit.expr_target_kind(arg_expr_id) == hir_target_local()) {
                    let local_id = self.unit.expr_target_id(arg_expr_id);
                    if (local_id != hir_id_invalid()
                        && self.unit.local_type(local_id) != param_type) {
                        self.unit.set_local_type(local_id, param_type);
                        changed = true;
                    }
                }
            }
            arg_expr_id = self.unit.expr_next_arg(arg_expr_id);
            arg_index = arg_index + 1;
        }
        return changed;
    }

    fn refresh_deferred_match_patterns_once(self) -> bool {
        var changed = false;
        var stmt_id: i32 = 1;
        while (stmt_id <= self.unit.stmt_count) {
            if (self.unit.stmt_kind(stmt_id) == hir_stmt_match()) {
                let subject_expr_id = self.unit.stmt_expr(stmt_id);
                let subject_type_id = self.unit.expr_type(subject_expr_id);
                if (self.type_id_is_valid(subject_type_id)) {
                    var arm_stmt_id = self.unit.stmt_child(stmt_id);
                    var guard: i32 = 0;
                    while (arm_stmt_id != hir_id_invalid()
                        && guard <= self.unit.stmt_count + 2) {
                        let pattern_expr_id = self.unit.stmt_expr(arm_stmt_id);
                        if (pattern_expr_id != hir_id_invalid()) {
                            let before_pattern_type = self.unit.expr_type(pattern_expr_id);
                            let before_pattern_target = self.unit.expr_target_id(pattern_expr_id);
                            let before_callee = self.unit.expr_lhs(pattern_expr_id);
                            var before_callee_type = hir_id_invalid();
                            var before_callee_target = hir_id_invalid();
                            if (before_callee != hir_id_invalid()) {
                                before_callee_type = self.unit.expr_type(before_callee);
                                before_callee_target = self.unit.expr_target_id(before_callee);
                            }
                            self.resolve_expected_variant_expr(pattern_expr_id, subject_type_id);
                            if (before_pattern_type != self.unit.expr_type(pattern_expr_id)
                                || before_pattern_target != self.unit.expr_target_id(pattern_expr_id)
                                || (before_callee != hir_id_invalid()
                                    && (before_callee_type != self.unit.expr_type(before_callee)
                                        || before_callee_target != self.unit.expr_target_id(before_callee)))) {
                                changed = true;
                            }
                            if (self.refresh_deferred_match_pattern_bind_types(pattern_expr_id,
                                                                                subject_type_id)) {
                                changed = true;
                            }
                        }
                        arm_stmt_id = self.unit.stmt_next(arm_stmt_id);
                        guard = guard + 1;
                    }
                }
            }
            stmt_id = stmt_id + 1;
        }
        return changed;
    }

    // A `let` initializer may be a member whose field target becomes known
    // only in deferred member resolution. Preserve that type on the local and
    // on already-created local references before MIR is built.
    fn refresh_inferred_local_types_once(self) -> bool {
        var changed = false;
        var stmt_id: i32 = 1;
        while (stmt_id <= self.unit.stmt_count) {
            let kind = self.unit.stmt_kind(stmt_id);
            if ((kind == hir_stmt_let() || kind == hir_stmt_var())
                && !self.type_id_is_valid(self.unit.stmt_type(stmt_id))) {
                let local_id = self.unit.stmt_local(stmt_id);
                var local_type = hir_id_invalid();
                if (local_id != hir_id_invalid()) {
                    local_type = self.unit.local_type(local_id);
                }
                // An inferred local has no user-written type to preserve. Its
                // initializer may initially have a plausible but wrong type
                // while deferred member/call resolution is incomplete (for
                // example an unresolved `.clone()` can look like `str`). Once
                // the initializer closes, keep the local synchronized with it;
                // accepting only invalid/void placeholders leaves a stale ABI
                // type in MIR and can pass a `%__String` to a pointer call.
                if (local_id != hir_id_invalid()) {
                    let inferred = self.closed_expr_type_for_local(self.unit.stmt_expr(stmt_id));
                    if (self.type_id_is_valid(inferred)
                        && hir_type_table_kind(self.unit.types, inferred) != ty_VOID()
                        && local_type != inferred) {
                        self.unit.set_local_type(local_id, inferred);
                        changed = true;
                    }
                }
            }
            stmt_id = stmt_id + 1;
        }
        var expr_id: i32 = 1;
        while (expr_id <= self.unit.expr_count) {
            if (self.unit.expr_sem_kind(expr_id) == expr_sem_LOCAL()) {
                let expr_type = self.unit.expr_type(expr_id);
                let local_id = self.unit.expr_target_id(expr_id);
                if (local_id != hir_id_invalid()) {
                    let local_type = self.unit.local_type(local_id);
                    if (self.type_id_is_valid(local_type)
                        && hir_type_table_kind(self.unit.types, local_type) != ty_VOID()
                        && expr_type != local_type) {
                        self.unit.set_expr_type(expr_id, local_type);
                        changed = true;
                    }
                }
            } else if (!self.type_id_is_valid(self.unit.expr_type(expr_id))) {
                let target_kind = self.unit.expr_target_kind(expr_id);
                let target_id = self.unit.expr_target_id(expr_id);
                if ((target_kind == hir_target_field() || target_kind == hir_target_item())
                    && target_id != hir_id_invalid()) {
                    let item_type = self.unit.item_type(target_id);
                    if (self.type_id_is_valid(item_type)) {
                        self.unit.set_expr_type(expr_id, item_type);
                        changed = true;
                    }
                } else if (target_kind == hir_target_function()
                           && target_id != hir_id_invalid()) {
                    let function_type = self.function_type_id(target_id);
                    if (self.type_id_is_valid(function_type)) {
                        self.unit.set_expr_type(expr_id, function_type);
                        changed = true;
                    }
                }
            }
            expr_id = expr_id + 1;
        }
        // A resolved field can expose a concrete array after its index
        // expression was originally built. Recover array element types before
        // evaluating binary results that consume those indexed values.
        expr_id = 1;
        while (expr_id <= self.unit.expr_count) {
            if (self.unit.expr_kind(expr_id) == ex_INDEX()) {
                let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
                var indexed_type = lhs_type;
                if (self.type_id_is_valid(lhs_type)) {
                    let lhs_kind = hir_type_table_kind(self.unit.types, lhs_type);
                    if (lhs_kind == ty_REF() || lhs_kind == ty_MUTREF() || lhs_kind == ty_PTR()) {
                        let pointee = hir_type_table_elem(self.unit.types, lhs_type);
                        if (self.type_id_is_valid(pointee)) { indexed_type = pointee; }
                    }
                }
                if (self.type_id_is_valid(indexed_type)
                    && hir_type_table_kind(self.unit.types, indexed_type) == ty_ARRAY()) {
                    let before_type = self.unit.expr_type(expr_id);
                    self.resolve_index_expr_type_after_children(null, expr_id);
                    if (before_type != self.unit.expr_type(expr_id)) { changed = true; }
                }
            }
            expr_id = expr_id + 1;
        }
        // Member and index resolution can make the operands of an already-built
        // binary expression concrete. Re-run the normal binary result rule
        // before the next local-inference round so `let n = self.len - self.pos`
        // becomes a typed local rather than an unresolved MIR place.
        expr_id = 1;
        while (expr_id <= self.unit.expr_count) {
            if (self.unit.expr_kind(expr_id) == ex_BIN()) {
                let before_type = self.unit.expr_type(expr_id);
                self.resolve_binary_expr_type_after_children(expr_id);
                if (before_type != self.unit.expr_type(expr_id)) { changed = true; }
            }
            expr_id = expr_id + 1;
        }
        return changed;
    }

    fn call_expr_needs_deferred_resolution(self, expr_id: i32) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        if (self.unit.expr_kind(expr_id) != ex_CALL()) { return false; }
        if (self.call_expr_member_callee_owner_mismatch(expr_id)) { return true; }
        // A member begins as a provisional builtin when its raw declaration
        // is not available yet.  Deferred member resolution can later close
        // that callee to a real method, but the enclosing call may already
        // have copied the provisional builtin semantic and result type.
        // Re-resolve precisely this disagreement so the call follows the
        // authoritative callee instead of reaching MIR as a builtin with a
        // method target/value type from a different resolution generation.
        let callee_expr_id = self.unit.expr_lhs(expr_id);
        if (self.unit.expr_target_kind(expr_id) == hir_target_builtin()
            && callee_expr_id != hir_id_invalid()
            && self.unit.expr_target_kind(callee_expr_id) == hir_target_function()) {
            return true;
        }
        if (!self.type_id_is_valid(self.unit.expr_type(expr_id))) { return true; }
        let sem_kind = self.unit.expr_sem_kind(expr_id);
        if (sem_kind == expr_sem_INDIRECT_FN()) {
            if (callee_expr_id != hir_id_invalid()
                && self.unit.expr_kind(callee_expr_id) == ex_MEMBER()
                && self.unit.expr_target_kind(callee_expr_id) == hir_target_function()
                && self.unit.expr_target_id(callee_expr_id) != hir_id_invalid()) {
                return true;
            }
            return false;
        }
        let target_kind = self.unit.expr_target_kind(expr_id);
        let target_id = self.unit.expr_target_id(expr_id);
        if (target_kind == hir_target_none()) { return true; }
        if (target_kind == hir_target_function()) {
            if (target_id == hir_id_invalid()) { return true; }
            if (self.function_has_open_template_types(target_id)) { return true; }
        }
        return false;
    }

    fn call_expr_member_callee_owner_mismatch(self, expr_id: i32) -> bool {
        if (expr_id == hir_id_invalid() || self.unit.expr_kind(expr_id) != ex_CALL()) { return false; }
        let callee_expr_id = self.unit.expr_lhs(expr_id);
        if (callee_expr_id == hir_id_invalid() || self.unit.expr_kind(callee_expr_id) != ex_MEMBER()) { return false; }
        if (self.unit.expr_target_kind(callee_expr_id) != hir_target_function()) { return false; }
        let target_id = self.unit.expr_target_id(callee_expr_id);
        if (target_id == hir_id_invalid()) { return true; }
        let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
        if (owner_expr_id == hir_id_invalid()) { return false; }
        if (self.unit.expr_sem_kind(owner_expr_id) == expr_sem_CLASS()) { return false; }
        let owner_type_id = self.member_lookup_type_id(self.unit.expr_type(owner_expr_id));
        if (!self.type_id_is_valid(owner_type_id)) { return false; }
        let owner_type_text = self.member_lookup_type_name(owner_type_id);
        if (owner_type_text.len == 0 || self.type_text_has_open_template_atom(owner_type_text)) { return false; }
        let target_owner_type = hir_unit_function_owner_type(self.unit, target_id);
        if (target_owner_type.len == 0) { return false; }
        if (target_owner_type == owner_type_text) { return false; }
        return !policy_type_name_equal(target_owner_type, owner_type_text);
    }

    fn resolve_call_expr_from_hir(self, expr_id: i32) -> bool {
        if (!self.call_expr_needs_deferred_resolution(expr_id)) { return false; }
        let callee_expr_id = self.unit.expr_lhs(expr_id);
        if (callee_expr_id == hir_id_invalid()) { return false; }
        var callee_sem = self.unit.expr_sem_kind(callee_expr_id);
        if (!self.call_semantic_can_follow_callee(callee_sem)
            && self.unit.expr_kind(callee_expr_id) == ex_MEMBER()) {
            let method_fn = self.concrete_method_target_for_call_expr(null,
                                                                      expr_id,
                                                                      callee_expr_id,
                                                                      null);
            if (method_fn != hir_id_invalid()) {
                self.unit.set_expr_semantic(callee_expr_id,
                                           expr_sem_METHOD(),
                                           hir_target_function(),
                                           method_fn);
                let method_type = self.function_type_id(method_fn);
                if (method_type != hir_id_invalid()) {
                    self.unit.set_expr_type(callee_expr_id, method_type);
                }
                callee_sem = expr_sem_METHOD();
            }
        }
        if (!self.call_semantic_can_follow_callee(callee_sem)
            && !self.expr_type_is_function_value(callee_expr_id)) {
            return false;
        }
        let before_sem = self.unit.expr_sem_kind(expr_id);
        let before_target_kind = self.unit.expr_target_kind(expr_id);
        let before_target_id = self.unit.expr_target_id(expr_id);
        let before_type = self.unit.expr_type(expr_id);
        self.resolve_call_expr_after_children(null, expr_id, callee_expr_id);
        return before_sem != self.unit.expr_sem_kind(expr_id)
            || before_target_kind != self.unit.expr_target_kind(expr_id)
            || before_target_id != self.unit.expr_target_id(expr_id)
            || before_type != self.unit.expr_type(expr_id);
    }

    fn resolve_deferred_member_exprs(self) {
        self.profile_build_phase("deferred-members-enter");
        var changed = self.resolve_deferred_member_exprs_once();
        var guard: i32 = 0;
        while (changed && guard < 8) {
            self.materialize_reachable_function_bodies();
            self.materialize_concrete_type_items();
            changed = self.resolve_deferred_member_exprs_once();
            guard = guard + 1;
        }
        self.profile_build_phase("deferred-members-leave");
    }

    fn canonical_builtin_name_for_expr(self, e: rawptr) -> string {
        let raw_name = self.builtin_name_for_expr(e);
        let base = policy_generic_call_base(raw_name.clone());
        self.note_reflection_builtin_use(base);
        if (base != "sizeof" && base != "repr_sizeof" && base != "alignof"
            && base != "field_count" && base != "field_name"
            && base != "field_type" && base != "has_field"
            && base != "type_name" && base != "reflect_name"
            && base != "construct") {
            return raw_name;
        }
        let args = policy_generic_call_args(raw_name.clone());
        if (args.len == 0) { return raw_name; }
        var out_args = "";
        var i: i32 = 0;
        while (i < 64) {
            let raw_arg = policy_generic_arg_at(args, i);
            if (raw_arg.len == 0) {
                if (out_args.len == 0) { return raw_name; }
                return base + "::<" + out_args + ">";
            }
            let concrete_arg = self.canonical_type_text_in_current_env(raw_arg);
            if (concrete_arg.len == 0 || hir_builder_type_name_has_template_atom(concrete_arg)) {
                return raw_name;
            }
            self.ensure_concrete_type_text_ready(concrete_arg);
            out_args = hir_builder_append_csv(out_args, concrete_arg);
            i = i + 1;
        }
        return raw_name;
    }

    fn builtin_owner_type_for_expr(self, e: rawptr) -> i32 {
        if (e == null) { return hir_id_invalid(); }
        let k = expr_get_kind(e);
        if (k == ex_MEMBER()) {
            return self.type_id_from_expr(expr_get_lhs(e));
        }
        if (k == ex_CALL()) {
            let callee = expr_get_lhs(e);
            if (callee != null && expr_get_kind(callee) == ex_MEMBER()) {
                return self.type_id_from_expr(expr_get_lhs(callee));
            }
        }
        return hir_id_invalid();
    }

    fn member_name_for_expr(self, e: rawptr) -> string {
        if (e == null) { return ""; }
        if (expr_get_kind(e) == ex_CALL()) {
            let callee = expr_get_lhs(e);
            if (callee != null) { return expr_get_name(callee); }
        }
        return expr_get_name(e);
    }

    fn unresolved_trait_builtin_receiver_text(self, e: rawptr) -> string {
        let receiver = self.receiver_expr_for_call(e);
        if (receiver == null) { return ""; }
        return self.type_text_from_expr(receiver);
    }

    fn type_text_looks_concrete(self, text: string) -> bool {
        if (text.len == 0) { return false; }
        if (text.len == 1) {
            let c = text.charAt(0);
            if (c >= 65 && c <= 90) { return false; }
        }
        return true;
    }

    fn compare_builtin_receiver_supported(self, text: string) -> bool {
        let base = policy_generic_call_base(text.clone());
        if (hir_builder_is_primitive_str_name(base)) { return true; }
        if (base == "i32") { return true; }
        if (base == "i64") { return true; }
        if (base == "f32") { return true; }
        if (base == "f64") { return true; }
        if (base == "bool") { return true; }
        if (base == "char") { return true; }
        return false;
    }

    fn semantic_kind_for_expr(self, e: rawptr, sem_kind: i32) -> i32 {
        if (sem_kind != expr_sem_NONE()) { return sem_kind; }
        let name = self.member_name_for_expr(e);
        if (name != "hash" && name != "operator_eq" && name != "operator==" && name != "compare") { return sem_kind; }
        let recv_text = self.unresolved_trait_builtin_receiver_text(e);
        if (!self.type_text_looks_concrete(recv_text)) { return sem_kind; }
        if (name == "compare" && !self.compare_builtin_receiver_supported(recv_text)) { return sem_kind; }
        return expr_sem_BUILTIN();
    }

    fn target_id_for_expr(self, e: rawptr, sem_kind: i32, target_kind: i32) -> i32 {
        if (e == null) { return hir_id_invalid(); }
        if (target_kind == hir_target_local()) {
            let local_target = expr_get_semantic_target(e);
            let existing_local = hir_local_scope_lookup_target(self.locals, local_target);
            if (existing_local != hir_id_invalid()) { return existing_local; }
            let captured_local = self.ensure_capture_local(local_target);
            if (captured_local != hir_id_invalid()) { return captured_local; }
            let captured_by_name = self.ensure_capture_local_by_name(expr_get_name(e), local_target);
            if (captured_by_name != hir_id_invalid()) { return captured_by_name; }
            return hir_local_scope_lookup(self.locals, expr_get_name(e));
        }
        if (target_kind == hir_target_builtin()) {
            return self.unit.add_or_get_builtin(self.canonical_builtin_name_for_expr(e),
                                               sem_kind,
                                               self.builtin_owner_type_for_expr(e),
                                               expr_get_semantic_flags(e));
        }
        if (target_kind == hir_target_none()) {
            return hir_id_invalid();
        }
        if (target_kind == hir_target_type()) {
            return self.type_id_from_expr_semantic(e, sem_kind);
        }
        let raw_target = expr_get_semantic_target(e);
        // Template artifact bodies cannot serialize raw declaration pointers.
        // Rebind imported constants/globals from the validated value index by
        // name before giving up.  Keeping this path limited to value
        // semantics avoids turning arbitrary unresolved identifiers into
        // permissive rawptr values.
        if (raw_target == null
            && (sem_kind == expr_sem_CONST() || sem_kind == expr_sem_GLOBAL())) {
            let rebound_value = self.value_item_id_for_name(expr_get_name(e));
            if (rebound_value != hir_id_invalid()) { return rebound_value; }
            let rebound_decl = self.raw_value_decl_for_name(expr_get_name(e));
            if (rebound_decl != null) {
                let rebound_item = self.register_decl(rebound_decl, hir_id_invalid());
                if (rebound_item != hir_id_invalid()) { return rebound_item; }
            }
            return hir_id_invalid();
        }
        if (raw_target == null) { return hir_id_invalid(); }
        if (target_kind == hir_target_function()) {
            if (vyx_bootstrap_profile_level() > 2) {
                print("[hir-target-fn] direct-enter name=" + expr_get_name(e)
                      + " raw=" + decl_get_name(raw_target)
                      + " exprs=" + self.i32_text(self.unit.expr_count)
                      + " types=" + self.i32_text(self.unit.types.count));
            }
            let direct_closed = self.direct_closed_raw_function_target(raw_target);
            if (vyx_bootstrap_profile_level() > 2) {
                print("[hir-target-fn] direct-leave name=" + expr_get_name(e)
                      + " id=" + self.i32_text(direct_closed)
                      + " exprs=" + self.i32_text(self.unit.expr_count)
                      + " types=" + self.i32_text(self.unit.types.count));
            }
            if (direct_closed != hir_id_invalid()) { return direct_closed; }
            if (vyx_bootstrap_profile_level() > 2) {
                print("[hir-target-fn] concrete-enter name=" + expr_get_name(e)
                      + " raw=" + decl_get_name(raw_target)
                      + " exprs=" + self.i32_text(self.unit.expr_count)
                      + " types=" + self.i32_text(self.unit.types.count));
            }
            let concrete_fn = self.concrete_function_target(e, raw_target);
            if (vyx_bootstrap_profile_level() > 2) {
                print("[hir-target-fn] concrete-leave name=" + expr_get_name(e)
                      + " id=" + self.i32_text(concrete_fn)
                      + " exprs=" + self.i32_text(self.unit.expr_count)
                      + " types=" + self.i32_text(self.unit.types.count));
            }
            if (concrete_fn != hir_id_invalid()) { return concrete_fn; }
            var fn_id = hir_pointer_map_function(self.decl_map,raw_target);
            if (fn_id != hir_id_invalid()) {
                self.ensure_reachable_function_body(raw_target, fn_id, false);
                return fn_id;
            }
            self.register_decl(raw_target, hir_id_invalid());
            fn_id = hir_pointer_map_function(self.decl_map,raw_target);
            self.ensure_reachable_function_body(raw_target, fn_id, false);
            return fn_id;
        }
        if (target_kind == hir_target_field()) {
            let concrete_field = self.concrete_field_target(e, raw_target);
            if (concrete_field != hir_id_invalid()) { return concrete_field; }
        }
        if (target_kind == hir_target_variant()) {
            let concrete_variant = self.concrete_variant_target(e, raw_target);
            if (concrete_variant != hir_id_invalid()) { return concrete_variant; }
        }
        var item_id = hir_pointer_map_item(self.decl_map,raw_target);
        if (item_id != hir_id_invalid()) { return item_id; }
        item_id = self.register_decl(raw_target, hir_id_invalid());
        return item_id;
    }

    fn ensure_capture_local(self, target: rawptr) -> i32 {
        if (target == null || self.capture_source_head == null) { return hir_id_invalid(); }
        let existing = hir_local_scope_lookup_target(self.locals, target);
        if (existing != hir_id_invalid()) { return existing; }
        let source_node = hir_local_scope_find_node(self.capture_source_head, target);
        if (source_node == null) { return hir_id_invalid(); }
        return self.create_capture_local_from_source_node(source_node, target);
    }

    fn ensure_capture_local_by_name(self, name: string, target: rawptr) -> i32 {
        if (name.len == 0 || self.capture_source_head == null) { return hir_id_invalid(); }
        if (target != null) {
            let existing_target = hir_local_scope_lookup_target(self.locals, target);
            if (existing_target != hir_id_invalid()) { return existing_target; }
        }
        let existing_name = hir_local_scope_lookup(self.locals, name);
        if (existing_name != hir_id_invalid()) { return existing_name; }
        var source_node = hir_local_scope_find_node(self.capture_source_head, target);
        if (source_node == null) {
            source_node = hir_local_scope_find_node_by_name(self.capture_source_head, name);
        }
        if (source_node == null) { return hir_id_invalid(); }
        var capture_target = target;
        if (capture_target == null) { capture_target = hir_local_scope_node_target(source_node); }
        return self.create_capture_local_from_source_node(source_node, capture_target);
    }

    fn create_capture_local_from_source_node(self, source_node: rawptr, target: rawptr) -> i32 {
        if (source_node == null) { return hir_id_invalid(); }
        let cap_name = hir_local_scope_node_name(source_node);
        let cap_type = hir_local_scope_node_type(source_node);
        if (cap_name.len == 0 || cap_type == hir_id_invalid()) { return hir_id_invalid(); }
        let cap_local = self.unit.add_local(self.current_function_id, cap_name, cap_type, 2);
        self.unit.set_local_capture_source(cap_local, hir_local_scope_node_local(source_node));
        self.locals = hir_local_scope_push(self.locals,
                             cap_name,
                             cap_local,
                             cap_type,
                             self.current_function_id,
                             target);
        return cap_local;
    }

    fn preload_capture_target(self, target: rawptr) {
        if (target == null) { return; }
        if (hir_local_scope_lookup_target(self.locals, target) != hir_id_invalid()) { return; }
        self.ensure_capture_local(target);
    }

    fn preload_capture_expr(self, e: rawptr) {
        if (e == null) { return; }
        if (expr_get_semantic_kind(e) == expr_sem_LOCAL()) {
            let target = expr_get_semantic_target(e);
            if (target != null) {
                self.preload_capture_target(target);
            } else {
                self.ensure_capture_local_by_name(expr_get_name(e), null);
            }
        } elif (expr_get_kind(e) == ex_IDENT()) {
            self.ensure_capture_local_by_name(expr_get_name(e), expr_get_semantic_target(e));
        }
        let k = expr_get_kind(e);
        if (k == ex_BIN()
            || k == ex_ASSIGN()) {
            self.preload_capture_expr(expr_get_lhs(e));
            self.preload_capture_expr(expr_get_rhs(e));
            return;
        }
        if (k == ex_TERNARY()) {
            self.preload_capture_expr(expr_get_lhs(e));
            self.preload_capture_expr(expr_get_rhs(e));
            self.preload_capture_expr(expr_get_args(e));
            return;
        }
        if (k == ex_UNARY()
            || k == ex_ADDR_OF()
            || k == ex_DEREF()
            || k == ex_AWAIT()
            || k == ex_COMPTIME()
            || k == ex_FAIL()) {
            self.preload_capture_expr(expr_get_lhs(e));
            return;
        }
        if (k == ex_CALL()) {
            self.preload_capture_expr(expr_get_lhs(e));
            self.preload_capture_stmt_chain(expr_get_args(e));
            return;
        }
        if (k == ex_MEMBER()) {
            self.preload_capture_expr(expr_get_lhs(e));
            return;
        }
        if (k == ex_INDEX()) {
            self.preload_capture_expr(expr_get_lhs(e));
            self.preload_capture_expr(expr_get_rhs(e));
            return;
        }
        if (k == ex_STRUCT_INIT()
            || k == ex_FSTRING()
            || k == ex_TUPLE_LIT()
            || k == ex_INLINE_ASM()) {
            self.preload_capture_stmt_chain(expr_get_args(e));
            return;
        }
        if (k == ex_ARRAY_LIT()) {
            self.preload_capture_stmt_chain(expr_get_args(e));
            self.preload_capture_expr(expr_get_captures(e));
            return;
        }
        if (k == ex_CLOSURE()) {
            self.preload_capture_stmt_chain(expr_get_captures(e));
            self.preload_capture_stmt_chain(expr_get_lhs(e));
            return;
        }
        if (k == ex_IF_EXPR() || k == ex_MATCH_EXPR()) {
            self.preload_capture_expr(expr_get_lhs(e));
            if (k == ex_IF_EXPR()) {
                self.preload_capture_stmt(expr_get_rhs(e));
                let else_part = expr_get_args(e);
                if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
                    self.preload_capture_expr(else_part);
                } else {
                    self.preload_capture_stmt(else_part);
                }
            } else {
                var match_arm = expr_get_args(e);
                while (match_arm != null) {
                    self.preload_capture_expr(stmt_get_init(match_arm));
                    self.preload_capture_expr(stmt_get_cond(match_arm));
                    self.preload_capture_stmt(stmt_get_body(match_arm));
                    match_arm = stmt_get_next(match_arm);
                }
            }
            return;
        }
    }

    fn preload_capture_stmt(self, s: rawptr) {
        if (s == null) { return; }
        let k = stmt_get_kind(s);
        if (k == st_EXPR()) {
            self.preload_capture_expr(stmt_get_init(s));
            return;
        }
        if (k == st_LET() || k == st_VAR()) {
            self.preload_capture_expr(stmt_get_init(s));
            return;
        }
        if (k == st_RETURN()) {
            self.preload_capture_expr(stmt_get_init(s));
            return;
        }
        if (k == st_IF()) {
            self.preload_capture_expr(stmt_get_cond(s));
            self.preload_capture_stmt(stmt_get_then_blk(s));
            self.preload_capture_stmt(stmt_get_else_blk(s));
            return;
        }
        if (k == st_WHILE()) {
            self.preload_capture_expr(stmt_get_cond(s));
            self.preload_capture_stmt(stmt_get_body(s));
            return;
        }
        if (k == st_BLOCK()) {
            self.preload_capture_stmt_chain(stmt_get_body(s));
            return;
        }
        if (k == st_FOR()) {
            self.preload_capture_stmt(stmt_get_init(s));
            self.preload_capture_expr(stmt_get_cond(s));
            self.preload_capture_stmt(stmt_get_body(s));
            self.preload_capture_stmt(stmt_get_then_blk(s));
            return;
        }
        if (k == st_FOREACH()) {
            self.preload_capture_expr(stmt_get_cond(s));
            self.preload_capture_stmt(stmt_get_body(s));
            return;
        }
        if (k == st_MATCH()) {
            self.preload_capture_expr(stmt_get_init(s));
            var arm = stmt_get_body(s);
            while (arm != null) {
                self.preload_capture_expr(stmt_get_init(arm));
                self.preload_capture_expr(stmt_get_cond(arm));
                self.preload_capture_stmt(stmt_get_body(arm));
                arm = stmt_get_next(arm);
            }
            return;
        }
        if (k == st_DEFER()) {
            self.preload_capture_stmt(stmt_get_init(s));
            return;
        }
        if (k == st_STATIC_ASSERT()) {
            self.preload_capture_expr(stmt_get_cond(s));
            return;
        }
    }

    fn preload_capture_stmt_chain(self, head: rawptr) {
        var cur = head;
        while (cur != null) {
            self.preload_capture_stmt(cur);
            cur = stmt_get_next(cur);
        }
    }

    fn prepare_arg_expr_for_list(self, arg_expr_id: i32) {
        if (arg_expr_id == hir_id_invalid()) { return; }
        self.unit.set_expr_next_arg(arg_expr_id, hir_id_invalid());
    }

    fn append_arg_expr(self, owner_expr_id: i32, first_arg: i32, last_arg: i32, next_arg: i32) -> i32 {
        if (next_arg == hir_id_invalid()) { return last_arg; }
        self.prepare_arg_expr_for_list(next_arg);
        if (first_arg == hir_id_invalid()) {
            self.unit.set_expr_first_arg(owner_expr_id, next_arg);
        }
        if (last_arg != hir_id_invalid()) {
            self.unit.set_expr_next_arg(last_arg, next_arg);
        }
        return next_arg;
    }

    fn build_arg_cells(self, owner_expr_id: i32, head: rawptr) {
        var first_arg = hir_id_invalid();
        var last_arg = hir_id_invalid();
        var cur = head;
        while (cur != null) {
            let raw_arg_expr = stmt_get_init(cur);
            if (raw_arg_expr != null && expr_get_kind(raw_arg_expr) == ex_IDENT()) {
                let expanded_name = expr_get_name(raw_arg_expr);
                if (expanded_name.len > 3 && expanded_name.endsWith("...")) {
                    let pack_name = expanded_name.substring(0, expanded_name.len - 3);
                    if (hir_pack_bindings_find(self.pack_bindings, pack_name) != null) {
                        let pack_count = hir_pack_bindings_count(self.pack_bindings, pack_name);
                        var pack_index: i32 = 0;
                        while (pack_index < pack_count) {
                            let local_id = hir_pack_bindings_local_at(self.pack_bindings, pack_name, pack_index);
                            let expanded_arg = self.build_pack_local_read_expr(raw_arg_expr, local_id);
                            if (expanded_arg != hir_id_invalid()) {
                                self.unit.set_expr_arg_name(expanded_arg, stmt_get_name(cur));
                                last_arg = self.append_arg_expr(owner_expr_id,
                                                                first_arg,
                                                                last_arg,
                                                                expanded_arg);
                                if (first_arg == hir_id_invalid()) { first_arg = expanded_arg; }
                            }
                            pack_index = pack_index + 1;
                        }
                        cur = stmt_get_next(cur);
                        continue;
                    }
                }
            }
            let arg_expr = self.build_expr(raw_arg_expr);
            if (arg_expr != hir_id_invalid()) {
                self.prepare_arg_expr_for_list(arg_expr);
                self.unit.set_expr_arg_name(arg_expr, stmt_get_name(cur));
                if (first_arg == hir_id_invalid()) {
                    first_arg = arg_expr;
                    self.unit.set_expr_first_arg(owner_expr_id, arg_expr);
                }
                if (last_arg != hir_id_invalid()) {
                    self.unit.set_expr_next_arg(last_arg, arg_expr);
                }
                last_arg = arg_expr;
            }
            cur = stmt_get_next(cur);
        }
    }

    fn last_arg_expr(self, owner_expr_id: i32) -> i32 {
        var cur = self.unit.expr_first_arg(owner_expr_id);
        var last = hir_id_invalid();
        var guard: i32 = 0;
        while (cur != hir_id_invalid() && guard <= self.unit.expr_count + 2) {
            last = cur;
            cur = self.unit.expr_next_arg(cur);
            guard = guard + 1;
        }
        return last;
    }

    fn hir_call_named_arg_for_param(self, first_arg_id: i32, param_name: string) -> i32 {
        if (param_name.len == 0) { return hir_id_invalid(); }
        var cur = first_arg_id;
        var guard: i32 = 0;
        while (cur != hir_id_invalid() && guard <= self.unit.expr_count + 2) {
            if (hir_unit_expr_arg_name(self.unit, cur) == param_name) { return cur; }
            cur = self.unit.expr_next_arg(cur);
            guard = guard + 1;
        }
        return hir_id_invalid();
    }

    fn next_positional_call_arg(self, start_arg_id: i32) -> i32 {
        var cur = start_arg_id;
        var guard: i32 = 0;
        while (cur != hir_id_invalid() && guard <= self.unit.expr_count + 2) {
            if (hir_unit_expr_arg_name(self.unit, cur).len == 0) { return cur; }
            cur = self.unit.expr_next_arg(cur);
            guard = guard + 1;
        }
        return hir_id_invalid();
    }

    fn append_default_call_arg(self,
                                      owner_expr_id: i32,
                                      param_name: string,
                                      default_stmt: rawptr,
                                      first_arg_id: i32,
                                      last_arg_id: i32) -> i32 {
        if (default_stmt == null) { return last_arg_id; }
        let default_expr = stmt_get_init(default_stmt);
        if (default_expr == null) { return last_arg_id; }
        let default_arg_id = self.build_expr(default_expr);
        if (default_arg_id == hir_id_invalid()) { return last_arg_id; }
        self.unit.set_expr_arg_name(default_arg_id, param_name);
        return self.append_arg_expr(owner_expr_id, first_arg_id, last_arg_id, default_arg_id);
    }

    fn materialize_default_call_args(self, owner_expr_id: i32, raw_target: rawptr) {
        if (owner_expr_id == hir_id_invalid() || raw_target == null) { return; }
        var first_arg = self.unit.expr_first_arg(owner_expr_id);
        var last_arg = self.last_arg_expr(owner_expr_id);
        var positional = first_arg;
        var param = decl_get_params(raw_target);
        while (param != null) {
            let param_name = decl_get_name(param);
            if (param_name != "self") {
                var has_arg = false;
                if (self.hir_call_named_arg_for_param(first_arg, param_name) != hir_id_invalid()) {
                    has_arg = true;
                } else {
                    let positional_arg = self.next_positional_call_arg(positional);
                    if (positional_arg != hir_id_invalid()) {
                        has_arg = true;
                        positional = self.unit.expr_next_arg(positional_arg);
                    }
                }
                if (!has_arg && decl_get_body(param) != null) {
                    last_arg = self.append_default_call_arg(owner_expr_id,
                                                            param_name,
                                                            decl_get_body(param),
                                                            first_arg,
                                                            last_arg);
                    if (first_arg == hir_id_invalid()) {
                        first_arg = self.unit.expr_first_arg(owner_expr_id);
                    }
                }
            }
            param = decl_get_next(param);
        }
    }

    fn field_id_for_type_and_name(self, owner_type_id: i32, field_name: string) -> i32 {
        self.profile_field_lookup_calls = self.profile_field_lookup_calls + 1;
        if (owner_type_id == hir_id_invalid() || field_name.len == 0) { return hir_id_invalid(); }
        if (self.type_id_is_valid(owner_type_id)) {
            let owner_type_name = hir_type_table_text(self.unit.types, owner_type_id);
            let owner_has_generic_args = policy_generic_call_args(owner_type_name.clone()).len > 0;
            let owner_is_closed_generic = owner_has_generic_args
                && !self.type_text_has_open_template_atom(owner_type_name);
            let indexed_exact = hir_pair_id_map_get(self.field_index,owner_type_name, field_name);
            if (indexed_exact != hir_id_invalid()) { return indexed_exact; }
            if (owner_is_closed_generic) {
                self.ensure_concrete_type_text_ready(owner_type_name);
                let indexed_after_ready = hir_pair_id_map_get(self.field_index,owner_type_name, field_name);
                if (indexed_after_ready != hir_id_invalid()) { return indexed_after_ready; }
            }
            var exact_item_id: i32 = 1;
            while (exact_item_id <= self.unit.item_count) {
                if (self.unit.item_kind(exact_item_id) == hir_item_field()
                    && self.unit.item_name(exact_item_id) == field_name) {
                    let exact_owner_item = self.unit.item_owner(exact_item_id);
                    if (exact_owner_item != hir_id_invalid()
                        && self.type_id_for_item(exact_owner_item) == owner_type_id) {
                        return exact_item_id;
                    }
                }
                exact_item_id = exact_item_id + 1;
            }
            if (owner_is_closed_generic) { return hir_id_invalid(); }
            let owner_base = hir_builder_type_base_name(owner_type_name);
            if (owner_base.len > 0) {
                let indexed = hir_pair_id_map_get(self.field_index,owner_base, field_name);
                if (indexed != hir_id_invalid()) { return indexed; }
                let owner_last = hir_builder_last_path_segment(owner_base);
                if (owner_last.len > 0) {
                    let indexed_last = hir_pair_id_map_get(self.field_index,owner_last, field_name);
                    if (indexed_last != hir_id_invalid()) { return indexed_last; }
                }
            }
            if (owner_has_generic_args) {
                var item_id_generic: i32 = 1;
                while (item_id_generic <= self.unit.item_count) {
                    if (self.unit.item_kind(item_id_generic) == hir_item_field()
                        && self.unit.item_name(item_id_generic) == field_name) {
                        let owner_item_generic = self.unit.item_owner(item_id_generic);
                        if (owner_item_generic != hir_id_invalid()
                            && self.type_id_for_item(owner_item_generic) == owner_type_id) {
                            return item_id_generic;
                        }
                    }
                    item_id_generic = item_id_generic + 1;
                }
                return hir_id_invalid();
            }
        }
        var item_id: i32 = 1;
        while (item_id <= self.unit.item_count) {
            if (self.unit.item_kind(item_id) == hir_item_field()
                && self.unit.item_name(item_id) == field_name) {
                let owner_item = self.unit.item_owner(item_id);
                if (owner_item != hir_id_invalid()
                    && self.type_id_for_item(owner_item) == owner_type_id) {
                    return item_id;
                }
            }
            item_id = item_id + 1;
        }
        return hir_id_invalid();
    }

    // Associated constants are value items rather than instance fields, so
    // field lookup intentionally excludes them. Resolve them from a concrete
    // receiver type during deferred HIR closure (for example `T::MAX` after
    // a generic `T` is instantiated) and retain the declared value type.
    fn member_value_item_id_for_type_and_name(self, owner_type_id: i32, name: string) -> i32 {
        if (!self.type_id_is_valid(owner_type_id) || name.len == 0) {
            return hir_id_invalid();
        }
        var item_id: i32 = 1;
        while (item_id <= self.unit.item_count) {
            let kind = self.unit.item_kind(item_id);
            if ((kind == hir_item_const() || kind == hir_item_global())
                && self.unit.item_name(item_id) == name) {
                let owner_item = self.unit.item_owner(item_id);
                if (owner_item != hir_id_invalid()
                    && self.type_id_for_item(owner_item) == owner_type_id) {
                    return item_id;
                }
            }
            item_id = item_id + 1;
        }
        return hir_id_invalid();
    }

    fn type_id_is_valid(self, type_id: i32) -> bool {
        // Reject nonpositive IDs before indexing the HIR type table.
        return type_id > hir_id_invalid() && type_id <= self.unit.types.count;
    }

    fn type_id_has_template_atom(self, type_id: i32) -> bool {
        if (!self.type_id_is_valid(type_id)) { return false; }
        return self.type_text_has_open_template_atom(hir_type_table_text(self.unit.types, type_id));
    }

    fn expr_type_needs_concrete(self, expr_id: i32) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        let type_id = self.unit.expr_type(expr_id);
        return !self.type_id_is_valid(type_id) || self.type_id_has_template_atom(type_id);
    }

    fn set_expr_type_if_empty(self, expr_id: i32, type_id: i32) {
        if (expr_id == hir_id_invalid() || !self.type_id_is_valid(type_id)) { return; }
        if (!self.type_id_is_valid(self.unit.expr_type(expr_id))) {
            self.unit.set_expr_type(expr_id, type_id);
        }
    }

    fn set_expr_type_canonical(self, expr_id: i32, type_id: i32) {
        if (expr_id == hir_id_invalid() || !self.type_id_is_valid(type_id)) { return; }
        self.unit.set_expr_type(expr_id, type_id);
    }

    fn builtin_bool_type_id(self) -> i32 {
        return self.type_id_from_text("bool");
    }

    fn builtin_i32_type_id(self) -> i32 {
        return self.type_id_from_text("i32");
    }

    fn builtin_i64_type_id(self) -> i32 {
        return self.type_id_from_text("i64");
    }

    fn builtin_f32_type_id(self) -> i32 {
        return self.type_id_from_text("f32");
    }

    fn builtin_f64_type_id(self) -> i32 {
        return self.type_id_from_text("f64");
    }

    fn builtin_str_type_id(self) -> i32 {
        return self.type_id_from_text("str");
    }

    fn builtin_char_type_id(self) -> i32 {
        return self.type_id_from_text("char");
    }

    fn builtin_rawptr_type_id(self) -> i32 {
        return self.type_id_from_text("rawptr");
    }

    fn resolve_literal_expr_type_after_create(self, expr_id: i32, kind: i32) {
        if (kind == ex_INT_LIT()) {
            if (hir_builder_lit_is_float(self.unit.expr_value_text(expr_id))) {
                self.set_expr_type_if_empty(expr_id, self.builtin_f64_type_id());
                return;
            }
            self.set_expr_type_if_empty(expr_id, self.builtin_i64_type_id());
            return;
        }
        if (kind == ex_BOOL_LIT()) {
            self.set_expr_type_if_empty(expr_id, self.builtin_bool_type_id());
            return;
        }
        if (kind == ex_STR_LIT() || kind == ex_FSTRING()) {
            self.set_expr_type_if_empty(expr_id, self.builtin_str_type_id());
            return;
        }
        if (kind == ex_CHAR_LIT()) {
            self.set_expr_type_if_empty(expr_id, self.builtin_char_type_id());
            return;
        }
        if (kind == ex_NULL_LIT()) {
            self.set_expr_type_if_empty(expr_id, self.builtin_rawptr_type_id());
        }
    }

    fn binary_op_returns_bool(self, op: i32) -> bool {
        if (op == tk_EQEQ() || op == tk_NEQ()) { return true; }
        if (op == tk_LT() || op == tk_LE() || op == tk_GT() || op == tk_GE()) { return true; }
        if (op == tk_AND() || op == tk_OR()) { return true; }
        if (op == tk_MATCHOP()) { return true; }
        return false;
    }

    fn binary_op_is_arithmetic(self, op: i32) -> bool {
        if (op == tk_PLUS() || op == tk_MINUS()) { return true; }
        if (op == tk_STAR() || op == tk_SLASH() || op == tk_PERCENT()) { return true; }
        return false;
    }

    fn binary_op_is_bitwise(self, op: i32) -> bool {
        if (op == tk_AMP() || op == tk_PIPE() || op == tk_CARET()) { return true; }
        return false;
    }

    fn binary_op_is_shift(self, op: i32) -> bool {
        return op == tk_LSHIFT() || op == tk_RSHIFT();
    }

    fn type_id_kind_or_unknown(self, type_id: i32) -> i32 {
        if (!self.type_id_is_valid(type_id)) { return hir_type_unknown(); }
        return hir_type_table_kind(self.unit.types, type_id);
    }

    fn type_kind_is_signed_int_id(self, kind: i32) -> bool {
        if (kind == ty_I8() || kind == ty_I16() || kind == ty_I32() || kind == ty_I64()) { return true; }
        return kind == ty_ISIZE();
    }

    fn type_kind_is_unsigned_int_id(self, kind: i32) -> bool {
        if (kind == ty_CHAR()) { return true; }
        if (kind == ty_U8() || kind == ty_U16() || kind == ty_U32() || kind == ty_U64()) { return true; }
        return kind == ty_USIZE();
    }

    fn type_kind_is_int_id(self, kind: i32) -> bool {
        if (kind == ty_CHAR()) { return true; }
        if (self.type_kind_is_signed_int_id(kind)) { return true; }
        return self.type_kind_is_unsigned_int_id(kind);
    }

    fn type_kind_int_bits_id(self, kind: i32) -> i32 {
        if (kind == ty_BOOL()) { return 8; }
        if (kind == ty_CHAR()) { return 32; }
        if (kind == ty_I8() || kind == ty_U8()) { return 8; }
        if (kind == ty_I16() || kind == ty_U16()) { return 16; }
        if (kind == ty_I32() || kind == ty_U32()) { return 32; }
        if (kind == ty_I64() || kind == ty_U64()) { return 64; }
        if (kind == ty_ISIZE() || kind == ty_USIZE()) { return 64; }
        return 0;
    }

    fn type_kind_is_float_id(self, kind: i32) -> bool {
        return kind == ty_F32() || kind == ty_F64();
    }

    fn type_id_is_floatish(self, type_id: i32) -> bool {
        let kind = self.type_id_kind_or_unknown(type_id);
        if (self.type_kind_is_float_id(kind)) { return true; }
        if (kind == ty_CLASS()) {
            let text = hir_type_table_text(self.unit.types, type_id);
            return text == "f32" || text == "f64";
        }
        return false;
    }

    fn type_id_is_string(self, type_id: i32) -> bool {
        if (!self.type_id_is_valid(type_id)) { return false; }
        if (self.type_id_kind_or_unknown(type_id) == ty_STRING()) { return true; }
        return hir_builder_is_primitive_str_name(hir_type_table_text(self.unit.types, type_id));
    }

    fn type_id_float_bits(self, type_id: i32) -> i32 {
        let kind = self.type_id_kind_or_unknown(type_id);
        if (kind == ty_F32()) { return 32; }
        if (kind == ty_F64()) { return 64; }
        if (kind == ty_CLASS()) {
            let text = hir_type_table_text(self.unit.types, type_id);
            if (text == "f32") { return 32; }
            if (text == "f64") { return 64; }
        }
        return 0;
    }

    fn numeric_integer_result_type_id(self, lhs_type: i32, rhs_type: i32) -> i32 {
        let lhs_kind = self.type_id_kind_or_unknown(lhs_type);
        let rhs_kind = self.type_id_kind_or_unknown(rhs_type);
        if (lhs_kind == rhs_kind && self.type_kind_is_int_id(lhs_kind)) { return lhs_type; }
        let lhs_bits = self.type_kind_int_bits_id(lhs_kind);
        let rhs_bits = self.type_kind_int_bits_id(rhs_kind);
        if (rhs_bits > lhs_bits && rhs_bits > 0) { return rhs_type; }
        if (lhs_bits > 0) { return lhs_type; }
        return self.builtin_i32_type_id();
    }

    fn numeric_float_result_type_id(self, lhs_type: i32, rhs_type: i32) -> i32 {
        let lhs_bits = self.type_id_float_bits(lhs_type);
        let rhs_bits = self.type_id_float_bits(rhs_type);
        if (lhs_bits >= rhs_bits && lhs_bits > 0) {
            if (lhs_bits == 32) { return self.builtin_f32_type_id(); }
            return self.builtin_f64_type_id();
        }
        if (rhs_bits > 0) {
            if (rhs_bits == 32) { return self.builtin_f32_type_id(); }
            return self.builtin_f64_type_id();
        }
        return self.builtin_f64_type_id();
    }

    fn resolve_binary_result_type_id(self, op: i32, lhs_type: i32, rhs_type: i32) -> i32 {
        if (op == tk_PIPEARROW()) { return rhs_type; }
        if (op == tk_QUESTIONQUESTION()) { return lhs_type; }
        if (op == tk_DOTDOT() || op == tk_DOTDOTEQ()) { return self.type_id_from_text("Range"); }
        if (self.binary_op_returns_bool(op)) { return self.builtin_bool_type_id(); }
        if (!self.type_id_is_valid(lhs_type) || !self.type_id_is_valid(rhs_type)) { return hir_id_invalid(); }

        let lhs_kind = self.type_id_kind_or_unknown(lhs_type);
        let rhs_kind = self.type_id_kind_or_unknown(rhs_type);
        let lhs_is_int = self.type_kind_is_int_id(lhs_kind);
        let rhs_is_int = self.type_kind_is_int_id(rhs_kind);
        let lhs_is_float = self.type_id_is_floatish(lhs_type);
        let rhs_is_float = self.type_id_is_floatish(rhs_type);

        if (op == tk_PLUS()
            && self.type_id_is_string(lhs_type)
            && self.type_id_is_string(rhs_type)) {
            return self.builtin_str_type_id();
        }

        if (self.binary_op_is_arithmetic(op)) {
            if ((lhs_is_float && (rhs_is_float || rhs_is_int))
                || (rhs_is_float && lhs_is_int)) {
                return self.numeric_float_result_type_id(lhs_type, rhs_type);
            }
            if ((op == tk_PLUS() || op == tk_MINUS())
                && lhs_kind == ty_RAWPTR()
                && rhs_is_int) {
                return self.builtin_rawptr_type_id();
            }
            if (op == tk_PLUS()
                && rhs_kind == ty_RAWPTR()
                && lhs_is_int) {
                return self.builtin_rawptr_type_id();
            }
            if (lhs_is_int && rhs_is_int) {
                return self.numeric_integer_result_type_id(lhs_type, rhs_type);
            }
        }

        if (self.binary_op_is_bitwise(op)) {
            if (lhs_is_int && rhs_is_int) {
                return self.numeric_integer_result_type_id(lhs_type, rhs_type);
            }
        }

        if (self.binary_op_is_shift(op)) {
            if (lhs_is_int && rhs_is_int) { return lhs_type; }
        }

        return hir_id_invalid();
    }

    fn resolve_binary_expr_type_after_children(self, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        let op = self.unit.expr_op(expr_id);
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        let rhs_type = self.unit.expr_type(self.unit.expr_rhs(expr_id));
        let bintype_trace = hir_builder_env_enabled("VYX_TRACE_BINTYPE");
        if (bintype_trace) {
            print("[bintype] expr=" + policy_i64_to_string(expr_id as i64)
                  + " op=" + policy_i64_to_string(op as i64)
                  + " lhs=" + (self.type_id_is_valid(lhs_type) ? hir_type_table_text(self.unit.types, lhs_type) : "<inv>")
                  + " rhs=" + (self.type_id_is_valid(rhs_type) ? hir_type_table_text(self.unit.types, rhs_type) : "<inv>")
                  + " cur=" + (self.type_id_is_valid(self.unit.expr_type(expr_id)) ? hir_type_table_text(self.unit.types, self.unit.expr_type(expr_id)) : "<empty>"));
        }
        if (op == tk_MINUS()
            && self.type_id_kind_or_unknown(lhs_type) == ty_RAWPTR()
            && self.type_id_kind_or_unknown(rhs_type) == ty_RAWPTR()) {
            self.set_expr_type_canonical(expr_id, self.builtin_i64_type_id());
            return;
        }
        let resolved_type = self.resolve_binary_result_type_id(op, lhs_type, rhs_type);
        if (self.type_id_is_valid(resolved_type)) {
            self.set_expr_type_canonical(expr_id, resolved_type);
            if (bintype_trace) {
                print("[bintype] expr=" + policy_i64_to_string(expr_id as i64) + " resolved=" + hir_type_table_text(self.unit.types, resolved_type));
            }
            return;
        }
        if (self.type_id_is_valid(lhs_type)) {
            // An earlier typing pass may have provisionally taken the rhs type
            // because the lhs operand was untyped at the time (index-operator
            // consumer resolution can start building the instance body before
            // its member exprs are typed).  That provisional type sticks
            // because set_expr_type_if_empty refuses to overwrite, so correct
            // it here now that the lhs type is known.
            if (self.provisional_binary_rhs_map != null
                && hir_i32_array_map_get(self.provisional_binary_rhs_map, expr_id) > 0) {
                self.set_expr_type_canonical(expr_id, lhs_type);
                if (bintype_trace) {
                    print("[bintype] expr=" + policy_i64_to_string(expr_id as i64) + " corrected-provisional -> " + hir_type_table_text(self.unit.types, lhs_type));
                }
                return;
            }
            self.set_expr_type_if_empty(expr_id, lhs_type);
            if (bintype_trace) {
                print("[bintype] expr=" + policy_i64_to_string(expr_id as i64) + " fallback-lhs final=" + (self.type_id_is_valid(self.unit.expr_type(expr_id)) ? hir_type_table_text(self.unit.types, self.unit.expr_type(expr_id)) : "<empty>"));
            }
            return;
        }
        if (self.type_id_is_valid(rhs_type)) {
            self.set_expr_type_if_empty(expr_id, rhs_type);
            if (self.binary_op_is_arithmetic(op)) {
                self.provisional_binary_rhs_map = hir_i32_array_map_put(self.provisional_binary_rhs_map,
                                                                        expr_id,
                                                                        1);
            }
            if (bintype_trace) {
                print("[bintype] expr=" + policy_i64_to_string(expr_id as i64) + " provisional-rhs=" + hir_type_table_text(self.unit.types, rhs_type));
            }
        }
        if (bintype_trace) {
            print("[bintype] expr=" + policy_i64_to_string(expr_id as i64) + " final=" + (self.type_id_is_valid(self.unit.expr_type(expr_id)) ? hir_type_table_text(self.unit.types, self.unit.expr_type(expr_id)) : "<empty>"));
        }
    }

    fn resolve_assign_expr_type_after_children(self, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        let rhs_type = self.unit.expr_type(self.unit.expr_rhs(expr_id));
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        if (self.type_id_is_valid(rhs_type)) {
            self.set_expr_type_if_empty(expr_id, rhs_type);
            return;
        }
        if (self.type_id_is_valid(lhs_type)) {
            self.set_expr_type_if_empty(expr_id, lhs_type);
        }
    }

    fn assign_method_name_for_op(self, op: i32) -> string {
        if (op == tk_EQ()) { return "operator="; }
        if (op == tk_PLUSEQ()) { return "operator+="; }
        if (op == tk_MINUSEQ()) { return "operator-="; }
        if (op == tk_STAREQ()) { return "operator*="; }
        if (op == tk_SLASHEQ()) { return "operator/="; }
        if (op == tk_PERCENTEQ()) { return "operator%="; }
        if (op == tk_AMPEQ()) { return "operator&="; }
        if (op == tk_PIPEEQ()) { return "operator|="; }
        if (op == tk_CARETEQ()) { return "operator^="; }
        if (op == tk_LSHIFTEQ()) { return "operator<<="; }
        if (op == tk_RSHIFTEQ()) { return "operator>>="; }
        return "";
    }

    fn method_name_is_value_assign(self, name: string) -> bool {
        if (name == "operator_add_assign" || name == "operator+=") { return true; }
        if (name == "operator_sub_assign" || name == "operator-=") { return true; }
        if (name == "operator_mul_assign" || name == "operator*=") { return true; }
        if (name == "operator_div_assign" || name == "operator/=") { return true; }
        if (name == "operator_mod_assign" || name == "operator%=") { return true; }
        if (name == "operator_band_assign" || name == "operator&=") { return true; }
        if (name == "operator_bor_assign" || name == "operator|=") { return true; }
        if (name == "operator_bxor_assign" || name == "operator^=") { return true; }
        if (name == "operator_shl_assign" || name == "operator<<=") { return true; }
        if (name == "operator_shr_assign" || name == "operator>>=") { return true; }
        return false;
    }

    fn type_id_is_pointer_like(self, type_id: i32) -> bool {
        if (!self.type_id_is_valid(type_id)) { return false; }
        let kind = hir_type_table_kind(self.unit.types, type_id);
        if (kind == ty_RAWPTR() || kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) { return true; }
        return false;
    }

    fn member_lookup_type_id(self, type_id: i32) -> i32 {
        if (!self.type_id_is_valid(type_id)) { return hir_id_invalid(); }
        let kind = hir_type_table_kind(self.unit.types, type_id);
        if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
            let elem = hir_type_table_elem(self.unit.types, type_id);
            if (self.type_id_is_valid(elem)
                && hir_type_table_kind(self.unit.types, elem) == ty_CLASS()) {
                return elem;
            }
        }
        return type_id;
    }

    fn member_lookup_type_name(self, type_id: i32) -> string {
        let lookup_type = self.member_lookup_type_id(type_id);
        if (!self.type_id_is_valid(lookup_type)) { return ""; }
        let raw = hir_type_table_text(self.unit.types, lookup_type);
        let resolved = self.resolve_type_text_in_current_env(raw);
        if (resolved.len > 0) { return resolved; }
        return raw;
    }

    fn type_text_is_reflect_instance(self, text: string) -> bool {
        return text == "std.reflect.Instance";
    }

    fn synthetic_method_call_expr(self, receiver: rawptr, method_name: string, arg: rawptr) -> rawptr {
        if (receiver == null || method_name.len == 0) { return null; }
        let member = expr_alloc(ex_MEMBER());
        if (member == null) { return null; }
        expr_set_lhs(member, receiver);
        expr_set_name(member, method_name);
        let call = expr_alloc(ex_CALL());
        if (call == null) { return null; }
        expr_set_lhs(call, member);
        if (arg != null) {
            let cell = stmt_alloc(st_EXPR());
            if (cell == null) { return null; }
            stmt_set_init(cell, arg);
            expr_set_args(call, cell);
        }
        return call;
    }

    fn build_empty_struct_init_new_call(self, e: rawptr) -> i32 {
        if (e == null || expr_get_kind(e) != ex_STRUCT_INIT() || expr_get_args(e) != null) {
            return hir_id_invalid();
        }
        let type_name = expr_get_name(e);
        if (type_name.len == 0) { return hir_id_invalid(); }
        let resolved = self.resolve_type_text_in_current_env(type_name);
        if (resolved.len == 0 || self.type_text_has_open_template_atom(resolved)) {
            return hir_id_invalid();
        }
        if (self.raw_class_decl_for_type_text(resolved) == null) { return hir_id_invalid(); }
        var new_decl = self.raw_static_method_decl_for_type_text(resolved, "new");
        if (new_decl == null) {
            new_decl = self.raw_template_method_decl_for_type_text(resolved, "new", true);
        }
        if (new_decl == null) { return hir_id_invalid(); }
        let receiver = expr_alloc(ex_IDENT());
        if (receiver == null) { return hir_id_invalid(); }
        expr_set_name(receiver, type_name);
        let call = self.synthetic_method_call_expr(receiver, "new", null);
        if (call == null) { return hir_id_invalid(); }
        return self.build_expr(call);
    }

    /// Container list initialization: `Vec<i32>{1, 2, 3}` parses as a
    /// struct-init whose cells are all positional (empty cell names).  When
    /// the resolved class exposes a static `from_array(items: *T, n: i64)`,
    /// rewrite the literal — at the AST level, before any HIR expr is
    /// allocated — into `Type::from_array([e1, ..., en], n)`.  Going through
    /// a real synthetic call (instead of a MIR-level desugar) means the
    /// ordinary call-resolution path materializes the `from_array` instance
    /// on demand and applies the array-literal → `*T` decay, so the method
    /// never needs to have been called elsewhere first.
    /// Returns invalid for named-field inits and for classes without
    /// `from_array` (those keep the aggregate / positional-field path).
    fn build_container_list_init_from_array_call(self, e: rawptr) -> i32 {
        if (e == null || expr_get_kind(e) != ex_STRUCT_INIT() || expr_get_args(e) == null) {
            return hir_id_invalid();
        }
        // Every cell must be positional (empty name) with a value; a mixed
        // named/positional init falls back to the aggregate path so sema
        // reports the field mismatch normally.
        var cell = expr_get_args(e);
        var count: i64 = 0;
        while (cell != null) {
            if (stmt_get_name(cell).len > 0) { return hir_id_invalid(); }
            if (stmt_get_init(cell) == null) { return hir_id_invalid(); }
            count = count + 1;
            cell = stmt_get_next(cell);
        }
        let type_name = expr_get_name(e);
        if (type_name.len == 0) { return hir_id_invalid(); }
        let resolved = self.resolve_type_text_in_current_env(type_name);
        if (resolved.len == 0 || self.type_text_has_open_template_atom(resolved)) {
            return hir_id_invalid();
        }
        if (self.raw_class_decl_for_type_text(resolved) == null) { return hir_id_invalid(); }
        if (self.raw_static_method_decl_for_type_text(resolved, "from_array") == null) {
            return hir_id_invalid();
        }
        let call = hir_native_init_array_call(type_name, expr_get_args(e), count);
        if (call == null) { return hir_id_invalid(); }
        return self.build_expr(call);
    }

    fn concrete_assignment_method_target(self,
                                                assign_expr_id: i32,
                                                owner_type_text: string,
                                                method_name: string) -> i32 {
        if (assign_expr_id == hir_id_invalid() || owner_type_text.len == 0 || method_name.len == 0) {
            return hir_id_invalid();
        }
        var method_decl = self.raw_method_decl_for_type_text(owner_type_text, method_name);
        if (method_decl == null) {
            method_decl = self.raw_template_method_decl_for_type_text(owner_type_text, method_name, false);
        }
        if (method_decl == null) { return hir_id_invalid(); }
        // Assignment children have already been inferred.  Resolve the
        // generic method from their HIR types so overload closure never
        // depends on the raw AST TypeRef carried by a temporary synthetic
        // call node.
        return self.ensure_method_instance_for_call(owner_type_text,
                                                    method_name,
                                                    null,
                                                    assign_expr_id,
                                                    method_decl,
                                                    false);
    }

    fn resolve_assignment_method_after_children(self, source_assign: rawptr, expr_id: i32) {
        if (source_assign == null || expr_id == hir_id_invalid()) { return; }
        let lhs_id = self.unit.expr_lhs(expr_id);
        let rhs_id = self.unit.expr_rhs(expr_id);
        if (lhs_id == hir_id_invalid() || rhs_id == hir_id_invalid()) { return; }
        let lhs_type = self.unit.expr_type(lhs_id);
        if (!self.type_id_is_valid(lhs_type)) { return; }
        let lhs_text = hir_type_table_text(self.unit.types, lhs_type);
        if (lhs_text.len == 0 || hir_builder_type_name_has_template_atom(lhs_text)) { return; }
        var method_name = "";
        if (self.type_text_is_reflect_instance(lhs_text) && self.unit.expr_op(expr_id) == tk_EQ()) {
            if (self.type_id_is_pointer_like(self.unit.expr_type(rhs_id))) {
                method_name = "rebindRaw";
            } else {
                method_name = "assign";
            }
        } else {
            method_name = self.assign_method_name_for_op(self.unit.expr_op(expr_id));
        }
        if (method_name.len == 0) { return; }
        let target_fn = self.concrete_assignment_method_target(expr_id, lhs_text, method_name);
        if (target_fn == hir_id_invalid()) { return; }
        self.unit.set_expr_semantic(expr_id, expr_sem_METHOD(), hir_target_function(), target_fn);
        let ret_type = self.unit.function_return_type(target_fn);
        if (self.type_id_is_valid(ret_type)) {
            self.unit.set_expr_type(expr_id, ret_type);
        }
    }

    fn resolve_unary_expr_type_after_child(self, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        if (self.unit.expr_op(expr_id) == tk_NOT()) {
            self.set_expr_type_if_empty(expr_id, self.builtin_bool_type_id());
            return;
        }
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        if (self.type_id_is_valid(lhs_type)) {
            self.set_expr_type_if_empty(expr_id, lhs_type);
        }
    }

    fn resolve_single_child_expr_type_after_child(self, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        if (self.type_id_is_valid(lhs_type)) {
            self.set_expr_type_if_empty(expr_id, lhs_type);
        }
    }

    fn resolve_addr_of_expr_type(self, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        if (self.type_id_is_valid(lhs_type)) {
            var kind = ty_REF();
            var prefix = "ref";
            if (self.unit.expr_op(expr_id) != 0) {
                kind = ty_MUTREF();
                prefix = "mutref";
            }
            let elem_text = hir_type_table_text(self.unit.types, lhs_type);
            let ptr_id = self.unit.types.intern(kind,
                                               prefix + "<" + elem_text + ">",
                                               lhs_type,
                                               0);
            if (self.type_id_is_valid(ptr_id)) {
                self.set_expr_type_if_empty(expr_id, ptr_id);
                return;
            }
        }
        self.set_expr_type_if_empty(expr_id, self.builtin_rawptr_type_id());
    }

    fn resolve_deref_expr_type_after_child(self, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        if (self.type_id_is_valid(lhs_type)) {
            let elem = hir_type_table_elem(self.unit.types, lhs_type);
            if (self.type_id_is_valid(elem)) {
                self.set_expr_type_if_empty(expr_id, elem);
                return;
            }
        }
        self.set_expr_type_if_empty(expr_id, self.builtin_rawptr_type_id());
    }

    fn index_operator_value_type_from_return(self, return_type: i32) -> i32 {
        if (!self.type_id_is_valid(return_type)) { return hir_id_invalid(); }
        let ret_text = hir_type_table_text(self.unit.types, return_type);
        let ret_base = policy_generic_call_base(ret_text.clone());
        let k = hir_type_table_kind(self.unit.types, return_type);
        if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()
            || ret_base == "ptr" || ret_base == "ref" || ret_base == "mutref") {
            let elem = hir_type_table_elem(self.unit.types, return_type);
            if (self.type_id_is_valid(elem)) {
                let elem_text = hir_type_table_text(self.unit.types, elem);
                if (elem_text.len > 0 && !hir_builder_type_name_has_template_atom(elem_text)) {
                    return elem;
                }
            }
            let args = policy_generic_call_args(ret_text.clone());
            let arg0 = policy_generic_arg_at(args, 0);
            if (arg0.len > 0 && !hir_builder_type_name_has_template_atom(arg0)) {
                return self.type_id_from_text(arg0);
            }
            if (self.type_id_is_valid(elem)) { return elem; }
        }
        return return_type;
    }

    fn concrete_index_method_target(self, index_expr_id: i32, owner_type_text: string) -> i32 {
        if (index_expr_id == hir_id_invalid() || owner_type_text.len == 0) { return hir_id_invalid(); }
        var method_decl = self.raw_method_decl_for_type_text(owner_type_text, "operator[]");
        if (method_decl == null) {
            method_decl = self.raw_template_method_decl_for_type_text(owner_type_text, "operator[]", false);
        }
        if (method_decl == null) { return hir_id_invalid(); }
        return self.ensure_method_instance_for_call(owner_type_text,
                                                    "operator[]",
                                                    null,
                                                    index_expr_id,
                                                    method_decl,
                                                    false);
    }

    fn resolve_index_expr_type_after_children(self, source_index: rawptr, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        if (!self.type_id_is_valid(lhs_type)) { return; }
        let lhs_kind = hir_type_table_kind(self.unit.types, lhs_type);
        if (lhs_kind == ty_REF() || lhs_kind == ty_MUTREF() || lhs_kind == ty_PTR()) {
            let pointee = hir_type_table_elem(self.unit.types, lhs_type);
            if (self.type_id_is_valid(pointee)) {
                var indexed_type = pointee;
                // A direct array borrow exposes the borrowed array as an
                // element view, so `(&mut array)[i]` has the same type as
                // `array[i]`. A pointer-to-array retains complete-pointee
                // stepping: `(*[T; N])[i]` is still `[T; N]`.
                if ((lhs_kind == ty_REF() || lhs_kind == ty_MUTREF())
                    && hir_type_table_kind(self.unit.types, pointee) == ty_ARRAY()) {
                    let array_elem = hir_type_table_elem(self.unit.types, pointee);
                    if (self.type_id_is_valid(array_elem)) { indexed_type = array_elem; }
                    self.unit.set_expr_type(expr_id, indexed_type);
                    return;
                }
                // References are views of their pointee, not a distinct
                // indexing owner.  Resolve Vec/Dict/Stack/etc. operator[]
                // against the concrete pointee so `v: &mut Vec<T>` supports
                // the same `v[i]` syntax as an owned Vec<T>.  Keep the old
                // pointee fallback when no overload exists; this preserves
                // raw pointer/array diagnostics while allowing the normal
                // method resolver to report an invalid container index.
                let pointee_text = hir_type_table_text(self.unit.types, pointee);
                if (pointee_text.len() > 0
                    && !hir_builder_type_name_has_template_atom(pointee_text)) {
                    let target_fn = self.concrete_index_method_target(expr_id, pointee_text);
                    if (target_fn != hir_id_invalid()) {
                        self.unit.set_expr_semantic(expr_id,
                                                   expr_sem_METHOD(),
                                                   hir_target_function(),
                                                   target_fn);
                        // WYSIWYG index types: `b[i]` has exactly the type the
                        // operator[] declaration states.  A `*T` return stays a
                        // pointer (index again for the element, `b[i][j]`); a
                        // `&mut T`/`&T` return is a reference view that reads
                        // and assigns like the element.
                        let value_type = self.unit.function_return_type(target_fn);
                        if (self.type_id_is_valid(value_type)) {
                            self.unit.set_expr_type(expr_id, value_type);
                        }
                        return;
                    }
                }
                self.unit.set_expr_type(expr_id, indexed_type);
            }
            return;
        }
        if (lhs_kind == ty_ARRAY()) {
            let elem_type = hir_type_table_elem(self.unit.types, lhs_type);
            if (self.type_id_is_valid(elem_type)) {
                self.unit.set_expr_type(expr_id, elem_type);
            }
            return;
        }

        let lhs_text = hir_type_table_text(self.unit.types, lhs_type);
        if (lhs_text.len == 0 || hir_builder_type_name_has_template_atom(lhs_text)) { return; }
        let target_fn = self.concrete_index_method_target(expr_id, lhs_text);
        if (target_fn == hir_id_invalid()) { return; }
        self.unit.set_expr_semantic(expr_id, expr_sem_METHOD(), hir_target_function(), target_fn);
        // WYSIWYG index types (see the pointee branch above): `b[i]` keeps
        // the exact operator[] return type instead of dereferencing to the
        // element.
        let value_type = self.unit.function_return_type(target_fn);
        if (self.type_id_is_valid(value_type)) {
            self.unit.set_expr_type(expr_id, value_type);
        }
    }

    fn function_id_for_name(self, name: string) -> i32 {
        if (name.len == 0) { return hir_id_invalid(); }
        let direct = hir_name_id_map_get(self.free_function_index,name);
        if (direct != hir_id_invalid()) { return direct; }
        let base = policy_generic_call_base(name.clone());
        if (base.len > 0 && base != name) {
            let base_hit = hir_name_id_map_get(self.free_function_index,base);
            if (base_hit != hir_id_invalid()) { return base_hit; }
        }
        let last = hir_builder_last_path_segment(base);
        if (last.len > 0 && last != base) {
            let last_hit = hir_name_id_map_get(self.free_function_index,last);
            if (last_hit != hir_id_invalid()) { return last_hit; }
        }
        return hir_id_invalid();
    }

    fn value_item_id_for_name(self, name: string) -> i32 {
        if (name.len == 0) { return hir_id_invalid(); }
        let direct = hir_name_id_map_get(self.value_item_index,name);
        if (direct != hir_id_invalid()) { return direct; }
        let base = policy_generic_call_base(name.clone());
        if (base.len > 0 && base != name) {
            let base_hit = hir_name_id_map_get(self.value_item_index,base);
            if (base_hit != hir_id_invalid()) { return base_hit; }
        }
        let last = hir_builder_last_path_segment(base);
        if (last.len > 0 && last != base) {
            let last_hit = hir_name_id_map_get(self.value_item_index,last);
            if (last_hit != hir_id_invalid()) { return last_hit; }
        }
        return hir_id_invalid();
    }

    fn raw_value_decl_for_name(self, name: string) -> rawptr {
        if (self.source_unit == null || name.len == 0) { return null; }
        var cur = unit_get_decls(self.source_unit);
        while (cur != null) {
            let kind = decl_get_kind(cur);
            if ((kind == de_CONST() || kind == de_GLOBAL_VAR())
                && decl_get_name(cur) == name) {
                return cur;
            }
            cur = decl_get_next(cur);
        }
        return null;
    }

    fn type_ref_from_type_id(self, type_id: i32) -> rawptr {
        if (!self.type_id_is_valid(type_id)) { return tref_alloc(ty_VOID(), ""); }
        return self.type_ref_from_text(hir_type_table_text(self.unit.types, type_id));
    }

    fn function_type_id(self, function_id: i32) -> i32 {
        if (function_id == hir_id_invalid()) { return hir_id_invalid(); }
        let cached = hir_int_id_map_get(self.function_type_cache,function_id);
        if (cached != -1 && cached != hir_id_invalid()) { return cached; }
        var count: i32 = 0;
        var local = self.unit.function_first_local(function_id);
        while (local != hir_id_invalid()) {
            if ((self.unit.local_flags(local) & hir_local_flag_param()) != 0
                && !self.local_is_constructor_abi_self(function_id, local)) {
                count = count + 1;
            }
            local = self.unit.local_next(local);
        }
        var buf: rawptr = null;
        if (count > 0) {
            buf = hir_profile_malloc((count * 8) as u64);
            if (buf != null) { memset(buf, 0, (count * 8) as u64); }
        }
        var idx: i32 = 0;
        local = self.unit.function_first_local(function_id);
        while (local != hir_id_invalid()) {
            if ((self.unit.local_flags(local) & hir_local_flag_param()) != 0
                && !self.local_is_constructor_abi_self(function_id, local)) {
                if (buf != null) {
                    ast_write_rawptr(ptr_offset(buf, idx * 8), self.type_ref_from_type_id(self.unit.local_type(local)));
                }
                idx = idx + 1;
            }
            local = self.unit.local_next(local);
        }
        let params = tref_alloc_tuple(buf, count as i64);
        let fn_ret_type_id = self.unit.function_return_type(function_id);
        let ret_ref = self.type_ref_from_type_id(fn_ret_type_id);
        let out = self.unit.types.intern_type_ref(tref_alloc_fn(params, ret_ref));
        // Never cache a signature computed from an instance shell whose
        // return type has not been backfilled yet; the stale void-ret fn
        // type would survive the backfill and poison later lookups.
        if (out != hir_id_invalid() && self.type_id_is_valid(fn_ret_type_id)) {
            self.function_type_cache = hir_int_id_map_put(self.function_type_cache,function_id, out);
        }
        return out;
    }

    fn note_reflection_builtin_use(self, name: string) {
        let base = policy_generic_call_base(name.clone());
        if (base == "reflect_manifest"
            || base == "getType"
            || base == "reflect_method_value"
            || base == "reflect_method_ptr_by_id") {
            self.reflection_manifest_required = true;
            self.reflection_name_map_required = true;
            return;
        }
        if (base == "reflect_name") {
            self.reflection_name_map_required = true;
        }
    }

    fn builtin_name_recognized(self, name: string) -> bool {
        let base = policy_generic_call_base(name.clone());
        if (self.builtin_string_constructor_name_recognized(base)) { return true; }
        if (base == "panic") { return true; }
        if (base == "assert" || base == "assert_eq") { return true; }
        if (base == "sizeof") { return true; }
        if (base == "repr_sizeof") { return true; }
        if (base == "alignof") { return true; }
        if (base == "construct") { return true; }
        if (base == "typeof") { return true; }
        if (base == "typeinfo") { return true; }
        if (base == "type_name") { return true; }
        if (base == "reflect_manifest") { return true; }
        if (base == "reflect_name") { return true; }
        if (base == "reflect_method_ptr_by_id") { return true; }
        if (base == "reflect_method_value") { return true; }
        if (base == "field_count") { return true; }
        if (base == "field_name") { return true; }
        if (base == "field_type") { return true; }
        if (base == "hash") { return true; }
        if (base == "operator_eq" || base == "operator==") { return true; }
        if (base == "compare") { return true; }
        if (base == "argCount") { return true; }
        if (base == "getArg") { return true; }
        if (base == "to_rawptr") { return true; }
        if (base == "ptr_offset") { return true; }
        if (base == "ptr_read_u8" || base == "ptr_read_i32" || base == "ptr_read_i64") { return true; }
        if (base == "ptr_write_i32" || base == "ptr_write_i64") { return true; }
        if (base == "malloc" || base == "free" || base == "realloc" || base == "alloc" || base == "dealloc") { return true; }
        if (base == "memcpy" || base == "memmove" || base == "memset" || base == "memcmp" || base == "strlen") { return true; }
        if (base == "transmute") { return true; }
        if (base == "print" || base == "println") { return true; }
        if (base == "format") { return true; }
        if (base == "int_to_string" || base == "bool_to_string") { return true; }
        return false;
    }

    fn builtin_type_id_for_name(self, name: string) -> i32 {
        let base = policy_generic_call_base(name.clone());
        self.note_reflection_builtin_use(base);
        if (base == "hash" || base == "sizeof" || base == "repr_sizeof") {
            return self.type_id_from_text("i64");
        }
        if (base == "alignof") {
            return self.type_id_from_text("i64");
        }
        if (base == "construct") {
            let type_args = policy_generic_call_args(name.clone());
            let target_type = policy_generic_arg_at(type_args, 0);
            if (target_type.len > 0) {
                return self.type_id_from_text(self.resolve_type_text_in_current_env(target_type));
            }
            return hir_id_invalid();
        }
        if (base == "typeof" || base == "typeinfo" || base == "type_name"
            || base == "reflect_manifest" || base == "reflect_name") {
            return self.builtin_str_type_id();
        }
        if (base == "field_count") {
            return self.type_id_from_text("i32");
        }
        if (base == "field_name" || base == "field_type") {
            return self.builtin_str_type_id();
        }
        if (base == "reflect_method_value") {
            let value_type = self.reflect_method_value_type_id_from_name(name);
            if (value_type != hir_id_invalid()) { return value_type; }
            return self.type_id_from_text("rawptr");
        }
        if (base == "reflect_method_ptr_by_id") {
            return self.type_id_from_text("rawptr");
        }
        if (base == "operator_eq" || base == "operator==") {
            return self.type_id_from_text("bool");
        }
        if (base == "compare") {
            return self.type_id_from_text("i32");
        }
        if (base == "argCount") {
            return self.type_id_from_text("i32");
        }
        if (base == "getArg") {
            return self.builtin_str_type_id();
        }
        if (base == "assert" || base == "assert_eq") {
            return self.unit.types.intern_type_ref(null);
        }
        if (base == "format") {
            return self.builtin_str_type_id();
        }
        if (base == "int_to_string" || base == "bool_to_string") {
            return self.builtin_str_type_id();
        }
        if (base == "to_rawptr" || base == "ptr_offset" || base == "malloc" || base == "realloc"
            || base == "alloc" || base == "transmute" || base == "memmove" || base == "memset") {
            return self.type_id_from_text("rawptr");
        }
        if (base == "free" || base == "dealloc" || base == "memcpy" || base == "ptr_write_i32" || base == "ptr_write_i64") {
            return self.unit.types.intern_type_ref(null);
        }
        if (base == "strlen") {
            return self.type_id_from_text("i64");
        }
        if (base == "memcmp") {
            return self.type_id_from_text("i32");
        }
        if (base == "ptr_read_u8") {
            return self.type_id_from_text("i32");
        }
        if (base == "ptr_read_i32") {
            return self.type_id_from_text("i32");
        }
        if (base == "ptr_read_i64") {
            return self.type_id_from_text("i64");
        }
        if (self.builtin_string_constructor_name_recognized(base)) {
            return self.builtin_str_type_id();
        }
        let string_member_type = self.string_builtin_member_type_id(base);
        if (string_member_type != hir_id_invalid()) { return string_member_type; }
        return self.unit.types.intern_type_ref(null);
    }

    fn builtin_call_result_type_id(self, callee_expr_id: i32) -> i32 {
        if (callee_expr_id == hir_id_invalid()) { return hir_id_invalid(); }
        let raw_name = self.unit.expr_name(callee_expr_id);
        let base = policy_generic_call_base(raw_name.clone());
        if (base == "new") {
            if (self.unit.expr_target_kind(callee_expr_id) == hir_target_builtin()) {
                let builtin_id = self.unit.expr_target_id(callee_expr_id);
                let owner_type_id = self.unit.builtin_owner_type(builtin_id);
                if (self.type_id_is_valid(owner_type_id)) { return owner_type_id; }
            }
            let callee_type = self.unit.expr_type(callee_expr_id);
            if (self.type_id_is_valid(callee_type)) {
                let callee_kind = hir_type_table_kind(self.unit.types, callee_type);
                if (callee_kind == ty_FN() || callee_kind == ty_CFN()) {
                    let return_type = hir_type_table_elem(self.unit.types, callee_type);
                    if (self.type_id_is_valid(return_type)) { return return_type; }
                }
            }
        }
        return self.builtin_type_id_for_name(raw_name);
    }

    fn builtin_string_constructor_name_recognized(self, name: string) -> bool {
        let base = policy_generic_call_base(name.clone());
        if (base == "from_cstr") { return true; }
        if (base == "from_cstr_len") { return true; }
        if (base == "from_cstr_view_len") { return true; }
        if (base == "from_raw_string_parts") { return true; }
        return false;
    }

    fn string_builtin_member_type_id(self, name: string) -> i32 {
        let base = policy_generic_call_base(name.clone());
        if (base == "ptr" || base == "c_str" || base == "data") {
            return self.type_id_from_text("rawptr");
        }
        if (base == "len" || base == "length" || base == "size" || base == "cap" || base == "owned") {
            return self.type_id_from_text("i64");
        }
        let smk = policy_string_method_kind(base);
        if (smk == 9) {
            return self.type_id_from_text("i64");
        }
        if (smk == 1 || smk == 15) {
            return self.type_id_from_text("rawptr");
        }
        if (smk == 2 || smk == 4 || smk == 5 || smk == 6
            || smk == 7 || smk == 8 || smk == 16 || smk == 17) {
            return self.builtin_str_type_id();
        }
        if (smk == 3) {
            return self.type_id_from_text("i32");
        }
        if (smk == 10 || smk == 11 || smk == 12 || smk == 13 || smk == 14) {
            return self.type_id_from_text("bool");
        }
        if (base == "find" || base == "indexOf" || base == "index_of") {
            return self.type_id_from_text("i64");
        }
        return hir_id_invalid();
    }

    fn type_text_is_builtin_str(self, text: string) -> bool {
        let base = hir_builder_type_base_name(text);
        return hir_builder_is_primitive_str_name(base);
    }

    fn resolve_string_builtin_member_expr(self,
                                                 expr_id: i32,
                                                 owner_type_name: string,
                                                 member_name: string) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        if (!self.type_text_is_builtin_str(owner_type_name)) { return false; }
        let member_type = self.string_builtin_member_type_id(member_name);
        if (member_type == hir_id_invalid()) { return false; }
        let owner_type_id = self.type_id_from_text(owner_type_name);
        let builtin_id = self.unit.add_or_get_builtin(member_name,
                                                     expr_sem_BUILTIN(),
                                                     owner_type_id,
                                                     0);
        self.unit.set_expr_type(expr_id, member_type);
        self.unit.set_expr_semantic(expr_id, expr_sem_BUILTIN(), hir_target_builtin(), builtin_id);
        return true;
    }

    fn primitive_builtin_member_type_id(self, owner_type_name: string, member_name: string) -> i32 {
        if (owner_type_name.len == 0 || member_name.len == 0) { return hir_id_invalid(); }
        let owner_base = hir_builder_type_base_name(owner_type_name);
        let prim_kind = policy_primitive_type_kind(owner_base);
        if (prim_kind == 0) { return hir_id_invalid(); }
        let member_base = policy_generic_call_base(member_name.clone());
        if (member_base == "toString" || member_base == "to_string") {
            return self.builtin_str_type_id();
        }
        return hir_id_invalid();
    }

    fn resolve_primitive_builtin_member_expr(self,
                                                    expr_id: i32,
                                                    owner_type_name: string,
                                                    member_name: string) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        let member_type = self.primitive_builtin_member_type_id(owner_type_name, member_name);
        if (member_type == hir_id_invalid()) { return false; }
        let owner_type_id = self.type_id_from_text(owner_type_name);
        let builtin_id = self.unit.add_or_get_builtin(policy_generic_call_base(member_name.clone()),
                                                     expr_sem_BUILTIN(),
                                                     owner_type_id,
                                                     0);
        self.unit.set_expr_type(expr_id, member_type);
        self.unit.set_expr_semantic(expr_id, expr_sem_BUILTIN(), hir_target_builtin(), builtin_id);
        return true;
    }

    fn tuple_member_type_id(self, owner_type_id: i32, member_name: string) -> i32 {
        if (!self.type_id_is_valid(owner_type_id) || member_name.len == 0) { return hir_id_invalid(); }
        if (hir_type_table_kind(self.unit.types, owner_type_id) != ty_TUPLE()) { return hir_id_invalid(); }
        let idx = hir_builder_tuple_member_index(member_name);
        if (idx < 0) { return hir_id_invalid(); }
        let text = hir_type_table_text(self.unit.types, owner_type_id);
        if (text.len < 2 || text.charAt(0) != 40 || text.charAt(text.len - 1) != 41) {
            return hir_id_invalid();
        }
        let inner = text.substring(1, text.len - 1);
        let elem_text = policy_generic_arg_at(inner, idx);
        if (elem_text.len == 0) { return hir_id_invalid(); }
        return self.type_id_from_text(elem_text);
    }

    fn resolve_tuple_builtin_member_expr(self,
                                                expr_id: i32,
                                                owner_type_id: i32,
                                                member_name: string) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        let member_type = self.tuple_member_type_id(owner_type_id, member_name);
        if (member_type == hir_id_invalid()) { return false; }
        let builtin_id = self.unit.add_or_get_builtin(member_name,
                                                     expr_sem_BUILTIN(),
                                                     owner_type_id,
                                                     0);
        self.unit.set_expr_type(expr_id, member_type);
        self.unit.set_expr_semantic(expr_id, expr_sem_BUILTIN(), hir_target_builtin(), builtin_id);
        return true;
    }

    fn function_type_id_for_zero_arg_return(self, return_type_id: i32) -> i32 {
        if (!self.type_id_is_valid(return_type_id)) { return hir_id_invalid(); }
        let cached = hir_int_id_map_get(self.zero_arg_function_type_cache,return_type_id);
        if (cached != -1 && cached != hir_id_invalid()) { return cached; }
        let params_ref = tref_alloc_tuple(null, 0);
        let ret_ref = self.type_ref_from_type_id(return_type_id);
        let out = self.unit.types.intern_type_ref(tref_alloc_fn(params_ref, ret_ref));
        if (out != hir_id_invalid()) {
            self.zero_arg_function_type_cache = hir_int_id_map_put(self.zero_arg_function_type_cache,return_type_id, out);
        }
        return out;
    }

    fn resolve_default_new_member_expr(self,
                                              expr_id: i32,
                                              owner_type_name: string,
                                              member_name: string) -> bool {
        if (expr_id == hir_id_invalid() || member_name != "new" || owner_type_name.len == 0) {
            return false;
        }
        if (self.raw_method_decl_exists_for_type_text(owner_type_name, member_name, true)) {
            return false;
        }
        let owner_type_id = self.type_id_from_text(owner_type_name);
        if (!self.type_id_is_valid(owner_type_id)) { return false; }
        let builtin_id = self.unit.add_or_get_builtin("new",
                                                     expr_sem_BUILTIN(),
                                                     owner_type_id,
                                                     0);
        self.unit.set_expr_type(expr_id, self.function_type_id_for_zero_arg_return(owner_type_id));
        self.unit.set_expr_semantic(expr_id, expr_sem_BUILTIN(), hir_target_builtin(), builtin_id);
        return true;
    }

    // `T.new(args...)` is the uniform value-construction spelling used by
    // generic factories. A declared static `new` remains authoritative. When
    // no such factory exists, bind the call to the best matching language
    // constructor before falling back to the builtin 0/1-argument value
    // constructor. This keeps constructor selection in HIR so LLVM and C++
    // consume the exact same MIR target.
    fn resolve_default_new_constructor_call(self,
                                                     e: rawptr,
                                                     call_expr_id: i32,
                                                     callee_expr_id: i32) -> bool {
        if (call_expr_id == hir_id_invalid()
            || callee_expr_id == hir_id_invalid()
            || self.unit.expr_kind(callee_expr_id) != ex_MEMBER()
            || policy_generic_call_base(self.unit.expr_name(callee_expr_id).clone()) != "new"
            || self.unit.expr_target_kind(callee_expr_id) != hir_target_builtin()) {
            return false;
        }
        let owner_type_name = self.member_call_owner_type_name(e, callee_expr_id);
        if (owner_type_name.len == 0 || self.type_text_has_open_template_atom(owner_type_name)) {
            return false;
        }
        let owner_decl = self.raw_class_decl_for_type_text(owner_type_name);
        if (owner_decl == null) { return false; }
        // Prefer an already closed HIR constructor. This path has complete
        // argument types (including the widened literal types captured by a
        // generic pack) and therefore preserves overload selection without
        // depending on the original template AST's stale `new` callee.
        var constructor_fn = self.best_hir_method_function_for_call(owner_type_name,
                                                                     "constructor",
                                                                     call_expr_id,
                                                                     callee_expr_id);
        if (constructor_fn == hir_id_invalid()) {
            let constructor_decl = self.raw_method_decl_for_call_on_class_tree(owner_decl,
                                                                                "constructor",
                                                                                false,
                                                                                e,
                                                                                call_expr_id,
                                                                                owner_type_name,
                                                                                0);
            if (constructor_decl == null) { return false; }
            constructor_fn = self.closed_method_target_for_type_text(owner_type_name,
                                                                      "constructor",
                                                                      e,
                                                                      call_expr_id,
                                                                      constructor_decl,
                                                                      false);
        }
        if (constructor_fn == hir_id_invalid()
            || self.function_has_open_template_types(constructor_fn)) {
            return false;
        }
        // A language constructor is a value-producing type call, not an
        // instance method call. Erase the synthetic `.new` receiver so MIR
        // matches the canonical `Type(args...)` shape and does not pass the
        // type designator as the constructor's hidden `self` storage.
        self.unit.set_expr_lhs(callee_expr_id, hir_id_invalid());
        self.unit.set_expr_name(callee_expr_id, owner_type_name);
        self.unit.set_expr_semantic(callee_expr_id,
                                   expr_sem_METHOD(),
                                   hir_target_function(),
                                   constructor_fn);
        let constructor_type = self.function_type_id(constructor_fn);
        if (constructor_type != hir_id_invalid()) {
            self.unit.set_expr_type(callee_expr_id, constructor_type);
        }
        self.unit.set_expr_semantic(call_expr_id,
                                   expr_sem_METHOD(),
                                   hir_target_function(),
                                   constructor_fn);
        let return_type = self.unit.function_return_type(constructor_fn);
        if (self.type_id_is_valid(return_type)) {
            self.unit.set_expr_type(call_expr_id, return_type);
        } else {
            self.unit.set_expr_type(call_expr_id,
                                   self.type_id_from_text(owner_type_name));
        }
        return true;
    }

    // `construct::<T>(args...)` performs value construction without consulting
    // a static `T.new` factory. Bind a matching source-language constructor in
    // HIR; otherwise retain the builtin target for zero-argument value
    // initialization or one-argument move/value construction. Both codegen
    // backends therefore consume one identical MIR decision.
    fn resolve_construct_constructor_call(self,
                                                  e: rawptr,
                                                  call_expr_id: i32,
                                                  callee_expr_id: i32) -> bool {
        if (call_expr_id == hir_id_invalid()
            || callee_expr_id == hir_id_invalid()
            || self.unit.expr_kind(callee_expr_id) == ex_MEMBER()
            || self.unit.expr_target_kind(callee_expr_id) != hir_target_builtin()) {
            return false;
        }
        let raw_name = self.unit.expr_name(callee_expr_id);
        if (policy_generic_call_base(raw_name.clone()) != "construct") { return false; }
        let type_args = policy_generic_call_args(raw_name.clone());
        let raw_owner_type_name = policy_generic_arg_at(type_args, 0);
        if (raw_owner_type_name.len == 0) { return false; }
        let owner_type_name = self.canonical_type_text_in_current_env(raw_owner_type_name);
        if (owner_type_name.len == 0 || self.type_text_has_open_template_atom(owner_type_name)) {
            return false;
        }
        self.ensure_concrete_type_text_ready(owner_type_name);
        let owner_type_id = self.type_id_from_text(owner_type_name);
        if (!self.type_id_is_valid(owner_type_id)) { return false; }
        self.unit.set_expr_type(call_expr_id, owner_type_id);

        let owner_decl = self.raw_class_decl_for_type_text(owner_type_name);
        if (owner_decl == null) { return false; }
        var constructor_fn = self.best_hir_method_function_for_call(owner_type_name,
                                                                     "constructor",
                                                                     call_expr_id,
                                                                     callee_expr_id);
        if (constructor_fn == hir_id_invalid()) {
            let constructor_decl = self.raw_method_decl_for_call_on_class_tree(owner_decl,
                                                                                "constructor",
                                                                                false,
                                                                                e,
                                                                                call_expr_id,
                                                                                owner_type_name,
                                                                                0);
            if (constructor_decl == null) { return false; }
            constructor_fn = self.closed_method_target_for_type_text(owner_type_name,
                                                                      "constructor",
                                                                      e,
                                                                      call_expr_id,
                                                                      constructor_decl,
                                                                      false);
        }
        if (constructor_fn == hir_id_invalid()
            || self.function_has_open_template_types(constructor_fn)) {
            return false;
        }
        self.unit.set_expr_name(callee_expr_id, owner_type_name);
        self.unit.set_expr_semantic(callee_expr_id,
                                   expr_sem_METHOD(),
                                   hir_target_function(),
                                   constructor_fn);
        let constructor_type = self.function_type_id(constructor_fn);
        if (constructor_type != hir_id_invalid()) {
            self.unit.set_expr_type(callee_expr_id, constructor_type);
        }
        self.unit.set_expr_semantic(call_expr_id,
                                   expr_sem_METHOD(),
                                   hir_target_function(),
                                   constructor_fn);
        let return_type = self.unit.function_return_type(constructor_fn);
        if (self.type_id_is_valid(return_type)) {
            self.unit.set_expr_type(call_expr_id, return_type);
        }
        return true;
    }

    fn reflection_member_name_recognized(self, member_name: string) -> bool {
        if (member_name == "name" || member_name == "kind") { return true; }
        if (member_name == "fields" || member_name == "methods") { return true; }
        return false;
    }

    fn reflection_member_result_type_id(self, member_name: string) -> i32 {
        if (member_name == "name" || member_name == "kind") { return self.builtin_str_type_id(); }
        if (member_name == "fields" || member_name == "methods") { return self.type_id_from_text("rawptr"); }
        return hir_id_invalid();
    }

    fn reflection_lhs_is_type_operand(self, source_member: rawptr, lhs_expr_id: i32) -> bool {
        if (lhs_expr_id == hir_id_invalid()) { return false; }
        if (self.unit.expr_sem_kind(lhs_expr_id) == expr_sem_CLASS()) { return true; }
        if (source_member == null || expr_get_kind(source_member) != ex_MEMBER()) { return false; }
        let raw_lhs = expr_get_lhs(source_member);
        if (raw_lhs == null || expr_get_kind(raw_lhs) != ex_IDENT()) { return false; }
        let raw_name = expr_get_name(raw_lhs);
        if (raw_name.len == 0) { return false; }
        if (hir_builder_generic_contains(self.current_generic_params, raw_name)) { return true; }
        if (self.current_generic_binding(raw_name).len > 0) { return true; }
        let resolved = self.resolve_type_text_in_current_env(raw_name);
        if (resolved.len == 0) { return false; }
        if (self.raw_class_decl_for_type_text(resolved) != null) { return true; }
        return policy_primitive_type_kind(resolved) != 0 || hir_builder_is_primitive_str_name(resolved) || resolved == "bool" || resolved == "char" || resolved == "rawptr";
    }

    fn reflection_lhs_type_id(self, source_member: rawptr, lhs_expr_id: i32) -> i32 {
        if (lhs_expr_id != hir_id_invalid()) {
            let direct_type = self.unit.expr_type(lhs_expr_id);
            if (self.type_id_is_valid(direct_type)) { return direct_type; }
        }
        if (source_member == null || expr_get_kind(source_member) != ex_MEMBER()) { return hir_id_invalid(); }
        let raw_lhs = expr_get_lhs(source_member);
        if (raw_lhs == null || expr_get_kind(raw_lhs) != ex_IDENT()) { return hir_id_invalid(); }
        let resolved = self.resolve_type_text_in_current_env(expr_get_name(raw_lhs));
        if (resolved.len == 0) { return hir_id_invalid(); }
        return self.type_id_from_text(resolved);
    }

    fn resolve_reflection_member_expr(self, e: rawptr, expr_id: i32, lhs_expr_id: i32) -> bool {
        if (expr_id == hir_id_invalid() || lhs_expr_id == hir_id_invalid()) { return false; }
        if (e == null || expr_get_kind(e) != ex_MEMBER()) { return false; }
        let member_name = policy_versioned_generic_call_base(expr_get_name(e).clone());
        if (!self.reflection_member_name_recognized(member_name)) { return false; }
        if (!self.reflection_lhs_is_type_operand(e, lhs_expr_id)) { return false; }
        let owner_type_id = self.reflection_lhs_type_id(e, lhs_expr_id);
        if (!self.type_id_is_valid(owner_type_id)) { return false; }
        let result_type_id = self.reflection_member_result_type_id(member_name);
        if (!self.type_id_is_valid(result_type_id)) { return false; }
        let builtin_id = self.unit.add_or_get_builtin(member_name,
                                                     expr_sem_BUILTIN(),
                                                     owner_type_id,
                                                     expr_get_semantic_flags(e));
        if (builtin_id == hir_id_invalid()) { return false; }
        self.unit.set_expr_type(expr_id, result_type_id);
        self.unit.set_expr_semantic(expr_id,
                                   expr_sem_BUILTIN(),
                                   hir_target_builtin(),
                                   builtin_id);
        return true;
    }

    fn resolve_ident_expr_after_create(self, e: rawptr, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        if (self.unit.expr_target_kind(expr_id) == hir_target_function()) {
            self.set_expr_type_if_empty(expr_id, self.function_type_id(self.unit.expr_target_id(expr_id)));
            return;
        }
        if (self.unit.expr_target_kind(expr_id) == hir_target_builtin()) {
            self.set_expr_type_canonical(expr_id, self.builtin_type_id_for_name(self.unit.expr_name(expr_id)));
            return;
        }
        if (self.unit.expr_target_kind(expr_id) == hir_target_item()) {
            let item_id = self.unit.expr_target_id(expr_id);
            if (item_id != hir_id_invalid()
                && (self.unit.item_kind(item_id) == hir_item_class()
                    || self.unit.item_kind(item_id) == hir_item_enum())) {
                let item_type_text = self.unit.item_name(item_id);
                let resolved_item_type = self.resolve_type_text_in_current_env(item_type_text);
                if (resolved_item_type.len > 0) {
                    self.set_expr_type_canonical(expr_id, self.type_id_from_text(resolved_item_type));
                } else {
                    self.set_expr_type_canonical(expr_id, self.type_id_from_text(item_type_text));
                }
                return;
            }
        }
        if (self.unit.expr_target_kind(expr_id) != hir_target_none()) { return; }
        let name = expr_get_name(e);
        let local_id = hir_local_scope_lookup(self.locals, name);
        if (local_id != hir_id_invalid()) {
            self.unit.set_expr_type(expr_id, self.unit.local_type(local_id));
            self.unit.set_expr_semantic(expr_id, expr_sem_LOCAL(), hir_target_local(), local_id);
            return;
        }
        let capture_local = self.ensure_capture_local_by_name(name, expr_get_semantic_target(e));
        if (capture_local != hir_id_invalid()) {
            self.unit.set_expr_type(expr_id, self.unit.local_type(capture_local));
            self.unit.set_expr_semantic(expr_id, expr_sem_LOCAL(), hir_target_local(), capture_local);
            return;
        }
        let item_id = self.value_item_id_for_name(name);
        if (item_id != hir_id_invalid()) {
            let item_kind = self.unit.item_kind(item_id);
            var sem_kind = expr_sem_CONST();
            if (item_kind == hir_item_global()) { sem_kind = expr_sem_GLOBAL(); }
            self.unit.set_expr_semantic(expr_id, sem_kind, hir_target_item(), item_id);
            self.set_expr_type_if_empty(expr_id, self.unit.item_type(item_id));
            return;
        }
        let fn_id = self.function_id_for_name(name);
        if (fn_id != hir_id_invalid()) {
            self.unit.set_expr_semantic(expr_id, expr_sem_DIRECT_FN(), hir_target_function(), fn_id);
            let raw_target = hir_pointer_map_raw_for_function(self.decl_map,fn_id);
            if (raw_target != null) {
                self.ensure_reachable_function_body(raw_target, fn_id, false);
            }
            self.set_expr_type_if_empty(expr_id, self.function_type_id(fn_id));
            return;
        }
        let type_name = self.resolve_type_text_in_current_env(name);
        if (type_name.len > 0) {
            self.ensure_concrete_type_text_ready(type_name);
            var raw_class = self.raw_class_decl_for_type_text(type_name);
            if (raw_class == null) {
                raw_class = self.find_class_decl(type_name);
                if (raw_class == null) {
                    let type_base = policy_generic_call_base(type_name.clone());
                    if (type_base.len > 0) {
                        raw_class = self.find_class_decl(type_base);
                    }
                }
                if (raw_class != null) { self.ensure_concrete_type_text_ready(type_name); }
            }
            if (raw_class == null) {
                let template_class = self.raw_template_class_decl_for_type_text(type_name);
                if (template_class != null) {
                    self.ensure_concrete_type_text_ready(type_name);
                    raw_class = self.raw_class_decl_for_type_text(type_name);
                }
            }
            if (raw_class != null) {
                let type_item = hir_pointer_map_item(self.decl_map,raw_class);
                self.unit.set_expr_semantic(expr_id, expr_sem_CLASS(), hir_target_item(), type_item);
                var canonical_type_name = type_name;
                if (type_item != hir_id_invalid()
                    && (self.unit.item_kind(type_item) == hir_item_class()
                        || self.unit.item_kind(type_item) == hir_item_enum())) {
                    canonical_type_name = self.unit.item_name(type_item);
                }
                self.set_expr_type_canonical(expr_id, self.type_id_from_text(canonical_type_name));
                return;
            }
            if (hir_builder_generic_contains(self.current_generic_params, name)
                || self.current_generic_binding(name).len > 0
                || policy_primitive_type_kind(type_name) != 0
                || hir_builder_is_primitive_str_name(type_name)
                || type_name == "bool"
                || type_name == "char"
                || type_name == "rawptr") {
                let type_target_id = self.type_id_from_text(type_name);
                self.unit.set_expr_semantic(expr_id,
                                           expr_sem_CLASS(),
                                           hir_target_type(),
                                           type_target_id);
                self.set_expr_type_if_empty(expr_id, type_target_id);
                return;
            }
        }
        if (self.builtin_name_recognized(name)) {
            let builtin_name = self.canonical_builtin_name_for_expr(e);
            let builtin_id = self.unit.add_or_get_builtin(builtin_name,
                                                         expr_sem_BUILTIN(),
                                                         hir_id_invalid(),
                                                         expr_get_semantic_flags(e));
            self.unit.set_expr_semantic(expr_id, expr_sem_BUILTIN(), hir_target_builtin(), builtin_id);
            if (!self.type_id_is_valid(self.unit.expr_type(expr_id))) {
                self.unit.set_expr_type(expr_id, self.builtin_type_id_for_name(builtin_name));
            }
        }
    }

    fn build_initializers_for_decl_chain(self, head: rawptr, owner_template: bool) {
        var cur = head;
        while (cur != null) {
            if (self.decl_effectively_imported(cur)) {
                cur = decl_get_next(cur);
                continue;
            }
            let k = decl_get_kind(cur);
            if (k == de_CLASS() || k == de_ENUM()) {
                let templ = owner_template
                    || hir_builder_decl_template_head(cur)
                    || self.decl_members_have_template_type(cur);
                self.build_initializers_for_decl_chain(decl_get_members(cur), templ);
            } else if (k == de_CONST() || k == de_GLOBAL_VAR() || hir_builder_decl_is_assoc_const_member(cur)) {
                let fn_id_saved = self.current_function_id;
                let item_id_saved = self.current_item_id;
                self.current_function_id = hir_id_invalid();
                self.current_item_id = hir_pointer_map_item(self.decl_map,cur);
                let init_chain = self.build_stmt_chain(decl_get_body(cur));
                self.unit.set_item_init(self.current_item_id, init_chain.first);
                self.current_item_id = item_id_saved;
                self.current_function_id = fn_id_saved;
            }
            cur = decl_get_next(cur);
        }
    }

    fn unit_has_local_main_function(self, head: rawptr) -> bool {
        var cur = head;
        while (cur != null) {
            if (!self.decl_effectively_imported(cur)
                && decl_get_kind(cur) == de_FN()
                && decl_get_name(cur) == "main"
                && decl_get_body(cur) != null) {
                return true;
            }
            cur = decl_get_next(cur);
        }
        return false;
    }

    fn materialize_local_main_function(self, head: rawptr) -> bool {
        var cur = head;
        while (cur != null) {
            if (!self.decl_effectively_imported(cur)
                && decl_get_kind(cur) == de_FN()
                && decl_get_name(cur) == "main"
                && decl_get_body(cur) != null) {
                let fn_id = hir_pointer_map_function(self.decl_map,cur);
                self.unit.add_function_flags(fn_id, hir_function_flag_codegen_root());
                self.ensure_reachable_function_body(cur, fn_id, false);
                return self.unit.function_body(fn_id) != hir_id_invalid();
            }
            cur = decl_get_next(cur);
        }
        return false;
    }

    fn materialize_exported_function_roots_for_decl_chain(self,
                                                                head: rawptr,
                                                                owner_template: bool,
                                                                owner_exports: bool) {
        var cur = head;
        while (cur != null) {
            if (self.decl_is_foreign_import(cur)) {
                cur = decl_get_next(cur);
                continue;
            }
            let k = decl_get_kind(cur);
            if (k == de_FN()) {
                self.materialize_exported_generic_root_instances_for_decl(cur);
                if (!owner_template
                    && !hir_builder_decl_template_head(cur)
                    && self.export_root_name_allowed(decl_get_name(cur))
                    && (hir_builder_decl_exports_world(cur) || self.export_root_names_specified)
                    && decl_get_body(cur) != null) {
                    let root_fn = hir_pointer_map_function(self.decl_map,cur);
                    self.unit.add_function_flags(root_fn, hir_function_flag_codegen_root());
                }
            } else if (k == de_METHOD()) {
                self.materialize_exported_generic_root_instances_for_decl(cur);
                if (!owner_template
                    && !hir_builder_decl_template_head(cur)
                    && self.export_method_roots
                    && self.export_root_name_allowed(decl_get_name(cur))
                    && ((owner_exports && hir_builder_decl_exports_world(cur)) || self.export_root_names_specified)
                    && decl_get_body(cur) != null) {
                    let root_method_fn = hir_pointer_map_function(self.decl_map,cur);
                    self.unit.add_function_flags(root_method_fn, hir_function_flag_codegen_root());
                }
            } else if (k == de_CLASS() || k == de_ENUM()) {
                let templ = owner_template
                    || hir_builder_decl_template_head(cur)
                    || self.decl_members_have_template_type(cur);
                let next_owner_exports = hir_builder_decl_exports_world(cur);
                self.materialize_exported_function_roots_for_decl_chain(decl_get_members(cur),
                                                                        templ,
                                                                        next_owner_exports);
            }
            cur = decl_get_next(cur);
        }
    }

    fn mark_exported_function_roots_for_decl_chain(self,
                                                          head: rawptr,
                                                          owner_template: bool,
                                                          owner_exports: bool) {
        var cur = head;
        while (cur != null) {
            if (self.decl_is_foreign_import(cur)) {
                cur = decl_get_next(cur);
                continue;
            }
            let k = decl_get_kind(cur);
            if (k == de_FN()) {
                self.materialize_exported_generic_root_instances_for_decl(cur);
                if (!owner_template
                    && !hir_builder_decl_template_head(cur)
                    && self.export_root_name_allowed(decl_get_name(cur))
                    && (hir_builder_decl_exports_world(cur) || self.export_root_names_specified)
                    && decl_get_body(cur) != null) {
                    let root_fn = hir_pointer_map_function(self.decl_map,cur);
                    self.unit.add_function_flags(root_fn, hir_function_flag_codegen_root());
                }
            } else if (k == de_METHOD()) {
                self.materialize_exported_generic_root_instances_for_decl(cur);
                if (!owner_template
                    && !hir_builder_decl_template_head(cur)
                    && self.export_method_roots
                    && self.export_root_name_allowed(decl_get_name(cur))
                    && ((owner_exports && hir_builder_decl_exports_world(cur)) || self.export_root_names_specified)
                    && decl_get_body(cur) != null) {
                    let root_method_fn = hir_pointer_map_function(self.decl_map,cur);
                    self.unit.add_function_flags(root_method_fn, hir_function_flag_codegen_root());
                }
            } else if (k == de_CLASS() || k == de_ENUM()) {
                let templ = owner_template
                    || hir_builder_decl_template_head(cur)
                    || self.decl_members_have_template_type(cur);
                let next_owner_exports = hir_builder_decl_exports_world(cur);
                self.mark_exported_function_roots_for_decl_chain(decl_get_members(cur),
                                                                 templ,
                                                                 next_owner_exports);
            }
            cur = decl_get_next(cur);
        }
    }

    fn materialize_c_abi_export_functions(self, head: rawptr) {
        var cur = head;
        while (cur != null) {
            if (!self.decl_effectively_imported(cur)
                && decl_get_kind(cur) == de_FN()
                && decl_get_body(cur) != null) {
                let fn_id = hir_pointer_map_function(self.decl_map, cur);
                if (fn_id != hir_id_invalid()
                    && (self.unit.function_flags(fn_id) & hir_function_flag_no_mangle()) != 0) {
                    self.unit.add_function_flags(fn_id, hir_function_flag_codegen_root());
                    self.ensure_reachable_function_body(cur, fn_id, false);
                }
            }
            cur = decl_get_next(cur);
        }
    }

    fn materialize_function_roots(self, unit_ptr: rawptr) {
        let head = unit_get_decls(unit_ptr);
        let has_main = self.unit_has_local_main_function(head);
        if (has_main && self.export_root_name_allowed("main")) {
            self.materialize_local_main_function(head);
        }
        self.materialize_c_abi_export_functions(head);
        if (self.export_root_bodies) {
            if (self.lazy_codegen) {
                self.mark_exported_function_roots_for_decl_chain(head, false, true);
            } else {
                self.materialize_exported_function_roots_for_decl_chain(head, false, true);
            }
        }
    }

    fn member_expr_has_resolved_structural_target(self, e: rawptr, lhs_expr_id: i32) -> bool {
        if (e == null || lhs_expr_id == hir_id_invalid()) { return false; }
        if (expr_get_kind(e) != ex_MEMBER()) { return false; }
        let member_name = policy_versioned_generic_call_base(expr_get_name(e).clone());
        if (member_name.len == 0) { return false; }
        var owner_type_name = "";
        if (self.unit.expr_sem_kind(lhs_expr_id) == expr_sem_CLASS()) {
            owner_type_name = self.resolve_type_text_in_current_env(self.unit.expr_name(lhs_expr_id));
            if (owner_type_name.len == 0
                && self.unit.expr_target_kind(lhs_expr_id) == hir_target_item()) {
                let owner_item = self.unit.expr_target_id(lhs_expr_id);
                if (owner_item != hir_id_invalid()) {
                    owner_type_name = self.unit.item_name(owner_item);
                }
            }
        }
        if (owner_type_name.len == 0) {
            let owner_type_id = self.member_lookup_type_id(self.unit.expr_type(lhs_expr_id));
            if (!self.type_id_is_valid(owner_type_id)) { return false; }
            owner_type_name = self.member_lookup_type_name(owner_type_id);
            if (owner_type_name == "rawptr") { return false; }
            let field_item = self.field_id_for_type_and_name(owner_type_id, member_name);
            if (field_item != hir_id_invalid()) { return true; }
        }
        if (owner_type_name.len == 0) { return false; }
        if (self.raw_member_decl_for_type_text(owner_type_name, member_name) != null) { return true; }
        let want_static_member = self.unit.expr_sem_kind(lhs_expr_id) == expr_sem_CLASS();
        if (self.raw_method_decl_exists_for_type_text(owner_type_name,
                                                      member_name,
                                                      want_static_member)) {
            return true;
        }
        if (self.method_function_target_by_owner_type_and_method(owner_type_name, member_name) != hir_id_invalid()) {
            return true;
        }
        let payload_owner_type = self.heap_indirect_member_owner_type_text(owner_type_name, member_name);
        if (payload_owner_type.len > 0) {
            if (self.raw_member_decl_for_type_text(payload_owner_type, member_name) != null) { return true; }
            if (self.raw_method_decl_exists_for_type_text(payload_owner_type,
                                                          member_name,
                                                          false)) {
                return true;
            }
            if (self.method_function_target_by_owner_type_and_method(payload_owner_type, member_name) != hir_id_invalid()) {
                return true;
            }
        }
        return false;
    }

    fn raw_method_decl_exists_for_type_text(self,
                                                  owner_type_name: string,
                                                  member_name: string,
                                                  want_static: bool) -> bool {
        if (owner_type_name.len == 0 || member_name.len == 0) { return false; }
        var cache_key = member_name;
        if (want_static) {
            cache_key = cache_key + "|static=1";
        } else {
            cache_key = cache_key + "|static=0";
        }
        if (hir_pair_raw_map_get(self.raw_method_lookup_cache,owner_type_name, cache_key) != null) {
            return true;
        }
        if (hir_pair_id_map_get(self.raw_method_lookup_miss_cache,owner_type_name, cache_key) != hir_id_invalid()) {
            return false;
        }
        var out: rawptr = null;
        if (want_static) {
            out = self.raw_static_method_decl_for_type_text(owner_type_name, member_name);
            if (out == null) {
                out = self.raw_template_method_decl_for_type_text(owner_type_name, member_name, true);
            }
        } else {
            out = self.raw_method_decl_for_type_text(owner_type_name, member_name);
            if (out == null) {
                out = self.raw_template_method_decl_for_type_text(owner_type_name, member_name, false);
            }
        }
        if (out != null) {
            self.raw_method_lookup_cache = hir_pair_raw_map_put(self.raw_method_lookup_cache,owner_type_name, cache_key, out);
            return true;
        }
        self.raw_method_lookup_miss_cache = hir_pair_id_map_put(self.raw_method_lookup_miss_cache,owner_type_name, cache_key, 1);
        return false;
    }

    fn declared_member_or_method_exists_for_expr(self,
                                                       owner_type_name: string,
                                                       member_name: string,
                                                       lhs_expr_id: i32) -> bool {
        if (owner_type_name.len == 0 || member_name.len == 0 || lhs_expr_id == hir_id_invalid()) {
            return false;
        }
        if (self.raw_member_decl_for_type_text(owner_type_name, member_name) != null) { return true; }
        let want_static_member = self.unit.expr_sem_kind(lhs_expr_id) == expr_sem_CLASS();
        return self.raw_method_decl_exists_for_type_text(owner_type_name,
                                                         member_name,
                                                         want_static_member);
    }

    fn restore_builtin_member_semantic(self, e: rawptr, expr_id: i32) -> bool {
        if (e == null || expr_id == hir_id_invalid()) { return false; }
        if (expr_get_kind(e) != ex_MEMBER()) { return false; }
        if (expr_get_semantic_kind(e) != expr_sem_BUILTIN()) { return false; }
        let builtin_name = self.canonical_builtin_name_for_expr(e);
        if (builtin_name.len == 0) { return false; }
        let builtin_id = self.unit.add_or_get_builtin(builtin_name,
                                                     expr_sem_BUILTIN(),
                                                     self.builtin_owner_type_for_expr(e),
                                                     expr_get_semantic_flags(e));
        if (builtin_id == hir_id_invalid()) { return false; }
        let builtin_type = self.type_id_from_expr_semantic(e, expr_sem_BUILTIN());
        if (self.type_id_is_valid(builtin_type)) {
            self.unit.set_expr_type(expr_id, builtin_type);
        }
        self.unit.set_expr_semantic(expr_id,
                                   expr_sem_BUILTIN(),
                                   hir_target_builtin(),
                                   builtin_id);
        return true;
    }

    fn restore_variant_member_semantic(self, e: rawptr, expr_id: i32) -> bool {
        if (e == null || expr_id == hir_id_invalid()) { return false; }
        if (expr_get_kind(e) != ex_MEMBER()) { return false; }
        if (expr_get_semantic_kind(e) != expr_sem_VARIANT()) { return false; }
        let raw_target = expr_get_semantic_target(e);
        if (raw_target == null || decl_get_kind(raw_target) != de_VARIANT()) { return false; }
        var owner_decl = expr_get_semantic_owner(e);
        if (owner_decl == null) {
            owner_decl = hir_raw_owner_map_get(self.decl_owner_map,raw_target);
        }
        var variant_item = hir_id_invalid();
        var variant_type = hir_id_invalid();
        if (owner_decl != null) {
            let owner_type_name = self.concrete_owner_type_name(e, owner_decl);
            if (owner_type_name.len > 0) {
                variant_item = self.concrete_variant_target_for_type_text(raw_target,
                                                                          owner_decl,
                                                                          owner_type_name);
                variant_type = self.variant_constructor_type_id_for_type_text(raw_target,
                                                                              owner_decl,
                                                                              owner_type_name);
            }
        }
        if (variant_item == hir_id_invalid()) {
            variant_item = self.concrete_variant_target(e, raw_target);
        }
        if (variant_item == hir_id_invalid()) { return false; }
        if (self.type_id_is_valid(variant_type)) {
            self.unit.set_expr_type(expr_id, variant_type);
        } else {
            self.unit.set_expr_type(expr_id, self.unit.item_type(variant_item));
        }
        self.unit.set_expr_semantic(expr_id,
                                   expr_sem_VARIANT(),
                                   hir_target_variant(),
                                   variant_item);
        return true;
    }

    /// Guard for the FIELD fast path: a raw field target whose item type
    /// still carries an open template atom must not be bound directly when
    /// the receiver type is a closed generic — a concrete instance field
    /// exists (or can be instantiated) and the regular resolution flow
    /// below will find it.
    fn direct_field_shadows_concrete_instance(self, direct_field: i32, lhs_expr_id: i32) -> bool {
        if (!self.type_id_has_template_atom(self.unit.item_type(direct_field))) { return false; }
        let receiver_type_id = self.member_lookup_type_id(self.unit.expr_type(lhs_expr_id));
        if (!self.type_id_is_valid(receiver_type_id)) { return false; }
        let receiver_text = hir_type_table_text(self.unit.types, receiver_type_id);
        if (policy_generic_call_args(receiver_text.clone()).len == 0) { return false; }
        return !self.type_text_has_open_template_atom(receiver_text);
    }

    fn direct_method_shadows_concrete_instance(self, raw_method: rawptr, lhs_expr_id: i32) -> bool {
        if (raw_method == null || decl_get_kind(raw_method) != de_METHOD()) { return false; }
        let method_owner = hir_raw_owner_map_get(self.decl_owner_map,raw_method);
        if (method_owner == null || !hir_builder_decl_template_head(method_owner)) { return false; }
        let receiver_type_id = self.member_lookup_type_id(self.unit.expr_type(lhs_expr_id));
        if (!self.type_id_is_valid(receiver_type_id)) { return false; }
        let receiver_text = hir_type_table_text(self.unit.types, receiver_type_id);
        if (policy_generic_call_args(receiver_text.clone()).len == 0) { return false; }
        if (self.type_text_has_open_template_atom(receiver_text)) { return false; }
        let owner_text = decl_get_name(method_owner);
        if (owner_text.len == 0) { return false; }
        let owner_base = hir_builder_type_base_name(owner_text);
        return hir_builder_type_owner_names_match(receiver_text, owner_base);
    }

    fn resolve_member_expr_after_children(self, e: rawptr, expr_id: i32, lhs_expr_id: i32) {
        if (expr_id == hir_id_invalid() || lhs_expr_id == hir_id_invalid()) { return; }
        let defer_method_resolution_for_direct_call = e != null
            && e == self.current_call_callee_ast
            && expr_get_kind(e) == ex_MEMBER();
        if (self.restore_variant_member_semantic(e, expr_id)) { return; }
        if (defer_method_resolution_for_direct_call) {
            let raw_sem_kind = expr_get_semantic_kind(e);
            let raw_target = expr_get_semantic_target(e);
            if (!hir_builder_decl_is_foreign_dci_ctor(raw_target)) {
                if ((raw_sem_kind == expr_sem_METHOD()
                    && !self.direct_method_shadows_concrete_instance(raw_target, lhs_expr_id))
                    || (raw_target != null && decl_get_kind(raw_target) == de_METHOD())) {
                    return;
                }
            }
        }
        if (!self.member_expr_has_resolved_structural_target(e, lhs_expr_id)) {
            let preempt_owner_type = self.member_owner_type_name(e, lhs_expr_id);
            let preempt_member_name = policy_versioned_generic_call_base(expr_get_name(e).clone());
            var declared_member_exists = false;
            if (preempt_owner_type.len > 0 && preempt_member_name.len > 0) {
                declared_member_exists = self.declared_member_or_method_exists_for_expr(preempt_owner_type,
                                                                                        preempt_member_name,
                                                                                        lhs_expr_id);
            }
            if (!declared_member_exists && self.restore_builtin_member_semantic(e, expr_id)) { return; }
        }
        if (self.resolve_reflection_member_expr(e, expr_id, lhs_expr_id)) { return; }
        let raw_sem_kind = expr_get_semantic_kind(e);
        let raw_target = expr_get_semantic_target(e);
        if (raw_sem_kind == expr_sem_METHOD() && raw_target != null) {
            let direct_method_fn = self.direct_closed_raw_function_target(raw_target);
            if (direct_method_fn != hir_id_invalid()) {
                self.unit.set_expr_type(expr_id, self.function_type_id(direct_method_fn));
                self.unit.set_expr_semantic(expr_id,
                                           expr_sem_METHOD(),
                                           hir_target_function(),
                                           direct_method_fn);
                return;
            }
        }
        if (raw_sem_kind == expr_sem_FIELD() && raw_target != null) {
            var semantic_field_target = raw_target;
            let semantic_owner_type = self.member_owner_type_name(e, lhs_expr_id);
            let semantic_member_name = policy_versioned_generic_call_base(
                expr_get_name(e).clone());
            let semantic_receiver_type = self.member_lookup_type_id(
                self.unit.expr_type(lhs_expr_id));
            let indexed_semantic_field = self.field_id_for_type_and_name(
                semantic_receiver_type,
                semantic_member_name);
            if (indexed_semantic_field != hir_id_invalid()) {
                self.unit.set_expr_type(expr_id,
                                       self.unit.item_type(indexed_semantic_field));
                self.unit.set_expr_semantic(expr_id,
                                           expr_sem_FIELD(),
                                           hir_target_field(),
                                           indexed_semantic_field);
                return;
            }
            if (semantic_owner_type.len > 0 && semantic_member_name.len > 0) {
                let canonical_field = self.raw_member_decl_for_type_text(
                    semantic_owner_type,
                    semantic_member_name);
                if (canonical_field != null
                    && decl_get_kind(canonical_field) == de_FIELD()) {
                    semantic_field_target = canonical_field;
                }
            }
            let raw_field_owner = hir_raw_owner_map_get(self.decl_owner_map,
                                                        semantic_field_target);
            if (raw_field_owner == null
                || !hir_builder_decl_template_head(raw_field_owner)) {
                let direct_field = hir_pointer_map_item(self.decl_map,
                                                        semantic_field_target);
                if (direct_field != hir_id_invalid()
                    && !self.direct_field_shadows_concrete_instance(direct_field, lhs_expr_id)) {
                    self.unit.set_expr_type(expr_id, self.unit.item_type(direct_field));
                    self.unit.set_expr_semantic(expr_id,
                                               expr_sem_FIELD(),
                                               hir_target_field(),
                                               direct_field);
                    return;
                }
            }
        }
        let existing_target_kind = self.unit.expr_target_kind(expr_id);
        if (existing_target_kind != hir_target_none()
            && existing_target_kind != hir_target_field()
            && existing_target_kind != hir_target_variant()
            && existing_target_kind != hir_target_builtin()
            && existing_target_kind != hir_target_function()) { return; }
        var owner_type_name = self.member_owner_type_name(e, lhs_expr_id);
        if (owner_type_name.len == 0) {
            if (self.restore_builtin_member_semantic(e, expr_id)) { return; }
            return;
        }
        let member_name = policy_versioned_generic_call_base(expr_get_name(e).clone());
        if (self.unit.expr_sem_kind(expr_id) == expr_sem_FIELD()
            || existing_target_kind == hir_target_field()) {
            let receiver_type_id = self.member_lookup_type_id(self.unit.expr_type(lhs_expr_id));
            let field_item_by_receiver = self.field_id_for_type_and_name(receiver_type_id, member_name);
            if (field_item_by_receiver != hir_id_invalid()) {
                self.unit.set_expr_type(expr_id, self.unit.item_type(field_item_by_receiver));
                self.unit.set_expr_semantic(expr_id,
                                           expr_sem_FIELD(),
                                           hir_target_field(),
                                           field_item_by_receiver);
                return;
            }
        }
        let dyn_iface_name = self.dyn_interface_name_from_type_text(owner_type_name);
        if (dyn_iface_name.len > 0) {
            let dyn_method_fn = self.method_function_target_by_owner_type_and_method(dyn_iface_name, member_name);
            if (dyn_method_fn != hir_id_invalid()) {
                self.unit.set_expr_type(expr_id, self.function_type_id(dyn_method_fn));
                self.unit.set_expr_semantic(expr_id, expr_sem_METHOD(), hir_target_function(), dyn_method_fn);
                return;
            }
        }
        let owner_type_id_for_tuple = self.unit.expr_type(lhs_expr_id);
        if (self.resolve_tuple_builtin_member_expr(expr_id, owner_type_id_for_tuple, member_name)) { return; }
        let want_static_member = self.unit.expr_sem_kind(lhs_expr_id) == expr_sem_CLASS();
        var semantic_method_decl: rawptr = null;
        if (!defer_method_resolution_for_direct_call) {
            semantic_method_decl = self.semantic_method_decl_for_member_ast(e,
                                                                            owner_type_name,
                                                                            member_name,
                                                                            want_static_member);
        }
        if (semantic_method_decl != null) {
            let semantic_method_fn = self.closed_method_target_for_type_text(owner_type_name,
                                                                             member_name,
                                                                             null,
                                                                             hir_id_invalid(),
                                                                             semantic_method_decl,
                                                                             want_static_member);
            if (semantic_method_fn != hir_id_invalid()) {
                self.unit.set_expr_type(expr_id, self.function_type_id(semantic_method_fn));
                self.unit.set_expr_semantic(expr_id,
                                           expr_sem_METHOD(),
                                           hir_target_function(),
                                           semantic_method_fn);
                return;
            }
        }
        var member_decl = self.raw_member_decl_for_type_text(owner_type_name, member_name);
        if (member_decl == null) {
            let payload_owner_type = self.heap_indirect_member_owner_type_text(owner_type_name, member_name);
            if (payload_owner_type.len > 0) {
                let payload_member_decl = self.raw_member_decl_for_type_text(payload_owner_type, member_name);
                if (payload_member_decl != null) {
                    owner_type_name = payload_owner_type;
                    member_decl = payload_member_decl;
                }
            }
        }
        if (member_decl == null) {
            let owner_type_id = self.member_lookup_type_id(self.unit.expr_type(lhs_expr_id));
            let field_item = self.field_id_for_type_and_name(owner_type_id, member_name);
            if (field_item != hir_id_invalid()) {
                self.unit.set_expr_type(expr_id, self.unit.item_type(field_item));
                self.unit.set_expr_semantic(expr_id, expr_sem_FIELD(), hir_target_field(), field_item);
                return;
            }
            var method_owner_type = owner_type_name;
            var method_fn = hir_id_invalid();
            if (!defer_method_resolution_for_direct_call) {
                method_fn = self.closed_method_target_for_type_text(method_owner_type,
                                                                    member_name,
                                                                    null,
                                                                    hir_id_invalid(),
                                                                    null,
                                                                    want_static_member);
            }
            if (method_fn == hir_id_invalid()) {
                let payload_owner_type = self.heap_indirect_member_owner_type_text(owner_type_name, member_name);
                if (payload_owner_type.len > 0 && !defer_method_resolution_for_direct_call) {
                    var payload_method_fn = self.closed_method_target_for_type_text(payload_owner_type,
                                                                                    member_name,
                                                                                    null,
                                                                                    hir_id_invalid(),
                                                                                    null,
                                                                                    false);
                    if (payload_method_fn != hir_id_invalid()) {
                        method_owner_type = payload_owner_type;
                        method_fn = payload_method_fn;
                    }
                }
            }
            if (method_fn != hir_id_invalid()) {
                self.unit.set_expr_type(expr_id, self.function_type_id(method_fn));
                self.unit.set_expr_semantic(expr_id, expr_sem_METHOD(), hir_target_function(), method_fn);
                return;
            }
            if (self.resolve_default_new_member_expr(expr_id, owner_type_name, member_name)) { return; }
            if (self.resolve_string_builtin_member_expr(expr_id, owner_type_name, member_name)) { return; }
            if (self.resolve_primitive_builtin_member_expr(expr_id, owner_type_name, member_name)) { return; }
            if (self.restore_builtin_member_semantic(e, expr_id)) { return; }
            return;
        }
        let owner_decl = self.raw_class_decl_for_type_text(owner_type_name);
        if (hir_builder_decl_is_assoc_const_member(member_decl)) {
            let value_item = self.concrete_member_value_target_for_type_text(member_decl, owner_decl, owner_type_name);
            if (value_item == hir_id_invalid()) { return; }
            self.unit.set_expr_type(expr_id, self.unit.item_type(value_item));
            self.unit.set_expr_semantic(expr_id, expr_sem_CONST(), hir_target_item(), value_item);
            return;
        }
        if (decl_get_kind(member_decl) == de_FIELD()) {
            let field_item = self.concrete_field_target_for_type_text(member_decl, owner_decl, owner_type_name);
            if (field_item == hir_id_invalid()) { return; }
            self.unit.set_expr_type(expr_id, self.unit.item_type(field_item));
            self.unit.set_expr_semantic(expr_id, expr_sem_FIELD(), hir_target_field(), field_item);
            return;
        }
        if (decl_get_kind(member_decl) == de_VARIANT()) {
            let variant_item = self.concrete_variant_target_for_type_text(member_decl, owner_decl, owner_type_name);
            if (variant_item == hir_id_invalid()) { return; }
            let variant_type = self.variant_constructor_type_id_for_type_text(member_decl, owner_decl, owner_type_name);
            if (variant_type != hir_id_invalid()) {
                self.unit.set_expr_type(expr_id, variant_type);
            } else {
                self.unit.set_expr_type(expr_id, self.unit.item_type(variant_item));
            }
            self.unit.set_expr_semantic(expr_id, expr_sem_VARIANT(), hir_target_variant(), variant_item);
            return;
        }
        if (decl_get_kind(member_decl) == de_CONST() || decl_get_kind(member_decl) == de_GLOBAL_VAR()) {
            let value_item = self.concrete_member_value_target_for_type_text(member_decl, owner_decl, owner_type_name);
            if (value_item == hir_id_invalid()) { return; }
            self.unit.set_expr_type(expr_id, self.unit.item_type(value_item));
            var value_sem = expr_sem_CONST();
            if (decl_get_kind(member_decl) == de_GLOBAL_VAR()) { value_sem = expr_sem_GLOBAL(); }
            self.unit.set_expr_semantic(expr_id, value_sem, hir_target_item(), value_item);
            return;
        }
        if (decl_get_kind(member_decl) == de_METHOD()) {
            if (defer_method_resolution_for_direct_call) { return; }
            var selected_method_decl = semantic_method_decl;
            if (selected_method_decl == null) { selected_method_decl = member_decl; }
            var method_fn = self.closed_method_target_for_type_text(owner_type_name,
                                                                    member_name,
                                                                    null,
                                                                    hir_id_invalid(),
                                                                    selected_method_decl,
                                                                    decl_get_is_static(selected_method_decl) || want_static_member);
            if (method_fn == hir_id_invalid()) { return; }
            method_fn = self.prefer_closed_function_instance_for_owner_method(owner_type_name,
                                                                              member_name,
                                                                              method_fn);
            self.unit.set_expr_type(expr_id, self.function_type_id(method_fn));
            self.unit.set_expr_semantic(expr_id, expr_sem_METHOD(), hir_target_function(), method_fn);
        }
    }

    fn hir_type_id_peel_handle(self, type_id: i32) -> i32 {
        var cur = type_id;
        var depth: i32 = 0;
        while (depth < 4 && self.type_id_is_valid(cur)) {
            let kind = hir_type_table_kind(self.unit.types, cur);
            if (kind != ty_PTR() && kind != ty_REF() && kind != ty_MUTREF()) {
                return cur;
            }
            let elem = hir_type_table_elem(self.unit.types, cur);
            if (!self.type_id_is_valid(elem)) { return cur; }
            cur = elem;
            depth = depth + 1;
        }
        return cur;
    }

    fn dyn_interface_name_from_type_text(self, type_text: string) -> string {
        let peeled = hir_builder_peel_handle_type_text(type_text);
        if (peeled.len <= 3) { return ""; }
        let base = policy_generic_call_base(peeled.clone());
        if (base.len <= 3 || !base.startsWith("dyn")) { return ""; }
        let iface_base = base.substring(3, base.len);
        if (iface_base.len == 0) { return ""; }
        let args = policy_generic_call_args(peeled.clone());
        if (args.len > 0) { return iface_base + "::<" + args + ">"; }
        return iface_base;
    }

    fn dyn_interface_method_target_for_callee_member(self, callee_expr_id: i32) -> i32 {
        if (callee_expr_id == hir_id_invalid()) { return hir_id_invalid(); }
        if (self.unit.expr_kind(callee_expr_id) != ex_MEMBER()) { return hir_id_invalid(); }
        let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
        if (owner_expr_id == hir_id_invalid()) { return hir_id_invalid(); }
        let owner_type_id = self.member_lookup_type_id(self.unit.expr_type(owner_expr_id));
        if (!self.type_id_is_valid(owner_type_id)) { return hir_id_invalid(); }
        let owner_type_name = self.member_lookup_type_name(owner_type_id);
        let dyn_iface_name = self.dyn_interface_name_from_type_text(owner_type_name);
        if (dyn_iface_name.len == 0) { return hir_id_invalid(); }
        let member_name = policy_versioned_generic_call_base(self.unit.expr_name(callee_expr_id).clone());
        return self.method_function_target_by_owner_type_and_method(dyn_iface_name, member_name);
    }

    fn materialize_dyn_trait_impl_methods_on_trait(self,
                                                          actual_type_name: string,
                                                          trait_decl: rawptr,
                                                          depth: i32) {
        if (actual_type_name.len == 0 || trait_decl == null || depth > 16) { return; }
        if ((decl_get_generic_flags(trait_decl) & 2) == 0) { return; }
        var member = decl_get_members(trait_decl);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && !decl_get_is_static(member)) {
                var method_start: i64 = 0;
                let method_timing = hir_builder_env_enabled("VYX_HIR_DYN_MATERIALIZE_TIMING");
                if (method_timing) { method_start = vyx_bootstrap_now_ms(); }
                self.ensure_method_instance_for_type_text(actual_type_name, decl_get_name(member));
                if (method_timing) {
                    let method_elapsed = vyx_bootstrap_now_ms() - method_start;
                    if (method_elapsed >= hir_builder_slow_expr_threshold_ms()) {
                        print("[hir-dyn-method] type=" + actual_type_name
                              + " trait=" + decl_get_name(trait_decl)
                              + " method=" + decl_get_name(member)
                              + " elapsed=" + policy_i64_to_string(method_elapsed)
                              + " depth=" + self.i32_text(depth));
                    }
                }
            }
            member = decl_get_next(member);
        }
        let gp = decl_get_generic_params(trait_decl);
        var idx: i32 = 0;
        while (idx < 64) {
            let super_name = hir_builder_impl_trait_at(gp, idx);
            if (super_name.len == 0) { break; }
            let super_decl = self.raw_interface_decl_for_trait_name(super_name);
            if (super_decl != null && super_decl != trait_decl) {
                self.materialize_dyn_trait_impl_methods_on_trait(actual_type_name,
                                                                 super_decl,
                                                                 depth + 1);
            }
            idx = idx + 1;
        }
    }

    fn materialize_dyn_trait_impl_methods(self, actual_type_name: string, trait_name: string) {
        if (actual_type_name.len == 0 || trait_name.len == 0) { return; }
        if (hir_pair_id_map_get(self.dyn_trait_impl_materialized_cache,actual_type_name, trait_name) != hir_id_invalid()) {
            return;
        }
        let timing_enabled = hir_builder_env_enabled("VYX_HIR_DYN_MATERIALIZE_TIMING");
        var timing_start: i64 = 0;
        var timing_satisfy_ms: i64 = 0;
        var timing_decl_ms: i64 = 0;
        var timing_methods_ms: i64 = 0;
        if (timing_enabled) { timing_start = vyx_bootstrap_now_ms(); }
        if (!self.type_text_satisfies_dyn_trait(actual_type_name, trait_name)) { return; }
        var timing_mark: i64 = 0;
        if (timing_enabled) {
            timing_mark = vyx_bootstrap_now_ms();
            timing_satisfy_ms = timing_mark - timing_start;
        }
        let trait_decl = self.raw_interface_decl_for_trait_name(trait_name);
        if (trait_decl == null) { return; }
        if (timing_enabled) {
            let now_decl = vyx_bootstrap_now_ms();
            timing_decl_ms = now_decl - timing_mark;
            timing_mark = now_decl;
        }
        self.materialize_dyn_trait_impl_methods_on_trait(actual_type_name, trait_decl, 0);
        if (timing_enabled) {
            timing_methods_ms = vyx_bootstrap_now_ms() - timing_mark;
        }
        self.dyn_trait_impl_materialized_cache = hir_pair_id_map_put(self.dyn_trait_impl_materialized_cache,actual_type_name, trait_name, 1);
        if (timing_enabled) {
            let total = vyx_bootstrap_now_ms() - timing_start;
            if (total >= hir_builder_slow_expr_threshold_ms()) {
                print("[hir-dyn-materialize] type=" + actual_type_name
                      + " trait=" + trait_name
                      + " total=" + policy_i64_to_string(total)
                      + " satisfy=" + policy_i64_to_string(timing_satisfy_ms)
                      + " decl=" + policy_i64_to_string(timing_decl_ms)
                      + " methods=" + policy_i64_to_string(timing_methods_ms));
            }
        }
    }

    fn expr_dyn_payload_type_text(self, expr_id: i32) -> string {
        var cur = expr_id;
        var depth: i32 = 0;
        var last = "";
        while (depth < 6 && cur != hir_id_invalid()) {
            let type_id = self.unit.expr_type(cur);
            if (self.type_id_is_valid(type_id)) {
                let peeled = hir_builder_peel_handle_type_text(
                    hir_type_table_text(self.unit.types, type_id));
                if (peeled.len > 0) { last = peeled; }
                if (self.dyn_interface_name_from_type_text(peeled).len == 0) {
                    let base = policy_generic_call_base(peeled.clone());
                    if (base.len > 0
                        && base != "ref"
                        && base != "mutref"
                        && base != "ptr"
                        && base != "rawptr") {
                        return peeled;
                    }
                }
            }
            let kind = self.unit.expr_kind(cur);
            if (kind != ex_ADDR_OF()
                && kind != ex_CAST()
                && kind != ex_DEREF()
                && kind != ex_UNARY()) {
                break;
            }
            cur = self.unit.expr_lhs(cur);
            depth = depth + 1;
        }
        return last;
    }

    fn materialize_dyn_type_coercion(self, actual_type_id: i32, expected_type_id: i32) {
        if (!self.type_id_is_valid(actual_type_id) || !self.type_id_is_valid(expected_type_id)) { return; }
        let expected_core = self.hir_type_id_peel_handle(expected_type_id);
        let trait_name = self.dyn_interface_name_from_type_text(
            hir_type_table_text(self.unit.types, expected_core));
        if (trait_name.len == 0) { return; }
        let actual_core = self.hir_type_id_peel_handle(actual_type_id);
        if (!self.type_id_is_valid(actual_core)) { return; }
        let actual_name = hir_type_table_text(self.unit.types, actual_core);
        if (actual_name.len == 0) { return; }
        if (self.dyn_interface_name_from_type_text(actual_name).len > 0) { return; }
        self.materialize_dyn_trait_impl_methods(actual_name, trait_name);
    }

    fn materialize_dyn_expected_arg_impl(self, arg_expr_id: i32, expected_type_id: i32) {
        if (arg_expr_id == hir_id_invalid() || !self.type_id_is_valid(expected_type_id)) { return; }
        let expected_type_name = hir_type_table_text(self.unit.types, expected_type_id);
        let trait_name = self.dyn_interface_name_from_type_text(expected_type_name);
        if (trait_name.len == 0) { return; }
        self.materialize_dyn_type_coercion(self.unit.expr_type(arg_expr_id), expected_type_id);
        let walked = self.expr_dyn_payload_type_text(arg_expr_id);
        if (walked.len > 0 && self.dyn_interface_name_from_type_text(walked).len == 0) {
            self.materialize_dyn_trait_impl_methods(walked, trait_name);
        }
    }

    fn next_source_param_local(self, local_id: i32) -> i32 {
        var cur = local_id;
        while (cur != hir_id_invalid()) {
            let flags = self.unit.local_flags(cur);
            if ((flags & hir_local_flag_param()) != 0) { return cur; }
            if ((flags & hir_local_flag_capture()) == 0) { return hir_id_invalid(); }
            cur = self.unit.local_next(cur);
        }
        return hir_id_invalid();
    }

    fn materialize_dyn_call_arg_impls(self,
                                             call_expr_id: i32,
                                             callee_expr_id: i32,
                                             target_fn: i32) {
        if (call_expr_id == hir_id_invalid() || target_fn == hir_id_invalid()) { return; }
        var param_local = self.next_source_param_local(self.unit.function_first_local(target_fn));
        if (self.local_is_constructor_abi_self(target_fn, param_local)) {
            param_local = self.next_source_param_local(self.unit.local_next(param_local));
        } else if (callee_expr_id != hir_id_invalid()
            && self.unit.expr_kind(callee_expr_id) == ex_MEMBER()
            && param_local != hir_id_invalid()
            && (self.unit.local_flags(param_local) & hir_local_flag_self_receiver()) != 0) {
            let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
            if (owner_expr_id != hir_id_invalid()
                && self.unit.expr_sem_kind(owner_expr_id) != expr_sem_CLASS()) {
                param_local = self.next_source_param_local(self.unit.local_next(param_local));
            }
        }
        var arg_expr = self.unit.expr_first_arg(call_expr_id);
        while (arg_expr != hir_id_invalid() && param_local != hir_id_invalid()) {
            self.materialize_dyn_expected_arg_impl(arg_expr, self.unit.local_type(param_local));
            arg_expr = self.unit.expr_next_arg(arg_expr);
            param_local = self.next_source_param_local(self.unit.local_next(param_local));
        }
    }

    fn apply_function_call_arg_expected_types(self,
                                                    call_expr_id: i32,
                                                    callee_expr_id: i32,
                                                    target_fn: i32) {
        if (call_expr_id == hir_id_invalid()
            || target_fn == hir_id_invalid()
            || self.unit.expr_kind(call_expr_id) != ex_CALL()) {
            return;
        }
        var param_local = self.next_source_param_local(self.unit.function_first_local(target_fn));
        if (self.local_is_constructor_abi_self(target_fn, param_local)) {
            param_local = self.next_source_param_local(self.unit.local_next(param_local));
        } else if (callee_expr_id != hir_id_invalid()
            && self.unit.expr_kind(callee_expr_id) == ex_MEMBER()
            && param_local != hir_id_invalid()
            && (self.unit.local_flags(param_local) & hir_local_flag_self_receiver()) != 0) {
            let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
            if (owner_expr_id != hir_id_invalid()
                && self.unit.expr_sem_kind(owner_expr_id) != expr_sem_CLASS()) {
                param_local = self.next_source_param_local(self.unit.local_next(param_local));
            }
        }
        var arg_expr = self.unit.expr_first_arg(call_expr_id);
        while (arg_expr != hir_id_invalid() && param_local != hir_id_invalid()) {
            self.apply_expected_expr_type(arg_expr, self.unit.local_type(param_local));
            arg_expr = self.unit.expr_next_arg(arg_expr);
            param_local = self.next_source_param_local(self.unit.local_next(param_local));
        }
    }

    fn member_call_target_needs_receiver_rebind(self,
                                                 e: rawptr,
                                                 callee_expr_id: i32,
                                                 target_id: i32) -> bool {
        if (target_id == hir_id_invalid()
            || callee_expr_id == hir_id_invalid()
            || self.unit.expr_kind(callee_expr_id) != ex_MEMBER()) {
            return false;
        }
        var raw_callee = e;
        if (raw_callee != null && expr_get_kind(raw_callee) == ex_CALL()) {
            raw_callee = expr_get_lhs(raw_callee);
        }
        if (raw_callee == null
            || expr_get_kind(raw_callee) != ex_MEMBER()
            || !hir_builder_expr_is_self_ident(expr_get_lhs(raw_callee))) {
            return false;
        }
        let receiver_type_name = self.member_call_owner_type_name(e, callee_expr_id);
        if (receiver_type_name.len == 0) { return false; }
        let target_owner_type = hir_unit_function_owner_type(self.unit, target_id);
        if (target_owner_type.len == 0) { return false; }
        return !self.function_candidate_has_exact_owner_type(target_id, receiver_type_name);
    }

    fn member_call_owner_type_name(self, e: rawptr, callee_expr_id: i32) -> string {
        if (callee_expr_id == hir_id_invalid()
            || self.unit.expr_kind(callee_expr_id) != ex_MEMBER()) {
            return "";
        }
        let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
        if (owner_expr_id == hir_id_invalid()) { return ""; }
        if (self.unit.expr_sem_kind(owner_expr_id) == expr_sem_CLASS()) {
            return self.resolve_type_text_in_current_env(self.unit.expr_name(owner_expr_id));
        }
        var raw_callee = e;
        if (e != null && expr_get_kind(e) == ex_CALL()) {
            raw_callee = expr_get_lhs(e);
        }
        let owner_from_raw = self.member_owner_type_name(raw_callee, owner_expr_id);
        if (owner_from_raw.len > 0) {
            return self.resolve_type_text_in_current_env(owner_from_raw);
        }
        let owner_type_id = self.member_lookup_type_id(self.unit.expr_type(owner_expr_id));
        if (!self.type_id_is_valid(owner_type_id)) { return ""; }
        return self.member_lookup_type_name(owner_type_id);
    }

    fn method_call_target_cache_key(self,
                                           method_name: string,
                                           want_static: bool,
                                           explicit_method_args: string,
                                           call_expr_id: i32) -> string {
        if (method_name.len == 0
            || call_expr_id == hir_id_invalid()
            || self.unit.expr_kind(call_expr_id) != ex_CALL()) {
            return "";
        }
        var out = method_name;
        if (want_static) {
            out = out + "|static=1";
        } else {
            out = out + "|static=0";
        }
        let env_key = hir_builder_env_key(self.current_generic_params, self.current_generic_args);
        if (env_key.len > 0) { out = out + "|env=" + env_key; }
        if (explicit_method_args.len > 0) {
            out = out + "|explicit=" + explicit_method_args;
        }
        out = out.clone() + "|args=";
        var arg_expr = self.unit.expr_first_arg(call_expr_id);
        var arg_count: i32 = 0;
        while (arg_expr != hir_id_invalid()) {
            let arg_type_id = self.unit.expr_type(arg_expr);
            if (!self.type_id_is_valid(arg_type_id)) { return ""; }
            var arg_text = hir_type_table_text(self.unit.types, arg_type_id);
            if (arg_text.len == 0) { return ""; }
            let resolved = self.resolve_type_text_in_current_env(arg_text);
            if (resolved.len > 0) { arg_text = resolved; }
            if (self.type_text_has_open_template_atom(arg_text)) { return ""; }
            if (arg_count > 0) { out = out.clone() + ","; }
            out = out.clone() + arg_text;
            arg_count = arg_count + 1;
            arg_expr = self.unit.expr_next_arg(arg_expr);
        }
        if (arg_count == 0) { out = out.clone() + "()"; }
        return out;
    }

    fn concrete_method_target_for_call_expr(self,
                                                   e: rawptr,
                                                   call_expr_id: i32,
                                                   callee_expr_id: i32,
                                                   method_decl: rawptr) -> i32 {
        if (callee_expr_id == hir_id_invalid()
            || self.unit.expr_kind(callee_expr_id) != ex_MEMBER()) {
            return hir_id_invalid();
        }
        let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
        if (owner_expr_id == hir_id_invalid()) { return hir_id_invalid(); }
        let owner_type_name = self.member_call_owner_type_name(e, callee_expr_id);
        if (owner_type_name.len == 0 || self.type_text_has_open_template_atom(owner_type_name)) {
            return hir_id_invalid();
        }
        if (self.dyn_interface_name_from_type_text(owner_type_name).len > 0) {
            return hir_id_invalid();
        }
        let method_name = policy_versioned_generic_call_base(self.unit.expr_name(callee_expr_id).clone());
        if (method_name.len == 0) { return hir_id_invalid(); }
        var selected_decl = method_decl;
        var selected_decl_is_authoritative = selected_decl != null;
        var selected_decl_from_raw_semantic = false;
        var raw_callee_ast = e;
        if (raw_callee_ast != null
            && expr_get_kind(raw_callee_ast) == ex_CALL()) {
            raw_callee_ast = expr_get_lhs(raw_callee_ast);
        }
        // resolve_call_expr_after_children forwards the member's Sema target
        // as method_decl. Treat that exact AST target as semantic provenance
        // too: otherwise the non-null argument bypasses the self-receiver
        // rebound below and a default interface body keeps calling its
        // bodyless prototype instead of the concrete implementation.
        if (selected_decl != null
            && raw_callee_ast != null
            && expr_get_kind(raw_callee_ast) == ex_MEMBER()
            && expr_get_semantic_target(raw_callee_ast) == selected_decl) {
            selected_decl_from_raw_semantic = true;
        }
        if (selected_decl == null
            && raw_callee_ast != null
            && expr_get_kind(raw_callee_ast) == ex_MEMBER()) {
            let semantic_decl = expr_get_semantic_target(raw_callee_ast);
            if (semantic_decl != null
                && decl_get_kind(semantic_decl) == de_METHOD()) {
                selected_decl = semantic_decl;
                selected_decl_is_authoritative = true;
                selected_decl_from_raw_semantic = true;
            }
        }
        if (selected_decl == null && call_expr_id != hir_id_invalid()) {
            selected_decl = self.raw_method_decl_for_call_expr(e,
                                                               call_expr_id,
                                                               callee_expr_id);
            if (policy_module_selector_index(
                    self.unit.expr_name(callee_expr_id)) >= 0) {
                selected_decl_is_authoritative = true;
            }
        }
        // Sema is authoritative for member overload selection.  HIR may
        // still be resolving literal and pointer argument types here, so a
        // local re-score is only safe after it has explicit, complete type
        // evidence; preserving the semantic declaration avoids collapsing
        // distinct virtual overloads onto the first owner/name match.
        var explicit_method_args = self.resolve_explicit_generic_args_for_call(e);
        if (explicit_method_args.len == 0) {
            explicit_method_args = self.resolve_explicit_generic_args_for_hir_call(call_expr_id);
        }
        let want_static = self.unit.expr_sem_kind(owner_expr_id) == expr_sem_CLASS();
        // Sema records the generic-class template declaration, while the
        // HIR receiver is already closed (Holder::<i32>, etc.).  Prefer the
        // exact full-specialization body before treating that Sema target as
        // authoritative. Version selectors remain authoritative by design.
        if (selected_decl != null
            && policy_generic_call_args(owner_type_name.clone()).len > 0
            && policy_module_selector_index(self.unit.expr_name(callee_expr_id)) < 0
            && !hir_builder_decl_is_foreign_dci_native(selected_decl)) {
            let specialized_decl = self.canonical_method_decl_for_owner_type(
                selected_decl,
                owner_type_name);
            if (specialized_decl != null
                && specialized_decl != selected_decl
                && self.raw_function_body_decl_for(specialized_decl) != null) {
                selected_decl = specialized_decl;
                selected_decl_is_authoritative = true;
            }
        }
        // An explicit method generic list always requests a closed template
        // instance.  Resolve it before name-keyed HIR caches, which contain
        // erased signature shells and therefore cannot represent `<T>`.
        if (explicit_method_args.len > 0) {
            var explicit_template = self.raw_template_method_decl_for_call_type_text(
                owner_type_name,
                method_name,
                want_static,
                e,
                call_expr_id);
            if (hir_builder_decl_template_params(explicit_template).len == 0) {
                explicit_template = self.raw_template_method_decl_for_type_text(
                    owner_type_name,
                    method_name,
                    want_static);
            }
            if (explicit_template != null
                && hir_builder_decl_template_params(explicit_template).len > 0
                && !hir_builder_decl_is_foreign_dci_native(explicit_template)) {
                let explicit_fn = self.closed_method_target_for_type_text(
                    owner_type_name,
                    method_name,
                    e,
                    call_expr_id,
                    explicit_template,
                    want_static);
                if (explicit_fn != hir_id_invalid()
                    && !self.function_has_open_template_types(explicit_fn)
                    && self.function_candidate_matches_method_name(explicit_fn, method_name)) {
                    return explicit_fn;
                }
            }
        }
        // Sema records the declaration selected while parsing the original
        // parent body. Once that body is materialized for a derived receiver,
        // a bare `self.method()` must restart lookup at the concrete receiver
        // class so overrides bind to that receiver's instance. Explicit base
        // calls, version-selected calls, foreign DCI methods, and caller-
        // supplied declarations remain authoritative.
        if (selected_decl_from_raw_semantic
            && !want_static
            && raw_callee_ast != null
            && expr_get_kind(raw_callee_ast) == ex_MEMBER()
            && policy_module_selector_index(expr_get_name(raw_callee_ast)) < 0
            && !hir_builder_decl_is_foreign_dci_native(selected_decl)) {
            let raw_receiver = expr_get_lhs(raw_callee_ast);
            let semantic_owner = hir_raw_owner_map_get(self.decl_owner_map,selected_decl);
            let receiver_owner = self.raw_class_decl_for_type_text(owner_type_name);
            if (hir_builder_expr_is_self_ident(raw_receiver)
                && semantic_owner != null
                && receiver_owner != null
                && receiver_owner != semantic_owner
                && self.owner_decl_accepts_owner_type(semantic_owner, owner_type_name)) {
                let rebound_decl = self.raw_method_decl_for_call_on_class_tree(
                    receiver_owner,
                    method_name,
                    false,
                    e,
                    call_expr_id,
                    owner_type_name,
                    0);
                if (rebound_decl != null
                    && !hir_builder_decl_is_foreign_dci_native(rebound_decl)) {
                    selected_decl = rebound_decl;
                }
            }
        }
        // An explicit method generic list is a materialization request, not a
        // decoration on a closed declaration. Sema can point at a concrete
        // signature clone whose generic metadata has already been erased; use
        // the matching template body when it has the same selected call shape.
        // This keeps overload selection while carrying method parameters
        // through nested generic calls such as bind<T> -> self.matches::<T>().
        if (selected_decl != null
            && explicit_method_args.len > 0
            && raw_callee_ast != null
            && expr_get_kind(raw_callee_ast) == ex_MEMBER()
            && policy_module_selector_index(expr_get_name(raw_callee_ast)) < 0
            && !hir_builder_decl_is_foreign_dci_native(selected_decl)) {
            var template_decl = self.raw_template_method_decl_for_call_type_text(
                owner_type_name,
                method_name,
                want_static,
                e,
                call_expr_id);
            // The call-scored lookup may return Sema's erased signature clone
            // even though we explicitly need a method-generic body.  In that
            // case, recover the owner member template before testing the
            // compatible concrete signature below.
            if (hir_builder_decl_template_params(template_decl).len == 0) {
                let owner_template_decl = self.raw_template_method_decl_for_type_text(
                    owner_type_name,
                    method_name,
                    want_static);
                if (owner_template_decl != null
                    && hir_builder_decl_template_params(owner_template_decl).len > 0) {
                    template_decl = owner_template_decl;
                }
            }
            let template_params = hir_builder_decl_template_params(template_decl);
            if (template_decl != null
                && template_params.len > 0
                && !hir_builder_decl_is_foreign_dci_native(template_decl)
                // Do not require identical generic metadata here: the Sema
                // clone deliberately erased it.  Name/staticness/value-arity
                // still bind this back to the selected overload.
                && hir_builder_decl_specialization_shape_matches(selected_decl, template_decl)
                && self.decl_signature_matches_in_env(selected_decl,
                                                       template_decl,
                                                       template_params,
                                                       explicit_method_args)) {
                let template_owner = hir_raw_owner_map_get(self.decl_owner_map,template_decl);
                if (self.owner_decl_accepts_owner_type(template_owner, owner_type_name)) {
                    selected_decl = template_decl;
                    // The explicit generic list and the compatibility checks
                    // above identify this declaration more precisely than the
                    // name-keyed HIR score cache. Resolve its closed instance
                    // before considering that cache.
                    selected_decl_is_authoritative = true;
                }
            }
        }
        // Sema owns overload/version selection. Preserve its declaration
        // before consulting name-keyed caches or HIR rescoring; those indexes
        // deliberately cannot distinguish two ABI-compatible versions.
        if (selected_decl != null && selected_decl_is_authoritative) {
            let semantic_fn = self.closed_method_target_for_type_text(
                owner_type_name,
                method_name,
                e,
                call_expr_id,
                selected_decl,
                want_static);
            if (semantic_fn != hir_id_invalid()
                && !self.function_has_open_template_types(semantic_fn)
                && self.function_candidate_matches_method_name(semantic_fn,
                                                               method_name)) {
                return semantic_fn;
            }
        }
        let scored_fn = self.best_hir_method_function_for_call(
            owner_type_name,
            method_name,
            call_expr_id,
            callee_expr_id);
        if (scored_fn != hir_id_invalid()
            && self.function_candidate_matches_method_name(scored_fn,
                                                           method_name)) {
            return scored_fn;
        }
        let call_cache_key = self.method_call_target_cache_key(method_name,
                                                               want_static,
                                                               explicit_method_args,
                                                               call_expr_id);
        if (call_cache_key.len > 0) {
            let cached_target = hir_pair_id_map_get(self.method_call_target_cache,owner_type_name, call_cache_key);
            if (cached_target != hir_id_invalid()
                && self.function_candidate_matches_method_name(cached_target, method_name)
                && !self.function_has_open_template_types(cached_target)) {
                self.ensure_reachable_function_body_by_id(cached_target);
                return cached_target;
            }
        }
        if (explicit_method_args.len == 0) {
            let direct_indexed_fn = self.method_function_target_by_owner_type_and_method(owner_type_name,
                                                                                         method_name);
            if (direct_indexed_fn != hir_id_invalid()
                && self.function_candidate_matches_method_name(direct_indexed_fn, method_name)
                && self.function_candidate_covers_owner_type(direct_indexed_fn, owner_type_name)
                && !self.function_has_open_template_types(direct_indexed_fn)) {
                if (call_cache_key.len > 0) {
                    self.method_call_target_cache = hir_pair_id_map_put(self.method_call_target_cache,owner_type_name, call_cache_key, direct_indexed_fn);
                }
                self.ensure_reachable_function_body_by_id(direct_indexed_fn);
                return direct_indexed_fn;
            }
            let hir_scored_fn = self.best_hir_method_function_for_call(owner_type_name,
                                                                        method_name,
                                                                        call_expr_id,
                                                                        callee_expr_id);
            if (hir_scored_fn != hir_id_invalid()
                && self.function_candidate_matches_method_name(hir_scored_fn, method_name)) {
                if (call_cache_key.len > 0) {
                    self.method_call_target_cache = hir_pair_id_map_put(self.method_call_target_cache,owner_type_name, call_cache_key, hir_scored_fn);
                }
                return hir_scored_fn;
            }
        }
        let out_fn = self.closed_method_target_for_type_text(owner_type_name,
                                                             method_name,
                                                             e,
                                                             call_expr_id,
                                                             selected_decl,
                                                             want_static);
        if (out_fn == hir_id_invalid() || self.function_has_open_template_types(out_fn)) {
            return hir_id_invalid();
        }
        if (!self.function_candidate_matches_method_name(out_fn, method_name)) {
            return hir_id_invalid();
        }
        if (call_cache_key.len > 0) {
            self.method_call_target_cache = hir_pair_id_map_put(self.method_call_target_cache,owner_type_name, call_cache_key, out_fn);
        }
        return out_fn;
    }

    fn closed_member_call_target_for_receiver(self,
                                                     e: rawptr,
                                                     call_expr_id: i32,
                                                     callee_expr_id: i32,
                                                     current_fn: i32) -> i32 {
        if (callee_expr_id == hir_id_invalid()
            || self.unit.expr_kind(callee_expr_id) != ex_MEMBER()) {
            return current_fn;
        }
        let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
        if (owner_expr_id == hir_id_invalid()) { return current_fn; }
        var owner_type_name = "";
        if (self.unit.expr_sem_kind(owner_expr_id) == expr_sem_CLASS()) {
            owner_type_name = self.resolve_type_text_in_current_env(self.unit.expr_name(owner_expr_id));
        }
        if (owner_type_name.len == 0) {
            let owner_type_id = self.member_lookup_type_id(self.unit.expr_type(owner_expr_id));
            if (!self.type_id_is_valid(owner_type_id)) { return current_fn; }
            owner_type_name = self.member_lookup_type_name(owner_type_id);
        }
        if (owner_type_name.len == 0 || self.type_text_has_open_template_atom(owner_type_name)) {
            return current_fn;
        }
        if (self.dyn_interface_name_from_type_text(owner_type_name).len > 0) {
            return current_fn;
        }
        let method_name = policy_versioned_generic_call_base(self.unit.expr_name(callee_expr_id).clone());
        if (method_name.len == 0) { return current_fn; }
        let call_scored_fn = self.concrete_method_target_for_call_expr(e,
                                                                       call_expr_id,
                                                                       callee_expr_id,
                                                                       null);
        if (call_scored_fn != hir_id_invalid()
            && !self.function_has_open_template_types(call_scored_fn)) {
            return call_scored_fn;
        }
        if (current_fn != hir_id_invalid() && !self.function_has_open_template_types(current_fn)) {
            let current_owner_type = hir_unit_function_owner_type(self.unit, current_fn);
            if ((current_owner_type.len == 0 || current_owner_type == owner_type_name)
                && self.function_candidate_matches_method_name(current_fn, method_name)) {
                return current_fn;
            }
            if (self.unit.function_body(current_fn) != hir_id_invalid()
                && self.function_candidate_matches_method_name(current_fn, method_name)) {
                return current_fn;
            }
        }
        var closed_fn = self.concrete_method_target_for_call_expr(e,
                                                                  call_expr_id,
                                                                  callee_expr_id,
                                                                  null);
        if (closed_fn == hir_id_invalid()) {
            closed_fn = self.closed_method_target_for_type_text(owner_type_name,
                                                                method_name,
                                                                e,
                                                                call_expr_id,
                                                                null,
                                                                self.unit.expr_sem_kind(owner_expr_id) == expr_sem_CLASS());
        }
        if (closed_fn == hir_id_invalid()) { return current_fn; }
        if (self.function_has_open_template_types(closed_fn)) { return current_fn; }
        return closed_fn;
    }

    fn member_owner_type_name(self, e: rawptr, lhs_expr_id: i32) -> string {
        var member_name = "";
        if (e != null) { member_name = policy_versioned_generic_call_base(expr_get_name(e).clone()); }
        if (lhs_expr_id != hir_id_invalid()
            && self.unit.expr_sem_kind(lhs_expr_id) == expr_sem_CLASS()) {
            let class_owner = self.resolve_type_text_in_current_env(self.unit.expr_name(lhs_expr_id));
            if (class_owner.len > 0
                && !self.type_text_has_open_template_atom(class_owner)
                && self.raw_class_decl_for_type_text(class_owner) != null) {
                return class_owner;
            }
        }
        if (e != null) {
            let lhs = expr_get_lhs(e);
            if (lhs != null && expr_get_kind(lhs) == ex_IDENT()) {
                let candidate = self.resolve_type_text_in_current_env(expr_get_name(lhs));
                if (candidate.len > 0 && self.raw_class_decl_for_type_text(candidate) != null) {
                    return candidate;
                }
            }
        }
        let owner_type_id = self.member_lookup_type_id(self.unit.expr_type(lhs_expr_id));
        if (!self.type_id_is_valid(owner_type_id)) { return ""; }
        var owner_type = self.member_lookup_type_name(owner_type_id);
        if (member_name.len > 0) {
            let want_static_member = self.unit.expr_sem_kind(lhs_expr_id) == expr_sem_CLASS();
            if (self.raw_member_decl_for_type_text(owner_type, member_name) != null) {
                return owner_type;
            }
            if (self.raw_method_decl_exists_for_type_text(owner_type,
                                                          member_name,
                                                          want_static_member)) {
                return owner_type;
            }
            if (self.method_function_target_by_owner_type_and_method(owner_type, member_name) != hir_id_invalid()) {
                return owner_type;
            }
            let payload_owner = self.heap_indirect_member_owner_type_text(owner_type, member_name);
            if (payload_owner.len > 0) { return payload_owner; }
        }
        return owner_type;
    }

    fn call_semantic_can_follow_callee(self, sem_kind: i32) -> bool {
        if (sem_kind == expr_sem_DIRECT_FN()) { return true; }
        if (sem_kind == expr_sem_METHOD()) { return true; }
        if (sem_kind == expr_sem_VARIANT()) { return true; }
        if (sem_kind == expr_sem_BUILTIN()) { return true; }
        if (sem_kind == expr_sem_INDIRECT_FN()) { return true; }
        return false;
    }

    fn expr_type_is_function_value(self, expr_id: i32) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        let type_id = self.unit.expr_type(expr_id);
        if (!self.type_id_is_valid(type_id)) { return false; }
        let kind = hir_type_table_kind(self.unit.types, type_id);
        return kind == ty_FN() || kind == ty_CFN() || kind == ty_RAWPTR();
    }

    fn expr_is_direct_function_designator(self, expr_id: i32) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        if (self.unit.expr_target_kind(expr_id) != hir_target_function()) { return false; }
        let kind = self.unit.expr_kind(expr_id);
        return kind == ex_IDENT() || kind == ex_MEMBER();
    }

    fn resolve_indirect_function_value_call(self, expr_id: i32, callee_expr_id: i32) -> bool {
        if (self.unit.expr_sem_kind(callee_expr_id) == expr_sem_BUILTIN()
            || self.unit.expr_target_kind(callee_expr_id) == hir_target_builtin()) {
            return false;
        }
        // An unresolved member is not yet a callable value. Once member
        // resolution identifies a function-valued field, its target is no
        // longer NONE and the indirect-call path becomes authoritative.
        if (self.unit.expr_kind(callee_expr_id) == ex_MEMBER()
            && self.unit.expr_target_kind(callee_expr_id) == hir_target_none()) {
            return false;
        }
        if (!self.expr_type_is_function_value(callee_expr_id)) { return false; }
        if (self.expr_is_direct_function_designator(callee_expr_id)) { return false; }
        let callee_type = self.unit.expr_type(callee_expr_id);
        let return_type = hir_type_table_elem(self.unit.types, callee_type);
        self.apply_function_value_call_arg_expected_types(expr_id, callee_type);
        self.unit.set_expr_semantic(expr_id, expr_sem_INDIRECT_FN(), hir_target_none(), hir_id_invalid());
        if (self.type_id_is_valid(return_type)) {
            self.unit.set_expr_type(expr_id, return_type);
        }
        return true;
    }

    fn resolve_member_callee_method_for_call(self,
                                                   e: rawptr,
                                                   call_expr_id: i32,
                                                   callee_expr_id: i32) -> bool {
        if (call_expr_id == hir_id_invalid()
            || callee_expr_id == hir_id_invalid()
            || self.unit.expr_kind(callee_expr_id) != ex_MEMBER()) {
            return false;
        }
        let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
        if (owner_expr_id == hir_id_invalid()) { return false; }
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] member-method-owner-expr=" + self.i32_text(owner_expr_id)); }
        var owner_type_name = self.member_call_owner_type_name(e, callee_expr_id);
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] member-method-owner-raw=" + owner_type_name); }
        if (owner_type_name.len == 0) { return false; }
        // The resolver may legally return its input unchanged. Keep a distinct
        // owned input while replacing this local so that identity resolution
        // cannot return storage invalidated by the assignment itself.
        let owner_type_lookup = owner_type_name.clone();
        owner_type_name = self.resolve_type_text_in_current_env(owner_type_lookup);
        if (owner_type_name.len > 0 && self.unit.expr_sem_kind(owner_expr_id) == expr_sem_CLASS()) {
            self.unit.set_expr_name(owner_expr_id, owner_type_name);
        }
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] member-method-owner-resolved=" + owner_type_name); }
        if (owner_type_name.len == 0 || self.type_text_has_open_template_atom(owner_type_name)) {
            return false;
        }
        if (self.dyn_interface_name_from_type_text(owner_type_name).len > 0) { return false; }
        let method_name = policy_versioned_generic_call_base(self.unit.expr_name(callee_expr_id).clone());
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] member-method-name=" + method_name); }
        if (method_name.len == 0) { return false; }
        let existing_target_kind = self.unit.expr_target_kind(callee_expr_id);
        let existing_target_id = self.unit.expr_target_id(callee_expr_id);
        if (existing_target_kind == hir_target_function()
            && (existing_target_id <= 0 || existing_target_id > self.unit.function_count)) {
            self.unit.set_expr_semantic(callee_expr_id,
                                       expr_sem_NONE(),
                                       hir_target_none(),
                                       hir_id_invalid());
        }
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
            print("[hir-progress] member-method-after-stale-guard target-kind="
                  + self.i32_text(self.unit.expr_target_kind(callee_expr_id))
                  + " target=" + self.i32_text(self.unit.expr_target_id(callee_expr_id)));
        }
        let want_static = self.unit.expr_sem_kind(owner_expr_id) == expr_sem_CLASS();
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] member-method-want-static"); }
        if (self.unit.expr_target_kind(callee_expr_id) == hir_target_builtin()) {
            // Delayed member resolution can retain the builtin target after
            // its class receiver has lost the transient CLASS semantic tag.
            // The candidate filter itself proves staticness, so it remains
            // safe to recover a registered static method independently of
            // that mutable expression annotation.
            let registered_static_fn = self.best_hir_static_method_function_for_call(owner_type_name,
                                                                                       method_name,
                                                                                       call_expr_id,
                                                                                       callee_expr_id);
            var selected_static_fn = registered_static_fn;
            if (selected_static_fn == hir_id_invalid()) {
                selected_static_fn = self.unique_registered_direct_static_method_function(owner_type_name,
                                                                                            method_name);
            }
            if (selected_static_fn != hir_id_invalid()) {
                self.unit.set_expr_semantic(callee_expr_id,
                                           expr_sem_METHOD(),
                                           hir_target_function(),
                                           selected_static_fn);
                let registered_static_type = self.function_type_id(selected_static_fn);
                if (registered_static_type != hir_id_invalid()) {
                    self.unit.set_expr_type(callee_expr_id, registered_static_type);
                }
                return true;
            }
            if (!self.raw_method_decl_exists_for_type_text(owner_type_name, method_name, want_static)) {
                return false;
            }
        }
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] member-method-before-concrete"); }
        var method_fn = self.concrete_method_target_for_call_expr(e,
                                                                  call_expr_id,
                                                                  callee_expr_id,
                                                                  null);
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] member-method-concrete=" + self.i32_text(method_fn)); }
        if (method_fn == hir_id_invalid()) {
            method_fn = self.closed_method_target_for_type_text(owner_type_name,
                                                                method_name,
                                                                e,
                                                                call_expr_id,
                                                                null,
                                                                want_static);
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] member-method-closed=" + self.i32_text(method_fn)); }
        }
        if (method_fn == hir_id_invalid() || self.function_has_open_template_types(method_fn)) {
            return false;
        }
        self.unit.set_expr_semantic(callee_expr_id,
                                   expr_sem_METHOD(),
                                   hir_target_function(),
                                   method_fn);
        let method_type = self.function_type_id(method_fn);
        if (method_type != hir_id_invalid()) {
            self.unit.set_expr_type(callee_expr_id, method_type);
        }
        return true;
    }

    fn function_type_param_type_id(self, fn_type_id: i32, idx: i32) -> i32 {
        if (!self.type_id_is_valid(fn_type_id) || idx < 0) { return hir_id_invalid(); }
        let kind = hir_type_table_kind(self.unit.types, fn_type_id);
        if (kind != ty_FN() && kind != ty_CFN()) { return hir_id_invalid(); }
        let text = hir_type_table_text(self.unit.types, fn_type_id);
        var open_idx: i32 = -1;
        if (text.len >= 3 && text.substring(0, 3) == "fn(") {
            open_idx = 2;
        } elif (text.len >= 4 && text.substring(0, 4) == "cfn(") {
            open_idx = 3;
        } elif (text.len >= 10 && text.substring(0, 10) == "unsafe fn(") {
            open_idx = 9;
        }
        if (open_idx < 0) { return hir_id_invalid(); }
        let close_idx = self.fn_type_text_close_paren(text, open_idx);
        if (close_idx < 0) { return hir_id_invalid(); }
        let params_text = text.substring(open_idx + 1, close_idx);
        let param_text = policy_generic_arg_at(params_text, idx);
        if (param_text.len == 0) { return hir_id_invalid(); }
        let resolved = self.resolve_type_text_in_current_env(param_text);
        if (resolved.len == 0) { return hir_id_invalid(); }
        return self.type_id_from_text(resolved);
    }

    fn apply_function_value_call_arg_expected_types(self, call_expr_id: i32, fn_type_id: i32) {
        if (call_expr_id == hir_id_invalid()
            || self.unit.expr_kind(call_expr_id) != ex_CALL()
            || !self.type_id_is_valid(fn_type_id)) {
            return;
        }
        var arg = self.unit.expr_first_arg(call_expr_id);
        var idx: i32 = 0;
        while (arg != hir_id_invalid()) {
            let param_type = self.function_type_param_type_id(fn_type_id, idx);
            if (self.type_id_is_valid(param_type)) {
                self.apply_expected_expr_type(arg, param_type);
            }
            arg = self.unit.expr_next_arg(arg);
            idx = idx + 1;
        }
    }

    fn promote_member_field_callee_to_method(self,
                                                    e: rawptr,
                                                    expr_id: i32,
                                                    callee_expr_id: i32) -> bool {
        if (expr_id == hir_id_invalid()
            || callee_expr_id == hir_id_invalid()
            || self.unit.expr_kind(callee_expr_id) != ex_MEMBER()
            || self.unit.expr_sem_kind(callee_expr_id) != expr_sem_FIELD()) {
            return false;
        }
        let method_decl = self.raw_method_decl_for_call_expr(e, expr_id, callee_expr_id);
        if (method_decl == null) { return false; }
        let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
        if (owner_expr_id == hir_id_invalid()) { return false; }
        var raw_callee = e;
        if (e != null && expr_get_kind(e) == ex_CALL()) {
            raw_callee = expr_get_lhs(e);
        }
        let owner_type_name = self.member_owner_type_name(raw_callee, owner_expr_id);
        if (owner_type_name.len == 0 || self.type_text_has_open_template_atom(owner_type_name)) { return false; }
        let member_name = policy_versioned_generic_call_base(self.unit.expr_name(callee_expr_id).clone());
        var method_fn = self.concrete_method_target_for_call_expr(e,
                                                                  expr_id,
                                                                  callee_expr_id,
                                                                  method_decl);
        if (method_fn == hir_id_invalid()) {
            method_fn = self.closed_method_target_for_type_text(owner_type_name,
                                                                member_name,
                                                                e,
                                                                expr_id,
                                                                method_decl,
                                                                self.unit.expr_sem_kind(owner_expr_id) == expr_sem_CLASS());
        }
        if (method_fn == hir_id_invalid()) { return false; }
        self.unit.set_expr_semantic(callee_expr_id, expr_sem_METHOD(), hir_target_function(), method_fn);
        let method_type = self.function_type_id(method_fn);
        if (method_type != hir_id_invalid()) {
            self.unit.set_expr_type(callee_expr_id, method_type);
        }
        return true;
    }

    fn resolve_call_expr_after_children(self, e: rawptr, expr_id: i32, callee_expr_id: i32) {
        if (expr_id == hir_id_invalid() || callee_expr_id == hir_id_invalid()) { return; }
        let call_phase_timing = hir_builder_env_enabled("VYX_HIR_EXPR_TIMING");
        var call_phase_start: i64 = 0;
        var call_phase_mark: i64 = 0;
        var call_phase_callee: i64 = 0;
        var call_phase_target: i64 = 0;
        var call_phase_result: i64 = 0;
        var call_phase_schedule: i64 = 0;
        var call_phase_expected: i64 = 0;
        var call_phase_dyn: i64 = 0;
        var call_phase_default: i64 = 0;
        var call_phase_typefix: i64 = 0;
        if (call_phase_timing) {
            call_phase_start = vyx_bootstrap_now_ms();
            call_phase_mark = call_phase_start;
        }
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
            print("[hir-progress] resolve-call-enter expr=" + self.i32_text(expr_id)
                  + " callee=" + self.i32_text(callee_expr_id)
                  + " callee-kind=" + self.i32_text(self.unit.expr_kind(callee_expr_id))
                  + " callee-sem=" + self.i32_text(self.unit.expr_sem_kind(callee_expr_id))
                  + " callee-target=" + self.i32_text(self.unit.expr_target_id(callee_expr_id)));
        }
        if (self.unit.expr_kind(callee_expr_id) == ex_MEMBER()) {
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] resolve-call-before-promote"); }
            self.promote_member_field_callee_to_method(e, expr_id, callee_expr_id);
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] resolve-call-before-member-method"); }
            self.resolve_member_callee_method_for_call(e, expr_id, callee_expr_id);
            self.resolve_default_new_constructor_call(e, expr_id, callee_expr_id);
            if ((self.unit.expr_target_kind(callee_expr_id) == hir_target_builtin()
                 && self.unit.expr_sem_kind(callee_expr_id) == expr_sem_BUILTIN())
                || ((self.unit.expr_target_kind(callee_expr_id) == hir_target_function()
                     || self.unit.expr_target_kind(callee_expr_id) == hir_target_builtin())
                    && self.unit.expr_sem_kind(callee_expr_id) == expr_sem_DIRECT_FN()
                    && (self.unit.expr_target_id(callee_expr_id) <= 0
                        || self.function_has_open_template_types(self.unit.expr_target_id(callee_expr_id))))) {
                let qualified_fn = self.qualified_free_function_target_for_call(e,
                                                                                 expr_id,
                                                                                 callee_expr_id);
                if (qualified_fn != hir_id_invalid()) {
                    self.unit.set_expr_semantic(callee_expr_id,
                                                expr_sem_DIRECT_FN(),
                                                hir_target_function(),
                                                qualified_fn);
                    let qualified_ty = self.function_type_id(qualified_fn);
                    if (qualified_ty != hir_id_invalid()) {
                        self.unit.set_expr_type(callee_expr_id, qualified_ty);
                    }
                }
            }
            // A qualified free function is represented by the front end as a
            // module member with the BUILTIN semantic tag.  That tag is only
            // correct for compiler intrinsics: when the member still carries
            // a declaration target, recover its registered function id here
            // so imported template bodies are scheduled and their return type
            // reaches MIR.  Without this promotion `Module::generic::<T>()`
            // becomes a builtin shell and silently lowers as `void`.
            if ((self.unit.expr_target_kind(callee_expr_id) == hir_target_builtin()
                 || self.unit.expr_target_kind(callee_expr_id) == hir_target_function())
                && (self.unit.expr_sem_kind(callee_expr_id) == expr_sem_BUILTIN()
                    || self.unit.expr_sem_kind(callee_expr_id) == expr_sem_DIRECT_FN())
                && (self.unit.expr_target_id(callee_expr_id) <= 0
                    || self.function_has_open_template_types(self.unit.expr_target_id(callee_expr_id)))) {
                let raw_free = self.raw_function_target_for_call_expr(e);
                if (raw_free != null
                    && (decl_get_kind(raw_free) == de_FN()
                        || decl_get_kind(raw_free) == de_METHOD()
                        || decl_get_kind(raw_free) == de_EXTERN_FN())) {
                    let promoted_fn = hir_pointer_map_function(self.decl_map, raw_free);
                    if (promoted_fn != hir_id_invalid()) {
                        self.unit.set_expr_semantic(callee_expr_id,
                                                    expr_sem_DIRECT_FN(),
                                                    hir_target_function(),
                                                    promoted_fn);
                        let promoted_ty = self.function_type_id(promoted_fn);
                        if (promoted_ty != hir_id_invalid()) {
                            self.unit.set_expr_type(callee_expr_id, promoted_ty);
                        }
                    }
                }
            }
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] resolve-call-before-indirect-member"); }
            if (self.resolve_indirect_function_value_call(expr_id, callee_expr_id)) { return; }
        } else {
            self.resolve_construct_constructor_call(e, expr_id, callee_expr_id);
            if ((self.unit.expr_sem_kind(callee_expr_id) == expr_sem_BUILTIN()
                 || self.unit.expr_sem_kind(callee_expr_id) == expr_sem_DIRECT_FN())
                && (self.unit.expr_target_id(callee_expr_id) <= 0
                    || self.function_has_open_template_types(self.unit.expr_target_id(callee_expr_id)))) {
                let qualified_fn = self.qualified_free_function_target_for_call(e,
                                                                                 expr_id,
                                                                                 callee_expr_id);
                if (qualified_fn != hir_id_invalid()) {
                    self.unit.set_expr_semantic(callee_expr_id,
                                                expr_sem_DIRECT_FN(),
                                                hir_target_function(),
                                                qualified_fn);
                    let qualified_ty = self.function_type_id(qualified_fn);
                    if (qualified_ty != hir_id_invalid()) {
                        self.unit.set_expr_type(callee_expr_id, qualified_ty);
                    }
                }
            }
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] resolve-call-before-indirect"); }
            if (self.resolve_indirect_function_value_call(expr_id, callee_expr_id)) { return; }
        }
        if (call_phase_timing) {
            let now_callee = vyx_bootstrap_now_ms();
            call_phase_callee = now_callee - call_phase_mark;
            call_phase_mark = now_callee;
        }
        if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] resolve-call-after-callee-special"); }
        var callee_sem = self.unit.expr_sem_kind(callee_expr_id);
        if (!self.call_semantic_can_follow_callee(callee_sem)) { return; }
        var target_kind = self.unit.expr_target_kind(callee_expr_id);
        var target_id = self.unit.expr_target_id(callee_expr_id);
        // Imported artifact bodies can reach this point without retaining a
        // raw source pointer.  Retry the module/name lookup after all callee
        // normalization has completed, then continue through ordinary
        // generic instance materialization below.
        if ((callee_sem == expr_sem_BUILTIN() || callee_sem == expr_sem_DIRECT_FN())
            && target_id <= 0) {
            let late_qualified_fn = self.qualified_free_function_target_for_call(e,
                                                                                   expr_id,
                                                                                   callee_expr_id);
            if (late_qualified_fn != hir_id_invalid()) {
                callee_sem = expr_sem_DIRECT_FN();
                target_kind = hir_target_function();
                target_id = late_qualified_fn;
                self.unit.set_expr_semantic(callee_expr_id,
                                            callee_sem,
                                            target_kind,
                                            target_id);
                let late_ty = self.function_type_id(late_qualified_fn);
                if (late_ty != hir_id_invalid()) {
                    self.unit.set_expr_type(callee_expr_id, late_ty);
                }
            }
        }
        var raw_target: rawptr = null;
        let member_call_already_closed = self.unit.expr_kind(callee_expr_id) == ex_MEMBER()
            && target_kind == hir_target_function()
            && target_id != hir_id_invalid()
            && !self.function_has_open_template_types(target_id)
            && !self.member_call_target_needs_receiver_rebind(e,
                                                               callee_expr_id,
                                                               target_id);
        if (target_kind == hir_target_function()) {
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] resolve-call-target-function target=" + self.i32_text(target_id)); }
            let dyn_method_fn = self.dyn_interface_method_target_for_callee_member(callee_expr_id);
            if (dyn_method_fn != hir_id_invalid()) {
                target_id = dyn_method_fn;
                self.unit.set_expr_semantic(callee_expr_id, expr_sem_METHOD(), target_kind, target_id);
                let concrete_fn_type = self.function_type_id(target_id);
                if (concrete_fn_type != hir_id_invalid()) {
                    self.unit.set_expr_type(callee_expr_id, concrete_fn_type);
                }
            } else if (!member_call_already_closed) {
                if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] resolve-call-before-raw-target"); }
                raw_target = self.raw_function_target_for_call_expr(e);
                if (raw_target == null && target_id != hir_id_invalid()) {
                    raw_target = hir_pointer_map_raw_for_function(self.decl_map,target_id);
                }
                if (self.unit.expr_kind(callee_expr_id) == ex_MEMBER()) {
                    if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] resolve-call-before-member-retarget"); }
                    let resolved_raw_target = hir_pointer_map_raw_for_function(self.decl_map,target_id);
                    if (resolved_raw_target != null) {
                        raw_target = resolved_raw_target;
                    } else if (raw_target != null) {
                        let callee_name = policy_versioned_generic_call_base(self.unit.expr_name(callee_expr_id).clone());
                        if (decl_get_name(raw_target) != callee_name) {
                            raw_target = null;
                        }
                    }
                    let scored_method_target = self.raw_method_decl_for_call_expr(e, expr_id, callee_expr_id);
                    if (scored_method_target != null) {
                        raw_target = scored_method_target;
                    }
                }
                var concrete_fn = hir_id_invalid();
                if (self.unit.expr_kind(callee_expr_id) == ex_MEMBER()) {
                    if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] resolve-call-before-concrete-method"); }
                    concrete_fn = self.concrete_method_target_for_call_expr(e,
                                                                            expr_id,
                                                                            callee_expr_id,
                                                                            raw_target);
                }
                if (concrete_fn == hir_id_invalid()) {
                    if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] resolve-call-before-explicit-free"); }
                    concrete_fn = self.concrete_explicit_free_function_call_target(e, expr_id, callee_expr_id, raw_target);
                }
                if (concrete_fn == hir_id_invalid()) {
                    if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] resolve-call-before-free-target"); }
                    concrete_fn = self.concrete_free_function_target_for_call_expr(e,
                                                                                   expr_id,
                                                                                   callee_expr_id,
                                                                                   raw_target);
                }
                if (concrete_fn == hir_id_invalid()) {
                    if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] resolve-call-before-concrete-function"); }
                    concrete_fn = self.concrete_function_target(e, raw_target);
                }
                if (concrete_fn != hir_id_invalid()) {
                    if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) { print("[hir-progress] resolve-call-concrete=" + self.i32_text(concrete_fn)); }
                    target_id = concrete_fn;
                    if (self.unit.expr_kind(callee_expr_id) == ex_MEMBER()) {
                        let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
                        let owner_type_id = self.member_lookup_type_id(self.unit.expr_type(owner_expr_id));
                        var owner_type_name = "";
                        if (self.type_id_is_valid(owner_type_id)) {
                            owner_type_name = self.member_lookup_type_name(owner_type_id);
                        }
                        let member_name = policy_versioned_generic_call_base(self.unit.expr_name(callee_expr_id).clone());
                        target_id = self.prefer_closed_function_instance_for_owner_method(owner_type_name,
                                                                                          member_name,
                                                                                          target_id);
                    }
                    self.unit.set_expr_semantic(callee_expr_id, callee_sem, target_kind, target_id);
                    let concrete_fn_type = self.function_type_id(target_id);
                    if (concrete_fn_type != hir_id_invalid()) {
                        self.unit.set_expr_type(callee_expr_id, concrete_fn_type);
                    }
                }
            }
            if (!member_call_already_closed) {
                let receiver_closed_fn = self.closed_member_call_target_for_receiver(e,
                                                                                     expr_id,
                                                                                     callee_expr_id,
                                                                                     target_id);
                if (receiver_closed_fn != target_id) {
                    target_id = receiver_closed_fn;
                    self.unit.set_expr_semantic(callee_expr_id, callee_sem, target_kind, target_id);
                    let receiver_fn_type = self.function_type_id(target_id);
                    if (receiver_fn_type != hir_id_invalid()) {
                        self.unit.set_expr_type(callee_expr_id, receiver_fn_type);
                    }
                }
            }
        }
        if (call_phase_timing) {
            let now_target = vyx_bootstrap_now_ms();
            call_phase_target = now_target - call_phase_mark;
            call_phase_mark = now_target;
        }
        self.unit.set_expr_semantic(expr_id, callee_sem, target_kind, target_id);
        if (target_kind == hir_target_builtin()) {
            let builtin_result = self.builtin_call_result_type_id(callee_expr_id);
            if (self.type_id_is_valid(builtin_result)) {
                self.unit.set_expr_type(expr_id, builtin_result);
            }
        }
        if (target_kind == hir_target_function()) {
            var result_mark: i64 = 0;
            if (call_phase_timing) { result_mark = vyx_bootstrap_now_ms(); }
            self.ensure_reachable_function_body_for_expr(e, target_id);
            if (call_phase_timing) {
                let now_schedule = vyx_bootstrap_now_ms();
                call_phase_schedule = now_schedule - result_mark;
                result_mark = now_schedule;
            }
            self.apply_function_call_arg_expected_types(expr_id, callee_expr_id, target_id);
            if (call_phase_timing) {
                let now_expected = vyx_bootstrap_now_ms();
                call_phase_expected = now_expected - result_mark;
                result_mark = now_expected;
            }
            self.materialize_dyn_call_arg_impls(expr_id, callee_expr_id, target_id);
            if (call_phase_timing) {
                let now_dyn = vyx_bootstrap_now_ms();
                call_phase_dyn = now_dyn - result_mark;
                result_mark = now_dyn;
            }
            let return_type = self.unit.function_return_type(target_id);
            let return_text = hir_type_table_text(self.unit.types, return_type);
            if (self.unit.expr_kind(callee_expr_id) == ex_MEMBER()
                && self.method_name_is_value_assign(self.unit.expr_name(callee_expr_id))
                && (return_text.len == 0 || return_text == "void")) {
                let receiver_expr_id = self.unit.expr_lhs(callee_expr_id);
                let receiver_type = self.unit.expr_type(receiver_expr_id);
                if (self.type_id_is_valid(receiver_type)) {
                    self.unit.set_expr_type(expr_id, receiver_type);
                }
            } else if (self.type_id_is_valid(return_type)) {
                self.unit.set_expr_type(expr_id, return_type);
            }
            self.materialize_default_call_args(expr_id, raw_target);
            if (call_phase_timing) {
                let now_default = vyx_bootstrap_now_ms();
                call_phase_default = now_default - result_mark;
            }
        }
        if (self.expr_type_needs_concrete(expr_id)) {
            var typefix_mark: i64 = 0;
            if (call_phase_timing) { typefix_mark = vyx_bootstrap_now_ms(); }
            let callee_type = self.unit.expr_type(callee_expr_id);
            let callee_type_kind = hir_type_table_kind(self.unit.types, callee_type);
            if ((callee_type_kind == ty_FN() || callee_type_kind == ty_CFN())
                && self.type_id_is_valid(hir_type_table_elem(self.unit.types, callee_type))) {
                self.unit.set_expr_type(expr_id, hir_type_table_elem(self.unit.types, callee_type));
            } else if (target_kind == hir_target_function() && target_id != hir_id_invalid()) {
                // The target may be an instance shell whose return type has
                // not been backfilled yet (early cache registration); writing
                // the invalid id here would freeze the call expr as void.
                // Keep the expr type unresolved so the semantic resolver can
                // backfill it once the return type is known.
                let deferred_return_type = self.unit.function_return_type(target_id);
                if (self.type_id_is_valid(deferred_return_type)) {
                    self.unit.set_expr_type(expr_id, deferred_return_type);
                }
            } else if (target_kind == hir_target_builtin()) {
                self.unit.set_expr_type(expr_id, self.builtin_call_result_type_id(callee_expr_id));
            } else if (target_kind == hir_target_variant() && target_id != hir_id_invalid()) {
                self.unit.set_expr_type(expr_id, self.unit.item_type(target_id));
            } else if (self.type_id_is_valid(callee_type)) {
                self.unit.set_expr_type(expr_id, callee_type);
            }
            if (call_phase_timing) {
                call_phase_typefix = vyx_bootstrap_now_ms() - typefix_mark;
            }
        }
        if (call_phase_timing) {
            let now_result = vyx_bootstrap_now_ms();
            call_phase_result = now_result - call_phase_mark;
            let call_phase_total = now_result - call_phase_start;
            if (call_phase_total >= hir_builder_slow_expr_threshold_ms()) {
                print("[hir-call-phase] fn=" + self.unit.function_name(self.current_function_id)
                      + " total=" + policy_i64_to_string(call_phase_total)
                      + " callee=" + policy_i64_to_string(call_phase_callee)
                      + " target=" + policy_i64_to_string(call_phase_target)
                      + " result=" + policy_i64_to_string(call_phase_result)
                      + " schedule=" + policy_i64_to_string(call_phase_schedule)
                      + " expected=" + policy_i64_to_string(call_phase_expected)
                      + " dyn=" + policy_i64_to_string(call_phase_dyn)
                      + " default=" + policy_i64_to_string(call_phase_default)
                      + " typefix=" + policy_i64_to_string(call_phase_typefix)
                      + " name=" + self.unit.expr_name(callee_expr_id)
                      + " target_id=" + self.i32_text(target_id)
                      + " expr_id=" + self.i32_text(expr_id));
            }
        }
    }

    fn apply_expected_variant_arg_types(self,
                                               call_expr_id: i32,
                                               owner_type_id: i32,
                                               variant_decl: rawptr) {
        if (call_expr_id == hir_id_invalid()
            || self.unit.expr_kind(call_expr_id) != ex_CALL()
            || !self.type_id_is_valid(owner_type_id)
            || variant_decl == null) {
            return;
        }
        var arg = self.unit.expr_first_arg(call_expr_id);
        var arg_index: i32 = 0;
        while (arg != hir_id_invalid()) {
            let param_type = self.variant_param_type_id_for_owner(owner_type_id, variant_decl, arg_index);
            if (self.type_id_is_valid(param_type)) {
                self.apply_expected_expr_type(arg, param_type);
            }
            arg = self.unit.expr_next_arg(arg);
            arg_index = arg_index + 1;
        }
    }

    fn resolve_expected_variant_expr(self, expr_id: i32, expected_type_id: i32) -> bool {
        if (expr_id == hir_id_invalid() || !self.type_id_is_valid(expected_type_id)) { return false; }
        let expected_type_text = hir_type_table_text(self.unit.types, expected_type_id);
        if (expected_type_text.len == 0 || self.type_text_has_open_template_atom(expected_type_text)) { return false; }
        let owner_decl = self.raw_class_decl_for_type_text(expected_type_text);
        if (owner_decl == null) { return false; }
        let expr_kind = self.unit.expr_kind(expr_id);
        var variant_expr_id = expr_id;
        if (expr_kind == ex_CALL()) {
            variant_expr_id = self.unit.expr_lhs(expr_id);
        } else if (expr_kind != ex_IDENT()) {
            return false;
        }
        if (variant_expr_id == hir_id_invalid()) { return false; }
        let variant_target_kind = self.unit.expr_target_kind(variant_expr_id);
        if (variant_target_kind != hir_target_none()
            && variant_target_kind != hir_target_variant()) {
            return false;
        }
        let variant_name = policy_generic_call_base(self.unit.expr_name(variant_expr_id).clone());
        if (variant_name.len == 0) { return false; }
        let variant_decl = self.raw_member_decl_for_type_text(expected_type_text, variant_name);
        if (variant_decl == null || decl_get_kind(variant_decl) != de_VARIANT()) { return false; }
        self.ensure_concrete_type_text_ready(expected_type_text);
        let variant_item = self.concrete_variant_target_for_type_text(variant_decl,
                                                                      owner_decl,
                                                                      expected_type_text);
        if (variant_item == hir_id_invalid()) { return false; }
        let variant_type = self.variant_constructor_type_id_for_type_text(variant_decl,
                                                                          owner_decl,
                                                                          expected_type_text);
        if (variant_type != hir_id_invalid()) {
            self.unit.set_expr_type(variant_expr_id, variant_type);
        } else {
            self.unit.set_expr_type(variant_expr_id, expected_type_id);
        }
        self.unit.set_expr_semantic(variant_expr_id,
                                   expr_sem_VARIANT(),
                                   hir_target_variant(),
                                   variant_item);
        if (expr_kind == ex_CALL()) {
            self.unit.set_expr_type(expr_id, expected_type_id);
            self.unit.set_expr_semantic(expr_id,
                                       expr_sem_VARIANT(),
                                       hir_target_variant(),
                                       variant_item);
            self.apply_expected_variant_arg_types(expr_id, expected_type_id, variant_decl);
        } else {
            self.unit.set_expr_type(expr_id, expected_type_id);
            self.unit.set_expr_semantic(expr_id,
                                       expr_sem_VARIANT(),
                                       hir_target_variant(),
                                       variant_item);
        }
        return true;
    }

    fn type_id_for_item(self, item_id: i32) -> i32 {
        let direct = self.unit.item_type(item_id);
        if (direct != hir_id_invalid()) { return direct; }
        let name = self.unit.item_name(item_id);
        if (name.len == 0) { return hir_id_invalid(); }
        var type_id: i32 = 1;
        while (type_id <= self.unit.types.count) {
            if (hir_type_table_text(self.unit.types, type_id) == name) { return type_id; }
            type_id = type_id + 1;
        }
        return hir_id_invalid();
    }

    fn resolve_struct_init_type_id(self, e: rawptr, expr_id: i32) -> i32 {
        let existing = self.unit.expr_type(expr_id);
        if (self.type_id_is_valid(existing)) { return existing; }
        var name = "";
        if (e != null) { name = expr_get_name(e); }
        let ret_type = self.unit.function_return_type(self.current_function_id);
        if (self.type_id_is_valid(ret_type) && name.len > 0) {
            let ret_text = hir_type_table_text(self.unit.types, ret_type);
            if (hir_builder_last_path_segment(hir_builder_type_base_name(ret_text))
                == hir_builder_last_path_segment(policy_generic_call_base(name.clone()))) {
                self.unit.set_expr_type(expr_id, ret_type);
                return ret_type;
            }
        }
        if (name.len > 0) {
            let resolved = self.resolve_type_text_in_current_env(name);
            if (resolved.len > 0 && self.raw_class_decl_for_type_text(resolved) != null) {
                let type_id = self.type_id_from_text(resolved);
                self.unit.set_expr_type(expr_id, type_id);
                return type_id;
            }
        }
        return existing;
    }

    fn type_id_is_integer_primitive(self, type_id: i32) -> bool {
        if (!self.type_id_is_valid(type_id)) { return false; }
        let kind = hir_type_table_kind(self.unit.types, type_id);
        if (kind == ty_I8() || kind == ty_I16() || kind == ty_I32() || kind == ty_I64()) { return true; }
        if (kind == ty_U8() || kind == ty_U16() || kind == ty_U32() || kind == ty_U64()) { return true; }
        return kind == ty_ISIZE() || kind == ty_USIZE();
    }

    fn apply_expected_expr_type_from_current_env(self,
                                                        expr_id: i32,
                                                        current_type_id: i32,
                                                        expected_type_id: i32) -> bool {
        if (expr_id == hir_id_invalid()
            || !self.type_id_is_valid(current_type_id)
            || !self.type_id_is_valid(expected_type_id)
            || current_type_id == expected_type_id) {
            return false;
        }
        let expected_text = hir_type_table_text(self.unit.types, expected_type_id);
        if (expected_text.len == 0 || self.type_text_has_open_template_atom(expected_text)) {
            return false;
        }
        let current_text = hir_type_table_text(self.unit.types, current_type_id);
        if (current_text.len == 0) { return false; }
        let resolved_text = self.resolve_type_text_in_current_env(current_text);
        if (resolved_text.len == 0) { return false; }
        let resolved_type_id = self.type_id_from_text(resolved_text);
        if ((self.type_id_is_valid(resolved_type_id) && resolved_type_id == expected_type_id)
            || policy_type_name_equal(resolved_text, expected_text)) {
            self.unit.set_expr_type(expr_id, expected_type_id);
            return true;
        }
        return false;
    }

    fn expected_static_owner_type_for_call(self, expr_id: i32, expected_type_id: i32) -> string {
        if (expr_id == hir_id_invalid()
            || !self.type_id_is_valid(expected_type_id)
            || self.unit.expr_kind(expr_id) != ex_CALL()) {
            return "";
        }
        let callee_expr_id = self.unit.expr_lhs(expr_id);
        if (callee_expr_id == hir_id_invalid()
            || self.unit.expr_kind(callee_expr_id) != ex_MEMBER()) {
            return "";
        }
        let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
        if (owner_expr_id == hir_id_invalid()) { return ""; }
        var expected_text = hir_type_table_text(self.unit.types, expected_type_id);
        if (expected_text.len == 0) { return ""; }
        let resolved_expected = self.resolve_type_text_in_current_env(expected_text);
        if (resolved_expected.len > 0) { expected_text = resolved_expected; }
        if (expected_text.len == 0 || self.type_text_has_open_template_atom(expected_text)) {
            return "";
        }
        if (policy_generic_call_args(expected_text.clone()).len == 0) { return ""; }
        if (self.raw_class_decl_for_type_text(expected_text) == null) { return ""; }
        let expected_base = hir_builder_type_base_name(expected_text);
        if (expected_base.len == 0) { return ""; }
        var owner_text = self.unit.expr_name(owner_expr_id);
        if (owner_text.len > 0) {
            let resolved_owner = self.resolve_type_text_in_current_env(owner_text);
            if (resolved_owner.len > 0) { owner_text = resolved_owner; }
        }
        if (owner_text.len == 0) {
            let owner_type_id = self.member_lookup_type_id(self.unit.expr_type(owner_expr_id));
            if (self.type_id_is_valid(owner_type_id)) {
                owner_text = self.member_lookup_type_name(owner_type_id);
            }
        }
        if (owner_text.len == 0) { return ""; }
        let owner_base = hir_builder_type_base_name(owner_text);
        if (!hir_builder_type_owner_names_match(owner_base, expected_base)) { return ""; }
        let owner_args = policy_generic_call_args(owner_text.clone());
        // A call whose static owner is already closed has nothing to infer
        // from the expected result type. Re-resolving such a call can select a
        // second generic-pack instance and disconnect the already-built HIR
        // argument chain (most visibly in direct return expressions).
        if (owner_args.len > 0 && !self.type_text_has_open_template_atom(owner_text)) {
            return "";
        }
        return expected_text;
    }

    fn rebind_expected_static_member_call(self, expr_id: i32, expected_type_id: i32) -> bool {
        let owner_type_name = self.expected_static_owner_type_for_call(expr_id, expected_type_id);
        if (owner_type_name.len == 0) { return false; }
        let owner_decl = self.raw_class_decl_for_type_text(owner_type_name);
        if (owner_decl == null) { return false; }
        self.ensure_concrete_type_text_ready(owner_type_name);
        let concrete_owner_type = self.type_id_from_text(owner_type_name);
        if (!self.type_id_is_valid(concrete_owner_type)) { return false; }
        let callee_expr_id = self.unit.expr_lhs(expr_id);
        let owner_expr_id = self.unit.expr_lhs(callee_expr_id);
        let method_name = policy_versioned_generic_call_base(self.unit.expr_name(callee_expr_id).clone());
        if (method_name.len == 0) { return false; }
        if (!self.raw_method_decl_exists_for_type_text(owner_type_name, method_name, true)) {
            return false;
        }
        let raw_class = owner_decl;
        if (raw_class == null) { return false; }
        let owner_item = hir_pointer_map_item(self.decl_map,raw_class);
        self.unit.set_expr_name(owner_expr_id, owner_type_name);
        self.unit.set_expr_type(owner_expr_id, concrete_owner_type);
        self.unit.set_expr_semantic(owner_expr_id,
                                   expr_sem_CLASS(),
                                   hir_target_item(),
                                   owner_item);
        self.unit.set_expr_semantic(callee_expr_id,
                                   expr_sem_NONE(),
                                   hir_target_none(),
                                   hir_id_invalid());
        self.unit.set_expr_semantic(expr_id,
                                   expr_sem_NONE(),
                                   hir_target_none(),
                                   hir_id_invalid());
        self.resolve_call_expr_after_children(null, expr_id, callee_expr_id);
        if (self.unit.expr_target_kind(expr_id) != hir_target_function()) { return false; }
        let target_id = self.unit.expr_target_id(expr_id);
        if (target_id == hir_id_invalid() || self.function_has_open_template_types(target_id)) {
            return false;
        }
        return true;
    }

    fn apply_expected_expr_type(self, expr_id: i32, expected_type_id: i32) {
        if (expr_id == hir_id_invalid() || !self.type_id_is_valid(expected_type_id)) { return; }
        let expected_timing = hir_builder_env_enabled("VYX_HIR_EXPECTED_TIMING");
        var expected_start: i64 = 0;
        var expected_mark: i64 = 0;
        var expected_dyn_ms: i64 = 0;
        var expected_variant_ms: i64 = 0;
        var expected_rebind_ms: i64 = 0;
        var expected_env_ms: i64 = 0;
        var expected_open_ms: i64 = 0;
        if (expected_timing) {
            expected_start = vyx_bootstrap_now_ms();
            expected_mark = expected_start;
        }
        self.materialize_dyn_expected_arg_impl(expr_id, expected_type_id);
        if (expected_timing) {
            let now_dyn = vyx_bootstrap_now_ms();
            expected_dyn_ms = now_dyn - expected_mark;
            expected_mark = now_dyn;
        }
        let expr_kind = self.unit.expr_kind(expr_id);
        if (expr_kind == ex_CALL()) {
            let expected_callee = self.unit.expr_lhs(expr_id);
            var retry_generic_call = false;
            if (expected_callee != hir_id_invalid()
                && (self.unit.expr_sem_kind(expected_callee) == expr_sem_BUILTIN()
                    || self.unit.expr_sem_kind(expected_callee) == expr_sem_DIRECT_FN())) {
                let expected_target = self.unit.expr_target_id(expected_callee);
                retry_generic_call = expected_target <= 0
                    || self.function_has_open_template_types(expected_target);
                let explicit_name = self.unit.expr_name(expected_callee);
                if (!retry_generic_call && policy_generic_call_args(explicit_name.clone()).len > 0
                    && expected_target > 0) {
                    let expected_ret = self.unit.function_return_type(expected_target);
                    retry_generic_call = hir_type_table_kind(self.unit.types, expected_ret) == ty_RAWPTR();
                }
            }
            if (retry_generic_call) {
                // A call in a return expression is built before its expected
                // result type is available. Retry imported generic recovery
                // here so an explicit `<i32>` closes the function instance
                // instead of leaving the provisional rawptr shell in place.
                self.resolve_call_expr_after_children(null, expr_id, expected_callee);
                let refreshed_target = self.unit.expr_target_id(expected_callee);
                if (self.unit.expr_target_kind(expected_callee) == hir_target_function()
                    && refreshed_target != hir_id_invalid()) {
                    let refreshed_ret = self.unit.function_return_type(refreshed_target);
                    if (self.type_id_is_valid(refreshed_ret)) {
                        self.unit.set_expr_type(expr_id, refreshed_ret);
                    }
                }
            }
        }
        if (expr_kind == ex_ARRAY_LIT()) {
            let expected_kind = hir_type_table_kind(self.unit.types, expected_type_id);
            if (expected_kind == ty_ARRAY()) {
                self.unit.set_expr_type(expr_id, expected_type_id);
                let elem_type = hir_type_table_elem(self.unit.types, expected_type_id);
                if (self.type_id_is_valid(elem_type)) {
                    var arg = self.unit.expr_first_arg(expr_id);
                    while (arg != hir_id_invalid()) {
                        self.apply_expected_expr_type(arg, elem_type);
                        arg = self.unit.expr_next_arg(arg);
                    }
                }
                return;
            }
            // Bare array literal flowing into a `*T` parameter (call
            // argument decay): retype the literal to `[N x T]` so its
            // elements materialize at the pointed-to element type and the
            // MIR array→pointer decay sees matching element types.
            // Without this, elements keep their standalone inference
            // (`10` → i32) and `Vec<i64>::from_array([10, 20], 2)` /
            // `Vec<i64>{10, 20}` fail with an element mismatch.
            if (expected_kind == ty_PTR()) {
                let elem_type = hir_type_table_elem(self.unit.types, expected_type_id);
                var count: i64 = 0;
                var arg = self.unit.expr_first_arg(expr_id);
                while (arg != hir_id_invalid()) {
                    count = count + 1;
                    arg = self.unit.expr_next_arg(arg);
                }
                if (self.type_id_is_valid(elem_type) && count > 0) {
                    let elem_text = hir_type_table_text(self.unit.types, elem_type);
                    let arr_text = "[" + elem_text + "; " + policy_i64_to_string(count) + "]";
                    let arr_type = self.type_id_from_text(arr_text);
                    if (self.type_id_is_valid(arr_type)) {
                        self.unit.set_expr_type(expr_id, arr_type);
                        arg = self.unit.expr_first_arg(expr_id);
                        while (arg != hir_id_invalid()) {
                            self.apply_expected_expr_type(arg, elem_type);
                            arg = self.unit.expr_next_arg(arg);
                        }
                    }
                }
            }
            return;
        }
        if (expr_kind == ex_INT_LIT() && self.type_id_is_integer_primitive(expected_type_id)) {
            self.unit.set_expr_type(expr_id, expected_type_id);
            return;
        }
        if (expr_kind == ex_INT_LIT()
            && hir_builder_lit_is_float(self.unit.expr_value_text(expr_id))
            && self.type_id_is_floatish(expected_type_id)) {
            self.unit.set_expr_type(expr_id, expected_type_id);
            return;
        }
        if (self.resolve_expected_variant_expr(expr_id, expected_type_id)) { return; }
        if (expected_timing) {
            let now_variant = vyx_bootstrap_now_ms();
            expected_variant_ms = now_variant - expected_mark;
            expected_mark = now_variant;
        }
        let current_type = self.unit.expr_type(expr_id);
        if (expr_kind == ex_CALL()) {
            if (self.rebind_expected_static_member_call(expr_id, expected_type_id)) {
                self.unit.set_expr_type(expr_id, expected_type_id);
                return;
            }
        }
        if (expected_timing) {
            let now_rebind = vyx_bootstrap_now_ms();
            expected_rebind_ms = now_rebind - expected_mark;
            expected_mark = now_rebind;
        }
        if (expr_kind == ex_STRUCT_INIT()) {
            if (!self.type_id_is_valid(current_type)) {
                self.unit.set_expr_type(expr_id, expected_type_id);
                return;
            }
            if (current_type == expected_type_id
                || self.apply_expected_expr_type_from_current_env(expr_id, current_type, expected_type_id)) {
                return;
            }
            if (self.type_id_has_template_atom(current_type)
                && !self.type_id_has_template_atom(expected_type_id)) {
                self.unit.set_expr_type(expr_id, expected_type_id);
            }
            return;
        }
        if (self.apply_expected_expr_type_from_current_env(expr_id, current_type, expected_type_id)) {
            return;
        }
        if (expected_timing) {
            let now_env = vyx_bootstrap_now_ms();
            expected_env_ms = now_env - expected_mark;
            expected_mark = now_env;
        }
        if (self.type_id_is_valid(current_type)
            && self.type_id_has_template_atom(current_type)
            && !self.type_id_has_template_atom(expected_type_id)) {
            self.unit.set_expr_type(expr_id, expected_type_id);
            return;
        }
        if (expected_timing) {
            let now_open = vyx_bootstrap_now_ms();
            expected_open_ms = now_open - expected_mark;
        }
        if (!self.type_id_is_valid(self.unit.expr_type(expr_id))) {
            self.unit.set_expr_type(expr_id, expected_type_id);
        }
        if (expected_timing) {
            let total = vyx_bootstrap_now_ms() - expected_start;
            if (total >= hir_builder_slow_expr_threshold_ms()) {
                var current_type_text = "<invalid>";
                if (self.type_id_is_valid(current_type)) {
                    current_type_text = hir_type_table_text(self.unit.types, current_type);
                }
                print("[hir-expected-phase] fn=" + self.unit.function_name(self.current_function_id)
                      + " total=" + policy_i64_to_string(total)
                      + " dyn=" + policy_i64_to_string(expected_dyn_ms)
                      + " variant=" + policy_i64_to_string(expected_variant_ms)
                      + " rebind=" + policy_i64_to_string(expected_rebind_ms)
                      + " env=" + policy_i64_to_string(expected_env_ms)
                      + " open=" + policy_i64_to_string(expected_open_ms)
                      + " expr_kind=" + self.i32_text(expr_kind)
                      + " expr_type=" + current_type_text
                      + " expected=" + hir_type_table_text(self.unit.types, expected_type_id)
                      + " expr_id=" + self.i32_text(expr_id));
            }
        }
    }

    fn build_struct_arg_cells(self, owner_expr_id: i32, owner_type_id: i32, head: rawptr) {
        if (self.type_id_is_valid(owner_type_id)) {
            self.ensure_concrete_type_text_ready(hir_type_table_text(self.unit.types, owner_type_id));
        }
        var first_arg = hir_id_invalid();
        var last_arg = hir_id_invalid();
        var cur = head;
        while (cur != null) {
            self.profile_struct_field_phase("field-enter", owner_type_id, stmt_get_name(cur), hir_id_invalid());
            let arg_expr = self.build_expr(stmt_get_init(cur));
            if (arg_expr != hir_id_invalid()) {
                self.prepare_arg_expr_for_list(arg_expr);
                let field_id = self.field_id_for_type_and_name(owner_type_id, stmt_get_name(cur));
                if (field_id != hir_id_invalid()) {
                    self.unit.set_expr_aggregate_field(arg_expr, field_id);
                    self.apply_expected_expr_type(arg_expr, self.unit.item_type(field_id));
                }
                self.profile_struct_field_phase("field-leave", owner_type_id, stmt_get_name(cur), arg_expr);
                if (first_arg == hir_id_invalid()) {
                    first_arg = arg_expr;
                    self.unit.set_expr_first_arg(owner_expr_id, arg_expr);
                }
                if (last_arg != hir_id_invalid()) {
                    self.unit.set_expr_next_arg(last_arg, arg_expr);
                }
                last_arg = arg_expr;
            }
            cur = stmt_get_next(cur);
        }
    }

    fn build_typed_int_const_expr(self, source: rawptr, type_id: i32, value: i64) -> i32 {
        let text = policy_i64_to_string(value);
        let expr_id = self.unit.add_expr(self.current_function_id,
                                        ex_INT_LIT(),
                                        "",
                                        text,
                                        value,
                                        type_id,
                                        expr_sem_NONE(),
                                        hir_target_none(),
                                        hir_id_invalid(),
                                        0,
                                        0);
        self.set_hir_expr_loc_from_ast(expr_id, source);
        self.unit.set_expr_owner_item(expr_id, self.current_item_id);
        return expr_id;
    }

    fn build_i64_const_expr(self, source: rawptr, value: i64) -> i32 {
        let type_id = self.type_id_from_text("i64");
        return self.build_typed_int_const_expr(source, type_id, value);
    }

    fn build_bool_const_expr(self, source: rawptr, value: bool) -> i32 {
        var int_value: i64 = 0;
        if (value) { int_value = 1; }
        let type_id = self.type_id_from_text("bool");
        let expr_id = self.unit.add_expr(self.current_function_id,
                                        ex_BOOL_LIT(),
                                        "",
                                        "",
                                        int_value,
                                        type_id,
                                        expr_sem_NONE(),
                                        hir_target_none(),
                                        hir_id_invalid(),
                                        0,
                                        0);
        self.set_hir_expr_loc_from_ast(expr_id, source);
        self.unit.set_expr_owner_item(expr_id, self.current_item_id);
        return expr_id;
    }

    fn build_current_const_generic_ident_expr(self, e: rawptr) -> i32 {
        if (e == null || expr_get_kind(e) != ex_IDENT()) { return hir_id_invalid(); }
        let bound = self.current_generic_binding(expr_get_name(e));
        if (bound.len == 0 || !hir_builder_string_is_i64_lit(bound)) { return hir_id_invalid(); }
        var type_id = self.type_id_from_expr(e);
        if (type_id == hir_id_invalid()) {
            type_id = self.type_id_from_text("i64");
        }
        return self.build_typed_int_const_expr(e, type_id, hir_builder_parse_i64_lit(bound));
    }

    fn build_pack_ref_expr(self, e: rawptr) -> i32 {
        if (e == null || expr_get_kind(e) != ex_IDENT()) { return hir_id_invalid(); }
        let pack_name = expr_get_name(e);
        let binding = hir_pack_bindings_find(self.pack_bindings, pack_name);
        if (binding == null) { return hir_id_invalid(); }
        let first_local = hir_pack_bindings_local_at(self.pack_bindings, pack_name, 0);
        if (first_local == hir_id_invalid()) { return hir_id_invalid(); }
        let type_id = self.unit.local_type(first_local);
        if (!self.type_id_is_valid(type_id)) { return hir_id_invalid(); }
        let builtin_id = self.unit.add_or_get_builtin("pack",
                                                     expr_sem_BUILTIN(),
                                                     type_id,
                                                     0);
        if (builtin_id == hir_id_invalid()) { return hir_id_invalid(); }
        let expr_id = self.unit.add_expr(self.current_function_id,
                                        ex_IDENT(),
                                        pack_name,
                                        "",
                                        0,
                                        type_id,
                                        expr_sem_BUILTIN(),
                                        hir_target_builtin(),
                                        builtin_id,
                                        0,
                                        0);
        self.set_hir_expr_loc_from_ast(expr_id, e);
        self.unit.set_expr_owner_item(expr_id, self.current_item_id);
        return expr_id;
    }

    fn build_pack_local_read_expr(self, source: rawptr, local_id: i32) -> i32 {
        if (local_id == hir_id_invalid()) { return hir_id_invalid(); }
        let expr_id = self.unit.add_expr(self.current_function_id,
                                        ex_IDENT(),
                                        self.unit.local_name(local_id),
                                        "",
                                        0,
                                        self.unit.local_type(local_id),
                                        expr_sem_LOCAL(),
                                        hir_target_local(),
                                        local_id,
                                        0,
                                        0);
        self.set_hir_expr_loc_from_ast(expr_id, source);
        self.unit.set_expr_owner_item(expr_id, self.current_item_id);
        return expr_id;
    }

    fn build_pack_member_expr(self, e: rawptr) -> i32 {
        if (e == null || expr_get_kind(e) != ex_MEMBER()) { return hir_id_invalid(); }
        if (expr_get_name(e) != "len" && expr_get_name(e) != "length" && expr_get_name(e) != "size") { return hir_id_invalid(); }
        let base = expr_get_lhs(e);
        if (base == null || expr_get_kind(base) != ex_IDENT()) { return hir_id_invalid(); }
        let pack_name = expr_get_name(base);
        if (hir_pack_bindings_find(self.pack_bindings, pack_name) == null) { return hir_id_invalid(); }
        return self.build_i64_const_expr(e, hir_pack_bindings_count(self.pack_bindings, pack_name) as i64);
    }

    fn eval_pack_const_index_expr(self, e: rawptr, pack_name: string) -> i64 {
        if (e == null || pack_name.len == 0) { return -1; }
        let k = expr_get_kind(e);
        if (k == ex_INT_LIT()) { return expr_get_int_val(e); }
        if (k == ex_IDENT()) {
            let bound = self.current_generic_binding(expr_get_name(e));
            if (bound.len > 0 && hir_builder_string_is_i64_lit(bound)) {
                return hir_builder_parse_i64_lit(bound);
            }
            return -1;
        }
        if (k == ex_MEMBER()) {
            let member = expr_get_name(e);
            if (member != "len" && member != "length" && member != "size") { return -1; }
            let base = expr_get_lhs(e);
            if (base == null || expr_get_kind(base) != ex_IDENT() || expr_get_name(base) != pack_name) { return -1; }
            if (hir_pack_bindings_find(self.pack_bindings, pack_name) == null) { return -1; }
            return hir_pack_bindings_count(self.pack_bindings, pack_name) as i64;
        }
        if (k == ex_UNARY()) {
            let inner = self.eval_pack_const_index_expr(expr_get_lhs(e), pack_name);
            if (inner < 0) { return -1; }
            let op = expr_get_op(e);
            if (op == tk_PLUS()) { return inner; }
            if (op == tk_MINUS()) { return 0 - inner; }
            return -1;
        }
        if (k == ex_BIN()) {
            let lhs = self.eval_pack_const_index_expr(expr_get_lhs(e), pack_name);
            let rhs = self.eval_pack_const_index_expr(expr_get_rhs(e), pack_name);
            if (lhs < 0 || rhs < 0) { return -1; }
            let op = expr_get_op(e);
            if (op == tk_PLUS()) { return lhs + rhs; }
            if (op == tk_MINUS()) { return lhs - rhs; }
            if (op == tk_STAR()) { return lhs * rhs; }
            if (op == tk_SLASH()) {
                if (rhs == 0) { return -1; }
                return lhs / rhs;
            }
            if (op == tk_PERCENT()) {
                if (rhs == 0) { return -1; }
                return lhs % rhs;
            }
            return -1;
        }
        return -1;
    }

    fn set_pack_index_expr_type_if_known(self, source: rawptr, expr_id: i32) -> bool {
        if (source == null || expr_id == hir_id_invalid() || expr_get_kind(source) != ex_INDEX()) { return false; }
        let base = expr_get_lhs(source);
        if (base == null || expr_get_kind(base) != ex_IDENT()) { return false; }
        let pack_name = expr_get_name(base);
        if (hir_pack_bindings_find(self.pack_bindings, pack_name) == null) { return false; }
        let local_id = hir_pack_bindings_local_at(self.pack_bindings, pack_name, 0);
        if (local_id == hir_id_invalid()) { return false; }
        self.unit.set_expr_type(expr_id, self.unit.local_type(local_id));
        return true;
    }

    fn build_pack_index_expr(self, e: rawptr) -> i32 {
        if (e == null || expr_get_kind(e) != ex_INDEX()) { return hir_id_invalid(); }
        let base = expr_get_lhs(e);
        let index = expr_get_rhs(e);
        if (base == null || index == null) { return hir_id_invalid(); }
        if (expr_get_kind(base) != ex_IDENT()) { return hir_id_invalid(); }
        let pack_name = expr_get_name(base);
        if (hir_pack_bindings_find(self.pack_bindings, pack_name) == null) { return hir_id_invalid(); }
        let index_value = self.eval_pack_const_index_expr(index, pack_name);
        if (index_value < 0 || index_value > 2147483647) { return hir_id_invalid(); }
        let local_id = hir_pack_bindings_local_at(self.pack_bindings, pack_name, index_value as i32);
        return self.build_pack_local_read_expr(e, local_id);
    }

    fn pack_fold_base_name(self, name: string) -> string {
        if (name.len <= 3) { return ""; }
        var i: i32 = 0;
        while (i + 2 < name.len) {
            if (name.charAt(i) == 46 && name.charAt(i + 1) == 46 && name.charAt(i + 2) == 46) {
                if (i <= 0) { return ""; }
                return name.substring(0, i);
            }
            i = i + 1;
        }
        return "";
    }

    fn pack_fold_op(self, name: string) -> i32 {
        if (name.endsWith("...+")) { return tk_PLUS(); }
        if (name.endsWith("...-")) { return tk_MINUS(); }
        if (name.endsWith("...*")) { return tk_STAR(); }
        if (name.endsWith("...&&")) { return tk_AND(); }
        if (name.endsWith("...|")) { return tk_PIPE(); }
        return 0;
    }

    fn build_pack_fold_identity_expr(self, source: rawptr, op: i32) -> i32 {
        if (op == tk_PLUS() || op == tk_MINUS()) { return self.build_i64_const_expr(source, 0); }
        if (op == tk_STAR()) { return self.build_i64_const_expr(source, 1); }
        if (op == tk_AND()) { return self.build_bool_const_expr(source, true); }
        if (op == tk_PIPE()) { return self.build_bool_const_expr(source, false); }
        return hir_id_invalid();
    }

    fn build_pack_binary_expr(self, source: rawptr, op: i32, lhs_id: i32, rhs_id: i32) -> i32 {
        if (lhs_id == hir_id_invalid() || rhs_id == hir_id_invalid()) { return hir_id_invalid(); }
        var type_id = self.unit.expr_type(lhs_id);
        if (op == tk_AND() || op == tk_PIPE()) {
            type_id = self.builtin_bool_type_id();
        }
        let expr_id = self.unit.add_expr(self.current_function_id,
                                        ex_BIN(),
                                        "",
                                        "",
                                        0,
                                        type_id,
                                        expr_sem_NONE(),
                                        hir_target_none(),
                                        hir_id_invalid(),
                                        0,
                                        op);
        self.set_hir_expr_loc_from_ast(expr_id, source);
        self.unit.set_expr_owner_item(expr_id, self.current_item_id);
        self.unit.set_expr_lhs(expr_id, lhs_id);
        self.unit.set_expr_rhs(expr_id, rhs_id);
        self.resolve_binary_expr_type_after_children(expr_id);
        return expr_id;
    }

    fn add_expr_shell_from_ast(self, e: rawptr, ast_kind: i32) -> i32 {
        var sem_kind = self.semantic_kind_for_expr(e, expr_get_semantic_kind(e));
        let type_id = self.type_id_from_expr_semantic(e, sem_kind);
        var target_kind = self.target_kind_for_expr(e, sem_kind);
        var target_id = hir_id_invalid();
        if (ast_kind == ex_CALL() || ast_kind == ex_MEMBER()) {
            sem_kind = expr_sem_NONE();
            target_kind = hir_target_none();
        } else {
            target_id = self.target_id_for_expr(e, sem_kind, target_kind);
        }
        var value_text = expr_get_str_val(e);
        var name = expr_get_name(e);
        if (target_kind == hir_target_builtin()) {
            name = self.canonical_builtin_name_for_expr(e);
        }
        let expr_id = self.unit.add_expr(self.current_function_id,
                                        ast_kind,
                                        name,
                                        value_text,
                                        expr_get_int_val(e),
                                        type_id,
                                        sem_kind,
                                        target_kind,
                                        target_id,
                                        expr_get_semantic_flags(e),
                                        expr_get_op(e));
        self.set_hir_expr_loc_from_ast(expr_id, e);
        self.unit.set_expr_owner_item(expr_id, self.current_item_id);
        self.profile_expr_trace("expr", e, expr_id);
        self.resolve_literal_expr_type_after_create(expr_id, ast_kind);
        return expr_id;
    }

    fn build_binary_expr_iterative(self, e: rawptr) -> i32 {
        if (e == null || expr_get_kind(e) != ex_BIN()) { return hir_id_invalid(); }
        var chain_head: rawptr = null;
        var cur = e;
        var depth: i32 = 0;
        while (cur != null && expr_get_kind(cur) == ex_BIN()) {
            depth = depth + 1;
            if (depth > 4096) {
                return hir_id_invalid();
            }
            let node = hir_profile_malloc(16);
            if (node == null) { return hir_id_invalid(); }
            memset(node, 0, 16);
            ast_write_rawptr(node, cur);
            ast_write_rawptr(ptr_offset(node, 8), chain_head);
            chain_head = node;
            cur = expr_get_lhs(cur);
        }
        var acc = self.build_expr(cur);
        var node = chain_head;
        while (node != null) {
            let next = ast_read_rawptr(ptr_offset(node, 8));
            let bin_expr = ast_read_rawptr(node);
            free(node);
            if (acc == hir_id_invalid() || bin_expr == null) {
                node = next;
                continue;
            }
            let expr_id = self.add_expr_shell_from_ast(bin_expr, ex_BIN());
            self.unit.set_expr_lhs(expr_id, acc);
            self.unit.set_expr_rhs(expr_id, self.build_expr(expr_get_rhs(bin_expr)));
            self.unit.set_expr_aux(expr_id, self.build_expr(expr_get_args(bin_expr)));
            self.resolve_binary_expr_type_after_children(expr_id);
            acc = expr_id;
            node = next;
        }
        return acc;
    }

    fn build_pack_fold_expr(self, e: rawptr) -> i32 {
        if (e == null || expr_get_kind(e) != ex_IDENT()) { return hir_id_invalid(); }
        let name = expr_get_name(e);
        let op = self.pack_fold_op(name);
        if (op == 0) { return hir_id_invalid(); }
        let pack_name = self.pack_fold_base_name(name);
        if (pack_name.len == 0) { return hir_id_invalid(); }
        let pack_count = hir_pack_bindings_count(self.pack_bindings, pack_name);
        if (pack_count <= 0) { return self.build_pack_fold_identity_expr(e, op); }
        var index: i32 = 0;
        var acc = hir_id_invalid();
        while (index < pack_count) {
            let local_id = hir_pack_bindings_local_at(self.pack_bindings, pack_name, index);
            let local_expr = self.build_pack_local_read_expr(e, local_id);
            if (local_expr == hir_id_invalid()) { return hir_id_invalid(); }
            if (acc == hir_id_invalid()) {
                acc = local_expr;
            } else {
                acc = self.build_pack_binary_expr(e, op, acc, local_expr);
                if (acc == hir_id_invalid()) { return hir_id_invalid(); }
            }
            index = index + 1;
        }
        return acc;
    }

    fn build_expr(self, e: rawptr) -> i32 {
        e = hir_native_init_prepare(e, self.source_unit, self.unit.types);
        if (e == null) { return hir_id_invalid(); }
        let ast_kind = expr_get_kind(e);
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-expr-enter] kind=" + self.i32_text(ast_kind)
                  + " name=" + expr_get_name(e)
                  + " fn=" + self.i32_text(self.current_function_id)
                  + " stmts=" + self.i32_text(self.unit.stmt_count)
                  + " exprs=" + self.i32_text(self.unit.expr_count)
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        if (ast_kind == ex_IDENT()) {
            let pack_fold = self.build_pack_fold_expr(e);
            if (pack_fold != hir_id_invalid()) { return pack_fold; }
            let const_generic_expr = self.build_current_const_generic_ident_expr(e);
            if (const_generic_expr != hir_id_invalid()) { return const_generic_expr; }
            let pack_ref = self.build_pack_ref_expr(e);
            if (pack_ref != hir_id_invalid()) { return pack_ref; }
        }
        if (ast_kind == ex_MEMBER()) {
            let pack_member = self.build_pack_member_expr(e);
            if (pack_member != hir_id_invalid()) { return pack_member; }
        }
        if (ast_kind == ex_STRUCT_INIT()) {
            let new_call = self.build_empty_struct_init_new_call(e);
            if (new_call != hir_id_invalid()) { return new_call; }
            let list_call = self.build_container_list_init_from_array_call(e);
            if (list_call != hir_id_invalid()) { return list_call; }
        }
        if (ast_kind == ex_INDEX()) {
            let pack_index = self.build_pack_index_expr(e);
            if (pack_index != hir_id_invalid()) { return pack_index; }
        }
        if (ast_kind == ex_BIN()) {
            return self.build_binary_expr_iterative(e);
        }
        var sem_kind = self.semantic_kind_for_expr(e, expr_get_semantic_kind(e));
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-expr-sem] kind=" + self.i32_text(ast_kind)
                  + " name=" + expr_get_name(e)
                  + " sem=" + self.i32_text(sem_kind)
                  + " exprs=" + self.i32_text(self.unit.expr_count)
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        let type_id = self.type_id_from_expr_semantic(e, sem_kind);
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-expr-type] kind=" + self.i32_text(ast_kind)
                  + " name=" + expr_get_name(e)
                  + " type=" + self.i32_text(type_id)
                  + " exprs=" + self.i32_text(self.unit.expr_count)
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        var target_kind = self.target_kind_for_expr(e, sem_kind);
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-expr-target-kind] kind=" + self.i32_text(ast_kind)
                  + " name=" + expr_get_name(e)
                  + " target_kind=" + self.i32_text(target_kind)
                  + " exprs=" + self.i32_text(self.unit.expr_count)
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        var target_id = hir_id_invalid();
        if (ast_kind == ex_CALL() || ast_kind == ex_MEMBER()) {
            sem_kind = expr_sem_NONE();
            target_kind = hir_target_none();
        } else {
            target_id = self.target_id_for_expr(e, sem_kind, target_kind);
        }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-expr-target-id] kind=" + self.i32_text(ast_kind)
                  + " name=" + expr_get_name(e)
                  + " target_kind=" + self.i32_text(target_kind)
                  + " target_id=" + self.i32_text(target_id)
                  + " exprs=" + self.i32_text(self.unit.expr_count)
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        var value_text = expr_get_str_val(e);
        var name = expr_get_name(e);
        if (target_kind == hir_target_builtin()) {
            name = self.canonical_builtin_name_for_expr(e);
        }
        let expr_id = self.unit.add_expr(self.current_function_id,
                                        ast_kind,
                                        name,
                                        value_text,
                                        expr_get_int_val(e),
                                        type_id,
                                        sem_kind,
                                        target_kind,
                                        target_id,
                                        expr_get_semantic_flags(e),
                                        expr_get_op(e));
        self.set_hir_expr_loc_from_ast(expr_id, e);
        self.unit.set_expr_owner_item(expr_id, self.current_item_id);
        self.profile_expr_trace("expr", e, expr_id);
        self.resolve_literal_expr_type_after_create(expr_id, ast_kind);
        if (ast_kind == ex_IDENT()) {
            self.resolve_ident_expr_after_create(e, expr_id);
            return expr_id;
        }
        if (ast_kind == ex_BIN()
            || ast_kind == ex_TERNARY()) {
            self.unit.set_expr_lhs(expr_id, self.build_expr(expr_get_lhs(e)));
            self.unit.set_expr_rhs(expr_id, self.build_expr(expr_get_rhs(e)));
            self.unit.set_expr_aux(expr_id, self.build_expr(expr_get_args(e)));
            if (ast_kind == ex_BIN()) {
                self.resolve_binary_expr_type_after_children(expr_id);
            } else {
                let rhs_type = self.unit.expr_type(self.unit.expr_rhs(expr_id));
                let aux_type = self.unit.expr_type(self.unit.expr_aux(expr_id));
                if (self.type_id_is_valid(rhs_type)) { self.set_expr_type_if_empty(expr_id, rhs_type); }
                else if (self.type_id_is_valid(aux_type)) { self.set_expr_type_if_empty(expr_id, aux_type); }
            }
            return expr_id;
        }
        if (ast_kind == ex_ASSIGN()) {
            self.unit.set_expr_lhs(expr_id, self.build_expr(expr_get_lhs(e)));
            self.unit.set_expr_rhs(expr_id, self.build_expr(expr_get_rhs(e)));
            self.unit.set_expr_aux(expr_id, self.build_expr(expr_get_args(e)));
            self.apply_expected_expr_type(self.unit.expr_rhs(expr_id),
                                          self.unit.expr_type(self.unit.expr_lhs(expr_id)));
            self.resolve_assign_expr_type_after_children(expr_id);
            self.resolve_assignment_method_after_children(e, expr_id);
            return expr_id;
        }
        if (ast_kind == ex_UNARY()
            || ast_kind == ex_CAST()
            || ast_kind == ex_FAIL()) {
            self.unit.set_expr_lhs(expr_id, self.build_expr(expr_get_lhs(e)));
            if (ast_kind == ex_UNARY()) {
                self.resolve_unary_expr_type_after_child(expr_id);
            } else if (ast_kind == ex_FAIL()) {
                self.set_expr_type_if_empty(expr_id, self.unit.function_return_type(self.current_function_id));
            } else {
                self.resolve_single_child_expr_type_after_child(expr_id);
                self.materialize_dyn_expected_arg_impl(self.unit.expr_lhs(expr_id),
                                                       self.unit.expr_type(expr_id));
            }
            return expr_id;
        }
        if (ast_kind == ex_ADDR_OF()) {
            self.unit.set_expr_lhs(expr_id, self.build_expr(expr_get_lhs(e)));
            self.resolve_addr_of_expr_type(expr_id);
            return expr_id;
        }
        if (ast_kind == ex_DEREF()) {
            self.unit.set_expr_lhs(expr_id, self.build_expr(expr_get_lhs(e)));
            self.resolve_deref_expr_type_after_child(expr_id);
            return expr_id;
        }
        if (ast_kind == ex_NEW()) {
            let payload_type_id = self.type_id_from_ref(expr_get_captures(e));
            if (payload_type_id != hir_id_invalid()
                && self.unit.expr_target_kind(expr_id) == hir_target_none()) {
                self.unit.set_expr_semantic(expr_id,
                                           expr_sem_CLASS(),
                                           hir_target_type(),
                                           payload_type_id);
            }
            self.unit.set_expr_lhs(expr_id, self.build_expr(expr_get_lhs(e)));
            self.unit.set_expr_rhs(expr_id, self.build_expr(expr_get_rhs(e)));
            self.build_arg_cells(expr_id, expr_get_args(e));
            // Runtime-length array allocation (`new [T; expr]()`): carry the
            // size expression as an explicit value so codegen can compute
            // count * elem_size at run time. Only a plain integer literal
            // keeps the compile-time allocation path; anything else (idents,
            // binary expressions) is lowered as a value because the interned
            // type text cannot carry a foldable expression.
            let new_payload_tref = expr_get_captures(e);
            if (new_payload_tref != null && tref_get_kind(new_payload_tref) == ty_ARRAY()) {
                let new_size_e = tref_array_size_expr(new_payload_tref);
                if (new_size_e != null && expr_get_kind(new_size_e) != ex_INT_LIT()) {
                    self.unit.set_expr_aux(expr_id, self.build_expr(new_size_e));
                }
            }
            return expr_id;
        }
        if (ast_kind == ex_DELETE()) {
            let explicit_payload_type_id = self.type_id_from_ref(expr_get_captures(e));
            if (explicit_payload_type_id != hir_id_invalid()) {
                self.unit.set_expr_semantic(expr_id,
                                           expr_sem_CLASS(),
                                           hir_target_type(),
                                           explicit_payload_type_id);
            }
            self.unit.set_expr_lhs(expr_id, self.build_expr(expr_get_lhs(e)));
            self.unit.set_expr_rhs(expr_id, self.build_expr(expr_get_rhs(e)));
            return expr_id;
        }
        if (ast_kind == ex_COMPTIME()) {
            self.unit.set_expr_lhs(expr_id, self.build_expr(expr_get_lhs(e)));
            self.resolve_single_child_expr_type_after_child(expr_id);
            return expr_id;
        }
        if (ast_kind == ex_AWAIT()) {
            let awaited_expr = self.build_expr(expr_get_lhs(e));
            self.unit.set_expr_lhs(expr_id, awaited_expr);
            let await_fn = self.ensure_await_value_instance_for_type_id(self.unit.expr_type(awaited_expr));
            if (await_fn != hir_id_invalid()) {
                self.unit.set_expr_semantic(expr_id, expr_sem_METHOD(), hir_target_function(), await_fn);
            }
            return expr_id;
        }
        if (ast_kind == ex_CALL()) {
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
                print("[hir-progress] build-call-enter id=" + self.i32_text(expr_id)
                      + " name=" + expr_get_name(e));
            }
            self.profile_expr_trace("call-enter", e, expr_id);
            let saved_call_callee_ast = self.current_call_callee_ast;
            self.current_call_callee_ast = expr_get_lhs(e);
            let callee_expr = self.build_expr(expr_get_lhs(e));
            self.current_call_callee_ast = saved_call_callee_ast;
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
                print("[hir-progress] build-call-after-callee id=" + self.i32_text(expr_id)
                      + " callee=" + self.i32_text(callee_expr));
            }
            self.unit.set_expr_lhs(expr_id, callee_expr);
            self.build_arg_cells(expr_id, expr_get_args(e));
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
                print("[hir-progress] build-call-before-resolve id=" + self.i32_text(expr_id));
            }
            let expr_timing_enabled = hir_builder_env_enabled("VYX_HIR_EXPR_TIMING");
            var expr_timing_start: i64 = 0;
            if (expr_timing_enabled) { expr_timing_start = vyx_bootstrap_now_ms(); }
            if (hir_builder_env_enabled("VYX_HIR_HOT_TIMING")) {
                let hot_call_start = vyx_bootstrap_now_ms();
                self.resolve_call_expr_after_children(e, expr_id, callee_expr);
                self.profile_ms_resolve_call = self.profile_ms_resolve_call + (vyx_bootstrap_now_ms() - hot_call_start);
            } else {
                self.resolve_call_expr_after_children(e, expr_id, callee_expr);
            }
            if (expr_timing_enabled) {
                let expr_elapsed = vyx_bootstrap_now_ms() - expr_timing_start;
                if (expr_elapsed >= hir_builder_slow_expr_threshold_ms()) {
                    var callee_name = "";
                    var owner_type = "";
                    if (callee_expr != hir_id_invalid()) {
                        callee_name = self.unit.expr_name(callee_expr);
                        if (self.unit.expr_kind(callee_expr) == ex_MEMBER()) {
                            let owner_expr_id = self.unit.expr_lhs(callee_expr);
                            if (owner_expr_id != hir_id_invalid()) {
                                let owner_type_id = self.member_lookup_type_id(self.unit.expr_type(owner_expr_id));
                                if (self.type_id_is_valid(owner_type_id)) {
                                    owner_type = self.member_lookup_type_name(owner_type_id);
                                }
                            }
                        }
                    }
                    print("[hir-expr-timing] kind=call fn=" + self.unit.function_name(self.current_function_id)
                          + " elapsed=" + policy_i64_to_string(expr_elapsed)
                          + " name=" + callee_name
                          + " owner=" + owner_type
                          + " line=" + self.i32_text(expr_loc_line(e))
                          + " col=" + self.i32_text(expr_loc_col(e))
                          + " expr_id=" + self.i32_text(expr_id)
                          + " callee_id=" + self.i32_text(callee_expr)
                          + " target=" + self.i32_text(self.unit.expr_target_id(callee_expr)));
                }
            }
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
                print("[hir-progress] build-call-leave id=" + self.i32_text(expr_id));
            }
            self.profile_expr_trace("call-leave", e, expr_id);
            return expr_id;
        }
        if (ast_kind == ex_MEMBER()) {
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
                print("[hir-progress] build-member-enter id=" + self.i32_text(expr_id)
                      + " name=" + expr_get_name(e));
            }
            self.profile_expr_trace("member-enter", e, expr_id);
            let member_lhs = self.build_expr(expr_get_lhs(e));
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
                print("[hir-progress] build-member-after-lhs id=" + self.i32_text(expr_id)
                      + " lhs=" + self.i32_text(member_lhs));
            }
            self.unit.set_expr_lhs(expr_id, member_lhs);
            let expr_timing_enabled = hir_builder_env_enabled("VYX_HIR_EXPR_TIMING");
            var expr_timing_start: i64 = 0;
            if (expr_timing_enabled) { expr_timing_start = vyx_bootstrap_now_ms(); }
            if (hir_builder_env_enabled("VYX_HIR_HOT_TIMING")) {
                let hot_member_start = vyx_bootstrap_now_ms();
                self.resolve_member_expr_after_children(e, expr_id, member_lhs);
                self.profile_ms_resolve_member = self.profile_ms_resolve_member + (vyx_bootstrap_now_ms() - hot_member_start);
            } else {
                self.resolve_member_expr_after_children(e, expr_id, member_lhs);
            }
            if (expr_timing_enabled) {
                let expr_elapsed = vyx_bootstrap_now_ms() - expr_timing_start;
                if (expr_elapsed >= hir_builder_slow_expr_threshold_ms()) {
                    var owner_type = "";
                    let owner_type_id = self.member_lookup_type_id(self.unit.expr_type(member_lhs));
                    if (self.type_id_is_valid(owner_type_id)) {
                        owner_type = self.member_lookup_type_name(owner_type_id);
                    }
                    print("[hir-expr-timing] kind=member fn=" + self.unit.function_name(self.current_function_id)
                          + " elapsed=" + policy_i64_to_string(expr_elapsed)
                          + " name=" + policy_versioned_generic_call_base(expr_get_name(e).clone())
                          + " owner=" + owner_type
                          + " line=" + self.i32_text(expr_loc_line(e))
                          + " col=" + self.i32_text(expr_loc_col(e))
                          + " expr_id=" + self.i32_text(expr_id)
                          + " target=" + self.i32_text(self.unit.expr_target_id(expr_id)));
                }
            }
            if (hir_builder_env_enabled("VYX_HIR_PROGRESS")) {
                print("[hir-progress] build-member-leave id=" + self.i32_text(expr_id));
            }
            self.profile_expr_trace("member-leave", e, expr_id);
            return expr_id;
        }
        if (ast_kind == ex_INDEX()) {
            self.unit.set_expr_lhs(expr_id, self.build_expr(expr_get_lhs(e)));
            self.unit.set_expr_rhs(expr_id, self.build_expr(expr_get_rhs(e)));
            self.set_pack_index_expr_type_if_known(e, expr_id);
            self.resolve_index_expr_type_after_children(e, expr_id);
            return expr_id;
        }
        if (ast_kind == ex_STRUCT_INIT()) {
            self.profile_expr_trace("struct-enter", e, expr_id);
            let struct_type = self.resolve_struct_init_type_id(e, expr_id);
            self.build_struct_arg_cells(expr_id, struct_type, expr_get_args(e));
            self.profile_expr_trace("struct-leave", e, expr_id);
            return expr_id;
        }
        if (ast_kind == ex_FSTRING()
            || ast_kind == ex_TUPLE_LIT()
            || ast_kind == ex_INLINE_ASM()) {
            self.build_arg_cells(expr_id, expr_get_args(e));
            return expr_id;
        }
        if (ast_kind == ex_ARRAY_LIT()) {
            self.build_arg_cells(expr_id, expr_get_args(e));
            self.unit.set_expr_aux(expr_id, self.build_expr(expr_get_captures(e)));
            return expr_id;
        }
        if (ast_kind == ex_CLOSURE()) {
            self.build_closure_expr(e, expr_id, type_id);
            return expr_id;
        }
        if (ast_kind == ex_IF_EXPR()) {
            self.unit.set_expr_lhs(expr_id, self.build_expr(expr_get_lhs(e)));
            let saved_then = self.locals.head;
            self.unit.set_expr_stmt_rhs(expr_id, self.build_stmt(expr_get_rhs(e)));
            self.locals = hir_local_scope_drop_to(self.locals, saved_then);
            let else_part = expr_get_args(e);
            var else_expr_id = hir_id_invalid();
            if (else_part != null && expr_get_kind(else_part) == ex_IF_EXPR()) {
                self.unit.set_expr_aux(expr_id, self.build_expr(else_part));
                else_expr_id = self.unit.expr_aux(expr_id);
            } else {
                self.unit.set_expr_stmt_aux(expr_id, self.build_stmt(else_part));
            }
            // Type closure for the if-expression itself. Sema skips generic
            // method bodies whose owner has a template head
            // (host_analyze_all_method_bodies), so the AST ty stamp this
            // expression normally inherits may never have been written.
            // Derive it here from the branches we just built: prefer the
            // then-branch tail expression's type, then the else branch,
            // mirroring sema's resolve order. Without this, the MIR layer
            // allocates the result place with an empty type and codegen
            // fails with "cannot allocate local ... invalid type".
            if (!self.type_id_is_valid(self.unit.expr_type(expr_id))) {
                let then_type = self.hir_branch_tail_type(self.unit.expr_stmt_rhs(expr_id));
                if (self.type_id_is_valid(then_type)) {
                    self.unit.set_expr_type(expr_id, then_type);
                } else if (else_expr_id != hir_id_invalid()) {
                    let else_type = self.unit.expr_type(else_expr_id);
                    if (self.type_id_is_valid(else_type)) {
                        self.unit.set_expr_type(expr_id, else_type);
                    }
                } else {
                    let else_stmt_type = self.hir_branch_tail_type(
                        self.unit.expr_stmt_aux(expr_id));
                    if (self.type_id_is_valid(else_stmt_type)) {
                        self.unit.set_expr_type(expr_id, else_stmt_type);
                    }
                }
            }
            return expr_id;
        }
        if (ast_kind == ex_MATCH_EXPR()) {
            // Match expressions retain the statement matcher’s arm layout
            // in a value expression.  The MIR builder consumes the arm chain
            // from expr_stmt_rhs and writes the selected arm value into its
            // result place.
            let scrutinee_expr = self.build_expr(expr_get_lhs(e));
            self.unit.set_expr_lhs(expr_id, scrutinee_expr);
            let scrutinee_type = self.unit.expr_type(scrutinee_expr);
            var arm = expr_get_args(e);
            var first_arm = hir_id_invalid();
            var last_arm = hir_id_invalid();
            var result_type = self.unit.expr_type(expr_id);
            while (arm != null) {
                let saved_arm = self.locals.head;
                let arm_stmt = self.unit.add_stmt(self.current_function_id,
                                                  hir_stmt_expr(), "",
                                                  hir_id_invalid());
                self.set_hir_stmt_loc_from_ast(arm_stmt, arm);
                self.unit.set_stmt_owner_item(arm_stmt, self.current_item_id);
                let pat = stmt_get_init(arm);
                self.push_pattern_binds_for_type(pat, scrutinee_type);
                let pat_expr = self.build_expr(pat);
                self.resolve_expected_variant_expr(pat_expr, scrutinee_type);
                self.unit.set_stmt_expr(arm_stmt, pat_expr);
                self.unit.set_stmt_cond(arm_stmt, self.build_expr(stmt_get_cond(arm)));
                self.unit.set_stmt_child(arm_stmt, self.build_stmt(stmt_get_body(arm)));
                let arm_body = self.unit.stmt_child(arm_stmt);
                var arm_type = hir_id_invalid();
                if (arm_body != hir_id_invalid()) {
                    if (self.unit.stmt_kind(arm_body) == hir_stmt_expr()) {
                        arm_type = self.unit.expr_type(self.unit.stmt_expr(arm_body));
                    } else {
                        arm_type = self.hir_branch_tail_type(arm_body);
                    }
                }
                if (!self.type_id_is_valid(result_type) && self.type_id_is_valid(arm_type)) {
                    result_type = arm_type;
                }
                self.locals = hir_local_scope_drop_to(self.locals, saved_arm);
                if (first_arm == hir_id_invalid()) {
                    first_arm = arm_stmt;
                }
                if (last_arm != hir_id_invalid()) {
                    self.unit.set_stmt_next(last_arm, arm_stmt);
                }
                last_arm = arm_stmt;
                arm = stmt_get_next(arm);
            }
            self.unit.set_expr_stmt_rhs(expr_id, first_arm);
            if (!self.type_id_is_valid(self.unit.expr_type(expr_id))
                && self.type_id_is_valid(result_type)) {
                self.unit.set_expr_type(expr_id, result_type);
            }
            return expr_id;
        }
        return expr_id;
    }

    /// Type of the last value-producing statement in an already-built HIR
    /// block chain: the init expression of a trailing st_EXPR/st_LET/st_VAR
    /// or the payload of a st_RETURN. Returns invalid when the block falls
    /// through without a value.
    fn hir_branch_tail_type(self, stmt_id: i32) -> i32 {
        if (stmt_id == hir_id_invalid()) { return hir_id_invalid(); }
        var cur = stmt_id;
        var tail = hir_id_invalid();
        while (cur != hir_id_invalid()) {
            tail = cur;
            cur = self.unit.stmt_next(cur);
        }
        let k = self.unit.stmt_kind(tail);
        if (k == st_BLOCK()) {
            return self.hir_branch_tail_type(self.unit.stmt_child(tail));
        }
        if (k == st_EXPR() || k == st_LET() || k == st_VAR()) {
            let init_expr = self.unit.stmt_expr(tail);
            if (init_expr != hir_id_invalid()) { return self.unit.expr_type(init_expr); }
            return hir_id_invalid();
        }
        if (k == st_RETURN()) {
            let ret_expr = self.unit.stmt_expr(tail);
            if (ret_expr != hir_id_invalid()) { return self.unit.expr_type(ret_expr); }
        }
        return hir_id_invalid();
    }

    fn closure_return_type_id(self, e: rawptr) -> i32 {
        let explicit_ret = expr_get_rhs(e);
        if (explicit_ret != null) {
            return self.type_id_from_ref(explicit_ret);
        }
        let closure_ty = expr_get_ty(e);
        if (closure_ty != null && tref_get_kind(closure_ty) == ty_FN()) {
            return self.type_id_from_ref(tref_fn_ret(closure_ty));
        }
        return self.unit.types.intern_type_ref(null);
    }

    fn build_closure_expr(self, e: rawptr, expr_id: i32, type_id: i32) {
        let closure_item = self.unit.add_item(hir_item_closure(),
                                             "closure$" + policy_i64_to_string(expr_id as i64),
                                             type_id,
                                             self.current_item_id);
        let closure_fn = self.unit.add_function(closure_item,
                                               self.unit.item_name(closure_item),
                                               self.closure_return_type_id(e));
        self.unit.set_expr_target(expr_id, hir_target_function(), closure_fn);
        let saved_function = self.current_function_id;
        let saved_item = self.current_item_id;
        let saved_locals = self.locals.head;
        let saved_capture_source = self.capture_source_head;
        self.current_function_id = closure_fn;
        self.current_item_id = closure_item;
        self.capture_source_head = saved_locals;
        self.locals = hir_local_scope_restore(self.locals, null);
        var cap = expr_get_captures(e);
        while (cap != null) {
            let cap_name = stmt_get_name(cap);
            let cap_init_ast = stmt_get_init(cap);
            var cap_init_expr = hir_id_invalid();
            if (cap_init_ast != null) {
                let closure_locals = self.locals.head;
                let closure_function = self.current_function_id;
                let closure_item_active = self.current_item_id;
                let closure_capture_source = self.capture_source_head;
                self.current_function_id = saved_function;
                self.current_item_id = saved_item;
                self.capture_source_head = saved_capture_source;
                self.locals = hir_local_scope_restore(self.locals, saved_locals);
                cap_init_expr = self.build_expr(cap_init_ast);
                self.locals = hir_local_scope_restore(self.locals, closure_locals);
                self.capture_source_head = closure_capture_source;
                self.current_item_id = closure_item_active;
                self.current_function_id = closure_function;
            }
            var cap_ty = self.type_id_from_ref(stmt_get_ty(cap));
            if (cap_ty == hir_id_invalid()) {
                cap_ty = self.type_id_from_expr(cap_init_ast);
            }
            var cap_flags: i32 = hir_local_flag_capture();
            if (stmt_get_cond(cap) != null) {
                cap_flags = cap_flags | hir_local_flag_reference_capture();
            }
            let cap_local = self.unit.add_local(closure_fn, cap_name, cap_ty, cap_flags);
            if (cap_init_expr != hir_id_invalid()) {
                self.unit.set_local_capture_init_expr(cap_local, cap_init_expr);
            } else {
                var cap_source_node = hir_local_scope_find_node(saved_locals, stmt_get_semantic_target(cap));
                if (cap_source_node == null) {
                    cap_source_node = hir_local_scope_find_node_by_name(saved_locals, cap_name);
                }
                self.unit.set_local_capture_source(cap_local, hir_local_scope_node_local(cap_source_node));
            }
            self.locals = hir_local_scope_push(self.locals, cap_name, cap_local, cap_ty, closure_fn, stmt_get_semantic_target(cap));
            cap = stmt_get_next(cap);
        }
        var param = expr_get_args(e);
        while (param != null) {
            let pty = self.type_id_from_ref(decl_get_ty(param));
            let plocal = self.unit.add_local(closure_fn, decl_get_name(param), pty, hir_local_flag_param());
            self.locals = hir_local_scope_push(self.locals,
                                 decl_get_name(param),
                                 plocal,
                                 pty,
                                 closure_fn,
                                 decl_get_semantic_target(param));
            param = decl_get_next(param);
        }
        self.unit.set_expr_type(expr_id, self.function_type_id(closure_fn));
        self.preload_capture_stmt_chain(expr_get_lhs(e));
        let body_chain = self.build_stmt_chain(expr_get_lhs(e));
        self.unit.set_function_body(closure_fn, body_chain.first, body_chain.count);
        self.unit.set_expr_stmt_aux(expr_id, body_chain.first);
        self.locals = hir_local_scope_drop_to(self.locals, saved_locals);
        self.capture_source_head = saved_capture_source;
        self.current_item_id = saved_item;
        self.current_function_id = saved_function;
    }

    fn find_class_decl_in_chain(self, head: rawptr, name: string, base: string, short_name: string, depth: i32) -> rawptr {
        if (head == null || name.len == 0 || depth > 64) { return null; }
        var cur = head;
        while (cur != null) {
            let k = decl_get_kind(cur);
            if (k == de_CLASS() || k == de_ENUM()) {
                let dn = decl_get_name(cur);
                if (dn == name || dn == base || dn == short_name
                    || policy_type_name_equal(dn, name)
                    || policy_type_name_equal(dn, base)) {
                    return cur;
                }
            }
            let members = decl_get_members(cur);
            if (members != null) {
                let nested = self.find_class_decl_in_chain(members, name, base, short_name, depth + 1);
                if (nested != null) { return nested; }
            }
            cur = decl_get_next(cur);
        }
        return null;
    }

    fn raw_interface_method_decl_on_trait(self,
                                          trait_decl: rawptr,
                                          method_name: string,
                                          depth: i32) -> rawptr {
        if (trait_decl == null || method_name.len == 0 || depth > 16) { return null; }
        if (((decl_get_generic_flags(trait_decl) & 2) == 0)
            && !hir_builder_string_contains(decl_get_generic_params(trait_decl), "|kind:interface")) {
            return null;
        }
        var member = decl_get_members(trait_decl);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && hir_builder_method_name_matches_lookup(decl_get_name(member), method_name)
                && !decl_get_is_static(member)) {
                return member;
            }
            member = decl_get_next(member);
        }
        let gp = decl_get_generic_params(trait_decl);
        var idx: i32 = 0;
        while (idx < 64) {
            let super_name = hir_builder_impl_trait_at(gp, idx);
            if (super_name.len == 0) { break; }
            let super_decl = self.raw_interface_decl_for_trait_name(super_name);
            if (super_decl != null && super_decl != trait_decl) {
                let inherited = self.raw_interface_method_decl_on_trait(super_decl,
                                                                        method_name,
                                                                        depth + 1);
                if (inherited != null) { return inherited; }
            }
            idx = idx + 1;
        }
        return null;
    }

    fn find_class_decl(self, name: string) -> rawptr {
        if (self.source_unit == null || name.len == 0) { return null; }
        let base = policy_generic_call_base(name);
        let short_name = hir_builder_last_path_segment(base);
        return self.find_class_decl_in_chain(unit_get_decls(self.source_unit), name, base, short_name, 0);
    }

    fn find_type_alias_decl(self, name: string) -> rawptr {
        if (self.source_unit == null || name.len == 0) { return null; }
        let cached = hir_raw_name_map_get(self.type_alias_decl_cache,name);
        if (cached != null) { return cached; }
        if (hir_name_id_map_get(self.type_alias_decl_miss_cache,name) != hir_id_invalid()) { return null; }
        let base = policy_generic_call_base(name);
        let short_name = hir_builder_last_path_segment(base);
        var cur = unit_get_decls(self.source_unit);
        while (cur != null) {
            if (decl_get_kind(cur) == de_TYPE_ALIAS()) {
                let dn = decl_get_name(cur);
                if (dn == name || dn == base || dn == short_name
                    || policy_type_name_equal(dn, name)
                    || policy_type_name_equal(dn, base)) {
                    self.type_alias_decl_cache = hir_raw_name_map_put(self.type_alias_decl_cache,name, cur);
                    return cur;
                }
            }
            cur = decl_get_next(cur);
        }
        self.type_alias_decl_miss_cache = hir_name_id_map_put(self.type_alias_decl_miss_cache,name, 1);
        return null;
    }

    fn class_nth_layout_parent(self, cd: rawptr, want: i32) -> rawptr {
        if (cd == null || want < 0) { return null; }
        if (want == 0) {
            let cached_parent = hir_raw_owner_map_get(self.class_parent_cache,cd);
            if (cached_parent != null) { return cached_parent; }
        }
        let gp = decl_get_generic_params(cd);
        let prefix_pos = hir_builder_index_of(gp, "|impl:");
        if (prefix_pos < 0) { return null; }
        var start = prefix_pos + 6;
        var i = start;
        var seen: i32 = 0;
        while (i <= gp.len) {
            if (i == gp.len || gp.charAt(i) == 44 || gp.charAt(i) == 124) {
                let item = gp.substring(start, i);
                if (item.len > 0 && item != decl_get_name(cd)) {
                    let parent_decl = self.find_class_decl(item);
                    if (parent_decl != null && ((decl_get_generic_flags(parent_decl) & 2) == 0)) {
                        if (seen == want) {
                            if (want == 0) {
                                self.class_parent_cache = hir_raw_owner_map_put(self.class_parent_cache,cd, parent_decl);
                            }
                            return parent_decl;
                        }
                        seen = seen + 1;
                    }
                }
                start = i + 1;
                if (i < gp.len && gp.charAt(i) == 124) { return null; }
            }
            i = i + 1;
        }
        return null;
    }

    fn class_parent_decl(self, cd: rawptr) -> rawptr {
        return self.class_nth_layout_parent(cd, 0);
    }

    fn reflect_type_visible(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        if (!hir_builder_decl_has_reflect_attr(d)) { return false; }
        if (hir_builder_decl_has_hidden_attr(d)) { return false; }
        if (!hir_builder_decl_exports_world(d)) { return false; }
        let vis = hir_builder_reflect_attr_visibility(d);
        if (vis == "private" || vis == "internal" || vis == "protected") { return false; }
        let k = decl_get_kind(d);
        if (k == de_ENUM()) { return true; }
        if (k != de_CLASS()) { return false; }
        return true;
    }

    fn reflect_member_visible(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        if (!hir_builder_decl_exports_world(d)) { return false; }
        if (hir_builder_decl_has_hidden_attr(d)) { return false; }
        if (hir_builder_decl_visibility_is_none(d)) { return false; }
        return true;
    }

    fn count_class_fields(self, class_decl: rawptr) -> i32 {
        if (class_decl == null) { return 0; }
        var n: i32 = 0;
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(class_decl, parent_i);
            if (parent_decl == null) { break; }
            n = n + self.count_class_fields(parent_decl);
            parent_i = parent_i + 1;
        }
        var mp = decl_get_members(class_decl);
        while (mp != null) {
            if (hir_builder_decl_is_layout_field(mp)) { n = n + 1; }
            mp = decl_get_next(mp);
        }
        return n;
    }

    fn class_layout_field_at(self, class_decl: rawptr, want_idx: i32) -> rawptr {
        if (class_decl == null || want_idx < 0) { return null; }
        var local_idx = want_idx;
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(class_decl, parent_i);
            if (parent_decl == null) { break; }
            let parent_count = self.count_class_fields(parent_decl);
            if (local_idx < parent_count) { return self.class_layout_field_at(parent_decl, local_idx); }
            local_idx = local_idx - parent_count;
            parent_i = parent_i + 1;
        }
        var idx: i32 = 0;
        var mp = decl_get_members(class_decl);
        while (mp != null) {
            if (hir_builder_decl_is_layout_field(mp)) {
                if (idx == local_idx) { return mp; }
                idx = idx + 1;
            }
            mp = decl_get_next(mp);
        }
        return null;
    }

    fn reflected_field_count(self, class_decl: rawptr) -> i32 {
        if (class_decl == null) { return 0; }
        var n: i32 = 0;
        let total = self.count_class_fields(class_decl);
        var idx: i32 = 0;
        while (idx < total) {
            let f = self.class_layout_field_at(class_decl, idx);
            if (f != null && self.reflect_member_visible(f)) { n = n + 1; }
            idx = idx + 1;
        }
        return n;
    }

    fn reflected_method_count(self, class_decl: rawptr) -> i32 {
        if (class_decl == null) { return 0; }
        var n: i32 = 0;
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(class_decl, parent_i);
            if (parent_decl == null) { break; }
            n = n + self.reflected_method_count(parent_decl);
            parent_i = parent_i + 1;
        }
        var m = decl_get_members(class_decl);
        while (m != null) {
            if (decl_get_kind(m) == de_METHOD() && self.reflect_member_visible(m)) { n = n + 1; }
            m = decl_get_next(m);
        }
        return n;
    }

    fn type_name_for_ref(self, ty: rawptr) -> string {
        if (ty == null) { return "void"; }
        let sty = self.concrete_type_ref(ty);
        if (sty == null) { return "void"; }
        let k = tref_get_kind(sty);
        if (k == ty_I32()) { return "i32"; }
        if (k == ty_I64()) { return "i64"; }
        if (k == ty_I8()) { return "i8"; }
        if (k == ty_I16()) { return "i16"; }
        if (k == ty_U8()) { return "u8"; }
        if (k == ty_U16()) { return "u16"; }
        if (k == ty_U32()) { return "u32"; }
        if (k == ty_U64()) { return "u64"; }
        if (k == ty_ISIZE()) { return "isize"; }
        if (k == ty_USIZE()) { return "usize"; }
        if (k == ty_F32()) { return "f32"; }
        if (k == ty_F64()) { return "f64"; }
        if (k == ty_BOOL()) { return "bool"; }
        if (k == ty_CHAR()) { return "char"; }
        if (k == ty_STRING()) { return "string"; }
        if (k == ty_RAWPTR()) { return "rawptr"; }
        if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()) {
            var prefix = "ptr";
            if (k == ty_REF()) { prefix = "ref"; }
            if (k == ty_MUTREF()) { prefix = "mutref"; }
            return prefix + "<" + self.type_name_for_ref(tref_pointee(sty)) + ">";
        }
        if (k == ty_VOID()) { return "void"; }
        if (k == ty_RANGE()) { return "Range"; }
        if (k == ty_ARRAY()) {
            return "[" + self.type_name_for_ref(tref_array_elem(sty))
                + ";"
                + policy_i64_to_string(tref_array_size(sty))
                + "]";
        }
        if (k == ty_TUPLE()) {
            var out = "(";
            var i: i64 = 0;
            while (i < tref_tuple_count(sty)) {
                if (i > 0) { out = out + ","; }
                out = out + self.type_name_for_ref(tref_tuple_elem_at(sty, i));
                i = i + 1;
            }
            return out + ")";
        }
        if (k == ty_FN() || k == ty_CFN()) {
            var out2 = "fn(";
            if (k == ty_CFN()) { out2 = "cfn("; }
            var p: i64 = 0;
            while (p < tref_fn_param_count(sty)) {
                if (p > 0) { out2 = out2 + ","; }
                out2 = out2 + self.type_name_for_ref(tref_fn_param_at(sty, p));
                p = p + 1;
            }
            out2 = out2 + ")->" + self.type_name_for_ref(tref_fn_ret(sty));
            return out2;
        }
        if (k == ty_CLASS()) {
            let n = tref_get_name(sty);
            if (hir_builder_is_primitive_str_name(n)) { return "string"; }
            if (n.len > 0) { return n; }
        }
        return "rawptr";
    }

    fn class_uses_c_repr(self, class_decl: rawptr) -> bool {
        if (class_decl == null) { return false; }
        if (hir_builder_decl_is_packed(class_decl)) { return true; }
        if (hir_builder_decl_repr_align(class_decl) > 0) { return true; }
        return hir_builder_decl_has_repr_c(class_decl);
    }

    fn class_abi_align(self, class_decl: rawptr) -> i64 {
        if (class_decl == null) { return 8; }
        if (!self.class_uses_c_repr(class_decl)) { return 8; }
        let packed = hir_builder_decl_is_packed(class_decl);
        let forced = hir_builder_decl_repr_align(class_decl);
        if (packed && forced <= 0) { return 1; }
        var max_align: i64 = 1;
        if (!packed) {
            let total = self.count_class_fields(class_decl);
            var idx: i32 = 0;
            while (idx < total) {
                let f = self.class_layout_field_at(class_decl, idx);
                if (f != null) {
                    let align = self.type_ref_abi_align(self.concrete_type_ref(decl_get_ty(f)));
                    if (align > max_align) { max_align = align; }
                }
                idx = idx + 1;
            }
        }
        if (forced > max_align) { max_align = forced; }
        if (max_align <= 0) { return 1; }
        return max_align;
    }

    fn type_ref_abi_align(self, ty_ref: rawptr) -> i64 {
        if (ty_ref == null) { return 8; }
        let sty = self.concrete_type_ref(ty_ref);
        if (sty == null) { return 8; }
        let k = tref_get_kind(sty);
        if (k == ty_BOOL() || k == ty_I8() || k == ty_U8()) { return 1; }
        if (k == ty_I16() || k == ty_U16()) { return 2; }
        if (k == ty_CHAR() || k == ty_I32() || k == ty_U32() || k == ty_F32()) { return 4; }
        if (k == ty_ARRAY()) { return self.type_ref_abi_align(tref_array_elem(sty)); }
        if (k == ty_CLASS()) {
            let n = tref_get_name(sty);
            if (hir_builder_is_primitive_str_name(n)) { return 8; }
            let cd = self.find_class_decl(n);
            if (cd != null) { return self.class_abi_align(cd); }
        }
        return 8;
    }

    fn align_i64(self, value: i64, align: i64) -> i64 {
        if (align <= 1) { return value; }
        let rem = value % align;
        if (rem == 0) { return value; }
        return value + (align - rem);
    }

    fn class_storage_size(self, class_decl: rawptr) -> i64 {
        if (class_decl == null) { return 8; }
        let packed = hir_builder_decl_is_packed(class_decl);
        let total = self.count_class_fields(class_decl);
        var off: i64 = 0;
        var idx: i32 = 0;
        while (idx < total) {
            let f = self.class_layout_field_at(class_decl, idx);
            if (f != null) {
                let ft = self.concrete_type_ref(decl_get_ty(f));
                var align = self.type_ref_abi_align(ft);
                if (packed) { align = 1; }
                off = self.align_i64(off, align);
                off = off + self.type_ref_storage_size(ft);
            }
            idx = idx + 1;
        }
        if (self.class_uses_c_repr(class_decl)) {
            off = self.align_i64(off, self.class_abi_align(class_decl));
        } else {
            var max_align: i64 = 1;
            var j: i32 = 0;
            while (j < total) {
                let f2 = self.class_layout_field_at(class_decl, j);
                if (f2 != null) {
                    let a2 = self.type_ref_abi_align(self.concrete_type_ref(decl_get_ty(f2)));
                    if (a2 > max_align) { max_align = a2; }
                }
                j = j + 1;
            }
            off = self.align_i64(off, max_align);
        }
        if (off <= 0) { return 1; }
        return off;
    }

    fn type_ref_storage_size(self, ty_ref: rawptr) -> i64 {
        if (ty_ref == null) { return 8; }
        let sty = self.concrete_type_ref(ty_ref);
        if (sty == null) { return 8; }
        let k = tref_get_kind(sty);
        if (k == ty_BOOL() || k == ty_I8() || k == ty_U8()) { return 1; }
        if (k == ty_I16() || k == ty_U16()) { return 2; }
        if (k == ty_CHAR() || k == ty_I32() || k == ty_U32() || k == ty_F32()) { return 4; }
        if (k == ty_I64() || k == ty_U64() || k == ty_ISIZE() || k == ty_USIZE() || k == ty_F64()) { return 8; }
        if (k == ty_RAWPTR() || k == ty_PTR() || k == ty_REF() || k == ty_MUTREF() || k == ty_FN() || k == ty_CFN()) { return 8; }
        if (k == ty_STRING()) { return 32; }
        if (k == ty_VOID()) { return 0; }
        if (k == ty_RANGE()) { return 16; }
        if (k == ty_ARRAY()) {
            let elem = tref_array_elem(sty);
            let count = tref_array_size(sty);
            if (count <= 0) { return 0; }
            return self.type_ref_storage_size(elem) * count;
        }
        if (k == ty_TUPLE()) {
            var off: i64 = 0;
            var max_align: i64 = 1;
            var i: i64 = 0;
            while (i < tref_tuple_count(sty)) {
                let et = tref_tuple_elem_at(sty, i);
                let ea = self.type_ref_abi_align(et);
                if (ea > max_align) { max_align = ea; }
                off = self.align_i64(off, ea);
                off = off + self.type_ref_storage_size(et);
                i = i + 1;
            }
            return self.align_i64(off, max_align);
        }
        if (k == ty_CLASS()) {
            let n = tref_get_name(sty);
            if (hir_builder_is_primitive_str_name(n)) { return 32; }
            if (n == "f32") { return 4; }
            if (n == "f64") { return 8; }
            if (policy_generic_call_base(n) == "Option" || policy_generic_call_base(n) == "Result") { return 16; }
            let cd = self.find_class_decl(n);
            if (cd != null) { return self.class_storage_size(cd); }
            return 8;
        }
        return 8;
    }

    fn reflected_field_offset(self, class_decl: rawptr, layout_idx: i32) -> i64 {
        if (class_decl == null || layout_idx < 0) { return -1; }
        let packed = hir_builder_decl_is_packed(class_decl);
        var off: i64 = 0;
        var i: i32 = 0;
        while (i < layout_idx) {
            let f = self.class_layout_field_at(class_decl, i);
            if (f != null) {
                let ft = self.concrete_type_ref(decl_get_ty(f));
                var align = self.type_ref_abi_align(ft);
                if (packed) { align = 1; }
                off = self.align_i64(off, align);
                off = off + self.type_ref_storage_size(ft);
            }
            i = i + 1;
        }
        let target = self.class_layout_field_at(class_decl, layout_idx);
        if (target != null) {
            var target_align = self.type_ref_abi_align(self.concrete_type_ref(decl_get_ty(target)));
            if (packed) { target_align = 1; }
            off = self.align_i64(off, target_align);
        }
        return off;
    }

    fn reflected_fields_blob(self, class_decl: rawptr) -> string {
        if (class_decl == null) { return ""; }
        let total = self.count_class_fields(class_decl);
        var out = "";
        var visible_idx: i32 = 0;
        var layout_idx: i32 = 0;
        while (layout_idx < total) {
            let f = self.class_layout_field_at(class_decl, layout_idx);
            if (f != null && self.reflect_member_visible(f)) {
                if (out.len > 0) { out = out.clone() + ";"; }
                let field_ty = self.concrete_type_ref(decl_get_ty(f));
                let field_size = self.type_ref_storage_size(field_ty);
                let field_off = self.reflected_field_offset(class_decl, layout_idx);
                var entry = hir_builder_reflect_decl_name(f);
                entry = entry.clone() + "~" + self.type_name_for_ref(field_ty);
                entry = entry.clone() + "~" + policy_i64_to_string(visible_idx as i64);
                entry = entry.clone() + "~" + policy_i64_to_string(field_off);
                entry = entry.clone() + "~" + policy_i64_to_string(field_size);
                entry = entry.clone() + "~1~" + hir_builder_reflect_alias_blob(f);
                out = out.clone() + entry.clone();
                visible_idx = visible_idx + 1;
            }
            layout_idx = layout_idx + 1;
        }
        return out;
    }

    fn reflected_method_params_blob(self, method_decl: rawptr) -> string {
        if (method_decl == null) { return ""; }
        var out = "";
        var p = decl_get_params(method_decl);
        while (p != null) {
            if (decl_get_name(p) != "self" && !hir_builder_decl_is_variadic_param(p)) {
                if (out.len > 0) { out = out.clone() + ","; }
                out = out.clone() + self.type_name_for_ref(self.concrete_type_ref(decl_get_ty(p)));
            }
            p = decl_get_next(p);
        }
        return out;
    }

    fn reflected_methods_blob_for_decl(self, owner_class_name: string, class_decl: rawptr) -> string {
        if (class_decl == null) { return ""; }
        var out = "";
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(class_decl, parent_i);
            if (parent_decl == null) { break; }
            let parent_blob = self.reflected_methods_blob_for_decl(owner_class_name, parent_decl);
            if (parent_blob.len > 0) {
                if (out.len > 0) { out = out.clone() + ";"; }
                out = out.clone() + parent_blob;
            }
            parent_i = parent_i + 1;
        }
        var m = decl_get_members(class_decl);
        while (m != null) {
            if (decl_get_kind(m) == de_METHOD() && self.reflect_member_visible(m)) {
                if (out.len > 0) { out = out.clone() + ";"; }
                var param_count = hir_builder_count_non_variadic_params(decl_get_params(m));
                let first_param = decl_get_params(m);
                if (first_param != null && decl_get_name(first_param) == "self" && param_count > 0) {
                    param_count = param_count - 1;
                }
                let method_symbol = hir_builder_class_method_symbol_name(decl_get_name(class_decl), decl_get_name(m));
                var entry = hir_builder_reflect_decl_name(m);
                entry = entry.clone() + "~" + self.type_name_for_ref(self.concrete_type_ref(decl_get_ty(m)));
                entry = entry.clone() + "~" + policy_i64_to_string(param_count as i64);
                entry = entry.clone() + "~" + self.reflected_method_params_blob(m);
                entry = entry.clone() + "~" + owner_class_name;
                entry = entry.clone() + "~" + policy_i64_to_string(hir_builder_reflect_symbol_id(method_symbol));
                entry = entry.clone() + "~" + hir_builder_reflect_alias_blob(m);
                entry = entry.clone() + "~";
                if (hir_builder_method_decl_has_receiver(m)) {
                    entry = entry.clone() + "1";
                } else {
                    entry = entry.clone() + "0";
                }
                out = out.clone() + entry.clone();
            }
            m = decl_get_next(m);
        }
        return out;
    }

    fn materialize_reflection_method_roots_for_decl(self, class_decl: rawptr) {
        if (class_decl == null) { return; }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(class_decl, parent_i);
            if (parent_decl == null) { break; }
            self.materialize_reflection_method_roots_for_decl(parent_decl);
            parent_i = parent_i + 1;
        }
        var m = decl_get_members(class_decl);
        while (m != null) {
            if (decl_get_kind(m) == de_METHOD()
                && decl_get_body(m) != null
                && self.reflect_member_visible(m)) {
                let fn_id = hir_pointer_map_function(self.decl_map,m);
                if (fn_id != hir_id_invalid()) {
                    let prior_flags = hir_unit_function_flags(self.unit, fn_id);
                    var reflection_flags = hir_function_flag_codegen_root()
                        | hir_function_flag_reflection_root();
                    if ((prior_flags & hir_function_flag_codegen_root()) != 0
                        && (prior_flags & hir_function_flag_reflection_root()) == 0) {
                        reflection_flags = reflection_flags
                            | hir_function_flag_reflection_named_root();
                    }
                    self.unit.add_function_flags(fn_id,
                                                reflection_flags);
                    self.ensure_reachable_function_body(m, fn_id, false);
                }
            }
            m = decl_get_next(m);
        }
    }

    fn materialize_reflection_method_roots(self) {
        if (self.source_unit == null) { return; }
        var cd = unit_get_decls(self.source_unit);
        while (cd != null) {
            if (self.reflect_type_visible(cd)) {
                self.materialize_reflection_method_roots_for_decl(cd);
            }
            cd = decl_get_next(cd);
        }
    }

    fn source_unit_has_reflect_visible_type(self) -> bool {
        if (self.source_unit == null) { return false; }
        var cd = unit_get_decls(self.source_unit);
        while (cd != null) {
            if (self.reflect_type_visible(cd)) { return true; }
            cd = decl_get_next(cd);
        }
        return false;
    }

    fn reflected_parent_name(self, class_decl: rawptr) -> string {
        let parent_decl = self.class_parent_decl(class_decl);
        if (parent_decl == null) { return ""; }
        if (self.reflect_type_visible(parent_decl)) { return hir_builder_reflect_decl_name(parent_decl); }
        return decl_get_name(parent_decl);
    }

    fn reflected_interfaces_blob(self, class_decl: rawptr) -> string {
        if (class_decl == null || (decl_get_generic_flags(class_decl) & 64) == 0) { return ""; }
        let gp = decl_get_generic_params(class_decl);
        let prefix_pos = hir_builder_index_of(gp, "|impl:");
        if (prefix_pos < 0) { return ""; }
        var start = prefix_pos + 6;
        var i = start;
        var out = "";
        while (i <= gp.len) {
            if (i == gp.len || gp.charAt(i) == 44 || gp.charAt(i) == 124) {
                let item = gp.substring(start, i);
                if (item.len > 0) {
                    let iface_decl = self.find_class_decl(item);
                    if (iface_decl != null && ((decl_get_generic_flags(iface_decl) & 2) != 0)) {
                        if (out.len > 0) { out = out.clone() + ","; }
                        if (self.reflect_type_visible(iface_decl)) {
                            out = out.clone() + hir_builder_reflect_decl_name(iface_decl);
                        } else {
                            out = out.clone() + item;
                        }
                    }
                }
                start = i + 1;
                if (i < gp.len && gp.charAt(i) == 124) { return out; }
            }
            i = i + 1;
        }
        return out;
    }

    fn reflection_kind_name(self, d: rawptr) -> string {
        if (d == null) { return ""; }
        if (decl_get_kind(d) == de_ENUM()) { return "enum"; }
        if (decl_get_kind(d) == de_CLASS()
            && (((decl_get_generic_flags(d) & 2) != 0)
                || hir_builder_string_contains(decl_get_generic_params(d), "|kind:interface"))) {
            return "interface";
        }
        return hir_builder_reflect_kind_for_type_name(decl_get_name(d));
    }

    fn build_reflection_manifest(self) -> string {
        if (self.source_unit == null) { return ""; }
        var out = "";
        var cd = unit_get_decls(self.source_unit);
        while (cd != null) {
            if (self.reflect_type_visible(cd)) {
                if (out.len > 0) { out = out.clone() + "\n"; }
                let reflect_name = hir_builder_reflect_decl_name(cd);
                let reflect_aliases = hir_builder_reflect_alias_blob(cd);
                let type_size = self.type_ref_storage_size(tref_alloc(ty_CLASS(), decl_get_name(cd)));
                let fcnt = self.reflected_field_count(cd);
                let mcnt = self.reflected_method_count(cd);
                var row = reflect_name.clone();
                row = row.clone() + "|" + reflect_aliases.clone();
                row = row.clone() + "|" + self.reflection_kind_name(cd);
                row = row.clone() + "|" + policy_i64_to_string(type_size);
                row = row.clone() + "|" + policy_i64_to_string(fcnt as i64);
                row = row.clone() + "|" + policy_i64_to_string(mcnt as i64);
                row = row.clone() + "|" + self.reflected_fields_blob(cd);
                row = row.clone() + "|" + self.reflected_methods_blob_for_decl(decl_get_name(cd), cd);
                row = row.clone() + "|" + self.reflected_parent_name(cd);
                row = row.clone() + "|" + self.reflected_interfaces_blob(cd);
                out = out.clone() + row.clone();
            }
            cd = decl_get_next(cd);
        }
        return out;
    }

    fn build_reflection_name_map(self) -> string {
        if (self.source_unit == null) { return ""; }
        var out = "";
        var cd = unit_get_decls(self.source_unit);
        while (cd != null) {
            if (self.reflect_type_visible(cd)) {
                if (out.len > 0) { out = out.clone() + "\n"; }
                let row = decl_get_name(cd) + "~" + hir_builder_reflect_decl_name(cd);
                out = out.clone() + row.clone();
            }
            cd = decl_get_next(cd);
        }
        return out;
    }

    fn collect_foreign_cpp_includes_from_decl_chain(self, head: rawptr, rows: string) -> string {
        var out = rows;
        var cd = head;
        while (cd != null) {
            // `extern "dci"` is the C++ DCI profile spelling; includes must be
            // collected for both `|extern_abi:dci` and `|extern_abi:cpp`.
            if (hir_builder_decl_is_foreign_dci(cd)) {
                out = hir_builder_append_cpp_include_attrs(out, cd);
            }
            if (decl_get_members(cd) != null) {
                out = self.collect_foreign_cpp_includes_from_decl_chain(decl_get_members(cd), out);
            }
            cd = decl_get_next(cd);
        }
        return out;
    }

    fn build_foreign_cpp_includes(self) -> string {
        if (self.source_unit == null) { return ""; }
        return self.collect_foreign_cpp_includes_from_decl_chain(unit_get_decls(self.source_unit), "");
    }

    fn class_decl_requires_dci_stub(self, cd: rawptr, depth: i32) -> bool {
        if (cd == null || depth > 32) { return false; }
        if (decl_get_kind(cd) != de_CLASS()) { return false; }
        // Foreign DCI/C++ types are the stub *bases*, never Vyx stub classes.
        // Parent match must use foreign_dci so `extern "dci"` (not only
        // `extern "cpp"`) triggers subclass factory / vtable thunk emission.
        if (hir_builder_decl_is_foreign_dci(cd)) { return false; }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(cd, parent_i);
            if (parent_decl == null) { return false; }
            if (hir_builder_decl_is_foreign_dci(parent_decl)) { return true; }
            if (self.class_decl_requires_dci_stub(parent_decl, depth + 1)) { return true; }
            parent_i = parent_i + 1;
        }
        return false;
    }

    /// The direct foreign DCI/C++ parent a stub class takes its layout from.
    fn dci_stub_foreign_parent_decl(self, cd: rawptr) -> rawptr {
        if (cd == null) { return null; }
        var parent_i: i32 = 0;
        while (parent_i < 16) {
            let parent_decl = self.class_nth_layout_parent(cd, parent_i);
            if (parent_decl == null) { return null; }
            if (hir_builder_decl_is_foreign_dci(parent_decl)) { return parent_decl; }
            parent_i = parent_i + 1;
        }
        return null;
    }

    /// The base entry a closed instance actually inherits: the base clause's
    /// arguments substituted with the instance's own (`native.SinkG<T>` with
    /// `T=i32` becomes `native.SinkG<i32>`).  That is the spelling the
    /// producer's contract carries, and the only one a descriptor lookup can
    /// resolve to a layout / vtable.
    fn dci_stub_instance_base_text(self,
                                   cd: rawptr,
                                   owner_params: string,
                                   owner_args: string) -> string {
        let parent_decl = self.dci_stub_foreign_parent_decl(cd);
        if (parent_decl == null) { return ""; }
        var base_text = decl_get_name(parent_decl);
        if (base_text.len == 0) { return ""; }
        var base_args = hir_builder_base_clause_args(decl_get_generic_params(cd), base_text);
        if (base_args.len > 0) {
            base_args = hir_builder_substitute_env_in_type_text(base_args, owner_params, owner_args);
            if (base_args.len == 0) { return ""; }
            base_text = base_text + "<" + base_args + ">";
        }
        return base_text;
    }

    /// Register one closed instance of a generic DCI stub class, then
    /// materialize the overrides it contributes as closed functions.
    ///
    /// The declaration-level function of such an override keeps the class's
    /// open parameters (`consume(x: T) -> T`), so it can never be the entry a
    /// foreign stub dispatches into; the closed instance is.
    fn record_dci_stub_class_instance(self,
                                      cd: rawptr,
                                      owner_key: string,
                                      owner_params: string,
                                      owner_args: string) {
        if (cd == null || owner_key.len == 0) { return; }
        let base_text = self.dci_stub_instance_base_text(cd, owner_params, owner_args);
        if (base_text.len == 0) { return; }
        // Compare whole lines: a row is a prefix of nothing, but a shorter row
        // could otherwise match inside a longer one.
        let row = "class\t" + owner_key + "\t" + base_text + "\n";
        if (!hir_builder_string_contains(self.dci_stub_instance_specs, row)) {
            self.dci_stub_instance_specs = self.dci_stub_instance_specs + row;
            // Publish *now*, not at the next `finalize_foreign_cpp_metadata`.
            //
            // The row is discovered while a closed instance is materialized,
            // and in lazy-codegen builds that happens long after the last
            // publish: `HirUnitBuilder.build` publishes before any function
            // body exists, and MIR/codegen then materialize bodies on demand
            // (`hir_codegen_builder_handle_materialize_function_body` ->
            // `ensure_class_instance`).  A stub class missing from the spec
            // list is not "a stub class with no layout" -- it is not a stub
            // class at all, so the instance is lowered as an empty value
            // struct (no vptr) and every `as *Base` / virtual call against it
            // fails at the ABI boundary.  The stub-source emitter runs in its
            // own process off this same list, so it would emit no stub either.
            self.unit.set_dci_stub_specs(self.build_dci_stub_specs());
        }
        self.materialize_dci_stub_class_instance_overrides(cd, owner_key);
    }

    /// Closed overrides of one stub-class instance.
    ///
    /// The environment is the class's own (`T -> i32`) plus `Self -> the
    /// instance`, which is the same environment the ordinary method sink builds
    /// for a closed receiver.  The instance function therefore carries the
    /// instance's owner text (`VyxSink<i32>`) and a fully substituted signature
    /// (`consume(x: i32) -> i32`) -- the shape the stub emitter matches against
    /// the base's descriptor vtable.  Flags mirror the declaration-level path
    /// for a non-generic stub class exactly; `codegen_root` is required because
    /// no Vyx call site reaches a reverse override (the foreign dispatch is its
    /// only caller), and the override flag is what makes it eligible as a stub
    /// override at all.
    fn materialize_dci_stub_class_instance_overrides(self, cd: rawptr, owner_key: string) {
        if (cd == null || owner_key.len == 0) { return; }
        let class_params = hir_builder_decl_template_params(cd);
        let class_args = hir_builder_owner_args_for_params(class_params, owner_key);
        if (class_params.len == 0 || class_args.len == 0) { return; }
        var params = class_params;
        var args = class_args;
        if (!hir_builder_generic_contains(params, "Self")) {
            params = hir_builder_append_csv(params, "Self");
            args = hir_builder_append_csv(args, owner_key);
        }
        var member = decl_get_members(cd);
        while (member != null) {
            if (decl_get_kind(member) == de_METHOD()
                && hir_builder_decl_has_marker(member, "override")) {
                let override_fn = self.ensure_function_instance(member, cd, owner_key,
                                                                params, args);
                if (override_fn != hir_id_invalid()) {
                    if (hir_builder_decl_has_marker(member, "virtual")) {
                        self.unit.add_function_flags(
                            override_fn, hir_function_flag_foreign_dci_virtual_method());
                    }
                    self.unit.add_function_flags(
                        override_fn,
                        hir_function_flag_foreign_dci_override_method()
                        | hir_function_flag_codegen_root());
                    if (hir_builder_decl_has_marker(member, "final")) {
                        self.unit.add_function_flags(
                            override_fn, hir_function_flag_foreign_dci_final_method());
                    }
                }
            }
            member = decl_get_next(member);
        }
    }

    fn append_dci_stub_specs_from_decl_chain(self, head: rawptr, rows: string) -> string {
        var out = rows;
        var cd = head;
        while (cd != null) {
            if (decl_get_kind(cd) == de_CLASS()) {
                if (self.class_decl_requires_dci_stub(cd, 0)
                    && hir_builder_decl_template_params(cd).len == 0) {
                    var parent_decl = self.class_parent_decl(cd);
                    var parent_i: i32 = 0;
                    while (parent_i < 16) {
                        let p = self.class_nth_layout_parent(cd, parent_i);
                        if (p == null) { break; }
                        if (hir_builder_decl_is_foreign_dci(p)) {
                            parent_decl = p;
                            break;
                        }
                        parent_i = parent_i + 1;
                    }
                    if (parent_decl != null) {
                        // A generic foreign base is inherited as a *closed
                        // instance*: `class VyxHost : native.Sink<i32>` needs
                        // the descriptor / stub base to say `native.Sink<i32>`,
                        // because that is the entry the producer's contract
                        // carries (`native.Sink` alone is the open trait and
                        // has no vtable).  The arguments come from the base
                        // clause; the parser keeps them in `|baseargs:`.
                        var base_text = decl_get_name(parent_decl);
                        let base_args = hir_builder_base_clause_args(
                            decl_get_generic_params(cd), base_text);
                        if (base_args.len > 0) {
                            base_text = base_text + "<" + base_args + ">";
                        }
                        out = out + "class\t" + decl_get_name(cd) + "\t" + base_text + "\n";
                    }
                }
                out = self.append_dci_stub_specs_from_decl_chain(decl_get_members(cd), out);
            }
            cd = decl_get_next(cd);
        }
        return out;
    }

    fn build_dci_stub_specs(self) -> string {
        if (self.source_unit == null) { return ""; }
        // Non-generic stub classes come straight from the declaration chain.
        // Generic ones contributed one row per materialized instance while
        // that instance was built (see `record_dci_stub_class_instance`).
        return self.append_dci_stub_specs_from_decl_chain(unit_get_decls(self.source_unit), "")
               + self.dci_stub_instance_specs;
    }

    public fn finalize_foreign_cpp_metadata(self) {
        self.unit.set_foreign_cpp_includes(self.build_foreign_cpp_includes());
        self.unit.set_dci_stub_specs(self.build_dci_stub_specs());
    }

    public fn finalize_reflection_metadata(self) {
        let has_reflect_visible_type = self.source_unit_has_reflect_visible_type();
        let needs_reflection_manifest = self.reflection_manifest_required
            || has_reflect_visible_type
            || self.unit_has_call_named("reflect_manifest")
            || self.unit_has_call_named("getType")
            || self.unit_has_call_named("reflect_method_value")
            || self.unit_has_call_named("reflect_method_ptr_by_id");
        let needs_reflection_name_map = self.reflection_name_map_required
            || needs_reflection_manifest
            || self.unit_has_call_named("reflect_name");
        if (needs_reflection_manifest) {
            self.materialize_reflection_method_roots();
            self.materialize_reachable_function_bodies();
            self.materialize_concrete_type_items();
            self.resolve_deferred_member_exprs();
            self.profile_build_phase("reflection-roots");
        }
        if (needs_reflection_manifest) {
            self.unit.set_reflection_manifest(self.build_reflection_manifest());
            self.profile_build_phase("reflection-manifest");
        }
        if (needs_reflection_name_map) {
            self.unit.set_reflection_name_map(self.build_reflection_name_map());
            self.profile_build_phase("reflection-name-map");
        }
    }

    fn drain_codegen_hir_until_stable(self) {
        self.profile_build_phase("drain-enter");
        var changed = true;
        var round: i32 = 0;
        while (changed) {
            round = round + 1;
            self.profile_build_phase("drain-round-" + self.i32_text(round) + "-enter");
            let before_items = self.unit.item_count;
            let before_functions = self.unit.function_count;
            let before_locals = self.unit.local_count;
            let before_stmts = self.unit.stmt_count;
            let before_exprs = self.unit.expr_count;
            let before_types = self.unit.types.count;
            self.profile_build_phase("drain-round-" + self.i32_text(round) + "-before-reachable");
            self.materialize_reachable_function_bodies();
            self.profile_build_phase("drain-round-" + self.i32_text(round) + "-after-reachable");
            self.profile_build_phase("drain-round-" + self.i32_text(round) + "-before-concrete");
            self.materialize_concrete_type_items();
            self.profile_build_phase("drain-round-" + self.i32_text(round) + "-after-concrete");
            self.profile_build_phase("drain-round-" + self.i32_text(round) + "-before-deferred");
            self.resolve_deferred_member_exprs();
            self.profile_build_phase("drain-round-" + self.i32_text(round) + "-after-deferred");
            changed = self.unit.item_count != before_items
                || self.unit.function_count != before_functions
                || self.unit.local_count != before_locals
                || self.unit.stmt_count != before_stmts
                || self.unit.expr_count != before_exprs
                || self.unit.types.count != before_types;
            self.profile_build_phase("drain-round-" + self.i32_text(round) + "-leave");
        }
        self.profile_build_phase("drain-leave");
    }

    public fn finalize_codegen_hir(self) {
        self.profile_build_phase("finalize-enter");
        self.drain_codegen_hir_until_stable();
        self.profile_build_phase("finalize-after-drain-1");
        self.finalize_foreign_cpp_metadata();
        self.finalize_reflection_metadata();
        self.profile_build_phase("finalize-after-reflection");
        self.drain_codegen_hir_until_stable();
        self.finalize_foreign_cpp_metadata();
        self.profile_build_phase("finalize-leave");
    }

    fn clear_hir_string_slot(self, rec: rawptr, ptr_off: i32, len_off: i32) {
        if (rec == null) { return; }
        let slot = ptr_offset(rec, ptr_off);
        let old_ptr = ast_read_rawptr(slot);
        if (old_ptr != null) {
            vyx_forget_string_len(old_ptr);
            free(old_ptr);
        }
        ast_write_rawptr(slot, null);
        ast_write_i64(ptr_offset(rec, len_off), 0);
    }

    fn clear_stmt_record_strings(self, stmt_id: i32) {
        let rec = self.unit.stmt_record(stmt_id);
        if (rec == null) { return; }
        self.clear_hir_string_slot(rec, 48, 56);
        memset(rec, 0, 64);
    }

    fn clear_expr_record_strings(self, expr_id: i32) {
        let rec = self.unit.expr_record(expr_id);
        if (rec == null) { return; }
        self.clear_hir_string_slot(rec, 56, 64);
        self.clear_hir_string_slot(rec, 72, 80);
        self.clear_hir_string_slot(rec, 112, 120);
        memset(rec, 0, 144);
    }

    fn clear_local_record_strings(self, local_id: i32) {
        let rec = self.unit.local_record(local_id);
        if (rec == null) { return; }
        self.clear_hir_string_slot(rec, 16, 24);
        memset(rec, 0, 48);
    }

    fn function_owns_latest_body_range(self, function_id: i32, stmt_mark: i32, expr_mark: i32) -> bool {
        if (function_id == hir_id_invalid()) { return false; }
        var stmt_id = stmt_mark + 1;
        while (stmt_id <= self.unit.stmt_count) {
            let stmt_rec = self.unit.stmt_record(stmt_id);
            if (stmt_rec != null
                && ast_read_i32(stmt_rec) != hir_id_invalid()
                && ast_read_i32(ptr_offset(stmt_rec, 8)) != function_id) {
                return false;
            }
            stmt_id = stmt_id + 1;
        }
        var expr_id = expr_mark + 1;
        while (expr_id <= self.unit.expr_count) {
            let expr_rec = self.unit.expr_record(expr_id);
            if (expr_rec != null
                && ast_read_i32(expr_rec) != hir_id_invalid()
                && ast_read_i32(ptr_offset(expr_rec, 8)) != function_id) {
                return false;
            }
            expr_id = expr_id + 1;
        }
        return true;
    }

    fn function_owns_latest_local_range(self, function_id: i32, local_mark: i32) -> bool {
        if (function_id == hir_id_invalid()) { return false; }
        var local_id = local_mark + 1;
        while (local_id <= self.unit.local_count) {
            let rec = self.unit.local_record(local_id);
            if (rec != null) {
                if (ast_read_i32(ptr_offset(rec, 4)) != function_id) { return false; }
                if (self.local_survives_codegen_discard(local_id, local_mark)) { return false; }
            }
            local_id = local_id + 1;
        }
        return true;
    }

    fn local_survives_codegen_discard(self, local_id: i32, local_mark: i32) -> bool {
        if (local_id <= local_mark) { return true; }
        let rec = self.unit.local_record(local_id);
        if (rec == null) { return false; }
        let flags = ast_read_i32(ptr_offset(rec, 12));
        if ((flags & hir_local_flag_param()) != 0) { return true; }
        if ((flags & hir_local_flag_capture()) != 0) { return true; }
        return false;
    }

    fn trim_function_locals_after_mark(self, function_id: i32, local_mark: i32) {
        if (function_id == hir_id_invalid()) { return; }
        let fn_rec = self.unit.function_record(function_id);
        if (fn_rec == null) { return; }
        var cur = ast_read_i32(ptr_offset(fn_rec, 12));
        var prev: i32 = hir_id_invalid();
        var kept: i32 = 0;
        var guard: i32 = 0;
        var guard_limit = self.unit.local_count + 2;
        while (cur != hir_id_invalid() && guard < guard_limit) {
            let rec = self.unit.local_record(cur);
            let next = self.unit.local_next(cur);
            if (rec == null || !self.local_survives_codegen_discard(cur, local_mark)) {
                if (prev == hir_id_invalid()) {
                    ast_write_i32(ptr_offset(fn_rec, 12), next);
                } else {
                    let prev_rec = self.unit.local_record(prev);
                    if (prev_rec != null) { ast_write_i32(ptr_offset(prev_rec, 32), next); }
                }
                cur = next;
            } else {
                kept = kept + 1;
                prev = cur;
                cur = next;
            }
            guard = guard + 1;
        }
        ast_write_i32(ptr_offset(fn_rec, 100), prev);
        ast_write_i32(ptr_offset(fn_rec, 16), kept);
    }

    fn trim_unit_local_tail_after_codegen(self) {
        var new_count = self.unit.local_count;
        while (new_count > 0) {
            let rec = self.unit.local_record(new_count);
            if (rec == null) { return; }
            if (ast_read_i32(rec) != 0) { break; }
            new_count = new_count - 1;
        }
        if (new_count < self.unit.local_count) {
            self.unit.local_count = new_count;
            self.unit.ids.next_local_id = new_count + 1;
        }
    }

    fn discard_function_locals_after_codegen(self, function_id: i32, local_mark: i32) {
        if (function_id == hir_id_invalid()) { return; }
        if (self.function_owns_latest_local_range(function_id, local_mark)) {
            var local_id = local_mark + 1;
            while (local_id <= self.unit.local_count) {
                self.clear_local_record_strings(local_id);
                local_id = local_id + 1;
            }
            self.trim_function_locals_after_mark(function_id, local_mark);
            self.trim_unit_local_tail_after_codegen();
            return;
        }
        var id: i32 = 1;
        while (id <= self.unit.local_count) {
            let rec = self.unit.local_record(id);
            if (id > local_mark
                && rec != null
                && ast_read_i32(ptr_offset(rec, 4)) == function_id
                && !self.local_survives_codegen_discard(id, local_mark)) {
                self.clear_local_record_strings(id);
            }
            id = id + 1;
        }
        self.trim_function_locals_after_mark(function_id, local_mark);
        self.trim_unit_local_tail_after_codegen();
    }

    fn discard_latest_function_body_range_after_codegen(self,
                                                         function_id: i32,
                                                         stmt_mark: i32,
                                                         expr_mark: i32,
                                                         local_mark: i32) {
        var stmt_id = stmt_mark + 1;
        while (stmt_id <= self.unit.stmt_count) {
            self.clear_stmt_record_strings(stmt_id);
            stmt_id = stmt_id + 1;
        }
        var expr_id = expr_mark + 1;
        while (expr_id <= self.unit.expr_count) {
            self.clear_expr_record_strings(expr_id);
            expr_id = expr_id + 1;
        }
        self.unit.stmt_count = stmt_mark;
        self.unit.expr_count = expr_mark;
        self.unit.ids.next_stmt_id = stmt_mark + 1;
        self.unit.ids.next_expr_id = expr_mark + 1;
        if (self.materialized_expr_count > expr_mark) {
            self.materialized_expr_count = expr_mark;
        }
        self.unit.set_function_body(function_id, hir_id_invalid(), 0);
        self.discard_function_locals_after_codegen(function_id, local_mark);
    }

    public fn discard_function_body_after_codegen(self, function_id: i32, stmt_mark: i32, expr_mark: i32, local_mark: i32) {
        if (function_id == hir_id_invalid()) { return; }
        if (!self.function_owns_latest_body_range(function_id, stmt_mark, expr_mark)) { return; }
        self.discard_latest_function_body_range_after_codegen(function_id,
                                                               stmt_mark,
                                                               expr_mark,
                                                               local_mark);
    }

    public fn discard_function_body_records_after_codegen(self, function_id: i32, stmt_mark: i32, expr_mark: i32, local_mark: i32) {
        if (function_id == hir_id_invalid()) { return; }
        if (self.function_owns_latest_body_range(function_id, stmt_mark, expr_mark)) {
            self.discard_latest_function_body_range_after_codegen(function_id,
                                                                   stmt_mark,
                                                                   expr_mark,
                                                                   local_mark);
            return;
        }
        var stmt_id: i32 = stmt_mark + 1;
        while (stmt_id <= self.unit.stmt_count) {
            let rec = self.unit.stmt_record(stmt_id);
            if (rec != null && ast_read_i32(ptr_offset(rec, 8)) == function_id) {
                self.clear_stmt_record_strings(stmt_id);
            }
            stmt_id = stmt_id + 1;
        }
        var expr_id: i32 = expr_mark + 1;
        while (expr_id <= self.unit.expr_count) {
            let rec2 = self.unit.expr_record(expr_id);
            if (rec2 != null && ast_read_i32(ptr_offset(rec2, 8)) == function_id) {
                self.clear_expr_record_strings(expr_id);
            }
            expr_id = expr_id + 1;
        }
        self.unit.set_function_body(function_id, hir_id_invalid(), 0);
        self.discard_function_locals_after_codegen(function_id, local_mark);
    }

    public fn materialize_marked_codegen_roots(self) {
        self.profile_build_phase("marked-roots-enter");
        var fn_id: i32 = 1;
        while (fn_id <= self.unit.function_count) {
            if ((hir_unit_function_flags(self.unit, fn_id) & hir_function_flag_codegen_root()) != 0) {
                if (self.unit.function_body(fn_id) == hir_id_invalid()) {
                    self.materialize_function_body_for_codegen(fn_id);
                    self.materialize_reachable_function_bodies();
                }
            }
            fn_id = fn_id + 1;
        }
        self.materialize_concrete_type_items();
        self.resolve_deferred_member_exprs_once();
        self.materialize_reachable_function_bodies();
        self.profile_build_phase("marked-roots-leave");
    }

    fn expr_base_name(self, expr_id: i32) -> string {
        if (expr_id == hir_id_invalid()) { return ""; }
        return policy_generic_call_base(self.unit.expr_name(expr_id).clone());
    }

    fn unit_has_call_named(self, want_name: string) -> bool {
        if (want_name.len == 0) { return false; }
        var expr_id: i32 = 1;
        while (expr_id <= self.unit.expr_count) {
            if (self.unit.expr_kind(expr_id) == ex_CALL()) {
                if (self.expr_base_name(expr_id) == want_name) { return true; }
                let callee_id = self.unit.expr_lhs(expr_id);
                if (callee_id != hir_id_invalid()
                    && self.expr_base_name(callee_id) == want_name) {
                    return true;
                }
            }
            expr_id = expr_id + 1;
        }
        return false;
    }

    fn i32_text(self, value: i32) -> string {
        let wide: i64 = value as i64;
        return policy_i64_to_string(wide);
    }

    fn profile_build_phase(self, label: string) {
        if (vyx_bootstrap_profile_level() <= 1) { return; }
        let item_count_text = self.i32_text(self.unit.item_count);
        let function_count_text = self.i32_text(self.unit.function_count);
        let local_count_text = self.i32_text(self.unit.local_count);
        let stmt_count_text = self.i32_text(self.unit.stmt_count);
        let expr_count_text = self.i32_text(self.unit.expr_count);
        let type_count_text = self.i32_text(self.unit.types.count);
        print("[hir-build] " + label
              + " items=" + item_count_text
              + " functions=" + function_count_text
              + " locals=" + local_count_text
              + " stmts=" + stmt_count_text
              + " exprs=" + expr_count_text
              + " types=" + type_count_text
              + " scheduled=" + policy_i64_to_string(self.scheduled_body_count)
              + " drained=" + policy_i64_to_string(self.materialized_body_count));
    }

    fn profile_summary(self, label: string) {
        if (vyx_bootstrap_profile_level() <= 0) { return; }
        print("[hir-summary] " + label
              + " items=" + self.i32_text(self.unit.item_count)
              + " functions=" + self.i32_text(self.unit.function_count)
              + " locals=" + self.i32_text(self.unit.local_count)
              + " stmts=" + self.i32_text(self.unit.stmt_count)
              + " exprs=" + self.i32_text(self.unit.expr_count)
              + " types=" + self.i32_text(self.unit.types.count)
              + " scheduled=" + policy_i64_to_string(self.scheduled_body_count)
              + " drained=" + policy_i64_to_string(self.materialized_body_count)
              + " open=" + policy_i64_to_string(self.profile_type_open_calls)
              + " resolve=" + policy_i64_to_string(self.profile_resolve_type_calls)
              + " rawclass=" + policy_i64_to_string(self.profile_raw_class_calls)
              + " ensuremeth=" + policy_i64_to_string(self.profile_ensure_method_calls)
              + " methodtarget=" + policy_i64_to_string(self.profile_method_target_calls)
              + " field=" + policy_i64_to_string(self.profile_field_lookup_calls)
              + " fnopen=" + policy_i64_to_string(self.profile_function_open_calls)
              + " typeref=" + policy_i64_to_string(self.profile_type_id_ref_calls)
              + " concrete=" + policy_i64_to_string(self.profile_concrete_type_ref_calls)
              + " typetext=" + policy_i64_to_string(self.profile_type_id_text_calls)
              + " private_mb=" + hir_builder_memory_mb_text(vyx_rt_process_private_bytes())
              + " working_mb=" + hir_builder_memory_mb_text(vyx_rt_process_working_set_bytes()));
    }

    fn profile_body_phase(self, label: string, d: rawptr, fn_id: i32) {
        if (vyx_bootstrap_profile_level() <= 1) { return; }
        var name = "";
        if (d != null) { name = decl_get_name(d); }
        if (name.len == 0 && fn_id != hir_id_invalid()) { name = self.unit.function_name(fn_id); }
        print("[hir-body] " + label
              + " fn=" + name
              + " id=" + self.i32_text(fn_id)
              + " items=" + self.i32_text(self.unit.item_count)
              + " functions=" + self.i32_text(self.unit.function_count)
              + " locals=" + self.i32_text(self.unit.local_count)
              + " stmts=" + self.i32_text(self.unit.stmt_count)
              + " exprs=" + self.i32_text(self.unit.expr_count)
              + " types=" + self.i32_text(self.unit.types.count)
              + " open=" + policy_i64_to_string(self.profile_type_open_calls)
              + " resolve=" + policy_i64_to_string(self.profile_resolve_type_calls)
              + " rawclass=" + policy_i64_to_string(self.profile_raw_class_calls)
              + " ensuremeth=" + policy_i64_to_string(self.profile_ensure_method_calls)
              + " methodtarget=" + policy_i64_to_string(self.profile_method_target_calls)
              + " field=" + policy_i64_to_string(self.profile_field_lookup_calls)
              + " fnopen=" + policy_i64_to_string(self.profile_function_open_calls)
              + " typeref=" + policy_i64_to_string(self.profile_type_id_ref_calls)
              + " concrete=" + policy_i64_to_string(self.profile_concrete_type_ref_calls)
              + " typetext=" + policy_i64_to_string(self.profile_type_id_text_calls)
              + " private_mb=" + hir_builder_memory_mb_text(vyx_rt_process_private_bytes())
              + " working_mb=" + hir_builder_memory_mb_text(vyx_rt_process_working_set_bytes()));
    }

    fn profile_materialize_type(self, type_id: i32, type_text: string) {
        if (vyx_bootstrap_profile_level() <= 1) { return; }
        print("[hir-materialize] type="
              + self.i32_text(type_id)
              + " text=" + type_text
              + " items=" + self.i32_text(self.unit.item_count)
              + " functions=" + self.i32_text(self.unit.function_count)
              + " types=" + self.i32_text(self.unit.types.count));
    }

    fn profile_trace_near_current_body(self) -> bool {
        if (vyx_bootstrap_profile_level() <= 2) { return false; }
        return self.unit.expr_count >= 2100;
    }

    fn profile_type_ready_phase(self, label: string, type_text: string) {
        if (!self.profile_trace_near_current_body()) { return; }
        var fn_name = "";
        if (self.current_function_id != hir_id_invalid()) {
            fn_name = self.unit.function_name(self.current_function_id);
        }
        print("[hir-ready] " + label
              + " fn=" + fn_name
              + " type=" + type_text
              + " items=" + self.i32_text(self.unit.item_count)
              + " functions=" + self.i32_text(self.unit.function_count)
              + " locals=" + self.i32_text(self.unit.local_count)
              + " stmts=" + self.i32_text(self.unit.stmt_count)
              + " exprs=" + self.i32_text(self.unit.expr_count)
              + " types=" + self.i32_text(self.unit.types.count));
    }

    fn profile_function_instance_phase(self,
                                             label: string,
                                             fn_decl: rawptr,
                                             owner_type_name: string,
                                             params: string,
                                             args: string) {
        if (!self.profile_trace_near_current_body()) { return; }
        var fn_name = "";
        if (fn_decl != null) { fn_name = decl_get_name(fn_decl); }
        print("[hir-instance] " + label
              + " fn=" + fn_name
              + " owner=" + owner_type_name
              + " params=" + params
              + " args=" + args
              + " items=" + self.i32_text(self.unit.item_count)
              + " functions=" + self.i32_text(self.unit.function_count)
              + " locals=" + self.i32_text(self.unit.local_count)
              + " stmts=" + self.i32_text(self.unit.stmt_count)
              + " exprs=" + self.i32_text(self.unit.expr_count)
              + " types=" + self.i32_text(self.unit.types.count));
    }

    fn profile_struct_field_phase(self, label: string, owner_type_id: i32, field_name: string, arg_expr: i32) {
        if (!self.profile_trace_near_current_body()) { return; }
        var owner_text = "";
        if (self.type_id_is_valid(owner_type_id)) {
            owner_text = hir_type_table_text(self.unit.types, owner_type_id);
        }
        var arg_text = "";
        if (arg_expr != hir_id_invalid() && self.type_id_is_valid(self.unit.expr_type(arg_expr))) {
            arg_text = hir_type_table_text(self.unit.types, self.unit.expr_type(arg_expr));
        }
        var fn_name = "";
        if (self.current_function_id != hir_id_invalid()) {
            fn_name = self.unit.function_name(self.current_function_id);
        }
        print("[hir-struct] " + label
              + " fn=" + fn_name
              + " owner=" + owner_text
              + " field=" + field_name
              + " arg=" + self.i32_text(arg_expr)
              + " arg_type=" + arg_text
              + " items=" + self.i32_text(self.unit.item_count)
              + " functions=" + self.i32_text(self.unit.function_count)
              + " locals=" + self.i32_text(self.unit.local_count)
              + " stmts=" + self.i32_text(self.unit.stmt_count)
              + " exprs=" + self.i32_text(self.unit.expr_count)
              + " types=" + self.i32_text(self.unit.types.count));
    }

    fn profile_stmt_trace(self, label: string, s: rawptr, stmt_id: i32) {
        if (vyx_bootstrap_profile_level() <= 2) { return; }
        if (self.unit.expr_count < 2200) { return; }
        var fn_name = "";
        if (self.current_function_id != hir_id_invalid()) {
            fn_name = self.unit.function_name(self.current_function_id);
        }
        var stmt_name = "";
        var kind_text = "0";
        if (s != null) {
            stmt_name = stmt_get_name(s);
            kind_text = self.i32_text(stmt_get_kind(s));
        }
        print("[hir-trace] " + label
              + " fn=" + fn_name
              + " stmt=" + self.i32_text(stmt_id)
              + " ast=" + kind_text
              + " name=" + stmt_name
              + " stmts=" + self.i32_text(self.unit.stmt_count)
              + " exprs=" + self.i32_text(self.unit.expr_count)
              + " types=" + self.i32_text(self.unit.types.count)
              + " open=" + policy_i64_to_string(self.profile_type_open_calls)
              + " resolve=" + policy_i64_to_string(self.profile_resolve_type_calls)
              + " rawclass=" + policy_i64_to_string(self.profile_raw_class_calls)
              + " ensuremeth=" + policy_i64_to_string(self.profile_ensure_method_calls)
              + " methodtarget=" + policy_i64_to_string(self.profile_method_target_calls)
              + " field=" + policy_i64_to_string(self.profile_field_lookup_calls)
              + " fnopen=" + policy_i64_to_string(self.profile_function_open_calls)
              + " typeref=" + policy_i64_to_string(self.profile_type_id_ref_calls)
              + " concrete=" + policy_i64_to_string(self.profile_concrete_type_ref_calls)
              + " typetext=" + policy_i64_to_string(self.profile_type_id_text_calls));
    }

    fn profile_expr_trace(self, label: string, e: rawptr, expr_id: i32) {
        if (vyx_bootstrap_profile_level() <= 2) { return; }
        if (self.unit.expr_count < 2200) { return; }
        var fn_name = "";
        if (self.current_function_id != hir_id_invalid()) {
            fn_name = self.unit.function_name(self.current_function_id);
        }
        var expr_name = "";
        var kind_text = "0";
        var sem_text = "0";
        if (e != null) {
            expr_name = expr_get_name(e);
            kind_text = self.i32_text(expr_get_kind(e));
            sem_text = self.i32_text(expr_get_semantic_kind(e));
        }
        print("[hir-trace] " + label
              + " fn=" + fn_name
              + " expr=" + self.i32_text(expr_id)
              + " ast=" + kind_text
              + " sem=" + sem_text
              + " name=" + expr_name
              + " stmts=" + self.i32_text(self.unit.stmt_count)
              + " exprs=" + self.i32_text(self.unit.expr_count)
              + " types=" + self.i32_text(self.unit.types.count)
              + " open=" + policy_i64_to_string(self.profile_type_open_calls)
              + " resolve=" + policy_i64_to_string(self.profile_resolve_type_calls)
              + " rawclass=" + policy_i64_to_string(self.profile_raw_class_calls)
              + " ensuremeth=" + policy_i64_to_string(self.profile_ensure_method_calls)
              + " methodtarget=" + policy_i64_to_string(self.profile_method_target_calls)
              + " field=" + policy_i64_to_string(self.profile_field_lookup_calls)
              + " fnopen=" + policy_i64_to_string(self.profile_function_open_calls)
              + " typeref=" + policy_i64_to_string(self.profile_type_id_ref_calls)
              + " concrete=" + policy_i64_to_string(self.profile_concrete_type_ref_calls)
              + " typetext=" + policy_i64_to_string(self.profile_type_id_text_calls));
    }

    public fn build(self, unit_ptr: rawptr) {
        self.source_unit = unit_ptr;
        self.profile_build_phase("start");
        self.preindex_raw_type_decls(unit_get_decls(unit_ptr));
        self.register_decl_chain(unit_get_decls(unit_ptr), hir_id_invalid());
        self.profile_build_phase("registered");
        self.build_initializers_for_decl_chain(unit_get_decls(unit_ptr), false);
        self.profile_build_phase("initializers");
        self.materialize_function_roots(unit_ptr);
        self.profile_build_phase("root-functions");
        if (self.lazy_codegen) {
            self.materialize_language_lowering_roots();
            self.profile_build_phase("lazy-language-roots");
            self.materialize_concrete_type_items();
            self.profile_build_phase("lazy-concrete-types");
            self.resolve_deferred_member_exprs();
            self.profile_build_phase("lazy-deferred-members");
            self.finalize_foreign_cpp_metadata();
            self.profile_summary("lazy-build");
            return self.unit;
        }
        self.materialize_reachable_function_bodies();
        self.profile_build_phase("reachable-1");
        self.materialize_language_lowering_roots();
        self.profile_build_phase("language-roots");
        self.materialize_reachable_function_bodies();
        self.profile_build_phase("reachable-2");
        self.materialize_concrete_type_items();
        self.profile_build_phase("concrete-types");
        self.resolve_deferred_member_exprs();
        self.profile_build_phase("deferred-members");
        self.finalize_foreign_cpp_metadata();
        self.finalize_reflection_metadata();
        self.profile_summary("build");
    }

}

fn hir_build_unit(unit_ptr: rawptr) -> HirUnit {
    let builder = HirUnitBuilder.create();
    builder.build(unit_ptr);
    return builder.unit;
}

fn hir_build_unit_for_codegen(unit_ptr: rawptr, export_root_bodies: bool) -> HirUnit {
    var builder = HirUnitBuilder.create();
    builder.export_root_bodies = export_root_bodies;
    builder.materialize_imported_bodies = true;
    builder.lazy_codegen = true;
    builder.build(unit_ptr);
    builder.finalize_codegen_hir();
    return builder.unit;
}

fn hir_build_codegen_builder(unit_ptr: rawptr, export_root_bodies: bool) -> HirUnitBuilder {
    var builder = HirUnitBuilder.create();
    builder.export_root_bodies = export_root_bodies;
    builder.materialize_imported_bodies = true;
    builder.lazy_codegen = true;
    builder.build(unit_ptr);
    if (export_root_bodies) {
        builder.materialize_function_body_for_codegen(hir_id_invalid());
        builder.discard_function_body_after_codegen(hir_id_invalid(), 0, 0, 0);
        builder.discard_function_body_records_after_codegen(hir_id_invalid(), 0, 0, 0);
    }
    return builder;
}

fn hir_build_codegen_builder_with_method_roots(unit_ptr: rawptr,
                                               export_root_bodies: bool,
                                               export_method_roots: bool) -> HirUnitBuilder {
    return hir_build_codegen_builder_with_export_roots(unit_ptr,
                                                       export_root_bodies,
                                                       export_method_roots,
                                                       "",
                                                       false);
}

fn hir_build_codegen_builder_with_export_roots(unit_ptr: rawptr,
                                               export_root_bodies: bool,
                                               export_method_roots: bool,
                                               export_root_names: string,
                                               export_root_names_specified: bool) -> HirUnitBuilder {
    var builder = HirUnitBuilder.create();
    builder.export_root_bodies = export_root_bodies;
    builder.export_method_roots = export_method_roots;
    builder.export_root_names = export_root_names;
    builder.export_root_names_specified = export_root_names_specified;
    builder.materialize_imported_bodies = true;
    builder.lazy_codegen = true;
    builder.build(unit_ptr);
    if (export_root_bodies) {
        builder.materialize_function_body_for_codegen(hir_id_invalid());
        builder.discard_function_body_after_codegen(hir_id_invalid(), 0, 0, 0);
        builder.discard_function_body_records_after_codegen(hir_id_invalid(), 0, 0, 0);
    }
    return builder;
}

fn hir_codegen_builder_handle_alloc(builder: HirUnitBuilder) -> rawptr {
    let handle = malloc(repr_sizeof::<HirUnitBuilder>());
    if (handle == null) { return null; }
    memcpy(handle, to_rawptr(&builder), repr_sizeof::<HirUnitBuilder>());
    return handle;
}

fn hir_codegen_builder_handle_load(handle: rawptr) -> HirUnitBuilder {
    var builder: HirUnitBuilder;
    if (handle == null) {
        return HirUnitBuilder.create();
    }
    memcpy(to_rawptr(&builder), handle, repr_sizeof::<HirUnitBuilder>());
    return builder;
}

fn hir_codegen_builder_handle_store(handle: rawptr, builder: HirUnitBuilder) {
    if (handle == null) { return; }
    memcpy(handle, to_rawptr(&builder), repr_sizeof::<HirUnitBuilder>());
}

public fn hir_build_codegen_builder_handle_with_export_roots(unit_ptr: rawptr,
                                                            export_root_bodies: bool,
                                                            export_method_roots: bool,
                                                            export_root_names: string,
                                                            export_root_names_specified: bool) -> rawptr {
    let builder = hir_build_codegen_builder_with_export_roots(unit_ptr,
                                                              export_root_bodies,
                                                              export_method_roots,
                                                              export_root_names,
                                                              export_root_names_specified);
    return hir_codegen_builder_handle_alloc(builder);
}

public fn hir_codegen_builder_handle_unit(handle: rawptr) -> HirUnit {
    if (handle == null) { return HirUnit.create(); }
    var builder: HirUnitBuilder;
    memcpy(to_rawptr(&builder), handle, repr_sizeof::<HirUnitBuilder>());
    return builder.unit;
}

public fn hir_codegen_builder_handle_set_unit(handle: rawptr, unit: HirUnit) {
    if (handle == null) { return; }
    var builder: HirUnitBuilder;
    memcpy(to_rawptr(&builder), handle, repr_sizeof::<HirUnitBuilder>());
    builder.unit = unit;
    memcpy(handle, to_rawptr(&builder), repr_sizeof::<HirUnitBuilder>());
}

fn hir_build_unit_for_codegen_marked_roots(unit_ptr: rawptr, export_root_bodies: bool) -> HirUnit {
    var builder = HirUnitBuilder.create();
    builder.export_root_bodies = export_root_bodies;
    builder.materialize_imported_bodies = true;
    builder.lazy_codegen = true;
    builder.build(unit_ptr);
    if (export_root_bodies) {
        builder.materialize_function_body_for_codegen(hir_id_invalid());
    }
    builder.materialize_marked_codegen_roots();
    builder.finalize_reflection_metadata();
    return builder.unit;
}

fn hir_codegen_builder_materialize_function_body(builder: HirUnitBuilder, function_id: i32) -> HirUnitBuilder {
    builder.materialize_function_body_for_codegen(function_id);
    return builder;
}

fn hir_codegen_builder_empty() -> HirUnitBuilder {
    return HirUnitBuilder.create();
}

fn hir_codegen_builder_reset_materialization_scoped_caches(builder: HirUnitBuilder) -> HirUnitBuilder {
    builder.reset_materialization_scoped_caches();
    return builder;
}

fn hir_codegen_builder_discard_function_body_records_after_codegen(builder: HirUnitBuilder,
                                                                   function_id: i32,
                                                                   stmt_mark: i32,
                                                                   expr_mark: i32,
                                                                   local_mark: i32) -> HirUnitBuilder {
    builder.discard_function_body_records_after_codegen(function_id, stmt_mark, expr_mark, local_mark);
    return builder;
}

fn hir_codegen_builder_finalize_reflection_metadata(builder: HirUnitBuilder) -> HirUnitBuilder {
    builder.finalize_reflection_metadata();
    return builder;
}

fn hir_codegen_builder_prepare_materialized_facts(builder: HirUnitBuilder, function_id: i32) -> HirUnitBuilder {
    builder.materialize_concrete_type_items_for_function(function_id);
    var changed = builder.resolve_deferred_member_exprs_once();
    var guard: i32 = 0;
    while (changed && guard < 4) {
        builder.materialize_concrete_type_items_for_function(function_id);
        changed = builder.resolve_deferred_member_exprs_once();
        guard = guard + 1;
    }
    return builder;
}

fn hir_codegen_builder_mark_function_body_codegen_done(builder: HirUnitBuilder, function_id: i32) -> HirUnitBuilder {
    if (function_id != hir_id_invalid()) {
        builder.codegen_body_done_ids = hir_int_id_map_put(builder.codegen_body_done_ids,function_id, 1);
        builder.scheduled_function_ids = hir_int_id_map_put(builder.scheduled_function_ids,function_id, 2);
    }
    return builder;
}

fn hir_codegen_builder_release_codegen_state(builder: HirUnitBuilder) -> HirUnitBuilder {
    builder.release_codegen_state();
    return builder;
}

fn hir_codegen_builder_materialize_function_body_ok(builder: HirUnitBuilder, function_id: i32) -> bool {
    return builder.materialize_function_body_for_codegen(function_id);
}

fn hir_codegen_builder_prepare_materialized_facts_inplace(builder: HirUnitBuilder, function_id: i32) {
    builder.materialize_concrete_type_items_for_function(function_id);
    var changed = builder.resolve_deferred_member_exprs_once();
    var guard: i32 = 0;
    while (changed && guard < 4) {
        builder.materialize_concrete_type_items_for_function(function_id);
        changed = builder.resolve_deferred_member_exprs_once();
        guard = guard + 1;
    }
}

public fn hir_codegen_builder_handle_materialize_function_body(handle: rawptr, function_id: i32) -> bool {
    if (handle == null) { return false; }
    var builder: HirUnitBuilder;
    memcpy(to_rawptr(&builder), handle, repr_sizeof::<HirUnitBuilder>());
    builder.materialize_function_body_for_codegen(function_id);
    let ok = builder.unit.function_body(function_id) != hir_id_invalid();
    memcpy(handle, to_rawptr(&builder), repr_sizeof::<HirUnitBuilder>());
    return ok;
}

/// Handled variant of `HirUnitBuilder.function_body_is_recoverable`: the MIR
/// builder owns the HIR builder only through this handle.
public fn hir_codegen_builder_handle_function_body_is_recoverable(handle: rawptr, function_id: i32) -> bool {
    if (handle == null) { return false; }
    var builder: HirUnitBuilder;
    memcpy(to_rawptr(&builder), handle, repr_sizeof::<HirUnitBuilder>());
    return builder.function_body_is_recoverable(function_id);
}

fn hir_codegen_builder_handle_reset_materialization_scoped_caches(handle: rawptr) {
    if (handle == null) { return; }
    var builder = hir_codegen_builder_handle_load(handle);
    builder.reset_materialization_scoped_caches();
    hir_codegen_builder_handle_store(handle, builder);
}

fn hir_codegen_builder_handle_discard_function_body_records_after_codegen(handle: rawptr,
                                                                         function_id: i32,
                                                                         stmt_mark: i32,
                                                                         expr_mark: i32,
                                                                         local_mark: i32) {
    if (handle == null) { return; }
    var builder = hir_codegen_builder_handle_load(handle);
    builder.discard_function_body_records_after_codegen(function_id, stmt_mark, expr_mark, local_mark);
    hir_codegen_builder_handle_store(handle, builder);
}

public fn hir_codegen_builder_handle_finish_function_codegen(handle: rawptr,
                                                             function_id: i32,
                                                             stmt_mark: i32,
                                                             expr_mark: i32,
                                                             local_mark: i32) {
    if (handle == null) { return; }
    var builder: HirUnitBuilder;
    memcpy(to_rawptr(&builder), handle, repr_sizeof::<HirUnitBuilder>());
    if (function_id != hir_id_invalid()
        && builder.unit.function_body(function_id) != hir_id_invalid()) {
        builder.discard_function_body_records_after_codegen(function_id, stmt_mark, expr_mark, local_mark);
        builder.codegen_body_done_ids = hir_int_id_map_put(builder.codegen_body_done_ids,function_id, 1);
        builder.scheduled_function_ids = hir_int_id_map_put(builder.scheduled_function_ids,function_id, 2);
    } else {
        builder.invalidate_materialization_resolution_caches();
    }
    memcpy(handle, to_rawptr(&builder), repr_sizeof::<HirUnitBuilder>());
}

public fn hir_codegen_builder_handle_finalize_reflection_metadata(handle: rawptr) {
    if (handle == null) { return; }
    var builder: HirUnitBuilder;
    memcpy(to_rawptr(&builder), handle, repr_sizeof::<HirUnitBuilder>());
    builder.finalize_reflection_metadata();
    memcpy(handle, to_rawptr(&builder), repr_sizeof::<HirUnitBuilder>());
}

public fn hir_codegen_builder_handle_prepare_materialized_facts(handle: rawptr, function_id: i32) {
    if (handle == null) { return; }
    var builder: HirUnitBuilder;
    memcpy(to_rawptr(&builder), handle, repr_sizeof::<HirUnitBuilder>());
    builder.materialize_concrete_type_items_for_function(function_id);
    var changed = builder.resolve_deferred_member_exprs_once();
    var guard: i32 = 0;
    while (changed && guard < 4) {
        builder.materialize_concrete_type_items_for_function(function_id);
        changed = builder.resolve_deferred_member_exprs_once();
        guard = guard + 1;
    }
    memcpy(handle, to_rawptr(&builder), repr_sizeof::<HirUnitBuilder>());
}

public fn hir_codegen_builder_handle_ensure_concrete_type_text_ready(handle: rawptr, text: string) -> bool {
    if (handle == null || text.len == 0) { return false; }
    var builder: HirUnitBuilder;
    memcpy(to_rawptr(&builder), handle, repr_sizeof::<HirUnitBuilder>());
    let before_items = builder.unit.item_count;
    let before_types = builder.unit.types.count;
    let type_id = builder.ensure_concrete_type_text_ready(text);
    let changed = builder.unit.item_count != before_items || builder.unit.types.count != before_types;
    memcpy(handle, to_rawptr(&builder), repr_sizeof::<HirUnitBuilder>());
    return type_id != hir_id_invalid() || changed;
}

fn hir_codegen_builder_handle_mark_function_body_codegen_done(handle: rawptr, function_id: i32) {
    if (handle == null) { return; }
    var builder = hir_codegen_builder_handle_load(handle);
    if (function_id != hir_id_invalid()) {
        builder.codegen_body_done_ids = hir_int_id_map_put(builder.codegen_body_done_ids,function_id, 1);
        builder.scheduled_function_ids = hir_int_id_map_put(builder.scheduled_function_ids,function_id, 2);
    }
    hir_codegen_builder_handle_store(handle, builder);
}

public fn hir_codegen_builder_handle_release_codegen_state(handle: rawptr) {
    if (handle == null) { return; }
    var builder: HirUnitBuilder;
    memcpy(to_rawptr(&builder), handle, repr_sizeof::<HirUnitBuilder>());
    builder.release_codegen_state();
    memcpy(handle, to_rawptr(&builder), repr_sizeof::<HirUnitBuilder>());
}

public fn hir_codegen_builder_handle_free(handle: rawptr) {
    if (handle == null) { return; }
    free(handle);
}
