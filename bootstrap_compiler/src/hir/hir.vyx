module bootstrap.hir;

/// AST semantic-fact *audit*, not a second HIR.
///
/// The only HIR model is `hir_model.vyx` (stable TypeId / FunctionId /
/// GenericEnvId). This module walks the AST after Sema and checks that
/// expressions have canonical types and call/member facts. It does not
/// allocate HIR records or write CSV generic-env strings.

use bootstrap.ast;
use bootstrap.diag;
use bootstrap.policy;

fn hir_string_contains(hay: string, needle: string) -> bool {
    if (needle.len == 0) { return true; }
    if (hay.len < needle.len) { return false; }
    var i: i32 = 0;
    while (i + needle.len <= hay.len) {
        var j: i32 = 0;
        var same: bool = true;
        while (j < needle.len && same) {
            if (hay.charAt(i + j) != needle.charAt(j)) {
                same = false;
            }
            j = j + 1;
        }
        if (same) { return true; }
        i = i + 1;
    }
    return false;
}

fn hir_decl_marked_imported(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_string_contains(decl_get_meta(d), "|imported");
}

fn hir_decl_has_template_head(d: rawptr) -> bool {
    if (d == null) { return false; }
    let gp = decl_get_generic_params(d);
    if (gp.len == 0) { return false; }
    if (gp.charAt(0) == 124) { return false; }
    return true;
}

fn hir_decl_body_ready(d: rawptr) -> bool {
    if (d == null) { return false; }
    return hir_string_contains(decl_get_meta(d), "|hir_facts_resolved");
}

public class HirFactAudit {
    public expr_count: i32
    public call_count: i32
    public member_count: i32
    public errors: i32
    public print_summary: bool

    public static fn create() -> HirFactAudit {
        return HirFactAudit {
            expr_count: 0,
            call_count: 0,
            member_count: 0,
            errors: 0,
            print_summary: true
        };
    }

    public static fn create_silent() -> HirFactAudit {
        return HirFactAudit {
            expr_count: 0,
            call_count: 0,
            member_count: 0,
            errors: 0,
            print_summary: false
        };
    }

    public fn fail_expr(self, e: rawptr, msg: string) {
        self.errors = self.errors + 1;
        diag_emit_at(diag_sev_ERROR(),
                     diag_code_internal(),
                     expr_loc_ptr(e),
                     "HIR fact audit: " + msg);
        diag_emit_help_at(diag_code_internal(),
                            expr_loc_ptr(e),
                            "this expression is missing a semantic fact; reduce the input or report a compiler bug");
    }

    public fn expr_label(self, e: rawptr) -> string {
        if (e == null) { return "<null>"; }
        let name = expr_get_name(e);
        let kind = policy_i64_to_string(expr_get_kind(e) as i64);
        let sem = policy_i64_to_string(expr_get_semantic_kind(e) as i64);
        let ty = expr_get_ty(e);
        var ty_text = "";
        if (ty != null) {
            let tk = tref_get_kind(ty);
            ty_text = " type_kind=" + policy_i64_to_string(tk as i64);
            if (tk == ty_CLASS()) {
                ty_text = ty_text + " type_name=" + tref_get_name(ty);
            }
        }
        if (name.len > 0) {
            return "kind=" + kind + " name=" + name + " sem=" + sem + ty_text;
        }
        return "kind=" + kind + " sem=" + sem + ty_text;
    }

    public fn expr_has_class_type(self, e: rawptr) -> bool {
        if (e == null) { return false; }
        let ty = expr_get_ty(e);
        if (ty == null) { return false; }
        return tref_get_kind(ty) == ty_CLASS();
    }

    public fn unresolved_member_can_be_resolved_by_hir(self, e: rawptr) -> bool {
        if (e == null || expr_get_kind(e) != ex_MEMBER()) { return false; }
        if (expr_get_ty(e) == null) { return false; }
        return self.expr_has_class_type(expr_get_lhs(e));
    }

    public fn unresolved_call_can_be_resolved_by_hir(self, e: rawptr) -> bool {
        if (e == null || expr_get_kind(e) != ex_CALL()) { return false; }
        let callee = expr_get_lhs(e);
        if (callee == null || expr_get_kind(callee) != ex_MEMBER()) { return false; }
        return self.unresolved_member_can_be_resolved_by_hir(callee);
    }

    public fn check_call_or_member_semantics(self, e: rawptr, kind: i32) {
        let sem = expr_get_semantic_kind(e);
        if (kind == ex_CALL()) {
            self.call_count = self.call_count + 1;
            if (sem == expr_sem_DIRECT_FN()
                || sem == expr_sem_METHOD()
                || sem == expr_sem_VARIANT()
                || sem == expr_sem_BUILTIN()
                || sem == expr_sem_INDIRECT_FN()) {
                return;
            }
            if (self.unresolved_call_can_be_resolved_by_hir(e)) { return; }
            self.fail_expr(e,
                           "call expression has no resolved callee semantic; call="
                           + self.expr_label(e)
                           + " callee="
                           + self.expr_label(expr_get_lhs(e)));
            return;
        }
        if (kind == ex_MEMBER()) {
            self.member_count = self.member_count + 1;
            if (sem == expr_sem_METHOD()
                || sem == expr_sem_FIELD()
                || sem == expr_sem_VARIANT()
                || sem == expr_sem_CLASS()
                || sem == expr_sem_BUILTIN()) {
                return;
            }
            if (self.unresolved_member_can_be_resolved_by_hir(e)) { return; }
            self.fail_expr(e,
                           "member expression has no resolved member semantic; member="
                           + self.expr_label(e)
                           + " receiver="
                           + self.expr_label(expr_get_lhs(e)));
        }
    }

    public fn check_arg_cells(self, head: rawptr) {
        var cur = head;
        while (cur != null) {
            self.check_expr(stmt_get_init(cur));
            cur = stmt_get_next(cur);
        }
    }

    public fn check_stmt_chain(self, head: rawptr) {
        var cur = head;
        while (cur != null) {
            self.check_stmt(cur);
            cur = stmt_get_next(cur);
        }
    }

    public fn check_decl_chain(self, head: rawptr) {
        var cur = head;
        while (cur != null) {
            self.check_decl(cur);
            cur = decl_get_next(cur);
        }
    }

    public fn check_decl(self, d: rawptr) {
        if (d == null) { return; }
        if (hir_decl_marked_imported(d)) { return; }
        let k = decl_get_kind(d);
        if (k == de_FN() || k == de_METHOD()) {
            if (hir_decl_body_ready(d)) {
                self.check_stmt_chain(decl_get_body(d));
            }
            return;
        }
        if (k == de_CONST() || k == de_GLOBAL_VAR()) {
            self.check_stmt_chain(decl_get_body(d));
            return;
        }
        if (k == de_CLASS() || k == de_ENUM()) {
            if (hir_decl_has_template_head(d)) { return; }
            self.check_decl_chain(decl_get_members(d));
        }
    }

    public fn check_stmt(self, s: rawptr) {
        if (s == null) { return; }
        let k = stmt_get_kind(s);
        if (k == st_EXPR()) {
            self.check_expr(stmt_get_init(s));
            return;
        }
        if (k == st_LET() || k == st_VAR() || k == st_RETURN()) {
            self.check_expr(stmt_get_init(s));
            return;
        }
        if (k == st_IF()) {
            self.check_expr(stmt_get_cond(s));
            self.check_stmt(stmt_get_then_blk(s));
            self.check_stmt(stmt_get_else_blk(s));
            return;
        }
        if (k == st_WHILE()) {
            self.check_expr(stmt_get_cond(s));
            self.check_stmt(stmt_get_body(s));
            return;
        }
        if (k == st_BLOCK()) {
            self.check_stmt_chain(stmt_get_body(s));
            return;
        }
        if (k == st_FOR()) {
            self.check_stmt(stmt_get_init(s));
            self.check_expr(stmt_get_cond(s));
            self.check_stmt(stmt_get_body(s));
            self.check_stmt(stmt_get_then_blk(s));
            return;
        }
        if (k == st_FOREACH()) {
            self.check_expr(stmt_get_cond(s));
            self.check_stmt(stmt_get_body(s));
            return;
        }
        if (k == st_MATCH()) {
            self.check_expr(stmt_get_init(s));
            var arm = stmt_get_body(s);
            while (arm != null) {
                self.check_expr(stmt_get_init(arm));
                self.check_expr(stmt_get_cond(arm));
                self.check_stmt(stmt_get_body(arm));
                arm = stmt_get_next(arm);
            }
            return;
        }
        if (k == st_DEFER()) {
            self.check_stmt(stmt_get_init(s));
            return;
        }
        if (k == st_STATIC_ASSERT()) {
            self.check_expr(stmt_get_cond(s));
        }
    }

    public fn check_if_expr(self, e: rawptr) {
        self.check_expr(expr_get_lhs(e));
        self.check_stmt(expr_get_rhs(e));
        let else_part = expr_get_args(e);
        if (else_part == null) { return; }
        if (expr_get_kind(else_part) == ex_IF_EXPR()) {
            self.check_expr(else_part);
        } else {
            self.check_stmt(else_part);
        }
    }

    public fn check_expr(self, e: rawptr) {
        if (e == null) { return; }
        self.expr_count = self.expr_count + 1;
        let k = expr_get_kind(e);
        if (expr_get_ty(e) == null) {
            self.fail_expr(e, "expression has no canonical type (" + self.expr_label(e) + ")");
        }
        self.check_call_or_member_semantics(e, k);

        if (k == ex_BIN() || k == ex_ASSIGN() || k == ex_TERNARY()) {
            self.check_expr(expr_get_lhs(e));
            self.check_expr(expr_get_rhs(e));
            self.check_expr(expr_get_args(e));
            return;
        }
        if (k == ex_UNARY() || k == ex_ADDR_OF() || k == ex_DEREF()
            || k == ex_AWAIT() || k == ex_COMPTIME() || k == ex_FAIL()) {
            self.check_expr(expr_get_lhs(e));
            return;
        }
        if (k == ex_NEW()) {
            self.check_expr(expr_get_lhs(e));
            self.check_expr(expr_get_rhs(e));
            self.check_arg_cells(expr_get_args(e));
            return;
        }
        if (k == ex_DELETE()) {
            self.check_expr(expr_get_lhs(e));
            self.check_expr(expr_get_rhs(e));
            return;
        }
        if (k == ex_CALL()) {
            self.check_expr(expr_get_lhs(e));
            self.check_arg_cells(expr_get_args(e));
            return;
        }
        if (k == ex_MEMBER()) {
            self.check_expr(expr_get_lhs(e));
            return;
        }
        if (k == ex_INDEX()) {
            self.check_expr(expr_get_lhs(e));
            self.check_expr(expr_get_rhs(e));
            return;
        }
        if (k == ex_STRUCT_INIT() || k == ex_FSTRING()
            || k == ex_TUPLE_LIT() || k == ex_INLINE_ASM()) {
            self.check_arg_cells(expr_get_args(e));
            return;
        }
        if (k == ex_ARRAY_LIT()) {
            self.check_arg_cells(expr_get_args(e));
            self.check_expr(expr_get_captures(e));
            return;
        }
        if (k == ex_CLOSURE()) {
            self.check_stmt(expr_get_lhs(e));
            self.check_decl_chain(expr_get_args(e));
            self.check_stmt_chain(expr_get_captures(e));
            return;
        }
        if (k == ex_IF_EXPR()) {
            self.check_if_expr(e);
        }
    }

    public fn run(self, unit: rawptr) -> i32 {
        self.check_decl_chain(unit_get_decls(unit));
        if (self.errors == 0 && self.print_summary) {
            print("[hir-facts] exprs=" + policy_i64_to_string(self.expr_count as i64)
                  + " calls=" + policy_i64_to_string(self.call_count as i64)
                  + " members=" + policy_i64_to_string(self.member_count as i64)
                  + " errors=0");
        }
        return self.errors;
    }
}

public fn hir_verify_semantic_facts(unit: rawptr) -> i32 {
    // The `[hir-facts]` summary is auditing evidence (VYX_PHASE_SUMMARY=1).
    if (!policy_phase_summary_enabled()) {
        return hir_verify_semantic_facts_silent(unit);
    }
    let audit = HirFactAudit.create();
    return audit.run(unit);
}

public fn hir_verify_semantic_facts_silent(unit: rawptr) -> i32 {
    let audit = HirFactAudit.create_silent();
    return audit.run(unit);
}
