module bootstrap.hir_dump;

use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_type_table;
use bootstrap.policy;

public class HirDumper {
    public enabled: bool

    public static fn create() -> HirDumper {
        return HirDumper { enabled: true };
    }

    public fn id_text(self, id: i32) -> string {
        return policy_i64_to_string(id as i64);
    }

    public fn type_text(self, h: HirUnit, id: i32) -> string {
        if (id == hir_id_invalid()) { return "-"; }
        return "#" + self.id_text(id) + ":" + hir_type_table_text(h.types, id);
    }

    public fn dump_types(self, h: HirUnit) {
        let type_count_text = self.id_text(h.types.count);
        print("hir2.types " + type_count_text);
        var id: i32 = 1;
        while (id <= h.types.count) {
            var open_text = "";
            if (hir_type_table_is_open(h.types, id)) { open_text = " open=1"; }
            print("  type #" + self.id_text(id)
                  + " kind=" + self.id_text(hir_type_table_kind(h.types, id))
                  + " flags=" + self.id_text(hir_type_table_flags(h.types, id))
                  + open_text
                  + " text=" + hir_type_table_text(h.types, id));
            id = id + 1;
        }
    }

    public fn type_list_text(self, h: HirUnit, head_id: i32) -> string {
        if (head_id == hir_id_invalid()) { return "-"; }
        var out = "";
        var cur = head_id;
        var guard: i32 = 0;
        let guard_limit: i32 = h.tlist_count + 2;
        while (cur != hir_id_invalid() && guard < guard_limit) {
            if (out.len > 0) { out = out + ","; }
            out = out + "#" + self.id_text(hir_unit_type_list_node_type(h, cur));
            cur = hir_unit_type_list_node_next(h, cur);
            guard = guard + 1;
        }
        if (out.len == 0) { return "-"; }
        return out;
    }

    public fn dump_genvs(self, h: HirUnit) {
        print("hir2.genvs " + self.id_text(h.genv_count));
        var id: i32 = 1;
        while (id <= h.genv_count) {
            print("  genv #" + self.id_text(id)
                  + " params=" + self.type_list_text(h, hir_unit_genv_param_list(h, id))
                  + " args=" + self.type_list_text(h, hir_unit_genv_arg_list(h, id))
                  + " owner=" + self.type_text(h, hir_unit_genv_owner_type(h, id)));
            id = id + 1;
        }
    }

    public fn dump_items(self, h: HirUnit) {
        print("hir2.items " + self.id_text(h.item_count));
        var id: i32 = 1;
        while (id <= h.item_count) {
            var const_value_text = "";
            if (h.item_const_value_state(id) != hir_const_value_none()) {
                const_value_text = " const_value=" + policy_i64_to_string(h.item_const_value_i64(id));
            }
            print("  item #" + self.id_text(id)
                  + " kind=" + self.id_text(h.item_kind(id))
                  + " name=" + h.item_name(id)
                  + " type=" + self.type_text(h, h.item_type(id))
                  + " owner=#" + self.id_text(h.item_owner(id))
                  + " fn=#" + self.id_text(h.item_function(id))
                  + " first_member=#" + self.id_text(h.item_first_member(id))
                  + " field_index=" + self.id_text(h.item_field_index(id))
                  + " variant_tag=" + self.id_text(h.item_variant_tag(id))
                  + " variant_payload_count=" + self.id_text(h.item_variant_payload_count(id))
                  + " variant_payloads=" + h.item_variant_payload_types(id)
                  + " variant_payload_types=" + self.type_list_text(h, h.item_variant_payload_type_list(id))
                  + const_value_text
                  + " init=#" + self.id_text(h.item_init(id))
                  + " next=#" + self.id_text(h.item_next_sibling(id)));
            id = id + 1;
        }
    }

    public fn dump_builtins(self, h: HirUnit) {
        print("hir2.builtins " + self.id_text(h.builtin_count));
        var id: i32 = 1;
        while (id <= h.builtin_count) {
            print("  builtin #" + self.id_text(id)
                  + " name=" + h.builtin_name(id)
                  + " sem=" + self.id_text(h.builtin_sem_kind(id))
                  + " owner_type=" + self.type_text(h, h.builtin_owner_type(id))
                  + " flags=" + self.id_text(h.builtin_flags(id)));
            id = id + 1;
        }
    }

    public fn dump_functions(self, h: HirUnit) {
        print("hir2.functions " + self.id_text(h.function_count));
        var id: i32 = 1;
        while (id <= h.function_count) {
            print("  fn #" + self.id_text(id)
                  + " item=#" + self.id_text(h.function_item(id))
                  + " name=" + h.function_name(id)
                  + " ret=" + self.type_text(h, h.function_return_type(id))
                  + " first_local=#" + self.id_text(h.function_first_local(id))
                  + " local_count=" + self.id_text(h.function_local_count(id))
                  + " body=#" + self.id_text(h.function_body(id))
                  + " stmt_count=" + self.id_text(h.function_stmt_count(id))
                  + " flags=" + self.id_text(h.function_flags(id))
                  + " genv=#" + self.id_text(h.function_generic_env_id(id)));
            id = id + 1;
        }
    }

    public fn dump_locals(self, h: HirUnit) {
        print("hir2.locals " + self.id_text(h.local_count));
        var id: i32 = 1;
        while (id <= h.local_count) {
            print("  local #" + self.id_text(id)
                  + " fn=#" + self.id_text(h.local_function(id))
                  + " name=" + h.local_name(id)
                  + " type=" + self.type_text(h, h.local_type(id))
                  + " flags=" + self.id_text(h.local_flags(id))
                  + " capture_source=#" + self.id_text(h.local_capture_source(id))
                  + " capture_init=#" + self.id_text(h.local_capture_init_expr(id))
                  + " drop_fn=#" + self.id_text(h.local_drop_function(id))
                  + " next=#" + self.id_text(h.local_next(id)));
            id = id + 1;
        }
    }

    public fn dump_stmts(self, h: HirUnit) {
        print("hir2.stmts " + self.id_text(h.stmt_count));
        var id: i32 = 1;
        while (id <= h.stmt_count) {
            print("  stmt #" + self.id_text(id)
                  + " kind=" + self.id_text(h.stmt_kind(id))
                  + " fn=#" + self.id_text(h.stmt_function(id))
                  + " owner_item=#" + self.id_text(h.stmt_owner_item(id))
                  + " name=" + h.stmt_name(id)
                  + " type=" + self.type_text(h, h.stmt_type(id))
                  + " expr=#" + self.id_text(h.stmt_expr(id))
                  + " cond=#" + self.id_text(h.stmt_cond(id))
                  + " child=#" + self.id_text(h.stmt_child(id))
                  + " else=#" + self.id_text(h.stmt_else(id))
                  + " aux=#" + self.id_text(h.stmt_aux(id))
                  + " local=#" + self.id_text(h.stmt_local(id))
                  + " next=#" + self.id_text(h.stmt_next(id)));
            id = id + 1;
        }
    }

    public fn dump_exprs(self, h: HirUnit) {
        print("hir2.exprs " + self.id_text(h.expr_count));
        var id: i32 = 1;
        while (id <= h.expr_count) {
            print("  expr #" + self.id_text(id)
                  + " kind=" + self.id_text(h.expr_kind(id))
                  + " fn=#" + self.id_text(h.expr_function(id))
                  + " owner_item=#" + self.id_text(h.expr_owner_item(id))
                  + " name=" + h.expr_name(id)
                  + " type=" + self.type_text(h, h.expr_type(id))
                  + " sem=" + self.id_text(h.expr_sem_kind(id))
                  + " target_kind=" + self.id_text(h.expr_target_kind(id))
                  + " target=#" + self.id_text(h.expr_target_id(id))
                  + " op=" + self.id_text(h.expr_op(id))
                  + " lhs=#" + self.id_text(h.expr_lhs(id))
                  + " rhs=#" + self.id_text(h.expr_rhs(id))
                  + " aux=#" + self.id_text(h.expr_aux(id))
                  + " stmt_rhs=#" + self.id_text(h.expr_stmt_rhs(id))
                  + " stmt_aux=#" + self.id_text(h.expr_stmt_aux(id))
                  + " first_arg=#" + self.id_text(h.expr_first_arg(id))
                  + " next_arg=#" + self.id_text(h.expr_next_arg(id))
                  + " arg_name=" + h.expr_arg_name(id)
                  + " vc=" + self.id_text(h.expr_value_category(id))
                  + " mvflags=" + self.id_text(h.expr_move_drop_flags(id))
                  + " drop_fn=#" + self.id_text(h.expr_drop_function(id))
                  + " value=" + h.expr_value_text(id));
            id = id + 1;
        }
    }

    public fn run(self, h: HirUnit) {
        let type_count_text = self.id_text(h.types.count);
        print("hir2.unit items=" + self.id_text(h.item_count)
              + " functions=" + self.id_text(h.function_count)
              + " locals=" + self.id_text(h.local_count)
              + " stmts=" + self.id_text(h.stmt_count)
              + " exprs=" + self.id_text(h.expr_count)
              + " types=" + type_count_text
              + " builtins=" + self.id_text(h.builtin_count)
              + " genvs=" + self.id_text(h.genv_count)
              + " tlists=" + self.id_text(h.tlist_count));
        self.dump_types(h);
        self.dump_items(h);
        self.dump_builtins(h);
        self.dump_functions(h);
        self.dump_locals(h);
        self.dump_stmts(h);
        self.dump_exprs(h);
        self.dump_genvs(h);
    }
}

public fn hir_dump_unit(h: HirUnit) {
    let dumper = HirDumper.create();
    dumper.run(h);
}
