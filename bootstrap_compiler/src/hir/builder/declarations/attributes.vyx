module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_binder;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_native_init;
use bootstrap.hir_type_table;
use bootstrap.policy;
use bootstrap.sema;

// Attributes for the HIR builder. See README.md.

fn hir_builder_strip_quotes(s: string) -> string {
    if (s.len >= 2 && s.charAt(0) == 34 && s.charAt(s.len - 1) == 34) {
        return s.substring(1, s.len - 1);
    }
    return s;
}

fn hir_builder_first_string_arg(value: string) -> string {
    var start: i32 = -1;
    var i: i32 = 0;
    while (i < value.len) {
        if (value.charAt(i) == 34) {
            if (start < 0) {
                start = i + 1;
            } else {
                return value.substring(start, i);
            }
        }
        i = i + 1;
    }
    return "";
}

fn hir_builder_line_blob_contains(rows: string, value: string) -> bool {
    let needle = hir_builder_trim(value);
    if (needle.len == 0) { return true; }
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= rows.len) {
        if (i == rows.len || rows.charAt(i) == 10) {
            if (hir_builder_trim(rows.substring(start, i)) == needle) { return true; }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn hir_builder_append_unique_line(rows: string, value: string) -> string {
    let clean = hir_builder_trim(value);
    if (clean.len == 0 || hir_builder_line_blob_contains(rows, clean)) { return rows; }
    if (rows.len == 0) { return clean; }
    return rows + "\n" + clean;
}

fn hir_builder_append_string_args_as_lines(rows: string, value: string) -> string {
    var out = rows;
    var start: i32 = -1;
    var i: i32 = 0;
    while (i < value.len) {
        if (value.charAt(i) == 34) {
            if (start < 0) {
                start = i + 1;
            } else {
                out = hir_builder_append_unique_line(out, value.substring(start, i));
                start = -1;
            }
        }
        i = i + 1;
    }
    return out;
}

fn hir_builder_append_cpp_include_attr_value(rows: string, value: string) -> string {
    var out = hir_builder_append_string_args_as_lines(rows, value);
    if (out != rows) { return out; }
    let clean = hir_builder_trim(hir_builder_strip_quotes(value));
    if (clean.len == 0) { return out; }
    return hir_builder_append_unique_line(out, clean);
}

fn hir_builder_append_cpp_include_attrs(rows: string, d: rawptr) -> string {
    var out = rows;
    var value = hir_builder_decl_attr_value(d, "cpp_include");
    if (value.len > 0) { out = hir_builder_append_cpp_include_attr_value(out, value); }
    value = hir_builder_decl_attr_value(d, "cxx_include");
    if (value.len > 0) { out = hir_builder_append_cpp_include_attr_value(out, value); }
    value = hir_builder_decl_attr_value(d, "include");
    if (value.len > 0) { out = hir_builder_append_cpp_include_attr_value(out, value); }
    return out;
}

fn hir_builder_alias_blob_from_attr(value: string) -> string {
    let alias_pos = hir_builder_index_of(value, "alias=");
    if (alias_pos < 0) { return ""; }
    var i = alias_pos + 6;
    while (i < value.len && value.charAt(i) == 32) { i = i + 1; }
    var out: string = "";
    if (i < value.len && value.charAt(i) == 91) {
        i = i + 1;
        var quote_start: i32 = -1;
        while (i < value.len && value.charAt(i) != 93) {
            let ch = value.charAt(i);
            if (ch == 34) {
                if (quote_start < 0) {
                    quote_start = i + 1;
                } else {
                    if (out.len > 0) { out = out + ","; }
                    out = out + value.substring(quote_start, i);
                    quote_start = -1;
                }
            }
            i = i + 1;
        }
        return out;
    }
    if (i < value.len && value.charAt(i) == 34) {
        return hir_builder_first_string_arg(value.substring(i, value.len));
    }
    return "";
}

fn hir_builder_decl_has_hidden_attr(d: rawptr) -> bool {
    if (d == null) { return false; }
    if (hir_builder_decl_has_exact_attr(d, "hidden")) { return true; }
    if (hir_builder_decl_has_exact_attr(d, "Hidden")) { return true; }
    return hir_builder_decl_has_exact_attr(d, "HIDDEN");
}

fn hir_builder_decl_has_reflect_attr(d: rawptr) -> bool {
    if (d == null) { return false; }
    // Reflection metadata and method roots may only consume an accepted
    // compiler-owned Effect result. Unknown/custom attributes stay inert.
    if (!hir_builder_string_contains(decl_get_meta(d), "|effect:reflect|")) { return false; }
    if (hir_builder_decl_has_exact_attr(d, "reflect")) { return true; }
    if (hir_builder_decl_has_exact_attr(d, "Reflect")) { return true; }
    return hir_builder_decl_has_exact_attr(d, "REFLECT");
}

fn hir_builder_vis_is_space(c: i32) -> bool {
    return c == 32 || c == 9 || c == 10 || c == 13;
}

fn hir_builder_vis_trim(s: string) -> string {
    var start: i32 = 0;
    var end: i32 = s.len as i32;
    while (start < end && hir_builder_vis_is_space(s.charAt(start))) { start = start + 1; }
    while (end > start && hir_builder_vis_is_space(s.charAt(end - 1))) { end = end - 1; }
    if (start == 0 && end == (s.len as i32)) { return s; }
    return s.substring(start, end);
}

fn hir_builder_vis_outer_parens(s: string) -> bool {
    let t = hir_builder_vis_trim(s);
    if (t.len < 2) { return false; }
    if (t.charAt(0) != 40 || t.charAt(t.len - 1) != 41) { return false; }
    var depth: i32 = 0;
    var i: i32 = 0;
    while (i < t.len) {
        let c = t.charAt(i);
        if (c == 40) {
            depth = depth + 1;
        } elif (c == 41) {
            depth = depth - 1;
            if (depth == 0 && i != t.len - 1) { return false; }
        }
        if (depth < 0) { return false; }
        i = i + 1;
    }
    return depth == 0;
}

fn hir_builder_vis_strip_outer_parens(s: string) -> string {
    var out = hir_builder_vis_trim(s);
    var changed: bool = true;
    while (changed && hir_builder_vis_outer_parens(out)) {
        changed = false;
        out = hir_builder_vis_trim(out.substring(1, out.len - 1));
        changed = true;
    }
    return out;
}

fn hir_builder_vis_find_top_addsub(expr: string) -> i32 {
    var depth: i32 = 0;
    var i: i32 = (expr.len - 1) as i32;
    while (i >= 0) {
        let c = expr.charAt(i);
        if (c == 41) { depth = depth + 1; }
        elif (c == 40) { depth = depth - 1; }
        elif (depth == 0 && (c == 43 || c == 45)) { return i; }
        i = i - 1;
    }
    return -1;
}

fn hir_builder_vis_find_top_and(expr: string) -> i32 {
    var depth: i32 = 0;
    var i: i32 = (expr.len - 1) as i32;
    while (i >= 0) {
        let c = expr.charAt(i);
        if (c == 41) { depth = depth + 1; }
        elif (c == 40) { depth = depth - 1; }
        elif (depth == 0 && c == 38) { return i; }
        i = i - 1;
    }
    return -1;
}

fn hir_builder_vis_expr_exports_world(expr_raw: string) -> bool {
    let expr = hir_builder_vis_strip_outer_parens(expr_raw);
    if (expr.len == 0) { return false; }
    let addsub = hir_builder_vis_find_top_addsub(expr);
    if (addsub >= 0) {
        let lhs = hir_builder_vis_expr_exports_world(expr.substring(0, addsub));
        let rhs = hir_builder_vis_expr_exports_world(expr.substring(addsub + 1, expr.len));
        if (expr.charAt(addsub) == 43) { return lhs || rhs; }
        return lhs && !rhs;
    }
    let and_pos = hir_builder_vis_find_top_and(expr);
    if (and_pos >= 0) {
        return hir_builder_vis_expr_exports_world(expr.substring(0, and_pos))
            && hir_builder_vis_expr_exports_world(expr.substring(and_pos + 1, expr.len));
    }
    return expr == "world" || expr == "public";
}

fn hir_builder_decl_visibility_expr(d: rawptr) -> string {
    if (d == null) { return "self"; }
    var expr = hir_builder_decl_attr_value(d, "vis");
    if (expr.len == 0) { expr = hir_builder_decl_attr_value(d, "visibility"); }
    if (expr.len > 0) { return hir_builder_vis_trim(expr); }
    let meta = decl_get_meta(d);
    if (hir_builder_string_contains(meta, "|vis:public")) { return "world"; }
    if (hir_builder_string_contains(meta, "|vis:private")) { return "self"; }
    if (hir_builder_string_contains(meta, "|vis:internal")) { return "package"; }
    if (hir_builder_string_contains(meta, "|vis:protected")) { return "tree"; }
    if (decl_get_is_public(d)) { return "world"; }
    return "self";
}

fn hir_builder_decl_exports_world(d: rawptr) -> bool {
    return hir_builder_vis_expr_exports_world(hir_builder_decl_visibility_expr(d));
}

fn hir_builder_decl_visibility_is_none(d: rawptr) -> bool {
    return hir_builder_vis_strip_outer_parens(hir_builder_decl_visibility_expr(d)) == "none";
}

fn hir_builder_reflect_decl_name(d: rawptr) -> string {
    if (d == null) { return ""; }
    var value = hir_builder_decl_attr_value(d, "reflect");
    if (value.len == 0) { value = hir_builder_decl_attr_value(d, "Reflect"); }
    if (value.len == 0) { return decl_get_name(d); }
    let first_string = hir_builder_first_string_arg(value);
    if (first_string.len > 0) { return first_string; }
    value = hir_builder_strip_quotes(value);
    if (value.len == 0) { return decl_get_name(d); }
    if (hir_builder_index_of(value, "alias=") >= 0 || hir_builder_index_of(value, "visibility=") >= 0) {
        return decl_get_name(d);
    }
    return value;
}

fn hir_builder_reflect_alias_blob(d: rawptr) -> string {
    if (d == null) { return ""; }
    var value = hir_builder_decl_attr_value(d, "reflect");
    if (value.len == 0) { value = hir_builder_decl_attr_value(d, "Reflect"); }
    if (value.len == 0) { return ""; }
    return hir_builder_alias_blob_from_attr(value);
}

fn hir_builder_reflect_attr_visibility(d: rawptr) -> string {
    if (d == null) { return ""; }
    var value = hir_builder_decl_attr_value(d, "reflect");
    if (value.len == 0) { value = hir_builder_decl_attr_value(d, "Reflect"); }
    if (value.len == 0) { return ""; }
    if (hir_builder_index_of(value, "visibility=private") >= 0) { return "private"; }
    if (hir_builder_index_of(value, "visibility=internal") >= 0) { return "internal"; }
    if (hir_builder_index_of(value, "visibility=protected") >= 0) { return "protected"; }
    if (hir_builder_index_of(value, "visibility=public") >= 0) { return "public"; }
    return "";
}
