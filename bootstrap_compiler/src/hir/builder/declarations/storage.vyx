module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_binder;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_native_init;
use bootstrap.hir_type_table;
use bootstrap.policy;
use bootstrap.sema;

// Storage for the HIR builder. See README.md.

impl HirUnitBuilder {
    fn decl_effectively_interface_storage(self, d: rawptr) -> bool {
        if (d == null) { return false; }
        if (hir_builder_string_contains(decl_get_meta(d), "|interface-storage|")) { return true; }
        var owner = hir_raw_owner_map_get(self.decl_owner_map,d);
        while (owner != null) {
            if (hir_builder_string_contains(decl_get_meta(owner), "|interface-storage|")) { return true; }
            owner = hir_raw_owner_map_get(self.decl_owner_map,owner);
        }
        return false;
    }

    fn storage_decl_exports_world(self, d: rawptr) -> bool {
        if (!hir_builder_decl_exports_world(d)) { return false; }
        var owner = hir_raw_owner_map_get(self.decl_owner_map,d);
        while (owner != null) {
            if (!hir_builder_decl_exports_world(owner)) { return false; }
            owner = hir_raw_owner_map_get(self.decl_owner_map,owner);
        }
        return true;
    }

    fn storage_decl_has_template_owner(self, d: rawptr) -> bool {
        var owner = hir_raw_owner_map_get(self.decl_owner_map,d);
        while (owner != null) {
            if (hir_builder_decl_template_head(owner)) { return true; }
            owner = hir_raw_owner_map_get(self.decl_owner_map,owner);
        }
        return false;
    }

    fn apply_storage_item_flags(self, d: rawptr, item_id: i32, closed_instance: bool) {
        let item_kind = self.unit.item_kind(item_id);
        if (item_kind != hir_item_const() && item_kind != hir_item_global()) { return; }
        self.unit.set_item_source_module(item_id, self.decl_source_module(d));
        if (closed_instance && self.storage_decl_has_template_owner(d)) {
            self.unit.add_item_flags(item_id, hir_item_flag_odr_storage());
            return;
        }
        if (self.decl_effectively_imported(d) && self.decl_effectively_interface_storage(d)) {
            let immutable = item_kind == hir_item_const()
                || hir_builder_string_contains(decl_get_generic_params(d), "|kind:let");
            if (immutable && hir_builder_decl_template_artifact(d) && decl_get_body(d) != null
                && !self.storage_decl_has_template_owner(d)) {
                self.unit.add_item_flags(item_id, hir_item_flag_odr_storage());
                return;
            }
            self.unit.add_item_flags(item_id, hir_item_flag_external_storage());
            return;
        }
        // Ordinary source imports and std bodies still materialize lazily.
        // Project-local source siblings belong to this object even though the
        // merged AST marks them imported for name and visibility resolution.
        if (self.decl_is_foreign_import(d)) { return; }
        if (!closed_instance && self.storage_decl_has_template_owner(d)) { return; }
        // A producer interface artifact may instantiate a generic body that
        // uses private storage. Retain that storage in export-object mode too.
        if (self.export_root_bodies || self.storage_decl_exports_world(d)) {
            self.unit.add_item_flags(item_id, hir_item_flag_exported_storage());
        }
    }

    fn build_initializers_for_decl_chain(self, head: rawptr, owner_template: bool) {
        var cur = head;
        while (cur != null) {
            if (self.decl_effectively_imported(cur)) {
                cur = decl_get_next(cur);
                continue;
            }
            let k = decl_get_kind(cur);
            if (k == de_CLASS() || k == de_ENUM()) {
                let templ = owner_template
                    || hir_builder_decl_template_head(cur)
                    || self.decl_members_have_template_type(cur);
                self.build_initializers_for_decl_chain(decl_get_members(cur), templ);
            } else if (k == de_CONST() || k == de_GLOBAL_VAR() || hir_builder_decl_is_assoc_const_member(cur)) {
                let fn_id_saved = self.current_function_id;
                let item_id_saved = self.current_item_id;
                self.current_function_id = hir_id_invalid();
                self.current_item_id = hir_pointer_map_item(self.decl_map,cur);
                let init_chain = self.build_stmt_chain(decl_get_body(cur));
                self.unit.set_item_init(self.current_item_id, init_chain.first);
                self.current_item_id = item_id_saved;
                self.current_function_id = fn_id_saved;
            }
            cur = decl_get_next(cur);
        }
    }
}
