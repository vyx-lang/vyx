module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_binder;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_native_init;
use bootstrap.hir_type_table;
use bootstrap.policy;
use bootstrap.sema;

// String ownership for the HIR builder. See README.md.

impl HirUnitBuilder {
    fn str_return_has_control(self, e: rawptr, depth: i32) -> bool {
        if (e == null) { return false; }
        if (depth > 32) { return true; }
        let kind = expr_get_kind(e);
        if (kind == ex_IF_EXPR() || kind == ex_MATCH_EXPR()) { return true; }
        if (kind == ex_BIN() || kind == ex_ASSIGN() || kind == ex_INDEX()) {
            return self.str_return_has_control(expr_get_lhs(e), depth + 1)
                || self.str_return_has_control(expr_get_rhs(e), depth + 1);
        }
        if (kind == ex_MEMBER() || kind == ex_CAST() || kind == ex_ADDR_OF()
            || kind == ex_DEREF() || kind == ex_UNARY()) {
            return self.str_return_has_control(expr_get_lhs(e), depth + 1);
        }
        if (kind == ex_TERNARY()) {
            return self.str_return_has_control(expr_get_lhs(e), depth + 1)
                || self.str_return_has_control(expr_get_rhs(e), depth + 1)
                || self.str_return_has_control(expr_get_args(e), depth + 1);
        }
        if (kind == ex_CALL() || kind == ex_FSTRING() || kind == ex_STRUCT_INIT()
            || kind == ex_TUPLE_LIT() || kind == ex_ARRAY_LIT()) {
            if (kind == ex_CALL() && self.str_return_has_control(expr_get_lhs(e), depth + 1)) { return true; }
            var arg = expr_get_args(e);
            while (arg != null) {
                if (self.str_return_has_control(stmt_get_init(arg), depth + 1)) { return true; }
                arg = stmt_get_next(arg);
            }
        }
        return false;
    }

    fn primitive_str_init_is_fresh_owned_value(self, init_e: rawptr) -> bool {
        if (init_e == null) { return false; }
        let kind = expr_get_kind(init_e);
        // The primitive ABI carries an explicit allocator-domain tag. Calling
        // str_drop on a literal/view is therefore a no-op, while an
        // interpolated string releases its runtime buffer. Both are safe
        // lexical values; the aliasing gate below remains responsible for
        // rejecting copies of an existing owning local.
        if (kind == ex_STR_LIT() || kind == ex_FSTRING()) { return true; }
        if (kind == ex_BIN() && expr_get_op(init_e) == tk_PLUS()) { return true; }
        if (kind != ex_CALL()) { return false; }
        let callee = expr_get_lhs(init_e);
        if (callee == null) { return false; }
        if (expr_get_kind(callee) == ex_MEMBER()) {
            let name = policy_generic_call_base(expr_get_name(callee));
            return name == "toUpper" || name == "toLower"
                || name == "to_upper" || name == "to_lower"
                || name == "trim" || name == "replace"
                || name == "substring" || name == "repeat"
                || name == "clone";
        }
        if (expr_get_kind(callee) != ex_IDENT()) { return false; }
        let name = policy_generic_call_base(expr_get_name(callee));
        return name == "int_to_string" || name == "bool_to_string"
            || name == "float_to_string" || name == "str_concat"
            || name == "str_dup" || name == "from_cstr_len"
            || name == "readFile";
    }

    // Primitive str values have an explicit ownership tag.  A fresh
    // initializer alone is not enough to schedule str_drop: later code may
    // return a borrowed alias, pass the value to an unknown callee, take its
    // address, aggregate it, or capture it.  Those paths cannot prove that a
    // lexical drop remains valid, so they conservatively reject auto-drop.
    //
    // This is intentionally an AST-side gate while HIR is being materialized.
    // Sema symbols can be rebuilt for a lazy generic body, so the same source
    // binding need not retain pointer identity here. Matching the name makes
    // the proof more conservative under shadowing, never less conservative.
    fn primitive_str_expr_mentions_target(self, e: rawptr, target: string) -> bool {
        if (e == null || target.len == 0) { return false; }
        if (expr_get_kind(e) == ex_IDENT() && expr_get_name(e) == target) {
            return true;
        }
        let k = expr_get_kind(e);
        if (k == ex_BIN() || k == ex_ASSIGN() || k == ex_INDEX()) {
            return self.primitive_str_expr_mentions_target(expr_get_lhs(e), target)
                || self.primitive_str_expr_mentions_target(expr_get_rhs(e), target);
        }
        if (k == ex_UNARY() || k == ex_ADDR_OF() || k == ex_DEREF()
            || k == ex_COMPTIME() || k == ex_FAIL() || k == ex_AWAIT() || k == ex_CAST()
            || k == ex_MEMBER()) {
            return self.primitive_str_expr_mentions_target(expr_get_lhs(e), target);
        }
        if (k == ex_CALL()) {
            return self.primitive_str_expr_mentions_target(expr_get_lhs(e), target)
                || self.primitive_str_stmt_chain_mentions_target(expr_get_args(e), target);
        }
        if (k == ex_STRUCT_INIT() || k == ex_FSTRING() || k == ex_TUPLE_LIT()
            || k == ex_INLINE_ASM()) {
            return self.primitive_str_stmt_chain_mentions_target(expr_get_args(e), target);
        }
        if (k == ex_ARRAY_LIT()) {
            return self.primitive_str_stmt_chain_mentions_target(expr_get_args(e), target)
                || self.primitive_str_expr_mentions_target(expr_get_captures(e), target);
        }
        if (k == ex_TERNARY()) {
            return self.primitive_str_expr_mentions_target(expr_get_lhs(e), target)
                || self.primitive_str_expr_mentions_target(expr_get_rhs(e), target)
                || self.primitive_str_expr_mentions_target(expr_get_args(e), target);
        }
        if (k == ex_CLOSURE()) {
            return self.primitive_str_stmt_chain_mentions_target(expr_get_lhs(e), target)
                || self.primitive_str_stmt_chain_mentions_target(expr_get_captures(e), target);
        }
        if (k == ex_IF_EXPR() || k == ex_MATCH_EXPR()) {
            if (self.primitive_str_expr_mentions_target(expr_get_lhs(e), target)) { return true; }
            if (k == ex_IF_EXPR()) {
                return self.primitive_str_stmt_mentions_target(expr_get_rhs(e), target)
                    || self.primitive_str_stmt_chain_mentions_target(expr_get_args(e), target);
            }
            var match_arm = expr_get_args(e);
            while (match_arm != null) {
                if (self.primitive_str_expr_mentions_target(stmt_get_init(match_arm), target)
                    || self.primitive_str_expr_mentions_target(stmt_get_cond(match_arm), target)
                    || self.primitive_str_stmt_chain_mentions_target(stmt_get_body(match_arm), target)) {
                    return true;
                }
                match_arm = stmt_get_next(match_arm);
            }
            return false;
        }
        return false;
    }

    fn primitive_str_stmt_mentions_target(self, s: rawptr, target: string) -> bool {
        if (s == null || target.len == 0) { return false; }
        let k = stmt_get_kind(s);
        if (k == st_EXPR() || k == st_LET() || k == st_VAR() || k == st_RETURN()) {
            return self.primitive_str_expr_mentions_target(stmt_get_init(s), target);
        }
        if (k == st_BLOCK()) {
            return self.primitive_str_stmt_chain_mentions_target(stmt_get_body(s), target);
        }
        if (k == st_IF()) {
            return self.primitive_str_expr_mentions_target(stmt_get_cond(s), target)
                || self.primitive_str_stmt_mentions_target(stmt_get_then_blk(s), target)
                || self.primitive_str_stmt_mentions_target(stmt_get_else_blk(s), target);
        }
        if (k == st_WHILE() || k == st_FOREACH()) {
            return self.primitive_str_expr_mentions_target(stmt_get_cond(s), target)
                || self.primitive_str_stmt_mentions_target(stmt_get_body(s), target);
        }
        if (k == st_FOR()) {
            return self.primitive_str_stmt_mentions_target(stmt_get_init(s), target)
                || self.primitive_str_expr_mentions_target(stmt_get_cond(s), target)
                || self.primitive_str_stmt_mentions_target(stmt_get_body(s), target)
                || self.primitive_str_stmt_mentions_target(stmt_get_then_blk(s), target);
        }
        if (k == st_MATCH()) {
            return self.primitive_str_expr_mentions_target(stmt_get_init(s), target)
                || self.primitive_str_stmt_chain_mentions_target(stmt_get_body(s), target);
        }
        if (k == st_DEFER()) {
            return self.primitive_str_stmt_mentions_target(stmt_get_init(s), target);
        }
        if (k == st_STATIC_ASSERT()) {
            return self.primitive_str_expr_mentions_target(stmt_get_cond(s), target);
        }
        return false;
    }

    fn primitive_str_stmt_chain_mentions_target(self, head: rawptr, target: string) -> bool {
        var cur = head;
        while (cur != null) {
            if (self.primitive_str_stmt_mentions_target(cur, target)) { return true; }
            cur = stmt_get_next(cur);
        }
        return false;
    }

    fn primitive_str_member_call_is_non_escaping(self, name: string) -> bool {
        let base = policy_generic_call_base(name);
        return base == "len" || base == "length" || base == "size" || base == "count"
            || base == "charAt" || base == "char_at"
            || base == "startsWith" || base == "starts_with"
            || base == "endsWith" || base == "ends_with"
            || base == "contains" || base == "indexOf" || base == "index_of"
            || base == "toUpper" || base == "toLower"
            || base == "to_upper" || base == "to_lower"
            || base == "trim" || base == "replace" || base == "substring"
            || base == "repeat" || base == "clone";
    }

    fn primitive_str_direct_call_is_non_escaping(self, name: string) -> bool {
        let base = policy_generic_call_base(name);
        return base == "str_concat" || base == "str_equals"
            || base == "str_length" || base == "str_trim" || base == "str_replace"
            || base == "str_to_upper" || base == "str_to_lower"
            || base == "str_index_of" || base == "str_starts_with" || base == "str_ends_with"
            || base == "str_drop";
    }

    fn primitive_str_member_call_returns_independent_scalar(self, name: string) -> bool {
        let base = policy_generic_call_base(name);
        return base == "len" || base == "length" || base == "size" || base == "count"
            || base == "charAt" || base == "char_at"
            || base == "startsWith" || base == "starts_with"
            || base == "endsWith" || base == "ends_with"
            || base == "contains" || base == "indexOf" || base == "index_of";
    }

    fn primitive_str_let_init_is_independent(self, init_e: rawptr, target: string) -> bool {
        if (init_e == null || !self.primitive_str_expr_mentions_target(init_e, target)) {
            return true;
        }
        // Fresh string producers copy the source bytes; the new local owns a
        // distinct tagged result and cannot keep the source allocation alive.
        if (self.primitive_str_init_is_fresh_owned_value(init_e)) {
            return !self.primitive_str_expr_has_unsafe_use(init_e, target);
        }
        if (expr_get_kind(init_e) != ex_CALL()) { return false; }
        let callee = expr_get_lhs(init_e);
        if (callee == null || expr_get_kind(callee) != ex_MEMBER()
            || !self.primitive_str_expr_mentions_target(expr_get_lhs(callee), target)
            || !self.primitive_str_member_call_returns_independent_scalar(expr_get_name(callee))) {
            return false;
        }
        return !self.primitive_str_expr_has_unsafe_use(init_e, target);
    }

    // Primitive str arguments to a language free function are borrowed by the
    // calling ABI. A callee that needs to retain bytes must create an explicit
    // owned copy; raw/foreign entrypoints have no such language contract and
    // remain an escape barrier. This admits normal helper calls in a lexical
    // owner proof without treating a return, aggregate, address or indirect
    // call as non-escaping.
    fn primitive_str_language_free_call_borrows_args(self, e: rawptr) -> bool {
        if (e == null || expr_get_kind(e) != ex_CALL()) { return false; }
        let callee = expr_get_lhs(e);
        if (callee == null || expr_get_kind(callee) != ex_IDENT()) { return false; }
        var target = expr_get_semantic_target(callee);
        if (target == null) { target = expr_get_semantic_target(e); }
        if (target == null || decl_get_kind(target) != de_FN()) { return false; }
        return !hir_builder_decl_is_foreign_dci(target);
    }

    fn primitive_str_expr_has_unsafe_use(self, e: rawptr, target: string) -> bool {
        if (!self.primitive_str_expr_mentions_target(e, target)) { return false; }
        let k = expr_get_kind(e);
        if (k == ex_IDENT()) { return false; }
        if (k == ex_BIN()) {
            return self.primitive_str_expr_has_unsafe_use(expr_get_lhs(e), target)
                || self.primitive_str_expr_has_unsafe_use(expr_get_rhs(e), target);
        }
        if (k == ex_ASSIGN()) {
            // `text = text + suffix` is the one reassignment form whose
            // lowering preserves a single ownership slot: it either grows the
            // existing allocation in place or replaces and releases it before
            // storing the new tagged value. Other assignments can copy an
            // external owner into this local and remain rejected.
            let lhs = expr_get_lhs(e);
            let rhs = expr_get_rhs(e);
            if (lhs != null && rhs != null
                && expr_get_kind(lhs) == ex_IDENT()
                && expr_get_name(lhs) == target
                && expr_get_kind(rhs) == ex_BIN()
                && expr_get_op(rhs) == tk_PLUS()
                && expr_get_lhs(rhs) != null
                && expr_get_kind(expr_get_lhs(rhs)) == ex_IDENT()
                && expr_get_name(expr_get_lhs(rhs)) == target
                && !self.primitive_str_expr_mentions_target(expr_get_rhs(rhs), target)) {
                return false;
            }
            // Assigning a fresh concat/transform result to some other owner
            // only reads this local's bytes. The destination receives an
            // independent tagged allocation; a direct `dest = source` copy is
            // not fresh and therefore still fails this gate.
            if (lhs != null && rhs != null
                && !self.primitive_str_expr_mentions_target(lhs, target)
                && self.primitive_str_init_is_fresh_owned_value(rhs)) {
                return self.primitive_str_expr_has_unsafe_use(rhs, target);
            }
            return true;
        }
        if (k == ex_CALL()) {
            let callee = expr_get_lhs(e);
            if (callee == null) { return true; }
            var allowed = self.primitive_str_language_free_call_borrows_args(e);
            if (expr_get_kind(callee) == ex_MEMBER()) {
                if (self.primitive_str_expr_mentions_target(expr_get_lhs(callee), target)) {
                    allowed = self.primitive_str_member_call_is_non_escaping(expr_get_name(callee));
                }
            } else if (!allowed && expr_get_kind(callee) == ex_IDENT()) {
                allowed = self.primitive_str_direct_call_is_non_escaping(expr_get_name(callee));
            }
            if (!allowed) { return true; }
            return self.primitive_str_expr_has_unsafe_use(expr_get_lhs(callee), target)
                || self.primitive_str_stmt_chain_has_unsafe_use(expr_get_args(e), target);
        }
        if (k == ex_MEMBER()) {
            let name = policy_generic_call_base(expr_get_name(e));
            if (name != "len" && name != "length" && name != "size" && name != "count"
                && name != "cap" && name != "owned") { return true; }
            return self.primitive_str_expr_has_unsafe_use(expr_get_lhs(e), target);
        }
        if (k == ex_FSTRING()) {
            return self.primitive_str_stmt_chain_has_unsafe_use(expr_get_args(e), target);
        }
        // Address/raw-pointer extraction, indexing, casts, aggregates, closure
        // capture and branch-result forwarding all need a later ownership
        // proof. They are barriers for this lexical auto-drop contract.
        return true;
    }

    fn primitive_str_stmt_has_unsafe_use(self, s: rawptr, target: string) -> bool {
        if (s == null) { return false; }
        let k = stmt_get_kind(s);
        if (k == st_EXPR()) {
            return self.primitive_str_expr_has_unsafe_use(stmt_get_init(s), target);
        }
        if (k == st_RETURN()) {
            // MIR return lowering deactivates the source local before it emits
            // the function-exit drops. A direct return therefore transfers this
            // local rather than causing a double release. Composite/unknown
            // return expressions still pass through the normal escape gate.
            return self.primitive_str_expr_has_unsafe_use(stmt_get_init(s), target);
        }
        if (k == st_LET() || k == st_VAR()) {
            // Direct copies such as `let alias = owner` remain an escape.
            // Proven fresh string producers and scalar read-only queries do
            // not retain a view into the source allocation.
            return !self.primitive_str_let_init_is_independent(stmt_get_init(s), target);
        }
        if (k == st_IF()) {
            return self.primitive_str_expr_has_unsafe_use(stmt_get_cond(s), target)
                || self.primitive_str_stmt_has_unsafe_use(stmt_get_then_blk(s), target)
                || self.primitive_str_stmt_has_unsafe_use(stmt_get_else_blk(s), target);
        }
        if (k == st_WHILE() || k == st_FOREACH()) {
            return self.primitive_str_expr_has_unsafe_use(stmt_get_cond(s), target)
                || self.primitive_str_stmt_has_unsafe_use(stmt_get_body(s), target);
        }
        if (k == st_FOR()) {
            return self.primitive_str_stmt_has_unsafe_use(stmt_get_init(s), target)
                || self.primitive_str_expr_has_unsafe_use(stmt_get_cond(s), target)
                || self.primitive_str_stmt_has_unsafe_use(stmt_get_body(s), target)
                || self.primitive_str_stmt_has_unsafe_use(stmt_get_then_blk(s), target);
        }
        if (k == st_BLOCK()) {
            return self.primitive_str_stmt_chain_has_unsafe_use(stmt_get_body(s), target);
        }
        if (k == st_MATCH() || k == st_DEFER()) {
            return self.primitive_str_stmt_mentions_target(s, target);
        }
        return false;
    }

    fn primitive_str_stmt_chain_has_unsafe_use(self, head: rawptr, target: string) -> bool {
        var cur = head;
        while (cur != null) {
            if (self.primitive_str_stmt_has_unsafe_use(cur, target)) { return true; }
            cur = stmt_get_next(cur);
        }
        return false;
    }

    fn primitive_str_local_has_proven_non_escaping_uses(self, s: rawptr) -> bool {
        if (s == null) { return false; }
        let target = stmt_get_name(s);
        if (target.len == 0) { return false; }
        return !self.primitive_str_stmt_chain_has_unsafe_use(stmt_get_next(s), target);
    }
}

// Query the retained source AST, not another function's disposable HIR range.
// Unknown or recursive result flows never establish an independent result.
impl HirUnitBuilder {
    fn independent_str_binding(self, first: rawptr, target: rawptr, depth: i32) -> rawptr {
        if (target == null || depth > 32) { return null; }
        var s = first;
        while (s != null) {
            let kind = stmt_get_kind(s);
            if (kind == st_LET() && stmt_get_semantic_kind(s) == expr_sem_LOCAL()
                && stmt_get_semantic_target(s) == target) { return stmt_get_init(s); }
            var found: rawptr = null;
            if (kind == st_BLOCK() || kind == st_WHILE() || kind == st_FOREACH()) {
                found = self.independent_str_binding(stmt_get_body(s), target, depth + 1);
            } else if (kind == st_IF() || kind == st_FOR()) {
                found = self.independent_str_binding(stmt_get_then_blk(s), target, depth + 1);
                if (found == null) { found = self.independent_str_binding(stmt_get_else_blk(s), target, depth + 1); }
            } else if (kind == st_MATCH()) {
                var arm = stmt_get_body(s);
                while (arm != null && found == null) {
                    found = self.independent_str_binding(stmt_get_body(arm), target, depth + 1);
                    arm = stmt_get_next(arm);
                }
            }
            if (found != null) { return found; }
            s = stmt_get_next(s);
        }
        return null;
    }

    fn independent_str_return_expr(self, e: rawptr, body: rawptr, depth: i32) -> bool {
        if (e == null || depth > 32) { return false; }
        if (self.str_return_has_control(e, 0)) { return false; }
        let kind = expr_get_kind(e);
        if (kind == ex_STR_LIT() || kind == ex_FSTRING()) { return true; }
        if (kind == ex_IDENT() && expr_get_semantic_kind(e) == expr_sem_LOCAL()) {
            let init = self.independent_str_binding(body, expr_get_semantic_target(e), 0);
            return init != null && self.independent_str_return_expr(init, body, depth + 1);
        }
        if (kind == ex_BIN() && expr_get_op(e) == tk_PLUS()) {
            let ty = expr_get_ty(e);
            let lhs_ty = expr_get_ty(expr_get_lhs(e));
            let rhs_ty = expr_get_ty(expr_get_rhs(e));
            return ty != null && tref_get_kind(ty) == ty_STRING()
                && lhs_ty != null && tref_get_kind(lhs_ty) == ty_STRING()
                && rhs_ty != null && tref_get_kind(rhs_ty) == ty_STRING();
        }
        if (kind == ex_TERNARY()) {
            return self.independent_str_return_expr(expr_get_rhs(e), body, depth + 1)
                && self.independent_str_return_expr(expr_get_args(e), body, depth + 1);
        }
        if (kind != ex_CALL()) { return false; }
        let callee = expr_get_lhs(e);
        if (callee == null) { return false; }
        let semantic = expr_get_semantic_kind(e);
        if (semantic == expr_sem_BUILTIN()) {
            // These are resolved language builtins, not arbitrary functions
            // whose last name happens to resemble a standard-library API.
            if (expr_get_kind(callee) == ex_IDENT()) {
                return expr_get_name(callee) == "from_cstr_len";
            }
            return expr_get_kind(callee) == ex_MEMBER()
                && policy_string_method_kind(expr_get_name(callee)) == 2;
        }
        if (semantic != expr_sem_DIRECT_FN() && semantic != expr_sem_METHOD()) { return false; }
        let target = expr_get_semantic_target(e);
        if (target == null) { return false; }
        let target_kind = decl_get_kind(target);
        if (target_kind != de_FN() && target_kind != de_METHOD()) { return false; }
        return self.independent_str_return_decl(target, depth + 1);
    }

    // Bits: 1 = at least one return; 2 = a return with unknown/borrowed origin.
    fn independent_str_return_stmts(self, first: rawptr, body: rawptr, depth: i32) -> i32 {
        if (depth > 32) { return 2; }
        var result: i32 = 0;
        var s = first;
        while (s != null) {
            let kind = stmt_get_kind(s);
            if (kind == st_RETURN()) {
                result = result | 1;
                if (!self.independent_str_return_expr(stmt_get_init(s), body, depth + 1)) { return result | 2; }
            } else if (kind == st_BLOCK()) {
                result = result | self.independent_str_return_stmts(stmt_get_body(s), body, depth + 1);
            } else if (kind == st_IF()) {
                result = result | self.independent_str_return_stmts(stmt_get_then_blk(s), body, depth + 1)
                    | self.independent_str_return_stmts(stmt_get_else_blk(s), body, depth + 1);
            } else if (kind == st_WHILE() || kind == st_FOREACH()) {
                result = result | self.independent_str_return_stmts(stmt_get_body(s), body, depth + 1);
            } else if (kind == st_FOR()) {
                result = result | self.independent_str_return_stmts(stmt_get_then_blk(s), body, depth + 1);
            } else if (kind == st_LET() || kind == st_VAR() || kind == st_EXPR()) {
                if (self.str_return_has_control(stmt_get_init(s), 0)) { return result | 2; }
            } else if (kind != st_LET() && kind != st_VAR() && kind != st_EXPR()
                && kind != st_BREAK() && kind != st_CONTINUE() && kind != st_DEFER()) {
                // Do not prove a contract by overlooking an unhandled return
                // carrier, for example a match arm or exception handler.
                return result | 2;
            }
            if ((result & 2) != 0) { return result; }
            s = stmt_get_next(s);
        }
        return result;
    }

    fn independent_str_return_decl(self, d: rawptr, depth: i32) -> bool {
        if (d == null || depth > 32) { return false; }
        let owner = hir_raw_owner_map_get(self.decl_owner_map, d);
        if (hir_builder_generic_param_count(hir_builder_decl_template_params(d)) > 0
            || hir_builder_generic_param_count(hir_builder_decl_template_params(owner)) > 0) { return false; }
        let body_decl = self.raw_function_body_decl_for(d);
        if (body_decl == null) { return false; }
        let body = decl_get_body(body_decl);
        if (body == null) { return false; }
        let facts = self.independent_str_return_stmts(body, body, depth + 1);
        // An implicit tail result is also a return. It cannot be ignored just
        // because another branch already contained an explicit return.
        var tail = body;
        if (stmt_get_kind(tail) == st_BLOCK()) { tail = stmt_get_body(tail); }
        if (tail == null) { return false; }
        while (stmt_get_next(tail) != null) { tail = stmt_get_next(tail); }
        if (stmt_get_kind(tail) == st_EXPR()) {
            return (facts & 2) == 0
                && self.independent_str_return_expr(stmt_get_init(tail), body, depth + 1);
        }
        return facts == 1;
    }

    fn function_returns_independent_str(self, function_id: i32) -> bool {
        return self.function_returns_independent_str_depth(function_id, 0);
    }

    fn function_returns_independent_str_depth(self, function_id: i32, depth: i32) -> bool {
        if (function_id == hir_id_invalid() || depth > 32
            || hir_type_table_kind(self.unit.types, self.unit.function_return_type(function_id)) != ty_STRING()) { return false; }
        if ((self.unit.function_flags(function_id) & hir_function_flag_independent_str_return()) != 0) { return true; }
        let source = self.function_body_source_decl(null, function_id);
        var independent = false;
        let owner = hir_raw_owner_map_get(self.decl_owner_map, source);
        if (hir_builder_generic_param_count(hir_builder_decl_template_params(source)) == 0
            && hir_builder_generic_param_count(hir_builder_decl_template_params(owner)) == 0) {
            independent = self.independent_str_return_decl(source, 0);
        }
        if (!independent) { independent = self.independent_str_hir_body(function_id, source, depth + 1); }
        // A lazy concrete callee may not have been emitted yet. Resolve one
        // linear return chain for its contract, retaining only signature facts
        // and releasing each completed body. Do not drain its dependency queue
        // or mark it code-generated: ordinary streaming still owns emission.
        let attempted: i32 = 33554432;
        if (!independent && self.unit.function_body(function_id) == hir_id_invalid()
            && !self.function_body_codegen_is_done(function_id)
            && (self.unit.function_flags(function_id) & attempted) == 0
            && self.independent_str_linear_source(source)) {
            self.unit.add_function_flags(function_id, attempted);
            let stmt_mark = self.unit.stmt_count;
            let expr_mark = self.unit.expr_count;
            let local_mark = self.unit.local_count;
            self.build_reachable_function_body_now(source, function_id, false);
            independent = self.independent_str_hir_body(function_id, source, depth + 1);
            self.discard_function_body_records_after_codegen(function_id, stmt_mark, expr_mark, local_mark);
            self.invalidate_materialization_resolution_caches();
        }
        if (!independent) { return false; }
        self.unit.add_function_flags(function_id, hir_function_flag_independent_str_return());
        return true;
    }

    // Closed generic bodies are already resolved while their caller is built.
    // Read that live range only; never rebuild a discarded body for this proof.
    fn independent_str_hir_expr(self, e: i32, first: i32, depth: i32) -> bool {
        if (e == hir_id_invalid() || depth > 32) { return false; }
        let kind = self.unit.expr_kind(e);
        if (kind == ex_STR_LIT() || kind == ex_FSTRING()) { return true; }
        if (kind == ex_IDENT() && self.unit.expr_target_kind(e) == hir_target_local()) {
            var s = first;
            while (s != hir_id_invalid()) {
                if (self.unit.stmt_kind(s) == hir_stmt_let()
                    && self.unit.stmt_local(s) == self.unit.expr_target_id(e)) {
                    return self.independent_str_hir_expr(self.unit.stmt_expr(s), first, depth + 1);
                }
                s = self.unit.stmt_next(s);
            }
            return false;
        }
        if (kind == ex_BIN() && self.unit.expr_op(e) == tk_PLUS()) {
            return hir_type_table_kind(self.unit.types, self.unit.expr_type(self.unit.expr_lhs(e))) == ty_STRING()
                && hir_type_table_kind(self.unit.types, self.unit.expr_type(self.unit.expr_rhs(e))) == ty_STRING();
        }
        if (kind != ex_CALL()) { return false; }
        let callee = self.unit.expr_lhs(e);
        var target_kind = self.unit.expr_target_kind(e);
        var target = self.unit.expr_target_id(e);
        if (target_kind == hir_target_none()) {
            target_kind = self.unit.expr_target_kind(callee);
            target = self.unit.expr_target_id(callee);
        }
        if (target_kind == hir_target_builtin()) {
            if (self.unit.expr_kind(callee) == ex_MEMBER()) {
                return hir_type_table_kind(self.unit.types, self.unit.expr_type(self.unit.expr_lhs(callee))) == ty_STRING()
                    && policy_string_method_kind(self.unit.expr_name(callee)) == 2;
            }
            return self.unit.builtin_name(target) == "from_cstr_len";
        }
        return target_kind == hir_target_function()
            && self.function_returns_independent_str_depth(target, depth + 1);
    }

    fn independent_str_linear_source(self, source: rawptr) -> bool {
        var raw = decl_get_body(source);
        if (raw == null) { return false; }
        if (stmt_get_kind(raw) == st_BLOCK()) { raw = stmt_get_body(raw); }
        while (raw != null && stmt_get_next(raw) != null) {
            let kind = stmt_get_kind(raw);
            if ((kind != st_LET() && kind != st_VAR() && kind != st_EXPR())
                || self.str_return_has_control(stmt_get_init(raw), 0)) { return false; }
            raw = stmt_get_next(raw);
        }
        return raw != null && (stmt_get_kind(raw) == st_RETURN() || stmt_get_kind(raw) == st_EXPR())
            && !self.str_return_has_control(stmt_get_init(raw), 0);
    }

    fn independent_str_hir_body(self, function_id: i32, source: rawptr, depth: i32) -> bool {
        if (depth > 32 || !self.independent_str_linear_source(source)) { return false; }
        var stmt = self.unit.function_body(function_id);
        if (stmt == hir_id_invalid()) { return false; }
        if (self.unit.stmt_kind(stmt) == hir_stmt_block()) { stmt = self.unit.stmt_child(stmt); }
        let first = stmt;
        if (stmt == hir_id_invalid()) { return false; }
        while (self.unit.stmt_next(stmt) != hir_id_invalid()) { stmt = self.unit.stmt_next(stmt); }
        if (self.unit.stmt_kind(stmt) != hir_stmt_return() && self.unit.stmt_kind(stmt) != hir_stmt_expr()) { return false; }
        return self.independent_str_hir_expr(self.unit.stmt_expr(stmt), first, depth + 1);
    }
}

public fn hir_codegen_builder_handle_function_returns_independent_str(handle: rawptr, function_id: i32) -> bool {
    if (handle == null) { return false; }
    var builder = hir_codegen_builder_handle_load(handle);
    let result = builder.function_returns_independent_str(function_id);
    hir_codegen_builder_handle_store(handle, builder);
    return result;
}

public fn hir_codegen_builder_handle_function_source_path(handle: rawptr, function_id: i32) -> str {
    if (handle == null) { return ""; }
    var builder = hir_codegen_builder_handle_load(handle);
    let source = builder.function_body_source_decl(null, function_id);
    return hir_builder_decl_source_path(source);
}
