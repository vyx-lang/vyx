module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_binder;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_native_init;
use bootstrap.hir_type_table;
use bootstrap.policy;
use bootstrap.sema;

// Builtins for the HIR builder. See README.md.

impl HirUnitBuilder {
    fn note_reflection_builtin_use(self, name: string) {
        let base = policy_generic_call_base(name.clone());
        if (base == "reflect_manifest"
            || base == "getType"
            || base == "reflect_method_value"
            || base == "reflect_method_ptr_by_id") {
            self.reflection_manifest_required = true;
            self.reflection_name_map_required = true;
            return;
        }
        if (base == "reflect_name") {
            self.reflection_name_map_required = true;
        }
    }

    fn builtin_name_recognized(self, name: string) -> bool {
        let base = policy_generic_call_base(name.clone());
        if (self.builtin_string_constructor_name_recognized(base)) { return true; }
        if (base == "panic") { return true; }
        if (base == "assert" || base == "assert_eq") { return true; }
        if (base == "sizeof") { return true; }
        if (base == "repr_sizeof") { return true; }
        if (base == "alignof") { return true; }
        if (base == "construct") { return true; }
        if (base == "typeof") { return true; }
        if (base == "typeinfo") { return true; }
        if (base == "type_name") { return true; }
        if (base == "reflect_manifest") { return true; }
        if (base == "reflect_name") { return true; }
        if (base == "reflect_method_ptr_by_id") { return true; }
        if (base == "reflect_method_value") { return true; }
        if (base == "field_count") { return true; }
        if (base == "field_name") { return true; }
        if (base == "field_type") { return true; }
        if (base == "hash") { return true; }
        if (base == "operator_eq" || base == "operator==") { return true; }
        if (base == "compare") { return true; }
        if (base == "argCount") { return true; }
        if (base == "getArg") { return true; }
        if (base == "to_rawptr") { return true; }
        if (base == "ptr_offset") { return true; }
        if (base == "ptr_read_u8" || base == "ptr_read_i32" || base == "ptr_read_i64") { return true; }
        if (base == "ptr_write_i32" || base == "ptr_write_i64") { return true; }
        if (base == "malloc" || base == "free" || base == "realloc" || base == "alloc" || base == "dealloc") { return true; }
        if (base == "memcpy" || base == "memmove" || base == "memset" || base == "memcmp" || base == "strlen") { return true; }
        if (base == "transmute") { return true; }
        if (base == "print" || base == "println") { return true; }
        if (base == "format") { return true; }
        if (base == "int_to_string" || base == "bool_to_string") { return true; }
        return false;
    }

    fn builtin_type_id_for_name(self, name: string) -> i32 {
        let base = policy_generic_call_base(name.clone());
        self.note_reflection_builtin_use(base);
        if (base == "hash" || base == "sizeof" || base == "repr_sizeof") {
            return self.type_id_from_text("i64");
        }
        if (base == "alignof") {
            return self.type_id_from_text("i64");
        }
        if (base == "construct") {
            let type_args = policy_generic_call_args(name.clone());
            let target_type = policy_generic_arg_at(type_args, 0);
            if (target_type.len > 0) {
                return self.type_id_from_text(self.resolve_type_text_in_current_env(target_type));
            }
            return hir_id_invalid();
        }
        if (base == "typeof" || base == "typeinfo" || base == "type_name"
            || base == "reflect_manifest" || base == "reflect_name") {
            return self.builtin_str_type_id();
        }
        if (base == "field_count") {
            return self.type_id_from_text("i32");
        }
        if (base == "field_name" || base == "field_type") {
            return self.builtin_str_type_id();
        }
        if (base == "reflect_method_value") {
            let value_type = self.reflect_method_value_type_id_from_name(name);
            if (value_type != hir_id_invalid()) { return value_type; }
            return self.type_id_from_text("rawptr");
        }
        if (base == "reflect_method_ptr_by_id") {
            return self.type_id_from_text("rawptr");
        }
        if (base == "operator_eq" || base == "operator==") {
            return self.type_id_from_text("bool");
        }
        if (base == "compare") {
            return self.type_id_from_text("i32");
        }
        if (base == "argCount") {
            return self.type_id_from_text("i32");
        }
        if (base == "getArg") {
            return self.builtin_str_type_id();
        }
        if (base == "assert" || base == "assert_eq") {
            return self.unit.types.intern_type_ref(null);
        }
        if (base == "format") {
            return self.builtin_str_type_id();
        }
        if (base == "int_to_string" || base == "bool_to_string") {
            return self.builtin_str_type_id();
        }
        if (base == "to_rawptr" || base == "ptr_offset" || base == "malloc" || base == "realloc"
            || base == "alloc" || base == "transmute" || base == "memmove" || base == "memset") {
            return self.type_id_from_text("rawptr");
        }
        if (base == "free" || base == "dealloc" || base == "memcpy" || base == "ptr_write_i32" || base == "ptr_write_i64") {
            return self.unit.types.intern_type_ref(null);
        }
        if (base == "strlen") {
            return self.type_id_from_text("i64");
        }
        if (base == "memcmp") {
            return self.type_id_from_text("i32");
        }
        if (base == "ptr_read_u8") {
            return self.type_id_from_text("i32");
        }
        if (base == "ptr_read_i32") {
            return self.type_id_from_text("i32");
        }
        if (base == "ptr_read_i64") {
            return self.type_id_from_text("i64");
        }
        if (self.builtin_string_constructor_name_recognized(base)) {
            return self.builtin_str_type_id();
        }
        let string_member_type = self.string_builtin_member_type_id(base);
        if (string_member_type != hir_id_invalid()) { return string_member_type; }
        return self.unit.types.intern_type_ref(null);
    }

    fn builtin_call_result_type_id(self, callee_expr_id: i32) -> i32 {
        if (callee_expr_id == hir_id_invalid()) { return hir_id_invalid(); }
        let raw_name = self.unit.expr_name(callee_expr_id);
        let base = policy_generic_call_base(raw_name.clone());
        if (base == "new") {
            if (self.unit.expr_target_kind(callee_expr_id) == hir_target_builtin()) {
                let builtin_id = self.unit.expr_target_id(callee_expr_id);
                let owner_type_id = self.unit.builtin_owner_type(builtin_id);
                if (self.type_id_is_valid(owner_type_id)) { return owner_type_id; }
            }
            let callee_type = self.unit.expr_type(callee_expr_id);
            if (self.type_id_is_valid(callee_type)) {
                let callee_kind = hir_type_table_kind(self.unit.types, callee_type);
                if (callee_kind == ty_FN() || callee_kind == ty_CFN()) {
                    let return_type = hir_type_table_elem(self.unit.types, callee_type);
                    if (self.type_id_is_valid(return_type)) { return return_type; }
                }
            }
        }
        return self.builtin_type_id_for_name(raw_name);
    }

    fn builtin_string_constructor_name_recognized(self, name: string) -> bool {
        let base = policy_generic_call_base(name.clone());
        if (base == "from_cstr") { return true; }
        if (base == "from_cstr_len") { return true; }
        if (base == "from_cstr_view_len") { return true; }
        if (base == "from_raw_string_parts") { return true; }
        return false;
    }

    fn string_builtin_member_type_id(self, name: string) -> i32 {
        let base = policy_generic_call_base(name.clone());
        if (base == "ptr" || base == "c_str" || base == "data") {
            return self.type_id_from_text("rawptr");
        }
        if (base == "len" || base == "length" || base == "size" || base == "cap" || base == "owned") {
            return self.type_id_from_text("i64");
        }
        let smk = policy_string_method_kind(base);
        if (smk == 9) {
            return self.type_id_from_text("i64");
        }
        if (smk == 1 || smk == 15) {
            return self.type_id_from_text("rawptr");
        }
        if (smk == 2 || smk == 4 || smk == 5 || smk == 6
            || smk == 7 || smk == 8 || smk == 16 || smk == 17) {
            return self.builtin_str_type_id();
        }
        if (smk == 3) {
            return self.type_id_from_text("i32");
        }
        if (smk == 10 || smk == 11 || smk == 12 || smk == 13 || smk == 14) {
            return self.type_id_from_text("bool");
        }
        if (base == "find" || base == "indexOf" || base == "index_of") {
            return self.type_id_from_text("i64");
        }
        return hir_id_invalid();
    }

    fn type_text_is_builtin_str(self, text: string) -> bool {
        let base = hir_builder_type_base_name(text);
        return hir_builder_is_primitive_str_name(base);
    }

    fn resolve_string_builtin_member_expr(self,
                                                 expr_id: i32,
                                                 owner_type_name: string,
                                                 member_name: string) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        if (!self.type_text_is_builtin_str(owner_type_name)) { return false; }
        let member_type = self.string_builtin_member_type_id(member_name);
        if (member_type == hir_id_invalid()) { return false; }
        let owner_type_id = self.type_id_from_text(owner_type_name);
        let builtin_id = self.unit.add_or_get_builtin(member_name,
                                                     expr_sem_BUILTIN(),
                                                     owner_type_id,
                                                     0);
        self.unit.set_expr_type(expr_id, member_type);
        self.unit.set_expr_semantic(expr_id, expr_sem_BUILTIN(), hir_target_builtin(), builtin_id);
        return true;
    }

    fn primitive_builtin_member_type_id(self, owner_type_name: string, member_name: string) -> i32 {
        if (owner_type_name.len == 0 || member_name.len == 0) { return hir_id_invalid(); }
        let owner_base = hir_builder_type_base_name(owner_type_name);
        let prim_kind = policy_primitive_type_kind(owner_base);
        if (prim_kind == 0) { return hir_id_invalid(); }
        let member_base = policy_generic_call_base(member_name.clone());
        if (member_base == "toString" || member_base == "to_string") {
            return self.builtin_str_type_id();
        }
        return hir_id_invalid();
    }

    fn resolve_primitive_builtin_member_expr(self,
                                                    expr_id: i32,
                                                    owner_type_name: string,
                                                    member_name: string) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        let member_type = self.primitive_builtin_member_type_id(owner_type_name, member_name);
        if (member_type == hir_id_invalid()) { return false; }
        let owner_type_id = self.type_id_from_text(owner_type_name);
        let builtin_id = self.unit.add_or_get_builtin(policy_generic_call_base(member_name.clone()),
                                                     expr_sem_BUILTIN(),
                                                     owner_type_id,
                                                     0);
        self.unit.set_expr_type(expr_id, member_type);
        self.unit.set_expr_semantic(expr_id, expr_sem_BUILTIN(), hir_target_builtin(), builtin_id);
        return true;
    }

    fn tuple_member_type_id(self, owner_type_id: i32, member_name: string) -> i32 {
        if (!self.type_id_is_valid(owner_type_id) || member_name.len == 0) { return hir_id_invalid(); }
        if (hir_type_table_kind(self.unit.types, owner_type_id) != ty_TUPLE()) { return hir_id_invalid(); }
        let idx = hir_builder_tuple_member_index(member_name);
        if (idx < 0) { return hir_id_invalid(); }
        let text = hir_type_table_text(self.unit.types, owner_type_id);
        if (text.len < 2 || text.charAt(0) != 40 || text.charAt(text.len - 1) != 41) {
            return hir_id_invalid();
        }
        let inner = text.substring(1, text.len - 1);
        let elem_text = policy_generic_arg_at(inner, idx);
        if (elem_text.len == 0) { return hir_id_invalid(); }
        return self.type_id_from_text(elem_text);
    }

    fn resolve_tuple_builtin_member_expr(self,
                                                expr_id: i32,
                                                owner_type_id: i32,
                                                member_name: string) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        let member_type = self.tuple_member_type_id(owner_type_id, member_name);
        if (member_type == hir_id_invalid()) { return false; }
        let builtin_id = self.unit.add_or_get_builtin(member_name,
                                                     expr_sem_BUILTIN(),
                                                     owner_type_id,
                                                     0);
        self.unit.set_expr_type(expr_id, member_type);
        self.unit.set_expr_semantic(expr_id, expr_sem_BUILTIN(), hir_target_builtin(), builtin_id);
        return true;
    }
}
