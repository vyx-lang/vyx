module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_binder;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_native_init;
use bootstrap.hir_type_table;
use bootstrap.policy;
use bootstrap.sema;

// Statements for the HIR builder. See README.md.

impl HirUnitBuilder {
    fn build_stmt_chain(self, head: rawptr) -> HirStmtChain {
        var out = HirStmtChain.empty();
        var cur = head;
        let timing_enabled = hir_builder_env_enabled("VYX_HIR_STMT_TIMING");
        let timing_threshold = hir_builder_slow_stmt_threshold_ms();
        while (cur != null) {
            var timing_start: i64 = 0;
            if (timing_enabled) { timing_start = vyx_bootstrap_now_ms(); }
            let stmt_id = self.build_stmt(cur);
            if (timing_enabled) {
                let timing_elapsed = vyx_bootstrap_now_ms() - timing_start;
                if (timing_elapsed >= timing_threshold) {
                    var fn_name = "";
                    if (self.current_function_id != hir_id_invalid()) {
                        fn_name = self.unit.function_name(self.current_function_id);
                    }
                    print("[hir-stmt-timing] fn=" + fn_name
                          + " elapsed=" + policy_i64_to_string(timing_elapsed)
                          + " kind=" + self.i32_text(stmt_get_kind(cur))
                          + " name=" + stmt_get_name(cur)
                          + " line=" + self.i32_text(stmt_loc_line(cur))
                          + " col=" + self.i32_text(stmt_loc_col(cur))
                          + " stmt_id=" + self.i32_text(stmt_id)
                          + " stmts=" + self.i32_text(self.unit.stmt_count)
                          + " exprs=" + self.i32_text(self.unit.expr_count));
                }
            }
            if (stmt_id != hir_id_invalid()) {
                if (out.first == hir_id_invalid()) {
                    out.first = stmt_id;
                }
                if (out.last != hir_id_invalid()) {
                    self.unit.set_stmt_next(out.last, stmt_id);
                }
                out.last = stmt_id;
                var next_count: i32 = out.count;
                next_count = next_count + 1;
                out.count = next_count;
            }
            cur = stmt_get_next(cur);
        }
        return out;
    }

    fn type_id_has_open_template_atom(self, type_id: i32) -> bool {
        if (!self.type_id_is_valid(type_id)) { return false; }
        return self.type_text_has_open_template_atom(hir_type_table_text(self.unit.types, type_id));
    }

    fn closed_expr_type_for_local(self, expr_id: i32) -> i32 {
        if (expr_id == hir_id_invalid()) { return hir_id_invalid(); }
        if (self.unit.expr_target_kind(expr_id) == hir_target_field()) {
            let field_id = self.unit.expr_target_id(expr_id);
            let field_type = self.unit.item_type(field_id);
            if (self.type_id_is_valid(field_type)
                && !self.type_id_has_open_template_atom(field_type)) {
                return field_type;
            }
        }
        if (self.unit.expr_kind(expr_id) == ex_CALL()) {
            let callee_expr_id = self.unit.expr_lhs(expr_id);
            if (callee_expr_id != hir_id_invalid()
                && self.unit.expr_kind(callee_expr_id) == ex_MEMBER()
                && self.method_name_is_value_assign(self.unit.expr_name(callee_expr_id))) {
                let direct_text = hir_type_table_text(self.unit.types, self.unit.expr_type(expr_id));
                if (direct_text.len == 0 || direct_text == "void") {
                    let receiver_expr_id = self.unit.expr_lhs(callee_expr_id);
                    let receiver_type = self.unit.expr_type(receiver_expr_id);
                    if (self.type_id_is_valid(receiver_type)
                        && !self.type_id_has_open_template_atom(receiver_type)) {
                        return receiver_type;
                    }
                }
            }
        }
        let direct_type = self.unit.expr_type(expr_id);
        if (self.type_id_is_valid(direct_type) && !self.type_id_has_open_template_atom(direct_type)) {
            return direct_type;
        }
        if (self.unit.expr_target_kind(expr_id) == hir_target_function()) {
            let fn_id = self.unit.expr_target_id(expr_id);
            let ret_type = self.unit.function_return_type(fn_id);
            if (self.type_id_is_valid(ret_type) && !self.type_id_has_open_template_atom(ret_type)) {
                return ret_type;
            }
        }
        return direct_type;
    }

    fn add_local_from_stmt(self, stmt_id: i32, s: rawptr, init_expr_id: i32) {
        let name = stmt_get_name(s);
        var type_id = self.type_id_from_ref(stmt_get_ty(s));
        // A generic body is built again for each closed instance.  Locals
        // declared as `T` must use that concrete type here; keeping the open
        // template atom suppresses ownership/drop metadata and leaks nested
        // owners such as Box<Ref<U>>.
        let declared_type = stmt_get_ty(s);
        if (declared_type != null) {
            let concrete_text = self.type_text_from_ref_env(declared_type,
                                                             self.current_generic_params,
                                                             self.current_generic_args);
            if (concrete_text.len > 0 && !self.type_text_has_open_template_atom(concrete_text)) {
                type_id = self.type_id_from_text(concrete_text);
            }
        }
        if (init_expr_id != hir_id_invalid()) {
            let init_type = self.closed_expr_type_for_local(init_expr_id);
            if (type_id == hir_id_invalid()) {
                type_id = init_type;
            } else if (init_type != hir_id_invalid()
                       && self.unit.expr_sem_kind(init_expr_id) == expr_sem_BUILTIN()) {
                // A builtin whose recorded type is still void (e.g. a pointer
                // method resolved late in sema) must not clobber the declared
                // local type.
                if (hir_type_table_kind(self.unit.types, init_type) != ty_VOID()) {
                type_id = init_type;
                }
            }
        }
        var local_flags: i32 = 0;
        if ((stmt_get_semantic_flags(s) & stmt_flag_volatile_local()) != 0) {
            // `let volatile x = ...;` / `var volatile x = ...;`: carry the
            // qualifier into the HIR local record so MIR and both backends
            // see it through the shared flags word.
            local_flags = local_flags | hir_local_flag_volatile();
        }
        var can_auto_drop = self.local_type_id_should_auto_drop(type_id);
        if (hir_type_table_kind(self.unit.types, type_id) == ty_STRING()) {
            let non_escaping = self.primitive_str_local_has_proven_non_escaping_uses(s);
            can_auto_drop = non_escaping && self.primitive_str_init_is_fresh_owned_value(stmt_get_init(s));
            if (non_escaping && !can_auto_drop && !self.local_stmt_is_raw_copy_view(s, name)) {
                local_flags = local_flags | hir_builder_pending_str_drop_flag();
            }
        }
        if (can_auto_drop
            && !self.local_stmt_is_raw_copy_view(s, name)) {
            local_flags = local_flags | hir_local_flag_auto_drop();
        }
        let local_id = self.unit.add_local(self.current_function_id, name, type_id, local_flags);
        if ((local_flags & hir_local_flag_auto_drop()) != 0) { self.set_local_drop_for_type(local_id, type_id); }
        self.unit.set_stmt_local(stmt_id, local_id);
        self.locals = hir_local_scope_push(self.locals,
                             name,
                             local_id,
                             type_id,
                             self.current_function_id,
                             stmt_get_semantic_target(s));
    }

    fn foreach_pack_name(self, s: rawptr) -> string {
        if (s == null || stmt_get_kind(s) != st_FOREACH()) { return ""; }
        let cond = stmt_get_cond(s);
        if (cond == null || expr_get_kind(cond) != ex_IDENT()) { return ""; }
        let pack_name = expr_get_name(cond);
        // A local declared inside the function can shadow a pack parameter.
        // Pack elements have distinct locals; a lexical local with the pack
        // name denotes an ordinary collection, not the argument expansion.
        if (self.active_value_pack_binding(pack_name) == null) { return ""; }
        return pack_name;
    }

    fn set_hir_stmt_loc_from_ast(self, stmt_id: i32, s: rawptr) {
        if (stmt_id == hir_id_invalid() || s == null) { return; }
        self.unit.set_stmt_loc(stmt_id,
                              stmt_loc_line(s),
                              stmt_loc_col(s),
                              stmt_loc_end_line(s),
                              stmt_loc_end_col(s));
    }

    fn set_hir_expr_loc_from_ast(self, expr_id: i32, e: rawptr) {
        if (expr_id == hir_id_invalid() || e == null) { return; }
        self.unit.set_expr_loc(expr_id,
                              expr_loc_line(e),
                              expr_loc_col(e),
                              expr_loc_end_line(e),
                              expr_loc_end_col(e));
    }

    fn build_pack_foreach_stmt(self, s: rawptr, pack_name: string) -> i32 {
        if (pack_name.len == 0) { return hir_id_invalid(); }
        let stmt_id = self.unit.add_stmt(self.current_function_id,
                                        hir_stmt_block(),
                                        "",
                                        hir_id_invalid());
        self.set_hir_stmt_loc_from_ast(stmt_id, s);
        self.unit.set_stmt_owner_item(stmt_id, self.current_item_id);
        var first_stmt = hir_id_invalid();
        var last_stmt = hir_id_invalid();
        let pack_count = hir_pack_bindings_count(self.pack_bindings, pack_name);
        var index: i32 = 0;
        while (index < pack_count) {
            let local_id = hir_pack_bindings_local_at(self.pack_bindings, pack_name, index);
            if (local_id != hir_id_invalid()) {
                let saved_each = self.locals.head;
                self.locals = hir_local_scope_push(self.locals,
                                     stmt_get_name(s),
                                     local_id,
                                     self.unit.local_type(local_id),
                                     self.current_function_id,
                                     stmt_get_semantic_target(s));
                let body_stmt = self.build_stmt(stmt_get_body(s));
                self.locals = hir_local_scope_drop_to(self.locals, saved_each);
                if (body_stmt != hir_id_invalid()) {
                    if (first_stmt == hir_id_invalid()) {
                        first_stmt = body_stmt;
                    }
                    if (last_stmt != hir_id_invalid()) {
                        self.unit.set_stmt_next(last_stmt, body_stmt);
                    }
                    last_stmt = body_stmt;
                }
            }
            index = index + 1;
        }
        self.unit.set_stmt_child(stmt_id, first_stmt);
        return stmt_id;
    }

    fn foreach_iter_type_id_from_cond(self, cond_expr_id: i32) -> i32 {
        if (cond_expr_id == hir_id_invalid()) { return hir_id_invalid(); }
        if (self.unit.expr_target_kind(cond_expr_id) == hir_target_builtin()
            && (self.unit.expr_name(cond_expr_id) == "fields"
                || self.unit.expr_name(cond_expr_id) == "methods")) {
            return self.builtin_i64_type_id();
        }
        if (self.unit.expr_kind(cond_expr_id) == ex_BIN()) {
            let op = self.unit.expr_op(cond_expr_id);
            if (op == tk_DOTDOT() || op == tk_DOTDOTEQ()) {
                return self.builtin_i64_type_id();
            }
        }
        var collection_type = self.foreach_collection_type_id(self.unit.expr_type(cond_expr_id));
        if (!self.type_id_is_valid(collection_type)) { return hir_id_invalid(); }
        let collection_kind = hir_type_table_kind(self.unit.types, collection_type);
        if (collection_kind == ty_STRING()) { return self.type_id_from_text("char"); }
        if (collection_kind == ty_RANGE()) { return self.builtin_i64_type_id(); }
        if (collection_kind == ty_ARRAY()) {
            let elem_type = hir_type_table_elem(self.unit.types, collection_type);
            if (self.type_id_is_valid(elem_type)) { return elem_type; }
        }
        var collection_text = hir_type_table_text(self.unit.types, collection_type);
        self.ensure_concrete_type_text_ready(collection_text);
        // A closed instance may omit source attributes. Read the provider
        // role from the template declaration selected for this exact type.
        var owner = self.raw_template_class_decl_for_type_text(collection_text);
        if (owner == null) { owner = self.raw_class_decl_for_type_text(collection_text); }
        if (vyx_bootstrap_profile_level() > 2) {
            var provider_meta = "";
            if (owner != null) { provider_meta = decl_get_meta(owner); }
            print("[hir-foreach-type] collection=" + collection_text + " provider=" + provider_meta);
        }
        if (owner != null && policy_strip_quoted_string(hir_builder_decl_attr_value(owner, "lang_item")) == "vec") {
            let get_fn = self.ensure_method_instance_for_type_text(collection_text, "get");
            if (get_fn != hir_id_invalid()) { return self.unit.function_return_type(get_fn); }
            return hir_id_invalid();
        }
        if ((hir_type_table_flags(self.unit.types, collection_type) & hir_type_flag_std_string()) != 0) {
            let iter_fn = self.ensure_method_instance_for_type_text(collection_text, "iter");
            if (iter_fn == hir_id_invalid()) { return hir_id_invalid(); }
            collection_type = self.unit.function_return_type(iter_fn);
            collection_text = hir_type_table_text(self.unit.types, collection_type);
        }
        let next_fn = self.ensure_method_instance_for_type_text(collection_text, "next");
        if (next_fn != hir_id_invalid()) {
            let option_type = self.unit.function_return_type(next_fn);
            self.ensure_concrete_type_text_ready(hir_type_table_text(self.unit.types, option_type));
            if ((hir_type_table_flags(self.unit.types, option_type) & hir_type_flag_std_option()) != 0) {
                let item = policy_generic_arg_at(policy_generic_call_args(hir_type_table_text(self.unit.types, option_type)), 0);
                if (item.len > 0) { return self.type_id_from_text(item); }
            }
        }
        return hir_id_invalid();
    }

    fn foreach_collection_type_id(self, type_id: i32) -> i32 {
        var current = type_id;
        var depth: i32 = 0;
        while (self.type_id_is_valid(current) && depth <= self.unit.types.count) {
            let kind = hir_type_table_kind(self.unit.types, current);
            if (kind != ty_REF() && kind != ty_MUTREF()) { return current; }
            current = hir_type_table_elem(self.unit.types, current);
            depth = depth + 1;
        }
        return hir_id_invalid();
    }

    fn foreach_protocol_decl_in_tree(self, owner: rawptr, name: string, source: i32, depth: i32) -> rawptr {
        if (owner == null || depth > 32) { return null; }
        var selected: rawptr = null;
        var member = decl_get_members(owner);
        while (member != null) {
            var parameter = decl_get_params(member);
            if (parameter != null && decl_get_name(parameter) == "self") { parameter = decl_get_next(parameter); }
            if (decl_get_kind(member) == de_METHOD() && decl_get_name(member) == name
                && hir_builder_method_decl_matches_static_use(member, false) && parameter == null) {
                if (selected != null && selected != member) {
                    diag_emit_at(diag_sev_ERROR(), diag_code_sema_no_overload(), self.unit.expr_loc_ptr(source),
                        "ambiguous receiver-only iteration method `" + name + "`");
                    return null;
                }
                selected = member;
            }
            member = decl_get_next(member);
        }
        if (selected != null) { return selected; }
        var index: i32 = 0;
        while (index < 16) {
            let parent = self.class_nth_layout_parent(owner, index);
            if (parent == null) { break; }
            let inherited = self.foreach_protocol_decl_in_tree(parent, name, source, depth + 1);
            if (inherited != null) {
                if (selected != null && selected != inherited) {
                    diag_emit_at(diag_sev_ERROR(), diag_code_sema_no_overload(), self.unit.expr_loc_ptr(source),
                        "ambiguous inherited iteration method `" + name + "`");
                    return null;
                }
                selected = inherited;
            }
            index += 1;
        }
        return selected;
    }

    fn receiver_only_protocol_target(self, type_id: i32, name: string, source: i32) -> i32 {
        let text = hir_type_table_text(self.unit.types, self.foreach_collection_type_id(type_id));
        self.ensure_concrete_type_text_ready(text);
        var owner = self.raw_class_decl_for_type_text(text);
        if (owner == null) { owner = self.raw_template_class_decl_for_type_text(text); }
        var declaration = self.foreach_protocol_decl_in_tree(owner, name, source, 0);
        let primitive = policy_primitive_type_kind(text);
        let receiver_kind = hir_type_table_kind(self.unit.types, self.foreach_collection_type_id(type_id));
        if (primitive != 0) {
            // Primitive impl owners are separate declaration records, not a
            // nominal class tree. Resolve by primitive type identity and the
            // complete receiver-only shape, never by a first name match.
            declaration = null;
            var item: i32 = 1;
            while (item <= self.unit.item_count) {
                if (self.unit.item_kind(item) == hir_item_method() && self.unit.item_name(item) == name) {
                    let method = hir_pointer_map_raw_for_item(self.decl_map, item);
                    let owner_item = self.unit.item_owner(item);
                    var parameter = decl_get_params(method);
                    if (parameter != null && decl_get_name(parameter) == "self") { parameter = decl_get_next(parameter); }
                    if (owner_item != hir_id_invalid()
                        && hir_type_table_kind(self.unit.types, self.unit.item_type(owner_item)) == receiver_kind
                        && !decl_get_is_static(method) && parameter == null) {
                        if (declaration != null && declaration != method) {
                            diag_emit_at(diag_sev_ERROR(), diag_code_sema_no_overload(), self.unit.expr_loc_ptr(source),
                                "ambiguous receiver-only primitive protocol method `" + name + "`");
                            return hir_id_invalid();
                        }
                        declaration = method;
                    }
                }
                item += 1;
            }
        }
        if (declaration == null) { return hir_id_invalid(); }
        if (primitive != 0) {
            let direct = hir_pointer_map_function(self.decl_map, declaration);
            if (direct != hir_id_invalid() && !self.function_has_open_template_types(direct)) {
                self.ensure_reachable_function_body_by_id(direct);
                return direct;
            }
        }
        let function = self.ensure_method_instance_for_call_at(text, name, null, hir_id_invalid(),
            declaration, false, source);
        if (function == hir_id_invalid()) { return function; }
        let item = self.unit.function_item(function);
        let function_owner = self.unit.item_owner(item);
        if (self.function_has_open_template_types(function)
            || (function_owner != hir_id_invalid() && self.unit.item_kind(function_owner) == hir_item_interface())) {
            diag_emit_at(diag_sev_ERROR(), diag_code_sema_no_overload(), self.unit.expr_loc_ptr(source),
                "iteration protocol requires a concrete receiver-only implementation of `" + name + "`");
            return hir_id_invalid();
        }
        if (name == "has_next" && hir_type_table_kind(self.unit.types, self.unit.function_return_type(function)) != ty_BOOL()) {
            diag_emit_at(diag_sev_ERROR(), diag_code_sema_type_mismatch(), self.unit.expr_loc_ptr(source),
                "iterator has_next() must return bool");
            return hir_id_invalid();
        }
        return function;
    }

    fn foreach_iter_type_id_from_stmt(self, stmt_id: i32) -> i32 {
        let next = self.unit.stmt_next_function(stmt_id);
        if (next != hir_id_invalid()) {
            let option = self.unit.function_return_type(next);
            self.ensure_concrete_type_text_ready(hir_type_table_text(self.unit.types, option));
            if ((hir_type_table_flags(self.unit.types, option) & hir_type_flag_std_option()) != 0) {
                let element = policy_generic_arg_at(policy_generic_call_args(hir_type_table_text(self.unit.types, option)), 0);
                return self.type_id_from_text(element);
            }
        }
        return self.foreach_iter_type_id_from_cond(self.unit.stmt_cond(stmt_id));
    }

    fn ensure_foreach_iterator_method_instances(self, iterator_type_id: i32, stmt_id: i32) {
        let collection = self.unit.stmt_cond(stmt_id);
        if (self.unit.expr_kind(collection) == ex_BIN()
            && (self.unit.expr_op(collection) == tk_DOTDOT() || self.unit.expr_op(collection) == tk_DOTDOTEQ())) {
            // A direct range is a language loop, not a nominal iterator.
            return;
        }
        iterator_type_id = self.foreach_collection_type_id(iterator_type_id);
        if (!self.type_id_is_valid(iterator_type_id)) { return; }
        let iterator_kind = hir_type_table_kind(self.unit.types, iterator_type_id);
        let iterator_text = hir_type_table_text(self.unit.types, iterator_type_id);
        if (iterator_kind == ty_ARRAY()) {
            var element = hir_type_table_elem(self.unit.types, iterator_type_id);
            var depth: i32 = 0;
            while (hir_type_table_kind(self.unit.types, element) == ty_ARRAY() && depth <= self.unit.types.count) {
                element = hir_type_table_elem(self.unit.types, element);
                depth += 1;
            }
            if (hir_type_table_kind(self.unit.types, element) == ty_CLASS()
                || hir_type_table_kind(self.unit.types, element) == ty_STRING()) {
                let clone = self.receiver_only_protocol_target(element, "clone", self.unit.stmt_cond(stmt_id));
                self.unit.set_stmt_iteration_functions(stmt_id, 0, 0, 0, clone);
            }
            return;
        }
        if (iterator_kind == ty_STRING()
            || (hir_type_table_flags(self.unit.types, iterator_type_id)
                & (hir_type_flag_std_string() | hir_type_flag_std_vec())) != 0) {
            let iter_fn = self.receiver_only_protocol_target(iterator_type_id, "iter", self.unit.stmt_cond(stmt_id));
            if (iter_fn != hir_id_invalid()) {
                let returned_iterator = self.unit.function_return_type(iter_fn);
                let has_next = self.receiver_only_protocol_target(returned_iterator, "has_next", self.unit.stmt_cond(stmt_id));
                let next = self.receiver_only_protocol_target(returned_iterator, "next", self.unit.stmt_cond(stmt_id));
                self.unit.set_stmt_iteration_functions(stmt_id, iter_fn, next, has_next, 0);
            }
            return;
        }
        if (iterator_kind != ty_CLASS()) { return; }
        let iterator_type = iterator_text;
        if (iterator_type.len == 0 || self.type_text_has_open_template_atom(iterator_type)) { return; }
        let has_next = self.receiver_only_protocol_target(iterator_type_id, "has_next", self.unit.stmt_cond(stmt_id));
        let next = self.receiver_only_protocol_target(iterator_type_id, "next", self.unit.stmt_cond(stmt_id));
        self.unit.set_stmt_iteration_functions(stmt_id, 0, next, has_next, 0);
        if (next == hir_id_invalid()) {
            diag_emit_at(diag_sev_ERROR(), diag_code_sema_no_overload(), self.unit.expr_loc_ptr(self.unit.stmt_cond(stmt_id)),
                "iteration requires a receiver-only next() returning Option<T>");
        }
    }

    fn build_stmt(self, s: rawptr) -> i32 {
        if (s == null) { return hir_id_invalid(); }
        let ast_kind = stmt_get_kind(s);
        if (ast_kind == st_FOREACH()) {
            let pack_name = self.foreach_pack_name(s);
            if (pack_name.len > 0) {
                return self.build_pack_foreach_stmt(s, pack_name);
            }
        }
        let hir_kind = hir_builder_stmt_kind_from_ast(ast_kind);
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-stmt-enter] kind=" + self.i32_text(ast_kind)
                  + " name=" + stmt_get_name(s)
                  + " fn=" + self.i32_text(self.current_function_id)
                  + " stmts=" + self.i32_text(self.unit.stmt_count)
                  + " exprs=" + self.i32_text(self.unit.expr_count)
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        let type_id = self.type_id_from_ref(stmt_get_ty(s));
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-stmt-type] kind=" + self.i32_text(ast_kind)
                  + " name=" + stmt_get_name(s)
                  + " type=" + self.i32_text(type_id)
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        let stmt_id = self.unit.add_stmt(self.current_function_id, hir_kind, stmt_get_name(s), type_id);
        self.set_hir_stmt_loc_from_ast(stmt_id, s);
        self.unit.set_stmt_owner_item(stmt_id, self.current_item_id);
        self.profile_stmt_trace("stmt", s, stmt_id);
        if (ast_kind == st_EXPR()) {
            self.unit.set_stmt_expr(stmt_id, self.build_expr(stmt_get_init(s)));
            return stmt_id;
        }
        if (ast_kind == st_LET() || ast_kind == st_VAR()) {
            let init_expr = stmt_get_init(s);
            let init_expr_id = self.build_expr(init_expr);
            if (self.type_id_is_valid(type_id)) {
                self.resolve_expected_variant_expr(init_expr_id, type_id);
                self.apply_expected_expr_type(init_expr_id, type_id);
            }
            self.unit.set_stmt_expr(stmt_id, init_expr_id);
            self.add_local_from_stmt(stmt_id, s, init_expr_id);
            return stmt_id;
        }
        if (ast_kind == st_RETURN()) {
            let ret_expr_id = self.build_expr(stmt_get_init(s));
            let return_type = self.unit.function_return_type(self.current_function_id);
            self.resolve_expected_variant_expr(ret_expr_id, return_type);
            self.apply_expected_expr_type(ret_expr_id, return_type);
            self.unit.set_stmt_expr(stmt_id, ret_expr_id);
            return stmt_id;
        }
        if (ast_kind == st_IF()) {
            self.unit.set_stmt_cond(stmt_id, self.build_expr(stmt_get_cond(s)));
            let saved_then = self.locals.head;
            self.unit.set_stmt_child(stmt_id, self.build_stmt(stmt_get_then_blk(s)));
            self.locals = hir_local_scope_drop_to(self.locals, saved_then);
            let saved_else = self.locals.head;
            self.unit.set_stmt_else(stmt_id, self.build_stmt(stmt_get_else_blk(s)));
            self.locals = hir_local_scope_drop_to(self.locals, saved_else);
            return stmt_id;
        }
        if (ast_kind == st_WHILE()) {
            self.unit.set_stmt_cond(stmt_id, self.build_expr(stmt_get_cond(s)));
            let saved = self.locals.head;
            self.unit.set_stmt_child(stmt_id, self.build_stmt(stmt_get_body(s)));
            self.locals = hir_local_scope_drop_to(self.locals, saved);
            return stmt_id;
        }
        if (ast_kind == st_BLOCK()) {
            let saved_block = self.locals.head;
            let chain = self.build_stmt_chain(stmt_get_body(s));
            self.unit.set_stmt_child(stmt_id, chain.first);
            self.locals = hir_local_scope_drop_to(self.locals, saved_block);
            if ((stmt_get_semantic_flags(s) & stmt_flag_unsafe_block()) != 0) {
                // `unsafe { ... }`: the block's aux slot is unused for plain
                // blocks, so it carries the unsafe marker into MIR building.
                self.unit.set_stmt_aux(stmt_id, stmt_flag_unsafe_block());
            }
            return stmt_id;
        }
        if (ast_kind == st_FOR()) {
            let saved_for = self.locals.head;
            self.unit.set_stmt_child(stmt_id, self.build_stmt(stmt_get_init(s)));
            self.unit.set_stmt_cond(stmt_id, self.build_expr(stmt_get_cond(s)));
            self.unit.set_stmt_aux(stmt_id, self.build_stmt(stmt_get_then_blk(s)));
            self.unit.set_stmt_else(stmt_id, self.build_stmt(stmt_get_body(s)));
            self.locals = hir_local_scope_drop_to(self.locals, saved_for);
            return stmt_id;
        }
        if (ast_kind == st_FOREACH()) {
            let saved_each = self.locals.head;
            let cond_expr_id = self.build_expr(stmt_get_cond(s));
            self.unit.set_stmt_cond(stmt_id, cond_expr_id);
            if (vyx_bootstrap_profile_level() > 2) {
                print("[hir-foreach-cond] expr=" + self.i32_text(cond_expr_id)
                    + " type=" + self.i32_text(self.unit.expr_type(cond_expr_id)));
            }
            self.ensure_foreach_iterator_method_instances(self.unit.expr_type(cond_expr_id), stmt_id);
            var iter_type = self.foreach_iter_type_id_from_stmt(stmt_id);
            if (!self.type_id_is_valid(iter_type)) { iter_type = type_id; }
            let local_id = self.unit.add_local(self.current_function_id, stmt_get_name(s), iter_type, 0);
            self.set_foreach_local_drop(local_id, iter_type, cond_expr_id);
            self.unit.set_stmt_local(stmt_id, local_id);
            self.locals = hir_local_scope_push(self.locals,
                                 stmt_get_name(s),
                                 local_id,
                                 iter_type,
                                 self.current_function_id,
                                 stmt_get_semantic_target(s));
            self.unit.set_stmt_child(stmt_id, self.build_stmt(stmt_get_body(s)));
            self.locals = hir_local_scope_drop_to(self.locals, saved_each);
            return stmt_id;
        }
        if (ast_kind == st_MATCH()) {
            let scrutinee_expr = self.build_expr(stmt_get_init(s));
            self.unit.set_stmt_expr(stmt_id, scrutinee_expr);
            let scrutinee_type = self.unit.expr_type(scrutinee_expr);
            var arm = stmt_get_body(s);
            var first_arm = hir_id_invalid();
            var last_arm = hir_id_invalid();
            while (arm != null) {
                let saved_arm = self.locals.head;
                let arm_stmt = self.unit.add_stmt(self.current_function_id, hir_stmt_expr(), "", hir_id_invalid());
                self.set_hir_stmt_loc_from_ast(arm_stmt, arm);
                self.unit.set_stmt_owner_item(arm_stmt, self.current_item_id);
                let pat = stmt_get_init(arm);
                self.push_pattern_binds_for_type(pat, scrutinee_type, self.match_subject_owns_payload(scrutinee_expr));
                let pat_expr = self.build_expr(pat);
                self.resolve_expected_variant_expr(pat_expr, scrutinee_type);
                self.refresh_deferred_match_pattern_bind_types(pat_expr, scrutinee_type,
                    self.match_subject_owns_payload(scrutinee_expr));
                self.unit.set_stmt_expr(arm_stmt, pat_expr);
                self.unit.set_stmt_cond(arm_stmt, self.build_expr(stmt_get_cond(arm)));
                self.unit.set_stmt_child(arm_stmt, self.build_stmt(stmt_get_body(arm)));
                self.locals = hir_local_scope_drop_to(self.locals, saved_arm);
                if (first_arm == hir_id_invalid()) {
                    first_arm = arm_stmt;
                }
                if (last_arm != hir_id_invalid()) {
                    self.unit.set_stmt_next(last_arm, arm_stmt);
                }
                last_arm = arm_stmt;
                arm = stmt_get_next(arm);
            }
            self.unit.set_stmt_child(stmt_id, first_arm);
            return stmt_id;
        }
        if (ast_kind == st_DEFER()) {
            self.unit.set_stmt_child(stmt_id, self.build_stmt(stmt_get_init(s)));
            return stmt_id;
        }
        if (ast_kind == st_STATIC_ASSERT()) {
            self.unit.set_stmt_cond(stmt_id, self.build_expr(stmt_get_cond(s)));
            return stmt_id;
        }
        return stmt_id;
    }
}
