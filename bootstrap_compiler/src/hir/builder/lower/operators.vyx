module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_binder;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_native_init;
use bootstrap.hir_type_table;
use bootstrap.policy;
use bootstrap.sema;

// Operators for the HIR builder. See README.md.

impl HirUnitBuilder {
    fn type_id_is_valid(self, type_id: i32) -> bool {
        // Reject nonpositive IDs before indexing the HIR type table.
        return type_id > hir_id_invalid() && type_id <= self.unit.types.count;
    }

    fn type_id_has_template_atom(self, type_id: i32) -> bool {
        if (!self.type_id_is_valid(type_id)) { return false; }
        return self.type_text_has_open_template_atom(hir_type_table_text(self.unit.types, type_id));
    }

    fn expr_type_needs_concrete(self, expr_id: i32) -> bool {
        if (expr_id == hir_id_invalid()) { return false; }
        let type_id = self.unit.expr_type(expr_id);
        return !self.type_id_is_valid(type_id) || self.type_id_has_template_atom(type_id);
    }

    fn set_expr_type_if_empty(self, expr_id: i32, type_id: i32) {
        if (expr_id == hir_id_invalid() || !self.type_id_is_valid(type_id)) { return; }
        if (!self.type_id_is_valid(self.unit.expr_type(expr_id))) {
            self.unit.set_expr_type(expr_id, type_id);
        }
    }

    fn set_expr_type_canonical(self, expr_id: i32, type_id: i32) {
        if (expr_id == hir_id_invalid() || !self.type_id_is_valid(type_id)) { return; }
        self.unit.set_expr_type(expr_id, type_id);
    }

    fn builtin_bool_type_id(self) -> i32 {
        return self.type_id_from_text("bool");
    }

    fn builtin_i32_type_id(self) -> i32 {
        return self.type_id_from_text("i32");
    }

    fn builtin_i64_type_id(self) -> i32 {
        return self.type_id_from_text("i64");
    }

    fn builtin_f32_type_id(self) -> i32 {
        return self.type_id_from_text("f32");
    }

    fn builtin_f64_type_id(self) -> i32 {
        return self.type_id_from_text("f64");
    }

    fn builtin_str_type_id(self) -> i32 {
        return self.type_id_from_text("str");
    }

    fn builtin_char_type_id(self) -> i32 {
        return self.type_id_from_text("char");
    }

    fn builtin_rawptr_type_id(self) -> i32 {
        return self.type_id_from_text("rawptr");
    }

    fn resolve_literal_expr_type_after_create(self, expr_id: i32, kind: i32) {
        if (kind == ex_INT_LIT()) {
            if (hir_builder_lit_is_float(self.unit.expr_value_text(expr_id))) {
                self.set_expr_type_if_empty(expr_id, self.builtin_f64_type_id());
                return;
            }
            self.set_expr_type_if_empty(expr_id, self.builtin_i64_type_id());
            return;
        }
        if (kind == ex_BOOL_LIT()) {
            self.set_expr_type_if_empty(expr_id, self.builtin_bool_type_id());
            return;
        }
        if (kind == ex_STR_LIT() || kind == ex_FSTRING()) {
            self.set_expr_type_if_empty(expr_id, self.builtin_str_type_id());
            return;
        }
        if (kind == ex_CHAR_LIT()) {
            self.set_expr_type_if_empty(expr_id, self.builtin_char_type_id());
            return;
        }
        if (kind == ex_NULL_LIT()) {
            self.set_expr_type_if_empty(expr_id, self.builtin_rawptr_type_id());
        }
    }

    fn binary_op_returns_bool(self, op: i32) -> bool {
        if (op == tk_EQEQ() || op == tk_NEQ()) { return true; }
        if (op == tk_LT() || op == tk_LE() || op == tk_GT() || op == tk_GE()) { return true; }
        if (op == tk_AND() || op == tk_OR()) { return true; }
        if (op == tk_MATCHOP()) { return true; }
        return false;
    }

    fn binary_op_is_arithmetic(self, op: i32) -> bool {
        if (op == tk_PLUS() || op == tk_MINUS()) { return true; }
        if (op == tk_STAR() || op == tk_SLASH() || op == tk_PERCENT()) { return true; }
        return false;
    }

    fn binary_op_is_bitwise(self, op: i32) -> bool {
        if (op == tk_AMP() || op == tk_PIPE() || op == tk_CARET()) { return true; }
        return false;
    }

    fn binary_op_is_shift(self, op: i32) -> bool {
        return op == tk_LSHIFT() || op == tk_RSHIFT();
    }

    fn type_id_kind_or_unknown(self, type_id: i32) -> i32 {
        if (!self.type_id_is_valid(type_id)) { return hir_type_unknown(); }
        return hir_type_table_kind(self.unit.types, type_id);
    }

    fn type_kind_is_signed_int_id(self, kind: i32) -> bool {
        if (kind == ty_I8() || kind == ty_I16() || kind == ty_I32() || kind == ty_I64()) { return true; }
        return kind == ty_ISIZE();
    }

    fn type_kind_is_unsigned_int_id(self, kind: i32) -> bool {
        if (kind == ty_CHAR()) { return true; }
        if (kind == ty_U8() || kind == ty_U16() || kind == ty_U32() || kind == ty_U64()) { return true; }
        return kind == ty_USIZE();
    }

    fn type_kind_is_int_id(self, kind: i32) -> bool {
        if (kind == ty_CHAR()) { return true; }
        if (self.type_kind_is_signed_int_id(kind)) { return true; }
        return self.type_kind_is_unsigned_int_id(kind);
    }

    fn type_kind_int_bits_id(self, kind: i32) -> i32 {
        if (kind == ty_BOOL()) { return 8; }
        if (kind == ty_CHAR()) { return 32; }
        if (kind == ty_I8() || kind == ty_U8()) { return 8; }
        if (kind == ty_I16() || kind == ty_U16()) { return 16; }
        if (kind == ty_I32() || kind == ty_U32()) { return 32; }
        if (kind == ty_I64() || kind == ty_U64()) { return 64; }
        if (kind == ty_ISIZE() || kind == ty_USIZE()) { return 64; }
        return 0;
    }

    fn type_kind_is_float_id(self, kind: i32) -> bool {
        return kind == ty_F32() || kind == ty_F64();
    }

    fn type_id_is_floatish(self, type_id: i32) -> bool {
        let kind = self.type_id_kind_or_unknown(type_id);
        if (self.type_kind_is_float_id(kind)) { return true; }
        if (kind == ty_CLASS()) {
            let text = hir_type_table_text(self.unit.types, type_id);
            return text == "f32" || text == "f64";
        }
        return false;
    }

    fn type_id_is_string(self, type_id: i32) -> bool {
        if (!self.type_id_is_valid(type_id)) { return false; }
        if (self.type_id_kind_or_unknown(type_id) == ty_STRING()) { return true; }
        return hir_builder_is_primitive_str_name(hir_type_table_text(self.unit.types, type_id));
    }

    fn type_id_float_bits(self, type_id: i32) -> i32 {
        let kind = self.type_id_kind_or_unknown(type_id);
        if (kind == ty_F32()) { return 32; }
        if (kind == ty_F64()) { return 64; }
        if (kind == ty_CLASS()) {
            let text = hir_type_table_text(self.unit.types, type_id);
            if (text == "f32") { return 32; }
            if (text == "f64") { return 64; }
        }
        return 0;
    }

    fn numeric_integer_result_type_id(self, lhs_type: i32, rhs_type: i32) -> i32 {
        let lhs_kind = self.type_id_kind_or_unknown(lhs_type);
        let rhs_kind = self.type_id_kind_or_unknown(rhs_type);
        if (lhs_kind == rhs_kind && self.type_kind_is_int_id(lhs_kind)) { return lhs_type; }
        let lhs_bits = self.type_kind_int_bits_id(lhs_kind);
        let rhs_bits = self.type_kind_int_bits_id(rhs_kind);
        if (rhs_bits > lhs_bits && rhs_bits > 0) { return rhs_type; }
        if (lhs_bits > 0) { return lhs_type; }
        return self.builtin_i32_type_id();
    }

    fn numeric_float_result_type_id(self, lhs_type: i32, rhs_type: i32) -> i32 {
        let lhs_bits = self.type_id_float_bits(lhs_type);
        let rhs_bits = self.type_id_float_bits(rhs_type);
        if (lhs_bits >= rhs_bits && lhs_bits > 0) {
            if (lhs_bits == 32) { return self.builtin_f32_type_id(); }
            return self.builtin_f64_type_id();
        }
        if (rhs_bits > 0) {
            if (rhs_bits == 32) { return self.builtin_f32_type_id(); }
            return self.builtin_f64_type_id();
        }
        return self.builtin_f64_type_id();
    }

    fn resolve_binary_result_type_id(self, op: i32, lhs_type: i32, rhs_type: i32) -> i32 {
        if (op == tk_PIPEARROW()) { return rhs_type; }
        if (op == tk_QUESTIONQUESTION()) { return lhs_type; }
        if (op == tk_DOTDOT() || op == tk_DOTDOTEQ()) { return self.type_id_from_text("Range"); }
        if (self.binary_op_returns_bool(op)) { return self.builtin_bool_type_id(); }
        if (!self.type_id_is_valid(lhs_type) || !self.type_id_is_valid(rhs_type)) { return hir_id_invalid(); }

        let lhs_kind = self.type_id_kind_or_unknown(lhs_type);
        let rhs_kind = self.type_id_kind_or_unknown(rhs_type);
        let lhs_is_int = self.type_kind_is_int_id(lhs_kind);
        let rhs_is_int = self.type_kind_is_int_id(rhs_kind);
        let lhs_is_float = self.type_id_is_floatish(lhs_type);
        let rhs_is_float = self.type_id_is_floatish(rhs_type);

        if (op == tk_PLUS()
            && self.type_id_is_string(lhs_type)
            && self.type_id_is_string(rhs_type)) {
            return self.builtin_str_type_id();
        }

        if (self.binary_op_is_arithmetic(op)) {
            if ((lhs_is_float && (rhs_is_float || rhs_is_int))
                || (rhs_is_float && lhs_is_int)) {
                return self.numeric_float_result_type_id(lhs_type, rhs_type);
            }
            if ((op == tk_PLUS() || op == tk_MINUS())
                && lhs_kind == ty_RAWPTR()
                && rhs_is_int) {
                return self.builtin_rawptr_type_id();
            }
            if (op == tk_PLUS()
                && rhs_kind == ty_RAWPTR()
                && lhs_is_int) {
                return self.builtin_rawptr_type_id();
            }
            if (lhs_is_int && rhs_is_int) {
                return self.numeric_integer_result_type_id(lhs_type, rhs_type);
            }
        }

        if (self.binary_op_is_bitwise(op)) {
            if (lhs_is_int && rhs_is_int) {
                return self.numeric_integer_result_type_id(lhs_type, rhs_type);
            }
        }

        if (self.binary_op_is_shift(op)) {
            if (lhs_is_int && rhs_is_int) { return lhs_type; }
        }

        return hir_id_invalid();
    }

    fn resolve_binary_expr_type_after_children(self, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        let op = self.unit.expr_op(expr_id);
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        let rhs_type = self.unit.expr_type(self.unit.expr_rhs(expr_id));
        let bintype_trace = hir_builder_env_enabled("VYX_TRACE_BINTYPE");
        if (bintype_trace) {
            print("[bintype] expr=" + policy_i64_to_string(expr_id as i64)
                  + " op=" + policy_i64_to_string(op as i64)
                  + " lhs=" + (self.type_id_is_valid(lhs_type) ? hir_type_table_text(self.unit.types, lhs_type) : "<inv>")
                  + " rhs=" + (self.type_id_is_valid(rhs_type) ? hir_type_table_text(self.unit.types, rhs_type) : "<inv>")
                  + " cur=" + (self.type_id_is_valid(self.unit.expr_type(expr_id)) ? hir_type_table_text(self.unit.types, self.unit.expr_type(expr_id)) : "<empty>"));
        }
        if (op == tk_MINUS()
            && self.type_id_kind_or_unknown(lhs_type) == ty_RAWPTR()
            && self.type_id_kind_or_unknown(rhs_type) == ty_RAWPTR()) {
            self.set_expr_type_canonical(expr_id, self.builtin_i64_type_id());
            return;
        }
        let resolved_type = self.resolve_binary_result_type_id(op, lhs_type, rhs_type);
        if (self.type_id_is_valid(resolved_type)) {
            self.set_expr_type_canonical(expr_id, resolved_type);
            if (bintype_trace) {
                print("[bintype] expr=" + policy_i64_to_string(expr_id as i64) + " resolved=" + hir_type_table_text(self.unit.types, resolved_type));
            }
            return;
        }
        if (self.type_id_is_valid(lhs_type)) {
            // An earlier typing pass may have provisionally taken the rhs type
            // because the lhs operand was untyped at the time (index-operator
            // consumer resolution can start building the instance body before
            // its member exprs are typed).  That provisional type sticks
            // because set_expr_type_if_empty refuses to overwrite, so correct
            // it here now that the lhs type is known.
            if (self.provisional_binary_rhs_map != null
                && hir_i32_array_map_get(self.provisional_binary_rhs_map, expr_id) > 0) {
                self.set_expr_type_canonical(expr_id, lhs_type);
                if (bintype_trace) {
                    print("[bintype] expr=" + policy_i64_to_string(expr_id as i64) + " corrected-provisional -> " + hir_type_table_text(self.unit.types, lhs_type));
                }
                return;
            }
            self.set_expr_type_if_empty(expr_id, lhs_type);
            if (bintype_trace) {
                print("[bintype] expr=" + policy_i64_to_string(expr_id as i64) + " fallback-lhs final=" + (self.type_id_is_valid(self.unit.expr_type(expr_id)) ? hir_type_table_text(self.unit.types, self.unit.expr_type(expr_id)) : "<empty>"));
            }
            return;
        }
        if (self.type_id_is_valid(rhs_type)) {
            self.set_expr_type_if_empty(expr_id, rhs_type);
            if (self.binary_op_is_arithmetic(op)) {
                self.provisional_binary_rhs_map = hir_i32_array_map_put(self.provisional_binary_rhs_map,
                                                                        expr_id,
                                                                        1);
            }
            if (bintype_trace) {
                print("[bintype] expr=" + policy_i64_to_string(expr_id as i64) + " provisional-rhs=" + hir_type_table_text(self.unit.types, rhs_type));
            }
        }
        if (bintype_trace) {
            print("[bintype] expr=" + policy_i64_to_string(expr_id as i64) + " final=" + (self.type_id_is_valid(self.unit.expr_type(expr_id)) ? hir_type_table_text(self.unit.types, self.unit.expr_type(expr_id)) : "<empty>"));
        }
    }

    fn resolve_assign_expr_type_after_children(self, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        let rhs_type = self.unit.expr_type(self.unit.expr_rhs(expr_id));
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        if (self.type_id_is_valid(rhs_type)) {
            self.set_expr_type_if_empty(expr_id, rhs_type);
            return;
        }
        if (self.type_id_is_valid(lhs_type)) {
            self.set_expr_type_if_empty(expr_id, lhs_type);
        }
    }

    fn assign_method_name_for_op(self, op: i32) -> string {
        if (op == tk_EQ()) { return "operator="; }
        if (op == tk_PLUSEQ()) { return "operator+="; }
        if (op == tk_MINUSEQ()) { return "operator-="; }
        if (op == tk_STAREQ()) { return "operator*="; }
        if (op == tk_SLASHEQ()) { return "operator/="; }
        if (op == tk_PERCENTEQ()) { return "operator%="; }
        if (op == tk_AMPEQ()) { return "operator&="; }
        if (op == tk_PIPEEQ()) { return "operator|="; }
        if (op == tk_CARETEQ()) { return "operator^="; }
        if (op == tk_LSHIFTEQ()) { return "operator<<="; }
        if (op == tk_RSHIFTEQ()) { return "operator>>="; }
        return "";
    }

    fn method_name_is_value_assign(self, name: string) -> bool {
        if (name == "operator_add_assign" || name == "operator+=") { return true; }
        if (name == "operator_sub_assign" || name == "operator-=") { return true; }
        if (name == "operator_mul_assign" || name == "operator*=") { return true; }
        if (name == "operator_div_assign" || name == "operator/=") { return true; }
        if (name == "operator_mod_assign" || name == "operator%=") { return true; }
        if (name == "operator_band_assign" || name == "operator&=") { return true; }
        if (name == "operator_bor_assign" || name == "operator|=") { return true; }
        if (name == "operator_bxor_assign" || name == "operator^=") { return true; }
        if (name == "operator_shl_assign" || name == "operator<<=") { return true; }
        if (name == "operator_shr_assign" || name == "operator>>=") { return true; }
        return false;
    }

    fn type_id_is_pointer_like(self, type_id: i32) -> bool {
        if (!self.type_id_is_valid(type_id)) { return false; }
        let kind = hir_type_table_kind(self.unit.types, type_id);
        if (kind == ty_RAWPTR() || kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) { return true; }
        return false;
    }

    fn member_lookup_type_id(self, type_id: i32) -> i32 {
        if (!self.type_id_is_valid(type_id)) { return hir_id_invalid(); }
        let kind = hir_type_table_kind(self.unit.types, type_id);
        if (kind == ty_PTR() || kind == ty_REF() || kind == ty_MUTREF()) {
            let elem = hir_type_table_elem(self.unit.types, type_id);
            if (self.type_id_is_valid(elem)
                && hir_type_table_kind(self.unit.types, elem) == ty_CLASS()) {
                return elem;
            }
        }
        return type_id;
    }

    fn member_lookup_type_name(self, type_id: i32) -> string {
        let lookup_type = self.member_lookup_type_id(type_id);
        if (!self.type_id_is_valid(lookup_type)) { return ""; }
        let raw = hir_type_table_text(self.unit.types, lookup_type);
        let resolved = self.resolve_type_text_in_current_env(raw);
        if (resolved.len > 0) { return resolved; }
        return raw;
    }

    fn type_text_is_reflect_instance(self, text: string) -> bool {
        return text == "std.reflect.Instance";
    }

    fn synthetic_method_call_expr(self, receiver: rawptr, method_name: string, arg: rawptr) -> rawptr {
        if (receiver == null || method_name.len == 0) { return null; }
        let member = expr_alloc(ex_MEMBER());
        if (member == null) { return null; }
        expr_set_lhs(member, receiver);
        expr_set_name(member, method_name);
        let call = expr_alloc(ex_CALL());
        if (call == null) { return null; }
        expr_set_lhs(call, member);
        if (arg != null) {
            let cell = stmt_alloc(st_EXPR());
            if (cell == null) { return null; }
            stmt_set_init(cell, arg);
            expr_set_args(call, cell);
        }
        return call;
    }

    fn build_empty_struct_init_new_call(self, e: rawptr) -> i32 {
        if (e == null || expr_get_kind(e) != ex_STRUCT_INIT() || expr_get_args(e) != null) {
            return hir_id_invalid();
        }
        let type_name = expr_get_name(e);
        if (type_name.len == 0) { return hir_id_invalid(); }
        let resolved = self.resolve_type_text_in_current_env(type_name);
        if (resolved.len == 0 || self.type_text_has_open_template_atom(resolved)) {
            return hir_id_invalid();
        }
        if (self.raw_class_decl_for_type_text(resolved) == null) { return hir_id_invalid(); }
        var new_decl = self.raw_static_method_decl_for_type_text(resolved, "new");
        if (new_decl == null) {
            new_decl = self.raw_template_method_decl_for_type_text(resolved, "new", true);
        }
        if (new_decl == null) { return hir_id_invalid(); }
        let receiver = expr_alloc(ex_IDENT());
        if (receiver == null) { return hir_id_invalid(); }
        expr_set_name(receiver, type_name);
        let call = self.synthetic_method_call_expr(receiver, "new", null);
        if (call == null) { return hir_id_invalid(); }
        return self.build_expr(call);
    }

    /// Container list initialization: `Vec<i32>{1, 2, 3}` parses as a
    /// struct-init whose cells are all positional (empty cell names).  When
    /// the resolved class exposes a static `from_array(items: *T, n: i64)`,
    /// rewrite the literal — at the AST level, before any HIR expr is
    /// allocated — into `Type::from_array([e1, ..., en], n)`.  Going through
    /// a real synthetic call (instead of a MIR-level desugar) means the
    /// ordinary call-resolution path materializes the `from_array` instance
    /// on demand and applies the array-literal → `*T` decay, so the method
    /// never needs to have been called elsewhere first.
    /// Returns invalid for named-field inits and for classes without
    /// `from_array` (those keep the aggregate / positional-field path).
    fn build_container_list_init_from_array_call(self, e: rawptr) -> i32 {
        if (e == null || expr_get_kind(e) != ex_STRUCT_INIT() || expr_get_args(e) == null) {
            return hir_id_invalid();
        }
        // Every cell must be positional (empty name) with a value; a mixed
        // named/positional init falls back to the aggregate path so sema
        // reports the field mismatch normally.
        var cell = expr_get_args(e);
        var count: i64 = 0;
        while (cell != null) {
            if (stmt_get_name(cell).len > 0) { return hir_id_invalid(); }
            if (stmt_get_init(cell) == null) { return hir_id_invalid(); }
            count = count + 1;
            cell = stmt_get_next(cell);
        }
        let type_name = expr_get_name(e);
        if (type_name.len == 0) { return hir_id_invalid(); }
        let resolved = self.resolve_type_text_in_current_env(type_name);
        if (resolved.len == 0 || self.type_text_has_open_template_atom(resolved)) {
            return hir_id_invalid();
        }
        if (self.raw_class_decl_for_type_text(resolved) == null) { return hir_id_invalid(); }
        if (self.raw_static_method_decl_for_type_text(resolved, "from_array") == null) {
            return hir_id_invalid();
        }
        let call = hir_native_init_array_call(type_name, expr_get_args(e), count);
        if (call == null) { return hir_id_invalid(); }
        return self.build_expr(call);
    }

    fn concrete_assignment_method_target(self,
                                                assign_expr_id: i32,
                                                owner_type_text: string,
                                                method_name: string) -> i32 {
        if (assign_expr_id == hir_id_invalid() || owner_type_text.len == 0 || method_name.len == 0) {
            return hir_id_invalid();
        }
        var method_decl = self.raw_method_decl_for_type_text(owner_type_text, method_name);
        if (method_decl == null) {
            method_decl = self.raw_template_method_decl_for_type_text(owner_type_text, method_name, false);
        }
        if (method_decl == null) { return hir_id_invalid(); }
        // Assignment children have already been inferred.  Resolve the
        // generic method from their HIR types so overload closure never
        // depends on the raw AST TypeRef carried by a temporary synthetic
        // call node.
        return self.ensure_method_instance_for_call(owner_type_text,
                                                    method_name,
                                                    null,
                                                    assign_expr_id,
                                                    method_decl,
                                                    false);
    }

    fn resolve_assignment_method_after_children(self, source_assign: rawptr, expr_id: i32) {
        if (source_assign == null || expr_id == hir_id_invalid()) { return; }
        let lhs_id = self.unit.expr_lhs(expr_id);
        let rhs_id = self.unit.expr_rhs(expr_id);
        if (lhs_id == hir_id_invalid() || rhs_id == hir_id_invalid()) { return; }
        let lhs_type = self.unit.expr_type(lhs_id);
        if (!self.type_id_is_valid(lhs_type)) { return; }
        let lhs_text = hir_type_table_text(self.unit.types, lhs_type);
        if (lhs_text.len == 0 || hir_builder_type_name_has_template_atom(lhs_text)) { return; }
        var method_name = "";
        if (self.type_text_is_reflect_instance(lhs_text) && self.unit.expr_op(expr_id) == tk_EQ()) {
            if (self.type_id_is_pointer_like(self.unit.expr_type(rhs_id))) {
                method_name = "rebindRaw";
            } else {
                method_name = "assign";
            }
        } else {
            method_name = self.assign_method_name_for_op(self.unit.expr_op(expr_id));
        }
        if (method_name.len == 0) { return; }
        let target_fn = self.concrete_assignment_method_target(expr_id, lhs_text, method_name);
        if (target_fn == hir_id_invalid()) { return; }
        self.unit.set_expr_semantic(expr_id, expr_sem_METHOD(), hir_target_function(), target_fn);
        let ret_type = self.unit.function_return_type(target_fn);
        if (self.type_id_is_valid(ret_type)) {
            self.unit.set_expr_type(expr_id, ret_type);
        }
    }

    fn resolve_unary_expr_type_after_child(self, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        if (self.unit.expr_op(expr_id) == tk_NOT()) {
            self.set_expr_type_if_empty(expr_id, self.builtin_bool_type_id());
            return;
        }
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        if (self.type_id_is_valid(lhs_type)) {
            self.set_expr_type_if_empty(expr_id, lhs_type);
        }
    }

    fn resolve_single_child_expr_type_after_child(self, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        if (self.type_id_is_valid(lhs_type)) {
            self.set_expr_type_if_empty(expr_id, lhs_type);
        }
    }

    fn resolve_addr_of_expr_type(self, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        if (self.type_id_is_valid(lhs_type)) {
            var kind = ty_REF();
            var prefix = "ref";
            if (self.unit.expr_op(expr_id) != 0) {
                kind = ty_MUTREF();
                prefix = "mutref";
            }
            let elem_text = hir_type_table_text(self.unit.types, lhs_type);
            let ptr_id = self.unit.types.intern(kind,
                                               prefix + "<" + elem_text + ">",
                                               lhs_type,
                                               0);
            if (self.type_id_is_valid(ptr_id)) {
                self.set_expr_type_if_empty(expr_id, ptr_id);
                return;
            }
        }
        self.set_expr_type_if_empty(expr_id, self.builtin_rawptr_type_id());
    }

    fn resolve_deref_expr_type_after_child(self, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        if (self.type_id_is_valid(lhs_type)) {
            let elem = hir_type_table_elem(self.unit.types, lhs_type);
            if (self.type_id_is_valid(elem)) {
                self.set_expr_type_if_empty(expr_id, elem);
                return;
            }
        }
        self.set_expr_type_if_empty(expr_id, self.builtin_rawptr_type_id());
    }

    fn index_operator_value_type_from_return(self, return_type: i32) -> i32 {
        if (!self.type_id_is_valid(return_type)) { return hir_id_invalid(); }
        let ret_text = hir_type_table_text(self.unit.types, return_type);
        let ret_base = policy_generic_call_base(ret_text.clone());
        let k = hir_type_table_kind(self.unit.types, return_type);
        if (k == ty_PTR() || k == ty_REF() || k == ty_MUTREF()
            || ret_base == "ptr" || ret_base == "ref" || ret_base == "mutref") {
            let elem = hir_type_table_elem(self.unit.types, return_type);
            if (self.type_id_is_valid(elem)) {
                let elem_text = hir_type_table_text(self.unit.types, elem);
                if (elem_text.len > 0 && !hir_builder_type_name_has_template_atom(elem_text)) {
                    return elem;
                }
            }
            let args = policy_generic_call_args(ret_text.clone());
            let arg0 = policy_generic_arg_at(args, 0);
            if (arg0.len > 0 && !hir_builder_type_name_has_template_atom(arg0)) {
                return self.type_id_from_text(arg0);
            }
            if (self.type_id_is_valid(elem)) { return elem; }
        }
        return return_type;
    }

    fn concrete_index_method_target(self, index_expr_id: i32, owner_type_text: string) -> i32 {
        if (index_expr_id == hir_id_invalid() || owner_type_text.len == 0) { return hir_id_invalid(); }
        var method_decl = self.raw_method_decl_for_type_text(owner_type_text, "operator[]");
        if (method_decl == null) {
            method_decl = self.raw_template_method_decl_for_type_text(owner_type_text, "operator[]", false);
        }
        if (method_decl == null) { return hir_id_invalid(); }
        return self.ensure_method_instance_for_call(owner_type_text,
                                                    "operator[]",
                                                    null,
                                                    index_expr_id,
                                                    method_decl,
                                                    false);
    }

    fn resolve_index_expr_type_after_children(self, source_index: rawptr, expr_id: i32) {
        if (expr_id == hir_id_invalid()) { return; }
        let lhs_type = self.unit.expr_type(self.unit.expr_lhs(expr_id));
        if (!self.type_id_is_valid(lhs_type)) { return; }
        let lhs_kind = hir_type_table_kind(self.unit.types, lhs_type);
        if (lhs_kind == ty_REF() || lhs_kind == ty_MUTREF() || lhs_kind == ty_PTR()) {
            let pointee = hir_type_table_elem(self.unit.types, lhs_type);
            if (self.type_id_is_valid(pointee)) {
                var indexed_type = pointee;
                // A direct array borrow exposes the borrowed array as an
                // element view, so `(&mut array)[i]` has the same type as
                // `array[i]`. A pointer-to-array retains complete-pointee
                // stepping: `(*[T; N])[i]` is still `[T; N]`.
                if ((lhs_kind == ty_REF() || lhs_kind == ty_MUTREF())
                    && hir_type_table_kind(self.unit.types, pointee) == ty_ARRAY()) {
                    let array_elem = hir_type_table_elem(self.unit.types, pointee);
                    if (self.type_id_is_valid(array_elem)) { indexed_type = array_elem; }
                    self.unit.set_expr_type(expr_id, indexed_type);
                    return;
                }
                // References are views of their pointee, not a distinct
                // indexing owner.  Resolve Vec/Dict/Stack/etc. operator[]
                // against the concrete pointee so `v: &mut Vec<T>` supports
                // the same `v[i]` syntax as an owned Vec<T>.  Keep the old
                // pointee fallback when no overload exists; this preserves
                // raw pointer/array diagnostics while allowing the normal
                // method resolver to report an invalid container index.
                let pointee_text = hir_type_table_text(self.unit.types, pointee);
                if (pointee_text.len() > 0
                    && !hir_builder_type_name_has_template_atom(pointee_text)) {
                    let target_fn = self.concrete_index_method_target(expr_id, pointee_text);
                    if (target_fn != hir_id_invalid()) {
                        self.unit.set_expr_semantic(expr_id,
                                                   expr_sem_METHOD(),
                                                   hir_target_function(),
                                                   target_fn);
                        // WYSIWYG index types: `b[i]` has exactly the type the
                        // operator[] declaration states.  A `*T` return stays a
                        // pointer (index again for the element, `b[i][j]`); a
                        // `&mut T`/`&T` return is a reference view that reads
                        // and assigns like the element.
                        let value_type = self.unit.function_return_type(target_fn);
                        if (self.type_id_is_valid(value_type)) {
                            self.unit.set_expr_type(expr_id, value_type);
                        }
                        return;
                    }
                }
                self.unit.set_expr_type(expr_id, indexed_type);
            }
            return;
        }
        if (lhs_kind == ty_ARRAY()) {
            let elem_type = hir_type_table_elem(self.unit.types, lhs_type);
            if (self.type_id_is_valid(elem_type)) {
                self.unit.set_expr_type(expr_id, elem_type);
            }
            return;
        }

        let lhs_text = hir_type_table_text(self.unit.types, lhs_type);
        if (lhs_text.len == 0 || hir_builder_type_name_has_template_atom(lhs_text)) { return; }
        let target_fn = self.concrete_index_method_target(expr_id, lhs_text);
        if (target_fn == hir_id_invalid()) { return; }
        self.unit.set_expr_semantic(expr_id, expr_sem_METHOD(), hir_target_function(), target_fn);
        // WYSIWYG index types (see the pointee branch above): `b[i]` keeps
        // the exact operator[] return type instead of dereferencing to the
        // element.
        let value_type = self.unit.function_return_type(target_fn);
        if (self.type_id_is_valid(value_type)) {
            self.unit.set_expr_type(expr_id, value_type);
        }
    }

    fn build_typed_int_const_expr(self, source: rawptr, type_id: i32, value: i64) -> i32 {
        let text = policy_i64_to_string(value);
        let expr_id = self.unit.add_expr(self.current_function_id,
                                        ex_INT_LIT(),
                                        "",
                                        text,
                                        value,
                                        type_id,
                                        expr_sem_NONE(),
                                        hir_target_none(),
                                        hir_id_invalid(),
                                        0,
                                        0);
        self.set_hir_expr_loc_from_ast(expr_id, source);
        self.unit.set_expr_owner_item(expr_id, self.current_item_id);
        return expr_id;
    }

    fn build_i64_const_expr(self, source: rawptr, value: i64) -> i32 {
        let type_id = self.type_id_from_text("i64");
        return self.build_typed_int_const_expr(source, type_id, value);
    }

    fn build_bool_const_expr(self, source: rawptr, value: bool) -> i32 {
        var int_value: i64 = 0;
        if (value) { int_value = 1; }
        let type_id = self.type_id_from_text("bool");
        let expr_id = self.unit.add_expr(self.current_function_id,
                                        ex_BOOL_LIT(),
                                        "",
                                        "",
                                        int_value,
                                        type_id,
                                        expr_sem_NONE(),
                                        hir_target_none(),
                                        hir_id_invalid(),
                                        0,
                                        0);
        self.set_hir_expr_loc_from_ast(expr_id, source);
        self.unit.set_expr_owner_item(expr_id, self.current_item_id);
        return expr_id;
    }
}
