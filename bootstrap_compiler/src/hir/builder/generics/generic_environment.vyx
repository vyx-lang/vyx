module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_binder;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_native_init;
use bootstrap.hir_type_table;
use bootstrap.policy;
use bootstrap.sema;

// Generic environment for the HIR builder. See README.md.

impl HirUnitBuilder {
    fn current_generic_binding(self, name: string) -> string {
        if (name.len == 0) { return ""; }
        var i: i32 = 0;
        while (i < 64) {
            let p = hir_builder_generic_param_at(self.current_generic_params, i);
            if (p.len == 0) { return ""; }
            if (p == name) {
                return policy_generic_arg_at(self.current_generic_args, i);
            }
            i = i + 1;
        }
        return "";
    }

    fn type_text_needs_current_env(self, text: string) -> bool {
        if (text.len == 0) { return false; }
        if (self.current_generic_params.len == 0 && self.current_generic_args.len == 0) { return false; }
        var i: i32 = 0;
        while (i < text.len) {
            let c = text.charAt(i);
            if (!hir_builder_identifier_char(c)) {
                i = i + 1;
            } else {
                let start = i;
                i = i + 1;
                while (i < text.len && hir_builder_identifier_char(text.charAt(i))) {
                    i = i + 1;
                }
                let token = text.substring(start, i);
                if (token == "Self") { return true; }
                if (hir_builder_generic_contains(self.current_generic_params, token)) { return true; }
            }
        }
        return false;
    }

    fn generic_arg_for_param(self, params: string, args: string, name: string) -> string {
        if (params.len == 0 || args.len == 0 || name.len == 0) { return ""; }
        var i: i32 = 0;
        while (i < 64) {
            let p = hir_builder_generic_param_at(params, i);
            if (p.len == 0) { return ""; }
            if (p == name) { return policy_generic_arg_at(args, i); }
            i = i + 1;
        }
        return "";
    }

    fn associated_type_text_in_current_env(self, text: string) -> string {
        let sep = hir_builder_assoc_separator_index(text);
        if (sep < 0) { return ""; }
        let sep_len = hir_builder_assoc_separator_len(text, sep);
        if (sep + sep_len >= text.len) { return ""; }
        let owner_raw = text.substring(0, sep);
        let member_name = text.substring(sep + sep_len, text.len);
        if (owner_raw.len == 0 || member_name.len == 0) { return ""; }
        if (policy_generic_call_has_args(member_name.clone()) != 0) { return ""; }
        let owner_text = self.resolve_type_text_in_current_env(owner_raw);
        if (owner_text.len == 0 || owner_text == text) { return ""; }
        let owner_decl = self.raw_class_decl_for_type_text(owner_text);
        if (owner_decl == null) { return ""; }
        let member = self.raw_member_decl_for_type_text(owner_text, member_name);
        if (member == null) { return ""; }
        let member_kind = decl_get_kind(member);
        if (member_kind != de_TYPE_ALIAS() && member_kind != de_FIELD()) { return ""; }
        let member_ty = decl_get_ty(member);
        if (member_ty == null) { return ""; }
        let owner_params = hir_builder_decl_template_params(owner_decl);
        let owner_args = hir_builder_owner_args_for_params(owner_params, owner_text);
        let member_text = self.type_text_from_ref_env(member_ty, owner_params, owner_args);
        if (member_text.len == 0 || member_text == text) { return ""; }
        return self.resolve_type_text_in_current_env(member_text);
    }

    fn resolve_type_text_in_current_env(self, text: string) -> string {
        self.profile_resolve_type_calls = self.profile_resolve_type_calls + 1;
        var hot_start: i64 = 0;
        let hot_timing = hir_builder_env_enabled("VYX_HIR_HOT_TIMING");
        if (hot_timing) { hot_start = vyx_bootstrap_now_ms(); }
        if (text.len == 0) { return ""; }
        var out = "";
        let needs_env = self.type_text_needs_current_env(text);
        if (!needs_env) {
            if (hir_builder_is_primitive_str_name(text)) {
                out = "str";
                if (hot_timing) { self.profile_ms_resolve_type = self.profile_ms_resolve_type + (vyx_bootstrap_now_ms() - hot_start); }
                return out;
            }
            if (!hir_builder_type_text_needs_env_resolution(text)) {
                out = text;
                if (hot_timing) { self.profile_ms_resolve_type = self.profile_ms_resolve_type + (vyx_bootstrap_now_ms() - hot_start); }
                return out;
            }
        }
        var cache_key = text;
        if (needs_env) {
            let env_key = hir_builder_env_key(self.current_generic_params, self.current_generic_args);
            if (env_key.len > 0) { cache_key = env_key + "=>" + text; }
        }
        let cached = self.resolved_type_text_cache.lookup(cache_key);
        if (cached.len > 0) {
            if (hot_timing) { self.profile_ms_resolve_type = self.profile_ms_resolve_type + (vyx_bootstrap_now_ms() - hot_start); }
            return cached;
        }
        out = self.resolve_type_text_in_current_env_uncached(text);
        if (out.len > 0) { self.resolved_type_text_cache.bind(cache_key, out); }
        if (hot_timing) { self.profile_ms_resolve_type = self.profile_ms_resolve_type + (vyx_bootstrap_now_ms() - hot_start); }
        return out;
    }

    fn resolve_type_text_in_current_env_uncached(self, text: string) -> string {
        if (text.len == 0) { return ""; }
        if (hir_builder_is_primitive_str_name(text)) { return "str"; }
        let pack_index_type = self.pack_index_type_text_in_current_env(text);
        if (pack_index_type.len > 0) { return pack_index_type; }
        if (policy_generic_call_has_args(text) != 0) {
            let base = policy_generic_call_base(text);
            let raw_args = policy_generic_call_args(text);
            var out_args = "";
            var i: i32 = 0;
            while (i < 64) {
                let raw_arg = policy_generic_arg_at(raw_args, i);
                if (raw_arg.len == 0) {
                    if (out_args.len == 0) { return base; }
                    return base + "::<" + out_args + ">";
                }
                out_args = hir_builder_append_csv(out_args, self.resolve_type_text_in_current_env(raw_arg));
                i = i + 1;
            }
            return base + "::<" + out_args + ">";
        }
        let bound = self.current_generic_binding(text);
        if (bound.len > 0 && bound != text) {
            return self.resolve_type_text_in_current_env(bound);
        }
        let associated = self.associated_type_text_in_current_env(text);
        if (associated.len > 0 && associated != text) { return associated; }
        return text;
    }

    fn canonical_type_text_in_current_env(self, text: string) -> string {
        let resolved = self.resolve_type_text_in_current_env(text);
        if (resolved.len == 0) { return ""; }
        let use_target = self.use_alias_target_type_text(resolved.clone());
        if (use_target.len > 0 && use_target != resolved) {
            return self.resolve_type_text_in_current_env(use_target);
        }
        let alias_decl = self.find_type_alias_decl(resolved);
        if (alias_decl != null && decl_get_ty(alias_decl) != null) {
            let alias_text = self.type_name_for_ref(decl_get_ty(alias_decl));
            if (alias_text.len > 0 && alias_text != resolved) {
                return self.resolve_type_text_in_current_env(alias_text);
            }
        }
        return resolved;
    }

    fn use_alias_target_type_text(self, text: string) -> string {
        if (self.source_unit == null || text.len == 0) { return ""; }
        let base = policy_generic_call_base(text.clone());
        let args = policy_generic_call_args(text.clone());
        var cur = unit_get_decls(self.source_unit);
        while (cur != null) {
            if (decl_get_kind(cur) == de_USE()) {
                let meta = decl_get_meta(cur);
                var alias = meta;
                let marker = meta.indexOf("|");
                if (marker == 0) { alias = ""; }
                else if (marker > 0) { alias = meta.substring(0, marker); }
                if (alias.len > 0 && alias == base) {
                    let target = decl_get_name(cur);
                    if (target.len == 0) { return ""; }
                    if (args.len > 0) { return target + "::<" + args + ">"; }
                    return target;
                }
            }
            cur = decl_get_next(cur);
        }
        return "";
    }

    fn canonical_type_text_in_function_env(self, text: string, fn_id: i32) -> string {
        if (text.len == 0) { return ""; }
        if (fn_id == hir_id_invalid()) {
            return self.canonical_type_text_in_current_env(text);
        }
        let saved_params = self.current_generic_params;
        let saved_args = self.current_generic_args;
        self.current_generic_params = hir_unit_function_generic_params(self.unit, fn_id);
        self.current_generic_args = hir_unit_function_generic_args(self.unit, fn_id);
        let out = self.canonical_type_text_in_current_env(text);
        self.current_generic_params = saved_params;
        self.current_generic_args = saved_args;
        return out;
    }

    fn concrete_owner_type_name_from_env(self, owner_decl: rawptr) -> string {
        if (owner_decl == null) { return ""; }
        let self_binding = self.current_generic_binding("Self");
        let owner_params = hir_builder_decl_template_params(owner_decl);
        if (self_binding.len > 0
            && self.owner_decl_accepts_owner_type(owner_decl, self_binding)
            && (owner_params.len == 0 || policy_generic_call_args(self_binding.clone()).len > 0)) {
            return self_binding;
        }
        if (owner_params.len == 0) { return ""; }
        var owner_args = "";
        var i: i32 = 0;
        while (i < 64) {
            let p = hir_builder_generic_param_at(owner_params, i);
            if (p.len == 0) {
                if (owner_args.len == 0) { return ""; }
                return policy_generic_call_base(decl_get_name(owner_decl)) + "::<" + owner_args + ">";
            }
            let a = self.current_generic_binding(p);
            if (a.len == 0) { return ""; }
            owner_args = hir_builder_append_csv(owner_args, a);
            i = i + 1;
        }
        if (self_binding.len > 0 && self.owner_decl_accepts_owner_type(owner_decl, self_binding)) {
            return self_binding;
        }
        return "";
    }

    fn concrete_owner_type_name(self, e: rawptr, owner_decl: rawptr) -> string {
        if (owner_decl == null) { return ""; }
        let owner_params = hir_builder_decl_template_params(owner_decl);
        let receiver = self.receiver_expr_for_call(e);
        if (receiver != null) {
            let explicit_receiver = self.resolve_type_text_in_current_env(expr_get_name(receiver));
            if (explicit_receiver.len > 0
                && self.raw_class_decl_for_type_text(explicit_receiver) != null
                && self.owner_decl_accepts_owner_type(owner_decl, explicit_receiver)
                && (owner_params.len == 0 || policy_generic_call_args(explicit_receiver.clone()).len > 0)) {
                return explicit_receiver;
            }
        }
        let receiver_text = self.type_text_from_expr(receiver);
        let receiver_owner = self.receiver_type_text_for_owner_decl(receiver_text, owner_decl);
        if (receiver_owner.len > 0
            && (owner_params.len == 0 || policy_generic_call_args(receiver_owner.clone()).len > 0)) {
            return receiver_owner;
        }
        let owner_name = decl_get_name(owner_decl);
        let owner_args = policy_generic_call_args(owner_name.clone());
        if (owner_args.len > 0) { return owner_name; }
        let env_owner = self.concrete_owner_type_name_from_env(owner_decl);
        if (env_owner.len > 0) { return env_owner; }
        return owner_name;
    }

    fn receiver_type_text_for_owner_decl(self, receiver_text: string, owner_decl: rawptr) -> string {
        if (receiver_text.len == 0 || owner_decl == null) { return ""; }
        let direct = self.resolve_type_text_in_current_env(receiver_text);
        if (direct.len == 0) { return ""; }
        if (self.owner_decl_matches_concrete_type(owner_decl, direct)) { return direct; }
        let payload = self.heap_indirect_payload_type_text(direct);
        if (payload.len > 0 && self.owner_decl_matches_concrete_type(owner_decl, payload)) {
            return payload;
        }
        return "";
    }

    fn type_text_is_box_lang_item(self, type_text: string) -> bool {
        let cd = self.raw_class_decl_for_type_text(type_text);
        if (cd == null) { return false; }
        if (hir_builder_decl_has_attr(cd, "lang_item(\"box\")")) { return true; }
        return hir_builder_type_base_name(type_text) == "Box";
    }

    fn type_text_is_heap_indirect_lang_item(self, type_text: string) -> bool {
        return self.type_text_is_ref_lang_item(type_text) || self.type_text_is_box_lang_item(type_text);
    }

    fn heap_indirect_payload_type_text(self, type_text: string) -> string {
        if (type_text.len == 0) { return ""; }
        let resolved = self.resolve_type_text_in_current_env(type_text);
        if (resolved.len == 0) { return ""; }
        if (!self.type_text_is_heap_indirect_lang_item(resolved)) { return ""; }
        let args = policy_generic_call_args(resolved.clone());
        let payload = policy_generic_arg_at(args, 0);
        if (payload.len == 0) { return ""; }
        return self.resolve_type_text_in_current_env(payload);
    }

    fn heap_indirect_member_owner_type_text(self, owner_type_name: string, member_name: string) -> string {
        if (owner_type_name.len == 0 || member_name.len == 0) { return ""; }
        let payload = self.heap_indirect_payload_type_text(owner_type_name);
        if (payload.len == 0) { return ""; }
        if (self.raw_member_decl_for_type_text(payload, member_name) != null) { return payload; }
        if (self.method_function_target_by_owner_type_and_method(payload, member_name) != hir_id_invalid()) {
            return payload;
        }
        return "";
    }
}
