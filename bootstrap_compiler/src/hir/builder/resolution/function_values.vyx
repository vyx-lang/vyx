module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.policy;

impl HirUnitBuilder {
    fn bind_free_function_value(self, e: rawptr, expr_id: i32, function_id: i32) -> i32 {
        if (e == self.current_call_callee_ast) { return function_id; }
        let anchor = hir_pointer_map_raw_for_function(self.decl_map, function_id);
        if (anchor == null || (decl_get_kind(anchor) != de_FN() && decl_get_kind(anchor) != de_EXTERN_FN())) {
            return function_id;
        }
        let arguments = self.resolve_explicit_generic_args_for_call(e);
        // Resolved source expressions already carry Sema's exact declaration.
        // Template artifacts clear that pointer, so recover their overload set
        // in its defining scope before constructing a concrete instance.
        var declaration = expr_get_semantic_target(e);
        if (declaration == null) {
            let name = policy_generic_call_base(decl_get_name(anchor));
            let scope = self.decl_source_module(anchor);
            let owner = hir_raw_owner_map_get(self.decl_owner_map, anchor);
            let arity = hir_builder_generic_arg_count(arguments);
            var primary: rawptr = null;
            var specialization: rawptr = null;
            var ambiguous = false;
            var ambiguous_spec = false;
            var entry = self.decl_map.head;
            while (entry != null) {
                let candidate = ast_read_rawptr(entry);
                if (candidate != null
                    && (decl_get_kind(candidate) == de_FN() || decl_get_kind(candidate) == de_EXTERN_FN())
                    && policy_generic_call_base(decl_get_name(candidate)) == name
                    && self.decl_source_module(candidate) == scope
                    && hir_raw_owner_map_get(self.decl_owner_map, candidate) == owner) {
                    let spec = hir_builder_decl_concrete_spec_args(candidate);
                    if (spec.len > 0) {
                        if (spec == arguments) {
                            if (specialization != null && specialization != candidate) { ambiguous_spec = true; }
                            specialization = candidate;
                        }
                    } else if (hir_builder_generic_param_count(hir_builder_decl_template_params(candidate)) == arity) {
                        if (primary != null && primary != candidate) { ambiguous = true; }
                        primary = candidate;
                    }
                }
                entry = ast_read_rawptr(ptr_offset(entry, 24));
            }
            if (specialization != null && !ambiguous_spec) { declaration = specialization; }
            else if (specialization == null && primary != null && !ambiguous) { declaration = primary; }
            else {
                diag_emit_at(diag_sev_ERROR(), diag_code_sema_no_overload(), self.unit.expr_loc_ptr(expr_id),
                    "function value requires a unique declaration matching its type arguments");
                return hir_id_invalid();
            }
        }
        let parameters = hir_builder_decl_template_params(declaration);
        if (parameters.len == 0) {
            let direct = hir_pointer_map_function(self.decl_map, declaration);
            self.ensure_reachable_function_body(declaration, direct, false);
            return direct;
        }
        if (arguments.len == 0) {
            diag_emit_at(diag_sev_ERROR(), diag_code_sema_no_overload(), self.unit.expr_loc_ptr(expr_id),
                "generic function value requires explicit type arguments");
            return hir_id_invalid();
        }
        if (hir_builder_generic_arg_count(arguments) != hir_builder_generic_param_count(parameters)) {
            diag_emit_at(diag_sev_ERROR(), diag_code_sema_no_overload(), self.unit.expr_loc_ptr(expr_id),
                "function value has no declaration matching its type arguments");
            return hir_id_invalid();
        }
        return self.concrete_function_target(e, declaration);
    }
}
