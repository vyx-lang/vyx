module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_binder;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_native_init;
use bootstrap.hir_type_table;
use bootstrap.policy;
use bootstrap.sema;

// Free calls for the HIR builder. See README.md.

impl HirUnitBuilder {
    fn concrete_function_target(self, e: rawptr, raw_target: rawptr) -> i32 {
        if (raw_target == null) { return hir_id_invalid(); }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] enter raw=" + decl_get_name(raw_target)
                  + " expr=" + expr_get_name(e)
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        var owner_decl = hir_raw_owner_map_get(self.decl_owner_map,raw_target);
        if (owner_decl == null) {
            owner_decl = expr_get_semantic_owner(e);
        }
        if (decl_get_kind(raw_target) == de_METHOD()) {
            owner_decl = self.generic_owner_decl_for_method_body(raw_target, owner_decl);
            raw_target = self.method_body_decl_for_instance(raw_target);
        }
        var owner_type_name = self.concrete_owner_type_name(e, owner_decl);
        let constructor_explicit_owner_args = self.resolve_explicit_generic_args_for_call(e);
        var type_call_explicit_owner_args: bool = false;
        if (owner_decl != null && constructor_explicit_owner_args.len > 0) {
            var explicit_source = e;
            if (explicit_source != null && expr_get_kind(explicit_source) == ex_CALL()) {
                explicit_source = expr_get_lhs(explicit_source);
            }
            if (explicit_source != null && expr_get_kind(explicit_source) == ex_IDENT()) {
                let explicit_base = hir_builder_last_path_segment(policy_generic_call_base(expr_get_name(explicit_source).clone()));
                let owner_base = hir_builder_last_path_segment(policy_generic_call_base(decl_get_name(owner_decl).clone()));
                type_call_explicit_owner_args = explicit_base.len > 0
                    && owner_base.len > 0
                    && explicit_base == owner_base;
            }
        }
        if (decl_get_kind(raw_target) == de_METHOD()
            && (decl_get_name(raw_target) == "constructor"
                || (decl_get_name(raw_target) == "new" && type_call_explicit_owner_args))
            && owner_decl != null
            && constructor_explicit_owner_args.len > 0) {
            let ctor_owner_params = hir_builder_decl_template_params(owner_decl);
            if (ctor_owner_params.len > 0
                && hir_builder_generic_param_count(ctor_owner_params) == hir_builder_generic_arg_count(constructor_explicit_owner_args)) {
                owner_type_name = policy_generic_call_base(decl_get_name(owner_decl).clone())
                    + "::<" + constructor_explicit_owner_args + ">";
            }
        }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] owner raw=" + decl_get_name(raw_target)
                  + " owner=" + owner_type_name
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        if (owner_type_name.len > 0 && decl_get_kind(raw_target) == de_METHOD()) {
            let canonical_method = self.canonical_method_decl_for_owner_type(raw_target,
                                                                             owner_type_name);
            if (canonical_method != null && canonical_method != raw_target) {
                raw_target = canonical_method;
                owner_decl = self.method_owner_decl_for_type_text(raw_target, owner_type_name, owner_decl);
                raw_target = self.method_body_decl_for_instance(raw_target);
                owner_type_name = self.concrete_owner_type_name(e, owner_decl);
            }
        }
        var owner_params = hir_builder_decl_template_params(owner_decl);
        if (owner_type_name.len > 0 && policy_generic_call_args(owner_type_name.clone()).len > 0) {
            let template_owner = self.raw_template_class_decl_for_type_text(owner_type_name);
            if (template_owner != null) {
                let template_params = hir_builder_decl_template_params(template_owner);
                if (template_params.len > 0) { owner_params = template_params; }
            }
        }
        var method_params = hir_builder_decl_template_params(raw_target);
        let owner_type_args = policy_generic_call_args(owner_type_name.clone());
        if (owner_params.len == 0 && owner_type_args.len > 0) {
            let ret_owner_params = hir_builder_template_params_matching_owner_text(hir_builder_type_ref_name(decl_get_ty(raw_target)),
                                                                                  owner_type_name);
            if (ret_owner_params.len > 0
                && hir_builder_generic_param_count(ret_owner_params) == hir_builder_generic_arg_count(owner_type_args)
                && !hir_builder_generic_contains(ret_owner_params, "Self")) {
                owner_params = ret_owner_params;
            }
        }
        if (owner_params.len == 0 && owner_type_args.len > 0 && method_params.len > 0) {
            let owner_arg_count = hir_builder_generic_arg_count(owner_type_args);
            let derived_owner_params = hir_builder_generic_params_prefix(method_params, owner_arg_count);
            if (hir_builder_generic_param_count(derived_owner_params) == owner_arg_count
                && !hir_builder_generic_contains(derived_owner_params, "Self")) {
                owner_params = derived_owner_params;
                method_params = hir_builder_generic_params_after(method_params, owner_arg_count);
            }
        }
        if (method_params.len == 0) {
            method_params = hir_builder_inferred_decl_template_params_except(raw_target, owner_params);
        }
        var owner_args = hir_builder_owner_args_for_params(owner_params, owner_type_name);
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] params raw=" + decl_get_name(raw_target)
                  + " owner_params=" + owner_params
                  + " method_params=" + method_params
                  + " owner_args=" + owner_args);
        }
        var explicit_method_args = self.resolve_explicit_generic_args_for_call(e);
        if (decl_get_kind(raw_target) == de_METHOD()
            && (decl_get_name(raw_target) == "constructor"
                || (decl_get_name(raw_target) == "new" && type_call_explicit_owner_args))
            && constructor_explicit_owner_args.len > 0
            && policy_generic_call_args(owner_type_name.clone()).len > 0) {
            explicit_method_args = "";
        }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] explicit raw=" + decl_get_name(raw_target)
                  + " explicit=" + explicit_method_args
                  + " owner_args=" + owner_args);
        }
        let bindings = self.infer_call_bindings(e,
                                                raw_target,
                                                owner_params,
                                                owner_args,
                                                method_params,
                                                explicit_method_args);
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] bindings raw=" + decl_get_name(raw_target)
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        let method_args = self.args_for_call_params(e, raw_target, method_params, explicit_method_args, bindings);
        bindings.dispose();
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] method-args raw=" + decl_get_name(raw_target)
                  + " method_args=" + method_args
                  + " types=" + self.i32_text(self.unit.types.count));
        }
        var params = owner_params;
        var args = owner_args;
        params = hir_builder_append_csv(params, method_params);
        args = hir_builder_append_csv(args, method_args);
        if (self.decl_body_has_template_type(raw_target)) {
            var env_index: i32 = 0;
            while (env_index < 64) {
                let env_param = hir_builder_generic_param_at(self.current_generic_params, env_index);
                if (env_param.len == 0) { break; }
                let env_arg = policy_generic_arg_at(self.current_generic_args, env_index);
                if (env_param != "Self"
                    && env_arg.len > 0
                    && self.decl_contains_template_param(raw_target, env_param)
                    && !hir_builder_generic_contains(params, env_param)) {
                    params = hir_builder_append_csv(params, env_param);
                    args = hir_builder_append_csv(args, env_arg);
                }
                env_index = env_index + 1;
            }
        }
        let direct_closed_target = self.direct_closed_method_function_if_no_instance_env(raw_target,
                                                                                        owner_decl,
                                                                                        owner_type_name,
                                                                                        params,
                                                                                        args);
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] direct-instance raw=" + decl_get_name(raw_target)
                  + " id=" + self.i32_text(direct_closed_target)
                  + " params=" + params
                  + " args=" + args);
        }
        if (direct_closed_target != hir_id_invalid()) { return direct_closed_target; }
        if (owner_type_name.len > 0 && !hir_builder_generic_contains(params, "Self")) {
            params = hir_builder_append_csv(params, "Self");
            args = hir_builder_append_csv(args, owner_type_name);
        }
        if (decl_get_body(raw_target) == null && owner_type_name.len > 0) {
            let impl_decl = self.concrete_impl_method_decl(decl_get_name(raw_target), owner_type_name);
            if (impl_decl != null && impl_decl != raw_target) {
                var impl_owner_decl = self.method_owner_decl_for_type_text(impl_decl,
                                                                           owner_type_name,
                                                                           self.concrete_impl_owner_decl(impl_decl));
                if (impl_owner_decl == null) { impl_owner_decl = owner_decl; }
                var impl_owner_params = hir_builder_decl_template_params(impl_owner_decl);
                var impl_method_params = hir_builder_decl_template_params(impl_decl);
                let impl_owner_type_args = policy_generic_call_args(owner_type_name.clone());
                if (impl_owner_params.len == 0 && impl_owner_type_args.len > 0) {
                    let impl_ret_owner_params = hir_builder_template_params_matching_owner_text(hir_builder_type_ref_name(decl_get_ty(impl_decl)),
                                                                                                owner_type_name);
                    if (impl_ret_owner_params.len > 0
                        && hir_builder_generic_param_count(impl_ret_owner_params) == hir_builder_generic_arg_count(impl_owner_type_args)
                        && !hir_builder_generic_contains(impl_ret_owner_params, "Self")) {
                        impl_owner_params = impl_ret_owner_params;
                    }
                }
                if (impl_owner_params.len == 0 && impl_owner_type_args.len > 0 && impl_method_params.len > 0) {
                    let impl_owner_arg_count = hir_builder_generic_arg_count(impl_owner_type_args);
                    let impl_derived_owner_params = hir_builder_generic_params_prefix(impl_method_params, impl_owner_arg_count);
                    if (hir_builder_generic_param_count(impl_derived_owner_params) == impl_owner_arg_count
                        && !hir_builder_generic_contains(impl_derived_owner_params, "Self")) {
                        impl_owner_params = impl_derived_owner_params;
                        impl_method_params = hir_builder_generic_params_after(impl_method_params, impl_owner_arg_count);
                    }
                }
                let impl_owner_args = hir_builder_owner_args_for_params(impl_owner_params, owner_type_name);
                let impl_bindings = self.infer_call_bindings(e,
                                                             impl_decl,
                                                             impl_owner_params,
                                                             impl_owner_args,
                                                             impl_method_params,
                                                             explicit_method_args);
                let impl_method_args = self.args_for_call_params(e, impl_decl, impl_method_params, explicit_method_args, impl_bindings);
                impl_bindings.dispose();
                var impl_params = impl_owner_params;
                var impl_args = impl_owner_args;
                impl_params = hir_builder_append_csv(impl_params, impl_method_params);
                impl_args = hir_builder_append_csv(impl_args, impl_method_args);
                // A trait requirement can resolve to a concrete implementation
                // after the enclosing generic body is closed. Do not turn an
                // already concrete implementation into a synthetic `Self`
                // instance: that changes its ABI symbol to `mir2$...` without
                // emitting a matching definition in the owner partition.
                let impl_direct_closed_target = self.direct_closed_method_function_if_no_instance_env(
                    impl_decl,
                    impl_owner_decl,
                    owner_type_name,
                    impl_params,
                    impl_args);
                if (impl_direct_closed_target != hir_id_invalid()) {
                    return impl_direct_closed_target;
                }
                let impl_direct_fn = hir_pointer_map_function(self.decl_map,impl_decl);
                if (impl_direct_fn != hir_id_invalid()
                    && hir_builder_decl_template_params(impl_decl).len == 0) {
                    self.ensure_reachable_function_body(impl_decl, impl_direct_fn, false);
                    return impl_direct_fn;
                }
                if (owner_type_name.len > 0 && !hir_builder_generic_contains(impl_params, "Self")) {
                    impl_params = hir_builder_append_csv(impl_params, "Self");
                    impl_args = hir_builder_append_csv(impl_args, owner_type_name);
                }
                if (impl_params.len > 0 && impl_args.len > 0) {
                    return self.ensure_function_instance(impl_decl,
                                                         impl_owner_decl,
                                                         owner_type_name,
                                                         impl_params,
                                                         impl_args);
                }
                if (impl_direct_fn != hir_id_invalid()) {
                    self.ensure_reachable_function_body(impl_decl, impl_direct_fn, false);
                    return impl_direct_fn;
                }
            }
        }
        let zero_variadic_instance = e != null
            && expr_get_kind(e) == ex_CALL()
            && self.decl_has_variadic_param(raw_target)
            && params.len > 0
            && args.len == 0;
        if (params.len == 0 || (args.len == 0 && !zero_variadic_instance)) {
            let direct_fn = hir_pointer_map_function(self.decl_map,raw_target);
            self.ensure_reachable_function_body(raw_target, direct_fn, false);
            return direct_fn;
        }
        if (vyx_bootstrap_profile_level() > 2) {
            print("[hir-concrete-fn] ensure-instance raw=" + decl_get_name(raw_target)
                  + " params=" + params
                  + " args=" + args);
        }
        return self.ensure_function_instance(raw_target, owner_decl, owner_type_name, params, args);
    }

    fn direct_closed_raw_function_target(self, raw_target: rawptr) -> i32 {
        if (raw_target == null) { return hir_id_invalid(); }
        let kind = decl_get_kind(raw_target);
        if (kind != de_FN() && kind != de_METHOD() && kind != de_EXTERN_FN()) {
            return hir_id_invalid();
        }
        if (hir_builder_decl_template_head(raw_target) || self.decl_body_has_template_type(raw_target)) {
            return hir_id_invalid();
        }
        let raw_owner = hir_raw_owner_map_get(self.decl_owner_map,raw_target);
        if (raw_owner != null && hir_builder_decl_template_head(raw_owner)) {
            return hir_id_invalid();
        }
        let direct_fn = hir_pointer_map_function(self.decl_map,raw_target);
        if (direct_fn == hir_id_invalid()) { return hir_id_invalid(); }
        self.ensure_reachable_function_body(raw_target, direct_fn, false);
        return direct_fn;
    }

    fn free_decl_score_for_call(self,
                                       call_expr_id: i32,
                                       free_decl: rawptr,
                                       params: string,
                                       args: string) -> i32 {
        if (call_expr_id == hir_id_invalid()
            || free_decl == null
            || decl_get_kind(free_decl) != de_FN()
            || self.unit.expr_kind(call_expr_id) != ex_CALL()) {
            return -1;
        }
        var param = decl_get_params(free_decl);
        var arg_id = self.unit.expr_first_arg(call_expr_id);
        var score: i32 = 0;
        while (param != null) {
            if (hir_builder_variadic_param(param)) { return score; }
            if (arg_id == hir_id_invalid()) { return -1; }
            let param_type_id = self.type_id_from_ref_env(decl_get_ty(param), params, args);
            let actual_type_id = self.unit.expr_type(arg_id);
            if (!self.type_id_is_valid(param_type_id) || !self.type_id_is_valid(actual_type_id)) { return -1; }
            let part = self.call_type_id_match_score(param_type_id, actual_type_id);
            if (part < 0) { return -1; }
            score = score + part;
            param = decl_get_next(param);
            arg_id = self.unit.expr_next_arg(arg_id);
        }
        if (arg_id != hir_id_invalid()) { return -1; }
        return score;
    }

    fn best_explicit_free_template_call_target(self,
                                                      e: rawptr,
                                                      call_expr_id: i32,
                                                      callee_base: string,
                                                      explicit_args: string) -> i32 {
        if (callee_base.len == 0 || explicit_args.len == 0) { return hir_id_invalid(); }
        var best_candidate: rawptr = null;
        var best_params = "";
        var best_args = "";
        var best_score: i32 = -1;
        var tied: bool = false;
        var cur = self.decl_map.head;
        while (cur != null) {
            let candidate = ast_read_rawptr(cur);
            if (candidate != null
                && (decl_get_kind(candidate) == de_FN()
                    || decl_get_kind(candidate) == de_EXTERN_FN())
                && policy_generic_call_base(decl_get_name(candidate).clone()) == callee_base
                && hir_builder_decl_template_params(candidate).len > 0) {
                let params = hir_builder_decl_template_params(candidate);
                let bindings = self.infer_call_bindings(e,
                                                        candidate,
                                                        "",
                                                        "",
                                                        params,
                                                        explicit_args);
                let args = self.args_for_call_params(e, candidate, params, explicit_args, bindings);
                bindings.dispose();
                if (self.env_args_closed_for_decl(candidate, params, args)) {
                    var closed = true;
                    var i: i32 = 0;
                    while (i < 256 && closed) {
                        let param = hir_builder_generic_param_at(params, i);
                        if (param.len == 0) { break; }
                        let arg = policy_generic_arg_at(args, i);
                        if (arg.len == 0 || self.type_text_has_open_template_atom(arg)) { closed = false; }
                        i = i + 1;
                    }
                    if (closed) {
                        let score = self.free_decl_score_for_call(call_expr_id, candidate, params, args);
                        if (score > best_score) {
                            best_score = score;
                            best_candidate = candidate;
                            best_params = params;
                            best_args = args;
                            tied = false;
                        } else if (score == best_score && score >= 0) {
                            tied = true;
                        }
                    }
                }
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        if (best_score < 0 || tied || best_candidate == null) { return hir_id_invalid(); }
        return self.ensure_function_instance(best_candidate, null, "", best_params, best_args);
    }

    // Imported template artifacts intentionally clear raw semantic pointers.
    // A qualified free call therefore arrives here as a BUILTIN-shaped member
    // with only its module/name identity.  Recover the declaration by the
    // validated artifact module stamp before generic instance materialization.
    // Matching the module as well as the short function name prevents two
    // imported modules that both export `same_name` from becoming ambiguous.
    fn qualified_free_function_target_for_call(self,
                                                e: rawptr,
                                                call_expr_id: i32,
                                                callee_expr_id: i32) -> i32 {
        if (call_expr_id == hir_id_invalid()
            || callee_expr_id == hir_id_invalid()) { return hir_id_invalid(); }
        var raw_callee = e;
        if (expr_get_kind(raw_callee) == ex_CALL()) { raw_callee = expr_get_lhs(raw_callee); }
        var module_name = "";
        if (raw_callee != null && expr_get_kind(raw_callee) == ex_MEMBER()) {
            module_name = expr_get_name(expr_get_lhs(raw_callee));
            if (module_name.len == 0) {
                let owner_id = self.unit.expr_lhs(callee_expr_id);
                if (owner_id != hir_id_invalid()) { module_name = self.unit.expr_name(owner_id); }
            }
        } elif (self.unit.expr_kind(callee_expr_id) == ex_MEMBER()) {
            // Expected-type recovery may invoke this routine after the raw
            // AST has been discarded. The HIR member owner still preserves
            // the fully qualified module name.
            let owner_id = self.unit.expr_lhs(callee_expr_id);
            if (owner_id != hir_id_invalid()) { module_name = self.unit.expr_name(owner_id); }
        } else {
            var current_raw = hir_pointer_map_raw_for_item(self.decl_map,
                                                            self.current_item_id);
            if (current_raw == null) {
                current_raw = hir_pointer_map_raw_for_function(self.decl_map,
                                                               self.current_function_id);
            }
            module_name = hir_builder_decl_source_module(current_raw);
            if (module_name.len == 0 && self.current_function_id != hir_id_invalid()) {
                let disc = self.unit.function_symbol_discriminator(self.current_function_id);
                let marker = "source=";
                let at = disc.indexOf(marker);
                if (at >= 0) {
                    let start = at + marker.len;
                    var end = start;
                    while (end < disc.len && disc.charAt(end) != 124) { end = end + 1; }
                    if (end > start) { module_name = disc.substring(start, end); }
                }
            }
        }
        let base = policy_generic_call_base(self.unit.expr_name(callee_expr_id).clone());
        if (base.len == 0) { return hir_id_invalid(); }
        // A materialized function instance may no longer carry the raw
        // source item that stamped its module.  Recover an unqualified call's
        // module only when the exported short name is unique across the
        // imported declaration set.  Ambiguous names remain fail-closed.
        if (module_name.len == 0) {
            var inferred_module = "";
            var inferred_ambiguous = false;
            var infer_cur = self.decl_map.head;
            while (infer_cur != null) {
                let infer_candidate = ast_read_rawptr(infer_cur);
                if (infer_candidate != null
                    && (decl_get_kind(infer_candidate) == de_FN()
                        || decl_get_kind(infer_candidate) == de_EXTERN_FN())
                    && policy_generic_call_base(decl_get_name(infer_candidate).clone()) == base) {
                    let infer_source = hir_builder_decl_source_module(infer_candidate);
                    if (infer_source.len > 0) {
                        let normalized = policy_module_base(infer_source.clone());
                        if (inferred_module.len == 0) {
                            inferred_module = normalized;
                        } elif (inferred_module != normalized) {
                            inferred_ambiguous = true;
                        }
                    }
                }
                infer_cur = ast_read_rawptr(ptr_offset(infer_cur, 24));
            }
            if (inferred_ambiguous || inferred_module.len == 0) { return hir_id_invalid(); }
            module_name = inferred_module;
        }
        let wanted_module = policy_module_base(module_name.clone());
        let explicit_args = self.resolve_explicit_generic_args_for_call(e);
        var best: rawptr = null;
        var best_score: i32 = -1;
        var tied = false;
        var candidate_count: i32 = 0;
        var cur = self.decl_map.head;
        while (cur != null) {
            let candidate = ast_read_rawptr(cur);
            if (candidate != null
                && (decl_get_kind(candidate) == de_FN()
                    || decl_get_kind(candidate) == de_EXTERN_FN())
                && policy_generic_call_base(decl_get_name(candidate).clone()) == base) {
                let source_module = hir_builder_decl_source_module(candidate);
                if (source_module.len > 0
                    && policy_module_base(source_module.clone()) == wanted_module) {
                    candidate_count = candidate_count + 1;
                    let params = hir_builder_decl_template_params(candidate);
                    var score = -1;
                    if (params.len == 0) {
                        score = self.free_decl_score_for_call(call_expr_id, candidate, "", "");
                    } else {
                        let bindings = self.infer_hir_call_bindings(call_expr_id,
                                                                    candidate,
                                                                    "",
                                                                    "",
                                                                    params,
                                                                    explicit_args);
                        let args = self.args_for_hir_call_params(call_expr_id,
                                                                  candidate,
                                                                  params,
                                                                  explicit_args,
                                                                  bindings);
                        score = self.free_decl_score_for_call(call_expr_id, candidate, params, args);
                        bindings.dispose();
                    }
                    if (score > best_score) {
                        best_score = score;
                        best = candidate;
                        tied = false;
                    } elif (score >= 0 && score == best_score) {
                        tied = true;
                    }
                }
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        // An explicitly typed, fully qualified generic call has a single
        // declaration identity even when its argument expression is still a
        // provisional artifact value.  Permit that unique candidate through
        // to instance materialization; overload sets still require the
        // ordinary type score and remain fail-closed on ties.
        if (best == null || tied
            || (best_score < 0 && (candidate_count != 1 || explicit_args.len == 0))) {
            return hir_id_invalid();
        }
        let params = hir_builder_decl_template_params(best);
        if (params.len > 0) {
            let out = self.concrete_free_function_target_for_call_expr(e,
                                                                       call_expr_id,
                                                                       callee_expr_id,
                                                                       best);
            return out;
        }
        let direct_fn = hir_pointer_map_function(self.decl_map, best);
        if (direct_fn != hir_id_invalid()) {
            self.ensure_reachable_function_body(best, direct_fn, false);
        }
        return direct_fn;
    }

    fn best_explicit_free_concrete_spec_call_target(self,
                                                           call_expr_id: i32,
                                                           callee_base: string,
                                                           explicit_args: string) -> i32 {
        if (callee_base.len == 0 || explicit_args.len == 0) { return hir_id_invalid(); }
        var best_candidate: rawptr = null;
        var best_score: i32 = -1;
        var tied: bool = false;
        var cur = self.decl_map.head;
        while (cur != null) {
            let candidate = ast_read_rawptr(cur);
            if (candidate != null
                && decl_get_kind(candidate) == de_FN()
                && policy_generic_call_base(decl_get_name(candidate).clone()) == callee_base
                && hir_builder_decl_concrete_spec_args(candidate) == explicit_args) {
                let score = self.free_decl_score_for_call(call_expr_id, candidate, "", "");
                if (score > best_score) {
                    best_score = score;
                    best_candidate = candidate;
                    tied = false;
                } else if (score == best_score && score >= 0) {
                    tied = true;
                }
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        if (best_score < 0 || tied || best_candidate == null) { return hir_id_invalid(); }
        let direct_fn = hir_pointer_map_function(self.decl_map,best_candidate);
        if (direct_fn == hir_id_invalid()) { return hir_id_invalid(); }
        if (self.function_has_open_template_types(direct_fn)) { return hir_id_invalid(); }
        self.ensure_reachable_function_body(best_candidate, direct_fn, false);
        return direct_fn;
    }

    fn concrete_free_function_target_for_call_expr(self,
                                                          e: rawptr,
                                                          call_expr_id: i32,
                                                          callee_expr_id: i32,
                                                          raw_target: rawptr) -> i32 {
        if (callee_expr_id == hir_id_invalid()
            || call_expr_id == hir_id_invalid()
            || raw_target == null) {
            return hir_id_invalid();
        }
        // DCI open-generic extern declarations instantiate like free
        // templates; the instance shell ends up declaration-only.
        if (decl_get_kind(raw_target) != de_FN()
            && decl_get_kind(raw_target) != de_EXTERN_FN()) {
            return hir_id_invalid();
        }
        if (decl_get_kind(raw_target) == de_EXTERN_FN()
            && !hir_builder_decl_is_foreign_dci(raw_target)) {
            return hir_id_invalid();
        }
        var template_decl = raw_target;
        var params = hir_builder_decl_template_params(template_decl);
        if (params.len == 0) {
            let body_decl = self.raw_function_body_decl_for(raw_target);
            if (body_decl != null && decl_get_kind(body_decl) == de_FN()) {
                let body_params = hir_builder_decl_template_params(body_decl);
                if (body_params.len > 0) {
                    template_decl = body_decl;
                    params = body_params;
                }
            }
        }
        if (params.len == 0) {
            params = hir_builder_inferred_decl_template_params_except(template_decl, "");
        }
        if (params.len == 0) { return hir_id_invalid(); }
        var explicit_args = self.resolve_explicit_generic_args_for_call(e);
        if (explicit_args.len == 0) {
            explicit_args = self.resolve_explicit_generic_args_for_hir_call(call_expr_id);
        }
        let bindings = self.infer_hir_call_bindings(call_expr_id,
                                                    template_decl,
                                                    "",
                                                    "",
                                                    params,
                                                    explicit_args);
        let args = self.args_for_hir_call_params(call_expr_id,
                                                 template_decl,
                                                 params,
                                                 explicit_args,
                                                 bindings);
        bindings.dispose();
        if (!self.env_args_closed_for_decl(template_decl, params, args)) {
            return hir_id_invalid();
        }
        let out_fn = self.ensure_function_instance(template_decl, null, "", params, args);
        if (out_fn == hir_id_invalid() || self.function_has_open_template_types(out_fn)) {
            return hir_id_invalid();
        }
        return out_fn;
    }

    fn concrete_explicit_free_function_call_target(self,
                                                          e: rawptr,
                                                          call_expr_id: i32,
                                                          callee_expr_id: i32,
                                                          raw_target: rawptr) -> i32 {
        if (callee_expr_id == hir_id_invalid() || raw_target == null) { return hir_id_invalid(); }
        if (decl_get_kind(raw_target) != de_FN()
            && !(decl_get_kind(raw_target) == de_EXTERN_FN()
                 && hir_builder_decl_is_foreign_dci(raw_target))) {
            return hir_id_invalid();
        }
        let callee_name = self.unit.expr_name(callee_expr_id);
        let explicit_args = self.resolve_explicit_generic_args_for_call(e);
        if (explicit_args.len == 0) { return hir_id_invalid(); }
        let callee_base = policy_generic_call_base(callee_name.clone());
        let best_concrete_spec = self.best_explicit_free_concrete_spec_call_target(call_expr_id,
                                                                                  callee_base,
                                                                                  explicit_args);
        if (best_concrete_spec != hir_id_invalid()) { return best_concrete_spec; }
        let hir_template = self.concrete_free_function_target_for_call_expr(e,
                                                                            call_expr_id,
                                                                            callee_expr_id,
                                                                            raw_target);
        if (hir_template != hir_id_invalid()) { return hir_template; }
        let best_template = self.best_explicit_free_template_call_target(e,
                                                                         call_expr_id,
                                                                         callee_base,
                                                                         explicit_args);
        if (best_template != hir_id_invalid()) { return best_template; }
        var template_decl = raw_target;
        var params = hir_builder_decl_template_params(template_decl);
        if (params.len == 0) {
            let body_decl = self.raw_function_body_decl_for(raw_target);
            if (body_decl != null && decl_get_kind(body_decl) == de_FN()) {
                let body_params = hir_builder_decl_template_params(body_decl);
                if (body_params.len > 0) {
                    template_decl = body_decl;
                    params = body_params;
                }
            }
        }
        if (params.len == 0) { return hir_id_invalid(); }
        let bindings = self.infer_call_bindings(e,
                                                template_decl,
                                                "",
                                                "",
                                                params,
                                                explicit_args);
        let args = self.args_for_call_params(e, template_decl, params, explicit_args, bindings);
        bindings.dispose();
        if (!self.env_args_cover_params_for_decl(template_decl, params, args)) { return hir_id_invalid(); }
        var i: i32 = 0;
        while (i < 256) {
            let param = hir_builder_generic_param_at(params, i);
            if (param.len == 0) { break; }
            let arg = policy_generic_arg_at(args, i);
            if (arg.len == 0 || self.type_text_has_open_template_atom(arg)) {
                return hir_id_invalid();
            }
            i = i + 1;
        }
        return self.ensure_function_instance(template_decl, null, "", params, args);
    }
}
