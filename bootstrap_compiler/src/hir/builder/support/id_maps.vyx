module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_binder;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_native_init;
use bootstrap.hir_type_table;
use bootstrap.policy;
use bootstrap.sema;

// Id maps for the HIR builder. See README.md.

class HirIntIdMap {
    public head: rawptr

    public static fn create() -> HirIntIdMap {
        return HirIntIdMap { head: null };
    }

    fn dispose(self) {
        var cur = self.head;
        while (cur != null) {
            let next = ast_read_rawptr(ptr_offset(cur, 8));
            free(cur);
            cur = next;
        }
        self.head = null;
    }

    fn put(self, key: i32, value: i32) {
        if (key == hir_id_invalid()) { return; }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_i32(cur) == key) {
                ast_write_i32(ptr_offset(cur, 4), value);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        let node = hir_profile_malloc(16);
        if (node == null) { return; }
        memset(node, 0, 16);
        ast_write_i32(node, key);
        ast_write_i32(ptr_offset(node, 4), value);
        ast_write_rawptr(ptr_offset(node, 8), self.head);
        self.head = node;
    }

    fn get(self, key: i32) -> i32 {
        if (key == hir_id_invalid()) { return -1; }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_i32(cur) == key) {
                return ast_read_i32(ptr_offset(cur, 4));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 8));
        }
        return -1;
    }
}

fn hir_int_id_map_create() -> HirIntIdMap {
    return HirIntIdMap.create();
}

fn hir_int_id_map_put(map: HirIntIdMap, key: i32, value: i32) -> HirIntIdMap {
    if (key == hir_id_invalid()) { return map; }
    var cur = map.head;
    while (cur != null) {
        if (ast_read_i32(cur) == key) {
            ast_write_i32(ptr_offset(cur, 4), value);
            return map;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 8));
    }
    let node = hir_profile_malloc(16);
    if (node == null) { return map; }
    memset(node, 0, 16);
    ast_write_i32(node, key);
    ast_write_i32(ptr_offset(node, 4), value);
    ast_write_rawptr(ptr_offset(node, 8), map.head);
    map.head = node;
    return map;
}

fn hir_int_id_map_get(map: HirIntIdMap, key: i32) -> i32 {
    if (key == hir_id_invalid()) { return -1; }
    var cur = map.head;
    while (cur != null) {
        if (ast_read_i32(cur) == key) {
            return ast_read_i32(ptr_offset(cur, 4));
        }
        cur = ast_read_rawptr(ptr_offset(cur, 8));
    }
    return -1;
}

fn hir_int_id_map_dispose(map: HirIntIdMap) -> HirIntIdMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 8));
        free(cur);
        cur = next;
    }
    map.head = null;
    return map;
}

fn hir_i32_array_map_create(initial_count: i32) -> rawptr {
    var cap = initial_count;
    if (cap < 1024) { cap = 1024; }
    let header = hir_profile_malloc(16);
    if (header == null) { return null; }
    memset(header, 0, 16);
    let bytes = ((cap + 1) * 4) as u64;
    let buf = hir_profile_malloc(bytes);
    if (buf == null) {
        free(header);
        return null;
    }
    memset(buf, 0, bytes);
    ast_write_rawptr(header, buf);
    ast_write_i32(ptr_offset(header, 8), cap);
    return header;
}

fn hir_i32_array_map_get(map: rawptr, id: i32) -> i32 {
    if (map == null || id <= 0) { return -1; }
    let cap = ast_read_i32(ptr_offset(map, 8));
    if (id > cap) { return -1; }
    let buf = ast_read_rawptr(map);
    if (buf == null) { return -1; }
    let value = ast_read_i32(ptr_offset(buf, id * 4));
    if (value == 0) { return -1; }
    return value - 1;
}

fn hir_i32_array_map_ensure(map: rawptr, id: i32) -> rawptr {
    if (id <= 0) { return map; }
    var out = map;
    if (out == null) { out = hir_i32_array_map_create(id); }
    if (out == null) { return null; }
    var cap = ast_read_i32(ptr_offset(out, 8));
    if (id <= cap) { return out; }
    var new_cap = cap;
    if (new_cap < 1024) { new_cap = 1024; }
    while (new_cap < id) { new_cap = new_cap * 2; }
    let old_buf = ast_read_rawptr(out);
    let new_bytes = ((new_cap + 1) * 4) as u64;
    let new_buf = hir_profile_malloc(new_bytes);
    if (new_buf == null) { return out; }
    memset(new_buf, 0, new_bytes);
    if (old_buf != null && cap > 0) {
        memcpy(new_buf, old_buf, ((cap + 1) * 4) as u64);
        free(old_buf);
    }
    ast_write_rawptr(out, new_buf);
    ast_write_i32(ptr_offset(out, 8), new_cap);
    return out;
}

fn hir_i32_array_map_put(map: rawptr, id: i32, value: i32) -> rawptr {
    if (id <= 0 || value < 0) { return map; }
    var out = hir_i32_array_map_ensure(map, id);
    if (out == null) { return map; }
    let buf = ast_read_rawptr(out);
    if (buf == null) { return out; }
    ast_write_i32(ptr_offset(buf, id * 4), value + 1);
    return out;
}

fn hir_i32_array_map_dispose(map: rawptr) -> rawptr {
    if (map == null) { return null; }
    let buf = ast_read_rawptr(map);
    if (buf != null) { free(buf); }
    free(map);
    return null;
}
