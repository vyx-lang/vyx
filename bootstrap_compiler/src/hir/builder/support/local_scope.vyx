module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_binder;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_native_init;
use bootstrap.hir_type_table;
use bootstrap.policy;
use bootstrap.sema;

// Local scope for the HIR builder. See README.md.

class HirLocalScope {
    public head: rawptr

    public static fn create() -> HirLocalScope {
        return HirLocalScope { head: null };
    }

    fn push(self, name: string, local_id: i32, type_id: i32, function_id: i32, target: rawptr) {
        if (name.len == 0) { return; }
        let node = hir_profile_malloc(56);
        if (node == null) { return; }
        memset(node, 0, 56);
        ast_write_rawptr(node, ast_dup_c_string(name));
        ast_write_i64(ptr_offset(node, 8), name.len);
        ast_write_i32(ptr_offset(node, 16), local_id);
        ast_write_i32(ptr_offset(node, 20), type_id);
        ast_write_i32(ptr_offset(node, 24), function_id);
        ast_write_rawptr(ptr_offset(node, 32), self.head);
        ast_write_rawptr(ptr_offset(node, 40), target);
        self.head = node;
    }

    fn restore(self, saved: rawptr) {
        self.head = saved;
    }

    fn drop_to(self, saved: rawptr) {
        var cur = self.head;
        while (cur != null && cur != saved) {
            let next = ast_read_rawptr(ptr_offset(cur, 32));
            let name_ptr = ast_read_rawptr(cur);
            if (name_ptr != null) { free(name_ptr); }
            free(cur);
            cur = next;
        }
        self.head = saved;
    }

    fn lookup(self, name: string) -> i32 {
        var cur = self.head;
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(ptr, len, name)) {
                return ast_read_i32(ptr_offset(cur, 16));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 32));
        }
        return hir_id_invalid();
    }

    fn lookup_target(self, target: rawptr) -> i32 {
        if (target == null) { return hir_id_invalid(); }
        var cur = self.head;
        while (cur != null) {
            if (ast_read_rawptr(ptr_offset(cur, 40)) == target) {
                return ast_read_i32(ptr_offset(cur, 16));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 32));
        }
        return hir_id_invalid();
    }
}

fn hir_local_scope_push(scope: HirLocalScope,
                        name: string,
                        local_id: i32,
                        type_id: i32,
                        function_id: i32,
                        target: rawptr) -> HirLocalScope {
    scope.push(name, local_id, type_id, function_id, target);
    return scope;
}

fn hir_local_scope_restore(scope: HirLocalScope, saved: rawptr) -> HirLocalScope {
    scope.restore(saved);
    return scope;
}

fn hir_local_scope_drop_to(scope: HirLocalScope, saved: rawptr) -> HirLocalScope {
    scope.drop_to(saved);
    return scope;
}

fn hir_local_scope_lookup_target(scope: HirLocalScope, target: rawptr) -> i32 {
    return scope.lookup_target(target);
}

fn hir_local_scope_lookup(scope: HirLocalScope, name: string) -> i32 {
    return scope.lookup(name);
}

fn hir_local_scope_dispose(scope: HirLocalScope) -> HirLocalScope {
    return hir_local_scope_drop_to(scope, null);
}

fn hir_local_scope_find_node(head: rawptr, target: rawptr) -> rawptr {
    if (target == null) { return null; }
    var cur = head;
    while (cur != null) {
        if (ast_read_rawptr(ptr_offset(cur, 40)) == target) { return cur; }
        cur = ast_read_rawptr(ptr_offset(cur, 32));
    }
    return null;
}

fn hir_local_scope_find_node_by_name(head: rawptr, name: string) -> rawptr {
    if (name.len == 0) { return null; }
    var cur = head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (hir_builder_c_string_equals(ptr, len, name)) { return cur; }
        cur = ast_read_rawptr(ptr_offset(cur, 32));
    }
    return null;
}

fn hir_local_scope_node_name(node: rawptr) -> string {
    if (node == null) { return ""; }
    let ptr = ast_read_rawptr(node);
    let len = ast_read_i64(ptr_offset(node, 8));
    if (ptr == null || len <= 0) { return ""; }
    return from_cstr_view_len(ptr, len);
}

fn hir_local_scope_node_type(node: rawptr) -> i32 {
    if (node == null) { return hir_id_invalid(); }
    return ast_read_i32(ptr_offset(node, 20));
}

fn hir_local_scope_node_local(node: rawptr) -> i32 {
    if (node == null) { return hir_id_invalid(); }
    return ast_read_i32(ptr_offset(node, 16));
}

fn hir_local_scope_node_target(node: rawptr) -> rawptr {
    if (node == null) { return null; }
    return ast_read_rawptr(ptr_offset(node, 40));
}
