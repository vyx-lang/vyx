module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_binder;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_native_init;
use bootstrap.hir_type_table;
use bootstrap.policy;
use bootstrap.sema;

// Name maps for the HIR builder. See README.md.

class HirStringSet {
    public head: rawptr
    public buckets: rawptr
    public bucket_cap: i32

    public static fn create() -> HirStringSet {
        return HirStringSet { head: null, buckets: null, bucket_cap: 0 };
    }

    fn contains(self, value: string) -> bool {
        if (value.len == 0) { return false; }
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(value), self.bucket_cap);
            var bcur = ast_read_rawptr(ptr_offset(self.buckets, (slot as i64) * 8));
            while (bcur != null) {
                let ptr2 = ast_read_rawptr(bcur);
                let len2 = ast_read_i64(ptr_offset(bcur, 8));
                if (hir_builder_c_string_equals(ptr2, len2, value)) { return true; }
                bcur = ast_read_rawptr(ptr_offset(bcur, 24));
            }
            return false;
        }
        var cur = self.head;
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(ptr, len, value)) { return true; }
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
        return false;
    }

    fn add(self, value: string) {
        if (value.len == 0) { return; }
        self.ensure_buckets();
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(value), self.bucket_cap);
            let slot_ptr = ptr_offset(self.buckets, (slot as i64) * 8);
            var bcur = ast_read_rawptr(slot_ptr);
            while (bcur != null) {
                let ptr2 = ast_read_rawptr(bcur);
                let len2 = ast_read_i64(ptr_offset(bcur, 8));
                if (hir_builder_c_string_equals(ptr2, len2, value)) { return; }
                bcur = ast_read_rawptr(ptr_offset(bcur, 24));
            }
            let bnode = hir_profile_malloc(32);
            if (bnode == null) { return; }
            memset(bnode, 0, 32);
            ast_write_rawptr(bnode, ast_dup_c_string(value));
            ast_write_i64(ptr_offset(bnode, 8), value.len);
            ast_write_rawptr(ptr_offset(bnode, 16), self.head);
            ast_write_rawptr(ptr_offset(bnode, 24), ast_read_rawptr(slot_ptr));
            self.head = bnode;
            ast_write_rawptr(slot_ptr, bnode);
            return;
        }
        if (self.contains(value)) { return; }
        let node = hir_profile_malloc(32);
        if (node == null) { return; }
        memset(node, 0, 32);
        ast_write_rawptr(node, ast_dup_c_string(value));
        ast_write_i64(ptr_offset(node, 8), value.len);
        ast_write_rawptr(ptr_offset(node, 16), self.head);
        ast_write_rawptr(ptr_offset(node, 24), null);
        self.head = node;
    }

    fn ensure_buckets(self) {
        if (self.buckets != null && self.bucket_cap > 0) { return; }
        self.bucket_cap = 16384;
        self.buckets = hir_builder_alloc_ptr_buckets(self.bucket_cap);
        if (self.buckets == null) {
            self.bucket_cap = 0;
            return;
        }
        var cur = self.head;
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            let key = ast_borrow_c_string(ptr, len);
            let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(key), self.bucket_cap);
            let slot_ptr = ptr_offset(self.buckets, (slot as i64) * 8);
            ast_write_rawptr(ptr_offset(cur, 24), ast_read_rawptr(slot_ptr));
            ast_write_rawptr(slot_ptr, cur);
            cur = ast_read_rawptr(ptr_offset(cur, 16));
        }
    }
}

fn hir_string_set_create() -> HirStringSet {
    return HirStringSet.create();
}

fn hir_string_set_contains(set: HirStringSet, value: string) -> bool {
    if (value.len == 0) { return false; }
    if (set.buckets != null && set.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(value), set.bucket_cap);
        var bcur = ast_read_rawptr(ptr_offset(set.buckets, (slot as i64) * 8));
        while (bcur != null) {
            let ptr2 = ast_read_rawptr(bcur);
            let len2 = ast_read_i64(ptr_offset(bcur, 8));
            if (hir_builder_c_string_equals(ptr2, len2, value)) { return true; }
            bcur = ast_read_rawptr(ptr_offset(bcur, 24));
        }
        return false;
    }
    var cur = set.head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (hir_builder_c_string_equals(ptr, len, value)) { return true; }
        cur = ast_read_rawptr(ptr_offset(cur, 16));
    }
    return false;
}

fn hir_string_set_add(set: HirStringSet, value: string) -> HirStringSet {
    if (value.len == 0) { return set; }
    set.ensure_buckets();
    if (set.buckets != null && set.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(value), set.bucket_cap);
        let slot_ptr = ptr_offset(set.buckets, (slot as i64) * 8);
        var bcur = ast_read_rawptr(slot_ptr);
        while (bcur != null) {
            let ptr2 = ast_read_rawptr(bcur);
            let len2 = ast_read_i64(ptr_offset(bcur, 8));
            if (hir_builder_c_string_equals(ptr2, len2, value)) { return set; }
            bcur = ast_read_rawptr(ptr_offset(bcur, 24));
        }
        let bnode = hir_profile_malloc(32);
        if (bnode == null) { return set; }
        memset(bnode, 0, 32);
        ast_write_rawptr(bnode, ast_dup_c_string(value));
        ast_write_i64(ptr_offset(bnode, 8), value.len);
        ast_write_rawptr(ptr_offset(bnode, 16), set.head);
        ast_write_rawptr(ptr_offset(bnode, 24), ast_read_rawptr(slot_ptr));
        set.head = bnode;
        ast_write_rawptr(slot_ptr, bnode);
        return set;
    }
    if (hir_string_set_contains(set, value)) { return set; }
    let node = hir_profile_malloc(32);
    if (node == null) { return set; }
    memset(node, 0, 32);
    ast_write_rawptr(node, ast_dup_c_string(value));
    ast_write_i64(ptr_offset(node, 8), value.len);
    ast_write_rawptr(ptr_offset(node, 16), set.head);
    ast_write_rawptr(ptr_offset(node, 24), null);
    set.head = node;
    return set;
}

fn hir_string_set_dispose(set: HirStringSet) -> HirStringSet {
    var cur = set.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 16));
        let key_ptr = ast_read_rawptr(cur);
        if (key_ptr != null) { free(key_ptr); }
        free(cur);
        cur = next;
    }
    if (set.buckets != null) { free(set.buckets); }
    set.head = null;
    set.buckets = null;
    set.bucket_cap = 0;
    return set;
}

class HirRawNameMap {
    public head: rawptr
    public buckets: rawptr
    public bucket_cap: i32

    public static fn create() -> HirRawNameMap {
        return HirRawNameMap { head: null, buckets: null, bucket_cap: 0 };
    }

    fn dispose(self) {
        var cur = self.head;
        while (cur != null) {
            let next = ast_read_rawptr(ptr_offset(cur, 24));
            let key_ptr = ast_read_rawptr(cur);
            if (key_ptr != null) { free(key_ptr); }
            free(cur);
            cur = next;
        }
        if (self.buckets != null) { free(self.buckets); }
        self.head = null;
        self.buckets = null;
        self.bucket_cap = 0;
    }

    fn put(self, key: string, value: rawptr) {
        if (key.len == 0 || value == null) { return; }
        self.ensure_buckets();
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(key), self.bucket_cap);
            let slot_ptr = ptr_offset(self.buckets, (slot as i64) * 8);
            var bcur = ast_read_rawptr(slot_ptr);
            while (bcur != null) {
                let ptr2 = ast_read_rawptr(bcur);
                let len2 = ast_read_i64(ptr_offset(bcur, 8));
                if (hir_builder_c_string_equals(ptr2, len2, key)) {
                    ast_write_rawptr(ptr_offset(bcur, 16), value);
                    return;
                }
                bcur = ast_read_rawptr(ptr_offset(bcur, 32));
            }
            let bnode = hir_profile_malloc(40);
            if (bnode == null) { return; }
            memset(bnode, 0, 40);
            ast_write_rawptr(bnode, ast_dup_c_string(key));
            ast_write_i64(ptr_offset(bnode, 8), key.len);
            ast_write_rawptr(ptr_offset(bnode, 16), value);
            ast_write_rawptr(ptr_offset(bnode, 24), self.head);
            ast_write_rawptr(ptr_offset(bnode, 32), ast_read_rawptr(slot_ptr));
            self.head = bnode;
            ast_write_rawptr(slot_ptr, bnode);
            return;
        }
        var cur = self.head;
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(ptr, len, key)) {
                ast_write_rawptr(ptr_offset(cur, 16), value);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        let node = hir_profile_malloc(40);
        if (node == null) { return; }
        memset(node, 0, 40);
        ast_write_rawptr(node, ast_dup_c_string(key));
        ast_write_i64(ptr_offset(node, 8), key.len);
        ast_write_rawptr(ptr_offset(node, 16), value);
        ast_write_rawptr(ptr_offset(node, 24), self.head);
        ast_write_rawptr(ptr_offset(node, 32), null);
        self.head = node;
    }

    fn get(self, key: string) -> rawptr {
        if (key.len == 0) { return null; }
        if (self.buckets != null && self.bucket_cap > 0) {
            let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(key), self.bucket_cap);
            var bcur = ast_read_rawptr(ptr_offset(self.buckets, (slot as i64) * 8));
            while (bcur != null) {
                let ptr2 = ast_read_rawptr(bcur);
                let len2 = ast_read_i64(ptr_offset(bcur, 8));
                if (hir_builder_c_string_equals(ptr2, len2, key)) {
                    return ast_read_rawptr(ptr_offset(bcur, 16));
                }
                bcur = ast_read_rawptr(ptr_offset(bcur, 32));
            }
            return null;
        }
        var cur = self.head;
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(ptr, len, key)) {
                return ast_read_rawptr(ptr_offset(cur, 16));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return null;
    }

    fn ensure_buckets(self) {
        if (self.buckets != null && self.bucket_cap > 0) { return; }
        self.bucket_cap = 65536;
        self.buckets = hir_builder_alloc_ptr_buckets(self.bucket_cap);
        if (self.buckets == null) {
            self.bucket_cap = 0;
            return;
        }
        var cur = self.head;
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            let key = ast_borrow_c_string(ptr, len);
            let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(key), self.bucket_cap);
            let slot_ptr = ptr_offset(self.buckets, (slot as i64) * 8);
            ast_write_rawptr(ptr_offset(cur, 32), ast_read_rawptr(slot_ptr));
            ast_write_rawptr(slot_ptr, cur);
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
    }
}

fn hir_raw_name_map_create() -> HirRawNameMap {
    return HirRawNameMap.create();
}

fn hir_raw_name_map_create_with_bucket_cap(cap: i32) -> HirRawNameMap {
    var out = HirRawNameMap.create();
    if (cap > 0) {
        out.bucket_cap = cap;
        out.buckets = hir_builder_alloc_ptr_buckets(out.bucket_cap);
        if (out.buckets == null) { out.bucket_cap = 0; }
    }
    return out;
}

fn hir_raw_name_map_create_small() -> HirRawNameMap {
    return hir_raw_name_map_create_with_bucket_cap(1024);
}

fn hir_raw_name_map_put(map: HirRawNameMap, key: string, value: rawptr) -> HirRawNameMap {
    if (key.len == 0 || value == null) { return map; }
    map.ensure_buckets();
    if (map.buckets != null && map.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(key), map.bucket_cap);
        let slot_ptr = ptr_offset(map.buckets, (slot as i64) * 8);
        var bcur = ast_read_rawptr(slot_ptr);
        while (bcur != null) {
            let ptr2 = ast_read_rawptr(bcur);
            let len2 = ast_read_i64(ptr_offset(bcur, 8));
            if (hir_builder_c_string_equals(ptr2, len2, key)) {
                ast_write_rawptr(ptr_offset(bcur, 16), value);
                return map;
            }
            bcur = ast_read_rawptr(ptr_offset(bcur, 32));
        }
        let bnode = hir_profile_malloc(40);
        if (bnode == null) { return map; }
        memset(bnode, 0, 40);
        ast_write_rawptr(bnode, ast_dup_c_string(key));
        ast_write_i64(ptr_offset(bnode, 8), key.len);
        ast_write_rawptr(ptr_offset(bnode, 16), value);
        ast_write_rawptr(ptr_offset(bnode, 24), map.head);
        ast_write_rawptr(ptr_offset(bnode, 32), ast_read_rawptr(slot_ptr));
        map.head = bnode;
        ast_write_rawptr(slot_ptr, bnode);
        return map;
    }
    var cur = map.head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (hir_builder_c_string_equals(ptr, len, key)) {
            ast_write_rawptr(ptr_offset(cur, 16), value);
            return map;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    let node = hir_profile_malloc(40);
    if (node == null) { return map; }
    memset(node, 0, 40);
    ast_write_rawptr(node, ast_dup_c_string(key));
    ast_write_i64(ptr_offset(node, 8), key.len);
    ast_write_rawptr(ptr_offset(node, 16), value);
    ast_write_rawptr(ptr_offset(node, 24), map.head);
    ast_write_rawptr(ptr_offset(node, 32), null);
    map.head = node;
    return map;
}

fn hir_raw_name_map_get(map: HirRawNameMap, key: string) -> rawptr {
    if (key.len == 0) { return null; }
    if (map.buckets != null && map.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(key), map.bucket_cap);
        var bcur = ast_read_rawptr(ptr_offset(map.buckets, (slot as i64) * 8));
        while (bcur != null) {
            let ptr2 = ast_read_rawptr(bcur);
            let len2 = ast_read_i64(ptr_offset(bcur, 8));
            if (hir_builder_c_string_equals(ptr2, len2, key)) {
                return ast_read_rawptr(ptr_offset(bcur, 16));
            }
            bcur = ast_read_rawptr(ptr_offset(bcur, 32));
        }
        return null;
    }
    var cur = map.head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (hir_builder_c_string_equals(ptr, len, key)) {
            return ast_read_rawptr(ptr_offset(cur, 16));
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    return null;
}

fn hir_raw_name_map_dispose(map: HirRawNameMap) -> HirRawNameMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 24));
        let key_ptr = ast_read_rawptr(cur);
        if (key_ptr != null) { free(key_ptr); }
            free(cur);
        cur = next;
    }
    if (map.buckets != null) { free(map.buckets); }
    map.head = null;
    map.buckets = null;
    map.bucket_cap = 0;
    return map;
}

fn hir_builder_raw_decl_external_priority(d: rawptr) -> i32 {
    if (d == null) { return 0; }
    if (hir_builder_decl_from_std_module(d)) { return 2; }
    if (hir_builder_decl_imported(d)) { return 1; }
    return 0;
}

fn hir_builder_string_hash_i32(value: string) -> i32 {
    var h: i64 = 5381;
    var i: i32 = 0;
    while (i < value.len) {
        h = ((h * 33) + (value.charAt(i) as i64) + 1) % 2147483647;
        i = i + 1;
    }
    return h as i32;
}

fn hir_builder_pair_hash_i32(owner: string, member: string) -> i32 {
    var h: i64 = 5381;
    var i: i32 = 0;
    while (i < owner.len) {
        h = ((h * 33) + (owner.charAt(i) as i64) + 1) % 2147483647;
        i = i + 1;
    }
    h = ((h * 33) + 124) % 2147483647;
    i = 0;
    while (i < member.len) {
        h = ((h * 33) + (member.charAt(i) as i64) + 1) % 2147483647;
        i = i + 1;
    }
    return h as i32;
}

fn hir_builder_hash_slot(hash: i32, cap: i32) -> i32 {
    if (cap <= 0) { return 0; }
    var h = hash;
    if (h < 0) { h = -h; }
    return h % cap;
}

fn hir_builder_alloc_ptr_buckets(cap: i32) -> rawptr {
    if (cap <= 0) { return null; }
    let bytes = (cap as u64) * 8;
    let buckets = hir_profile_malloc(bytes);
    if (buckets == null) { return null; }
    memset(buckets, 0, bytes);
    return buckets;
}

class HirNameIdMap {
    public head: rawptr
    public buckets: rawptr
    public bucket_cap: i32

    public static fn create() -> HirNameIdMap {
        return HirNameIdMap { head: null, buckets: null, bucket_cap: 0 };
    }

    fn dispose(self) {
        var cur = self.head;
        while (cur != null) {
            let next = ast_read_rawptr(ptr_offset(cur, 24));
            let key_ptr = ast_read_rawptr(cur);
            if (key_ptr != null) { free(key_ptr); }
            free(cur);
            cur = next;
        }
        if (self.buckets != null) { free(self.buckets); }
        self.head = null;
        self.buckets = null;
        self.bucket_cap = 0;
    }

    fn put(self, key: string, value: i32) {
        if (key.len == 0 || value == hir_id_invalid()) { return; }
        var cur = self.head;
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(ptr, len, key)) {
                ast_write_i32(ptr_offset(cur, 16), value);
                return;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        let node = hir_profile_malloc(32);
        if (node == null) { return; }
        memset(node, 0, 32);
        ast_write_rawptr(node, ast_dup_c_string(key));
        ast_write_i64(ptr_offset(node, 8), key.len);
        ast_write_i32(ptr_offset(node, 16), value);
        ast_write_rawptr(ptr_offset(node, 24), self.head);
        self.head = node;
    }

    fn put_first(self, key: string, value: i32) {
        if (key.len == 0 || value == hir_id_invalid()) { return; }
        if (self.get(key) != hir_id_invalid()) { return; }
        self.put(key, value);
    }

    fn get(self, key: string) -> i32 {
        if (key.len == 0) { return hir_id_invalid(); }
        var cur = self.head;
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(ptr, len, key)) {
                return ast_read_i32(ptr_offset(cur, 16));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 24));
        }
        return hir_id_invalid();
    }
}

fn hir_name_id_map_create() -> HirNameIdMap {
    return HirNameIdMap.create();
}

fn hir_name_id_map_create_with_bucket_cap(cap: i32) -> HirNameIdMap {
    var out = HirNameIdMap.create();
    if (cap > 0) {
        out.bucket_cap = cap;
        out.buckets = hir_builder_alloc_ptr_buckets(out.bucket_cap);
        if (out.buckets == null) { out.bucket_cap = 0; }
    }
    return out;
}

fn hir_name_id_map_create_small() -> HirNameIdMap {
    return hir_name_id_map_create_with_bucket_cap(1024);
}

fn hir_name_id_map_ensure_buckets(map: HirNameIdMap) -> HirNameIdMap {
    if (map.buckets != null && map.bucket_cap > 0) { return map; }
    map.bucket_cap = 65536;
    map.buckets = hir_builder_alloc_ptr_buckets(map.bucket_cap);
    if (map.buckets == null) {
        map.bucket_cap = 0;
        return map;
    }
    var cur = map.head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        let key = ast_borrow_c_string(ptr, len);
        let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(key), map.bucket_cap);
        let slot_ptr = ptr_offset(map.buckets, (slot as i64) * 8);
        ast_write_rawptr(ptr_offset(cur, 32), ast_read_rawptr(slot_ptr));
        ast_write_rawptr(slot_ptr, cur);
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    return map;
}

fn hir_name_id_map_put(map: HirNameIdMap, key: string, value: i32) -> HirNameIdMap {
    if (key.len == 0 || value == hir_id_invalid()) { return map; }
    map = hir_name_id_map_ensure_buckets(map);
    if (map.buckets != null && map.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(key), map.bucket_cap);
        let slot_ptr = ptr_offset(map.buckets, (slot as i64) * 8);
        var cur = ast_read_rawptr(slot_ptr);
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(ptr, len, key)) {
                ast_write_i32(ptr_offset(cur, 16), value);
                return map;
            }
            cur = ast_read_rawptr(ptr_offset(cur, 32));
        }
        let node = hir_profile_malloc(40);
        if (node == null) { return map; }
        memset(node, 0, 40);
        ast_write_rawptr(node, ast_dup_c_string(key));
        ast_write_i64(ptr_offset(node, 8), key.len);
        ast_write_i32(ptr_offset(node, 16), value);
        ast_write_rawptr(ptr_offset(node, 24), map.head);
        ast_write_rawptr(ptr_offset(node, 32), ast_read_rawptr(slot_ptr));
        map.head = node;
        ast_write_rawptr(slot_ptr, node);
        return map;
    }
    var cur = map.head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (hir_builder_c_string_equals(ptr, len, key)) {
            ast_write_i32(ptr_offset(cur, 16), value);
            return map;
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    let node = hir_profile_malloc(40);
    if (node == null) { return map; }
    memset(node, 0, 40);
    ast_write_rawptr(node, ast_dup_c_string(key));
    ast_write_i64(ptr_offset(node, 8), key.len);
    ast_write_i32(ptr_offset(node, 16), value);
    ast_write_rawptr(ptr_offset(node, 24), map.head);
    ast_write_rawptr(ptr_offset(node, 32), null);
    map.head = node;
    return map;
}

fn hir_name_id_map_put_first(map: HirNameIdMap, key: string, value: i32) -> HirNameIdMap {
    if (key.len == 0 || value == hir_id_invalid()) { return map; }
    if (hir_name_id_map_get(map, key) != hir_id_invalid()) { return map; }
    return hir_name_id_map_put(map, key, value);
}

fn hir_name_id_map_get(map: HirNameIdMap, key: string) -> i32 {
    if (key.len == 0) { return hir_id_invalid(); }
    if (map.buckets != null && map.bucket_cap > 0) {
        let slot = hir_builder_hash_slot(hir_builder_string_hash_i32(key), map.bucket_cap);
        var cur = ast_read_rawptr(ptr_offset(map.buckets, (slot as i64) * 8));
        while (cur != null) {
            let ptr = ast_read_rawptr(cur);
            let len = ast_read_i64(ptr_offset(cur, 8));
            if (hir_builder_c_string_equals(ptr, len, key)) {
                return ast_read_i32(ptr_offset(cur, 16));
            }
            cur = ast_read_rawptr(ptr_offset(cur, 32));
        }
        return hir_id_invalid();
    }
    var cur = map.head;
    while (cur != null) {
        let ptr = ast_read_rawptr(cur);
        let len = ast_read_i64(ptr_offset(cur, 8));
        if (hir_builder_c_string_equals(ptr, len, key)) {
            return ast_read_i32(ptr_offset(cur, 16));
        }
        cur = ast_read_rawptr(ptr_offset(cur, 24));
    }
    return hir_id_invalid();
}

fn hir_name_id_map_dispose(map: HirNameIdMap) -> HirNameIdMap {
    var cur = map.head;
    while (cur != null) {
        let next = ast_read_rawptr(ptr_offset(cur, 24));
        let key_ptr = ast_read_rawptr(cur);
        if (key_ptr != null) { free(key_ptr); }
            free(cur);
        cur = next;
    }
    if (map.buckets != null) { free(map.buckets); }
    map.head = null;
    map.buckets = null;
    map.bucket_cap = 0;
    return map;
}
