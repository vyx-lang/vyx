module bootstrap.hir_builder;

use bootstrap.ast;
use bootstrap.dci_dcib;
use bootstrap.dci_binder;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_native_init;
use bootstrap.hir_type_table;
use bootstrap.policy;
use bootstrap.sema;

// Text helpers for the HIR builder. See README.md.

// Membership in a pipe-separated root list, including its implicit outer
// delimiters. Compare the existing bytes instead of copying the whole list
// into "|" + roots + "|" for each declaration.
fn hir_builder_root_name_contains(roots: string, name: string) -> bool {
    if (name.len == 0) { return false; }
    var start: i64 = 0;
    while (start + name.len <= roots.len) {
        let end = start + name.len;
        if ((start == 0 || roots.charAt((start - 1) as i32) == 124)
            && (end == roots.len || roots.charAt(end as i32) == 124)
            && strncmp(ptr_offset(roots.c_str(), start), name.c_str(), name.len) == 0) {
            return true;
        }
        start = start + 1;
    }
    return false;
}

// Generic root requests are immutable during a builder's lifetime. Parse
// them once, retaining order and duplicates for the original instance loop.
fn hir_builder_generic_root_names(roots: string) -> string {
    if (!hir_builder_string_contains(roots, "<")) { return ""; }
    let buf = malloc((roots.len + 1) as u64);
    if (buf == null) { return roots; } // Original loop remains correct.
    var used: i64 = 0;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= roots.len) {
        if (i == roots.len || roots.charAt(i as i32) == 124) {
            let root = roots.substring(start as i32, i as i32);
            if (policy_generic_call_args(root.clone()).len > 0) {
                if (used > 0) {
                    memcpy(ptr_offset(buf, used), "|".c_str(), 1);
                    used = used + 1;
                }
                memcpy(ptr_offset(buf, used), root.c_str(), root.len as u64);
                used = used + root.len;
            }
            start = i + 1;
        }
        i = i + 1;
    }
    let result = from_cstr_len(buf, used);
    free(buf);
    return result;
}

fn hir_builder_c_string_equals(ptr: rawptr, len: i64, value: string) -> bool {
    if (ptr == null || len != value.len) { return false; }
    if (len == 0) { return value.len == 0; }
    return strncmp(ptr, value.c_str(), len) == 0;
}

fn hir_builder_string_contains(hay: string, needle: string) -> bool {
    if (needle.len == 0) { return true; }
    if (hay.len < needle.len) { return false; }
    var i: i64 = 0;
    while (i + needle.len <= hay.len) {
        var j: i64 = 0;
        var same: bool = true;
        while (j < needle.len && same) {
            if (hay.charAt((i + j) as i32) != needle.charAt(j as i32)) { same = false; }
            j = j + 1;
        }
        if (same) { return true; }
        i = i + 1;
    }
    return false;
}

// Compare a concatenated needle without allocating it at each candidate.
fn hir_builder_string_contains_parts(hay: string, prefix: string, middle: string, suffix: string) -> bool {
    let total = (prefix.len as i64) + (middle.len as i64) + (suffix.len as i64);
    if (total == 0) { return true; }
    if ((hay.len as i64) < total) { return false; }
    var i: i64 = 0;
    while (i <= (hay.len as i64) - total) {
        var j: i64 = 0;
        var same = true;
        while (j < total && same) {
            var expected: i32 = 0;
            if (j < prefix.len) { expected = prefix.charAt(j as i32); }
            else if (j < (prefix.len as i64) + (middle.len as i64)) {
                expected = middle.charAt((j - (prefix.len as i64)) as i32);
            } else {
                expected = suffix.charAt((j - (prefix.len as i64) - (middle.len as i64)) as i32);
            }
            if (hay.charAt((i + j) as i32) != expected) { same = false; }
            j = j + 1;
        }
        if (same) { return true; }
        i = i + 1;
    }
    return false;
}

fn hir_builder_method_name_matches_lookup(candidate: string, requested: string) -> bool {
    if (candidate == requested) { return true; }
    let legacy = policy_operator_legacy_method_name(requested);
    if (legacy.len > 0 && candidate == legacy) { return true; }
    let symbol = policy_operator_symbol_method_name(requested);
    if (symbol.len > 0 && candidate == symbol) { return true; }
    return false;
}

fn hir_builder_symbol_segment_for_name(name: string) -> string {
    return policy_mangle_part(name);
}

fn hir_builder_assoc_separator_index(name: string) -> i32 {
    var last: i32 = -1;
    var depth: i32 = 0;
    var i: i32 = 0;
    while (i < name.len) {
        let c = name.charAt(i);
        if (c == 60) {
            depth = depth + 1;
        } else if (c == 62) {
            if (depth > 0) { depth = depth - 1; }
        } else if (depth == 0) {
            if (c == 46) {
                last = i;
            } else if (c == 58 && i + 1 < name.len && name.charAt(i + 1) == 58) {
                if (!(i + 2 < name.len && name.charAt(i + 2) == 60)) {
                    last = i;
                }
                i = i + 1;
            }
        }
        i = i + 1;
    }
    return last;
}

fn hir_builder_assoc_separator_len(name: string, index: i32) -> i32 {
    if (index >= 0 && index < name.len && name.charAt(index) == 58) { return 2; }
    return 1;
}

fn hir_builder_type_text_needs_env_resolution(text: string) -> bool {
    var i: i32 = 0;
    while (i < text.len) {
        let c = text.charAt(i);
        if (c == 60 || c == 46) { return true; }
        if (c == 58 && i + 1 < text.len && text.charAt(i + 1) == 58) { return true; }
        i = i + 1;
    }
    return false;
}

fn hir_builder_trim(s: string) -> string {
    if (s.len == 0) { return ""; }
    var start: i32 = 0;
    var end: i32 = s.len as i32;
    while (start < end) {
        let c = s.charAt(start);
        if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
        start = start + 1;
    }
    while (end > start) {
        let c = s.charAt(end - 1);
        if (c != 32 && c != 9 && c != 10 && c != 13) { break; }
        end = end - 1;
    }
    return s.substring(start, end);
}

fn hir_builder_string_is_i64_lit(s: string) -> bool {
    let clean = hir_builder_trim(s);
    let n = clean.len;
    if (n == 0) { return false; }
    var i: i32 = 0;
    if (clean.charAt(0) == 45) {
        if (n == 1) { return false; }
        i = 1;
    }
    while (i < n) {
        let c = clean.charAt(i);
        if (c < 48 || c > 57) { return false; }
        i = i + 1;
    }
    return true;
}

fn hir_builder_lit_is_float(s: string) -> bool {
    let n = s.len;
    if (n <= 0) { return false; }
    var i: i32 = 0;
    while (i < n) {
        let c = s.charAt(i);
        if (c == 46) { return true; }
        if (c == 101 || c == 69) {
            var j = i + 1;
            if (j < n) {
                let next = s.charAt(j);
                if (next == 43 || next == 45) { j = j + 1; }
            }
            if (j < n) {
                let digit = s.charAt(j);
                if (digit >= 48 && digit <= 57) { return true; }
            }
        }
        i = i + 1;
    }
    return false;
}

fn hir_builder_parse_i64_lit(s: string) -> i64 {
    let clean = hir_builder_trim(s);
    var sign: i64 = 1;
    var i: i32 = 0;
    if (clean.len > 0 && clean.charAt(0) == 45) {
        sign = -1;
        i = 1;
    }
    var out: i64 = 0;
    while (i < clean.len) {
        let c = clean.charAt(i);
        if (c < 48 || c > 57) { return 0; }
        out = out * 10 + ((c - 48) as i64);
        i = i + 1;
    }
    return out * sign;
}

fn hir_builder_tuple_member_index(name: string) -> i32 {
    if (name.len == 0) { return -1; }
    var i: i32 = 0;
    if (name.charAt(0) == 95) { i = 1; }
    if (i >= name.len) { return -1; }
    var out: i32 = 0;
    while (i < name.len) {
        let c = name.charAt(i);
        if (c < 48 || c > 57) { return -1; }
        out = out * 10 + (c - 48);
        i = i + 1;
    }
    return out;
}

// Source identity comes from the declaring file, including lazy generic bodies.
fn hir_builder_decl_source_path(d: rawptr) -> string {
    if (d == null) { return ""; }
    let meta = decl_get_meta(d);
    let needle = "|source-path:";
    let at = hir_builder_index_of(meta, needle);
    if (at < 0) { return ""; }
    let start = at + (needle.len as i32);
    var end = start;
    while (end < meta.len && meta.charAt(end) != 124) { end += 1; }
    return meta.substring(start, end);
}
