module bootstrap.hir_verify;

use bootstrap.ast;
use bootstrap.diag;
use bootstrap.hir_ids;
use bootstrap.hir_model;
use bootstrap.hir_type_table;
use bootstrap.policy;

/// Conservative open-template-atom heuristic for verifier-side env checks:
/// an identifier atom is "open" when it is a single uppercase letter (a
/// template parameter by convention) or the literal `Self`.
fn hir_verify_text_has_open_template_atom(text: string) -> bool {
    var i: i32 = 0;
    let n = text.len;
    while (i < n) {
        let c = text.charAt(i);
        let ident_start = (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95;
        if (!ident_start) {
            i = i + 1;
        } else {
            var j = i + 1;
            while (j < n) {
                let cj = text.charAt(j);
                let ident_cont = (cj >= 65 && cj <= 90) || (cj >= 97 && cj <= 122) || (cj >= 48 && cj <= 57) || cj == 95;
                if (!ident_cont) { break; }
                j = j + 1;
            }
            if (j - i == 1 && c >= 65 && c <= 90) { return true; }
            if (j - i == 4 && text.substring(i, j) == "Self") { return true; }
            i = j;
        }
    }
    return false;
}

fn hir_verify_csv_count(text: string) -> i32 {
    if (text.len == 0) { return 0; }
    var count: i32 = 0;
    while (count < 256) {
        let item = policy_generic_arg_at(text, count);
        if (item.len == 0) { return count; }
        count = count + 1;
    }
    return count;
}

fn hir_verify_legacy_string_primitive_text(text_in: string) -> bool {
    let text = text_in.trim();
    if (text == "string" || text == "__String") { return true; }
    if (policy_generic_call_has_args(text.clone()) != 0) {
        let raw_args = policy_generic_call_args(text.clone());
        var i: i32 = 0;
        while (i < 64) {
            let arg = policy_generic_arg_at(raw_args, i).trim();
            if (arg.len == 0) { return false; }
            if (hir_verify_legacy_string_primitive_text(arg)) { return true; }
            i = i + 1;
        }
    }
    return false;
}

public class HirVerifier {
    public errors: i32
    public print_summary: bool

    public static fn create() -> HirVerifier {
        return HirVerifier { errors: 0, print_summary: true };
    }

    public static fn create_silent() -> HirVerifier {
        return HirVerifier { errors: 0, print_summary: false };
    }

    public fn record_error(self, msg: string) {
        self.errors = self.errors + 1;
        diag_emit(diag_sev_ERROR(),
                  diag_code_internal(),
                  1,
                  1,
                  "HIR verify: " + msg);
        diag_emit_help_at(diag_code_internal(),
                            null,
                            "this HIR unit is internally inconsistent; reduce the input or report a compiler bug");
    }

    public fn id_text(self, id: i32) -> string {
        return policy_i64_to_string(id as i64);
    }

    public fn type_text(self, h: HirUnit, id: i32) -> string {
        if (id < 1 || id > h.types.count) { return "-"; }
        return hir_type_table_text(h.types, id);
    }

    public fn function_text(self, h: HirUnit, id: i32) -> string {
        if (id < 1 || id > h.function_count || h.function_record(id) == null) { return "-"; }
        return h.function_name(id);
    }

    public fn valid_type(self, h: HirUnit, id: i32, allow_empty: bool, where_text: string) -> bool {
        if (id == hir_id_invalid()) {
            if (!allow_empty) { self.record_error(where_text + " references empty TypeId"); }
            return allow_empty;
        }
        if (id < 1 || id > h.types.count || hir_type_table_record(h.types, id) == null) {
            self.record_error(where_text + " references invalid TypeId " + self.id_text(id));
            return false;
        }
        return true;
    }

    public fn valid_item(self, h: HirUnit, id: i32, allow_empty: bool, where_text: string) -> bool {
        if (id == hir_id_invalid()) {
            if (!allow_empty) { self.record_error(where_text + " references empty ItemId"); }
            return allow_empty;
        }
        if (id < 1 || id > h.item_count || h.item_record(id) == null) {
            self.record_error(where_text + " references invalid ItemId " + self.id_text(id));
            return false;
        }
        return true;
    }

    public fn valid_builtin(self, h: HirUnit, id: i32, allow_empty: bool, where_text: string) -> bool {
        if (id == hir_id_invalid()) {
            if (!allow_empty) { self.record_error(where_text + " references empty BuiltinId"); }
            return allow_empty;
        }
        if (id < 1 || id > h.builtin_count || h.builtin_record(id) == null) {
            self.record_error(where_text + " references invalid BuiltinId " + self.id_text(id));
            return false;
        }
        return true;
    }

    public fn valid_function(self, h: HirUnit, id: i32, allow_empty: bool, where_text: string) -> bool {
        if (id == hir_id_invalid()) {
            if (!allow_empty) { self.record_error(where_text + " references empty FunctionId"); }
            return allow_empty;
        }
        if (id < 1 || id > h.function_count || h.function_record(id) == null) {
            self.record_error(where_text + " references invalid FunctionId " + self.id_text(id));
            return false;
        }
        return true;
    }

    public fn valid_local(self, h: HirUnit, id: i32, allow_empty: bool, where_text: string) -> bool {
        if (id == hir_id_invalid()) {
            if (!allow_empty) { self.record_error(where_text + " references empty LocalId"); }
            return allow_empty;
        }
        if (id < 1 || id > h.local_count || h.local_record(id) == null) {
            self.record_error(where_text + " references invalid LocalId " + self.id_text(id));
            return false;
        }
        return true;
    }

    public fn valid_stmt(self, h: HirUnit, id: i32, allow_empty: bool, where_text: string) -> bool {
        if (id == hir_id_invalid()) {
            if (!allow_empty) { self.record_error(where_text + " references empty StmtId"); }
            return allow_empty;
        }
        if (id < 1 || id > h.stmt_count || h.stmt_record(id) == null) {
            self.record_error(where_text + " references invalid StmtId " + self.id_text(id));
            return false;
        }
        return true;
    }

    public fn valid_expr(self, h: HirUnit, id: i32, allow_empty: bool, where_text: string) -> bool {
        if (id == hir_id_invalid()) {
            if (!allow_empty) { self.record_error(where_text + " references empty ExprId"); }
            return allow_empty;
        }
        if (id < 1 || id > h.expr_count || h.expr_record(id) == null) {
            self.record_error(where_text + " references invalid ExprId " + self.id_text(id));
            return false;
        }
        return true;
    }

    public fn item_kind_valid(self, k: i32) -> bool {
        if (k == hir_item_module()) { return true; }
        if (k == hir_item_function()) { return true; }
        if (k == hir_item_extern_function()) { return true; }
        if (k == hir_item_class()) { return true; }
        if (k == hir_item_interface()) { return true; }
        if (k == hir_item_enum()) { return true; }
        if (k == hir_item_field()) { return true; }
        if (k == hir_item_method()) { return true; }
        if (k == hir_item_variant()) { return true; }
        if (k == hir_item_const()) { return true; }
        if (k == hir_item_global()) { return true; }
        if (k == hir_item_type_alias()) { return true; }
        if (k == hir_item_closure()) { return true; }
        return false;
    }

    public fn stmt_kind_valid(self, k: i32) -> bool {
        if (k == hir_stmt_expr()) { return true; }
        if (k == hir_stmt_let()) { return true; }
        if (k == hir_stmt_var()) { return true; }
        if (k == hir_stmt_if()) { return true; }
        if (k == hir_stmt_while()) { return true; }
        if (k == hir_stmt_break()) { return true; }
        if (k == hir_stmt_continue()) { return true; }
        if (k == hir_stmt_return()) { return true; }
        if (k == hir_stmt_block()) { return true; }
        if (k == hir_stmt_for()) { return true; }
        if (k == hir_stmt_foreach()) { return true; }
        if (k == hir_stmt_match()) { return true; }
        if (k == hir_stmt_defer()) { return true; }
        if (k == hir_stmt_static_assert()) { return true; }
        return false;
    }

    public fn function_item_kind_valid(self, k: i32) -> bool {
        if (k == hir_item_function()) { return true; }
        if (k == hir_item_method()) { return true; }
        if (k == hir_item_extern_function()) { return true; }
        if (k == hir_item_closure()) { return true; }
        return false;
    }

    public fn function_allows_bodyless_target(self, h: HirUnit, function_id: i32) -> bool {
        if (function_id == hir_id_invalid()) { return false; }
        if (h.function_body(function_id) != hir_id_invalid()) { return true; }
        let item_id = h.function_item(function_id);
        if (item_id == hir_id_invalid()) { return false; }
        let item_kind = h.item_kind(item_id);
        if (item_kind == hir_item_extern_function()) { return true; }
        if ((hir_unit_function_flags(h, function_id) & hir_function_flag_imported_body()) != 0) { return true; }
        let owner_item = h.item_owner(item_id);
        if (owner_item != hir_id_invalid() && h.item_kind(owner_item) == hir_item_interface()) { return true; }
        return false;
    }

    public fn type_id_has_open_template_atom(self, h: HirUnit, type_id: i32) -> bool {
        if (type_id < 1 || type_id > h.types.count || hir_type_table_record(h.types, type_id) == null) {
            return false;
        }
        return (hir_type_table_flags(h.types, type_id) & hir_type_flag_open()) != 0;
    }

    public fn type_list_has_open_template_atom(self, h: HirUnit, head_id: i32) -> bool {
        var cur = head_id;
        var guard: i32 = 0;
        let guard_limit: i32 = h.tlist_count + 2;
        while (cur != hir_id_invalid() && guard < guard_limit) {
            let type_id = hir_unit_type_list_node_type(h, cur);
            if (self.type_id_has_open_template_atom(h, type_id)) { return true; }
            cur = hir_unit_type_list_node_next(h, cur);
            guard = guard + 1;
        }
        return false;
    }

    public fn function_generic_env_has_open_template_atom(self, h: HirUnit, fn_id: i32) -> bool {
        let env_id = hir_unit_function_generic_env_id(h, fn_id);
        if (env_id != hir_id_invalid()) {
            if (self.type_list_has_open_template_atom(h, hir_unit_genv_arg_list(h, env_id))) { return true; }
            let owner_type_id = hir_unit_genv_owner_type(h, env_id);
            if (owner_type_id != hir_id_invalid()
                && self.type_id_has_open_template_atom(h, owner_type_id)) {
                return true;
            }
            return false;
        }
        if (hir_verify_text_has_open_template_atom(h.function_generic_args(fn_id))) { return true; }
        return hir_verify_text_has_open_template_atom(h.function_owner_type(fn_id));
    }

    public fn function_needs_closed_signature(self, h: HirUnit, function_id: i32) -> bool {
        if (function_id < 1 || function_id > h.function_count || h.function_record(function_id) == null) {
            return false;
        }
        if (h.function_body(function_id) != hir_id_invalid()) { return true; }
        if ((hir_unit_function_flags(h, function_id) & hir_function_flag_codegen_root()) != 0) { return true; }
        return false;
    }

    public fn check_closed_function_signature(self, h: HirUnit, function_id: i32, where_text: string) {
        if (function_id < 1 || function_id > h.function_count || h.function_record(function_id) == null) { return; }
        if (!self.function_generic_env_is_closed(h, function_id)) {
            self.record_error(where_text + " has open generic env params="
                              + h.function_generic_params(function_id)
                              + " args=" + h.function_generic_args(function_id)
                              + " owner=" + h.function_owner_type(function_id));
        }
        let return_type = h.function_return_type(function_id);
        if (self.type_id_has_open_template_atom(h, return_type)) {
            self.record_error(where_text + " has open return type "
                              + self.id_text(return_type)
                              + ":" + self.type_text(h, return_type));
        }
    }

    public fn check_items(self, h: HirUnit) {
        var id: i32 = 1;
        while (id <= h.item_count) {
            let k = h.item_kind(id);
            if (!self.item_kind_valid(k)) {
                self.record_error("item " + self.id_text(id) + " has invalid kind " + self.id_text(k));
            }
            self.valid_type(h, h.item_type(id), true, "item " + self.id_text(id));
            self.valid_item(h, h.item_owner(id), true, "item " + self.id_text(id) + " owner");
            self.valid_function(h, h.item_function(id), true, "item " + self.id_text(id) + " function");
            self.valid_item(h, h.item_first_member(id), true, "item " + self.id_text(id) + " first member");
            self.valid_item(h, h.item_next_sibling(id), true, "item " + self.id_text(id) + " next sibling");
            self.valid_stmt(h, h.item_init(id), true, "item " + self.id_text(id) + " init");
            id = id + 1;
        }
    }

    public fn check_types(self, h: HirUnit) {
        var id: i32 = 1;
        while (id <= h.types.count) {
            if (hir_type_table_record(h.types, id) != null) {
                let kind = hir_type_table_kind(h.types, id);
                let text = hir_type_table_text(h.types, id);
                if (kind == ty_STRING()) {
                    if (text != "str") {
                        self.record_error("type " + self.id_text(id)
                                          + " is str ABI TypeId but text is `"
                                          + text
                                          + "`; expected `str` to match old codegen string ABI");
                    }
                } else {
                    if (text == "str" || hir_verify_legacy_string_primitive_text(text)) {
                        self.record_error("type " + self.id_text(id)
                                          + " has string primitive text `"
                                          + text
                                          + "` but kind is "
                                          + self.id_text(kind)
                                          + "; str ABI must be represented by ty_STRING");
                    }
                }
            }
            id = id + 1;
        }
    }

    public fn check_builtins(self, h: HirUnit) {
        var id: i32 = 1;
        while (id <= h.builtin_count) {
            if (h.builtin_name(id).len == 0) {
                self.record_error("builtin " + self.id_text(id) + " has empty name");
            }
            self.valid_type(h, h.builtin_owner_type(id), true, "builtin " + self.id_text(id) + " owner type");
            id = id + 1;
        }
    }

    public fn check_functions(self, h: HirUnit) {
        var id: i32 = 1;
        while (id <= h.function_count) {
            let item_id = h.function_item(id);
            if (self.valid_item(h, item_id, false, "function " + self.id_text(id) + " item")) {
                if (!self.function_item_kind_valid(h.item_kind(item_id))) {
                    self.record_error("function " + self.id_text(id) + " is owned by non-function item " + self.id_text(item_id));
                }
            }
            self.valid_type(h, h.function_return_type(id), false, "function " + self.id_text(id) + " return");
            self.valid_local(h, h.function_first_local(id), true, "function " + self.id_text(id) + " first local");
            self.valid_stmt(h, h.function_body(id), true, "function " + self.id_text(id) + " body");
            if (self.function_needs_closed_signature(h, id)) {
                self.check_closed_function_signature(h, id, "function " + self.id_text(id));
            }
            id = id + 1;
        }
    }

    public fn check_locals(self, h: HirUnit) {
        var id: i32 = 1;
        while (id <= h.local_count) {
            let flags = h.local_flags(id);
            self.valid_function(h, h.local_function(id), false, "local " + self.id_text(id) + " function");
            self.valid_type(h, h.local_type(id), false, "local " + self.id_text(id) + " type");
            if (self.function_needs_closed_signature(h, h.local_function(id))
                && self.type_id_has_open_template_atom(h, h.local_type(id))) {
                self.record_error("local " + self.id_text(id)
                                  + " in closed function "
                                  + self.id_text(h.local_function(id))
                                  + " has open type "
                                  + self.id_text(h.local_type(id))
                                  + ":" + self.type_text(h, h.local_type(id)));
            }
            self.valid_local(h, h.local_next(id), true, "local " + self.id_text(id) + " next");
            let drop_fn = h.local_drop_function(id);
            if (self.valid_function(h, drop_fn, true, "local " + self.id_text(id) + " drop function")
                && drop_fn != hir_id_invalid()) {
                if (!self.function_allows_bodyless_target(h, drop_fn)) {
                    self.record_error("local " + self.id_text(id)
                                      + " drop function "
                                      + self.id_text(drop_fn)
                                      + " has no executable body");
                }
                if (self.function_needs_closed_signature(h, drop_fn)) {
                    self.check_closed_function_signature(h,
                                                         drop_fn,
                                                         "local " + self.id_text(id)
                                                         + " drop function " + self.id_text(drop_fn));
                }
            }
            if (h.local_name(id).len == 0) {
                self.record_error("local " + self.id_text(id) + " has empty name");
            }
            if ((flags & hir_local_flag_param()) != 0 && h.local_name(id) == "self"
                && (flags & hir_local_flag_self_receiver()) == 0) {
                self.record_error("local " + self.id_text(id)
                                  + " is a self parameter but lacks receiver flag");
            }
            if ((flags & hir_local_flag_param()) != 0
                && (flags & hir_local_flag_self_receiver()) != 0
                && h.local_name(id) != "self") {
                self.record_error("local " + self.id_text(id)
                                  + " has receiver flag but parameter name is `"
                                  + h.local_name(id)
                                  + "`");
            }
            if ((flags & hir_local_flag_self_receiver()) != 0
                && (flags & hir_local_flag_param()) == 0) {
                self.record_error("local " + self.id_text(id)
                                  + " has receiver flag but is not a parameter");
            }
            let receiver_modes = (((flags & hir_local_flag_self_compat()) != 0) as i32)
                + (((flags & hir_local_flag_self_shared_ref()) != 0) as i32)
                + (((flags & hir_local_flag_self_mut_ref()) != 0) as i32)
                + (((flags & hir_local_flag_move_arg()) != 0) as i32);
            if ((flags & hir_local_flag_self_receiver()) != 0 && receiver_modes != 1) {
                self.record_error("local " + self.id_text(id)
                                  + " receiver must carry exactly one ownership mode");
            }
            if ((flags & hir_local_flag_self_receiver()) == 0
                && (flags & (hir_local_flag_self_compat()
                    | hir_local_flag_self_shared_ref()
                    | hir_local_flag_self_mut_ref())) != 0) {
                self.record_error("local " + self.id_text(id)
                                  + " has receiver ownership mode but is not a receiver");
            }
            if ((flags & hir_local_flag_self_receiver()) != 0
                && (flags & hir_local_flag_auto_drop()) != 0
                && (flags & hir_local_flag_move_arg()) == 0) {
                self.record_error("local " + self.id_text(id)
                                  + " borrowed/compat receiver cannot own drop glue");
            }
            if ((flags & hir_local_flag_reference_capture()) != 0
                && (flags & hir_local_flag_capture()) == 0) {
                self.record_error("local " + self.id_text(id)
                                  + " has reference-capture flag but is not a capture");
            }
            if ((flags & hir_local_flag_reference_capture()) != 0
                && (flags & hir_local_flag_self_receiver()) != 0) {
                self.record_error("local " + self.id_text(id)
                                  + " cannot be both receiver parameter and reference capture");
            }
            id = id + 1;
        }
    }

    public fn check_stmt_refs(self, h: HirUnit, id: i32) {
        self.valid_expr(h, h.stmt_expr(id), true, "stmt " + self.id_text(id) + " expr");
        self.valid_expr(h, h.stmt_cond(id), true, "stmt " + self.id_text(id) + " cond");
        self.valid_stmt(h, h.stmt_child(id), true, "stmt " + self.id_text(id) + " child");
        self.valid_stmt(h, h.stmt_else(id), true, "stmt " + self.id_text(id) + " else");
        self.valid_stmt(h, h.stmt_next(id), true, "stmt " + self.id_text(id) + " next");
        self.valid_stmt(h, h.stmt_aux(id), true, "stmt " + self.id_text(id) + " aux");
        self.valid_local(h, h.stmt_local(id), true, "stmt " + self.id_text(id) + " local");
    }

    public fn check_stmts(self, h: HirUnit) {
        var id: i32 = 1;
        while (id <= h.stmt_count) {
            let k = h.stmt_kind(id);
            if (!self.stmt_kind_valid(k)) {
                self.record_error("stmt " + self.id_text(id) + " has invalid kind " + self.id_text(k));
            }
            self.valid_type(h, h.stmt_type(id), true, "stmt " + self.id_text(id) + " type");
            let fn_id = h.stmt_function(id);
            let owner_item = h.stmt_owner_item(id);
            let has_fn = self.valid_function(h, fn_id, true, "stmt " + self.id_text(id) + " function");
            let has_owner = self.valid_item(h, owner_item, true, "stmt " + self.id_text(id) + " owner item");
            if (fn_id == hir_id_invalid() && owner_item == hir_id_invalid()) {
                self.record_error("stmt " + self.id_text(id) + " has neither FunctionId nor owner ItemId");
            }
            if (has_fn && fn_id != hir_id_invalid() && has_owner && owner_item != hir_id_invalid()) {
                let fn_item = h.function_item(fn_id);
                if (fn_item != owner_item) {
                    self.record_error("stmt " + self.id_text(id) + " owner item does not match its function item");
                }
            }
            self.check_stmt_refs(h, id);
            id = id + 1;
        }
    }

    public fn call_sem_valid(self, sem: i32) -> bool {
        if (sem == expr_sem_DIRECT_FN()) { return true; }
        if (sem == expr_sem_METHOD()) { return true; }
        if (sem == expr_sem_VARIANT()) { return true; }
        if (sem == expr_sem_BUILTIN()) { return true; }
        if (sem == expr_sem_INDIRECT_FN()) { return true; }
        return false;
    }

    public fn member_sem_valid(self, sem: i32) -> bool {
        if (sem == expr_sem_METHOD()) { return true; }
        if (sem == expr_sem_FIELD()) { return true; }
        if (sem == expr_sem_CONST()) { return true; }
        if (sem == expr_sem_GLOBAL()) { return true; }
        if (sem == expr_sem_VARIANT()) { return true; }
        if (sem == expr_sem_CLASS()) { return true; }
        if (sem == expr_sem_BUILTIN()) { return true; }
        return false;
    }

    /// True when the expr's containing function has a fully closed generic
    /// env: no unbound generic params, and neither generic args nor the
    /// owner type text carry an open template atom.
    public fn function_generic_env_is_closed(self, h: HirUnit, fn_id: i32) -> bool {
        if (fn_id < 1 || fn_id > h.function_count || h.function_record(fn_id) == null) { return false; }
        let gp = h.function_generic_params(fn_id);
        let ga = h.function_generic_args(fn_id);
        if ((hir_unit_function_flags(h, fn_id) & hir_function_flag_closed_generic_env()) != 0) {
            return !self.function_generic_env_has_open_template_atom(h, fn_id);
        }
        if (gp.len > 0 && ga.len == 0) { return false; }
        if (hir_verify_csv_count(ga) < hir_verify_csv_count(gp)) { return false; }
        return !self.function_generic_env_has_open_template_atom(h, fn_id);
    }

    public fn check_expr_target(self, h: HirUnit, id: i32) {
        let target_kind = h.expr_target_kind(id);
        let target_id = h.expr_target_id(id);
        let expr_context = "expr " + self.id_text(id)
                           + " kind=" + self.id_text(h.expr_kind(id))
                           + " name=" + h.expr_name(id)
                           + " sem=" + self.id_text(h.expr_sem_kind(id))
                           + " target_kind=" + self.id_text(target_kind)
                           + " type=" + self.id_text(h.expr_type(id));
        if (target_kind == hir_target_none()) {
            if (target_id != hir_id_invalid()) {
                self.record_error(expr_context + " has none target kind with non-empty target id");
            }
            return;
        }
        if (target_kind == hir_target_item()) {
            self.valid_item(h, target_id, false, expr_context + " item target");
            return;
        }
        if (target_kind == hir_target_function()) {
            if (self.valid_function(h, target_id, false, expr_context + " function target")
                && !self.function_allows_bodyless_target(h, target_id)) {
                self.record_error(expr_context
                                  + " function target "
                                  + self.id_text(target_id)
                                  + " has no executable body");
            }
            if (self.valid_function(h, target_id, false, expr_context + " function target")
                && self.function_needs_closed_signature(h, target_id)) {
                self.check_closed_function_signature(h,
                                                     target_id,
                                                     expr_context + " function target " + self.id_text(target_id));
            }
            return;
        }
        if (target_kind == hir_target_field()) {
            if (self.valid_item(h, target_id, false, expr_context + " field target")
                && h.item_kind(target_id) != hir_item_field()) {
                self.record_error(expr_context + " field target is not a field item");
            }
            if (self.valid_item(h, target_id, false, expr_context + " field target")
                && self.type_id_has_open_template_atom(h, h.item_type(target_id))
                && self.function_generic_env_is_closed(h, h.expr_function(id))) {
                self.record_error(expr_context
                                  + " field target "
                                  + self.id_text(target_id)
                                  + " has open item type "
                                  + self.id_text(h.item_type(target_id))
                                  + ":" + self.type_text(h, h.item_type(target_id)));
            }
            if ((h.item_flags(target_id) & hir_item_flag_template_member()) != 0
                && self.function_generic_env_is_closed(h, h.expr_function(id))) {
                self.record_error(expr_context
                                  + " binds template field item " + self.id_text(target_id)
                                  + " name=" + h.item_name(target_id)
                                  + " owner=" + h.item_name(h.item_owner(target_id))
                                  + " from closed generic context");
            }
            return;
        }
        if (target_kind == hir_target_variant()) {
            if (self.valid_item(h, target_id, false, expr_context + " variant target")
                && h.item_kind(target_id) != hir_item_variant()) {
                self.record_error(expr_context + " variant target is not a variant item");
            }
            return;
        }
        if (target_kind == hir_target_local()) {
            self.valid_local(h, target_id, false, expr_context + " local target");
            return;
        }
        if (target_kind == hir_target_builtin()) {
            self.valid_builtin(h, target_id, false, expr_context + " builtin target");
            return;
        }
        if (target_kind == hir_target_type()) {
            self.valid_type(h, target_id, false, expr_context + " type target");
            return;
        }
        self.record_error(expr_context + " has invalid target kind " + self.id_text(target_kind));
    }

    public fn check_expr_semantic_target_matrix(self, h: HirUnit, id: i32) {
        let sem = h.expr_sem_kind(id);
        let target_kind = h.expr_target_kind(id);
        let k = h.expr_kind(id);
        if (sem == expr_sem_NONE()) { return; }
        var expected: i32 = hir_target_none();
        var has_expected: bool = true;
        if (sem == expr_sem_LOCAL()) {
            expected = hir_target_local();
        } else if (sem == expr_sem_CONST() || sem == expr_sem_GLOBAL()) {
            expected = hir_target_item();
        } else if (sem == expr_sem_CLASS()) {
            if (target_kind != hir_target_item() && target_kind != hir_target_type()) {
                self.record_error("expr " + self.id_text(id)
                                  + " kind=" + self.id_text(k)
                                  + " name=" + h.expr_name(id)
                                  + " sem=" + self.id_text(sem)
                                  + " expects target_kind="
                                  + self.id_text(hir_target_item())
                                  + " or "
                                  + self.id_text(hir_target_type())
                                  + " but has target_kind="
                                  + self.id_text(target_kind));
            }
            return;
        } else if (sem == expr_sem_DIRECT_FN() || sem == expr_sem_METHOD()) {
            expected = hir_target_function();
        } else if (sem == expr_sem_FIELD()) {
            expected = hir_target_field();
        } else if (sem == expr_sem_VARIANT()) {
            expected = hir_target_variant();
        } else if (sem == expr_sem_BUILTIN()) {
            expected = hir_target_builtin();
        } else if (sem == expr_sem_INDIRECT_FN()) {
            let callee = h.expr_lhs(id);
            var fn_like = false;
            if (callee != hir_id_invalid()) {
                let callee_kind = hir_type_table_kind(h.types, h.expr_type(callee));
                fn_like = callee_kind == ty_FN() || callee_kind == ty_CFN() || callee_kind == ty_RAWPTR();
            }
            if (!fn_like) {
                self.record_error("expr " + self.id_text(id)
                                  + " has indirect call semantic without fn/cfn/rawptr callee type");
            }
            expected = hir_target_none();
        } else {
            has_expected = false;
        }
        if (has_expected && target_kind != expected) {
            self.record_error("expr " + self.id_text(id)
                              + " kind=" + self.id_text(k)
                              + " name=" + h.expr_name(id)
                              + " sem=" + self.id_text(sem)
                              + " expects target_kind="
                              + self.id_text(expected)
                              + " but has target_kind="
                              + self.id_text(target_kind));
        }
    }

    public fn check_expr_value_category(self, h: HirUnit, id: i32) {
        let fn_id = h.expr_function(id);
        if (!self.function_needs_closed_signature(h, fn_id)) { return; }
        let category = h.expr_value_category(id);
        if (category != hir_value_cat_place() && category != hir_value_cat_value()) {
            self.record_error("expr " + self.id_text(id)
                              + " in closed function "
                              + self.id_text(fn_id)
                              + " has no value category");
        }
        let drop_fn = h.expr_drop_function(id);
        if (drop_fn != hir_id_invalid()) {
            self.valid_function(h, drop_fn, false, "expr " + self.id_text(id) + " drop function");
        }
    }

    public fn check_expr_aggregate_field(self, h: HirUnit, id: i32) {
        let field_id = h.expr_aggregate_field(id);
        if (field_id == hir_id_invalid()) { return; }
        let expr_context = "expr " + self.id_text(id)
                           + " aggregate field "
                           + self.id_text(field_id)
                           + " name=" + h.expr_name(id)
                           + " fn=" + self.id_text(h.expr_function(id));
        if (!self.valid_item(h, field_id, false, expr_context)) { return; }
        if (h.item_kind(field_id) != hir_item_field()) {
            self.record_error(expr_context + " does not reference a field item");
            return;
        }
        let owner_item = h.item_owner(field_id);
        if (self.valid_item(h, owner_item, false, expr_context + " owner item")) {
            self.valid_type(h, h.item_type(owner_item), false, expr_context + " owner type");
            if (self.function_generic_env_is_closed(h, h.expr_function(id))
                && self.type_id_has_open_template_atom(h, h.item_type(owner_item))) {
                self.record_error(expr_context
                                  + " owner item has open type "
                                  + self.id_text(h.item_type(owner_item))
                                  + ":" + self.type_text(h, h.item_type(owner_item)));
            }
        }
        self.valid_type(h, h.item_type(field_id), false, expr_context + " field type");
        if (self.function_generic_env_is_closed(h, h.expr_function(id))) {
            if ((h.item_flags(field_id) & hir_item_flag_template_member()) != 0) {
                self.record_error(expr_context + " references template field item from closed generic context");
            }
            if (self.type_id_has_open_template_atom(h, h.item_type(field_id))) {
                self.record_error(expr_context
                                  + " has open field type "
                                  + self.id_text(h.item_type(field_id))
                                  + ":" + self.type_text(h, h.item_type(field_id)));
            }
        }
    }

    public fn check_exprs(self, h: HirUnit) {
        var id: i32 = 1;
        while (id <= h.expr_count) {
            let k = h.expr_kind(id);
            let fn_id = h.expr_function(id);
            self.valid_type(h,
                            h.expr_type(id),
                            false,
                            "expr " + self.id_text(id)
                            + " kind=" + self.id_text(k)
                            + " name=" + h.expr_name(id)
                            + " fn=" + self.id_text(fn_id)
                            + " fn_name=" + self.function_text(h, fn_id)
                            + " sem=" + self.id_text(h.expr_sem_kind(id))
                            + " target_kind=" + self.id_text(h.expr_target_kind(id))
                            + " target=" + self.id_text(h.expr_target_id(id))
                            + " type");
            let owner_item = h.expr_owner_item(id);
            let has_fn = self.valid_function(h, fn_id, true, "expr " + self.id_text(id) + " function");
            let has_owner = self.valid_item(h, owner_item, true, "expr " + self.id_text(id) + " owner item");
            if (fn_id == hir_id_invalid() && owner_item == hir_id_invalid()) {
                self.record_error("expr " + self.id_text(id) + " has neither FunctionId nor owner ItemId");
            }
            if (has_fn && fn_id != hir_id_invalid() && has_owner && owner_item != hir_id_invalid()) {
                let fn_item = h.function_item(fn_id);
                if (fn_item != owner_item) {
                    self.record_error("expr " + self.id_text(id) + " owner item does not match its function item");
                }
            }
            self.valid_expr(h, h.expr_lhs(id), true, "expr " + self.id_text(id) + " lhs");
            if (k == ex_IF_EXPR()) {
                self.valid_stmt(h, h.expr_stmt_rhs(id), false, "if expr " + self.id_text(id) + " then stmt");
                if (h.expr_aux(id) != hir_id_invalid()) {
                    self.valid_expr(h, h.expr_aux(id), false, "if expr " + self.id_text(id) + " else-if expr");
                }
                if (h.expr_stmt_aux(id) != hir_id_invalid()) {
                    self.valid_stmt(h, h.expr_stmt_aux(id), false, "if expr " + self.id_text(id) + " else stmt");
                }
                if (h.expr_rhs(id) != hir_id_invalid()) {
                    self.record_error("if expr " + self.id_text(id) + " stores StmtId in expr rhs slot");
                }
            } else if (k == ex_MATCH_EXPR()) {
                self.valid_stmt(h,
                                h.expr_stmt_rhs(id),
                                false,
                                "match expr " + self.id_text(id) + " arms");
                if (h.expr_rhs(id) != hir_id_invalid() || h.expr_aux(id) != hir_id_invalid()) {
                    self.record_error("match expr " + self.id_text(id) + " stores expression children in reserved slots");
                }
            } else if (k == ex_CLOSURE()) {
                self.valid_expr(h, h.expr_rhs(id), true, "closure expr " + self.id_text(id) + " rhs");
                self.valid_expr(h, h.expr_aux(id), true, "closure expr " + self.id_text(id) + " aux expr");
                self.valid_stmt(h, h.expr_stmt_aux(id), true, "closure expr " + self.id_text(id) + " body stmt");
            } else {
                self.valid_expr(h, h.expr_rhs(id), true, "expr " + self.id_text(id) + " rhs");
                self.valid_expr(h, h.expr_aux(id), true, "expr " + self.id_text(id) + " aux");
                if (h.expr_stmt_rhs(id) != hir_id_invalid() || h.expr_stmt_aux(id) != hir_id_invalid()) {
                    self.record_error("expr " + self.id_text(id) + " has unexpected StmtId child slot");
                }
            }
            self.valid_expr(h, h.expr_first_arg(id), true, "expr " + self.id_text(id) + " first arg");
            self.valid_expr(h, h.expr_next_arg(id), true, "expr " + self.id_text(id) + " next arg");
            if (k == ex_CALL() && !self.call_sem_valid(h.expr_sem_kind(id))) {
                self.record_error("call expr " + self.id_text(id)
                                  + " name=" + h.expr_name(id)
                                  + " fn=" + self.id_text(h.expr_function(id))
                                  + " fn_name=" + self.function_text(h, h.expr_function(id))
                                  + " type=" + self.id_text(h.expr_type(id))
                                  + ":" + self.type_text(h, h.expr_type(id))
                                  + " sem=" + self.id_text(h.expr_sem_kind(id))
                                  + " target_kind=" + self.id_text(h.expr_target_kind(id))
                                  + " target=" + self.id_text(h.expr_target_id(id))
                                  + " has unresolved callee semantic");
            }
            if (k == ex_MEMBER() && !self.member_sem_valid(h.expr_sem_kind(id))) {
                self.record_error("member expr " + self.id_text(id)
                                  + " name=" + h.expr_name(id)
                                  + " fn=" + self.id_text(h.expr_function(id))
                                  + " fn_name=" + self.function_text(h, h.expr_function(id))
                                  + " type=" + self.id_text(h.expr_type(id))
                                  + ":" + self.type_text(h, h.expr_type(id))
                                  + " sem=" + self.id_text(h.expr_sem_kind(id))
                                  + " target_kind=" + self.id_text(h.expr_target_kind(id))
                                  + " target=" + self.id_text(h.expr_target_id(id))
                                  + " has unresolved member semantic");
            }
            if (k == ex_CLOSURE()) {
                if (h.expr_target_kind(id) != hir_target_function()) {
                    self.record_error("closure expr " + self.id_text(id) + " does not target a HIR FunctionId");
                }
            }
            self.check_expr_target(h, id);
            self.check_expr_semantic_target_matrix(h, id);
            self.check_expr_value_category(h, id);
            self.check_expr_aggregate_field(h, id);
            id = id + 1;
        }
    }

    public fn run(self, h: HirUnit) -> i32 {
        if (h.item_buf == null || h.function_buf == null || h.local_buf == null
            || h.stmt_buf == null || h.expr_buf == null || h.types.buf == null
            || h.builtin_buf == null) {
            self.record_error("HIR unit has an unallocated core table");
        }
        self.check_items(h);
        self.check_types(h);
        self.check_builtins(h);
        self.check_functions(h);
        self.check_locals(h);
        self.check_stmts(h);
        self.check_exprs(h);
        let type_count_text = self.id_text(h.types.count);
        if (self.print_summary) {
            print("[hir2-verify] items=" + policy_i64_to_string(h.item_count as i64)
                  + " functions=" + policy_i64_to_string(h.function_count as i64)
                  + " locals=" + policy_i64_to_string(h.local_count as i64)
                  + " stmts=" + policy_i64_to_string(h.stmt_count as i64)
                  + " exprs=" + policy_i64_to_string(h.expr_count as i64)
                  + " types=" + type_count_text
                  + " builtins=" + policy_i64_to_string(h.builtin_count as i64)
                  + " errors=" + policy_i64_to_string(self.errors as i64));
        }
        return self.errors;
    }
}

public fn hir_verify_unit(h: HirUnit) -> i32 {
    // The `[hir2-verify]` summary is auditing evidence (VYX_PHASE_SUMMARY=1).
    if (!policy_phase_summary_enabled()) {
        return hir_verify_unit_silent(h);
    }
    let verifier = HirVerifier.create();
    return verifier.run(h);
}

public fn hir_verify_unit_silent(h: HirUnit) -> i32 {
    let verifier = HirVerifier.create_silent();
    return verifier.run(h);
}
