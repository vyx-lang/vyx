    /// Field index among the owner's layout fields. Stored biased by +1 so a
    /// zeroed record reads back as -1 (unset).
    public fn set_item_field_index(self, item_id: i32, index: i32) {
        let rec = self.item_record(item_id);
        if (rec == null || index < 0) { return; }
        ast_write_i32(ptr_offset(rec, 72), index + 1);
    }

    public fn item_field_index(self, item_id: i32) -> i32 {
        let rec = self.item_record(item_id);
        if (rec == null) { return -1; }
        return ast_read_i32(ptr_offset(rec, 72)) - 1;
    }

    /// Variant tag ordinal among the owner's variants, +1 biased like
    /// field_index (-1 = unset).
    public fn set_item_variant_tag(self, item_id: i32, tag: i32) {
        let rec = self.item_record(item_id);
        if (rec == null || tag < 0) { return; }
        ast_write_i32(ptr_offset(rec, 76), tag + 1);
    }

    public fn item_variant_tag(self, item_id: i32) -> i32 {
        let rec = self.item_record(item_id);
        if (rec == null) { return -1; }
        return ast_read_i32(ptr_offset(rec, 76)) - 1;
    }

