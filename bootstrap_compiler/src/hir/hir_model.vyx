module bootstrap.hir_model;

use bootstrap.ast;
use bootstrap.hir_ids;
use bootstrap.hir_type_table;

extern "C" {
    fn malloc(size: u64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: u64) -> rawptr;
    fn vyx_forget_string_len(s: rawptr);
}

/// Item record layout (96 bytes):
///   0 id | 4 kind | 8 type | 12 owner | 16 function | 20 first_member
///   24 next_sibling | 28 init | 32/40 name ptr/len | 48/56 variant payload
///   text ptr/len | 64 payload_count | 68 flags | 72 field_index+1
///   76 variant_tag+1 | 80 const_value i64 | 88 const_value_state
///   92 payload_type_list head
fn hir_item_record_size() -> i32 { return 96; }

/// Item flag bits live in the i32 at record offset 68.
public fn hir_item_flag_template_member() -> i32 { return 1; }
public fn hir_item_flag_foreign_dci() -> i32 { return 2; }
public fn hir_item_flag_foreign_cpp() -> i32 { return hir_item_flag_foreign_dci(); }
fn hir_builtin_record_size() -> i32 { return 40; }
/// Function record layout (120 bytes): 48..95 unused string slots (cleared
/// after GenericEnvId is published), 96 structured generic env id
/// (source of truth), 100 local-list tail id, 104..119 stable ABI discriminator.
fn hir_function_record_size() -> i32 { return 120; }
fn hir_local_record_size() -> i32 { return 48; }
fn hir_stmt_record_size() -> i32 { return 80; }
/// Stmt loc tail (16 bytes) lives at 64..79.
/// Expr record layout (160 bytes): 0..127 legacy fields, 128 value_category,
/// 132 move_drop_flags (reserved), 136 drop_function id (reserved), 140 spare,
/// 144..159 SourceLoc copied from the AST expr.
fn hir_expr_record_size() -> i32 { return 160; }
/// Generic env record (16 bytes): 0 id | 4 param type-list head
/// | 8 arg type-list head | 12 owner TypeId.
fn hir_genv_record_size() -> i32 { return 16; }
/// TypeId list pool node (16 bytes): 0 id | 4 TypeId | 8 next node | 12 spare.
fn hir_tlist_record_size() -> i32 { return 16; }

fn hir_record_at(buf: rawptr, id: i32, size: i32) -> rawptr {
    if (buf == null || id <= 0) { return null; }
    return ptr_offset(buf, (id - 1) * size);
}

fn hir_write_string(rec: rawptr, ptr_off: i32, len_off: i32, text: string) {
    if (rec == null) { return; }
    let slot = ptr_offset(rec, ptr_off);
    let old_ptr = ast_read_rawptr(slot);
    if (old_ptr != null) {
        vyx_forget_string_len(old_ptr);
        free(old_ptr);
    }
    if (text.len <= 0) {
        ast_write_rawptr(slot, null);
        ast_write_i64(ptr_offset(rec, len_off), 0);
        return;
    }
    ast_write_rawptr(slot, ast_dup_c_string(text));
    ast_write_i64(ptr_offset(rec, len_off), text.len);
}

fn hir_read_string(rec: rawptr, ptr_off: i32, len_off: i32) -> string {
    if (rec == null) { return ""; }
    let ptr = ast_read_rawptr(ptr_offset(rec, ptr_off));
    let len = ast_read_i64(ptr_offset(rec, len_off));
    if (ptr == null || len <= 0) { return ""; }
    return from_cstr_view_len(ptr, len);
}

fn hir_model_csv_at(csv: string, want_idx: i32) -> string {
    if (csv.len == 0 || want_idx < 0) { return ""; }
    var idx: i32 = 0;
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= csv.len) {
        var at_sep = false;
        if (i == csv.len) { at_sep = true; }
        else if (csv.charAt(i) == 44) { at_sep = true; }
        if (at_sep) {
            if (idx == want_idx) { return csv.substring(start, i); }
            idx = idx + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

public class HirUnit {
    public ids: HirIdAllocator
    public types: HirTypeTable
    public item_buf: rawptr
    public item_count: i32
    public item_cap: i32
    public builtin_buf: rawptr
    public builtin_count: i32
    public builtin_cap: i32
    public function_buf: rawptr
    public function_count: i32
    public function_cap: i32
    public local_buf: rawptr
    public local_count: i32
    public local_cap: i32
    public stmt_buf: rawptr
    public stmt_count: i32
    public stmt_cap: i32
    public expr_buf: rawptr
    public expr_count: i32
    public expr_cap: i32
    public genv_buf: rawptr
    public genv_count: i32
    public genv_cap: i32
    public tlist_buf: rawptr
    public tlist_count: i32
    public tlist_cap: i32
    public reflection_manifest: string
    public reflection_name_map: string
    public foreign_cpp_includes: string
    public dci_stub_specs: string
    public interface_supers: string

    public static fn create() -> HirUnit {
        let item_cap0: i32 = 256;
        let builtin_cap0: i32 = 256;
        let fn_cap0: i32 = 256;
        let local_cap0: i32 = 512;
        let stmt_cap0: i32 = 1024;
        let expr_cap0: i32 = 2048;
        let genv_cap0: i32 = 128;
        let tlist_cap0: i32 = 256;
        let item_buf0 = malloc((item_cap0 * hir_item_record_size()) as u64);
        let builtin_buf0 = malloc((builtin_cap0 * hir_builtin_record_size()) as u64);
        let fn_buf0 = malloc((fn_cap0 * hir_function_record_size()) as u64);
        let local_buf0 = malloc((local_cap0 * hir_local_record_size()) as u64);
        let stmt_buf0 = malloc((stmt_cap0 * hir_stmt_record_size()) as u64);
        let expr_buf0 = malloc((expr_cap0 * hir_expr_record_size()) as u64);
        let genv_buf0 = malloc((genv_cap0 * hir_genv_record_size()) as u64);
        let tlist_buf0 = malloc((tlist_cap0 * hir_tlist_record_size()) as u64);
        if (item_buf0 != null) { memset(item_buf0, 0, (item_cap0 * hir_item_record_size()) as u64); }
        if (builtin_buf0 != null) { memset(builtin_buf0, 0, (builtin_cap0 * hir_builtin_record_size()) as u64); }
        if (fn_buf0 != null) { memset(fn_buf0, 0, (fn_cap0 * hir_function_record_size()) as u64); }
        if (local_buf0 != null) { memset(local_buf0, 0, (local_cap0 * hir_local_record_size()) as u64); }
        if (stmt_buf0 != null) { memset(stmt_buf0, 0, (stmt_cap0 * hir_stmt_record_size()) as u64); }
        if (expr_buf0 != null) { memset(expr_buf0, 0, (expr_cap0 * hir_expr_record_size()) as u64); }
        if (genv_buf0 != null) { memset(genv_buf0, 0, (genv_cap0 * hir_genv_record_size()) as u64); }
        if (tlist_buf0 != null) { memset(tlist_buf0, 0, (tlist_cap0 * hir_tlist_record_size()) as u64); }
        return HirUnit {
            ids: HirIdAllocator.create(),
            types: HirTypeTable.create(),
            item_buf: item_buf0,
            item_count: 0,
            item_cap: item_cap0,
            builtin_buf: builtin_buf0,
            builtin_count: 0,
            builtin_cap: builtin_cap0,
            function_buf: fn_buf0,
            function_count: 0,
            function_cap: fn_cap0,
            local_buf: local_buf0,
            local_count: 0,
            local_cap: local_cap0,
            stmt_buf: stmt_buf0,
            stmt_count: 0,
            stmt_cap: stmt_cap0,
            expr_buf: expr_buf0,
            expr_count: 0,
            expr_cap: expr_cap0,
            genv_buf: genv_buf0,
            genv_count: 0,
            genv_cap: genv_cap0,
            tlist_buf: tlist_buf0,
            tlist_count: 0,
            tlist_cap: tlist_cap0,
            reflection_manifest: "",
            reflection_name_map: "",
            foreign_cpp_includes: "",
            dci_stub_specs: "",
            interface_supers: ""
        };
    }

    public fn grow_table(self, old_buf: rawptr, old_count: i32, old_cap: i32, rec_size: i32, want_count: i32) -> rawptr {
        if (want_count <= old_cap) { return old_buf; }
        var new_cap = old_cap;
        if (new_cap <= 0) { new_cap = 128; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let alloc_cap: i64 = new_cap as i64;
        let alloc_rec_size: i64 = rec_size as i64;
        let alloc_bytes: i64 = alloc_cap * alloc_rec_size;
        let new_buf = malloc(alloc_bytes as u64);
        if (new_buf == null) { return old_buf; }
        memset(new_buf, 0, alloc_bytes as u64);
        if (old_buf != null && old_count > 0) {
            let copy_count: i64 = old_count as i64;
            let copy_bytes: i64 = copy_count * alloc_rec_size;
            memcpy(new_buf, old_buf, copy_bytes as u64);
        }
        if (old_buf != null) { free(old_buf); }
        return new_buf;
    }

    public fn ensure_items(self, want_count: i32) {
        if (want_count <= self.item_cap) { return; }
        var new_cap = self.item_cap;
        if (new_cap <= 0) { new_cap = 256; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.item_buf, self.item_count, self.item_cap, hir_item_record_size(), want_count);
        if (new_buf == self.item_buf) { return; }
        self.item_buf = new_buf;
        self.item_cap = new_cap;
    }

    public fn ensure_builtins(self, want_count: i32) {
        if (want_count <= self.builtin_cap) { return; }
        var new_cap = self.builtin_cap;
        if (new_cap <= 0) { new_cap = 256; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.builtin_buf, self.builtin_count, self.builtin_cap, hir_builtin_record_size(), want_count);
        if (new_buf == self.builtin_buf) { return; }
        self.builtin_buf = new_buf;
        self.builtin_cap = new_cap;
    }

    public fn ensure_functions(self, want_count: i32) {
        if (want_count <= self.function_cap) { return; }
        var new_cap = self.function_cap;
        if (new_cap <= 0) { new_cap = 256; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.function_buf, self.function_count, self.function_cap, hir_function_record_size(), want_count);
        if (new_buf == self.function_buf) { return; }
        self.function_buf = new_buf;
        self.function_cap = new_cap;
    }

    public fn ensure_locals(self, want_count: i32) {
        if (want_count <= self.local_cap) { return; }
        var new_cap = self.local_cap;
        if (new_cap <= 0) { new_cap = 512; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.local_buf, self.local_count, self.local_cap, hir_local_record_size(), want_count);
        if (new_buf == self.local_buf) { return; }
        self.local_buf = new_buf;
        self.local_cap = new_cap;
    }

    public fn ensure_stmts(self, want_count: i32) {
        if (want_count <= self.stmt_cap) { return; }
        var new_cap = self.stmt_cap;
        if (new_cap <= 0) { new_cap = 1024; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.stmt_buf, self.stmt_count, self.stmt_cap, hir_stmt_record_size(), want_count);
        if (new_buf == self.stmt_buf) { return; }
        self.stmt_buf = new_buf;
        self.stmt_cap = new_cap;
    }

    public fn ensure_exprs(self, want_count: i32) {
        if (want_count <= self.expr_cap) { return; }
        var new_cap = self.expr_cap;
        if (new_cap <= 0) { new_cap = 2048; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.expr_buf, self.expr_count, self.expr_cap, hir_expr_record_size(), want_count);
        if (new_buf == self.expr_buf) { return; }
        self.expr_buf = new_buf;
        self.expr_cap = new_cap;
    }

    public fn ensure_genvs(self, want_count: i32) {
        if (want_count <= self.genv_cap) { return; }
        var new_cap = self.genv_cap;
        if (new_cap <= 0) { new_cap = 128; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.genv_buf, self.genv_count, self.genv_cap, hir_genv_record_size(), want_count);
        if (new_buf == self.genv_buf) { return; }
        self.genv_buf = new_buf;
        self.genv_cap = new_cap;
    }

    public fn ensure_tlists(self, want_count: i32) {
        if (want_count <= self.tlist_cap) { return; }
        var new_cap = self.tlist_cap;
        if (new_cap <= 0) { new_cap = 256; }
        while (new_cap < want_count) { new_cap = new_cap * 2; }
        let new_buf = self.grow_table(self.tlist_buf, self.tlist_count, self.tlist_cap, hir_tlist_record_size(), want_count);
        if (new_buf == self.tlist_buf) { return; }
        self.tlist_buf = new_buf;
        self.tlist_cap = new_cap;
    }

    public fn item_record(self, id: i32) -> rawptr {
        return hir_record_at(self.item_buf, id, hir_item_record_size());
    }

    public fn builtin_record(self, id: i32) -> rawptr {
        return hir_record_at(self.builtin_buf, id, hir_builtin_record_size());
    }

    public fn function_record(self, id: i32) -> rawptr {
        return hir_record_at(self.function_buf, id, hir_function_record_size());
    }

    public fn local_record(self, id: i32) -> rawptr {
        return hir_record_at(self.local_buf, id, hir_local_record_size());
    }

    public fn stmt_record(self, id: i32) -> rawptr {
        return hir_record_at(self.stmt_buf, id, hir_stmt_record_size());
    }

    public fn expr_record(self, id: i32) -> rawptr {
        return hir_record_at(self.expr_buf, id, hir_expr_record_size());
    }

    public fn genv_record(self, id: i32) -> rawptr {
        return hir_record_at(self.genv_buf, id, hir_genv_record_size());
    }

    public fn tlist_record(self, id: i32) -> rawptr {
        return hir_record_at(self.tlist_buf, id, hir_tlist_record_size());
    }

    public fn add_item(self, kind: i32, name: string, type_id: i32, owner_item_id: i32) -> i32 {
        let id = self.ids.alloc_item();
        self.ensure_items(id);
        let rec = self.item_record(id);
        if (rec == null) { return hir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), kind);
        ast_write_i32(ptr_offset(rec, 8), type_id);
        ast_write_i32(ptr_offset(rec, 12), owner_item_id);
        ast_write_i32(ptr_offset(rec, 16), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 20), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 24), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 28), hir_id_invalid());
        hir_write_string(rec, 32, 40, name);
        hir_write_string(rec, 48, 56, "");
        ast_write_i32(ptr_offset(rec, 64), 0);
        ast_write_i32(ptr_offset(rec, 68), 0);
        ast_write_i32(ptr_offset(rec, 72), 0);
        ast_write_i32(ptr_offset(rec, 76), 0);
        ast_write_i64(ptr_offset(rec, 80), 0);
        ast_write_i32(ptr_offset(rec, 88), 0);
        ast_write_i32(ptr_offset(rec, 92), hir_id_invalid());
        if (id > self.item_count) { self.item_count = id; }
        return id;
    }

    /// Type-list pool: singly linked TypeId chains referenced by head node id.
    public fn add_type_list_node(self, type_id: i32) -> i32 {
        var id: i32 = self.tlist_count;
        id = id + 1;
        self.ensure_tlists(id);
        let rec = self.tlist_record(id);
        if (rec == null) { return hir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), type_id);
        ast_write_i32(ptr_offset(rec, 8), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 12), 0);
        self.tlist_count = id;
        return id;
    }

    public fn set_type_list_next(self, node_id: i32, next_id: i32) {
        let rec = self.tlist_record(node_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 8), next_id); }
    }

    public fn type_list_node_type(self, node_id: i32) -> i32 {
        let rec = self.tlist_record(node_id);
        if (rec == null) { return hir_id_invalid(); }
        return ast_read_i32(ptr_offset(rec, 4));
    }

    public fn type_list_node_next(self, node_id: i32) -> i32 {
        let rec = self.tlist_record(node_id);
        if (rec == null) { return hir_id_invalid(); }
        return ast_read_i32(ptr_offset(rec, 8));
    }

    public fn type_list_len(self, head_id: i32) -> i32 {
        var count: i32 = 0;
        var cur = head_id;
        var guard: i32 = 0;
        let guard_limit: i32 = self.tlist_count + 2;
        while (cur != hir_id_invalid() && guard < guard_limit) {
            count = count + 1;
            cur = self.type_list_node_next(cur);
            guard = guard + 1;
        }
        return count;
    }

    /// Structured generic env rows: param/arg TypeId lists plus owner TypeId.
    /// This table is the ID-level source of truth. CSV strings on the function
    /// record are written only while the instance is being interned, then
    /// cleared.
    public fn add_generic_env(self, param_list_head: i32, arg_list_head: i32, owner_type_id: i32) -> i32 {
        var id: i32 = self.genv_count;
        id = id + 1;
        self.ensure_genvs(id);
        let rec = self.genv_record(id);
        if (rec == null) { return hir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), param_list_head);
        ast_write_i32(ptr_offset(rec, 8), arg_list_head);
        ast_write_i32(ptr_offset(rec, 12), owner_type_id);
        self.genv_count = id;
        return id;
    }

    public fn genv_param_list(self, id: i32) -> i32 {
        let rec = self.genv_record(id);
        if (rec == null) { return hir_id_invalid(); }
        return ast_read_i32(ptr_offset(rec, 4));
    }

    public fn genv_arg_list(self, id: i32) -> i32 {
        let rec = self.genv_record(id);
        if (rec == null) { return hir_id_invalid(); }
        return ast_read_i32(ptr_offset(rec, 8));
    }

    public fn genv_owner_type(self, id: i32) -> i32 {
        let rec = self.genv_record(id);
        if (rec == null) { return hir_id_invalid(); }
        return ast_read_i32(ptr_offset(rec, 12));
    }

    public fn add_item_flags(self, item_id: i32, flags: i32) {
        let rec = self.item_record(item_id);
        if (rec == null) { return; }
        let current = ast_read_i32(ptr_offset(rec, 68));
        ast_write_i32(ptr_offset(rec, 68), current | flags);
    }

    public fn add_or_get_builtin(self, name: string, sem_kind: i32, owner_type_id: i32, flags: i32) -> i32 {
        if (name.len == 0) { return hir_id_invalid(); }
        var cur: i32 = 1;
        while (cur <= self.builtin_count) {
            let rec0 = self.builtin_record(cur);
            if (rec0 != null
                && ast_read_i32(ptr_offset(rec0, 4)) == sem_kind
                && ast_read_i32(ptr_offset(rec0, 8)) == owner_type_id
                && ast_read_i32(ptr_offset(rec0, 12)) == flags
                && hir_read_string(rec0, 16, 24) == name) {
                return cur;
            }
            cur = cur + 1;
        }
        var id: i32 = self.builtin_count;
        id = id + 1;
        self.ensure_builtins(id);
        let rec = self.builtin_record(id);
        if (rec == null) { return hir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), sem_kind);
        ast_write_i32(ptr_offset(rec, 8), owner_type_id);
        ast_write_i32(ptr_offset(rec, 12), flags);
        hir_write_string(rec, 16, 24, name);
        self.builtin_count = id;
        return id;
    }

    public fn add_function(self, item_id: i32, name: string, ret_type_id: i32) -> i32 {
        let id = self.ids.alloc_function();
        self.ensure_functions(id);
        let rec = self.function_record(id);
        if (rec == null) { return hir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), item_id);
        ast_write_i32(ptr_offset(rec, 8), ret_type_id);
        ast_write_i32(ptr_offset(rec, 12), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 16), 0);
        ast_write_i32(ptr_offset(rec, 20), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 24), 0);
        ast_write_i32(ptr_offset(rec, 28), 0);
        hir_write_string(rec, 32, 40, name);
        ast_write_i32(ptr_offset(rec, 96), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 100), hir_id_invalid());
        hir_write_string(rec, 104, 112, "");
        if (item_id > 0) {
            let item_rec = self.item_record(item_id);
            if (item_rec != null) { ast_write_i32(ptr_offset(item_rec, 16), id); }
        }
        if (id > self.function_count) { self.function_count = id; }
        return id;
    }

    public fn add_local(self, function_id: i32, name: string, type_id: i32, flags: i32) -> i32 {
        let id = self.ids.alloc_local();
        self.ensure_locals(id);
        let rec = self.local_record(id);
        if (rec == null) { return hir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), function_id);
        ast_write_i32(ptr_offset(rec, 8), type_id);
        ast_write_i32(ptr_offset(rec, 12), flags);
        ast_write_i32(ptr_offset(rec, 32), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 36), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 40), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 44), hir_id_invalid());
        hir_write_string(rec, 16, 24, name);
        let fn_rec = self.function_record(function_id);
        if (fn_rec != null) {
            let first = ast_read_i32(ptr_offset(fn_rec, 12));
            if (first == hir_id_invalid()) {
                ast_write_i32(ptr_offset(fn_rec, 12), id);
                ast_write_i32(ptr_offset(fn_rec, 100), id);
            } else {
                var tail = ast_read_i32(ptr_offset(fn_rec, 100));
                var tail_rec = self.local_record(tail);
                if (tail_rec != null
                    && ast_read_i32(ptr_offset(tail_rec, 4)) == function_id
                    && ast_read_i32(ptr_offset(tail_rec, 32)) == hir_id_invalid()) {
                    ast_write_i32(ptr_offset(tail_rec, 32), id);
                } else {
                    var cur = first;
                    var guard: i32 = 0;
                    var guard_limit: i32 = self.local_count;
                    guard_limit = guard_limit + 2;
                    while (cur != hir_id_invalid() && guard < guard_limit) {
                        let cur_rec = self.local_record(cur);
                        let next = ast_read_i32(ptr_offset(cur_rec, 32));
                        if (next == hir_id_invalid()) {
                            ast_write_i32(ptr_offset(cur_rec, 32), id);
                            cur = hir_id_invalid();
                        } else {
                            cur = next;
                        }
                        guard = guard + 1;
                    }
                }
                ast_write_i32(ptr_offset(fn_rec, 100), id);
            }
            var fn_local_count: i32 = ast_read_i32(ptr_offset(fn_rec, 16));
            fn_local_count = fn_local_count + 1;
            ast_write_i32(ptr_offset(fn_rec, 16), fn_local_count);
        }
        if (id > self.local_count) { self.local_count = id; }
        return id;
    }

    public fn add_stmt(self, function_id: i32, kind: i32, name: string, type_id: i32) -> i32 {
        let id = self.ids.alloc_stmt();
        self.ensure_stmts(id);
        let rec = self.stmt_record(id);
        if (rec == null) { return hir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), kind);
        ast_write_i32(ptr_offset(rec, 8), function_id);
        ast_write_i32(ptr_offset(rec, 12), type_id);
        ast_write_i32(ptr_offset(rec, 16), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 20), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 24), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 28), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 32), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 36), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 40), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 44), hir_id_invalid());
        hir_write_string(rec, 48, 56, name);
        ast_write_i32(ptr_offset(rec, 64), 0);
        ast_write_i32(ptr_offset(rec, 68), 0);
        ast_write_i32(ptr_offset(rec, 72), 0);
        ast_write_i32(ptr_offset(rec, 76), 0);
        if (id > self.stmt_count) { self.stmt_count = id; }
        return id;
    }

    public fn add_expr(self,
                       function_id: i32,
                       kind: i32,
                       name: string,
                       value_text: string,
                       int_value: i64,
                       type_id: i32,
                       sem_kind: i32,
                       target_kind: i32,
                       target_id: i32,
                       flags: i32,
                       op: i32) -> i32 {
        let id = self.ids.alloc_expr();
        self.ensure_exprs(id);
        let rec = self.expr_record(id);
        if (rec == null) { return hir_id_invalid(); }
        ast_write_i32(rec, id);
        ast_write_i32(ptr_offset(rec, 4), kind);
        ast_write_i32(ptr_offset(rec, 8), function_id);
        ast_write_i32(ptr_offset(rec, 12), type_id);
        ast_write_i32(ptr_offset(rec, 16), sem_kind);
        ast_write_i32(ptr_offset(rec, 20), target_kind);
        ast_write_i32(ptr_offset(rec, 24), target_id);
        ast_write_i32(ptr_offset(rec, 28), op);
        ast_write_i32(ptr_offset(rec, 32), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 36), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 40), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 44), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 48), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 52), flags);
        hir_write_string(rec, 56, 64, name);
        hir_write_string(rec, 72, 80, value_text);
        ast_write_i64(ptr_offset(rec, 88), int_value);
        ast_write_i32(ptr_offset(rec, 96), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 100), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 104), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 108), hir_id_invalid());
        hir_write_string(rec, 112, 120, "");
        ast_write_i32(ptr_offset(rec, 128), 0);
        ast_write_i32(ptr_offset(rec, 132), 0);
        ast_write_i32(ptr_offset(rec, 136), hir_id_invalid());
        ast_write_i32(ptr_offset(rec, 140), 0);
        ast_write_i32(ptr_offset(rec, 144), 0);
        ast_write_i32(ptr_offset(rec, 148), 0);
        ast_write_i32(ptr_offset(rec, 152), 0);
        ast_write_i32(ptr_offset(rec, 156), 0);
        if (id > self.expr_count) { self.expr_count = id; }
        return id;
    }

    public fn set_function_body(self, function_id: i32, first_stmt_id: i32, stmt_count: i32) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        ast_write_i32(ptr_offset(rec, 20), first_stmt_id);
        ast_write_i32(ptr_offset(rec, 24), stmt_count);
    }

    public fn type_list_texts(self, head_id: i32) -> string {
        if (head_id == hir_id_invalid()) { return ""; }
        var out = "";
        var cur = head_id;
        var guard: i32 = 0;
        let guard_limit: i32 = self.tlist_count + 2;
        while (cur != hir_id_invalid() && guard < guard_limit) {
            let type_id = self.type_list_node_type(cur);
            let text = hir_type_table_text(self.types, type_id);
            if (out.len > 0) { out = out + ","; }
            out = out + text;
            cur = self.type_list_node_next(cur);
            guard = guard + 1;
        }
        return out;
    }

    public fn clear_function_generic_env_strings(self, function_id: i32) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        hir_write_string(rec, 48, 56, "");
        hir_write_string(rec, 64, 72, "");
        hir_write_string(rec, 80, 88, "");
    }

    fn intern_type_list_from_csv(self, csv: string) -> i32 {
        if (csv.len == 0) { return hir_id_invalid(); }
        var head: i32 = hir_id_invalid();
        var tail: i32 = hir_id_invalid();
        var i: i32 = 0;
        while (i < 64) {
            let part = hir_model_csv_at(csv, i);
            if (part.len == 0) { return head; }
            let ty = self.types.intern_name(part);
            let node = self.add_type_list_node(ty);
            if (head == hir_id_invalid()) { head = node; }
            else { self.set_type_list_next(tail, node); }
            tail = node;
            i = i + 1;
        }
        return head;
    }

    /// CSV is interned into GenericEnvId (param/arg TypeId lists + owner).
    /// Function-record string slots are then cleared; getters prefer env id.
    public fn set_function_generic_env(self, function_id: i32, params: string, args: string, owner_type: string) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        let params_head = self.intern_type_list_from_csv(params);
        let args_head = self.intern_type_list_from_csv(args);
        var owner_id: i32 = 0;
        if (owner_type.len > 0) { owner_id = self.types.intern_name(owner_type); }
        let env_id = self.add_generic_env(params_head, args_head, owner_id);
        self.set_function_generic_env_id(function_id, env_id);
        self.clear_function_generic_env_strings(function_id);
    }

    /// Carries declaration provenance that must participate in an internal
    /// symbol name.  Two module versions may intentionally expose the same
    /// owner, method name, and ABI signature, so the normal ABI tuple alone
    /// cannot identify their bodies.
    public fn set_function_symbol_discriminator(self,
                                                function_id: i32,
                                                discriminator: string) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        hir_write_string(rec, 104, 112, discriminator);
    }

    public fn add_function_flags(self, function_id: i32, flags: i32) {
        let rec = self.function_record(function_id);
        if (rec == null) { return; }
        let current = ast_read_i32(ptr_offset(rec, 28));
        ast_write_i32(ptr_offset(rec, 28), current | flags);
    }

