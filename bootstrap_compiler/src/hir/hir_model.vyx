    public fn set_expr_stmt_aux(self, expr_id: i32, stmt_id: i32) {
        let rec = self.expr_record(expr_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 104), stmt_id); }
    }

    public fn set_expr_aggregate_field(self, expr_id: i32, field_id: i32) {
        let rec = self.expr_record(expr_id);
        if (rec != null) { ast_write_i32(ptr_offset(rec, 108), field_id); }
    }

    public fn set_expr_arg_name(self, expr_id: i32, arg_name: string) {
        let rec = self.expr_record(expr_id);
        if (rec != null) { hir_write_string(rec, 112, 120, arg_name); }
    }

    public fn item_kind(self, id: i32) -> i32 { let r = self.item_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }
    public fn item_type(self, id: i32) -> i32 { let r = self.item_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }
    public fn item_owner(self, id: i32) -> i32 { let r = self.item_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }
    public fn item_function(self, id: i32) -> i32 { let r = self.item_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }
    public fn item_first_member(self, id: i32) -> i32 { let r = self.item_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }
    public fn item_next_sibling(self, id: i32) -> i32 { let r = self.item_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }
    public fn item_init(self, id: i32) -> i32 { let r = self.item_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 28)); }
    public fn item_name(self, id: i32) -> string { return hir_read_string(self.item_record(id), 32, 40); }
    public fn item_variant_payload_types(self, id: i32) -> string { return hir_read_string(self.item_record(id), 48, 56); }
    public fn item_variant_payload_count(self, id: i32) -> i32 { let r = self.item_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 64)); }
    public fn item_flags(self, id: i32) -> i32 { let r = self.item_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 68)); }

    public fn builtin_sem_kind(self, id: i32) -> i32 { let r = self.builtin_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }
    public fn builtin_owner_type(self, id: i32) -> i32 { let r = self.builtin_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }
    public fn builtin_flags(self, id: i32) -> i32 { let r = self.builtin_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }
    public fn builtin_name(self, id: i32) -> string { return hir_read_string(self.builtin_record(id), 16, 24); }

    public fn function_item(self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 4)); }
    public fn function_return_type(self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 8)); }
    public fn function_first_local(self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 12)); }
    public fn function_local_count(self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 16)); }
    public fn function_body(self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 20)); }
    public fn function_stmt_count(self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 24)); }
    public fn function_flags(self, id: i32) -> i32 { let r = self.function_record(id); if (r == null) { return 0; } return ast_read_i32(ptr_offset(r, 28)); }
    public fn function_name(self, id: i32) -> string { return hir_read_string(self.function_record(id), 32, 40); }
    public fn function_generic_params(self, id: i32) -> string {
        let env = self.function_generic_env_id(id);
        if (env > 0) { return self.type_list_texts(self.genv_param_list(env)); }
        return hir_read_string(self.function_record(id), 48, 56);
    }
    public fn function_generic_args(self, id: i32) -> string {
        let env = self.function_generic_env_id(id);
        if (env > 0) { return self.type_list_texts(self.genv_arg_list(env)); }
        return hir_read_string(self.function_record(id), 64, 72);
    }
    public fn function_owner_type(self, id: i32) -> string {
        let env = self.function_generic_env_id(id);
        if (env > 0) {
            let owner = self.genv_owner_type(env);
            if (owner > 0) { return hir_type_table_text(self.types, owner); }
            return "";
        }
        return hir_read_string(self.function_record(id), 80, 88);
    }
    public fn function_symbol_discriminator(self, id: i32) -> string { return hir_read_string(self.function_record(id), 104, 112); }

