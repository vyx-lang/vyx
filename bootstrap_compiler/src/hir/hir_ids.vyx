module bootstrap.hir_ids;

public fn hir_id_invalid() -> i32 { return 0; }

public fn hir_target_none() -> i32 { return 0; }
public fn hir_target_item() -> i32 { return 1; }
public fn hir_target_function() -> i32 { return 2; }
public fn hir_target_field() -> i32 { return 3; }
public fn hir_target_variant() -> i32 { return 4; }
public fn hir_target_local() -> i32 { return 5; }
public fn hir_target_builtin() -> i32 { return 6; }
public fn hir_target_type() -> i32 { return 7; }

public fn hir_item_module() -> i32 { return 1; }
public fn hir_item_function() -> i32 { return 2; }
public fn hir_item_extern_function() -> i32 { return 3; }
public fn hir_item_class() -> i32 { return 4; }
public fn hir_item_enum() -> i32 { return 5; }
public fn hir_item_field() -> i32 { return 6; }
public fn hir_item_method() -> i32 { return 7; }
public fn hir_item_variant() -> i32 { return 8; }
public fn hir_item_const() -> i32 { return 9; }
public fn hir_item_global() -> i32 { return 10; }
public fn hir_item_type_alias() -> i32 { return 11; }
public fn hir_item_closure() -> i32 { return 12; }
public fn hir_item_interface() -> i32 { return 13; }

public fn hir_function_flag_imported_body() -> i32 { return 1; }
public fn hir_function_flag_codegen_root() -> i32 { return 2; }
public fn hir_function_flag_closed_generic_env() -> i32 { return 4; }
public fn hir_function_flag_declaration_only() -> i32 { return 8; }
public fn hir_function_flag_async_task() -> i32 { return 16; }
/// DCI declaration traits. These bits describe the verified foreign contract,
/// independent of the language/profile that produced its descriptor.
public fn hir_function_flag_foreign_dci() -> i32 { return 32; }
public fn hir_function_flag_foreign_dci_ctor() -> i32 { return 64; }
public fn hir_function_flag_foreign_dci_const_method() -> i32 { return 128; }
public fn hir_function_flag_foreign_dci_virtual_method() -> i32 { return 256; }
public fn hir_function_flag_foreign_dci_override_method() -> i32 { return 512; }
public fn hir_function_flag_foreign_dci_final_method() -> i32 { return 1024; }
public fn hir_function_flag_foreign_dci_dtor() -> i32 { return 2048; }
// Source code-generation attributes. Keep these separate from ABI and
// lifecycle flags so HIR/MIR can preserve the user's optimization intent.
public fn hir_function_flag_inline_hint() -> i32 { return 4096; }
public fn hir_function_flag_noinline() -> i32 { return 8192; }
public fn hir_function_flag_cold() -> i32 { return 16384; }
public fn hir_function_flag_hot() -> i32 { return 32768; }
/// Reflection keeps callable bodies alive without making every partition
/// define the same linker symbol. The MIR root partitioner assigns these
/// roots to one deterministic top-level anchor partition.
public fn hir_function_flag_reflection_root() -> i32 { return 65536; }
/// The reflected method was already an exported/name-partitioned root before
/// reflection retention ran. Its own root-name partition owns the body;
/// otherwise the deterministic top-level reflection anchor owns it.
public fn hir_function_flag_reflection_named_root() -> i32 { return 131072; }
/// Keep a top-level Vyx function's source name as its externally visible
/// C ABI symbol. This is reserved for freestanding runtime/platform surfaces.
public fn hir_function_flag_no_mangle() -> i32 { return 262144; }
/// C `...` on an `extern "C"` / C-ABI function. Extra call args are
/// forwarded after the last typed formal.
public fn hir_function_flag_c_varargs() -> i32 { return 524288; }
/// Source-language value constructor. Needed because a closed generic
/// instance is registered under its mangled `mir2$…::<args>::constructor…`
/// item name, so any `function_name(fn) == "constructor"` test silently
/// misses it and the hidden `self` receiver is never materialized.
public fn hir_function_flag_constructor() -> i32 { return 1048576; }

/// `@[cuda_kernel]`: the function is an NVVM device kernel entry.  Lowering
/// attaches the `nvvm.kernel` function attribute so the NVPTX backend emits
/// a `.visible .entry` for it under the `nvptx64-nvidia-cuda` target.
public fn hir_function_flag_cuda_kernel() -> i32 { return 2097152; }

/// Source compatibility for the first C++ DCI profile.
public fn hir_function_flag_foreign_cpp() -> i32 { return hir_function_flag_foreign_dci(); }
public fn hir_function_flag_foreign_cpp_ctor() -> i32 { return hir_function_flag_foreign_dci_ctor(); }
public fn hir_function_flag_foreign_cpp_const_method() -> i32 { return hir_function_flag_foreign_dci_const_method(); }
public fn hir_function_flag_foreign_cpp_virtual_method() -> i32 { return hir_function_flag_foreign_dci_virtual_method(); }
public fn hir_function_flag_foreign_cpp_override_method() -> i32 { return hir_function_flag_foreign_dci_override_method(); }
public fn hir_function_flag_foreign_cpp_final_method() -> i32 { return hir_function_flag_foreign_dci_final_method(); }
public fn hir_function_flag_foreign_cpp_dtor() -> i32 { return hir_function_flag_foreign_dci_dtor(); }

/// Local flag bits. Capture reference mode is deliberately separate from the
/// receiver bit so closure lowering never has to infer semantics from names.
public fn hir_local_flag_param() -> i32 { return 1; }
public fn hir_local_flag_capture() -> i32 { return 2; }
public fn hir_local_flag_auto_drop() -> i32 { return 8; }
public fn hir_local_flag_move_arg() -> i32 { return 16; }
public fn hir_local_flag_self_receiver() -> i32 { return 32; }
public fn hir_local_flag_reference_capture() -> i32 { return 64; }
/// Receiver ownership mode. `self` keeps the compatibility-this semantics;
/// Rust-style forms are explicit and survive unchanged through MIR.
public fn hir_local_flag_self_shared_ref() -> i32 { return 256; }
public fn hir_local_flag_self_mut_ref() -> i32 { return 512; }
public fn hir_local_flag_self_compat() -> i32 { return 1024; }

// The local is declared `volatile`: every load/store on it must reach
// memory verbatim (LLVM `volatile` markers / C++ `volatile` qualifier).
public fn hir_local_flag_volatile() -> i32 { return 2048; }

/// Expr-level value category (reserved storage for the closed-HIR move/drop
/// contract; builder currently leaves exprs at `unknown`).
public fn hir_value_cat_unknown() -> i32 { return 0; }
public fn hir_value_cat_place() -> i32 { return 1; }
public fn hir_value_cat_value() -> i32 { return 2; }

public fn hir_move_drop_flag_none() -> i32 { return 0; }
public fn hir_move_drop_flag_read_place() -> i32 { return 1; }
public fn hir_move_drop_flag_borrow_arg() -> i32 { return 2; }
public fn hir_move_drop_flag_move_arg() -> i32 { return 4; }
public fn hir_move_drop_flag_has_drop() -> i32 { return 8; }

/// Folded const value slot states on item records.
public fn hir_const_value_none() -> i32 { return 0; }
public fn hir_const_value_i64() -> i32 { return 1; }

public fn hir_stmt_expr() -> i32 { return 1; }
public fn hir_stmt_let() -> i32 { return 2; }
public fn hir_stmt_var() -> i32 { return 3; }
public fn hir_stmt_if() -> i32 { return 4; }
public fn hir_stmt_while() -> i32 { return 5; }
public fn hir_stmt_break() -> i32 { return 6; }
public fn hir_stmt_continue() -> i32 { return 7; }
public fn hir_stmt_return() -> i32 { return 8; }
public fn hir_stmt_block() -> i32 { return 9; }
public fn hir_stmt_for() -> i32 { return 10; }
public fn hir_stmt_foreach() -> i32 { return 11; }
public fn hir_stmt_match() -> i32 { return 12; }
public fn hir_stmt_defer() -> i32 { return 13; }
public fn hir_stmt_static_assert() -> i32 { return 14; }

public fn hir_type_unknown() -> i32 { return 0; }

public class HirIdAllocator {
    public next_type_id: i32
    public next_item_id: i32
    public next_function_id: i32
    public next_local_id: i32
    public next_stmt_id: i32
    public next_expr_id: i32

    public static fn create() -> HirIdAllocator {
        return HirIdAllocator {
            next_type_id: 1,
            next_item_id: 1,
            next_function_id: 1,
            next_local_id: 1,
            next_stmt_id: 1,
            next_expr_id: 1
        };
    }

    public fn alloc_type(self) -> i32 {
        let id = self.next_type_id;
        self.next_type_id = self.next_type_id + 1;
        return id;
    }

    public fn alloc_item(self) -> i32 {
        let id = self.next_item_id;
        self.next_item_id = self.next_item_id + 1;
        return id;
    }

    public fn alloc_function(self) -> i32 {
        let id = self.next_function_id;
        self.next_function_id = self.next_function_id + 1;
        return id;
    }

    public fn alloc_local(self) -> i32 {
        let id = self.next_local_id;
        self.next_local_id = self.next_local_id + 1;
        return id;
    }

    public fn alloc_stmt(self) -> i32 {
        let id = self.next_stmt_id;
        self.next_stmt_id = self.next_stmt_id + 1;
        return id;
    }

    public fn alloc_expr(self) -> i32 {
        let id = self.next_expr_id;
        self.next_expr_id = self.next_expr_id + 1;
        return id;
    }
}

public fn hir_id_alloc_type(ids: &mut HirIdAllocator) -> i32 {
    return ids.alloc_type();
}

public fn hir_id_alloc_item(ids: &mut HirIdAllocator) -> i32 {
    return ids.alloc_item();
}

public fn hir_id_alloc_function(ids: &mut HirIdAllocator) -> i32 {
    return ids.alloc_function();
}

public fn hir_id_alloc_local(ids: &mut HirIdAllocator) -> i32 {
    return ids.alloc_local();
}

public fn hir_id_alloc_stmt(ids: &mut HirIdAllocator) -> i32 {
    return ids.alloc_stmt();
}

public fn hir_id_alloc_expr(ids: &mut HirIdAllocator) -> i32 {
    return ids.alloc_expr();
}
