module std.sync;

/// Vyx synchronization: OS mutex/rwlock/condvar plus seq_cst i64 atomics.
/// Handles come from `runtime/src/vyx_sync.c` (SRWLOCK / pthread), not C++ `std::mutex`.

extern "C" {
    fn vyx_mu_new() -> rawptr;
    fn vyx_mu_lock(m: rawptr);
    fn vyx_mu_try_lock(m: rawptr) -> i32;
    fn vyx_mu_unlock(m: rawptr);
    fn vyx_mu_destroy(m: rawptr);
    fn vyx_rw_new() -> rawptr;
    fn vyx_rw_read(r: rawptr);
    fn vyx_rw_write(r: rawptr);
    fn vyx_rw_try_read(r: rawptr) -> i32;
    fn vyx_rw_try_write(r: rawptr) -> i32;
    fn vyx_rw_unlock_read(r: rawptr);
    fn vyx_rw_unlock_write(r: rawptr);
    fn vyx_rw_destroy(r: rawptr);
    fn vyx_cv_new() -> rawptr;
    fn vyx_cv_wait(cv: rawptr, mu: rawptr);
    fn vyx_cv_wait_ns(cv: rawptr, mu: rawptr, ns: u64) -> i32;
    fn vyx_cv_signal(cv: rawptr);
    fn vyx_cv_broadcast(cv: rawptr);
    fn vyx_cv_destroy(cv: rawptr);
    fn vyx_once_new() -> rawptr;
    fn vyx_once_call(once: rawptr, fn_ptr: rawptr, arg: rawptr) -> i32;
    fn vyx_once_destroy(once: rawptr);
    fn vyx_bar_new(n: i32) -> rawptr;
    fn vyx_bar_wait(bar: rawptr) -> i32;
    fn vyx_bar_destroy(bar: rawptr);
    fn vyx_a64_new(init: i64) -> rawptr;
    fn vyx_a64_load(a: rawptr) -> i64;
    fn vyx_a64_store(a: rawptr, v: i64);
    fn vyx_a64_fetch_add(a: rawptr, delta: i64) -> i64;
    fn vyx_a64_cas(a: rawptr, expected: i64, desired: i64) -> i64;
    fn vyx_a64_destroy(a: rawptr);
}

public fn mutex_new() -> rawptr { return vyx_mu_new(); }
public fn mutex_lock(m: rawptr) { vyx_mu_lock(m); }
public fn mutex_try_lock(m: rawptr) -> bool { return vyx_mu_try_lock(m) != 0; }
public fn mutex_unlock(m: rawptr) { vyx_mu_unlock(m); }
public fn mutex_destroy(m: rawptr) { vyx_mu_destroy(m); }

public fn rwlock_new() -> rawptr { return vyx_rw_new(); }
public fn rwlock_read(r: rawptr) { vyx_rw_read(r); }
public fn rwlock_write(r: rawptr) { vyx_rw_write(r); }
public fn rwlock_try_read(r: rawptr) -> bool { return vyx_rw_try_read(r) != 0; }
public fn rwlock_try_write(r: rawptr) -> bool { return vyx_rw_try_write(r) != 0; }
public fn rwlock_unlock_read(r: rawptr) { vyx_rw_unlock_read(r); }
public fn rwlock_unlock_write(r: rawptr) { vyx_rw_unlock_write(r); }
public fn rwlock_destroy(r: rawptr) { vyx_rw_destroy(r); }

public fn condvar_new() -> rawptr { return vyx_cv_new(); }
public fn condvar_wait(cv: rawptr, mu: rawptr) { vyx_cv_wait(cv, mu); }
public fn condvar_wait_ms(cv: rawptr, mu: rawptr, ms: i64) -> i32 {
    var n = ms;
    if (n < 0) { n = 0; }
    return vyx_cv_wait_ns(cv, mu, (n as u64) * 1000000);
}
public fn condvar_signal(cv: rawptr) { vyx_cv_signal(cv); }
public fn condvar_broadcast(cv: rawptr) { vyx_cv_broadcast(cv); }
public fn condvar_destroy(cv: rawptr) { vyx_cv_destroy(cv); }

public fn once_new() -> rawptr { return vyx_once_new(); }
public fn once_call(once: rawptr, fn_ptr: rawptr, arg: rawptr) -> i32 {
    return vyx_once_call(once, fn_ptr, arg);
}
public fn once_destroy(once: rawptr) { vyx_once_destroy(once); }

public fn barrier_new(n: i32) -> rawptr { return vyx_bar_new(n); }
public fn barrier_wait(bar: rawptr) -> i32 { return vyx_bar_wait(bar); }
public fn barrier_destroy(bar: rawptr) { vyx_bar_destroy(bar); }

public fn atomic_new(init: i64) -> rawptr { return vyx_a64_new(init); }
public fn atomic_load(a: rawptr) -> i64 { return vyx_a64_load(a); }
public fn atomic_store(a: rawptr, val: i64) { vyx_a64_store(a, val); }
public fn atomic_add(a: rawptr, delta: i64) -> i64 {
    return vyx_a64_fetch_add(a, delta) + delta;
}
public fn atomic_inc(a: rawptr) -> i64 { return atomic_add(a, 1); }
public fn atomic_dec(a: rawptr) -> i64 { return atomic_add(a, -1); }
public fn atomic_cas(a: rawptr, expected: i64, desired: i64) -> i64 {
    return vyx_a64_cas(a, expected, desired);
}
public fn atomic_destroy(a: rawptr) { vyx_a64_destroy(a); }

public class Mutex<T> {
    public handle: rawptr;
    public value: T;

    public static fn new(init: T) -> Mutex<T> {
        return Mutex { handle: mutex_new(), value: init };
    }

    public fn lock() { mutex_lock(self.handle); }
    public fn try_lock() -> bool { return mutex_try_lock(self.handle); }
    public fn unlock() { mutex_unlock(self.handle); }
    public fn get() -> T { return self.value; }
    public fn set(v: T) { self.value = v; }

    public fn update(f: fn(T) -> T) {
        self.lock();
        self.value = f(self.value);
        self.unlock();
    }

    public fn destroy() {
        if (self.handle != null) {
            mutex_destroy(self.handle);
            self.handle = null;
        }
    }

    public fn drop() { self.destroy(); }
}

class RwLock<T> {
    public handle: rawptr;
    public value: T;

    public static fn new(init: T) -> RwLock<T> {
        return RwLock { handle: rwlock_new(), value: init };
    }

    public fn read() { rwlock_read(self.handle); }
    public fn write() { rwlock_write(self.handle); }
    public fn unlock_read() { rwlock_unlock_read(self.handle); }
    public fn unlock_write() { rwlock_unlock_write(self.handle); }
    public fn get() -> T { return self.value; }
    public fn set(v: T) { self.value = v; }

    public fn destroy() {
        if (self.handle != null) {
            rwlock_destroy(self.handle);
            self.handle = null;
        }
    }

    public fn drop() { self.destroy(); }
}

class Condvar {
    public handle: rawptr;

    public static fn new() -> Condvar {
        return Condvar { handle: condvar_new() };
    }

    public fn wait(mu: rawptr) { condvar_wait(self.handle, mu); }
    public fn notify_one() { condvar_signal(self.handle); }
    public fn notify_all() { condvar_broadcast(self.handle); }

    public fn destroy() {
        if (self.handle != null) {
            condvar_destroy(self.handle);
            self.handle = null;
        }
    }

    public fn drop() { self.destroy(); }
}

class Barrier {
    public handle: rawptr;

    public static fn new(n: i32) -> Barrier {
        return Barrier { handle: barrier_new(n) };
    }

    public fn wait() -> i32 { return barrier_wait(self.handle); }

    public fn destroy() {
        if (self.handle != null) {
            barrier_destroy(self.handle);
            self.handle = null;
        }
    }

    public fn drop() { self.destroy(); }
}

public class Once {
    public handle: rawptr;

    public static fn new() -> Once {
        return Once { handle: once_new() };
    }

    public fn call(fn_ptr: rawptr, arg: rawptr) -> i32 {
        return once_call(self.handle, fn_ptr, arg);
    }

    public fn destroy() {
        if (self.handle != null) {
            once_destroy(self.handle);
            self.handle = null;
        }
    }

    public fn drop() { self.destroy(); }
}

public fn mutex_run_with<T>(init: T, f: fn(T) -> T) -> T {
    let m = Mutex::<T>.new(init);
    m.update(f);
    let out = m.get();
    m.destroy();
    return out;
}
