module std.thread_pool;

/// Work-stealing pool via oneTBB (`tbb::parallel_for` / `tbb::task_group`).
/// This module depends on TBB, not on wrapping C++ `std::thread`.

extern "C" {
    fn vyx_tbb_max_concurrency() -> i32;
    fn vyx_tbb_parallel_for(n: i64, fn_ptr: rawptr, ctx: rawptr) -> i32;
    fn vyx_tbb_task_group_run_n(n: i64, fn_ptr: rawptr, ctx: rawptr) -> i32;
    fn vyx_tbb_arena_new(nthreads: i32) -> rawptr;
    fn vyx_tbb_arena_max_concurrency(arena: rawptr) -> i32;
    fn vyx_tbb_arena_parallel_for(arena: rawptr, n: i64, fn_ptr: rawptr, ctx: rawptr) -> i32;
    fn vyx_tbb_arena_free(arena: rawptr);
}

public fn pool_max_concurrency() -> i32 {
    let n = vyx_tbb_max_concurrency();
    if (n < 1) { return 1; }
    return n;
}

/// `fn_ptr` is `fn(rawptr, i64)` receiving `(ctx, index)` for `index` in `0..n`.
public fn parallel_for(n: i64, fn_ptr: rawptr, ctx: rawptr) {
    if (n <= 0) { return; }
    if (vyx_tbb_parallel_for(n, fn_ptr, ctx) != 0) {
        panic("tbb parallel_for failed");
    }
}

/// One TBB task per index. Prefer this when the N bodies have uneven cost (CGUs).
public fn task_group_run(n: i64, fn_ptr: rawptr, ctx: rawptr) {
    if (n <= 0) { return; }
    if (vyx_tbb_task_group_run_n(n, fn_ptr, ctx) != 0) {
        panic("tbb task_group failed");
    }
}

public fn arena_new(nthreads: i32) -> rawptr {
    return vyx_tbb_arena_new(nthreads);
}

public fn arena_max_concurrency(arena: rawptr) -> i32 {
    return vyx_tbb_arena_max_concurrency(arena);
}

public fn arena_parallel_for(arena: rawptr, n: i64, fn_ptr: rawptr, ctx: rawptr) {
    if (n <= 0) { return; }
    if (vyx_tbb_arena_parallel_for(arena, n, fn_ptr, ctx) != 0) {
        panic("tbb arena parallel_for failed");
    }
}

public fn arena_free(arena: rawptr) {
    if (arena == null) { return; }
    vyx_tbb_arena_free(arena);
}
