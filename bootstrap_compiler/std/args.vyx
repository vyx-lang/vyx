module std.args;

/// Vyx CLI Argument Parser
/// Parse command-line arguments using built-in getArg/argCount.
///
/// Usage:
///   let count = argCount();
///   foreach (i in 0..count) {
///       let arg = getArg(i);
///       if (arg == "--verbose") { verbose = true; }
///       if (arg.startsWith("--output=")) {
///           output = arg.substring(9, arg.len);
///       }
///   }
///
/// Helper functions:
///   has_flag("--verbose")     -> checks if flag exists
///   get_option("--output")   -> returns value after "="
///   get_positional(0)        -> returns nth non-flag argument

/// Check if a command-line flag exists
public fn has_flag(flag: string) -> bool {
    let count = argCount();
    foreach (i in 0..count) {
        let arg = getArg(i);
        if (arg == flag) {
            return true;
        }
    }
    return false;
}

/// Get value of --key=value option, returns empty string if not found
public fn get_option(key: string) -> string {
    let prefix = key + "=";
    let count = argCount();
    foreach (i in 0..count) {
        let arg = getArg(i);
        if (arg.startsWith(prefix)) {
            return arg.substring(prefix.len, arg.len);
        }
        if (arg == key) {
            if (i + 1 < count) {
                return getArg(i + 1);
            }
        }
    }
    return "";
}

/// Get nth positional argument (arguments not starting with -)
public fn get_positional(n: i32) -> string {
    let count = argCount();
    var posIdx = 0;
    foreach (i in 1..count) {
        let arg = getArg(i);
        if (!arg.startsWith("-")) {
            if (posIdx == n) {
                return arg;
            }
            posIdx = posIdx + 1;
        }
    }
    return "";
}

/// Count positional arguments
public fn positional_count() -> i32 {
    let count = argCount();
    var result = 0;
    foreach (i in 1..count) {
        let arg = getArg(i);
        if (!arg.startsWith("-")) {
            result = result + 1;
        }
    }
    return result;
}
