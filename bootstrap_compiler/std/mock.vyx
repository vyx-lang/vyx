module std.testing.mock;

use std.collections;

/// Vyx Mock/Stub Testing Framework
/// Track function calls and verify expectations in tests.
///
/// Usage:
///   @[test]
///   fn test_service() {
///       var call_log = Vec::<string>.new();
///
///       // Record calls
///       call_log.push("getData");
///       call_log.push("save");
///
///       // Verify
///       assert(mock_was_called(call_log, "getData"));
///       assert(!mock_was_called(call_log, "delete"));
///       assert_eq(mock_call_count(call_log, "getData"), 1);
///   }
///
/// Stub functions: use closures
///   let stub = [](x: i32) => { return 42; };

/// Check if a function name appears in the call log
public fn mock_was_called(log: Vec<string>, name: string) -> bool {
    foreach (entry in log) {
        if (entry == name) {
            return true;
        }
    }
    return false;
}

/// Count how many times a function name appears in the call log
public fn mock_call_count(log: Vec<string>, name: string) -> i32 {
    var count: i32 = 0;
    foreach (entry in log) {
        if (entry == name) {
            count = count + 1;
        }
    }
    return count;
}

/// Verify all expected function names were called
public fn mock_verify(log: Vec<string>, expected: Vec<string>) -> bool {
    var all_ok = true;
    foreach (name in expected) {
        if (!mock_was_called(log, name)) {
            print("MOCK FAIL: expected call to '${name}' not found");
            all_ok = false;
        }
    }
    if (all_ok) {
        print("MOCK: all expectations met");
    }
    return all_ok;
}

/// Assert a function was called exactly n times
public fn mock_assert_count(log: Vec<string>, name: string, expected: i32) {
    let actual = mock_call_count(log, name);
    if (actual != expected) {
        print("MOCK FAIL: '${name}' expected ${expected} calls, got ${actual}");
        panic("mock assertion failed");
    }
}
