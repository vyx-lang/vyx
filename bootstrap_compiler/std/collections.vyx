module std.collections;

use std.string;
use std.ref;

/// Vyx Standard Library: Collections Module
///
/// Re-exports (by virtue of sharing the `std.collections` module):
///   - Vec<T>             from vec.vyx
///   - Dict<K, V>         from dict.vyx
///   - Set<T>             from set.vyx    (legacy O(n) linear-probe; kept for compat)
///   - HashSet<T>         from hashset.vyx (O(1) expected; backed by Dict<T, i8>)
///   - Stack<T>/Queue<T>  from stack.vyx
///   - List<T>            from list.vyx   (doubly-linked list, heap nodes)
///   - Deque<T>           from deque.vyx  (ring-buffer, cap = power of 2)
///   - HashMap/StringMap  from hashmap.vyx
///   - BitSet             from bitset.vyx (fixed-length bit vector, Vec<i64> backed)
///   - PriorityQueue<T>   from priority_queue.vyx
///                        (binary heap; default min-heap, `.as_max_heap()` for max-heap)
///   - Iterator<T>        from iter.vyx
///   - Pair<A, B>         from pair.vyx   (also Tuple2 == Pair)
///   - Tuple3<A,B,C>
///     Tuple4<A,B,C,D>    from tuple.vyx
///   - Slice<T>           from slice.vyx  (non-owning (ptr,len) view)
///   - StringView         from slice.vyx  (non-owning byte view of a `str`)
///
/// Usage:
///   use std.collections;
///   var v = Vec.new();
///   v.push(3); v.push(1); v.push(2);
///   // Container algorithms live in std.algorithm.
///
///   var s = HashSet::<i64>.new();
///   s.add(1); s.add(1); s.add(2);  // len == 2
///
///   // use std.algorithm; for sort/search/reduction helpers.

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

/// Iterable trait — any container that supports indexed access.
/// Vec<T> automatically satisfies this through its get/set/len methods.
///
/// Sibling trait (defined in `iter.vyx`, Phase 7):
///   * `trait Iter<T>` — pull-style iteration protocol (one method,
///                       `next() -> Option<T>`).  `Iterable` and `Iter`
///                       describe *different* capabilities and are kept
///                       distinct on purpose, mirroring Rust's
///                       `IntoIterator` vs `Iterator` split.  `Iterable`
///                       = indexed random-access container, `Iter` =
///                       iteration *state* (cursor that yields once).
trait Iterable {
    fn len() -> i64;
    fn get(idx: i64) -> i64;
    fn set(idx: i64, val: i64);
}

// ── Numeric Utilities ──

/// Range sum: sum of integers from start to end (exclusive).
public fn sum_range(start: i64, end_val: i64) -> i64 {
    let n = end_val - start;
    return n * (2 * start + n - 1) / 2;
}

/// GCD (greatest common divisor).
public fn gcd(a: i64, b: i64) -> i64 {
    var x = a;
    var y = b;
    while (y != 0) {
        let t = y;
        y = x % y;
        x = t;
    }
    return x;
}

/// LCM (least common multiple).
public fn lcm(a: i64, b: i64) -> i64 {
    if (a == 0 || b == 0) { return 0; }
    return (a / gcd(a, b)) * b;
}

/// Fast power: base^exp using repeated squaring.
public fn pow(base: i64, exp: i64) -> i64 {
    var result: i64 = 1;
    var b = base;
    var e = exp;
    while (e > 0) {
        if ((e & 1) == 1) { result = result * b; }
        b = b * b;
        e = e >> 1;
    }
    return result;
}

/// Absolute value.
public fn abs(x: i64) -> i64 {
    return x < 0 ? 0 - x : x;
}

/// Clamp value between lo and hi.
public fn clamp(val: i64, lo: i64, hi: i64) -> i64 {
    return val < lo ? lo : (val > hi ? hi : val);
}
