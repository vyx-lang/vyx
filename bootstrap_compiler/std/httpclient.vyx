module std.http;

/// Vyx HTTP Client
/// Clean API built on libcurl with response body capture.
///
/// Usage:
///   let client = HttpClient.create();
///   let resp = client.get("https://api.example.com/data");
///   print("Status: ${resp.statusCode}");
///   print("Body: ${resp.body}");
///
///   let resp2 = client.postJson("https://api.example.com", "{\"key\":\"value\"}");
///   print(resp2.body);
///
/// Requires: libcurl

extern "C" {
    fn curl_global_init(flags: i64) -> i32;
    fn curl_global_cleanup();
    fn curl_easy_init() -> rawptr;
    fn curl_easy_cleanup(handle: rawptr);
    fn curl_easy_setopt(handle: rawptr, option: i32, value: rawptr) -> i32;
    fn curl_easy_perform(handle: rawptr) -> i32;
    fn curl_easy_getinfo(handle: rawptr, info: i32, out: rawptr) -> i32;
    fn curl_slist_append(list: rawptr, str: rawptr) -> rawptr;
    fn curl_slist_free_all(list: rawptr);
    fn malloc(size: i64) -> rawptr;
    fn realloc(ptr: rawptr, size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dest: rawptr, src: rawptr, n: i64) -> rawptr;
    // Body capture uses libcurl's default fwrite with WRITEDATA = a FILE*.
    // Vyx's C-only FFI cannot pass a Vyx CURLOPT_WRITEFUNCTION callback (Vyx
    // functions are fat pointers), so the body is routed through a temp FILE*.
    fn tmpfile() -> rawptr;
    fn fclose(f: rawptr) -> i32;
    fn fseek(f: rawptr, offset: i64, whence: i32) -> i32;
    fn ftell(f: rawptr) -> i64;
    fn fread(ptr: rawptr, size: i64, n: i64, f: rawptr) -> i64;
}

/// HTTP response with status code and body
struct HttpResponse {
    statusCode: i32;
    body: string;
    ok: bool;
}

/// Read all bytes libcurl wrote into `sink`, then close it. Returns the real
/// captured body (empty string only when nothing was written).
fn http_read_sink(sink: rawptr) -> string {
    fseek(sink, 0, 2);
    let n = ftell(sink);
    fseek(sink, 0, 0);
    if (n <= 0) { fclose(sink); return ""; }
    let buf = malloc(n + 1);
    if (buf == null) { fclose(sink); return ""; }
    let got = fread(buf, 1, n, sink);
    fclose(sink);
    let body = from_cstr_len(buf, got);
    free(buf);
    return body;
}

/// HTTP client with response capture
class HttpClient {
    private timeout: i32;
    private followRedirects: bool;

    /// Create a new HTTP client with default settings.
    public static fn create() -> HttpClient {
        curl_global_init(3);
        return HttpClient { timeout: 30, followRedirects: true };
    }

    /// Set request timeout in seconds.
    public fn setTimeout(seconds: i32) -> HttpClient {
        self.timeout = seconds;
        return self;
    }

    /// Perform a GET request and return the response.
    public fn get(url: string) -> HttpResponse {
        let handle = curl_easy_init();
        if (handle == null) {
            return HttpResponse { statusCode: 0, body: "", ok: false };
        }
        curl_easy_setopt(handle, 10002, url.c_str() as rawptr);
        curl_easy_setopt(handle, 52, 1 as rawptr);
        curl_easy_setopt(handle, 13, self.timeout as rawptr);
        let sink = tmpfile();
        if (sink != null) { curl_easy_setopt(handle, 10001, sink); }
        let result = curl_easy_perform(handle);
        var code: i32 = 0;
        curl_easy_getinfo(handle, 0x200002, &mut code as rawptr);
        curl_easy_cleanup(handle);
        var body = "";
        if (sink != null) { body = http_read_sink(sink); }
        return HttpResponse { statusCode: code, body: body, ok: result == 0 };
    }

    /// Perform a POST request with JSON body.
    public fn postJson(url: string, body: string) -> HttpResponse {
        let handle = curl_easy_init();
        if (handle == null) {
            return HttpResponse { statusCode: 0, body: "", ok: false };
        }
        curl_easy_setopt(handle, 10002, url.c_str() as rawptr);
        curl_easy_setopt(handle, 10015, body.c_str() as rawptr);
        curl_easy_setopt(handle, 52, 1 as rawptr);
        curl_easy_setopt(handle, 13, self.timeout as rawptr);
        let headers = curl_slist_append(null, "Content-Type: application/json");
        curl_easy_setopt(handle, 10023, headers);
        let sink = tmpfile();
        if (sink != null) { curl_easy_setopt(handle, 10001, sink); }
        let result = curl_easy_perform(handle);
        var code: i32 = 0;
        curl_easy_getinfo(handle, 0x200002, &mut code as rawptr);
        curl_slist_free_all(headers);
        curl_easy_cleanup(handle);
        var body = "";
        if (sink != null) { body = http_read_sink(sink); }
        return HttpResponse { statusCode: code, body: body, ok: result == 0 };
    }

    /// Perform a PUT request.
    public fn put(url: string, body: string) -> HttpResponse {
        let handle = curl_easy_init();
        if (handle == null) {
            return HttpResponse { statusCode: 0, body: "", ok: false };
        }
        curl_easy_setopt(handle, 10002, url.c_str() as rawptr);
        curl_easy_setopt(handle, 10036, "PUT");
        curl_easy_setopt(handle, 10015, body.c_str() as rawptr);
        curl_easy_setopt(handle, 52, 1 as rawptr);
        let headers = curl_slist_append(null, "Content-Type: application/json");
        curl_easy_setopt(handle, 10023, headers);
        let sink = tmpfile();
        if (sink != null) { curl_easy_setopt(handle, 10001, sink); }
        let result = curl_easy_perform(handle);
        var code: i32 = 0;
        curl_easy_getinfo(handle, 0x200002, &mut code as rawptr);
        curl_slist_free_all(headers);
        curl_easy_cleanup(handle);
        var body = "";
        if (sink != null) { body = http_read_sink(sink); }
        return HttpResponse { statusCode: code, body: body, ok: result == 0 };
    }

    /// Perform a PATCH request.
    public fn patch(url: string, body: string) -> HttpResponse {
        let handle = curl_easy_init();
        if (handle == null) {
            return HttpResponse { statusCode: 0, body: "", ok: false };
        }
        curl_easy_setopt(handle, 10002, url.c_str() as rawptr);
        curl_easy_setopt(handle, 10036, "PATCH");
        curl_easy_setopt(handle, 10015, body.c_str() as rawptr);
        curl_easy_setopt(handle, 52, 1 as rawptr);
        let headers = curl_slist_append(null, "Content-Type: application/json");
        curl_easy_setopt(handle, 10023, headers);
        let sink = tmpfile();
        if (sink != null) { curl_easy_setopt(handle, 10001, sink); }
        let result = curl_easy_perform(handle);
        var code: i32 = 0;
        curl_easy_getinfo(handle, 0x200002, &mut code as rawptr);
        curl_slist_free_all(headers);
        curl_easy_cleanup(handle);
        var body = "";
        if (sink != null) { body = http_read_sink(sink); }
        return HttpResponse { statusCode: code, body: body, ok: result == 0 };
    }

    /// Perform a DELETE request.
    public fn delete(url: string) -> HttpResponse {
        let handle = curl_easy_init();
        if (handle == null) {
            return HttpResponse { statusCode: 0, body: "", ok: false };
        }
        curl_easy_setopt(handle, 10002, url.c_str() as rawptr);
        curl_easy_setopt(handle, 10036, "DELETE");
        curl_easy_setopt(handle, 52, 1 as rawptr);
        let sink = tmpfile();
        if (sink != null) { curl_easy_setopt(handle, 10001, sink); }
        let result = curl_easy_perform(handle);
        var code: i32 = 0;
        curl_easy_getinfo(handle, 0x200002, &mut code as rawptr);
        curl_easy_cleanup(handle);
        var body = "";
        if (sink != null) { body = http_read_sink(sink); }
        return HttpResponse { statusCode: code, body: body, ok: result == 0 };
    }

    /// Perform a HEAD request (returns status only, no body).
    public fn head(url: string) -> HttpResponse {
        let handle = curl_easy_init();
        if (handle == null) {
            return HttpResponse { statusCode: 0, body: "", ok: false };
        }
        curl_easy_setopt(handle, 10002, url.c_str() as rawptr);
        curl_easy_setopt(handle, 44, 1 as rawptr);
        let sink = tmpfile();
        if (sink != null) { curl_easy_setopt(handle, 10001, sink); }
        let result = curl_easy_perform(handle);
        var code: i32 = 0;
        curl_easy_getinfo(handle, 0x200002, &mut code as rawptr);
        curl_easy_cleanup(handle);
        var body = "";
        if (sink != null) { body = http_read_sink(sink); }
        return HttpResponse { statusCode: code, body: body, ok: result == 0 };
    }
}
