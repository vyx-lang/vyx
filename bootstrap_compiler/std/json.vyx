module std.json;

use std.core;

extern "C" {
    fn vyx_json_parse(text: rawptr, error_offset: rawptr) -> rawptr;
    fn vyx_json_new_null() -> rawptr;
    fn vyx_json_new_bool(value: i32) -> rawptr;
    fn vyx_json_new_number(value: f64) -> rawptr;
    fn vyx_json_new_string(value: rawptr) -> rawptr;
    fn vyx_json_new_array() -> rawptr;
    fn vyx_json_new_object() -> rawptr;
    fn vyx_json_release(owner: rawptr);
    fn vyx_json_duplicate(owner: rawptr) -> rawptr;
    fn vyx_json_type(owner: rawptr) -> i32;
    fn vyx_json_size(owner: rawptr) -> i64;
    fn vyx_json_string_value(owner: rawptr) -> rawptr;
    fn vyx_json_number_value(owner: rawptr) -> f64;
    fn vyx_json_bool_value(owner: rawptr) -> i32;
    fn vyx_json_object_item_type(owner: rawptr, key: rawptr) -> i32;
    fn vyx_json_object_string(owner: rawptr, key: rawptr) -> rawptr;
    fn vyx_json_object_number(owner: rawptr, key: rawptr) -> f64;
    fn vyx_json_object_bool(owner: rawptr, key: rawptr) -> i32;
    fn vyx_json_object_get(owner: rawptr, key: rawptr) -> rawptr;
    fn vyx_json_array_get(owner: rawptr, index: i64) -> rawptr;
    fn vyx_json_object_key_at(owner: rawptr, index: i64) -> rawptr;
    fn vyx_json_object_put_null(owner: rawptr, key: rawptr) -> i32;
    fn vyx_json_object_put_bool(owner: rawptr, key: rawptr, value: i32) -> i32;
    fn vyx_json_object_put_number(owner: rawptr, key: rawptr, value: f64) -> i32;
    fn vyx_json_object_put_string(owner: rawptr, key: rawptr, value: rawptr) -> i32;
    fn vyx_json_object_put_value(owner: rawptr, key: rawptr, value: rawptr) -> i32;
    fn vyx_json_array_push_null(owner: rawptr) -> i32;
    fn vyx_json_array_push_bool(owner: rawptr, value: i32) -> i32;
    fn vyx_json_array_push_number(owner: rawptr, value: f64) -> i32;
    fn vyx_json_array_push_string(owner: rawptr, value: rawptr) -> i32;
    fn vyx_json_array_push_value(owner: rawptr, value: rawptr) -> i32;
    fn vyx_json_object_remove(owner: rawptr, key: rawptr) -> i32;
    fn vyx_json_print(owner: rawptr, pretty: i32) -> rawptr;
    fn vyx_json_string_free(value: rawptr);
}

public class JsonError {
    public code: i32;
    public message: string;
    public offset: i64;
}

fn json_error(code: i32, message: string) -> JsonError {
    return JsonError { code: code, message: message, offset: -1 };
}

fn json_error_at(code: i32, message: string, offset: i64) -> JsonError {
    return JsonError { code: code, message: message, offset: offset };
}

public fn json_error_parse() -> i32 { return 1; }
public fn json_error_missing() -> i32 { return 2; }
public fn json_error_type() -> i32 { return 3; }
public fn json_error_range() -> i32 { return 4; }
public fn json_error_allocation() -> i32 { return 5; }
public fn json_error_invalid() -> i32 { return 6; }

public fn json_type_invalid() -> i32 { return 0; }
public fn json_type_null() -> i32 { return 1; }
public fn json_type_bool() -> i32 { return 2; }
public fn json_type_number() -> i32 { return 3; }
public fn json_type_string() -> i32 { return 4; }
public fn json_type_array() -> i32 { return 5; }
public fn json_type_object() -> i32 { return 6; }

public class Json {
    private owner: rawptr;

    private static fn from_owner(owner: rawptr) -> Result<Json, JsonError> {
        if (owner == null) {
            return Err(json_error(json_error_allocation(), "JSON allocation failed"));
        }
        return Ok(Json { owner: owner });
    }

    public static fn parse(text: string) -> Result<Json, JsonError> {
        var offset: i64 = -1;
        let owner = vyx_json_parse(text.c_str(), to_rawptr(&offset));
        if (owner == null) {
            return Err(json_error_at(json_error_parse(), "invalid JSON", offset));
        }
        return Ok(Json { owner: owner });
    }

    public static fn null_value() -> Result<Json, JsonError> {
        return Json.from_owner(vyx_json_new_null());
    }

    public static fn boolean(value: bool) -> Result<Json, JsonError> {
        return Json.from_owner(vyx_json_new_bool(value ? 1 : 0));
    }

    public static fn number(value: f64) -> Result<Json, JsonError> {
        return Json.from_owner(vyx_json_new_number(value));
    }

    public static fn string_value(value: string) -> Result<Json, JsonError> {
        return Json.from_owner(vyx_json_new_string(value.c_str()));
    }

    public static fn array() -> Result<Json, JsonError> {
        return Json.from_owner(vyx_json_new_array());
    }

    public static fn object() -> Result<Json, JsonError> {
        return Json.from_owner(vyx_json_new_object());
    }

    public fn valid() -> bool { return self.owner != null; }
    public fn kind() -> i32 { return vyx_json_type(self.owner); }
    public fn is_null() -> bool { return self.kind() == json_type_null(); }
    public fn is_bool() -> bool { return self.kind() == json_type_bool(); }
    public fn is_number() -> bool { return self.kind() == json_type_number(); }
    public fn is_string() -> bool { return self.kind() == json_type_string(); }
    public fn is_array() -> bool { return self.kind() == json_type_array(); }
    public fn is_object() -> bool { return self.kind() == json_type_object(); }

    public fn try_clone() -> Result<Json, JsonError> {
        if (!self.valid()) { return Err(json_error(json_error_invalid(), "invalid JSON value")); }
        return Json.from_owner(vyx_json_duplicate(self.owner));
    }

    public fn clone() -> Json {
        let copy = vyx_json_duplicate(self.owner);
        if (copy == null) { panic("Json::clone allocation failed"); }
        return Json { owner: copy };
    }

    public fn len() -> Result<i64, JsonError> {
        let size = vyx_json_size(self.owner);
        if (size < 0) { return Err(json_error(json_error_type(), "JSON value is not an array or object")); }
        return Ok(size);
    }

    public fn get(key: string) -> Result<Json, JsonError> {
        let item_type = vyx_json_object_item_type(self.owner, key.c_str());
        if (item_type == -2) { return Err(json_error(json_error_type(), "JSON value is not an object")); }
        if (item_type == -1) { return Err(json_error(json_error_missing(), "object key not found: " + key)); }
        let item = vyx_json_object_get(self.owner, key.c_str());
        if (item == null) { return Err(json_error(json_error_allocation(), "JSON allocation failed")); }
        return Ok(Json { owner: item });
    }

    public fn at(index: i64) -> Result<Json, JsonError> {
        if (!self.is_array()) { return Err(json_error(json_error_type(), "JSON value is not an array")); }
        let size = vyx_json_size(self.owner);
        if (index < 0 || index >= size) { return Err(json_error(json_error_range(), "array index out of range")); }
        let item = vyx_json_array_get(self.owner, index);
        if (item == null) { return Err(json_error(json_error_allocation(), "JSON allocation failed")); }
        return Ok(Json { owner: item });
    }

    public fn key_at(index: i64) -> Result<string, JsonError> {
        if (!self.is_object()) { return Err(json_error(json_error_type(), "JSON value is not an object")); }
        let size = vyx_json_size(self.owner);
        if (index < 0 || index >= size) { return Err(json_error(json_error_range(), "object index out of range")); }
        let key = vyx_json_object_key_at(self.owner, index);
        if (key == null) { return Err(json_error(json_error_invalid(), "object key is unavailable")); }
        return Ok(from_cstr(key));
    }

    public fn as_string() -> Result<string, JsonError> {
        if (!self.is_string()) { return Err(json_error(json_error_type(), "JSON value is not a string")); }
        let value = vyx_json_string_value(self.owner);
        if (value == null) { return Err(json_error(json_error_invalid(), "JSON string is unavailable")); }
        return Ok(from_cstr(value));
    }

    public fn as_number() -> Result<f64, JsonError> {
        if (!self.is_number()) { return Err(json_error(json_error_type(), "JSON value is not a number")); }
        return Ok(vyx_json_number_value(self.owner));
    }

    public fn as_bool() -> Result<bool, JsonError> {
        if (!self.is_bool()) { return Err(json_error(json_error_type(), "JSON value is not a boolean")); }
        return Ok(vyx_json_bool_value(self.owner) != 0);
    }

    public fn get_string(key: string) -> Result<string, JsonError> {
        let item_type = vyx_json_object_item_type(self.owner, key.c_str());
        if (item_type == -2) { return Err(json_error(json_error_type(), "JSON value is not an object")); }
        if (item_type == -1) { return Err(json_error(json_error_missing(), "object key not found: " + key)); }
        if (item_type != json_type_string()) { return Err(json_error(json_error_type(), "object value is not a string")); }
        let value = vyx_json_object_string(self.owner, key.c_str());
        if (value == null) { return Err(json_error(json_error_invalid(), "JSON string is unavailable")); }
        return Ok(from_cstr(value));
    }

    public fn get_number(key: string) -> Result<f64, JsonError> {
        let item_type = vyx_json_object_item_type(self.owner, key.c_str());
        if (item_type == -2) { return Err(json_error(json_error_type(), "JSON value is not an object")); }
        if (item_type == -1) { return Err(json_error(json_error_missing(), "object key not found: " + key)); }
        if (item_type != json_type_number()) { return Err(json_error(json_error_type(), "object value is not a number")); }
        return Ok(vyx_json_object_number(self.owner, key.c_str()));
    }

    public fn get_bool(key: string) -> Result<bool, JsonError> {
        let item_type = vyx_json_object_item_type(self.owner, key.c_str());
        if (item_type == -2) { return Err(json_error(json_error_type(), "JSON value is not an object")); }
        if (item_type == -1) { return Err(json_error(json_error_missing(), "object key not found: " + key)); }
        if (item_type != json_type_bool()) { return Err(json_error(json_error_type(), "object value is not a boolean")); }
        return Ok(vyx_json_object_bool(self.owner, key.c_str()) != 0);
    }

    private fn mutation_result(code: i32, expected: string) -> Result<i32, JsonError> {
        if (code == 0) { return Ok(0); }
        if (code == -1) { return Err(json_error(json_error_type(), expected)); }
        return Err(json_error(json_error_allocation(), "JSON allocation failed"));
    }

    public fn put_null(key: string) -> Result<i32, JsonError> {
        return self.mutation_result(vyx_json_object_put_null(self.owner, key.c_str()), "JSON value is not an object");
    }

    public fn put_bool(key: string, value: bool) -> Result<i32, JsonError> {
        return self.mutation_result(vyx_json_object_put_bool(self.owner, key.c_str(), value ? 1 : 0), "JSON value is not an object");
    }

    public fn put_number(key: string, value: f64) -> Result<i32, JsonError> {
        return self.mutation_result(vyx_json_object_put_number(self.owner, key.c_str(), value), "JSON value is not an object");
    }

    public fn put_string(key: string, value: string) -> Result<i32, JsonError> {
        return self.mutation_result(vyx_json_object_put_string(self.owner, key.c_str(), value.c_str()), "JSON value is not an object");
    }

    public fn put(key: string, value: Json) -> Result<i32, JsonError> {
        return self.mutation_result(vyx_json_object_put_value(self.owner, key.c_str(), value.owner), "JSON value is not an object");
    }

    public fn push_null() -> Result<i32, JsonError> {
        return self.mutation_result(vyx_json_array_push_null(self.owner), "JSON value is not an array");
    }

    public fn push_bool(value: bool) -> Result<i32, JsonError> {
        return self.mutation_result(vyx_json_array_push_bool(self.owner, value ? 1 : 0), "JSON value is not an array");
    }

    public fn push_number(value: f64) -> Result<i32, JsonError> {
        return self.mutation_result(vyx_json_array_push_number(self.owner, value), "JSON value is not an array");
    }

    public fn push_string(value: string) -> Result<i32, JsonError> {
        return self.mutation_result(vyx_json_array_push_string(self.owner, value.c_str()), "JSON value is not an array");
    }

    public fn push(value: Json) -> Result<i32, JsonError> {
        return self.mutation_result(vyx_json_array_push_value(self.owner, value.owner), "JSON value is not an array");
    }

    public fn remove(key: string) -> Result<bool, JsonError> {
        let code = vyx_json_object_remove(self.owner, key.c_str());
        if (code < 0) { return Err(json_error(json_error_type(), "JSON value is not an object")); }
        return Ok(code != 0);
    }

    private fn format(pretty: bool) -> Result<string, JsonError> {
        let raw = vyx_json_print(self.owner, pretty ? 1 : 0);
        if (raw == null) { return Err(json_error(json_error_allocation(), "JSON formatting failed")); }
        let text = from_cstr(raw).clone();
        vyx_json_string_free(raw);
        return Ok(text);
    }

    public fn to_string() -> Result<string, JsonError> { return self.format(false); }
    public fn to_pretty_string() -> Result<string, JsonError> { return self.format(true); }

    public fn destroy() { self.drop(); }

    public fn drop() {
        if (self.owner != null) {
            vyx_json_release(self.owner);
            self.owner = null;
        }
    }
}
