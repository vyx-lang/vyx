}

public class Surface {
    private handle: rawptr;
    private owns: bool;

    public fn clone() -> Surface { return Surface { handle: self.handle, owns: false }; }

    public fn capabilities(adapter: Adapter) -> Result<SurfaceCapabilities, CacaoError> {
        var caps = CacaoSurfaceCapabilities_C {
            min_image_count: 0,
            max_image_count: 0,
            current_extent: CacaoExtent2D_C { width: 0, height: 0 },
            min_image_extent: CacaoExtent2D_C { width: 0, height: 0 },
            max_image_extent: CacaoExtent2D_C { width: 0, height: 0 },
            current_transform: CacaoSurfaceTransform_C { rotation: 0, flip_horizontal: false, flip_vertical: false }
        };
        let rc = cacao_surface_get_capabilities(self.handle, adapter.handle, to_rawptr(&caps));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(SurfaceCapabilities {
            min_image_count: caps.min_image_count,
            max_image_count: caps.max_image_count,
            current_extent: Extent2D.create(caps.current_extent.width, caps.current_extent.height),
            min_image_extent: Extent2D.create(caps.min_image_extent.width, caps.min_image_extent.height),
            max_image_extent: Extent2D.create(caps.max_image_extent.width, caps.max_image_extent.height),
            current_transform: SurfaceTransform.create(caps.current_transform.rotation, caps.current_transform.flip_horizontal, caps.current_transform.flip_vertical)
        });
    }

    public fn destroy() {
        if (self.handle != null && self.owns) {
            cacao_surface_release(self.handle);
        }
        self.handle = null;
        self.owns = false;
    }

    public fn drop() { return; }
}

