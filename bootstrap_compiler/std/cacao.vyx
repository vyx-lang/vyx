public class CommandEncoder {
    private handle: rawptr;
    private owns: bool;

    public fn clone() -> CommandEncoder { return CommandEncoder { handle: self.handle, owns: false }; }

    public fn isValid() -> bool { return self.handle != null; }

    public fn reset() -> Result<i32, CacaoError> { return cacao_check(cacao_cmd_reset(self.handle)); }
    public fn begin(one_time_submit: bool, simultaneous_use: bool) -> Result<i32, CacaoError> { return cacao_check(cacao_cmd_begin(self.handle, one_time_submit, simultaneous_use)); }
    public fn end() -> Result<i32, CacaoError> { return cacao_check(cacao_cmd_end(self.handle)); }
    public fn endRendering() -> Result<i32, CacaoError> { return cacao_check(cacao_cmd_end_rendering(self.handle)); }

    public fn setViewport(x: f32, y: f32, width: f32, height: f32, min_depth: f32, max_depth: f32) -> Result<i32, CacaoError> {
        return cacao_check(cacao_cmd_set_viewport(self.handle, x, y, width, height, min_depth, max_depth));
    }

    public fn setScissor(rect: Rect2D) -> Result<i32, CacaoError> {
        var crect = CacaoRect2D_C { offset_x: rect.x, offset_y: rect.y, width: rect.width, height: rect.height };
        return cacao_check(cacao_cmd_set_scissor(self.handle, to_rawptr(&crect)));
    }

    public fn beginRendering(&mut self, info: &RenderingInfo) -> Result<i32, CacaoError> {
        var attachments = Vec::<CacaoRenderingAttachmentInfo_C>.with_capacity(info.color_attachments.len);
        var i: i64 = 0;
        while (i < info.color_attachments.len) {
            let a = info.color_attachments.get(i);
            attachments.push(CacaoRenderingAttachmentInfo_C { texture: a.texture.handle, load_op: a.load_op, store_op: a.store_op, clear_r: a.clear_r, clear_g: a.clear_g, clear_b: a.clear_b, clear_a: a.clear_a, clear_depth: a.clear_depth, clear_stencil: a.clear_stencil });
            i = i + 1;
        }
        var depth_attachment = CacaoRenderingAttachmentInfo_C { texture: null, load_op: load_op_dont_care(), store_op: store_op_dont_care(), clear_r: 0.0, clear_g: 0.0, clear_b: 0.0, clear_a: 0.0, clear_depth: 1.0, clear_stencil: 0 };
        var depth_ptr: rawptr = null;
        if (info.has_depth_attachment) {
            depth_attachment = CacaoRenderingAttachmentInfo_C { texture: info.depth_attachment.texture.handle, load_op: info.depth_attachment.load_op, store_op: info.depth_attachment.store_op, clear_r: info.depth_attachment.clear_r, clear_g: info.depth_attachment.clear_g, clear_b: info.depth_attachment.clear_b, clear_a: info.depth_attachment.clear_a, clear_depth: info.depth_attachment.clear_depth, clear_stencil: info.depth_attachment.clear_stencil };
            depth_ptr = to_rawptr(&depth_attachment);
        }
        var stencil_attachment = CacaoRenderingAttachmentInfo_C { texture: null, load_op: load_op_dont_care(), store_op: store_op_dont_care(), clear_r: 0.0, clear_g: 0.0, clear_b: 0.0, clear_a: 0.0, clear_depth: 1.0, clear_stencil: 0 };
        var stencil_ptr: rawptr = null;
        if (info.has_stencil_attachment) {
            stencil_attachment = CacaoRenderingAttachmentInfo_C { texture: info.stencil_attachment.texture.handle, load_op: info.stencil_attachment.load_op, store_op: info.stencil_attachment.store_op, clear_r: info.stencil_attachment.clear_r, clear_g: info.stencil_attachment.clear_g, clear_b: info.stencil_attachment.clear_b, clear_a: info.stencil_attachment.clear_a, clear_depth: info.stencil_attachment.clear_depth, clear_stencil: info.stencil_attachment.clear_stencil };
            stencil_ptr = to_rawptr(&stencil_attachment);
        }
        var cinfo = CacaoRenderingInfo_C {
            render_area: CacaoRect2D_C { offset_x: info.render_area.x, offset_y: info.render_area.y, width: info.render_area.width, height: info.render_area.height },
            color_attachments: attachments.data,
            color_attachment_count: attachments.len as u32,
            depth_attachment: depth_ptr,
            stencil_attachment: stencil_ptr,
            layer_count: info.layer_count
        };
        let rc = cacao_cmd_begin_rendering(self.handle, to_rawptr(&cinfo));
        attachments.destroy();
        return cacao_check(rc);
    }

