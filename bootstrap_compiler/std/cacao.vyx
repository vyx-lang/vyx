public class TextureDesc {
    public kind: u32;
    public width: u32;
    public height: u32;
    public depth: u32;
    public array_layers: u32;
    public mip_levels: u32;
    public format: u32;
    public usage: u32;
    public initial_state: u32;
    public sample_count: u32;
    public name: string;
    private initial_data: rawptr;

    public static fn create(kind: u32, width: u32, height: u32, depth: u32, format: u32, usage: u32, name: string) -> TextureDesc {
        return TextureDesc { kind: kind, width: width, height: height, depth: depth, array_layers: 1, mip_levels: 1, format: format, usage: usage, initial_state: resource_undefined(), sample_count: 1, name: name, initial_data: null };
    }

    public static fn create1D(width: u32, format: u32, usage: u32, name: string) -> TextureDesc { return TextureDesc.create(texture_type_1d(), width, 1, 1, format, usage, name); }
    public static fn create2D(width: u32, height: u32, format: u32, usage: u32, name: string) -> TextureDesc { return TextureDesc.create(texture_type_2d(), width, height, 1, format, usage, name); }
    public static fn create3D(width: u32, height: u32, depth: u32, format: u32, usage: u32, name: string) -> TextureDesc { return TextureDesc.create(texture_type_3d(), width, height, depth, format, usage, name); }
    public static fn createCube(size: u32, format: u32, usage: u32, name: string) -> TextureDesc { return TextureDesc.create(texture_type_cube(), size, size, 1, format, usage, name).setArrayLayers(6); }
    public static fn create2DArray(width: u32, height: u32, layers: u32, format: u32, usage: u32, name: string) -> TextureDesc { return TextureDesc.create(texture_type_2d_array(), width, height, 1, format, usage, name).setArrayLayers(layers); }

    public fn setInitialState(state: u32) -> TextureDesc { self.initial_state = state; return self; }
    public fn setInitialData<T>(value: T) -> TextureDesc { self.initial_data = to_rawptr(&value); return self; }
    public fn setSampleCount(sample_count: u32) -> TextureDesc { self.sample_count = sample_count; return self; }
    public fn setArrayLayers(array_layers: u32) -> TextureDesc { self.array_layers = array_layers; return self; }
    public fn setMipLevels(mip_levels: u32) -> TextureDesc { self.mip_levels = mip_levels; return self; }
}

public class SamplerDesc {
    public mag_filter: u32;
    public min_filter: u32;
    public mipmap_mode: u32;
    public address_mode_u: u32;
    public address_mode_v: u32;
    public address_mode_w: u32;
    public mip_lod_bias: f32;
    public min_lod: f32;
    public max_lod: f32;
    public anisotropy_enable: bool;
    public max_anisotropy: f32;
    public compare_enable: bool;
    public compare_op: u32;
    public border_color: u32;
    public unnormalized_coordinates: bool;
    public name: string;

    public static fn create(name: string) -> SamplerDesc {
        return SamplerDesc { mag_filter: filter_linear(), min_filter: filter_linear(), mipmap_mode: filter_linear(), address_mode_u: sampler_address_clamp_to_edge(), address_mode_v: sampler_address_clamp_to_edge(), address_mode_w: sampler_address_clamp_to_edge(), mip_lod_bias: 0.0, min_lod: 0.0, max_lod: 1000.0, anisotropy_enable: false, max_anisotropy: 1.0, compare_enable: false, compare_op: compare_less_or_equal(), border_color: 2, unnormalized_coordinates: false, name: name };
    }

    public static fn linearClamp(name: string) -> SamplerDesc { return SamplerDesc.create(name); }
    public static fn linearRepeat(name: string) -> SamplerDesc { return SamplerDesc.create(name).setAddressMode(sampler_address_repeat(), sampler_address_repeat(), sampler_address_repeat()); }
    public static fn nearestClamp(name: string) -> SamplerDesc { return SamplerDesc.create(name).setFilter(filter_nearest(), filter_nearest()); }

    public fn setFilter(mag_filter: u32, min_filter: u32) -> SamplerDesc { self.mag_filter = mag_filter; self.min_filter = min_filter; return self; }
    public fn setMipmapMode(mipmap_mode: u32) -> SamplerDesc { self.mipmap_mode = mipmap_mode; return self; }
    public fn setAddressMode(u: u32, v: u32, w: u32) -> SamplerDesc { self.address_mode_u = u; self.address_mode_v = v; self.address_mode_w = w; return self; }
    public fn setLod(min_lod: f32, max_lod: f32, bias: f32) -> SamplerDesc { self.min_lod = min_lod; self.max_lod = max_lod; self.mip_lod_bias = bias; return self; }
    public fn setAnisotropy(enable: bool, max_anisotropy: f32) -> SamplerDesc { self.anisotropy_enable = enable; self.max_anisotropy = max_anisotropy; return self; }
    public fn setCompare(enable: bool, compare_op: u32) -> SamplerDesc { self.compare_enable = enable; self.compare_op = compare_op; return self; }
    public fn setBorderColor(border_color: u32) -> SamplerDesc { self.border_color = border_color; return self; }
    public fn setUnnormalizedCoordinates(enabled: bool) -> SamplerDesc { self.unnormalized_coordinates = enabled; return self; }
}

public class SwapchainDesc {
    public extent: Extent2D;
    public format: u32;
    public color_space: u32;
    public present_mode: u32;
    public min_image_count: u32;
    public pre_transform_rotation: u32;
    public pre_transform_flip_horizontal: bool;
    public pre_transform_flip_vertical: bool;
    public composite_alpha: u32;
    public usage: u32;
    public clipped: bool;
    public image_array_layers: u32;

    public static fn create(width: u32, height: u32, format: u32, usage: u32) -> SwapchainDesc {
        return SwapchainDesc {
            extent: Extent2D.create(width, height),
            format: format,
            color_space: color_space_srgb_nonlinear(),
            present_mode: present_mode_mailbox(),
            min_image_count: 3,
            pre_transform_rotation: 0,
            pre_transform_flip_horizontal: false,
            pre_transform_flip_vertical: false,
            composite_alpha: composite_alpha_opaque(),
            usage: usage,
            clipped: true,
            image_array_layers: 1
        };
    }

    public fn setPresentMode(present_mode: u32) -> SwapchainDesc { self.present_mode = present_mode; return self; }
    public fn setMinImageCount(min_image_count: u32) -> SwapchainDesc { self.min_image_count = min_image_count; return self; }
    public fn setCompositeAlpha(composite_alpha: u32) -> SwapchainDesc { self.composite_alpha = composite_alpha; return self; }
}

