    }

    public fn traceRays(sbt: ShaderBindingTable, width: u32, height: u32, depth: u32) -> Result<i32, CacaoError> {
        return cacao_check(cacao_cmd_trace_rays(self.handle, sbt.handle, width, height, depth));
    }

    public fn destroy() {
        if (self.handle != null && self.owns) {
            cacao_command_encoder_release(self.handle);
        }
        self.handle = null;
        self.owns = false;
    }

    public fn drop() { return; }
}


