    public fn createGraphicsPipeline(desc: GraphicsPipelineDesc) -> Result<GraphicsPipeline, CacaoError> {
        var shaders = Vec::<rawptr>.with_capacity(desc.shaders.len);
        var i: i64 = 0;
        while (i < desc.shaders.len) {
            let shader = desc.shaders.get(i);
            shaders.push(shader.handle);
            i = i + 1;
        }
        var bindings = Vec::<CacaoVertexInputBinding_C>.with_capacity(desc.vertex_bindings.len);
        i = 0;
        while (i < desc.vertex_bindings.len) {
            let b = desc.vertex_bindings.get(i);
            bindings.push(CacaoVertexInputBinding_C { binding: b.binding, stride: b.stride, input_rate: b.input_rate });
            i = i + 1;
        }
        var attributes = Vec::<CacaoVertexInputAttribute_C>.with_capacity(desc.vertex_attributes.len);
        i = 0;
        while (i < desc.vertex_attributes.len) {
            let a = desc.vertex_attributes.get(i);
            attributes.push(CacaoVertexInputAttribute_C { location: a.location, binding: a.binding, format: a.format, offset: a.offset, semantic_name: cacao_vertex_semantic_cstr(a.semantic_name), semantic_index: a.semantic_index });
            i = i + 1;
        }
        var blend_states = Vec::<CacaoColorBlendAttachmentState_C>.with_capacity(desc.color_blend_attachments.len);
        i = 0;
        while (i < desc.color_blend_attachments.len) {
            let b = desc.color_blend_attachments.get(i);
            blend_states.push(CacaoColorBlendAttachmentState_C { blend_enable: b.blend_enable, src_color_blend_factor: b.src_color_blend_factor, dst_color_blend_factor: b.dst_color_blend_factor, color_blend_op: b.color_blend_op, src_alpha_blend_factor: b.src_alpha_blend_factor, dst_alpha_blend_factor: b.dst_alpha_blend_factor, alpha_blend_op: b.alpha_blend_op, color_write_mask: b.color_write_mask });
            i = i + 1;
        }
        var cdesc = CacaoGraphicsPipelineCreateInfo_C {
            shaders: shaders.data,
            shader_count: shaders.len as u32,
            vertex_bindings: bindings.data,
            vertex_binding_count: bindings.len as u32,
            vertex_attributes: attributes.data,
            vertex_attribute_count: attributes.len as u32,
            topology: desc.topology,
            primitive_restart_enable: desc.primitive_restart_enable,
            polygon_mode: desc.polygon_mode,
            cull_mode: desc.cull_mode,
            front_face: desc.front_face,
            line_width: desc.line_width,
            depth_test_enable: desc.depth_test_enable,
            depth_write_enable: desc.depth_write_enable,
            depth_compare_op: desc.depth_compare_op,
            stencil_test_enable: desc.stencil_test_enable,
            stencil_front: CacaoStencilOpState_C { fail_op: desc.stencil_front.fail_op, pass_op: desc.stencil_front.pass_op, depth_fail_op: desc.stencil_front.depth_fail_op, compare_op: desc.stencil_front.compare_op, compare_mask: desc.stencil_front.compare_mask, write_mask: desc.stencil_front.write_mask, reference: desc.stencil_front.reference },
            stencil_back: CacaoStencilOpState_C { fail_op: desc.stencil_back.fail_op, pass_op: desc.stencil_back.pass_op, depth_fail_op: desc.stencil_back.depth_fail_op, compare_op: desc.stencil_back.compare_op, compare_mask: desc.stencil_back.compare_mask, write_mask: desc.stencil_back.write_mask, reference: desc.stencil_back.reference },
            stencil_read_mask: desc.stencil_read_mask,
            stencil_write_mask: desc.stencil_write_mask,
            color_blend_attachments: blend_states.data,
            color_blend_attachment_count: blend_states.len as u32,
            color_attachment_formats: desc.color_attachment_formats.data,
            color_attachment_format_count: desc.color_attachment_formats.len as u32,
            depth_stencil_format: desc.depth_stencil_format,
            sample_count: desc.sample_count,
            layout: desc.layout.handle
        };
        var out: rawptr = null;
        let rc = cacao_device_create_graphics_pipeline(self.handle, to_rawptr(&cdesc), to_rawptr(&out));
        shaders.destroy();
        bindings.destroy();
        attributes.destroy();
        blend_states.destroy();
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(GraphicsPipeline { handle: out, owns: true });
    }

