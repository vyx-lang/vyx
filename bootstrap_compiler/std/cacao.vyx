public class NativeWindowHandle {
    public hwnd: u64;
    public hinstance: u64;
    public metal_layer: u64;
    public wayland_display: u64;
    public wayland_surface: u64;
    public xcb_connection: u64;
    public xcb_window: u32;
    public x11_display: u64;
    public x11_window: u64;
    public android_native_window: u64;

    public static fn empty() -> NativeWindowHandle {
        return NativeWindowHandle { hwnd: 0, hinstance: 0, metal_layer: 0, wayland_display: 0, wayland_surface: 0, xcb_connection: 0, xcb_window: 0, x11_display: 0, x11_window: 0, android_native_window: 0 };
    }

    public static fn win32(hwnd: u64, hinstance: u64) -> NativeWindowHandle {
        var h = NativeWindowHandle.empty();
        h.hwnd = hwnd;
        h.hinstance = hinstance;
        return h;
    }

    public static fn metal(layer: u64) -> NativeWindowHandle {
        var h = NativeWindowHandle.empty();
        h.metal_layer = layer;
        return h;
    }

    public static fn wayland(display: u64, surface: u64) -> NativeWindowHandle {
        var h = NativeWindowHandle.empty();
        h.wayland_display = display;
        h.wayland_surface = surface;
        return h;
    }

    public static fn xcb(connection: u64, window: u32) -> NativeWindowHandle {
        var h = NativeWindowHandle.empty();
        h.xcb_connection = connection;
        h.xcb_window = window;
        return h;
    }

    public static fn x11(display: u64, window: u64) -> NativeWindowHandle {
        var h = NativeWindowHandle.empty();
        h.x11_display = display;
        h.x11_window = window;
        return h;
    }

    public static fn android(native_window: u64) -> NativeWindowHandle {
        var h = NativeWindowHandle.empty();
        h.android_native_window = native_window;
        return h;
    }
}

public class Win32WindowHandle {
    public hwnd: u64;
    public hinstance: u64;

    public static fn create(hwnd: u64, hinstance: u64) -> Win32WindowHandle {
        return Win32WindowHandle { hwnd: hwnd, hinstance: hinstance };
    }

    public fn native() -> NativeWindowHandle {
        return NativeWindowHandle.win32(self.hwnd, self.hinstance);
    }
}

