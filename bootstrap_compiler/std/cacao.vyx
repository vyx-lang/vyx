    public fn bindDescriptorSets(pipeline: GraphicsPipeline, first_set: u32, sets: Vec<DescriptorSet>) -> Result<i32, CacaoError> {
        var handles = Vec::<rawptr>.with_capacity(sets.len);
        var i: i64 = 0;
        while (i < sets.len) {
            let set = sets.get(i);
            handles.push(set.handle);
            i = i + 1;
        }
        let rc = cacao_cmd_bind_descriptor_sets(self.handle, pipeline.handle, first_set, handles.data, handles.len as u32);
        handles.destroy();
        return cacao_check(rc);
    }

    public fn pushConstants<T>(pipeline: GraphicsPipeline, stage_flags: u32, offset: u32, value: T) -> Result<i32, CacaoError> {
        let n = sizeof::<T>() as u32;
        return cacao_check(cacao_cmd_push_constants(self.handle, pipeline.handle, stage_flags, offset, n, to_rawptr(&value)));
    }

