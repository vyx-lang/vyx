public class Instance {
    private handle: rawptr;
    private owns: bool;

    public fn clone() -> Instance { return Instance { handle: self.handle, owns: false }; }

    public static fn create(desc: InstanceDesc) -> Result<Instance, CacaoError> {
        var cdesc = CacaoInstanceCreateInfo_C {
            backend_type: desc.backend,
            application_name: desc.application_name.c_str(),
            app_version: desc.app_version,
            enabled_features: desc.enabled_features.data,
            enabled_feature_count: desc.enabled_features.len as u32
        };
        var out: rawptr = null;
        let rc = cacao_instance_create(to_rawptr(&cdesc), to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(Instance { handle: out, owns: true });
    }

    public fn isValid() -> bool { return self.handle != null; }

    public fn backendType() -> Result<u32, CacaoError> {
        var out: u32 = 0;
        let rc = cacao_instance_get_backend_type(self.handle, to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(out);
    }

    public fn firstAdapter() -> Result<Adapter, CacaoError> {
        var count: u32 = 0;
        var rc = cacao_instance_enumerate_adapters(self.handle, null, to_rawptr(&count));
        if (rc != 0 && count == 0) { return Err(CacaoError.fromCode(rc)); }
        if (count == 0) { return Err(CacaoError { code: -1, message: "no Cacao adapter" }); }

        var adapters = Vec::<rawptr>.with_capacity(count as i64);
        var i: u32 = 0;
        while (i < count) {
            adapters.push(null);
            i = i + 1;
        }

        var requested: u32 = count;
        rc = cacao_instance_enumerate_adapters(self.handle, adapters.data, to_rawptr(&requested));
        if (rc != 0) {
            adapters.destroy();
            return Err(CacaoError.fromCode(rc));
        }
        if (requested == 0) {
            adapters.destroy();
            return Err(CacaoError { code: -1, message: "no Cacao adapter" });
        }

        let first = adapters.get(0);
        var extra: u32 = 1;
        while (extra < requested) {
            let adapter = adapters.get(extra as i64);
            if (adapter != null) { cacao_adapter_release(adapter); }
            extra = extra + 1;
        }
        adapters.destroy();
        return Ok(Adapter { handle: first, owns: true });
    }

    public fn createNativeSurface(window: NativeWindowHandle) -> Result<Surface, CacaoError> {
        var native = CacaoNativeWindowHandle_C {
            hwnd: window.hwnd as rawptr,
            hinstance: window.hinstance as rawptr,
            metal_layer: window.metal_layer as rawptr,
            wayland_display: window.wayland_display as rawptr,
            wayland_surface: window.wayland_surface as rawptr,
            xcb_connection: window.xcb_connection as rawptr,
            xcb_window: window.xcb_window,
            x11_display: window.x11_display as rawptr,
            x11_window: window.x11_window,
            android_native_window: window.android_native_window as rawptr
        };
        var out: rawptr = null;
        let rc = cacao_instance_create_surface(self.handle, to_rawptr(&native), to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(Surface { handle: out, owns: true });
    }

    public fn createSurface(window: Win32WindowHandle) -> Result<Surface, CacaoError> {
        return self.createNativeSurface(window.native());
    }

    public fn createShaderCompiler() -> Result<ShaderCompiler, CacaoError> {
        var out: rawptr = null;
        let rc = cacao_instance_create_shader_compiler(self.handle, to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(ShaderCompiler { handle: out, owns: true });
    }

    public fn destroy() {
        if (self.handle != null && self.owns) {
            cacao_instance_release(self.handle);
        }
        self.handle = null;
        self.owns = false;
    }

    public fn drop() { return; }
}

public class Adapter {
    private handle: rawptr;
    private owns: bool;

    public fn clone() -> Adapter { return Adapter { handle: self.handle, owns: false }; }

    public fn isValid() -> bool { return self.handle != null; }

    public fn adapterType() -> Result<u32, CacaoError> {
        var out: u32 = 0;
        let rc = cacao_adapter_get_type(self.handle, to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(out);
    }

    public fn isFeatureSupported(feature: u32) -> Result<bool, CacaoError> {
        var out: bool = false;
        let rc = cacao_adapter_is_feature_supported(self.handle, feature, to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(out);
    }

    public fn findQueueFamilyIndex(queue_type: u32) -> Result<u32, CacaoError> {
        var out: u32 = 0;
        let rc = cacao_adapter_find_queue_family_index(self.handle, queue_type, to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(out);
    }

    public fn properties() -> Result<AdapterProperties, CacaoError> {
        var props = CacaoAdapterProperties_C {
            device_id: 0,
            vendor_id: 0,
            name00: 0,
            name01: 0,
            name02: 0,
            name03: 0,
            name04: 0,
            name05: 0,
            name06: 0,
            name07: 0,
            name08: 0,
            name09: 0,
            name10: 0,
            name11: 0,
            name12: 0,
            name13: 0,
            name14: 0,
            name15: 0,
            name16: 0,
            name17: 0,
            name18: 0,
            name19: 0,
            name20: 0,
            name21: 0,
            name22: 0,
            name23: 0,
            name24: 0,
            name25: 0,
            name26: 0,
            name27: 0,
            name28: 0,
            name29: 0,
            name30: 0,
            name31: 0,
            adapter_type: 0,
            dedicated_video_memory: 0
        };
        let rc = cacao_adapter_get_properties(self.handle, to_rawptr(&props));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(AdapterProperties {
            device_id: props.device_id,
            vendor_id: props.vendor_id,
            name: from_cstr(to_rawptr(&props.name00)),
            adapter_type: props.adapter_type,
            dedicated_video_memory: props.dedicated_video_memory
        });
    }

    public fn createDevice(desc: DeviceDesc) -> Result<Device, CacaoError> {
        var q = CacaoQueueRequest_C { kind: desc.queue.queue_type, count: desc.queue.count, priority: desc.queue.priority };
        var surface_handle: rawptr = null;
        if (desc.has_compatible_surface) { surface_handle = desc.compatible_surface.handle; }
        var cdesc = CacaoDeviceCreateInfo_C {
            enabled_features: desc.enabled_features.data,
            enabled_feature_count: desc.enabled_features.len as u32,
            queue_requests: to_rawptr(&q),
            queue_request_count: 1,
            compatible_surface: surface_handle,
            next: null
        };
        var out: rawptr = null;
        let rc = cacao_adapter_create_device(self.handle, to_rawptr(&cdesc), to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(Device { handle: out, owns: true });
    }

    public fn destroy() {
        if (self.handle != null && self.owns) {
            cacao_adapter_release(self.handle);
        }
        self.handle = null;
        self.owns = false;
    }

    public fn drop() { return; }
}

public class Device {
    private handle: rawptr;
    private owns: bool;

    public fn clone() -> Device { return Device { handle: self.handle, owns: false }; }

    public fn isValid() -> bool { return self.handle != null; }

    public fn getQueue(queue_type: u32, index: u32) -> Result<DeviceQueue, CacaoError> {
        var out: rawptr = null;
        let rc = cacao_device_get_queue(self.handle, queue_type, index, to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(DeviceQueue { handle: out, owns: true });
    }

    public fn createTimelineSemaphore(initial_value: u64) -> Result<TimelineSemaphore, CacaoError> {
