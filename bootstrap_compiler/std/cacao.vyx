    }

    public fn addSetLayout(layout: DescriptorSetLayout) -> PipelineLayoutDesc {
        self.set_layouts.push(layout);
        return self;
    }

    public fn addPushConstants(stage_flags: u32, offset: u32, size: u32) -> PipelineLayoutDesc {
        self.push_constant_ranges.push(PushConstantRange.create(stage_flags, offset, size));
        return self;
    }
}

