    public src_alpha_blend_factor: u32;
    public dst_alpha_blend_factor: u32;
    public alpha_blend_op: u32;
    public color_write_mask: u32;

    public static fn opaque() -> ColorBlendAttachmentState {
        return ColorBlendAttachmentState {
            blend_enable: false,
            src_color_blend_factor: blend_one(),
            dst_color_blend_factor: blend_zero(),
            color_blend_op: blend_add(),
            src_alpha_blend_factor: blend_one(),
            dst_alpha_blend_factor: blend_zero(),
            alpha_blend_op: blend_add(),
            color_write_mask: color_write_all()
        };
    }
}

public class StencilOpState {
    public fail_op: u32;
    public pass_op: u32;
    public depth_fail_op: u32;
    public compare_op: u32;
    public compare_mask: u32;
    public write_mask: u32;
    public reference: u32;

    public static fn keep() -> StencilOpState {
        return StencilOpState { fail_op: stencil_op_keep(), pass_op: stencil_op_keep(), depth_fail_op: stencil_op_keep(), compare_op: compare_always(), compare_mask: 255 as u32, write_mask: 255 as u32, reference: 0 as u32 };
    }

    public static fn replace(reference: u32) -> StencilOpState {
        return StencilOpState { fail_op: stencil_op_keep(), pass_op: stencil_op_replace(), depth_fail_op: stencil_op_keep(), compare_op: compare_always(), compare_mask: 255 as u32, write_mask: 255 as u32, reference: reference };
    }

    public static fn testEqual(reference: u32) -> StencilOpState {
        return StencilOpState { fail_op: stencil_op_keep(), pass_op: stencil_op_keep(), depth_fail_op: stencil_op_keep(), compare_op: compare_equal(), compare_mask: 255 as u32, write_mask: 0 as u32, reference: reference };
    }

    public fn setOps(fail_op: u32, pass_op: u32, depth_fail_op: u32) -> StencilOpState { self.fail_op = fail_op; self.pass_op = pass_op; self.depth_fail_op = depth_fail_op; return self; }
    public fn setCompare(compare_op: u32) -> StencilOpState { self.compare_op = compare_op; return self; }
    public fn setMasks(compare_mask: u32, write_mask: u32) -> StencilOpState { self.compare_mask = compare_mask; self.write_mask = write_mask; return self; }
    public fn setReference(reference: u32) -> StencilOpState { self.reference = reference; return self; }
}

public class GraphicsPipelineDesc {
    public shaders: Vec<ShaderModule>;
    public vertex_bindings: Vec<VertexInputBinding>;
    public vertex_attributes: Vec<VertexInputAttribute>;
    public topology: u32;
    public primitive_restart_enable: bool;
    public polygon_mode: u32;
    public cull_mode: u32;
    public front_face: u32;
    public line_width: f32;
    public depth_test_enable: bool;
    public depth_write_enable: bool;
    public depth_compare_op: u32;
    public stencil_test_enable: bool;
    public stencil_front: StencilOpState;
    public stencil_back: StencilOpState;
    public stencil_read_mask: u32;
    public stencil_write_mask: u32;
    public color_blend_attachments: Vec<ColorBlendAttachmentState>;
    public color_attachment_formats: Vec<u32>;
    public depth_stencil_format: u32;
    public sample_count: u32;
    public layout: PipelineLayout;

    public static fn create(layout: PipelineLayout) -> GraphicsPipelineDesc {
        return GraphicsPipelineDesc {
            shaders: Vec::<ShaderModule>.new(),
            vertex_bindings: Vec::<VertexInputBinding>.new(),
            vertex_attributes: Vec::<VertexInputAttribute>.new(),
            topology: topology_triangle_list(),
            primitive_restart_enable: false,
            polygon_mode: polygon_fill(),
            cull_mode: cull_back(),
            front_face: front_face_counter_clockwise(),
            line_width: 1.0,
            depth_test_enable: false,
            depth_write_enable: false,
            depth_compare_op: compare_less_or_equal(),
            stencil_test_enable: false,
            stencil_front: StencilOpState.keep(),
            stencil_back: StencilOpState.keep(),
            stencil_read_mask: 255 as u32,
            stencil_write_mask: 255 as u32,
            color_blend_attachments: Vec::<ColorBlendAttachmentState>.new(),
            color_attachment_formats: Vec::<u32>.new(),
            depth_stencil_format: format_undefined(),
            sample_count: 1,
            layout: layout
        };
    }

    public fn addShader(shader: ShaderModule) -> GraphicsPipelineDesc { self.shaders.push(shader); return self; }
    public fn addVertexBinding(binding: u32, stride: u32) -> GraphicsPipelineDesc { self.vertex_bindings.push(VertexInputBinding.create(binding, stride, vertex_input_rate_vertex())); return self; }
    public fn addVertexAttribute(location: u32, binding: u32, format: u32, offset: u32, semantic_name: string, semantic_index: u32) -> GraphicsPipelineDesc { self.vertex_attributes.push(VertexInputAttribute.create(location, binding, format, offset, semantic_name, semantic_index)); return self; }
    public fn addColorAttachmentDefault() -> GraphicsPipelineDesc { self.color_blend_attachments.push(ColorBlendAttachmentState.opaque()); return self; }
    public fn addColorFormat(format: u32) -> GraphicsPipelineDesc { self.color_attachment_formats.push(format); return self; }
    public fn setTopology(topology: u32) -> GraphicsPipelineDesc { self.topology = topology; return self; }
    public fn setPrimitiveRestart(enabled: bool) -> GraphicsPipelineDesc { self.primitive_restart_enable = enabled; return self; }
    public fn setPolygonMode(polygon_mode: u32) -> GraphicsPipelineDesc { self.polygon_mode = polygon_mode; return self; }
    public fn setCullMode(cull_mode: u32) -> GraphicsPipelineDesc { self.cull_mode = cull_mode; return self; }
    public fn setFrontFace(front_face: u32) -> GraphicsPipelineDesc { self.front_face = front_face; return self; }
    public fn setLineWidth(line_width: f32) -> GraphicsPipelineDesc { self.line_width = line_width; return self; }
    public fn setDepthTest(test_enable: bool, write_enable: bool) -> GraphicsPipelineDesc { self.depth_test_enable = test_enable; self.depth_write_enable = write_enable; return self; }
    public fn setDepthCompare(compare_op: u32) -> GraphicsPipelineDesc { self.depth_compare_op = compare_op; return self; }
    public fn setStencilTest(enable: bool) -> GraphicsPipelineDesc { self.stencil_test_enable = enable; return self; }
    public fn setStencil(front: StencilOpState, back: StencilOpState) -> GraphicsPipelineDesc { self.stencil_front = front; self.stencil_back = back; self.stencil_read_mask = front.compare_mask; self.stencil_write_mask = front.write_mask; return self; }
    public fn setStencilReplace(reference: u32) -> GraphicsPipelineDesc { let state = StencilOpState.replace(reference); self.stencil_test_enable = true; self.stencil_front = state; self.stencil_back = state; self.stencil_read_mask = 255 as u32; self.stencil_write_mask = 255 as u32; return self; }
    public fn setStencilEqual(reference: u32) -> GraphicsPipelineDesc { let state = StencilOpState.testEqual(reference); self.stencil_test_enable = true; self.stencil_front = state; self.stencil_back = state; self.stencil_read_mask = 255 as u32; self.stencil_write_mask = 0 as u32; return self; }
    public fn setDepthStencilFormat(format: u32) -> GraphicsPipelineDesc { self.depth_stencil_format = format; return self; }
    public fn setSampleCount(sample_count: u32) -> GraphicsPipelineDesc { self.sample_count = sample_count; return self; }
}

