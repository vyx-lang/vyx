    }

    public fn bindRayTracingDescriptorSets(pipeline: RayTracingPipeline, first_set: u32, sets: Vec<DescriptorSet>) -> Result<i32, CacaoError> {
        var handles = Vec::<rawptr>.with_capacity(sets.len);
        var i: i64 = 0;
        while (i < sets.len) {
            let set = sets.get(i);
            handles.push(set.handle);
            i = i + 1;
        }
        let rc = cacao_cmd_bind_ray_tracing_descriptor_sets(self.handle, pipeline.handle, first_set, handles.data, handles.len as u32);
