public class CacaoError {
    public code: i32;
    public message: string;

    public static fn fromCode(code: i32) -> CacaoError {
        let msg_ptr = cacao_get_last_error();
        var msg = "";
        if (msg_ptr != null) { msg = from_cstr(msg_ptr); }
        return CacaoError { code: code, message: msg };
    }
}

fn cacao_check(code: i32) -> Result<i32, CacaoError> {
    if (code == 0) { return Ok(code); }
    return Err(CacaoError.fromCode(code));
}

public fn abiVersion() -> u32 {
    return cacao_get_abi_version();
}

public fn clearLastError() {
    cacao_clear_last_error();
}

public fn lastError() -> string {
    let msg = cacao_get_last_error();
    if (msg == null) { return ""; }
    return from_cstr(msg);
}

public fn bufferWriteRawHandle(buffer_handle: rawptr, data: rawptr, size: u64, offset: u64) -> Result<i32, CacaoError> {
    return cacao_check(cacao_buffer_write(buffer_handle, data, size, offset));
}

public fn bufferFlushRawHandle(buffer_handle: rawptr, offset: u64, size: u64) -> Result<i32, CacaoError> {
    return cacao_check(cacao_buffer_flush(buffer_handle, offset, size));
}

fn cacao_vertex_semantic_cstr(name: string) -> rawptr {
    if (name == "POSITION") { return "POSITION".c_str(); }
    if (name == "COLOR") { return "COLOR".c_str(); }
    if (name == "TEXCOORD") { return "TEXCOORD".c_str(); }
    if (name == "NORMAL") { return "NORMAL".c_str(); }
    if (name == "TANGENT") { return "TANGENT".c_str(); }
    return name.c_str();
}

