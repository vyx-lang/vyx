        return InstanceDesc { backend: backend, application_name: application_name, app_version: app_version, enabled_features: Vec::<u32>.new() };
    }

    public fn addFeature(feature: u32) -> InstanceDesc {
        self.enabled_features.push(feature);
        return self;
    }
}

public class QueueRequest {
    public queue_type: u32;
    public count: u32;
    public priority: f32;

    public static fn create(queue_type: u32, count: u32, priority: f32) -> QueueRequest {
        return QueueRequest { queue_type: queue_type, count: count, priority: priority };
    }

    public static fn graphics() -> QueueRequest { return QueueRequest.create(queue_graphics(), 1, 1.0); }
    public static fn compute() -> QueueRequest { return QueueRequest.create(queue_compute(), 1, 1.0); }
    public static fn transfer() -> QueueRequest { return QueueRequest.create(queue_transfer(), 1, 1.0); }
    public static fn present() -> QueueRequest { return QueueRequest.create(queue_present(), 1, 1.0); }

    public fn setCount(count: u32) -> QueueRequest { self.count = count; return self; }
    public fn setPriority(priority: f32) -> QueueRequest { self.priority = priority; return self; }
}

public class DeviceDesc {
    public queue: QueueRequest;
    public compatible_surface: Surface;
    public has_compatible_surface: bool;
    public enabled_features: Vec<u32>;

    public static fn createDefault() -> DeviceDesc {
        return DeviceDesc { queue: QueueRequest.graphics(), compatible_surface: Surface { handle: null, owns: false }, has_compatible_surface: false, enabled_features: Vec::<u32>.new() };
    }

    public static fn forSurface(surface: Surface) -> DeviceDesc {
        return DeviceDesc { queue: QueueRequest.graphics(), compatible_surface: surface, has_compatible_surface: true, enabled_features: Vec::<u32>.new() };
    }

    public fn addFeature(feature: u32) -> DeviceDesc {
        self.enabled_features.push(feature);
        return self;
    }
}

