    }

    public fn copyBufferToImage(src: Buffer, dst: Texture, dst_image_layout: u32, regions: Vec<BufferImageCopy>) -> Result<i32, CacaoError> {
        var cregions = Vec::<CacaoBufferImageCopy_C>.with_capacity(regions.len);
        var i: i64 = 0;
        while (i < regions.len) {
            let r = regions.get(i);
            cregions.push(CacaoBufferImageCopy_C { buffer_offset: r.buffer_offset, buffer_row_length: r.buffer_row_length, buffer_image_height: r.buffer_image_height, aspect_mask: r.aspect_mask, mip_level: r.mip_level, base_array_layer: r.base_array_layer, layer_count: r.layer_count, image_offset_x: r.image_offset_x, image_offset_y: r.image_offset_y, image_offset_z: r.image_offset_z, image_extent_width: r.image_extent_width, image_extent_height: r.image_extent_height, image_extent_depth: r.image_extent_depth });
            i = i + 1;
        }
        let rc = cacao_cmd_copy_buffer_to_image(self.handle, src.handle, dst.handle, dst_image_layout, cregions.data, cregions.len as u32);
        cregions.destroy();
        return cacao_check(rc);
    }

