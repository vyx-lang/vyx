    public clear_g: f32;
    public clear_b: f32;
    public clear_a: f32;
    public clear_depth: f32;
    public clear_stencil: u32;

    public static fn color(texture: Texture, r: f32, g: f32, b: f32, a: f32) -> RenderingAttachmentInfo {
        return RenderingAttachmentInfo { texture: texture, load_op: load_op_clear(), store_op: store_op_store(), clear_r: r, clear_g: g, clear_b: b, clear_a: a, clear_depth: 1.0, clear_stencil: 0 };
    }

    public static fn depth(texture: Texture, depth: f32) -> RenderingAttachmentInfo {
        return RenderingAttachmentInfo { texture: texture, load_op: load_op_clear(), store_op: store_op_store(), clear_r: 0.0, clear_g: 0.0, clear_b: 0.0, clear_a: 0.0, clear_depth: depth, clear_stencil: 0 };
    }

    public static fn stencil(texture: Texture, stencil: u32) -> RenderingAttachmentInfo {
        return RenderingAttachmentInfo { texture: texture, load_op: load_op_clear(), store_op: store_op_store(), clear_r: 0.0, clear_g: 0.0, clear_b: 0.0, clear_a: 0.0, clear_depth: 1.0, clear_stencil: stencil };
    }

    public fn setLoadOp(load_op: u32) -> RenderingAttachmentInfo { self.load_op = load_op; return self; }
    public fn setStoreOp(store_op: u32) -> RenderingAttachmentInfo { self.store_op = store_op; return self; }
}

