    public fn createSwapchain(surface: Surface, desc: SwapchainDesc) -> Result<Swapchain, CacaoError> {
        var transform = CacaoSurfaceTransform_C { rotation: desc.pre_transform_rotation, flip_horizontal: desc.pre_transform_flip_horizontal, flip_vertical: desc.pre_transform_flip_vertical };
        var cdesc = CacaoSwapchainCreateInfo_C {
            extent: CacaoExtent2D_C { width: desc.extent.width, height: desc.extent.height },
            format: desc.format,
            color_space: desc.color_space,
            present_mode: desc.present_mode,
            min_image_count: desc.min_image_count,
            pre_transform: transform,
            composite_alpha: desc.composite_alpha,
            usage: desc.usage,
            clipped: desc.clipped,
            compatible_surface: surface.handle,
            image_array_layers: desc.image_array_layers
        };
        var out: rawptr = null;
        let rc = cacao_device_create_swapchain(self.handle, to_rawptr(&cdesc), to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(Swapchain { handle: out, owns: true });
    }

    public fn destroy() {
        if (self.handle != null && self.owns) {
            cacao_device_release(self.handle);
        }
        self.handle = null;
        self.owns = false;
    }

    public fn drop() { return; }
}

public class DeviceQueue {
