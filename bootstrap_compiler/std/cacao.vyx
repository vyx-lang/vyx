    public has_stencil_attachment: bool;
    public layer_count: u32;

    public static fn create(render_area: Rect2D) -> RenderingInfo {
        let empty_tex = Texture { handle: null, owns: false };
        let empty = RenderingAttachmentInfo.color(empty_tex, 0.0, 0.0, 0.0, 0.0);
        return RenderingInfo { render_area: render_area, color_attachments: Vec::<RenderingAttachmentInfo>.new(), depth_attachment: empty, has_depth_attachment: false, stencil_attachment: empty, has_stencil_attachment: false, layer_count: 1 };
    }

    public fn addColorAttachment(attachment: RenderingAttachmentInfo) -> RenderingInfo {
        self.color_attachments.push(attachment);
        return self;
    }

    public fn setDepthAttachment(attachment: RenderingAttachmentInfo) -> RenderingInfo { self.depth_attachment = attachment; self.has_depth_attachment = true; return self; }
    public fn setStencilAttachment(attachment: RenderingAttachmentInfo) -> RenderingInfo { self.stencil_attachment = attachment; self.has_stencil_attachment = true; return self; }
    public fn setLayerCount(layer_count: u32) -> RenderingInfo { self.layer_count = layer_count; return self; }
}

