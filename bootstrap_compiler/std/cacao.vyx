    public fn createAccelerationStructure(desc: AccelerationStructureDesc) -> Result<AccelerationStructure, CacaoError> {
        var geometries = Vec::<CacaoAccelerationStructureGeometryDesc_C>.with_capacity(desc.geometries.len);
        var i: i64 = 0;
        while (i < desc.geometries.len) {
            let g = desc.geometries.get(i);
            geometries.push(CacaoAccelerationStructureGeometryDesc_C { vertex_buffer: g.vertex_buffer.handle, vertex_offset: g.vertex_offset, vertex_stride: g.vertex_stride, vertex_count: g.vertex_count, vertex_format: g.vertex_format, index_buffer: g.index_buffer.handle, index_offset: g.index_offset, index_count: g.index_count, index_format: g.index_format, transform_buffer: g.transform_buffer.handle, transform_offset: g.transform_offset, opaque: g.opaque });
            i = i + 1;
        }
        var instances = Vec::<CacaoAccelerationStructureInstance_C>.with_capacity(desc.instances.len);
        i = 0;
        while (i < desc.instances.len) {
            let inst = desc.instances.get(i);
            instances.push(CacaoAccelerationStructureInstance_C { transform00: inst.transform00, transform01: inst.transform01, transform02: inst.transform02, transform03: inst.transform03, transform04: inst.transform04, transform05: inst.transform05, transform06: inst.transform06, transform07: inst.transform07, transform08: inst.transform08, transform09: inst.transform09, transform10: inst.transform10, transform11: inst.transform11, instance_id: inst.instance_id, mask: inst.mask, shader_binding_table_offset: inst.shader_binding_table_offset, flags: inst.flags, acceleration_structure_address: inst.acceleration_structure_address });
            i = i + 1;
        }
        var cdesc = CacaoAccelerationStructureCreateInfo_C { kind: desc.kind, geometries: geometries.data, geometry_count: geometries.len as u32, instances: instances.data, instance_count: instances.len as u32, allow_update: desc.allow_update, prefer_fast_trace: desc.prefer_fast_trace };
        var out: rawptr = null;
        let rc = cacao_device_create_acceleration_structure(self.handle, to_rawptr(&cdesc), to_rawptr(&out));
        geometries.destroy();
        instances.destroy();
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(AccelerationStructure { handle: out, owns: true });
    }

