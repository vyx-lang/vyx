public class Buffer {
    private handle: rawptr;
    private owns: bool;

    public static fn empty() -> Buffer { return Buffer { handle: null, owns: false }; }

    public fn clone() -> Buffer { return Buffer { handle: self.handle, owns: false }; }
    public fn nativeHandle() -> rawptr { return self.handle; }

    fn writeBytes(data: rawptr, size: u64, offset: u64) -> Result<i32, CacaoError> {
        return cacao_check(cacao_buffer_write(self.handle, data, size, offset));
    }

    public fn writeRaw(data: rawptr, size: u64, offset: u64) -> Result<i32, CacaoError> {
        return self.writeBytes(data, size, offset);
    }

    public fn write<T>(value: T, offset: u64) -> Result<i32, CacaoError> {
        let n = sizeof::<T>() as u64;
        return self.writeBytes(to_rawptr(&value), n, offset);
    }

    public fn flush(offset: u64, size: u64) -> Result<i32, CacaoError> {
        return cacao_check(cacao_buffer_flush(self.handle, offset, size));
    }

    public fn read<T>(offset: u64) -> Result<T, CacaoError> {
        var data: rawptr = null;
        var rc = cacao_buffer_map(self.handle, to_rawptr(&data));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        var out: T;
        memcpy(to_rawptr(&out), data + (offset as i32), sizeof::<T>() as i64);
        rc = cacao_buffer_unmap(self.handle);
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(out);
    }

    public fn writeMapped<T>(value: T, offset: u64) -> Result<i32, CacaoError> {
        var data: rawptr = null;
        var rc = cacao_buffer_map(self.handle, to_rawptr(&data));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        memcpy(data + (offset as i32), to_rawptr(&value), sizeof::<T>() as i64);
        rc = cacao_buffer_unmap(self.handle);
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return self.flush(offset, sizeof::<T>() as u64);
    }

    public fn size() -> Result<u64, CacaoError> {
        var out: u64 = 0;
        let rc = cacao_buffer_get_size(self.handle, to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(out);
    }

    public fn usage() -> Result<u32, CacaoError> {
        var out: u32 = 0;
        let rc = cacao_buffer_get_usage(self.handle, to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(out);
    }

    public fn memoryUsage() -> Result<u32, CacaoError> {
        var out: u32 = 0;
        let rc = cacao_buffer_get_memory_usage(self.handle, to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(out);
    }

    public fn deviceAddress() -> Result<u64, CacaoError> {
        var out: u64 = 0;
        let rc = cacao_buffer_get_device_address(self.handle, to_rawptr(&out));
        if (rc != 0) { return Err(CacaoError.fromCode(rc)); }
        return Ok(out);
    }

    public fn destroy() {
        if (self.handle != null && self.owns) {
            cacao_buffer_release(self.handle);
        }
        self.handle = null;
        self.owns = false;
    }

    public fn drop() { return; }
}

