    public fn memoryBarrierFast(transition: u32) -> Result<i32, CacaoError> {
        return cacao_check(cacao_cmd_memory_barrier_fast(self.handle, transition));
    }

    public fn pipelineBarrier(src_scope: u32, dst_scope: u32, memory_barriers: Vec<MemoryBarrier>, buffer_barriers: Vec<BufferBarrier>, texture_barriers: Vec<TextureBarrier>) -> Result<i32, CacaoError> {
        var cmemory = Vec::<CacaoMemoryBarrier_C>.with_capacity(memory_barriers.len);
        var cbuffers = Vec::<CacaoBufferBarrier_C>.with_capacity(buffer_barriers.len);
        var ctextures = Vec::<CacaoTextureBarrier_C>.with_capacity(texture_barriers.len);
        var i: i64 = 0;
        while (i < memory_barriers.len) {
            let b = memory_barriers.get(i);
            cmemory.push(CacaoMemoryBarrier_C { old_state: b.old_state, new_state: b.new_state });
            i = i + 1;
        }
        i = 0;
        while (i < buffer_barriers.len) {
            let b = buffer_barriers.get(i);
            cbuffers.push(CacaoBufferBarrier_C { buffer: b.buffer.handle, old_state: b.old_state, new_state: b.new_state, offset: b.offset, size: b.size, src_queue_family: b.src_queue_family, dst_queue_family: b.dst_queue_family });
            i = i + 1;
        }
        i = 0;
        while (i < texture_barriers.len) {
            let b = texture_barriers.get(i);
            ctextures.push(CacaoTextureBarrier_C { texture: b.texture.handle, old_state: b.old_state, new_state: b.new_state, base_mip_level: b.base_mip_level, level_count: b.level_count, base_array_layer: b.base_array_layer, layer_count: b.layer_count, aspect_mask: b.aspect_mask, src_queue_family: b.src_queue_family, dst_queue_family: b.dst_queue_family });
            i = i + 1;
        }
        let rc = cacao_cmd_pipeline_barrier(self.handle, src_scope, dst_scope, cmemory.data, cmemory.len as u32, cbuffers.data, cbuffers.len as u32, ctextures.data, ctextures.len as u32);
        cmemory.destroy();
        cbuffers.destroy();
        ctextures.destroy();
        return cacao_check(rc);
    }

    public fn pipelineBarrierTextures(src_scope: u32, dst_scope: u32, barriers: Vec<TextureBarrier>) -> Result<i32, CacaoError> {
        var cbarriers = Vec::<CacaoTextureBarrier_C>.with_capacity(barriers.len);
        var i: i64 = 0;
        while (i < barriers.len) {
            let b = barriers.get(i);
            cbarriers.push(CacaoTextureBarrier_C { texture: b.texture.handle, old_state: b.old_state, new_state: b.new_state, base_mip_level: b.base_mip_level, level_count: b.level_count, base_array_layer: b.base_array_layer, layer_count: b.layer_count, aspect_mask: b.aspect_mask, src_queue_family: b.src_queue_family, dst_queue_family: b.dst_queue_family });
            i = i + 1;
        }
        let rc = cacao_cmd_pipeline_barrier_textures(self.handle, src_scope, dst_scope, cbarriers.data, cbarriers.len as u32);
        cbarriers.destroy();
        return cacao_check(rc);
    }

    public fn copyTexture2D(src: Texture, dst: Texture) -> Result<i32, CacaoError> {
        return cacao_check(cacao_cmd_copy_texture_2d(self.handle, src.handle, dst.handle));
    }

