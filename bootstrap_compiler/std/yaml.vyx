module std.yaml;

/// Vyx YAML Parser
/// Simple YAML parsing utilities for configuration files.
///
/// Supports:
///   key: value          -> key-value pairs
///   key: "quoted"       -> quoted string values
///   # comment           -> line comments
///   - item              -> list items
///   nested:             -> nested sections (by indentation)
///     key: value
///
/// Usage:
///   import std::io::{readFileAll}
///   import std::yaml::{yaml_key, yaml_value, yaml_indent}
///   let content = readFileAll("config.yaml");
///   let lines = content.split("\n");
///   foreach (line in lines) {
///       let k = yaml_key(line);
///       let v = yaml_value(line);
///       if (k.len > 0) { print("${k} = ${v}"); }
///   }

/// Get the indentation level (number of leading spaces)
public fn yaml_indent(line: string) -> i32 {
    var count: i32 = 0;
    foreach (c in line) {
        if (c == ' ') { count = count + 1; }
        else { return count; }
    }
    return count;
}

/// Check if a line is a YAML comment
public fn yaml_is_comment(line: string) -> bool {
    let trimmed = line.trim();
    return trimmed.startsWith("#") || trimmed.len == 0;
}

/// Check if a line is a list item (starts with "- ")
public fn yaml_is_list_item(line: string) -> bool {
    let trimmed = line.trim();
    return trimmed.startsWith("- ");
}

/// Get list item value (strips "- " prefix)
public fn yaml_list_value(line: string) -> string {
    let trimmed = line.trim();
    if (trimmed.startsWith("- ")) {
        return trimmed.substring(2, trimmed.len).trim();
    }
    return trimmed;
}

/// Extract key from "key: value" line
public fn yaml_key(line: string) -> string {
    if (yaml_is_comment(line)) { return ""; }
    if (yaml_is_list_item(line)) { return ""; }
    let colonPos = line.indexOf(":");
    if (colonPos > 0) {
        return line.substring(0, colonPos).trim();
    }
    return "";
}

/// Extract value from "key: value" line
public fn yaml_value(line: string) -> string {
    if (yaml_is_comment(line)) { return ""; }
    let colonPos = line.indexOf(":");
    if (colonPos > 0) {
        let rest = line.substring(colonPos + 1, line.len).trim();
        return yaml_unquote(rest);
    }
    return "";
}

/// Check if a line defines a section (key with no value, ends with colon)
public fn yaml_is_section(line: string) -> bool {
    let trimmed = line.trim();
    if (trimmed.endsWith(":") && !yaml_is_comment(trimmed)) {
        let colonPos = trimmed.indexOf(":");
        if (colonPos == trimmed.len - 1) {
            return true;
        }
    }
    return false;
}

/// Get section name from a section line
public fn yaml_section_name(line: string) -> string {
    let trimmed = line.trim();
    if (trimmed.endsWith(":")) {
        return trimmed.substring(0, trimmed.len - 1).trim();
    }
    return "";
}

/// Remove surrounding quotes from a value
public fn yaml_unquote(value: string) -> string {
    if (value.len >= 2) {
        if (value.startsWith("\"") && value.endsWith("\"")) {
            return value.substring(1, value.len - 1);
        }
        if (value.startsWith("'") && value.endsWith("'")) {
            return value.substring(1, value.len - 1);
        }
    }
    return value;
}

/// Check if a YAML value represents a boolean true
public fn yaml_is_true(value: string) -> bool {
    let lower = value.toLower();
    return lower == "true" || lower == "yes" || lower == "on";
}

/// Check if a YAML value represents a boolean false
public fn yaml_is_false(value: string) -> bool {
    let lower = value.toLower();
    return lower == "false" || lower == "no" || lower == "off";
}

/// Check if a YAML value represents null
public fn yaml_is_null(value: string) -> bool {
    let lower = value.toLower();
    return lower == "null" || lower == "~" || lower == "";
}
