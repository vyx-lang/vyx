module std.csv;

use std.collections;

/// CSV — CSV Parsing & Generation for Vyx
/// Usage: import std::csv;
///
/// Example:
///   let rows = csv_parse("name,age\nAlice,30\nBob,25");
///   for (row in rows) {
///       print(csv_row_get(row, 0));  // name
///   }
///
///   let line = csv_row("Alice", "30", "NYC");
///   print(line);  // "Alice,30,NYC"

public fn csv_escape(field: string) -> string {
    if (field.contains(",") || field.contains("\"") || field.contains("\n")) {
        return "\"" + field.replace("\"", "\"\"") + "\"";
    }
    return field;
}

public fn csv_row2(a: string, b: string) -> string {
    return csv_escape(a) + "," + csv_escape(b);
}

public fn csv_row3(a: string, b: string, c: string) -> string {
    return csv_escape(a) + "," + csv_escape(b) + "," + csv_escape(c);
}

public fn csv_row4(a: string, b: string, c: string, d: string) -> string {
    return csv_escape(a) + "," + csv_escape(b) + "," + csv_escape(c) + "," + csv_escape(d);
}

public fn csv_split_line(line: string) -> Vec<string> {
    var fields = Vec::<string>.new();
    var current = "";
    var in_quote = false;
    var i = 0;

    while (i < line.len) {
        let ch = line.charAt(i);

        if (in_quote) {
            if (ch == 34) {
                if (i + 1 < line.len && line.charAt(i + 1) == 34) {
                    current = current + "\"";
                    i = i + 2;
                    continue;
                } else {
                    in_quote = false;
                    i = i + 1;
                    continue;
                }
            } else {
                current = current + format("%c", ch);
            }
        } else {
            if (ch == 34) {
                in_quote = true;
            } elif (ch == 44) {
                fields.push(current);
                current = "";
            } else {
                current = current + format("%c", ch);
            }
        }
        i = i + 1;
    }

    fields.push(current);
    return fields;
}

public fn csv_parse(text: string) -> Vec<Vec<string>> {
    var rows = Vec::<Vec<string>>.new();
    let lines = text.split("\n");
    var i = 0;
    while (i < lines.len) {
        let line = lines.get(i);
        if (line.len > 0) {
            rows.push(csv_split_line(line));
        }
        i = i + 1;
    }
    return rows;
}
