module std.vio;

use std.ffi;

/// std/vio.vyx - Vyx Async I/O Runtime (Cross-Platform)
///
/// Quick start:
///   import std::vio;
///
///   async fn myTask() {
///       yield WaitForSeconds(1.0);
///       print("done\n");
///   }
///
///   fn main() {
///       spawn(myTask);           // run on thread
///       sleep(2000);             // wait
///       print(now());            // current time (ms)
///   }
///
/// Coroutine keywords:
///   yield;                       // yield one tick
///   yield WaitForSeconds(1.0);   // wait N seconds
///   yield WaitForMs(100);        // wait N milliseconds
///   await someAsyncFn();         // chain async calls

// ============================================================
//  Platform-independent extern declarations (POSIX sockets)
// ============================================================
extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn realloc(ptr: rawptr, size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memset(dest: rawptr, c: i32, n: i64) -> rawptr;
    fn memcpy(dest: rawptr, src: rawptr, n: i64) -> rawptr;
    fn strlen(s: rawptr) -> i64;
    fn vyx_fiber_invoke(work: i64, arg: rawptr) -> i32;
    fn vyx_fiber_set_current(slot: rawptr);
    fn vyx_fiber_get_current() -> rawptr;
}

// ============================================================
//  Windows platform declarations
// ============================================================
@[platform("windows")] {
    extern "C" {
        fn CreateIoCompletionPort(fh: rawptr, ep: rawptr, ck: i64, nt: i32) -> rawptr;
        fn PostQueuedCompletionStatus(cp: rawptr, bt: i32, ky: i64, ov: rawptr) -> i32;
        fn GetQueuedCompletionStatus(cp: rawptr, bt: rawptr, ky: rawptr, ov: rawptr, ms: i32) -> i32;
        fn CloseHandle(h: rawptr) -> i32;
        fn CreateThread(attrs: rawptr, stack: u64, start: rawptr, param: rawptr, flags: u32, tid: rawptr) -> rawptr;
        fn CreateFileA(name: rawptr, access: i32, share: i32, sec: rawptr, disp: i32, flags: i32, tmpl: rawptr) -> rawptr;
        fn ReadFile(fh: rawptr, buf: rawptr, sz: i32, rd: rawptr, ov: rawptr) -> i32;
        fn WriteFile(fh: rawptr, buf: rawptr, sz: i32, wr: rawptr, ov: rawptr) -> i32;
        fn _beginthread(fn_ptr: rawptr, stk: i32, arg: rawptr) -> rawptr;
        fn WaitForSingleObject(h: rawptr, ms: i32) -> i32;
        fn Sleep(ms: i32);
        fn GetTickCount64() -> i64;
        fn GetLastError() -> i32;
        fn InitializeCriticalSection(cs: rawptr);
        fn EnterCriticalSection(cs: rawptr);
        fn LeaveCriticalSection(cs: rawptr);
        fn DeleteCriticalSection(cs: rawptr);
        fn InitializeConditionVariable(cv: rawptr);
        fn SleepConditionVariableCS(cv: rawptr, cs: rawptr, ms: u32) -> i32;
        fn WakeConditionVariable(cv: rawptr);
        fn WakeAllConditionVariable(cv: rawptr);
        fn WSAStartup(ver: i16, data: rawptr) -> i32;
        fn WSACleanup() -> i32;
        fn socket(af: i32, st: i32, proto: i32) -> i64;
        fn closesocket(s: i64) -> i32;
        fn send(s: i64, buf: rawptr, len: i32, fl: i32) -> i32;
        fn recv(s: i64, buf: rawptr, len: i32, fl: i32) -> i32;
        fn bind(s: i64, addr: rawptr, len: i32) -> i32;
        fn listen(s: i64, bl: i32) -> i32;
        fn accept(s: i64, addr: rawptr, alen: rawptr) -> i64;
        fn htons(hostshort: i16) -> i16;
        fn inet_addr(cp: rawptr) -> i32;
        fn connect(s: i64, addr: rawptr, len: i32) -> i32;

        // Windows Fiber API
        fn ConvertThreadToFiber(param: rawptr) -> rawptr;
        fn CreateFiber(stack_size: i64, start: rawptr, param: rawptr) -> rawptr;
        fn SwitchToFiber(fiber: rawptr);
        fn DeleteFiber(fiber: rawptr);
        fn GetCurrentFiber() -> rawptr;
        fn vyx_fiber_win_proc() -> rawptr;
        fn vyx_fiber_win_host() -> rawptr;
    }
}

// ============================================================
//  POSIX platform declarations (Linux / Android / macOS)
// ============================================================
@[platform("posix")] {
    extern "C" {
        fn usleep(usec: i32) -> i32;
        fn clock_gettime(clk_id: i32, tp: rawptr) -> i32;
        fn pthread_create(thread: rawptr, attr: rawptr, start: rawptr, arg: rawptr) -> i32;
        fn pthread_join(thread: i64, retval: rawptr) -> i32;
        fn pthread_detach(thread: i64) -> i32;
        fn pthread_mutex_init(mutex: rawptr, attr: rawptr) -> i32;
        fn pthread_mutex_lock(mutex: rawptr) -> i32;
        fn pthread_mutex_unlock(mutex: rawptr) -> i32;
        fn pthread_mutex_destroy(mutex: rawptr) -> i32;
        fn pthread_cond_init(cond: rawptr, attr: rawptr) -> i32;
        fn pthread_cond_wait(cond: rawptr, mutex: rawptr) -> i32;
        fn pthread_cond_signal(cond: rawptr) -> i32;
        fn pthread_cond_broadcast(cond: rawptr) -> i32;
        fn pthread_cond_destroy(cond: rawptr) -> i32;
        fn socket(af: i32, st: i32, proto: i32) -> i64;
        fn close(fd: i32) -> i32;
        fn send(s: i64, buf: rawptr, len: i64, fl: i32) -> i64;
        fn recv(s: i64, buf: rawptr, len: i64, fl: i32) -> i64;
        fn bind(s: i64, addr: rawptr, len: i32) -> i32;
        fn listen(s: i64, bl: i32) -> i32;
        fn accept(s: i64, addr: rawptr, alen: rawptr) -> i64;
        fn htons(hostshort: i16) -> i16;
        fn connect(s: i64, addr: rawptr, len: i32) -> i32;
        fn mmap(addr: rawptr, length: i64, prot: i32, flags: i32, fd: i32, offset: i64) -> rawptr;
        fn munmap(addr: rawptr, length: i64) -> i32;

        // ucontext (POSIX fibers; Bionic has the type but not these calls)
        fn getcontext(ucp: rawptr) -> i32;
        fn makecontext(ucp: rawptr, func: rawptr, argc: i32, arg: rawptr);
        fn swapcontext(oucp: rawptr, ucp: rawptr) -> i32;
        fn vyx_bootstrap_ucontext_size() -> i64;
        fn vyx_bootstrap_ucontext_stack_sp_offset() -> i64;
        fn vyx_bootstrap_ucontext_stack_size_offset() -> i64;
        fn vyx_bootstrap_ucontext_link_offset() -> i64;
        fn vyx_bootstrap_fiber_current_set(fiber: rawptr);
        fn vyx_bootstrap_fiber_current_get() -> rawptr;
        fn vyx_bootstrap_scheduler_ctx_set(ctx: rawptr);
        fn vyx_bootstrap_scheduler_ctx_get() -> rawptr;
        fn vyx_bootstrap_fiber_start() -> rawptr;
        fn vyx_bootstrap_fiber_stop(main_fiber: rawptr);
        fn vyx_bootstrap_fiber_create(main_fiber: rawptr, work: rawptr, arg: rawptr) -> rawptr;
        fn vyx_bootstrap_fiber_switch(fiber: rawptr);
        fn vyx_bootstrap_fiber_yield();
        fn vyx_bootstrap_fiber_delete(fiber: rawptr);
        fn vyx_bootstrap_fiber_finished(fiber: rawptr) -> i32;
        fn vyx_fiber_posix_host() -> rawptr;
        fn vyx_fiber_posix_create(work: i64, arg: rawptr, slot: rawptr) -> rawptr;
        fn vyx_fiber_posix_enter(host: rawptr, fiber: rawptr);
        fn vyx_fiber_posix_yield(fiber: rawptr, host: rawptr);
        fn vyx_fiber_posix_destroy(fiber: rawptr);
    }
}

// ============================================================
//  Linux-only: io_uring
// ============================================================
@[platform("linux")] {
    extern "C" {
        fn syscall(number: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64) -> i64;
        fn close(fd: i32) -> i32;
    }

    /// io_uring_setup: create an io_uring instance (syscall 425)
    /// entries: number of SQ entries (power of 2)
    /// params: pointer to io_uring_params struct (120 bytes, zero-init)
    /// Returns: ring file descriptor or negative error
    public fn io_uring_setup(entries: i32, params: rawptr) -> i32 {
        let result = syscall(425, entries as i64, params as i64, 0, 0, 0, 0);
        return result as i32;
    }

    /// io_uring_enter: submit and/or wait for completions (syscall 426)
    /// fd: ring fd from setup
    /// to_submit: number of SQEs to submit
    /// min_complete: minimum completions to wait for (0 = don't wait)
    /// flags: IORING_ENTER_GETEVENTS (1) to wait
    /// Returns: number of SQEs submitted or negative error
    public fn io_uring_enter(fd: i32, to_submit: i32, min_complete: i32, flags: i32) -> i32 {
        let result = syscall(426, fd as i64, to_submit as i64, min_complete as i64, flags as i64, 0, 0);
        return result as i32;
    }

    /// io_uring_register: register buffers/files with the ring (syscall 427)
    public fn io_uring_register(fd: i32, opcode: i32, arg: rawptr, nr_args: i32) -> i32 {
        let result = syscall(427, fd as i64, opcode as i64, arg as i64, nr_args as i64, 0, 0);
        return result as i32;
    }

    /// Create an io_uring instance with default settings
    /// Returns: ring fd (>= 0) or error (< 0)
    public fn vio_uring_create(queue_depth: i32) -> i32 {
        // io_uring_params: 120 bytes, zero-initialized
        let params = malloc(120);
        memset(params, 0, 120);
        let ring_fd = io_uring_setup(queue_depth, params);
        free(params);
        return ring_fd;
    }

    /// Submit pending SQEs and optionally wait for completions
    public fn vio_uring_submit(ring_fd: i32, to_submit: i32, wait_nr: i32) -> i32 {
        var flags: i32 = 0;
        if (wait_nr > 0) {
            flags = 1;  // IORING_ENTER_GETEVENTS
        }
        return io_uring_enter(ring_fd, to_submit, wait_nr, flags);
    }

    /// Close an io_uring instance
    public fn vio_uring_destroy(ring_fd: i32) {
        close(ring_fd);
    }
}

// ============================================================
//  macOS-only: kqueue
// ============================================================
@[platform("macos")] {
    extern "C" {
        fn kqueue() -> i32;
        fn kevent(kq: i32, changelist: rawptr, nchanges: i32, eventlist: rawptr, nevents: i32, timeout: rawptr) -> i32;
    }
}

// ============================================================
//  Core API — cross-platform wrappers
// ============================================================

var g_vio_started: i32 = 0;

/// Initialize the async runtime. Returns 0 on success.
@[platform("windows")]
public fn vio_start() -> i32 {
    if (g_vio_started != 0) { return 0; }
    let wsadata = malloc(512);
    memset(wsadata, 0, 512);
    let rc = WSAStartup(514, wsadata);
    free(wsadata);
    if (rc == 0) { g_vio_started = 1; }
    return rc;
}

@[platform("posix")]
public fn vio_start() -> i32 {
    g_vio_started = 1;
    return 0;
}

/// Shutdown the runtime
@[platform("windows")]
public fn vio_stop() {
    if (g_vio_started != 0) {
        WSACleanup();
        g_vio_started = 0;
    }
}

@[platform("posix")]
public fn vio_stop() {
    g_vio_started = 0;
}

/// True after a successful start and before stop.
public fn vio_is_started() -> bool {
    return g_vio_started != 0;
}

/// Run a function asynchronously (on a new OS thread)
@[platform("windows")]
public fn vio_run(work: i64) -> i32 {
    return vio_run_ctx(work, null);
}

@[platform("windows")]
public fn vio_run_ctx(work: i64, ctx: rawptr) -> i32 {
    let h = CreateThread(null, 0, work as rawptr, ctx, 0, null);
    if (h == null) { return 1; }
    CloseHandle(h);
    return 0;
}

@[platform("posix")]
public fn vio_run(work: i64) -> i32 {
    return vio_run_ctx(work, null);
}

@[platform("posix")]
public fn vio_run_ctx(work: i64, ctx: rawptr) -> i32 {
    let tid = malloc(8);
    let rc = pthread_create(tid, null, work as rawptr, ctx);
    if (rc != 0) {
        free(tid);
        return rc;
    }
    let thread_id = ptr_read_i64(tid);
    pthread_detach(thread_id);
    free(tid);
    return 0;
}

/// Run and wait for completion
@[platform("windows")]
public fn vio_run_wait(work: i64, timeout_ms: i32) -> i32 {
    return vio_run_wait_ctx(work, null, timeout_ms);
}

@[platform("windows")]
public fn vio_run_wait_ctx(work: i64, ctx: rawptr, timeout_ms: i32) -> i32 {
    let h = CreateThread(null, 0, work as rawptr, ctx, 0, null);
    if (h == null) { return 1; }
    let rc = WaitForSingleObject(h, timeout_ms);
    CloseHandle(h);
    return rc;
}

@[platform("posix")]
public fn vio_run_wait(work: i64, timeout_ms: i32) -> i32 {
    return vio_run_wait_ctx(work, null, timeout_ms);
}

@[platform("posix")]
public fn vio_run_wait_ctx(work: i64, ctx: rawptr, timeout_ms: i32) -> i32 {
    let tid = malloc(8);
    let rc = pthread_create(tid, null, work as rawptr, ctx);
    if (rc != 0) {
        free(tid);
        return rc;
    }
    let thread_id = ptr_read_i64(tid);
    let join_rc = pthread_join(thread_id, null);
    free(tid);
    return join_rc;
}

/// Sleep current thread
@[platform("windows")]
public fn vio_sleep(ms: i32) {
    Sleep(ms);
}

@[platform("posix")]
public fn vio_sleep(ms: i32) {
    usleep(ms * 1000);
}

/// Stackless Future executor. Ready-queue lives in Vyx; workers run on the
/// pump stack via `vyx_fiber_invoke`. OS fibers stay only for StartCoroutine.
let VIO_SCHED_HANDLE: i32 = 0;
let VIO_SCHED_WORK: i32 = 8;
let VIO_SCHED_ARG: i32 = 16;
let VIO_SCHED_DONE: i32 = 24;
let VIO_SCHED_ENQ: i32 = 32;
let VIO_SCHED_NEXT: i32 = 40;
let VIO_SCHED_HOST: i32 = 48;
let VIO_SCHED_SLOT: i32 = 56;
let VIO_SCHED_STACK: i64 = 1048576;

let VIO_TIMER_DEADLINE: i32 = 0;
let VIO_TIMER_STATE: i32 = 8;
let VIO_TIMER_NEXT: i32 = 16;
let VIO_TIMER_SLOT: i64 = 24;

var vio_sched_head: rawptr = null;
var vio_sched_tail: rawptr = null;
var vio_sched_host: rawptr = null;
var vio_sched_pumping: i32 = 0;
var vio_timer_head: rawptr = null;
var vio_async_frame: rawptr = null;
var vio_async_pending: i32 = 0;
var vio_sched_pending_count: i32 = 0;

public fn vio_async_frame_set(p: rawptr) {
    vio_async_frame = p;
}

public fn vio_async_frame_get() -> rawptr {
    return vio_async_frame;
}

public fn vio_async_pending_set() {
    vio_async_pending = 1;
}

public fn vio_async_take_pending() -> i32 {
    let p = vio_async_pending;
    vio_async_pending = 0;
    return p;
}

public fn vio_sched_pending_returns() -> i32 {
    return vio_sched_pending_count;
}

fn vio_sched_queue_len() -> i32 {
    var n: i32 = 0;
    var cur = vio_sched_head;
    while (cur != null) {
        n = n + 1;
        cur = ptr_read_i64(ptr_offset(cur, VIO_SCHED_NEXT)) as rawptr;
    }
    return n;
}

fn vio_sched_enqueue(slot: rawptr) {
    if (slot == null) { return; }
    if (ptr_read_i64(ptr_offset(slot, VIO_SCHED_ENQ)) != 0) { return; }
    if (ptr_read_i64(ptr_offset(slot, VIO_SCHED_DONE)) != 0) { return; }
    ptr_write_i64(ptr_offset(slot, VIO_SCHED_NEXT), 0);
    ptr_write_i64(ptr_offset(slot, VIO_SCHED_ENQ), 1);
    if (vio_sched_tail == null) {
        vio_sched_head = slot;
        vio_sched_tail = slot;
        return;
    }
    ptr_write_i64(ptr_offset(vio_sched_tail, VIO_SCHED_NEXT), slot as i64);
    vio_sched_tail = slot;
}

fn vio_sched_dequeue() -> rawptr {
    let slot = vio_sched_head;
    if (slot == null) { return null; }
    let next = ptr_read_i64(ptr_offset(slot, VIO_SCHED_NEXT)) as rawptr;
    vio_sched_head = next;
    if (next == null) { vio_sched_tail = null; }
    ptr_write_i64(ptr_offset(slot, VIO_SCHED_NEXT), 0);
    ptr_write_i64(ptr_offset(slot, VIO_SCHED_ENQ), 0);
    return slot;
}

@[platform("windows")]
fn vio_sched_destroy_slot(slot: rawptr) {
    if (slot == null) { return; }
    let handle = ptr_read_i64(ptr_offset(slot, VIO_SCHED_HANDLE)) as rawptr;
    if (handle != null) { DeleteFiber(handle); }
    free(slot);
}

@[platform("posix")]
fn vio_sched_destroy_slot(slot: rawptr) {
    if (slot == null) { return; }
    let handle = ptr_read_i64(ptr_offset(slot, VIO_SCHED_HANDLE)) as rawptr;
    if (handle != null) { vyx_fiber_posix_destroy(handle); }
    free(slot);
}

public fn vio_sched_ensure() {
}

public fn vio_sched_spawn(work: i64, ctx: rawptr) -> i32 {
    if (work == 0) { return 1; }
    let slot = malloc(VIO_SCHED_SLOT as i64);
    if (slot == null) { return 1; }
    memset(slot, 0, VIO_SCHED_SLOT as i64);
    ptr_write_i64(ptr_offset(slot, VIO_SCHED_WORK), work);
    ptr_write_i64(ptr_offset(slot, VIO_SCHED_ARG), ctx as i64);
    vio_sched_enqueue(slot);
    return 0;
}

fn vio_sched_current_handle() -> rawptr {
    let slot = vyx_fiber_get_current();
    if (slot == null) { return null; }
    return ptr_read_i64(ptr_offset(slot, VIO_SCHED_HANDLE)) as rawptr;
}

public fn vio_sched_yield() {
    vio_sched_pump();
}

public fn vio_sched_pump() {
    if (vio_sched_current_handle() != null) { return; }
    if (vio_sched_pumping != 0) { return; }
    let saved = vyx_fiber_get_current();
    vio_sched_pumping = 1;
    let n = vio_sched_queue_len();
    var i: i32 = 0;
    while (i < n) {
        let slot = vio_sched_dequeue();
        if (slot == null) {
            i = i + 1;
            continue;
        }
        if (ptr_read_i64(ptr_offset(slot, VIO_SCHED_DONE)) != 0) {
            vio_sched_destroy_slot(slot);
            i = i + 1;
            continue;
        }
        let work = ptr_read_i64(ptr_offset(slot, VIO_SCHED_WORK));
        let arg = ptr_read_i64(ptr_offset(slot, VIO_SCHED_ARG)) as rawptr;
        vyx_fiber_set_current(slot);
        let rc = vyx_fiber_invoke(work, arg);
        vyx_fiber_set_current(saved);
        if (rc == 0) {
            vio_sched_pending_count = vio_sched_pending_count + 1;
            vio_sched_enqueue(slot);
        } else {
            ptr_write_i64(ptr_offset(slot, VIO_SCHED_DONE), 1);
            vio_sched_destroy_slot(slot);
        }
        i = i + 1;
    }
    vio_timer_fire();
    vio_sched_pumping = 0;
    vyx_fiber_set_current(saved);
}

public fn vio_sched_on_fiber() -> i32 {
    if (vyx_fiber_get_current() != null) { return 1; }
    return 0;
}

/// Yield to other tasks by pumping the ready queue. `@[async]` functions
/// suspend at MIR `await` (poll + yield); this is the executor pump.
public fn vio_yield() {
    vio_sched_pump();
}

/// Get current time in milliseconds
@[platform("windows")]
public fn vio_now() -> i64 {
    return GetTickCount64();
}

@[platform("posix")]
public fn vio_now() -> i64 {
    let ts = malloc(16);
    memset(ts, 0, 16);
    clock_gettime(1, ts);
    let sec = ptr_read_i64(ts);
    let nsec = ptr_read_i64((ts as i64 + 8) as rawptr);
    free(ts);
    return sec * 1000 + nsec / 1000000;
}

public fn vio_timer_arm(state: rawptr, ms: i32) {
    if (state == null) { return; }
    vio_promise_state_retain(state);
    let slot = malloc(VIO_TIMER_SLOT);
    if (slot == null) {
        vio_promise_state_release(state);
        return;
    }
    memset(slot, 0, VIO_TIMER_SLOT);
    var delay = ms as i64;
    if (delay < 0) { delay = 0; }
    let deadline = vio_now() + delay;
    ptr_write_i64(ptr_offset(slot, VIO_TIMER_DEADLINE), deadline);
    ptr_write_i64(ptr_offset(slot, VIO_TIMER_STATE), state as i64);
    ptr_write_i64(ptr_offset(slot, VIO_TIMER_NEXT), 0);
    if (vio_timer_head == null) {
        vio_timer_head = slot;
        return;
    }
    var prev: rawptr = null;
    var cur = vio_timer_head;
    while (cur != null) {
        let due = ptr_read_i64(ptr_offset(cur, VIO_TIMER_DEADLINE));
        if (deadline <= due) { break; }
        prev = cur;
        cur = ptr_read_i64(ptr_offset(cur, VIO_TIMER_NEXT)) as rawptr;
    }
    ptr_write_i64(ptr_offset(slot, VIO_TIMER_NEXT), cur as i64);
    if (prev == null) {
        vio_timer_head = slot;
        return;
    }
    ptr_write_i64(ptr_offset(prev, VIO_TIMER_NEXT), slot as i64);
}

public fn vio_timer_fire() {
    let now = vio_now();
    while (vio_timer_head != null) {
        let due = ptr_read_i64(ptr_offset(vio_timer_head, VIO_TIMER_DEADLINE));
        if (due > now) { break; }
        let slot = vio_timer_head;
        let state = ptr_read_i64(ptr_offset(slot, VIO_TIMER_STATE)) as rawptr;
        vio_timer_head = ptr_read_i64(ptr_offset(slot, VIO_TIMER_NEXT)) as rawptr;
        if (state != null) {
            vio_promise_state_resolve::<i32>(state, 0);
            vio_promise_state_release(state);
        }
        free(slot);
    }
}

public fn vio_timer_next_wait_ms() -> i64 {
    if (vio_timer_head == null) { return -1; }
    let wait = ptr_read_i64(ptr_offset(vio_timer_head, VIO_TIMER_DEADLINE)) - vio_now();
    if (wait < 0) { return 0; }
    return wait;
}

fn vio_future_drive() {
    vio_sched_pump();
    vio_timer_fire();
}

fn vio_future_await_done(state: rawptr) {
    while (vio_promise_state_done(state) == 0) {
        vio_future_drive();
        if (vio_promise_state_done(state) != 0) { break; }
        let wait = vio_timer_next_wait_ms();
        if (wait > 0) {
            var ms = wait;
            if (ms > 2147483647) { ms = 2147483647; }
            vio_sleep(ms as i32);
            continue;
        }
        if (wait == 0 || vio_sched_queue_len() > 0) { continue; }
        let lock = vio_promise_state_lock_handle(state);
        let cond = vio_promise_state_cond_handle(state);
        if (lock == null || cond == null) { break; }
        vio_lock_lock(lock);
        if (vio_promise_state_done(state) == 0) {
            vio_cond_wait(cond, lock);
        }
        vio_lock_unlock(lock);
    }
}

// ============================================================
//  Fiber Scheduler — cooperative multitasking
// ============================================================

/// Initialize fiber scheduler — platform-specific
@[platform("windows")]
public fn vio_fiber_start() -> rawptr {
    let main_fiber = ConvertThreadToFiber(null);
    return main_fiber;
}

@[platform("posix")]
public fn vio_fiber_start() -> rawptr {
    return vyx_bootstrap_fiber_start();
}

/// Create a fiber for a task
@[platform("windows")]
public fn vio_fiber_create(main_fiber: rawptr, work: i64) -> rawptr {
    return vio_fiber_create_ctx(main_fiber, work, main_fiber);
}

@[platform("windows")]
public fn vio_fiber_create_ctx(main_fiber: rawptr, work: i64, arg: rawptr) -> rawptr {
    let fiber = CreateFiber(0, work as rawptr, arg);
    return fiber;
}

@[platform("posix")]
public fn vio_fiber_create(main_fiber: rawptr, work: i64) -> rawptr {
    return vio_fiber_create_ctx(main_fiber, work, main_fiber);
}

@[platform("posix")]
public fn vio_fiber_create_ctx(main_fiber: rawptr, work: i64, arg: rawptr) -> rawptr {
    return vyx_bootstrap_fiber_create(main_fiber, work as rawptr, arg);
}

/// Switch to a specific fiber
@[platform("windows")]
public fn vio_fiber_switch(fiber: rawptr) {
    SwitchToFiber(fiber);
}

@[platform("posix")]
public fn vio_fiber_switch(fiber: rawptr) {
    vyx_bootstrap_fiber_switch(fiber);
}

/// Yield current fiber back to the scheduler
@[platform("windows")]
public fn vio_fiber_yield(main_fiber: rawptr) {
    SwitchToFiber(main_fiber);
}

@[platform("posix")]
public fn vio_fiber_yield(main_fiber: rawptr) {
    vyx_bootstrap_fiber_yield();
}

/// Delete / free a fiber
@[platform("windows")]
public fn vio_fiber_delete(fiber: rawptr) {
    DeleteFiber(fiber);
}

@[platform("posix")]
public fn vio_fiber_delete(fiber: rawptr) {
    vyx_bootstrap_fiber_delete(fiber);
}

/// Run a fiber once (switch to it and back)
public fn vio_fiber_run_one(main_fiber: rawptr, fiber: rawptr) {
    vio_fiber_switch(fiber);
}

/// Yield point for async/await — compiler may call this at await.
/// Stackless: pump the ready queue; does not suspend the current worker.
public fn __vio_await_yield() {
    vio_yield();
}

let VIO_LOCK_BYTES: i64 = 128;
let VIO_COND_BYTES: i64 = 128;
let VIO_PROMISE_STATE_BYTES: i64 = 80;
let VIO_PROMISE_STATE_LOCK_OFFSET: i64 = 0;
let VIO_PROMISE_STATE_COND_OFFSET: i64 = 8;
let VIO_PROMISE_STATE_REFCOUNT_OFFSET: i64 = 16;
let VIO_PROMISE_STATE_DONE_OFFSET: i64 = 24;
let VIO_PROMISE_STATE_FAILED_OFFSET: i64 = 32;
let VIO_PROMISE_STATE_ERROR_OFFSET: i64 = 40;
let VIO_PROMISE_STATE_SIZE_OFFSET: i64 = 48;
let VIO_PROMISE_STATE_VALUE_OFFSET: i64 = 56;

public fn vio_lock_new() -> rawptr {
    let lock = malloc(VIO_LOCK_BYTES);
    if (lock == null) { return null; }
    memset(lock, 0, VIO_LOCK_BYTES);
    return vio_lock_new_platform(lock);
}

@[platform("windows")]
public fn vio_lock_new_platform(lock: rawptr) -> rawptr {
    InitializeCriticalSection(lock);
    return lock;
}

@[platform("posix")]
fn vio_lock_new_platform(lock: rawptr) -> rawptr {
    let rc = pthread_mutex_init(lock, null);
    if (rc != 0) {
        free(lock);
        return null;
    }
    return lock;
}

@[platform("windows")]
public fn vio_lock_lock(lock: rawptr) {
    if (lock == null) { return; }
    EnterCriticalSection(lock);
}

@[platform("posix")]
fn vio_lock_lock(lock: rawptr) {
    if (lock == null) { return; }
    if (pthread_mutex_lock(lock) != 0) {
        panic("vio lock failed");
    }
}

@[platform("windows")]
public fn vio_lock_unlock(lock: rawptr) {
    if (lock == null) { return; }
    LeaveCriticalSection(lock);
}

@[platform("posix")]
fn vio_lock_unlock(lock: rawptr) {
    if (lock == null) { return; }
    if (pthread_mutex_unlock(lock) != 0) {
        panic("vio unlock failed");
    }
}

@[platform("windows")]
public fn vio_lock_destroy(lock: rawptr) {
    if (lock == null) { return; }
    DeleteCriticalSection(lock);
    free(lock);
}

@[platform("posix")]
fn vio_lock_destroy(lock: rawptr) {
    if (lock == null) { return; }
    if (pthread_mutex_destroy(lock) != 0) {
        panic("vio lock destroy failed");
    }
    free(lock);
}

public fn vio_cond_new() -> rawptr {
    let cond = malloc(VIO_COND_BYTES);
    if (cond == null) { return null; }
    memset(cond, 0, VIO_COND_BYTES);
    return vio_cond_new_platform(cond);
}

@[platform("windows")]
public fn vio_cond_new_platform(cond: rawptr) -> rawptr {
    InitializeConditionVariable(cond);
    return cond;
}

@[platform("posix")]
fn vio_cond_new_platform(cond: rawptr) -> rawptr {
    let rc = pthread_cond_init(cond, null);
    if (rc != 0) {
        free(cond);
        return null;
    }
    return cond;
}

@[platform("windows")]
public fn vio_cond_wait(cond: rawptr, lock: rawptr) {
    if (cond == null || lock == null) { return; }
    if (SleepConditionVariableCS(cond, lock, 4294967295 as u32) == 0) {
        panic("vio cond wait failed");
    }
}

@[platform("posix")]
fn vio_cond_wait(cond: rawptr, lock: rawptr) {
    if (cond == null || lock == null) { return; }
    if (pthread_cond_wait(cond, lock) != 0) {
        panic("vio cond wait failed");
    }
}

@[platform("windows")]
public fn vio_cond_signal(cond: rawptr) {
    if (cond == null) { return; }
    WakeConditionVariable(cond);
}

@[platform("posix")]
fn vio_cond_signal(cond: rawptr) {
    if (cond == null) { return; }
    if (pthread_cond_signal(cond) != 0) {
        panic("vio cond signal failed");
    }
}

@[platform("windows")]
public fn vio_cond_broadcast(cond: rawptr) {
    if (cond == null) { return; }
    WakeAllConditionVariable(cond);
}

@[platform("posix")]
fn vio_cond_broadcast(cond: rawptr) {
    if (cond == null) { return; }
    if (pthread_cond_broadcast(cond) != 0) {
        panic("vio cond broadcast failed");
    }
}

@[platform("windows")]
public fn vio_cond_destroy(cond: rawptr) {
    if (cond == null) { return; }
    free(cond);
}

@[platform("posix")]
fn vio_cond_destroy(cond: rawptr) {
    if (cond == null) { return; }
    if (pthread_cond_destroy(cond) != 0) {
        panic("vio cond destroy failed");
    }
    free(cond);
}

public fn vio_promise_state_lock_handle(state: rawptr) -> rawptr {
    if (state == null) { return null; }
    return ptr_read_i64(state + VIO_PROMISE_STATE_LOCK_OFFSET) as rawptr;
}

public fn vio_promise_state_set_lock_handle(state: rawptr, lock: rawptr) {
    if (state == null) { return; }
    ptr_write_i64(state + VIO_PROMISE_STATE_LOCK_OFFSET, lock as i64);
}

public fn vio_promise_state_cond_handle(state: rawptr) -> rawptr {
    if (state == null) { return null; }
    return ptr_read_i64(state + VIO_PROMISE_STATE_COND_OFFSET) as rawptr;
}

public fn vio_promise_state_set_cond_handle(state: rawptr, cond: rawptr) {
    if (state == null) { return; }
    ptr_write_i64(state + VIO_PROMISE_STATE_COND_OFFSET, cond as i64);
}

public fn vio_promise_state_refcount(state: rawptr) -> i64 {
    if (state == null) { return 0; }
    return ptr_read_i64(state + VIO_PROMISE_STATE_REFCOUNT_OFFSET);
}

public fn vio_promise_state_set_refcount(state: rawptr, value: i64) {
    if (state == null) { return; }
    ptr_write_i64(state + VIO_PROMISE_STATE_REFCOUNT_OFFSET, value);
}

public fn vio_promise_state_done(state: rawptr) -> i64 {
    if (state == null) { return 0; }
    return ptr_read_i64(state + VIO_PROMISE_STATE_DONE_OFFSET);
}

public fn vio_promise_state_set_done(state: rawptr, value: i64) {
    if (state == null) { return; }
    ptr_write_i64(state + VIO_PROMISE_STATE_DONE_OFFSET, value);
}

public fn vio_promise_state_failed(state: rawptr) -> i64 {
    if (state == null) { return 0; }
    return ptr_read_i64(state + VIO_PROMISE_STATE_FAILED_OFFSET);
}

public fn vio_promise_state_set_failed(state: rawptr, value: i64) {
    if (state == null) { return; }
    ptr_write_i64(state + VIO_PROMISE_STATE_FAILED_OFFSET, value);
}

public fn vio_promise_state_error(state: rawptr) -> i64 {
    if (state == null) { return 0; }
    return ptr_read_i64(state + VIO_PROMISE_STATE_ERROR_OFFSET);
}

public fn vio_promise_state_set_error(state: rawptr, value: i64) {
    if (state == null) { return; }
    ptr_write_i64(state + VIO_PROMISE_STATE_ERROR_OFFSET, value);
}

public fn vio_promise_state_payload_size(state: rawptr) -> i64 {
    if (state == null) { return 0; }
    return ptr_read_i64(state + VIO_PROMISE_STATE_SIZE_OFFSET);
}

public fn vio_promise_state_set_payload_size(state: rawptr, value: i64) {
    if (state == null) { return; }
    ptr_write_i64(state + VIO_PROMISE_STATE_SIZE_OFFSET, value);
}

public fn vio_promise_state_payload_ptr(state: rawptr) -> rawptr {
    if (state == null) { return null; }
    return ptr_read_i64(state + VIO_PROMISE_STATE_VALUE_OFFSET) as rawptr;
}

public fn vio_promise_state_set_payload_ptr(state: rawptr, value: rawptr) {
    if (state == null) { return; }
    ptr_write_i64(state + VIO_PROMISE_STATE_VALUE_OFFSET, value as i64);
}

public fn vio_promise_state_new() -> rawptr {
    let state = malloc(VIO_PROMISE_STATE_BYTES);
    if (state == null) { return null; }
    memset(state, 0, VIO_PROMISE_STATE_BYTES);
    let lock = vio_lock_new();
    if (lock == null) {
        free(state);
        return null;
    }
    let cond = vio_cond_new();
    if (cond == null) {
        vio_lock_destroy(lock);
        free(state);
        return null;
    }
    vio_promise_state_set_lock_handle(state, lock);
    vio_promise_state_set_cond_handle(state, cond);
    vio_promise_state_set_refcount(state, 1);
    return state;
}

public fn vio_promise_state_retain(state: rawptr) {
    if (state == null) { return; }
    let lock = vio_promise_state_lock_handle(state);
    if (lock == null) { return; }
    vio_lock_lock(lock);
    let count = vio_promise_state_refcount(state) + 1;
    vio_promise_state_set_refcount(state, count);
    vio_lock_unlock(lock);
}

public fn vio_promise_state_release(state: rawptr) {
    if (state == null) { return; }
    let lock = vio_promise_state_lock_handle(state);
    let cond = vio_promise_state_cond_handle(state);
    if (lock == null) {
        if (cond != null) {
            vio_cond_destroy(cond);
        }
        free(state);
        return;
    }
    vio_lock_lock(lock);
    let count = vio_promise_state_refcount(state) - 1;
    vio_promise_state_set_refcount(state, count);
    if (count > 0) {
        vio_lock_unlock(lock);
        return;
    }
    let payload = vio_promise_state_payload_ptr(state);
    vio_promise_state_set_cond_handle(state, null);
    vio_promise_state_set_payload_ptr(state, null);
    vio_promise_state_set_payload_size(state, 0);
    vio_lock_unlock(lock);
    vio_cond_destroy(cond);
    vio_lock_destroy(lock);
    if (payload != null) {
        free(payload);
    }
    free(state);
}

public fn vio_promise_state_resolve<T>(state: rawptr, val: T) {
    if (state == null) { panic("Promise resolve on null state"); }
    let lock = vio_promise_state_lock_handle(state);
    if (lock == null) { panic("Promise resolve on invalid state"); }
    let cond = vio_promise_state_cond_handle(state);
    vio_lock_lock(lock);
    if (vio_promise_state_done(state) != 0) {
        vio_lock_unlock(lock);
        return;
    }
    let size = sizeof::<T>();
    if (vio_promise_state_payload_size(state) == 0) {
        if (size > 0) {
            let buf = malloc(size);
            if (buf == null) {
                vio_lock_unlock(lock);
                panic("Promise payload allocation failed");
            }
            memset(buf, 0, size);
            vio_promise_state_set_payload_ptr(state, buf);
            vio_promise_state_set_payload_size(state, size);
        }
    } else if (vio_promise_state_payload_size(state) != size) {
        vio_lock_unlock(lock);
        panic("Promise payload size mismatch");
    }
    let payload = vio_promise_state_payload_ptr(state);
    if (size > 0 && payload != null) {
        memcpy(payload, to_rawptr(&val), size);
    }
    vio_promise_state_set_done(state, 1);
    vio_promise_state_set_failed(state, 0);
    vio_promise_state_set_error(state, 0);
    vio_cond_broadcast(cond);
    vio_lock_unlock(lock);
}

public fn vio_promise_state_reject(state: rawptr, code: i64) {
    if (state == null) { panic("Promise reject on null state"); }
    let lock = vio_promise_state_lock_handle(state);
    if (lock == null) { panic("Promise reject on invalid state"); }
    let cond = vio_promise_state_cond_handle(state);
    vio_lock_lock(lock);
    if (vio_promise_state_done(state) != 0) {
        vio_lock_unlock(lock);
        return;
    }
    vio_promise_state_set_done(state, 1);
    vio_promise_state_set_failed(state, 1);
    vio_promise_state_set_error(state, code);
    vio_cond_broadcast(cond);
    vio_lock_unlock(lock);
}

class Promise<R> {
    public state: rawptr;

    public static fn new() -> Promise<R> {
        let state = vio_promise_state_new();
        if (state == null) { panic("Promise allocation failed"); }
        return Promise { state: state };
    }

    public static fn ready(val: R) -> Promise<R> {
        let p = Promise::<R>.new();
        p.resolve(val);
        return p;
    }

    public static fn failed(code: i64) -> Promise<R> {
        let p = Promise::<R>.new();
        p.reject(code);
        return p;
    }

    public fn clone() -> Promise<R> {
        vio_promise_state_retain(self.state);
        return Promise { state: self.state };
    }

    public fn is_done() -> bool {
        if (self.state == null) { return false; }
        return vio_promise_state_done(self.state) != 0;
    }

    public fn is_failed() -> bool {
        if (self.state == null) { return false; }
        return vio_promise_state_failed(self.state) != 0;
    }

    public fn error_code() -> i64 {
        if (self.state == null) { return 0; }
        return vio_promise_state_error(self.state);
    }

    public fn resolve(val: R) {
        vio_promise_state_resolve::<R>(self.state, val);
    }

    public fn reject(code: i64) {
        vio_promise_state_reject(self.state, code);
    }

    public fn poll() -> bool {
        if (self.state == null) { return false; }
        return vio_promise_state_done(self.state) != 0;
    }

    public fn await_value() -> R {
        if (self.state == null) { panic("await on null Promise/Task"); }
        if (self.is_failed()) { panic("await on failed Promise/Task"); }
        vio_promise_state_retain(self.state);
        var out: R;
        let lock = vio_promise_state_lock_handle(self.state);
        let cond = vio_promise_state_cond_handle(self.state);
        if (lock == null || cond == null) {
            vio_promise_state_release(self.state);
            panic("await on invalid Promise/Task state");
        }
        vio_future_await_done(self.state);
        if (vio_promise_state_failed(self.state) != 0) {
            vio_promise_state_release(self.state);
            panic("await on failed Promise/Task");
        }
        vio_lock_lock(lock);
        let size = vio_promise_state_payload_size(self.state);
        let payload = vio_promise_state_payload_ptr(self.state);
        if (size > 0 && payload != null) {
            memcpy(to_rawptr(&out), payload, size);
        }
        vio_lock_unlock(lock);
        vio_promise_state_release(self.state);
        return out;
    }

    public fn drop() {
        if (to_rawptr(self) == null) { return; }
        if (self.state == null) { return; }
        vio_promise_state_release(self.state);
        self.state = null;
    }
}

class Task<R> {
    public state: rawptr;

    public static fn new() -> Task<R> {
        let state = vio_promise_state_new();
        if (state == null) { panic("Task allocation failed"); }
        return Task { state: state };
    }

    public static fn ready(val: R) -> Task<R> {
        let t = Task::<R>.new();
        t.resolve(val);
        return t;
    }

    public static fn sleep(ms: i32) -> Task<i32> {
        let t = Task::<i32>.new();
        vio_timer_arm(t.state, ms);
        return t;
    }

    public static fn yield_now() -> Task<i32> {
        let t = Task::<i32>.new();
        vio_timer_arm(t.state, 0);
        return t;
    }

    public static fn failed(code: i64) -> Task<R> {
        let t = Task::<R>.new();
        t.reject(code);
        return t;
    }

    public fn clone() -> Task<R> {
        vio_promise_state_retain(self.state);
        return Task { state: self.state };
    }

    public fn is_done() -> bool {
        if (self.state == null) { return false; }
        return vio_promise_state_done(self.state) != 0;
    }

    public fn is_failed() -> bool {
        if (self.state == null) { return false; }
        return vio_promise_state_failed(self.state) != 0;
    }

    public fn error_code() -> i64 {
        if (self.state == null) { return 0; }
        return vio_promise_state_error(self.state);
    }

    public fn resolve(val: R) {
        vio_promise_state_resolve::<R>(self.state, val);
    }

    public fn reject(code: i64) {
        vio_promise_state_reject(self.state, code);
    }

    public fn poll() -> bool {
        if (self.state == null) { return false; }
        return vio_promise_state_done(self.state) != 0;
    }

    public fn await_value() -> R {
        if (self.state == null) { panic("await on null Promise/Task"); }
        if (self.is_failed()) { panic("await on failed Promise/Task"); }
        vio_promise_state_retain(self.state);
        var out: R;
        let lock = vio_promise_state_lock_handle(self.state);
        let cond = vio_promise_state_cond_handle(self.state);
        if (lock == null || cond == null) {
            vio_promise_state_release(self.state);
            panic("await on invalid Promise/Task state");
        }
        vio_future_await_done(self.state);
        if (vio_promise_state_failed(self.state) != 0) {
            vio_promise_state_release(self.state);
            panic("await on failed Promise/Task");
        }
        vio_lock_lock(lock);
        let size = vio_promise_state_payload_size(self.state);
        let payload = vio_promise_state_payload_ptr(self.state);
        if (size > 0 && payload != null) {
            memcpy(to_rawptr(&out), payload, size);
        }
        vio_lock_unlock(lock);
        vio_promise_state_release(self.state);
        return out;
    }

    public fn drop() {
        if (to_rawptr(self) == null) { return; }
        if (self.state == null) { return; }
        vio_promise_state_release(self.state);
        self.state = null;
    }
}

// ============================================================
//  Unity C#-style Coroutine API
// ============================================================

/// Wait for N seconds (Unity's WaitForSeconds equivalent)
public fn WaitForSeconds(seconds: f64) {
    let ms = (seconds * 1000.0) as i32;
    vio_sleep(ms);
}

/// Wait for N milliseconds
public fn WaitForMs(ms: i32) {
    vio_sleep(ms);
}

/// Wait until next tick (Unity's yield return null equivalent)
public fn WaitForNextTick() {
    vio_yield();
}

/// Start a coroutine on a new fiber (Unity's StartCoroutine)
/// Returns fiber handle for StopCoroutine
public fn StartCoroutine(main_fiber: rawptr, work: i64) -> rawptr {
    return StartCoroutineCtx(main_fiber, work, main_fiber);
}

/// Start a coroutine with an explicit entry argument
public fn StartCoroutineCtx(main_fiber: rawptr, work: i64, arg: rawptr) -> rawptr {
    let fiber = vio_fiber_create_ctx(main_fiber, work, arg);
    vio_fiber_switch(fiber);
    return fiber;
}

/// Stop a running coroutine (Unity's StopCoroutine)
public fn StopCoroutine(handle: rawptr) {
    vio_fiber_delete(handle);
}

class CoroutineHandle {
    public raw: rawptr;

    public fn is_valid() -> bool {
        return self.raw != null;
    }
}

var g_coroutine_main_fiber: rawptr = null;

public fn StartCoroutineHandle(work: i64) -> CoroutineHandle {
    vio_start();
    if (g_coroutine_main_fiber == null) {
        g_coroutine_main_fiber = vio_fiber_start();
    }
    let h = StartCoroutine(g_coroutine_main_fiber, work);
    return CoroutineHandle { raw: h };
}

public fn StopCoroutineHandle(handle: CoroutineHandle) {
    if (handle.raw != null) {
        StopCoroutine(handle.raw);
    }
}

// Legacy misspelling retained for source compatibility. New code must use
// StartCoroutineHandle.
public fn StartCoruntine(work: i64) -> CoroutineHandle {
    return StartCoroutineHandle(work);
}

// Legacy misspelling retained for source compatibility. New code must use
// StopCoroutineHandle.
public fn StopCoruntine(handle: CoroutineHandle) {
    StopCoroutineHandle(handle);
}

/// Stop the fiber scheduler
@[platform("windows")]
public fn vio_fiber_stop(main_fiber: rawptr) {
    // On Windows, ConvertFiberToThread restores normal thread
    // For now, nothing to do
}

@[platform("posix")]
public fn vio_fiber_stop(main_fiber: rawptr) {
    vyx_bootstrap_fiber_stop(main_fiber);
}

// ============================================================
//  Async file I/O helpers (Windows-only for now)
// ============================================================

@[platform("windows")]
public fn open_async_file(path: rawptr) -> i64 {
    let fh = CreateFileA(
        path,
        1073741824,  // GENERIC_READ
        1,           // FILE_SHARE_READ
        null,
        3,           // OPEN_EXISTING
        1073741824,  // FILE_FLAG_OVERLAPPED
        null
    );
    return fh as i64;
}

@[platform("windows")]
public fn close_async_file(fh: i64) {
    CloseHandle(fh as rawptr);
}

// ============================================================
//  TCP helpers — cross-platform
// ============================================================

/// Create a TCP socket
public fn vio_tcp_new() -> i64 {
    return socket(2, 1, 0);
}

/// Close a TCP socket
@[platform("windows")]
public fn vio_tcp_close(fd: i64) {
    closesocket(fd);
}

@[platform("posix")]
public fn vio_tcp_close(fd: i64) {
    close(fd as i32);
}

/// Listen on a port
public fn vio_tcp_listen_on(fd: i64, backlog: i32) -> i32 {
    return listen(fd, backlog);
}

/// Accept a connection
public fn vio_tcp_accept_conn(fd: i64) -> i64 {
    return accept(fd, null, null);
}

/// Send bytes
@[platform("windows")]
public fn vio_tcp_send_bytes(fd: i64, buf: rawptr, len: i32) -> i32 {
    return send(fd, buf, len, 0);
}

@[platform("posix")]
public fn vio_tcp_send_bytes(fd: i64, buf: rawptr, len: i32) -> i32 {
    let sent = send(fd, buf, len as i64, 0);
    return sent as i32;
}

/// Receive bytes
@[platform("windows")]
public fn vio_tcp_recv_bytes(fd: i64, buf: rawptr, len: i32) -> i32 {
    return recv(fd, buf, len, 0);
}

@[platform("posix")]
public fn vio_tcp_recv_bytes(fd: i64, buf: rawptr, len: i32) -> i32 {
    let got = recv(fd, buf, len as i64, 0);
    return got as i32;
}

// ============================================================
//  OOP wrappers — Runtime class
// ============================================================

class Runtime {
    main_fiber: rawptr
    event_fd: i32
    running: i32

    /// Initialize the runtime (WSA + IOCP + Fiber)
    fn start() {
        vio_start();
        self.main_fiber = vio_fiber_start();
        self.running = 1;
    }

    /// Initialize without fiber support (lightweight)
    fn start_simple() {
        vio_start();
        self.running = 1;
    }

    /// Stop the runtime
    fn stop() {
        self.running = 0;
        vio_fiber_stop(self.main_fiber);
    }

    /// Spawn a task on a new OS thread
    fn spawn(work: i64) {
        vio_run(work);
    }

    /// Spawn a task on a new OS thread with explicit context.
    fn spawn_ctx(work: i64, arg: rawptr) {
        vio_run_ctx(work, arg);
    }

    /// Spawn a task and wait for completion.
    fn spawn_wait(work: i64, timeout_ms: i32) -> i32 {
        return vio_run_wait(work, timeout_ms);
    }

    /// Spawn a task with explicit context and wait for completion.
    fn spawn_wait_ctx(work: i64, arg: rawptr, timeout_ms: i32) -> i32 {
        return vio_run_wait_ctx(work, arg, timeout_ms);
    }

    /// Spawn a task as a fiber (cooperative)
    fn spawn_fiber(work: i64) -> rawptr {
        let fiber = vio_fiber_create(self.main_fiber, work);
        return fiber;
    }

    /// Run a fiber once (switch to it)
    fn run_fiber(fiber: rawptr) {
        vio_fiber_switch(fiber);
    }

    /// Yield current fiber to scheduler
    fn yield_to_scheduler() {
        vio_fiber_yield(self.main_fiber);
    }

    /// Sleep the current thread/fiber
    fn sleep(ms: i32) {
        vio_sleep(ms);
    }

    /// Get current time in ms
    fn now() -> i64 {
        return vio_now();
    }

    /// Check if runtime is running
    fn is_running() -> i32 {
        return self.running;
    }

    /// Get the main fiber handle (for manual scheduling)
    fn get_main_fiber() -> rawptr {
        return self.main_fiber;
    }

    /// Start a coroutine (Unity C#-style StartCoroutine)
    fn start_coroutine(work: i64) -> rawptr {
        return StartCoroutine(self.main_fiber, work);
    }

    /// Start a coroutine with an explicit context pointer.
    fn start_coroutine_ctx(work: i64, arg: rawptr) -> rawptr {
        return StartCoroutineCtx(self.main_fiber, work, arg);
    }

    /// Stop a coroutine (Unity C#-style StopCoroutine)
    fn stop_coroutine(handle: rawptr) {
        StopCoroutine(handle);
    }
}

// ============================================================
//  OOP wrappers — TcpSocket class
// ============================================================

class TcpSocket {
    fd: i64
    connected: i32

    /// Create a new TCP socket
    static fn create() -> TcpSocket {
        let s = socket(2, 1, 0);
        return TcpSocket { fd: s, connected: 0 };
    }

    /// Bind to a port
    fn bind_to(port: i16) -> i32 {
        let addr = malloc(16);
        memset(addr, 0, 16);
        let af: i16 = 2;
        memcpy(addr, to_rawptr(&af), 2);
        let net_port = htons(port);
        let port_ptr = (addr as i64 + 2) as rawptr;
        memcpy(port_ptr, to_rawptr(&net_port), 2);
        let result = bind(self.fd, addr, 16);
        free(addr);
        return result;
    }

    /// Start listening
    fn start_listen(backlog: i32) -> i32 {
        return listen(self.fd, backlog);
    }

    /// Accept a new connection
    fn accept_conn() -> TcpSocket {
        let client_fd = accept(self.fd, null, null);
        return TcpSocket { fd: client_fd, connected: 1 };
    }

    /// Send data
    fn send_data(buf: rawptr, len: i32) -> i32 {
        return vio_tcp_send_bytes(self.fd, buf, len);
    }

    /// Receive data
    fn recv_data(buf: rawptr, len: i32) -> i32 {
        return vio_tcp_recv_bytes(self.fd, buf, len);
    }

    /// Close the socket
    fn close() {
        vio_tcp_close(self.fd);
        self.connected = 0;
    }

    /// Check if connected
    fn is_connected() -> i32 {
        return self.connected;
    }

    /// Get the file descriptor
    fn get_fd() -> i64 {
        return self.fd;
    }
}

// ============================================================
//  Convenience API — short names, auto-init, zero boilerplate
//  Just: import std::vio; spawn(fn); sleep(100);
// ============================================================

/// Spawn a function on a new thread (auto-initializes runtime)
public fn spawn(work: i64) {
    vio_start();
    vio_run(work);
}

/// Sleep current thread for N milliseconds
public fn sleep(ms: i32) {
    vio_sleep(ms);
}

/// Get current timestamp in milliseconds
public fn now() -> i64 {
    return vio_now();
}

/// Spawn and wait for completion (blocking)
public fn run(work: i64, timeout_ms: i32) {
    vio_start();
    vio_run_wait(work, timeout_ms);
}

/// Create a TCP socket (auto-initializes WSA)
public fn tcp_new() -> TcpSocket {
    vio_start();
    return TcpSocket.create();
}
