module std.random;

use std.collections;

// Force Mono to cascade Vec<i32>.iter() → Iterator<i32>.
fn __random_force_iter_i32() {
    let _v = Vec::<i32>.new();
    let _it = _v.iter();
}

/// Random — Pseudorandom Number Generator for Vyx (PCG-XSH-RR)
/// Usage: import std::random;
///
/// Example:
///   let rng = Rng.create(42);           // seeded
///   let rng = Rng.auto();               // auto-seeded from clock
///   print(rng.nextInt());               // random i32
///   print(rng.range(1, 100));           // 1..100 inclusive
///   print(rng.nextFloat());             // 0.0..1.0
///   print(rng.choice(vec));             // random element

extern "C" { fn clock() -> i64; }

class Rng {
    state: i64
    inc: i64

    static fn create(seed: i64) -> Rng {
        var r = Rng { state: 0, inc: (seed << 1) | 1 };
        r.step();
        r.state = r.state + seed;
        r.step();
        return r;
    }

    static fn auto() -> Rng {
        return Rng.create(clock() * 6364136223846793005 + 1);
    }

    fn step() {
        self.state = self.state * 6364136223846793005 + self.inc;
    }

    fn nextU32() -> i32 {
        let old = self.state;
        self.step();
        let xor_shifted = (((old >> 18) ^ old) >> 27) as i32;
        let rot = (old >> 59) as i32;
        return (xor_shifted >> rot) | (xor_shifted << (32 - rot));
    }

    fn nextInt() -> i32 {
        return self.nextU32();
    }

    fn nextI64() -> i64 {
        let hi = self.nextU32() as i64;
        let lo = self.nextU32() as i64;
        return (hi << 32) | (lo & 4294967295);
    }

    fn nextFloat() -> f64 {
        let v = self.nextU32();
        let pos = v & 2147483647;
        return (pos as f64) / 2147483647.0;
    }

    fn range(min: i32, max: i32) -> i32 {
        if (min >= max) { return min; }
        let span = max - min + 1;
        let v = self.nextU32();
        let pos = v & 2147483647;
        return min + (pos % span);
    }

    fn rangeI64(min: i64, max: i64) -> i64 {
        if (min >= max) { return min; }
        let span = max - min + 1;
        let v = self.nextI64();
        let pos = v & 9223372036854775807;
        return min + (pos % span);
    }

    fn nextBool() -> bool {
        return (self.nextU32() & 1) != 0;
    }

    fn shuffle(vec: Vec<i32>) {
        var i = vec.len - 1;
        while (i > 0) {
            let j = self.range(0, i);
            let tmp = vec.get(i);
            vec.set(i, vec.get(j));
            vec.set(j, tmp);
            i = i - 1;
        }
    }
}
