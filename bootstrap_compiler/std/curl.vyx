module std.curl;

/// libcurl High-Level Bindings for Vyx
/// Usage: import std::curl;
///
/// Example:
///   http_init();
///   let resp = http_get("https://api.github.com/zen");
///   print(resp);
///   http_cleanup();
///
/// Requires: libcurl (link with -l curl or /defaultlib:libcurl)
///   Windows: vcpkg install curl
///   Linux: apt install libcurl4-openssl-dev
///   macOS: brew install curl

extern "C" {
    fn curl_global_init(flags: i64) -> i32;
    fn curl_global_cleanup();
    fn curl_easy_init() -> rawptr;
    fn curl_easy_cleanup(handle: rawptr);
    fn curl_easy_setopt(handle: rawptr, option: i32, param: rawptr) -> i32;
    fn curl_easy_perform(handle: rawptr) -> i32;
    fn curl_easy_getinfo(handle: rawptr, info: i32, param: rawptr) -> i32;
    fn curl_easy_strerror(code: i32) -> rawptr;
    fn curl_slist_append(list: rawptr, data: rawptr) -> rawptr;
    fn curl_slist_free_all(list: rawptr);
    fn malloc(size: u64) -> rawptr;
    fn realloc(ptr: rawptr, size: u64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
    // Response-body capture uses libcurl's DEFAULT write function (fwrite) with
    // WRITEDATA pointed at a libc FILE*. Vyx's FFI is C-only and Vyx functions
    // are fat pointers, so a Vyx CURLOPT_WRITEFUNCTION callback is not
    // expressible; routing the body through a FILE* is the honest in-language
    // way to capture it.
    fn tmpfile() -> rawptr;
    fn fclose(f: rawptr) -> i32;
    fn fseek(f: rawptr, offset: i64, whence: i32) -> i32;
    fn ftell(f: rawptr) -> i64;
    fn fread(ptr: rawptr, size: u64, n: u64, f: rawptr) -> u64;
}

let SEEK_SET: i32 = 0;
let SEEK_END: i32 = 2;

let CURL_GLOBAL_ALL: i64 = 3;
let CURLOPT_URL: i32 = 10002;
let CURLOPT_WRITEFUNCTION: i32 = 20011;
let CURLOPT_WRITEDATA: i32 = 10001;
let CURLOPT_POSTFIELDS: i32 = 10015;
let CURLOPT_HTTPHEADER: i32 = 10023;
let CURLOPT_POST: i32 = 47;
let CURLOPT_FOLLOWLOCATION: i32 = 52;
let CURLOPT_TIMEOUT: i32 = 13;
let CURLOPT_USERAGENT: i32 = 10018;
let CURLOPT_CUSTOMREQUEST: i32 = 10036;
let CURLINFO_RESPONSE_CODE: i32 = 2097154;

// ── Internal state ────────────────────────────────────────

var g_curl_initialized: bool = false;

// ── Response ──────────────────────────────────────────────

struct HttpResponse {
    status: i32;
    body: string;
    ok: bool;
}

// ── Lifecycle ─────────────────────────────────────────────

public fn http_init() {
    if (!g_curl_initialized) {
        curl_global_init(CURL_GLOBAL_ALL);
        g_curl_initialized = true;
    }
}

public fn http_cleanup() {
    if (g_curl_initialized) {
        curl_global_cleanup();
        g_curl_initialized = false;
    }
}

// ── Body capture (libcurl default fwrite -> FILE*) ─────────

/// Attach a fresh temp FILE* to `curl` as the write sink and perform the
/// request, then read the captured bytes back. Returns the real response body
/// on success, or "" on a transport error (result != 0) or capture failure.
/// This never returns a placeholder — the string is the actual bytes libcurl
/// wrote.
fn http_perform_capture(curl: rawptr) -> string {
    let sink = tmpfile();
    if (sink == null) { return ""; }
    curl_easy_setopt(curl, CURLOPT_WRITEDATA, sink);

    let result = curl_easy_perform(curl);
    if (result != 0) {
        fclose(sink);
        return "";
    }

    fseek(sink, 0, SEEK_END);
    let n = ftell(sink);
    fseek(sink, 0, SEEK_SET);
    if (n <= 0) {
        fclose(sink);
        return "";
    }
    let buf = malloc((n + 1) as u64);
    if (buf == null) {
        fclose(sink);
        return "";
    }
    let got = fread(buf, 1, n as u64, sink);
    fclose(sink);
    let body = from_cstr_len(buf, got as i64);
    free(buf);
    return body;
}

// ── Simple API ────────────────────────────────────────────

public fn http_get(url: string) -> string {
    http_init();
    let curl = curl_easy_init();
    if (curl == null) { return ""; }

    curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1 as rawptr);
    curl_easy_setopt(curl, CURLOPT_USERAGENT, "Vyx/1.0".c_str());

    let body = http_perform_capture(curl);
    curl_easy_cleanup(curl);
    return body;
}

public fn http_post(url: string, data: string) -> string {
    http_init();
    let curl = curl_easy_init();
    if (curl == null) { return ""; }

    curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
    curl_easy_setopt(curl, CURLOPT_POST, 1 as rawptr);
    curl_easy_setopt(curl, CURLOPT_POSTFIELDS, data.c_str());
    curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1 as rawptr);
    curl_easy_setopt(curl, CURLOPT_USERAGENT, "Vyx/1.0".c_str());

    let body = http_perform_capture(curl);
    curl_easy_cleanup(curl);
    return body;
}

public fn http_post_json(url: string, json: string) -> string {
    http_init();
    let curl = curl_easy_init();
    if (curl == null) { return ""; }

    curl_easy_setopt(curl, CURLOPT_URL, url.c_str());
    curl_easy_setopt(curl, CURLOPT_POST, 1 as rawptr);
    curl_easy_setopt(curl, CURLOPT_POSTFIELDS, json.c_str());

    var headers: rawptr = null;
    headers = curl_slist_append(headers, "Content-Type: application/json".c_str());
    curl_easy_setopt(curl, CURLOPT_HTTPHEADER, headers);
    curl_easy_setopt(curl, CURLOPT_USERAGENT, "Vyx/1.0".c_str());

    let body = http_perform_capture(curl);
    curl_slist_free_all(headers);
    curl_easy_cleanup(curl);
    return body;
}

// ── Error ─────────────────────────────────────────────────

public fn http_error(code: i32) -> string {
    let msg = curl_easy_strerror(code);
    if (msg == null) { return "unknown error"; }
    return from_cstr(msg);
}

// ── Utility ───────────────────────────────────────────────

public fn http_set_timeout(curl_handle: i64, seconds: i32) {
    curl_easy_setopt(curl_handle as rawptr, CURLOPT_TIMEOUT, seconds as rawptr);
}
