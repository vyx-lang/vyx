module std.collections;

use std.defaults;
use std.core;
use std.string;

/// Vyx Standard Library — Slice<T> and StringView
///
/// A Slice<T> is a non-owning view over a contiguous run of `T` values:
/// just a `(ptr, len)` pair. It does NOT free its backing storage, which
/// means the underlying buffer (typically a Vec<T> or a fixed array) must
/// outlive every Slice that points into it.
///
/// Typical uses:
///   - Pass a subrange of a Vec without copying the data.
///   - Iterate a borrowed region with `at` / `for_each`.
///   - Narrow down to a sub-slice via `sub_slice(start, end)`.
///
/// Sister type `StringView` is a non-owning view over a UTF-8 byte range
/// inside a `str`; same rules about ownership apply.
///
/// Construction: use `Slice::<T>.from_vec(v)` to obtain a view over a
/// `Vec<T>`, or `Slice::<T>.new(ptr, len)` for a raw-pointer range.
/// Both are static class methods and are the sole construction paths.

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memcmp(a: rawptr, b: rawptr, n: i64) -> i32;
}

// ─────────────────────────────── Slice<T> ──────────────────────────────────

class Slice<T> {
    public data: rawptr;
    public len: i64;

    /// Construct from a raw pointer and length. Caller guarantees that
    /// `[ptr, ptr + len * sizeof::<T>())` is valid memory that outlives
    /// the returned slice.
    ///
    /// The parameter type is `rawptr` because Vyx's generic instantiation
    /// pipeline doesn't currently monomorphise signatures that reference
    /// `*T` or `*Vec<T>` in parameter position. Callers normally get a
    /// typed pointer out of `Vec<T>.get_ptr(i)` and pass it in directly.
    public static fn new(ptr: rawptr, len: i64) -> Slice<T> {
        var nlen = len;
        if (nlen < 0) { nlen = 0; }
        return Slice { data: ptr, len: nlen };
    }

    /// Construct a slice viewing the full contents of `v`.
    /// The caller must ensure `v` is not destroyed while the slice is in use.
    ///
    /// BUG-LV-19 fix — `v` is borrowed via `@[borrow_args]` so the caller
    /// retains ownership.  Without this, V-MOVE-001 fires the moment a
    /// caller writes `let s = Slice.from_vec(v); v.len();`.
    @[borrow_args]
    public static fn from_vec(v: Vec<T>) -> Slice<T> {
        if (v.len <= 0) {
            return Slice { data: v.data, len: 0 };
        }
        return Slice { data: v.data, len: v.len };
    }

    public fn len() -> i64 { return self.len; }
    public fn isEmpty() -> bool { return self.len == 0; }

    /// Bounds-checked access. Returns `None` if `idx` is out of range.
    public fn at(idx: i64) -> Option<T> {
        if (idx < 0 || idx >= self.len) { return None; }
        let es = sizeof::<T>();
        var out: T;
        memcpy(to_rawptr(&out), self.data + idx * es, es);
        return Some(out);
    }

    /// Bounds-checked access that panics on OOB, matching Vec.get.
    public fn get(idx: i64) -> T {
        if (idx < 0 || idx >= self.len) { panic("Slice.get out of bounds"); }
        let es = sizeof::<T>();
        var out: T;
        memcpy(to_rawptr(&out), self.data + idx * es, es);
        return out;
    }

    public fn get_ptr(idx: i64) -> *T {
        if (idx < 0 || idx >= self.len) { panic("Slice.get_ptr out of bounds"); }
        return (self.data + idx * sizeof::<T>()) as *T;
    }

    public fn operator[](&mut self, idx: i64) -> &mut T {
        let p = self.get_ptr(idx);
        return &mut p[0];
    }

    /// Returns the sub-range `[start, end)`. Indices are clamped to valid
    /// bounds; if `end <= start` the result is empty. The returned slice
    /// aliases the same backing storage, so the same lifetime rules apply.
    public fn sub_slice(start: i64, end: i64) -> Slice<T> {
        var s = start;
        var e = end;
        if (s < 0) { s = 0; }
        if (e > self.len) { e = self.len; }
        if (e < s) { e = s; }
        let es = sizeof::<T>();
        return Slice { data: self.data + s * es, len: e - s };
    }

    /// Invoke `f` on every element in order. Does not allocate.
    public fn for_each(f: fn(T) -> void) {
        let es = sizeof::<T>();
        for (i in 0..self.len) {
            var val: T;
            memcpy(to_rawptr(&val), self.data + i * es, es);
            f(val);
        }
    }

    /// Pointer to element 0 (unsafe: does not check `len > 0`).
    public fn ptr() -> *T {
        return self.data as *T;
    }
}

// ─────────────────────────────── StringView ────────────────────────────────

/// Non-owning view over a byte range inside a `str`. Stores a raw
/// byte pointer and a byte length; the referenced memory must outlive
/// the view (e.g. the source `String` must not be destroyed while a
/// borrowed view from it is still in use).
class StringView {
    public data: rawptr;
    public len: i64;

    public static fn from_string(s: str) -> StringView {
        return StringView { data: s.ptr, len: s.len };
    }

    public static fn new(ptr: rawptr, len: i64) -> StringView {
        var n = len;
        if (n < 0) { n = 0; }
        return StringView { data: ptr, len: n };
    }

    public fn len() -> i64 { return self.len; }
    public fn isEmpty() -> bool { return self.len == 0; }

    /// Byte at `idx` as an i32 in `[0, 255]`, or -1 if out of range.
    public fn byteAt(idx: i64) -> i32 {
        if (idx < 0 || idx >= self.len) { return -1; }
        var b: i32 = 0;
        unsafe { memcpy(to_rawptr(&b), self.data + idx, 1); }
        return b & 255;
    }

    public fn sub_view(start: i64, end: i64) -> StringView {
        var s = start;
        var e = end;
        if (s < 0) { s = 0; }
        if (e > self.len) { e = self.len; }
        if (e < s) { e = s; }
        return StringView { data: self.data + s, len: e - s };
    }

    public fn equals(other: StringView) -> bool {
        if (self.len != other.len) { return false; }
        if (self.len == 0) { return true; }
        return memcmp(self.data, other.data, self.len) == 0;
    }

    /// Copy the viewed bytes out into a fresh owned `String`.
    public fn to_string() -> String {
        let buf = malloc(self.len + 1);
        if (buf == null) { return String.empty(); }
        if (self.len > 0) { memcpy(buf, self.data, self.len); }
        var zero: i32 = 0;
        unsafe { memcpy(buf + self.len, to_rawptr(&zero), 1); }
        let out = String.fromCStr(buf);
        free(buf);
        return out;
    }
}

impl Default for Slice<T> {
    static fn default_value() -> Slice<T> {
        return Slice::<T>.new(null, 0);
    }
}
