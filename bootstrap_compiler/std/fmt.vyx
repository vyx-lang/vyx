module std.fmt;

use std.string;

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, size: i64) -> rawptr;
    fn memset(dst: rawptr, value: i32, size: i64) -> rawptr;
}

/// Vyx Standard Library — Formatting traits
///
/// Display / Debug follow Rust's convention:
///   * `Display` — user-facing pretty form.  Always lossless-enough for
///     `println("x = ${x}")` output.  Users implement this on their own
///     classes to control how their type appears in interpolations.
///   * `Debug`   — developer-facing form.  Typically adds type tags,
///     quotes around strings, container layout, etc.  MVP for primitives
///     delegates to Display (Debug(string) wraps in quotes to distinguish
///     `"1"` from `1`, matching Rust's `"{:?}"`).
///
/// Phase 7 follow-up to Hashable/Eq/Ord/Deref: every primitive nominally
/// satisfies both traits via `impl Trait for <primitive>` blocks at the
/// bottom of this file.  Generic code with `where T: Display` will
/// dispatch `x.display()` through `primitiveMethodImpls_` when T binds
/// to a primitive, same plumbing as `trait Hashable` in std/hash.vyx.
///
/// Not yet wired into the compiler's `${x}` interpolation path — that
/// still snprintfs directly (see CodeGen::emitStringInterpolation).
/// Moving interpolation to dispatch through Display is a later step.

// ============================================================
// Traits
// ============================================================

trait Display {
    fn display() -> string;
}

trait Debug {
    fn debug() -> string;
}

// ============================================================
// Free helpers — primitive → string conversion.
//
// These are factored out of the `impl` blocks so they can be reused by
// user code (e.g. `Vec<T>.debug` concatenating element strings) without
// going through generic dispatch.  They're the formatting analogue of
// `hash_i64` / `str_compare` in std/hash.vyx + std/string.vyx.
//
// Underneath, everything routes through the `format(fmt, ...)` builtin
// (see CodeGen::emitFormat) which wraps snprintf.  This avoids an
// `extern "C" { fn snprintf(...) }` redeclaration here, which would
// collide with the one the interpolation lowering already emits.
// ============================================================

/// Convert an i64 to its decimal string representation.
public fn i64_to_string(val: i64) -> string {
    return format("%lld", val);
}

public fn i32_to_string(val: i32) -> string {
    return format("%d", val);
}

/// Convert an f64 to its string form.  Uses `%g` for a compact human
/// representation (drops trailing zeros, switches to scientific form
/// past 6 significant digits) — matches Rust's `{}` float default.
public fn f64_to_string(val: f64) -> string {
    return format("%g", val);
}

public fn f32_to_string(val: f32) -> string {
    return format("%g", val as f64);
}

/// Convert a bool to "true" / "false".
public fn bool_to_string(val: bool) -> string {
    if (val) { return "true"; }
    return "false";
}

/// Convert one Unicode scalar to its canonical UTF-8 encoding.
public fn char_to_string(val: char) -> string {
    var scalar = val as i64;
    if (scalar < 0 || scalar > 1114111 || (scalar >= 55296 && scalar <= 57343)) {
        scalar = 65533;
    }

    let buf = malloc(5);
    if (buf == null) { return ""; }
    var len: i64 = 0;
    var b0: i32 = 0;
    var b1: i32 = 0;
    var b2: i32 = 0;
    var b3: i32 = 0;
    if (scalar <= 127) {
        b0 = scalar as i32;
        len = 1;
    } elif (scalar <= 2047) {
        b0 = (192 | ((scalar >> 6) & 31)) as i32;
        b1 = (128 | (scalar & 63)) as i32;
        len = 2;
    } elif (scalar <= 65535) {
        b0 = (224 | ((scalar >> 12) & 15)) as i32;
        b1 = (128 | ((scalar >> 6) & 63)) as i32;
        b2 = (128 | (scalar & 63)) as i32;
        len = 3;
    } else {
        b0 = (240 | ((scalar >> 18) & 7)) as i32;
        b1 = (128 | ((scalar >> 12) & 63)) as i32;
        b2 = (128 | ((scalar >> 6) & 63)) as i32;
        b3 = (128 | (scalar & 63)) as i32;
        len = 4;
    }
    memcpy(buf, to_rawptr(&b0), 1);
    if (len > 1) { memcpy(buf + 1, to_rawptr(&b1), 1); }
    if (len > 2) { memcpy(buf + 2, to_rawptr(&b2), 1); }
    if (len > 3) { memcpy(buf + 3, to_rawptr(&b3), 1); }
    memset(buf + len, 0, 1);
    let out = from_cstr_len(buf, len);
    free(buf);
    return out;
}

// ============================================================
// Display impls for primitives
// ============================================================

impl Display for i32  { fn display() -> string { return i32_to_string(self); } }
impl Display for i64  { fn display() -> string { return i64_to_string(self); } }
impl Display for f32  { fn display() -> string { return f32_to_string(self); } }
impl Display for f64  { fn display() -> string { return f64_to_string(self); } }
impl Display for bool { fn display() -> string { return bool_to_string(self); } }
impl Display for char { fn display() -> string { return char_to_string(self); } }
impl Display for string { fn display() -> string { return self; } }
impl Display for String { fn display() -> string { return self.raw(); } }

// ============================================================
// Debug impls for primitives
//
// MVP: delegate to Display for numeric/bool/char.  `impl Debug for
// string` wraps in quotes so `"1"` and `1` look different in developer
// output — mirrors Rust's `"{:?}"` formatter.
// ============================================================

impl Debug for i32  { fn debug() -> string { return i32_to_string(self); } }
impl Debug for i64  { fn debug() -> string { return i64_to_string(self); } }
impl Debug for f32  { fn debug() -> string { return f32_to_string(self); } }
impl Debug for f64  { fn debug() -> string { return f64_to_string(self); } }
impl Debug for bool { fn debug() -> string { return bool_to_string(self); } }
impl Debug for char {
    fn debug() -> string {
        return "'" + char_to_string(self) + "'";
    }
}
impl Debug for string {
    fn debug() -> string {
        return "\"" + self + "\"";
    }
}
