module std.dll;

/// Vyx Dynamic Library Loader
/// Load and call functions from DLLs at runtime.
///
/// Usage:
///   let lib = Library.load("mylib.dll");
///   if (lib.isLoaded()) {
///       let addr = lib.getProc("myFunction");
///       // call through function pointer
///       lib.unload();
///   }

extern "C" {
    fn LoadLibraryA(path: rawptr) -> rawptr;
    fn FreeLibrary(handle: rawptr) -> i32;
    fn GetProcAddress(handle: rawptr, name: rawptr) -> rawptr;
}

/// Dynamic library handle
class Library {
    private handle: rawptr

    /// Load a dynamic library by path.
    public static fn load(path: string) -> Library {
        let h = LoadLibraryA(path.c_str() as rawptr);
        return Library { handle: h };
    }

    /// Check if library was loaded successfully.
    public fn isLoaded() -> bool {
        return self.handle != null;
    }

    /// Get address of an exported function by name.
    public fn getProc(name: string) -> rawptr {
        if (self.handle == null) { return null; }
        return GetProcAddress(self.handle, name.c_str() as rawptr);
    }

    /// Unload the library.
    public fn unload() {
        if (self.handle != null) {
            FreeLibrary(self.handle);
            self.handle = null;
        }
    }
}
