module std.log;

/// Vyx Logging Framework
/// Provides structured, leveled logging.
///
/// Usage:
///   log_info("server started on port ${port}");
///   log_warn("connection timeout");
///   log_error("failed to open file: ${path}");
///   log_debug("processing item ${i}");
///
/// Log levels: TRACE < DEBUG < INFO < WARN < ERROR < FATAL
/// Set minimum level: set_log_level(LOG_WARN);

extern "C" {
    fn printf(fmt: rawptr, ...args: rawptr) -> i32;
    fn time(t: rawptr) -> i64;
}

public let LOG_TRACE: i32 = 0;
public let LOG_DEBUG: i32 = 1;
public let LOG_INFO: i32 = 2;
public let LOG_WARN: i32 = 3;
public let LOG_ERROR: i32 = 4;
public let LOG_FATAL: i32 = 5;

let _log_level: i32 = 2;

public fn set_log_level(level: i32) {
    _log_level = level;
}

public fn log_trace(msg: string) {
    if (_log_level <= 0) {
        print("[TRACE] ${msg}");
    }
}

public fn log_debug(msg: string) {
    if (_log_level <= 1) {
        print("[DEBUG] ${msg}");
    }
}

public fn log_info(msg: string) {
    if (_log_level <= 2) {
        print("[INFO]  ${msg}");
    }
}

public fn log_warn(msg: string) {
    if (_log_level <= 3) {
        print("[WARN]  ${msg}");
    }
}

public fn log_error(msg: string) {
    if (_log_level <= 4) {
        print("[ERROR] ${msg}");
    }
}

public fn log_fatal(msg: string) {
    print("[FATAL] ${msg}");
    panic("fatal error: " + msg);
}
