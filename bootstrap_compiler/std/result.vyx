module std.core;

/// Result<T, E> — error handling type (like Rust's Result<T, E>)
/// Ok(T) contains a success value, Err(E) contains an error value.
@[c_repr]
@[lang_item("result")]
public enum Result<T, E> {
    Ok(T),
    Err(E),

    fn is_ok() -> bool {
        match (self) {
            case Ok(_) => { return true; }
            default => { return false; }
        }
    }
    fn isOk() -> bool { return self.is_ok(); }

    fn is_err() -> bool {
        match (self) {
            case Err(_) => { return true; }
            default => { return false; }
        }
    }
    fn isErr() -> bool { return self.is_err(); }

    fn unwrap() -> T {
        match (self) {
            case Ok(v) => { return v; }
            default => { panic("called unwrap() on Err"); }
        }
    }

    fn unwrap_or(default_val: T) -> T {
        match (self) {
            case Ok(v) => { return v; }
            default => { return default_val; }
        }
    }
    fn unwrapOr(default_val: T) -> T { return self.unwrap_or(default_val); }

    fn unwrap_err() -> E {
        match (self) {
            case Err(e) => { return e; }
            default => { panic("called unwrap_err() on Ok"); }
        }
    }

    fn map<U>(f: fn(T) -> U) -> Result<U, E> {
        match (self) {
            case Ok(v) => { return Ok(f(v)); }
            case Err(e) => { return Err(e); }
        }
    }

    fn map_err<F>(f: fn(E) -> F) -> Result<T, F> {
        match (self) {
            case Ok(v) => { return Ok(v); }
            case Err(e) => { return Err(f(e)); }
        }
    }

    fn and_then<U>(f: fn(T) -> Result<U, E>) -> Result<U, E> {
        match (self) {
            case Ok(v) => { return f(v); }
            case Err(e) => { return Err(e); }
        }
    }
    fn andThen<U>(f: fn(T) -> Result<U, E>) -> Result<U, E> { return self.and_then::<U>(f); }

    fn or_else<F>(f: fn(E) -> Result<T, F>) -> Result<T, F> {
        match (self) {
            case Ok(v) => { return Ok(v); }
            case Err(e) => { return f(e); }
        }
    }
    fn orElse<F>(f: fn(E) -> Result<T, F>) -> Result<T, F> { return self.or_else::<F>(f); }
}
