module std.reflect;

use std.string;

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
    fn memcmp(a: rawptr, b: rawptr, n: i64) -> i32;
}

fn reflect_byte_at(p: rawptr, idx: i64) -> i32 {
    if (p == null || idx < 0) { return -1; }
    var out: i64 = 0;
    memcpy(to_rawptr(&out), p + idx, 1);
    return (out & 255) as i32;
}

fn reflect_char_at(s: string, idx: i64) -> i32 {
    if (idx < 0 || idx >= s.len) { return -1; }
    return reflect_byte_at(s.c_str(), idx);
}

fn reflect_slice(s: string, lo: i64, hi: i64) -> string {
    if (hi <= lo || lo < 0 || lo >= s.len) { return ""; }
    var end = hi;
    if (end > s.len) { end = s.len; }
    return s.substring(lo as i32, end as i32);
}

fn reflect_find_char(s: string, start: i64, ch: i32) -> i64 {
    if (s.len == 0) { return -1; }
    let p = s.c_str();
    var i = start;
    if (i < 0) { i = 0; }
    while (i < s.len) {
        if (reflect_byte_at(p, i) == ch) { return i; }
        i = i + 1;
    }
    return -1;
}

fn reflect_part(s: string, index: i32, sep: i32) -> string {
    if (s.len == 0 || index < 0) { return ""; }
    let p = s.c_str();
    var part_idx: i32 = 0;
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= s.len) {
        if (i == s.len || reflect_byte_at(p, i) == sep) {
            if (part_idx == index) {
                return reflect_slice(s, start, i);
            }
            part_idx = part_idx + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return "";
}

fn reflect_part_count(s: string, sep: i32) -> i32 {
    if (s.len == 0) { return 0; }
    let p = s.c_str();
    var count: i32 = 1;
    var i: i64 = 0;
    while (i < s.len) {
        if (reflect_byte_at(p, i) == sep) { count = count + 1; }
        i = i + 1;
    }
    return count;
}

fn reflect_parse_i64_slice(s: string, lo: i64, hi: i64) -> i64 {
    if (hi <= lo) { return 0; }
    let p = s.c_str();
    var neg: bool = false;
    var i = lo;
    if (reflect_byte_at(p, i) == 45) {
        neg = true;
        i = i + 1;
    }
    var out: i64 = 0;
    while (i < hi) {
        let ch = reflect_byte_at(p, i);
        if (ch < 48 || ch > 57) { break; }
        out = out * 10 + (ch - 48) as i64;
        i = i + 1;
    }
    if (neg) { return 0 - out; }
    return out;
}

fn reflect_parse_i64(s: string) -> i64 {
    return reflect_parse_i64_slice(s, 0, s.len);
}

fn reflect_alias_matches(alias_blob: string, name: string) -> bool {
    if (alias_blob.len == 0) { return false; }
    let p = alias_blob.c_str();
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= alias_blob.len) {
        if (i == alias_blob.len || reflect_byte_at(p, i) == 44) {
            if (reflect_slice(alias_blob, start, i) == name) { return true; }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn reflect_cache_key(owner: string, member: string) -> string {
    return owner + "#" + member;
}

fn reflect_dup_cstr(s: string) -> rawptr {
    let n = s.len;
    let buf = malloc(n + 1);
    if (buf == null) { panic("reflect string duplication failed"); }
    if (n > 0) {
        memcpy(buf, s.c_str(), n);
    }
    memset(buf + n, 0, 1);
    return buf;
}

fn reflect_store_field(dst: rawptr, field: Field) {
    var tmp = field;
    memcpy(dst, to_rawptr(&tmp), sizeof::<Field>());
}

fn reflect_load_field(src: rawptr) -> Field {
    var out = Field.invalid();
    if (src == null) { return out; }
    memcpy(to_rawptr(&out), src, sizeof::<Field>());
    return out;
}

fn reflect_store_method(dst: rawptr, method: Method) {
    var tmp = method;
    memcpy(dst, to_rawptr(&tmp), sizeof::<Method>());
}

fn reflect_load_method(src: rawptr) -> Method {
    var out = Method.invalid();
    if (src == null) { return out; }
    memcpy(to_rawptr(&out), src, sizeof::<Method>());
    return out;
}

fn reflect_store_type(dst: rawptr, ty: Type) {
    var tmp = ty;
    memcpy(dst, to_rawptr(&tmp), sizeof::<Type>());
}

fn reflect_load_type(src: rawptr) -> Type {
    var out = Type.invalid();
    if (src == null) { return out; }
    memcpy(to_rawptr(&out), src, sizeof::<Type>());
    return out;
}

public class Field {
    public name: string;
    public aliases: string;
    public type_name: string;
    public index: i32;
    public offset: i64;
    public size: i64;
    public writable: bool;
    public valid: bool;

    public static fn invalid() -> Field {
        return Field {
            name: "",
            aliases: "",
            type_name: "",
            index: -1,
            offset: -1,
            size: 0,
            writable: false,
            valid: false
        };
    }
}

public class Method {
    public name: string;
    public aliases: string;
    public owner: string;
    public return_type: string;
    public param_count: i32;
    public params_blob: string;
    public id: i64;
    public receiver: rawptr;
    public needs_receiver: bool;
    public valid: bool;

    public static fn invalid() -> Method {
        return Method {
            name: "",
            aliases: "",
            owner: "",
            return_type: "",
            param_count: 0,
            params_blob: "",
            id: 0,
            receiver: null,
            needs_receiver: false,
            valid: false
        };
    }

    public fn paramType(index: i32) -> string {
        if (!self.valid || index < 0 || index >= self.param_count) { return ""; }
        return reflect_part(self.params_blob, index, 44);
    }

    public fn hasAlias(alias_name: string) -> bool {
        return reflect_alias_matches(self.aliases, alias_name);
    }

    public fn asRaw() -> rawptr {
        if (!self.valid || self.id <= 0) { return null; }
        return reflect_method_ptr_by_id(self.id);
    }

    public fn as<T>() -> T {
        if (!self.valid || self.id <= 0) { panic("reflect.Method.as on invalid method"); }
        return reflect_method_value::<T>(self.id, self.receiver, self.needs_receiver);
    }
}

public class Type {
    public name: string;
    public aliases: string;
    public kind: string;
    public size: i64;
    public field_count: i32;
    public method_count: i32;
    public fields_blob: string;
    public methods_blob: string;
    public parent: string;
    public interfaces: string;
    public valid: bool;
    public fields_intern: rawptr;
    public methods_intern: rawptr;

    public static fn invalid() -> Type {
        return Type {
            name: "",
            aliases: "",
            kind: "",
            size: 0,
            field_count: 0,
            method_count: 0,
            fields_blob: "",
            methods_blob: "",
            parent: "",
            interfaces: "",
            valid: false,
            fields_intern: null,
            methods_intern: null
        };
    }

    public static fn of<T>() -> Type {
        return getType(reflect_name::<T>());
    }

    public fn matches<T>() -> bool {
        if (!self.valid) { return false; }
        let reflected_name = reflect_name::<T>();
        return self.name == reflected_name || reflect_alias_matches(self.aliases, reflected_name);
    }

    public fn create() -> Instance {
        if (!self.valid || self.size <= 0) { return Instance.invalid(); }
        let buf = malloc(self.size);
        if (buf == null) { return Instance.invalid(); }
        memset(buf, 0, self.size);
        return Instance {
            type_name: self.name,
            type_size: self.size,
            fields_blob: reflect_dup_cstr(self.fields_blob),
            methods_blob: reflect_dup_cstr(self.methods_blob),
            data: buf,
            owned: true,
            valid: true
        };
    }

    public fn attach<T>(value: T) -> Instance {
        if (!self.valid || !self.matches::<T>()) { return Instance.invalid(); }
        let n = sizeof::<T>();
        if (self.size > 0 && self.size != n) { return Instance.invalid(); }
        let buf = malloc(n);
        if (buf == null) { return Instance.invalid(); }
        memcpy(buf, to_rawptr(&value), n);
        return Instance {
            type_name: self.name,
            type_size: self.size,
            fields_blob: reflect_dup_cstr(self.fields_blob),
            methods_blob: reflect_dup_cstr(self.methods_blob),
            data: buf,
            owned: true,
            valid: true
        };
    }

    public fn bindRaw(addr: rawptr) -> Instance {
        if (!self.valid || addr == null) { return Instance.invalid(); }
        return Instance {
            type_name: self.name,
            type_size: self.size,
            fields_blob: reflect_dup_cstr(self.fields_blob),
            methods_blob: reflect_dup_cstr(self.methods_blob),
            data: addr,
            owned: false,
            valid: true
        };
    }

    public fn bind<T>(ptr: *T) -> Instance {
        if (!self.valid || ptr == null) { return Instance.invalid(); }
        if (!self.matches::<T>()) { return Instance.invalid(); }
        let n = sizeof::<T>();
        if (self.size > 0 && self.size != n) { return Instance.invalid(); }
        return Instance {
            type_name: self.name,
            type_size: self.size,
            fields_blob: reflect_dup_cstr(self.fields_blob),
            methods_blob: reflect_dup_cstr(self.methods_blob),
            data: to_rawptr(ptr),
            owned: false,
            valid: true
        };
    }

    public fn getField(field_name: string) -> Field {
        if (!self.valid) { return Field.invalid(); }
        reflect_ensure_registry();
        return reflect_cached_field(self.name, field_name);
    }

    public fn getFieldAt(index: i32) -> Field {
        if (!self.valid || index < 0 || index >= self.field_count) { return Field.invalid(); }
        if (self.fields_intern != null) {
            return reflect_load_field(self.fields_intern + (index as i64) * sizeof::<Field>());
        }
        let entry = reflect_part(self.fields_blob, index, 59);
        if (entry.len == 0) { return Field.invalid(); }
        return reflect_field_from_entry(entry);
    }

    public fn getMethod(method_name: string) -> Method {
        if (!self.valid) { return Method.invalid(); }
        reflect_ensure_registry();
        return reflect_cached_method(self.name, method_name);
    }

    public fn getMethodAt(index: i32) -> Method {
        if (!self.valid || index < 0 || index >= self.method_count) { return Method.invalid(); }
        if (self.methods_intern != null) {
            return reflect_load_method(self.methods_intern + (index as i64) * sizeof::<Method>());
        }
        let entry = reflect_part(self.methods_blob, index, 59);
        if (entry.len == 0) { return Method.invalid(); }
        return reflect_method_from_entry(entry);
    }

    public fn parentName() -> string {
        return self.parent;
    }

    public fn parentType() -> Type {
        if (!self.valid || self.parent.len == 0) { return Type.invalid(); }
        return getType(self.parent);
    }

    public fn interfaceCount() -> i32 {
        return reflect_part_count(self.interfaces, 44);
    }

    public fn interfaceName(index: i32) -> string {
        if (!self.valid || index < 0) { return ""; }
        return reflect_part(self.interfaces, index, 44);
    }

    public fn interfaceType(index: i32) -> Type {
        let name = self.interfaceName(index);
        if (name.len == 0) { return Type.invalid(); }
        return getType(name);
    }

    public fn hasInterface(interface_name: string) -> bool {
        return reflect_alias_matches(self.interfaces, interface_name);
    }
}

impl Default for Field {
    static fn default_value() -> Field {
        return Field.invalid();
    }
}

impl Default for Method {
    static fn default_value() -> Method {
        return Method.invalid();
    }
}

impl Default for Type {
    static fn default_value() -> Type {
        return Type.invalid();
    }
}

public class Property {
    public index: i32;
    public offset: i64;
    public size: i64;
    public writable: bool;
    public addr: rawptr;
    public valid: bool;

    public static fn invalid() -> Property {
        return Property {
            index: -1,
            offset: -1,
            size: 0,
            writable: false,
            addr: null,
            valid: false
        };
    }

    public fn view<T>() -> T {
        if (!self.valid || self.addr == null) { panic("reflect.Property.view on invalid property"); }
        let n = sizeof::<T>();
        if (self.size > 0 && self.size != n) { panic("reflect.Property.view type size mismatch"); }
        var out: T;
        memcpy(to_rawptr(&out), self.addr, n);
        return out;
    }

    public fn as<T>() -> *T {
        if (!self.valid || self.addr == null) { panic("reflect.Property.as on invalid property"); }
        let n = sizeof::<T>();
        if (self.size > 0 && self.size != n) { panic("reflect.Property.as type size mismatch"); }
        return self.addr as *T;
    }

    public fn write<T>(value: T) {
        if (!self.valid || self.addr == null || !self.writable) {
            panic("reflect.Property.write on non-writable property");
        }
        let n = sizeof::<T>();
        if (self.size > 0 && self.size != n) { panic("reflect.Property.write type size mismatch"); }
        memcpy(self.addr, to_rawptr(&value), n);
    }

    public fn operator_assign<T>(value: T) -> Property {
        self.write::<T>(value);
        return self;
    }
}

public class Instance {
    public type_name: string;
    public type_size: i64;
    public fields_blob: rawptr;
    public methods_blob: rawptr;
    public data: rawptr;
    public owned: bool;
    public valid: bool;

    public static fn invalid() -> Instance {
        return Instance {
            type_name: "",
            type_size: 0,
            fields_blob: null,
            methods_blob: null,
            data: null,
            owned: false,
            valid: false
        };
    }

    public static fn bind<T>(ptr: *T) -> Instance {
        let t = Type.of::<T>();
        if (!t.valid || ptr == null) { return Instance.invalid(); }
        return t.bind::<T>(ptr);
    }

    public static fn from<T>(value: T) -> Instance {
        let t = Type.of::<T>();
        return t.attach::<T>(value);
    }

    public fn destroy() {
        if (self.owned && self.data != null) {
            free(self.data);
        }
        // Reflection metadata is copied into process-lifetime snapshots so
        // Property/Method views remain valid after the creating Type value dies.
        self.data = null;
        self.fields_blob = null;
        self.methods_blob = null;
        self.owned = false;
        self.valid = false;
    }

    public fn drop() {
        self.destroy();
    }

    public fn getProperty(field_name: string) -> Property {
        if (!self.valid || self.data == null) { return Property.invalid(); }
        reflect_ensure_registry();
        let owner = self.type_name;
        if (owner.len == 0) { return Property.invalid(); }
        let field = reflect_cached_field(owner, field_name);
        if (!field.valid) { return Property.invalid(); }
        return Property {
            index: field.index,
            offset: field.offset,
            size: field.size,
            writable: field.writable,
            addr: self.data + field.offset,
            valid: true
        };
    }

    public fn write<T>(prop: Property, value: T) -> Instance {
        prop.write::<T>(value);
        return self;
    }

    public fn getMethod(method_name: string) -> Method {
        if (!self.valid) { return Method.invalid(); }
        reflect_ensure_registry();
        let owner = self.type_name;
        if (owner.len == 0) { return Method.invalid(); }
        var method = reflect_cached_method(owner, method_name);
        if (!method.valid) { return Method.invalid(); }
        method.receiver = self.data;
        return method;
    }

    public fn view<T>() -> T {
        if (!self.valid || self.data == null) { panic("reflect.Instance.view on invalid instance"); }
        let n = sizeof::<T>();
        if (self.type_size > 0 && self.type_size != n) { panic("reflect.Instance.view type size mismatch"); }
        var out: T;
        memcpy(to_rawptr(&out), self.data, n);
        return out;
    }

    public fn as<T>() -> *T {
        if (!self.valid || self.data == null) { panic("reflect.Instance.as on invalid instance"); }
        let n = sizeof::<T>();
        if (self.type_size > 0 && self.type_size != n) { panic("reflect.Instance.as type size mismatch"); }
        return self.data as *T;
    }

    public fn assign<T>(value: T) {
        if (!self.valid || self.data == null) { panic("reflect.Instance.assign on invalid instance"); }
        let n = sizeof::<T>();
        if (self.type_size > 0 && self.type_size != n) { panic("reflect.Instance.assign type size mismatch"); }
        memcpy(self.data, to_rawptr(&value), n);
    }

    public fn rebindRaw(addr: rawptr) {
        if (!self.valid || addr == null) { panic("reflect.Instance.rebindRaw on invalid address"); }
        if (self.owned && self.data != null) { free(self.data); }
        self.data = addr;
        self.owned = false;
    }

    public fn operator_assign<T>(value: T) -> Instance {
        let ty_name: string = typeof(value);
        if (ty_name == "rawptr"
            || (ty_name.len > 0 && (ty_name.charAt(0) == 42 || ty_name.charAt(0) == 38))) {
            var raw: rawptr = null;
            memcpy(to_rawptr(&raw), to_rawptr(&value), 8);
            self.rebindRaw(raw);
            return self;
        }
        self.assign::<T>(value);
        return self;
    }
}

fn reflect_type_from_record(record: string) -> Type {
    if (record.len == 0) { return Type.invalid(); }
    let p = record.c_str();
    var field: i32 = 0;
    var start: i64 = 0;
    var i: i64 = 0;
    var n0s: i64 = 0; var n0e: i64 = 0;
    var n1s: i64 = 0; var n1e: i64 = 0;
    var n2s: i64 = 0; var n2e: i64 = 0;
    var n3s: i64 = 0; var n3e: i64 = 0;
    var n4s: i64 = 0; var n4e: i64 = 0;
    var n5s: i64 = 0; var n5e: i64 = 0;
    var n6s: i64 = 0; var n6e: i64 = 0;
    var n7s: i64 = 0; var n7e: i64 = 0;
    var n8s: i64 = 0; var n8e: i64 = 0;
    var n9s: i64 = 0; var n9e: i64 = 0;
    while (i <= record.len) {
        if (i == record.len || reflect_byte_at(p, i) == 124) {
            if (field == 0) { n0s = start; n0e = i; }
            elif (field == 1) { n1s = start; n1e = i; }
            elif (field == 2) { n2s = start; n2e = i; }
            elif (field == 3) { n3s = start; n3e = i; }
            elif (field == 4) { n4s = start; n4e = i; }
            elif (field == 5) { n5s = start; n5e = i; }
            elif (field == 6) { n6s = start; n6e = i; }
            elif (field == 7) { n7s = start; n7e = i; }
            elif (field == 8) { n8s = start; n8e = i; }
            elif (field == 9) { n9s = start; n9e = i; }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return Type {
        name: reflect_slice(record, n0s, n0e),
        aliases: reflect_slice(record, n1s, n1e),
        kind: reflect_slice(record, n2s, n2e),
        size: reflect_parse_i64_slice(record, n3s, n3e),
        field_count: reflect_parse_i64_slice(record, n4s, n4e) as i32,
        method_count: reflect_parse_i64_slice(record, n5s, n5e) as i32,
        fields_blob: reflect_slice(record, n6s, n6e),
        methods_blob: reflect_slice(record, n7s, n7e),
        parent: reflect_slice(record, n8s, n8e),
        interfaces: reflect_slice(record, n9s, n9e),
        valid: true,
        fields_intern: null,
        methods_intern: null
    };
}

fn reflect_field_from_entry(entry: string) -> Field {
    if (entry.len == 0) { return Field.invalid(); }
    let p = entry.c_str();
    var field: i32 = 0;
    var start: i64 = 0;
    var i: i64 = 0;
    var n0s: i64 = 0; var n0e: i64 = 0;
    var n1s: i64 = 0; var n1e: i64 = 0;
    var n2s: i64 = 0; var n2e: i64 = 0;
    var n3s: i64 = 0; var n3e: i64 = 0;
    var n4s: i64 = 0; var n4e: i64 = 0;
    var n5s: i64 = 0; var n5e: i64 = 0;
    var n6s: i64 = 0; var n6e: i64 = 0;
    while (i <= entry.len) {
        if (i == entry.len || reflect_byte_at(p, i) == 126) {
            if (field == 0) { n0s = start; n0e = i; }
            elif (field == 1) { n1s = start; n1e = i; }
            elif (field == 2) { n2s = start; n2e = i; }
            elif (field == 3) { n3s = start; n3e = i; }
            elif (field == 4) { n4s = start; n4e = i; }
            elif (field == 5) { n5s = start; n5e = i; }
            elif (field == 6) { n6s = start; n6e = i; }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return Field {
        name: reflect_slice(entry, n0s, n0e),
        aliases: reflect_slice(entry, n6s, n6e),
        type_name: reflect_slice(entry, n1s, n1e),
        index: reflect_parse_i64_slice(entry, n2s, n2e) as i32,
        offset: reflect_parse_i64_slice(entry, n3s, n3e),
        size: reflect_parse_i64_slice(entry, n4s, n4e),
        writable: reflect_parse_i64_slice(entry, n5s, n5e) != 0,
        valid: true
    };
}

fn reflect_method_from_entry(entry: string) -> Method {
    if (entry.len == 0) { return Method.invalid(); }
    let p = entry.c_str();
    var field: i32 = 0;
    var start: i64 = 0;
    var i: i64 = 0;
    var n0s: i64 = 0; var n0e: i64 = 0;
    var n1s: i64 = 0; var n1e: i64 = 0;
    var n2s: i64 = 0; var n2e: i64 = 0;
    var n3s: i64 = 0; var n3e: i64 = 0;
    var n4s: i64 = 0; var n4e: i64 = 0;
    var n5s: i64 = 0; var n5e: i64 = 0;
    var n6s: i64 = 0; var n6e: i64 = 0;
    var n7s: i64 = 0; var n7e: i64 = 0;
    while (i <= entry.len) {
        if (i == entry.len || reflect_byte_at(p, i) == 126) {
            if (field == 0) { n0s = start; n0e = i; }
            elif (field == 1) { n1s = start; n1e = i; }
            elif (field == 2) { n2s = start; n2e = i; }
            elif (field == 3) { n3s = start; n3e = i; }
            elif (field == 4) { n4s = start; n4e = i; }
            elif (field == 5) { n5s = start; n5e = i; }
            elif (field == 6) { n6s = start; n6e = i; }
            elif (field == 7) { n7s = start; n7e = i; }
            field = field + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return Method {
        name: reflect_slice(entry, n0s, n0e),
        aliases: reflect_slice(entry, n6s, n6e),
        owner: reflect_slice(entry, n4s, n4e),
        return_type: reflect_slice(entry, n1s, n1e),
        param_count: reflect_parse_i64_slice(entry, n2s, n2e) as i32,
        params_blob: reflect_slice(entry, n3s, n3e),
        id: reflect_parse_i64_slice(entry, n5s, n5e),
        receiver: null,
        needs_receiver: reflect_parse_i64_slice(entry, n7s, n7e) != 0,
        valid: true
    };
}

var g_reflect_registry_ready: bool = false;
var g_reflect_manifest_text: string = "";
var g_reflect_type_table: rawptr = null;
var g_reflect_field_table: rawptr = null;
var g_reflect_method_table: rawptr = null;
var g_reflect_type_cap: i64 = 0;
var g_reflect_field_cap: i64 = 0;
var g_reflect_method_cap: i64 = 0;

fn reflect_type_slot_size() -> i64 { return 48; }
fn reflect_member_slot_size() -> i64 { return 40; }

fn reflect_read_i64(p: rawptr) -> i64 {
    var out: i64 = 0;
    memcpy(to_rawptr(&out), p, 8);
    return out;
}

fn reflect_write_i64(p: rawptr, v: i64) {
    var tmp = v;
    memcpy(p, to_rawptr(&tmp), 8);
}

fn reflect_read_rawptr(p: rawptr) -> rawptr {
    var out: rawptr = null;
    memcpy(to_rawptr(&out), p, 8);
    return out;
}

fn reflect_write_rawptr(p: rawptr, v: rawptr) {
    var tmp = v;
    memcpy(p, to_rawptr(&tmp), 8);
}

fn reflect_raw_byte(p: rawptr, offset: i64) -> i32 {
    var out: i64 = 0;
    memcpy(to_rawptr(&out), p + offset, 1);
    return (out & 255) as i32;
}

fn reflect_hash_bytes(p: rawptr, n: i64) -> i64 {
    var hash: i64 = -3750763034362895579;
    if (p == null || n <= 0) { return hash; }
    var i: i64 = 0;
    while (i + 8 <= n) {
        var chunk: i64 = 0;
        memcpy(to_rawptr(&chunk), p + i, 8);
        var k: i64 = 0;
        while (k < 8) {
            hash = hash ^ ((chunk >> (k * 8)) & 255);
            hash = hash * 1099511628211;
            k = k + 1;
        }
        i = i + 8;
    }
    while (i < n) {
        hash = hash ^ (reflect_byte_at(p, i) as i64);
        hash = hash * 1099511628211;
        i = i + 1;
    }
    return hash;
}

fn reflect_hash_string(s: string) -> i64 {
    if (s.len == 0) { return -3750763034362895579; }
    return reflect_hash_bytes(s.c_str(), s.len);
}

fn reflect_hash_pair(owner: string, member: string) -> i64 {
    var hash = reflect_hash_string(owner);
    hash = hash ^ 35;
    hash = hash * 1099511628211;
    if (member.len == 0) { return hash; }
    let p = member.c_str();
    var i: i64 = 0;
    while (i < member.len) {
        hash = hash ^ (reflect_byte_at(p, i) as i64);
        hash = hash * 1099511628211;
        i = i + 1;
    }
    return hash;
}

fn reflect_next_pow2(want: i64) -> i64 {
    var cap: i64 = 16;
    while (cap < want) { cap = cap * 2; }
    return cap;
}

fn reflect_probe_start(hash: i64, cap: i64) -> i64 {
    if (cap <= 0) { return 0; }
    var idx = hash & (cap - 1);
    if (idx < 0) { idx = 0 - idx; }
    return idx;
}

fn reflect_slot_key_equals(slot: rawptr, key: string) -> bool {
    let key_ptr = reflect_read_rawptr(slot + 16);
    let key_len = reflect_read_i64(slot + 24);
    if (key_ptr == null || key_len != key.len) { return false; }
    if (key.len == 0) { return true; }
    return memcmp(key_ptr, key.c_str(), key_len) == 0;
}

fn reflect_slot_key_equals_pair(slot: rawptr, owner: string, member: string) -> bool {
    let key_ptr = reflect_read_rawptr(slot + 16);
    let key_len = reflect_read_i64(slot + 24);
    let want = owner.len + 1 + member.len;
    if (key_ptr == null || key_len != want) { return false; }
    if (owner.len > 0 && memcmp(key_ptr, owner.c_str(), owner.len) != 0) { return false; }
    if (reflect_byte_at(key_ptr, owner.len) != 35) { return false; }
    if (member.len == 0) { return true; }
    return memcmp(key_ptr + owner.len + 1, member.c_str(), member.len) == 0;
}

fn reflect_type_slot(idx: i64) -> rawptr {
    return g_reflect_type_table + idx * reflect_type_slot_size();
}

fn reflect_member_slot(table: rawptr, idx: i64) -> rawptr {
    return table + idx * reflect_member_slot_size();
}

fn reflect_cache_put_type_key(key: string, intern_ty: rawptr) {
    if (key.len == 0 || intern_ty == null || g_reflect_type_table == null || g_reflect_type_cap <= 0) { return; }
    let hash = reflect_hash_string(key);
    let mask = g_reflect_type_cap - 1;
    var idx = reflect_probe_start(hash, g_reflect_type_cap);
    var probes: i64 = 0;
    while (probes < g_reflect_type_cap) {
        let slot = reflect_type_slot(idx);
        let state = reflect_read_i64(slot);
        if (state == 0 || (reflect_read_i64(slot + 8) == hash && reflect_slot_key_equals(slot, key))) {
            reflect_write_i64(slot, 1);
            reflect_write_i64(slot + 8, hash);
            reflect_write_rawptr(slot + 16, reflect_dup_cstr(key));
            reflect_write_i64(slot + 24, key.len);
            reflect_write_rawptr(slot + 32, intern_ty);
            return;
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
}

fn reflect_cache_get_type_key(key: string) -> Type {
    if (key.len == 0 || g_reflect_type_table == null || g_reflect_type_cap <= 0) { return Type.invalid(); }
    let hash = reflect_hash_string(key);
    let mask = g_reflect_type_cap - 1;
    var idx = reflect_probe_start(hash, g_reflect_type_cap);
    var probes: i64 = 0;
    while (probes < g_reflect_type_cap) {
        let slot = reflect_type_slot(idx);
        let state = reflect_read_i64(slot);
        if (state == 0) { return Type.invalid(); }
        if (reflect_read_i64(slot + 8) == hash && reflect_slot_key_equals(slot, key)) {
            return reflect_load_type(reflect_read_rawptr(slot + 32));
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    return Type.invalid();
}

fn reflect_cache_put_member_ptr(table: rawptr, cap: i64, key: string, obj: rawptr) {
    if (key.len == 0 || obj == null || table == null || cap <= 0) { return; }
    let hash = reflect_hash_string(key);
    let mask = cap - 1;
    var idx = reflect_probe_start(hash, cap);
    var probes: i64 = 0;
    while (probes < cap) {
        let slot = reflect_member_slot(table, idx);
        let state = reflect_read_i64(slot);
        if (state == 0 || (reflect_read_i64(slot + 8) == hash && reflect_slot_key_equals(slot, key))) {
            reflect_write_i64(slot, 1);
            reflect_write_i64(slot + 8, hash);
            reflect_write_rawptr(slot + 16, reflect_dup_cstr(key));
            reflect_write_i64(slot + 24, key.len);
            reflect_write_rawptr(slot + 32, obj);
            return;
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
}

fn reflect_cache_get_member_ptr(table: rawptr, cap: i64, key: string) -> rawptr {
    if (key.len == 0 || table == null || cap <= 0) { return null; }
    let hash = reflect_hash_string(key);
    let mask = cap - 1;
    var idx = reflect_probe_start(hash, cap);
    var probes: i64 = 0;
    while (probes < cap) {
        let slot = reflect_member_slot(table, idx);
        let state = reflect_read_i64(slot);
        if (state == 0) { return null; }
        if (reflect_read_i64(slot + 8) == hash && reflect_slot_key_equals(slot, key)) {
            return reflect_read_rawptr(slot + 32);
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    return null;
}

fn reflect_cache_get_member_pair(table: rawptr, cap: i64, owner: string, member: string) -> rawptr {
    if (owner.len == 0 || member.len == 0 || table == null || cap <= 0) { return null; }
    let hash = reflect_hash_pair(owner, member);
    let mask = cap - 1;
    var idx = reflect_probe_start(hash, cap);
    var probes: i64 = 0;
    while (probes < cap) {
        let slot = reflect_member_slot(table, idx);
        let state = reflect_read_i64(slot);
        if (state == 0) { return null; }
        if (reflect_read_i64(slot + 8) == hash && reflect_slot_key_equals_pair(slot, owner, member)) {
            return reflect_read_rawptr(slot + 32);
        }
        idx = (idx + 1) & mask;
        probes = probes + 1;
    }
    return null;
}

fn reflect_cache_type_aliases(alias_blob: string, intern_ty: rawptr) {
    if (alias_blob.len == 0) { return; }
    let p = alias_blob.c_str();
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= alias_blob.len) {
        if (i == alias_blob.len || reflect_byte_at(p, i) == 44) {
            let alias_name = reflect_slice(alias_blob, start, i);
            reflect_cache_put_type_key(alias_name, intern_ty);
            start = i + 1;
        }
        i = i + 1;
    }
}

fn reflect_cache_field_aliases(owner: string, alias_blob: string, field_obj: rawptr) {
    if (alias_blob.len == 0) { return; }
    let p = alias_blob.c_str();
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= alias_blob.len) {
        if (i == alias_blob.len || reflect_byte_at(p, i) == 44) {
            let alias_name = reflect_slice(alias_blob, start, i);
            reflect_cache_put_member_ptr(g_reflect_field_table,
                                         g_reflect_field_cap,
                                         reflect_cache_key(owner, alias_name),
                                         field_obj);
            start = i + 1;
        }
        i = i + 1;
    }
}

fn reflect_cache_method_aliases(owner: string, alias_blob: string, method_obj: rawptr) {
    if (alias_blob.len == 0) { return; }
    let p = alias_blob.c_str();
    var start: i64 = 0;
    var i: i64 = 0;
    while (i <= alias_blob.len) {
        if (i == alias_blob.len || reflect_byte_at(p, i) == 44) {
            let alias_name = reflect_slice(alias_blob, start, i);
            reflect_cache_put_member_ptr(g_reflect_method_table,
                                         g_reflect_method_cap,
                                         reflect_cache_key(owner, alias_name),
                                         method_obj);
            start = i + 1;
        }
        i = i + 1;
    }
}

fn reflect_intern_type_members(ty: Type) -> Type {
    var out = ty;
    let field_n = ty.field_count;
    if (field_n > 0) {
        let bytes = (field_n as i64) * sizeof::<Field>();
        let arr = malloc(bytes);
        if (arr == null) { panic("reflect field intern failed"); }
        let blob = ty.fields_blob;
        let p = blob.c_str();
        var fi: i32 = 0;
        var start: i64 = 0;
        var i: i64 = 0;
        while (i <= blob.len && fi < field_n) {
            if (i == blob.len || reflect_byte_at(p, i) == 59) {
                let entry = reflect_slice(blob, start, i);
                let field = reflect_field_from_entry(entry);
                let slot = arr + (fi as i64) * sizeof::<Field>();
                reflect_store_field(slot, field);
                if (field.valid) {
                    reflect_cache_put_member_ptr(g_reflect_field_table,
                                                 g_reflect_field_cap,
                                                 reflect_cache_key(ty.name, field.name),
                                                 slot);
                    reflect_cache_field_aliases(ty.name, field.aliases, slot);
                }
                fi = fi + 1;
                start = i + 1;
            }
            i = i + 1;
        }
        out.fields_intern = arr;
    }
    let method_n = ty.method_count;
    if (method_n > 0) {
        let bytes2 = (method_n as i64) * sizeof::<Method>();
        let arr2 = malloc(bytes2);
        if (arr2 == null) { panic("reflect method intern failed"); }
        let blob2 = ty.methods_blob;
        let p2 = blob2.c_str();
        var mi: i32 = 0;
        var start2: i64 = 0;
        var j: i64 = 0;
        while (j <= blob2.len && mi < method_n) {
            if (j == blob2.len || reflect_byte_at(p2, j) == 59) {
                let entry2 = reflect_slice(blob2, start2, j);
                let method = reflect_method_from_entry(entry2);
                let slot2 = arr2 + (mi as i64) * sizeof::<Method>();
                reflect_store_method(slot2, method);
                if (method.valid) {
                    reflect_cache_put_member_ptr(g_reflect_method_table,
                                                 g_reflect_method_cap,
                                                 reflect_cache_key(ty.name, method.name),
                                                 slot2);
                    reflect_cache_method_aliases(ty.name, method.aliases, slot2);
                }
                mi = mi + 1;
                start2 = j + 1;
            }
            j = j + 1;
        }
        out.methods_intern = arr2;
    }
    return out;
}

fn reflect_cached_field(owner: string, field_name: string) -> Field {
    return reflect_load_field(reflect_cache_get_member_pair(g_reflect_field_table,
                                                            g_reflect_field_cap,
                                                            owner,
                                                            field_name));
}

fn reflect_cached_method(owner: string, method_name: string) -> Method {
    return reflect_load_method(reflect_cache_get_member_pair(g_reflect_method_table,
                                                              g_reflect_method_cap,
                                                              owner,
                                                              method_name));
}

fn reflect_ensure_registry() {
    if (g_reflect_registry_ready) { return; }
    g_reflect_manifest_text = reflect_manifest();
    let type_count = reflect_part_count(g_reflect_manifest_text, 10);
    g_reflect_type_cap = reflect_next_pow2((type_count as i64) * 4 + 16);
    g_reflect_field_cap = reflect_next_pow2((type_count as i64) * 128 + 256);
    g_reflect_method_cap = reflect_next_pow2((type_count as i64) * 128 + 256);
    g_reflect_type_table = malloc(g_reflect_type_cap * reflect_type_slot_size());
    g_reflect_field_table = malloc(g_reflect_field_cap * reflect_member_slot_size());
    g_reflect_method_table = malloc(g_reflect_method_cap * reflect_member_slot_size());
    if (g_reflect_type_table == null || g_reflect_field_table == null || g_reflect_method_table == null) {
        panic("reflect registry allocation failed");
    }
    memset(g_reflect_type_table, 0, g_reflect_type_cap * reflect_type_slot_size());
    memset(g_reflect_field_table, 0, g_reflect_field_cap * reflect_member_slot_size());
    memset(g_reflect_method_table, 0, g_reflect_method_cap * reflect_member_slot_size());
    var start: i64 = 0;
    var i: i64 = 0;
    let mp = g_reflect_manifest_text.c_str();
    while (i <= g_reflect_manifest_text.len) {
        if (i == g_reflect_manifest_text.len || reflect_byte_at(mp, i) == 10) {
            let record = reflect_slice(g_reflect_manifest_text, start, i);
            if (record.len > 0) {
                var ty = reflect_type_from_record(record);
                if (ty.valid && ty.name.len > 0) {
                    ty = reflect_intern_type_members(ty);
                    let intern = malloc(sizeof::<Type>());
                    if (intern == null) { panic("reflect type intern failed"); }
                    reflect_store_type(intern, ty);
                    reflect_cache_put_type_key(ty.name, intern);
                    reflect_cache_type_aliases(ty.aliases, intern);
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    g_reflect_registry_ready = true;
}

public fn getType(name: string) -> Type {
    if (name.len == 0) { return Type.invalid(); }
    reflect_ensure_registry();
    return reflect_cache_get_type_key(name);
}

public fn get_type(name: string) -> Type {
    return getType(name);
}

public fn typeOf<T>() -> Type {
    return Type.of::<T>();
}

public fn attach<T>(value: T) -> Instance {
    let t = Type.of::<T>();
    return t.attach::<T>(value);
}

public fn bind<T>(ptr: *T) -> Instance {
    return Instance.bind::<T>(ptr);
}
