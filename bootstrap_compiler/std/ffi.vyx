module std.ffi;

use std.string;
use std.collections;

/// C ABI FFI helpers. Language FFI is C-only; C++ class/vtable interop is DCI.
///
/// Integer aliases follow the target C ABI: Windows x64 is LLP64 (`c_long` is
/// i32); Linux / Android / macOS LP64 (`c_long` is i64). `c_void` is the
/// `void*` stand-in (`rawptr`). `cfn(...)` is the thin C function-pointer type.
///
/// Usage: `use std.ffi;`

public type c_void = rawptr;
public type c_char = i8;
public type c_schar = i8;
public type c_uchar = u8;
public type c_short = i16;
public type c_ushort = u16;
public type c_int = i32;
public type c_uint = u32;
@[platform("windows")]
public type c_long = i32;
@[platform("posix")]
public type c_long = i64;
@[platform("windows")]
public type c_ulong = u32;
@[platform("posix")]
public type c_ulong = u64;
public type c_longlong = i64;
public type c_ulonglong = u64;
public type c_float = f32;
public type c_double = f64;
public type c_size_t = u64;
public type c_ssize_t = i64;
public type c_ptrdiff_t = i64;
public type c_intptr_t = i64;
public type c_uintptr_t = u64;

extern "C" {
    fn malloc(size: u64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: u64) -> rawptr;
    fn strlen(s: rawptr) -> u64;
}

// ── C String Helpers ──────────────────────────────────────

public fn c_string(s: string) -> rawptr {
    return s.c_str();
}

public fn from_c_string(ptr: rawptr) -> string {
    if (ptr == null) { return ""; }
    return from_cstr(ptr);
}

// ── Memory Helpers ────────────────────────────────────────

public fn alloc(size: i32) -> rawptr {
    return malloc(size as u64);
}

public fn alloc_zero(size: i32) -> rawptr {
    let ptr = malloc(size as u64);
    if (ptr != null) {
        memset(ptr, 0, size as u64);
    }
    return ptr;
}

public fn dealloc(ptr: rawptr) {
    if (ptr != null) { free(ptr); }
}

public fn copy_bytes(dst: rawptr, src: rawptr, count: i32) {
    memcpy(dst, src, count as u64);
}

public fn zero_bytes(ptr: rawptr, count: i32) {
    memset(ptr, 0, count as u64);
}

// ── Pointer Arithmetic ───────────────────────────────────

public fn ptr_offset(ptr: rawptr, offset: i32) -> rawptr {
    return (ptr as i64 + offset as i64) as rawptr;
}

public fn ptr_read_i32(ptr: rawptr) -> i32 {
    var result: i32 = 0;
    memcpy(to_rawptr(&result), ptr, 4);
    return result;
}

public fn ptr_read_i64(ptr: rawptr) -> i64 {
    var result: i64 = 0;
    memcpy(to_rawptr(&result), ptr, 8);
    return result;
}

public fn ptr_read_f32(ptr: rawptr) -> f64 {
    var result: f32 = 0.0;
    memcpy(to_rawptr(&result), ptr, 4);
    return result as f64;
}

public fn ptr_read_f64(ptr: rawptr) -> f64 {
    var result: f64 = 0.0;
    memcpy(to_rawptr(&result), ptr, 8);
    return result;
}

public fn ptr_write_i32(ptr: rawptr, value: i32) {
    var v = value;
    memcpy(ptr, to_rawptr(&v), 4);
}

public fn ptr_write_i64(ptr: rawptr, value: i64) {
    var v = value;
    memcpy(ptr, to_rawptr(&v), 8);
}

// ── String Array (char**) ─────────────────────────────────

public fn make_c_string_array(strings: Vec<string>) -> rawptr {
    let count = strings.len;
    let arr = malloc((count + 1) as u64 * 8);
    for (i in 0..count) {
        let s = strings.get(i as i32);
        let cstr = s.c_str();
        var slot = ptr_offset(arr, (i * 8) as i32);
        memcpy(slot, to_rawptr(&cstr), 8);
    }
    // null-terminate the array
    var null_val: rawptr = null;
    memcpy(ptr_offset(arr, (count * 8) as i32), to_rawptr(&null_val), 8);
    return arr;
}

public fn free_c_string_array(arr: rawptr) {
    if (arr != null) { free(arr); }
}

// ── Size Constants ────────────────────────────────────────

public fn sizeof_i8() -> i32 { return 1; }
public fn sizeof_i16() -> i32 { return 2; }
public fn sizeof_i32() -> i32 { return 4; }
public fn sizeof_i64() -> i32 { return 8; }
public fn sizeof_f32() -> i32 { return 4; }
public fn sizeof_f64() -> i32 { return 8; }
public fn sizeof_ptr() -> i32 { return 8; }

/// Borrowed NUL-terminated C string. The pointer is not freed.
public class CStr {
    public ptr: rawptr;

    public static fn from_ptr(p: rawptr) -> CStr {
        return CStr { ptr: p };
    }

    public fn as_ptr(self) -> rawptr {
        return self.ptr;
    }

    public fn is_null(self) -> bool {
        return self.ptr == null;
    }

    public fn to_string(self) -> string {
        if (self.ptr == null) { return ""; }
        return from_cstr(self.ptr);
    }
}

/// Owned NUL-terminated C string. `drop` frees the buffer.
public class CString {
    public ptr: rawptr;

    public static fn from_string(s: string) -> CString {
        let src = s.c_str();
        let n = strlen(src);
        let p = malloc(n + 1);
        if (p != null) {
            memcpy(p, src, n);
            memset(ptr_offset(p, n as i32), 0, 1);
        }
        return CString { ptr: p };
    }

    public fn as_ptr(self) -> rawptr {
        return self.ptr;
    }

    public fn as_c_str(self) -> CStr {
        return CStr { ptr: self.ptr };
    }

    public fn to_string(self) -> string {
        if (self.ptr == null) { return ""; }
        return from_cstr(self.ptr);
    }

    public fn drop() {
        if (self.ptr != null) {
            free(self.ptr);
            self.ptr = null;
        }
    }
}
