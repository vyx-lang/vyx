module std.collections;

/// Vyx Standard Library — Tuple3<A,B,C> / Tuple4<A,B,C,D>
///
/// Heterogeneous 3- and 4-element tuples. `Tuple2` is intentionally provided
/// by `std/pair.vyx` (as `Pair<A,B>`) so we do not duplicate it here; use
/// `Pair` whenever you need a 2-tuple.
///
/// Fields are named `e0` / `e1` / `e2` / `e3` (Rust-style `.0`/`.1` is not
/// yet surfaced in syntax; using identifier fields keeps literal construction
/// and access uniform across all std containers).
///
/// `new` / `make` are identical-behaviour convenience constructors.
/// `eq` is byte-wise per-slot equality (same semantics as `Pair.eq`).
/// `clone` copies all slots by value.
/// `fmt` produces `"Tuple(e0, e1, …)"` via Vyx string interpolation; meant for
/// debugging and only compiles for payloads that are interpolation-convertible
/// (primitives, `string`).

extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memcmp(a: rawptr, b: rawptr, n: i64) -> i32;
}

public class Tuple3<A, B, C> {
    public e0: A;
    public e1: B;
    public e2: C;

    public static fn new(a: A, b: B, c: C) -> Tuple3<A, B, C> {
        return Tuple3 { e0: a, e1: b, e2: c };
    }

    public static fn make(a: A, b: B, c: C) -> Tuple3<A, B, C> {
        return Tuple3 { e0: a, e1: b, e2: c };
    }

    public fn eq(other: Tuple3<A, B, C>) -> bool {
        let sa = sizeof::<A>();
        let sb = sizeof::<B>();
        let sc = sizeof::<C>();
        if (!_tuple_slot_eq(to_rawptr(&self.e0), to_rawptr(&other.e0), sa)) { return false; }
        if (!_tuple_slot_eq(to_rawptr(&self.e1), to_rawptr(&other.e1), sb)) { return false; }
        return _tuple_slot_eq(to_rawptr(&self.e2), to_rawptr(&other.e2), sc);
    }

    /// Memberwise (shallow) copy of the three fields. Same caveat as
    /// `Pair.clone`: not a recursive deep clone. If any element type
    /// owns heap, call `.clone()` per-field and construct manually.
    /// See std/clone.vyx and std/pair.vyx:`Pair.clone` for context.
    public fn clone() -> Tuple3<A, B, C> {
        return Tuple3 { e0: self.e0, e1: self.e1, e2: self.e2 };
    }

    public fn fmt() -> string {
        return "Tuple(${self.e0}, ${self.e1}, ${self.e2})";
    }
}

public class Tuple4<A, B, C, D> {
    public e0: A;
    public e1: B;
    public e2: C;
    public e3: D;

    public static fn new(a: A, b: B, c: C, d: D) -> Tuple4<A, B, C, D> {
        return Tuple4 { e0: a, e1: b, e2: c, e3: d };
    }

    public static fn make(a: A, b: B, c: C, d: D) -> Tuple4<A, B, C, D> {
        return Tuple4 { e0: a, e1: b, e2: c, e3: d };
    }

    public fn eq(other: Tuple4<A, B, C, D>) -> bool {
        let sa = sizeof::<A>();
        let sb = sizeof::<B>();
        let sc = sizeof::<C>();
        let sd = sizeof::<D>();
        if (!_tuple_slot_eq(to_rawptr(&self.e0), to_rawptr(&other.e0), sa)) { return false; }
        if (!_tuple_slot_eq(to_rawptr(&self.e1), to_rawptr(&other.e1), sb)) { return false; }
        if (!_tuple_slot_eq(to_rawptr(&self.e2), to_rawptr(&other.e2), sc)) { return false; }
        return _tuple_slot_eq(to_rawptr(&self.e3), to_rawptr(&other.e3), sd);
    }

    /// Memberwise (shallow) copy of the four fields. Same caveat as
    /// Tuple3.clone / Pair.clone — not a recursive deep clone.
    /// See std/clone.vyx.
    public fn clone() -> Tuple4<A, B, C, D> {
        return Tuple4 { e0: self.e0, e1: self.e1, e2: self.e2, e3: self.e3 };
    }

    public fn fmt() -> string {
        return "Tuple(${self.e0}, ${self.e1}, ${self.e2}, ${self.e3})";
    }
}

/// Internal byte-wise slot comparison. Shared by Tuple3/Tuple4 (and by users
/// who want to implement custom N-tuples). Small slots (<=8 bytes) are read
/// into an i64 and compared as integers; larger slots fall back to memcmp.
fn _tuple_slot_eq(a: rawptr, b: rawptr, size: i64) -> bool {
    if (size <= 8) {
        var av: i64 = 0;
        var bv: i64 = 0;
        memcpy(to_rawptr(&av), a, size);
        memcpy(to_rawptr(&bv), b, size);
        return av == bv;
    }
    return memcmp(a, b, size) == 0;
}
