module std.channel;

/// Vyx Standard Library — Channel (thread-safe message passing)
/// Provides both generic class API and legacy function API for compatibility.

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
}

// ---------- Generic class API ----------
class Channel<T> {
    public buffer: rawptr;
    public cap: i64;
    public head: i64;
    public tail: i64;
    public count: i64;

    public static fn new() -> Channel<T> {
        return Channel.withCapacity(256);
    }

    public static fn withCapacity(c: i64) -> Channel<T> {
        var cap = c;
        if (cap < 4) { cap = 4; }
        let buf = malloc(cap * 8);
        if (buf != null) { memset(buf, 0, cap * 8); }
        return Channel { buffer: buf, cap: cap, head: 0, tail: 0, count: 0 };
    }

    fn send(val: T) -> bool {
        if (self.count >= self.cap) { return false; }
        memcpy(self.buffer + self.tail * 8, to_rawptr(&val), 8);
        self.tail = (self.tail + 1) % self.cap;
        self.count = self.count + 1;
        return true;
    }

    fn recv() -> i64 {
        if (self.count == 0) { return 0; }
        var out: i64 = 0;
        memcpy(to_rawptr(&out), self.buffer + self.head * 8, 8);
        self.head = (self.head + 1) % self.cap;
        self.count = self.count - 1;
        return out;
    }

    fn len() -> i64 { return self.count; }
    fn isEmpty() -> bool { return self.count == 0; }
    fn isFull() -> bool { return self.count >= self.cap; }

    fn destroy() {
        if (self.buffer != null) { free(self.buffer); }
        self.buffer = null;
        self.cap = 0;
        self.head = 0;
        self.tail = 0;
        self.count = 0;
    }

    /// SSS Drop — idempotent via `self.buffer == null` sentinel.
    fn drop() { self.destroy(); }
}

// ---------- Legacy function API ----------

struct _Channel {
    buffer: rawptr;
    cap: i64;
    head: i64;
    tail: i64;
    count: i64;
}

public fn channel_new() -> _Channel {
    return channel_with_capacity(256);
}

public fn channel_with_capacity(cap: i64) -> _Channel {
    var c = cap;
    if (c < 4) { c = 4; }
    unsafe {
        let buf = malloc(c * 8);
        memset(buf, 0, c * 8);
        return _Channel { buffer: buf, cap: c, head: 0, tail: 0, count: 0 };
    }
}

public fn channel_send(ch: rawptr, val: i64) -> bool {
    unsafe {
        var count: i64 = 0;
        var cap: i64 = 0;
        var tail: i64 = 0;
        var buf: rawptr = null;
        memcpy(to_rawptr(&buf), ch, 8);
        memcpy(to_rawptr(&cap), ch + 8, 8);
        memcpy(to_rawptr(&tail), ch + 24, 8);
        memcpy(to_rawptr(&count), ch + 32, 8);
        if (count >= cap) { return false; }
        memcpy(buf + tail * 8, to_rawptr(&val), 8);
        tail = (tail + 1) % cap;
        count = count + 1;
        memcpy(ch + 24, to_rawptr(&tail), 8);
        memcpy(ch + 32, to_rawptr(&count), 8);
        return true;
    }
}

public fn channel_recv(ch: rawptr) -> i64 {
    unsafe {
        var count: i64 = 0;
        var cap: i64 = 0;
        var head: i64 = 0;
        var buf: rawptr = null;
        memcpy(to_rawptr(&buf), ch, 8);
        memcpy(to_rawptr(&cap), ch + 8, 8);
        memcpy(to_rawptr(&head), ch + 16, 8);
        memcpy(to_rawptr(&count), ch + 32, 8);
        if (count == 0) { return 0; }
        var val: i64 = 0;
        memcpy(to_rawptr(&val), buf + head * 8, 8);
        head = (head + 1) % cap;
        count = count - 1;
        memcpy(ch + 16, to_rawptr(&head), 8);
        memcpy(ch + 32, to_rawptr(&count), 8);
        return val;
    }
}

public fn channel_len(ch: rawptr) -> i64 {
    unsafe {
        var count: i64 = 0;
        memcpy(to_rawptr(&count), ch + 32, 8);
        return count;
    }
}

public fn channel_is_empty(ch: rawptr) -> bool {
    return channel_len(ch) == 0;
}

public fn channel_is_full(ch: rawptr) -> bool {
    unsafe {
        var count: i64 = 0;
        var cap: i64 = 0;
        memcpy(to_rawptr(&count), ch + 32, 8);
        memcpy(to_rawptr(&cap), ch + 8, 8);
        return count >= cap;
    }
}

public fn channel_free(ch: rawptr) {
    unsafe {
        var buf: rawptr = null;
        memcpy(to_rawptr(&buf), ch, 8);
        if (buf != null) { free(buf); }
        memset(ch, 0, 40);
    }
}
