module std.core;

use std.defaults;

/// Option<T> — nullable value type (like Rust's Option<T>)
/// Some(T) contains a value, None represents absence.
@[c_repr]
@[lang_item("option")]
enum Option<T> {
    Some(T),
    None,

    fn isSome() -> bool {
        match (self) {
            case Some(_) => { return true; }
            default => { return false; }
        }
    }
    // snake_case alias — matches both conventions user code may spell.
    fn is_some() -> bool { return self.isSome(); }

    fn isNone() -> bool {
        match (self) {
            case None => { return true; }
            default => { return false; }
        }
    }
    fn is_none() -> bool { return self.isNone(); }

    fn unwrap() -> T {
        match (self) {
            case Some(v) => { return v; }
            default => { panic("called unwrap() on None"); }
        }
    }

    fn unwrap_or(default_val: T) -> T {
        match (self) {
            case Some(v) => { return v; }
            default => { return default_val; }
        }
    }
    fn unwrapOr(default_val: T) -> T { return self.unwrap_or(default_val); }

    fn map<U>(f: fn(T) -> U) -> Option<U> {
        match (self) {
            case Some(v) => { return Some(f(v)); }
            default => { return None; }
        }
    }

    fn and_then<U>(f: fn(T) -> Option<U>) -> Option<U> {
        match (self) {
            case Some(v) => { return f(v); }
            default => { return None; }
        }
    }
    fn andThen<U>(f: fn(T) -> Option<U>) -> Option<U> { return self.and_then::<U>(f); }

    fn or_else(f: fn() -> Option<T>) -> Option<T> {
        match (self) {
            case Some(v) => { return Some(v); }
            default => { return f(); }
        }
    }
    // Value-taking variant: `orElse(default_opt)` — if self is None, return
    // the provided Option<T> directly, no lazy closure needed.
    fn orElse<U>(alt: Option<T>) -> Option<T> {
        match (self) {
            case Some(v) => { return Some(v); }
            default => { return alt; }
        }
    }

    fn filter(pred: fn(T) -> bool) -> Option<T> {
        match (self) {
            case Some(v) => {
                if (pred(v)) { return Some(v); }
                return None;
            }
            default => { return None; }
        }
    }
}

impl Default for Option<T> {
    static fn default_value() -> Option<T> {
        return None;
    }
}
