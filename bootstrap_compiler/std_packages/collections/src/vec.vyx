module std.collections;

use std.defaults;
use std.string;
use std.clone;
use std.hash;

/// Vyx Standard Library — Vec<T>
/// True generic dynamic array — stores elements at their actual size.
/// For i32: 4 bytes/elem, for i64: 8 bytes, for string: 32 bytes, etc.
///
/// Safety tiers (opt-in philosophy — defaults cost cycles, fast path available):
///   - Checked:   `push` / `get` / `set` / `pop` — UAF guard + bounds
///                + iter-invalidation bump. Default; correct by construction.
///   - Unchecked: `push_unchecked` / `get_unchecked` / `set_unchecked`
///                — zero-cost. Caller owns every invariant: capacity
///                pre-reserved, no concurrent iterators, Vec not
///                destroyed. Bump-less: in-flight iterators will NOT
///                observe writes made via these methods. Use in inner
///                loops where the caller has already proved safety.
///   - Concurrent: wrap with `ConcurrentVec<T>` (std/concurrent.vyx).
///                Mutex per container, coarse but correct under threads.

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn realloc(ptr: rawptr, size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
    fn memmove(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memcmp(a: rawptr, b: rawptr, n: i64) -> i32;
}

// A removed slot relinquishes ownership. Primitive str has a tagged free
// function; a pointer read alone does not establish a fresh lexical owner.
// Consuming a slot must not copy-retain a Ref handle. The raw read is
// returned as a value, then owned by the destruction scope below. Its caller
// relinquishes the source slot and must not destroy that slot a second time.
fn vec_take_stored_value<T>(slot: *T) -> T {
    var value: T;
    memcpy(to_rawptr(&value), to_rawptr(slot), sizeof::<T>());
    return value;
}

fn vec_drop_stored_value<T>(slot: *T) {
    let value: T = vec_take_stored_value::<T>(slot);
}

fn vec_drop_stored_value<str>(slot: *str) {
    str_drop(*slot);
}

@[lang_item("vec")]
class Vec<T> : Iterable {
    public data: rawptr;
    public len: i64;
    public cap: i64;
    public elem_size: i64;
    // Structural-mutation counter. Incremented by push/pop/insert/remove/
    // clear/set whenever the backing array or logical size changes. Iter
    // captures a snapshot + a pointer here; Iter.next() compares and
    // panics on mismatch so stale iterators don't silently read dangling
    // data (the realloc hazard).
    public gen: i64;

    /// Panic with a clear message when a user operation runs on a Vec
    /// whose backing buffer has already been freed via `.destroy()`.
    /// Without this check, post-destroy push/get/set silently wrote to
    /// (or read from) dangling memory — classic UAF.
    fn _check_alive(&self) {
        if (self.data == null && self.cap == 0) {
            panic("Vec: use-after-destroy");
        }
    }

    /// Construction helpers. The
    /// `vector(n)` / `vector(n, val)` forms get dedicated names:
    ///   - `new()`          — empty vec with default capacity (16).
    ///   - `zeroed(n)`      — `vector(n)`: n default-initialized elements.
    ///   - `filled(n, val)` — `vector(n, val)`: n copies of `val`.
    ///   - `from_array(arr, n)` — copies n elements from a raw array.
    public static fn new() -> Vec<T> {
        let es = sizeof::<T>();
        let c: i64 = 16;
        let d = malloc(c * es);
        if (d == null) { panic("Vec: allocation failed"); }
        memset(d, 0, c * es);
        return Vec::<T> { data: d, len: 0, cap: c, elem_size: es, gen: 0 };
    }

    /// `vector(n)`: n default-initialized elements.
    @[lazy]
    public static fn zeroed(n: i64) -> Vec<T> where T: Default {
        if (n < 0) { panic("Vec: negative length"); }
        var out = Vec::<T>.with_capacity(n);
        var i: i64 = 0;
        while (i < n) { out.push_unchecked(T::default_value()); i += 1; }
        return out;
    }

    /// `vector(n, val)` for any element type: n copies of `val`.
    @[lazy]
    @[borrow_args]
    public static fn filled(n: i64, val: T) -> Vec<T> where T: Clone {
        let es = sizeof::<T>();
        var c = n;
        if (c < 0) { c = 0; }
        var out = Vec::<T>::with_capacity(c);
        var i: i64 = 0;
        while (i < c) {
            out.push_unchecked(val.clone());
            i = i + 1;
        }
        out.gen = out.gen + 1;
        return out;
    }

    /// Clone `n` elements from a typed array. Indexing `arr[i]` uses T's
    /// element size and each owning value receives an independent clone.
    /// The caller must supply a valid raw range of n elements.
    @[lazy]
    public static fn from_array(arr: *T, n: i64) -> Vec<T> where T: Clone {
        var count = n;
        if (arr == null || count <= 0) { return Vec::<T>::new(); }
        var out = Vec::<T>::with_capacity(count);
        var i: i64 = 0;
        while (i < count) {
            // The caller supplies a valid raw range of count elements.
            unsafe { out.push_unchecked(arr[i].clone()); }
            i = i + 1;
        }
        out.gen = out.gen + 1;
        return out;
    }

    /// `resize(n, val)`: grow fills new slots with `val`, shrink truncates.
    /// Matches C++ `vector::resize(n, val)`.
    @[lazy]
    @[borrow_args]
    public fn resize(n: i64, val: T) where T: Clone {
        self._check_alive();
        if (n < 0) { panic("Vec.resize: negative length"); }
        if (n < self.len) {
            var i = self.len;
            while (i > n) {
                i -= 1;
                self._drop_slot(i);
            }
            self.len = n;
            self.gen = self.gen + 1;
            return;
        }
        if (n == self.len) { return; }
        self.ensure_capacity(n);
        var i = self.len;
        while (i < n) {
            self.push_unchecked(val.clone());
            i = i + 1;
        }
        self.len = n;
        self.gen = self.gen + 1;
    }

    @[inline]
    public static fn with_capacity(cap: i64) -> Vec<T> {
        let es = sizeof::<T>();
        var c = cap;
        if (c < 4) { c = 4; }
        if (es > 0 && c > 9223372036854775807 / es) { panic("Vec: allocation size overflow"); }
        let d = malloc(c * es);
        if (d == null) { panic("Vec: allocation failed"); }
        return Vec::<T> { data: d, len: 0, cap: c, elem_size: es, gen: 0 };
    }

    public fn ensure_capacity(min_cap: i64) {
        // Negative request usually means i64 overflow in caller
        // arithmetic (e.g. `self.len + huge_value`). Reject up-front so
        // the "cap already >= min_cap" fast-path below doesn't silently
        // swallow the bug.
        if (min_cap < 0) { panic("Vec: capacity request overflowed i64"); }
        if (self.cap >= min_cap) { return; }
        var nc = self.cap;
        if (nc <= 0) { nc = 16; }
        while (nc < min_cap) {
            // Doubling-until-overflow guard: MAX_I64 / 2 = 4611686018427387903.
            if (nc > 4611686018427387903) {
                panic("Vec: capacity doubling overflowed i64");
            }
            nc = nc * 2;
        }
        // Element-size × capacity can still overflow even when min_cap fits.
        let es = sizeof::<T>();
        if (es > 0 && nc > 9223372036854775807 / es) {
            panic("Vec: nc * elem_size overflowed i64");
        }
        let nd = realloc(self.data, nc * es);
        if (nd == null) { panic("Vec: allocation failed"); }
        self.data = nd;
        self.cap = nc;
        self.gen = self.gen + 1;  // realloc invalidates live iterators
    }

    @[inline]
    public fn push(val: T) {
        self._check_alive();
        self.ensure_capacity(self.len + 1);
        let es = sizeof::<T>();
        let slot = self.data + self.len * es;
        unsafe { *(slot as *T) = val; }
        self.len = self.len + 1;
        self.gen = self.gen + 1;
    }

    /// Hot-path push for benchmarks or known-safe code paths.
    /// Skips the use-after-destroy check AND the gen bump (so any
    /// outstanding iterator won't see this modification). Caller is
    /// responsible for: (1) no concurrent iterators, (2) capacity
    /// already ensured, (3) Vec not destroyed. Use with care — this
    /// is the "zero-cost" tier.
    @[inline]
    public fn push_unchecked(val: T) {
        let es = sizeof::<T>();
        let slot = self.data + self.len * es;
        unsafe { *(slot as *T) = val; }
        self.len = self.len + 1;
    }

    public fn iter(&self) -> Iterator<T> {
        return Iterator::<T> {
            data: self.data, len: self.len, pos: 0,
            source_gen: to_rawptr(&self.gen),
            gen_snapshot: self.gen, owns_data: false
        };
    }

    /// Element access. The returned T is an *owned* value: for elements
    /// with heap storage (string, Vec, Box, ...) the element's Clone impl
    /// deep-copies so the result does not alias `self.data`. This matches
    /// the move-by-default ownership contract — every rvalue of an owning
    /// type must own its bytes — and lets consumers (interpolation, print)
    /// release the temporary without corrupting the vec slot.
    ///
    /// `@[lazy]` keeps the `e.clone()` requirement out of programs whose
    /// element types have no Clone impl; see std/clone.vyx for the two
    /// clone contracts and std/vec.vyx `clone()` for the same pattern.
    @[lazy]
    public fn get(&self, idx: i64) -> T where T: Clone {
        self._check_alive();
        if (idx < 0 || idx >= self.len) { panic("Vec.get out of bounds"); }
        let slot = (self.data + idx * sizeof::<T>()) as *T;
        return (*slot).clone();
    }

    /// Same ownership contract as `get`: returns an owned copy.
    @[inline]
    @[lazy]
    public fn get_unchecked(&self, idx: i64) -> T where T: Clone {
        let slot = (self.data + idx * sizeof::<T>()) as *T;
        return (*slot).clone();
    }

    /// Borrows an element without cloning it. The Vec must remain alive
    /// and its storage must not be resized while the reference is used.
    public fn get_ref(&self, idx: i64) -> &T {
        self._check_alive();
        if (idx < 0 || idx >= self.len) { panic("Vec.get_ref out of bounds"); }
        let slot = (self.data + idx * sizeof::<T>()) as *T;
        return &*slot;
    }

    /// Borrows a stored element for mutation without cloning or replacing it.
    public fn get_mut(&mut self, idx: i64) -> &mut T {
        self._check_alive();
        if (idx < 0 || idx >= self.len) { panic("Vec.get_mut out of bounds"); }
        let slot = (self.data + idx * sizeof::<T>()) as *T;
        return &mut *slot;
    }

    /// Returns a pointer to the element at idx, avoiding memcpy.
    public fn get_ptr(&self, idx: i64) -> *T {
        if (idx < 0 || idx >= self.len) { panic("Vec.get_ptr out of bounds"); }
        return (self.data + idx * sizeof::<T>()) as *T;
    }

    /// Index operator. Returns an element reference so `v[i]` can be
    /// used both for reads and as an assignment target.
    /// Index operator. Returns a mutable reference view: `v[i]` reads like
    /// the element, `v[i] = x` writes through the reference, and the
    /// declared type stays WYSIWYG (`typeof(v[i])` is `&mut T`).
    public fn operator[](&mut self, idx: i64) -> &mut T {
        let p = self.get_ptr(idx);
        return &mut p[0];
    }

    public fn set(idx: i64, val: T) {
        self._check_alive();
        if (idx < 0 || idx >= self.len) { panic("Vec.set out of bounds"); }
        self._drop_slot(idx);
        let es = sizeof::<T>();
        let slot = self.data + idx * es;
        unsafe { *(slot as *T) = val; }
    }

    /// Zero-cost set — no bounds check, no UAF check. Caller owns the
    /// invariants. Same opt-out tier as `get_unchecked` / `push_unchecked`.
    @[inline]
    public fn set_unchecked(idx: i64, val: T) {
        self._drop_slot(idx);
        let es = sizeof::<T>();
        let slot = self.data + idx * es;
        unsafe { *(slot as *T) = val; }
    }

    public fn pop() -> T {
        self._check_alive();
        if (self.len <= 0) { panic("Vec.pop from empty vec"); }
        self.len = self.len - 1;
        self.gen = self.gen + 1;
        let slot = self.data + self.len * sizeof::<T>();
        var out: T;
        memcpy(to_rawptr(&out), slot, sizeof::<T>());
        return out;
    }

    public fn clear() {
        var i = self.len;
        while (i > 0) {
            i -= 1;
            self._drop_slot(i);
        }
        self.len = 0;
        self.gen = self.gen + 1;
    }

    // Release the stored T before reusing the slot or freeing the buffer.
    fn _drop_slot(idx: i64) {
        let slot = (self.data + idx * sizeof::<T>()) as *T;
        vec_drop_stored_value::<T>(slot);
    }
    @[inline]
    public fn isEmpty(&self) -> bool { return self.len == 0; }
    @[inline]
    public fn length(&self) -> i64 { return self.len; }
    @[inline]
    public fn size(&self) -> i64 { return self.len; }
    @[inline]
    public fn count(&self) -> i64 { return self.len; }
    @[inline]
    public fn capacity(&self) -> i64 { return self.cap; }

    public fn first(&self) -> T {
        if (self.len <= 0) { panic("Vec.first on empty vec"); }
        return self.get_unchecked(0);
    }

    public fn last(&self) -> T {
        if (self.len <= 0) { panic("Vec.last on empty vec"); }
        return self.get_unchecked(self.len - 1);
    }

    public fn reserve(min_cap: i64) { self.ensure_capacity(min_cap); }

    public fn shrink_to_fit() {
        if (self.len >= self.cap) { return; }
        var nc = self.len;
        if (nc < 4) { nc = 4; }
        let nd = realloc(self.data, nc * self.elem_size);
        if (nd == null) { panic("Vec: allocation failed"); }
        self.data = nd;
        self.cap = nc;
        self.gen = self.gen + 1;  // realloc invalidates live iterators
    }

    /// Membership uses T's Eq implementation and borrows the needle.
    @[lazy]
    @[borrow_args]
    public fn contains(&self, val: T) -> bool where T: Eq {
        return self.indexOf(val) >= 0;
    }

    @[lazy]
    @[borrow_args]
    public fn indexOf(&self, val: T) -> i64 where T: Eq {
        self._check_alive();
        var i: i64 = 0;
        while (i < self.len) {
            let slot = (self.data + i * sizeof::<T>()) as *T;
            if ((*slot).operator_eq(val)) { return i; }
            i += 1;
        }
        return -1;
    }

    /// Compatibility reduction: convert each numeric element to i64, then
    /// sum in i64. Floating values truncate per element. For a typed numeric
    /// reduction use std.algorithm.sum_iter (Zero + Add).
    @[lazy]
    public fn sum(&self) -> i64 where T: Copy {
        self._check_alive();
        var total: i64 = 0;
        var i: i64 = 0;
        while (i < self.len) {
            let slot = (self.data + i * sizeof::<T>()) as *T;
            total += (*slot) as i64;
            i += 1;
        }
        return total;
    }

    public fn remove(idx: i64) -> T { return self.removeAt(idx); }

    public fn insert(idx: i64, val: T) {
        self._check_alive();
        if (idx < 0 || idx > self.len) { panic("Vec.insert out of bounds"); }
        self.ensure_capacity(self.len + 1);
        let es = sizeof::<T>();
        if (idx < self.len) {
            let src = self.data + idx * es;
            let dst = self.data + (idx + 1) * es;
            let bytes = (self.len - idx) * es;
            memmove(dst, src, bytes);
        }
        let slot = self.data + idx * es;
        unsafe { *(slot as *T) = val; }
        self.len = self.len + 1;
        self.gen = self.gen + 1;
    }

    public fn removeAt(idx: i64) -> T {
        self._check_alive();
        if (idx < 0 || idx >= self.len) { panic("Vec.removeAt out of bounds"); }
        let es = sizeof::<T>();
        let slot = self.data + idx * es;
        var out: T;
        memcpy(to_rawptr(&out), slot, es);
        self.len = self.len - 1;
        if (idx < self.len) {
            let src = self.data + (idx + 1) * es;
            let dst = self.data + idx * es;
            let bytes = (self.len - idx) * es;
            memmove(dst, src, bytes);
        }
        self.gen = self.gen + 1;
        return out;
    }

    /// Zero-allocation swap: uses 8-byte chunk swapping on the stack.
    @[inline]
    public fn swap(i: i64, j: i64) {
        self._check_alive();
        if (i < 0 || j < 0 || i >= self.len || j >= self.len) { panic("Vec.swap out of bounds"); }
        if (i == j) { return; }
        self._swap_unchecked(i, j);
        self.gen += 1;
    }

    fn _swap_unchecked(i: i64, j: i64) {
        let es = sizeof::<T>();
        let si = self.data + i * es;
        let sj = self.data + j * es;
        var off: i64 = 0;
        while (off + 8 <= es) {
            var tmp: i64 = 0;
            memcpy(to_rawptr(&tmp), si + off, 8);
            memcpy(si + off, sj + off, 8);
            memcpy(sj + off, to_rawptr(&tmp), 8);
            off = off + 8;
        }
        while (off < es) {
            var tmp: i64 = 0;
            memcpy(to_rawptr(&tmp), si + off, 1);
            memcpy(si + off, sj + off, 1);
            memcpy(sj + off, to_rawptr(&tmp), 1);
            off = off + 1;
        }
    }

    public fn reverse() {
        var lo: i64 = 0;
        var hi = self.len - 1;
        while (lo < hi) {
            self.swap(lo, hi);
            lo = lo + 1;
            hi = hi - 1;
        }
    }

    /// In-place heapsort. Comparisons use T's Ord, never its layout or
    /// address. No element is cloned or destroyed while slots are swapped.
    /// O(n log n) worst-case comparisons, O(1) auxiliary storage; unstable.
    @[lazy]
    public fn sort() where T: Ord {
        self._check_alive();
        if (self.len <= 1) { return; }
        var parent = self.len / 2;
        while (parent > 0) { parent -= 1; self._sift_typed(parent, self.len); }
        var end = self.len;
        while (end > 1) {
            end -= 1;
            self._swap_unchecked(0, end);
            self._sift_typed(0, end);
        }
        self.gen += 1;
    }

    @[lazy]
    fn _sift_typed(start: i64, end: i64) where T: Ord {
        var parent = start;
        while (parent < end / 2) {
            var child = parent * 2 + 1;
            if (child + 1 < end) {
                let left = (self.data + child * sizeof::<T>()) as *T;
                let right = (self.data + (child + 1) * sizeof::<T>()) as *T;
                if ((*left).compare(*right) < 0) { child += 1; }
            }
            let root = (self.data + parent * sizeof::<T>()) as *T;
            let candidate = (self.data + child * sizeof::<T>()) as *T;
            if ((*root).compare(*candidate) >= 0) { return; }
            self._swap_unchecked(parent, child);
            parent = child;
        }
    }

    /// Destroys live owning elements, then frees the backing buffer.
    /// Idempotent: safe to call multiple times (second call is a no-op).
    public fn destroy() {
        if (to_rawptr(self) == null) { return; }
        self.clear();
        if (self.data != null) { free(self.data); }
        self.data = null;
        self.len = 0;
        self.cap = 0;
    }

    /// Releases live elements and storage at scope exit. Moved Vec values
    /// relinquish this lifecycle to their destination.
    public fn drop() {
        if (to_rawptr(self) == null) { return; }
        self.destroy();
    }

    @[lazy]
    @[borrow_args]
    public fn operator_eq(&self, other: Vec<T>) -> bool where T: Eq {
        self._check_alive(); other._check_alive();
        if (self.len != other.len) { return false; }
        var i: i64 = 0;
        while (i < self.len) {
            let left = (self.data + i * sizeof::<T>()) as *T;
            let right = (other.data + i * sizeof::<T>()) as *T;
            if (!(*left).operator_eq(*right)) { return false; }
            i += 1;
        }
        return true;
    }

    @[lazy]
    public fn hash(&self) -> i64 where T: Hashable {
        self._check_alive();
        var result: i64 = -3750763034362895579;
        var i: i64 = 0;
        while (i < self.len) {
            let slot = (self.data + i * sizeof::<T>()) as *T;
            result = (result ^ (*slot).hash()) * 1099511628211;
            i += 1;
        }
        return result;
    }
}

impl<T> Eq for Vec<T> where T: Eq {}
impl<T> Hashable for Vec<T> where T: Hashable {}

impl Default for Vec<T> {
    static fn default_value() -> Vec<T> {
        return Vec::<T>.new();
    }
}

/// Copies each element into independent storage. Vec<T> remains usable
/// with non-Clone elements; only this operation requires T: Clone.
impl<T> Clone for Vec<T> where T: Clone {
    @[lazy]
    public fn clone(&self) -> Vec<T> where T: Clone {
        var out = Vec::<T>.with_capacity(self.len);
        var i: i64 = 0;
        while (i < self.len) {
            out.push(self.get(i));
            i = i + 1;
        }
        return out;
    }
}

/// Splitting extension for the primitive text type.
///
/// This lives here rather than in `std.string` because it hands back a
/// `Vec<string>` and `std.collections` already depends on `std.string` —
/// adding the reverse edge would make the dependency graph cyclic.
trait StrSplitExt {
    fn split(delim: str) -> Vec<string>;
}

impl StrSplitExt for str {
    /// Split on every occurrence of `delim`, keeping empty pieces, so
    /// `"a||b"` yields three parts and `"a|"` yields two.  Semantics match
    /// `std.algorithm::str_split`, including the degenerate cases: an empty
    /// delimiter or an empty subject returns the subject itself as a single
    /// element.
    fn split(delim: str) -> Vec<string> {
        var out = Vec::<string>.new();
        let dlen = delim.len;
        let slen = self.len;
        if (dlen == 0 || slen == 0) {
            out.push(self);
            return out;
        }
        var cursor: i64 = 0;
        while (true) {
            let rest = str_substring(self, cursor, slen);
            let rel = str_index_of(rest, delim);
            if (rel < 0) {
                out.push(rest);
                break;
            }
            let found = cursor + rel;
            out.push(str_substring(self, cursor, found));
            cursor = found + dlen;
        }
        return out;
    }
}
