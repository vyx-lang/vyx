module std.collections;

use std.core;
use std.dict;

/// Vyx Standard Library — HashSet<T>
///
/// Hash-based set with O(1) expected add/contains/remove.
///
/// Implemented as a thin wrapper around `Dict<T, bool>`: each element maps
/// to the sentinel value `true`; presence is tested via `Dict.contains`.
///
/// Kept alongside `std/set.vyx` (legacy linear probe) for compatibility;
/// new code should prefer `HashSet<T>`.

class HashSet<T> where T: Hashable + Eq {
    public inner: Dict<T, bool>;

    public static fn new() -> HashSet<T> {
        return HashSet { inner: Dict::<T, bool>.new() };
    }

    public static fn with_capacity(min_cap: i64) -> HashSet<T> {
        return HashSet { inner: Dict::<T, bool>.with_capacity(min_cap) };
    }

    /// Inserts `t`. Returns true when a new element was inserted,
    /// false when `t` was already present (no-op).
    public fn add(t: T) -> bool {
        if (self.inner.contains(t)) { return false; }
        self.inner.put(t, true);
        return true;
    }

    @[borrow_args]
    public fn contains(t: T) -> bool {
        return self.inner.contains(t);
    }

    @[borrow_args]
    public fn remove(t: T) -> bool {
        return self.inner.remove(t);
    }

    public fn len() -> i64 { return self.inner.len; }
    public fn size() -> i64 { return self.inner.len; }
    public fn count() -> i64 { return self.inner.len; }
    public fn isEmpty() -> bool { return self.inner.len == 0; }

    public fn clear() {
        self.inner.clear();
    }

    /// Iterate members. Order is unspecified (hash-table storage order).
    /// Inherits invalidation checks from the wrapped Dict's iterator.
    public fn iter() -> DictEntryIterator {
        return self.inner.iter();
    }

    /// Snapshot members as a Vec<T>. Useful when callers want a
    /// stable-order collection they can mutate freely.
    public fn to_vec() -> Vec<T> {
        return self.inner.keys();
    }

    public fn destroy() {
        self.inner.destroy();
    }

    /// SSS Drop — delegates to inner Dict.
    public fn drop() {
        self.inner.drop();
    }

    /// Deep copy. Independent from `self`; mutating the result does
    /// not affect `self`. See std/clone.vyx Contract A.
    ///
    /// Delegates to the wrapped Dict's `clone()` so both the ctrl
    /// table and the key payloads are freshly allocated. Requires
    /// `T: Clone` at call time (value side is `bool`, trivially
    /// cloneable). Tagged `@[lazy]` so non-Clone T remains valid.
    @[lazy]
    public fn clone() -> HashSet<T> {
        return HashSet { inner: self.inner.clone() };
    }

    // ── BUG-LV-18: set algebra ──────────────────────────────────────────
    // union / intersect / diff / is_subset_of are required by the
    // language-validation suite (T5 case6_set_algebra) and were the
    // only set-algebra surface missing from the std API. All return
    // freshly-allocated HashSets — neither operand is consumed, so
    // operands remain valid for further use after the call (BUG-LV-19
    // borrow-style contract).

    /// Returns a new HashSet containing every element that appears in
    /// `self` OR in `other` (or both). Both operands keep ownership.
    @[borrow_args]
    public fn union(other: HashSet<T>) -> HashSet<T> {
        var out = HashSet::<T>.new();
        let a_keys = self.inner.keys();
        var i: i64 = 0;
        while (i < a_keys.len) { out.add(a_keys.get(i)); i = i + 1; }
        let b_keys = other.inner.keys();
        var j: i64 = 0;
        while (j < b_keys.len) { out.add(b_keys.get(j)); j = j + 1; }
        return out;
    }

    /// Returns a new HashSet containing every element that appears in
    /// BOTH `self` and `other`.
    @[borrow_args]
    public fn intersect(other: HashSet<T>) -> HashSet<T> {
        var out = HashSet::<T>.new();
        let a_keys = self.inner.keys();
        var i: i64 = 0;
        while (i < a_keys.len) {
            let k = a_keys.get(i);
            if (other.contains(k)) { out.add(k); }
            i = i + 1;
        }
        return out;
    }

    /// Returns a new HashSet containing every element that appears in
    /// `self` but NOT in `other` (set-theoretic difference `self \ other`).
    @[borrow_args]
    public fn diff(other: HashSet<T>) -> HashSet<T> {
        var out = HashSet::<T>.new();
        let a_keys = self.inner.keys();
        var i: i64 = 0;
        while (i < a_keys.len) {
            let k = a_keys.get(i);
            if (!other.contains(k)) { out.add(k); }
            i = i + 1;
        }
        return out;
    }

    /// True iff every element of `self` also appears in `other`.
    /// (Trivially true for the empty set.)
    @[borrow_args]
    public fn is_subset_of(other: HashSet<T>) -> bool {
        let a_keys = self.inner.keys();
        var i: i64 = 0;
        while (i < a_keys.len) {
            if (!other.contains(a_keys.get(i))) { return false; }
            i = i + 1;
        }
        return true;
    }
}
