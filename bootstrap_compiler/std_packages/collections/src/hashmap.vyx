module std.collections;

use std.defaults;
use std.core;
use std.dict;

extern "C" {
    fn vyx_dict_i64_i64_put(dict: rawptr, key: i64, val: i64);
    fn vyx_dict_i64_i64_try_get(dict: rawptr, key: i64, out: rawptr) -> i32;
    fn vyx_dict_str_i64_put(dict: rawptr, key: rawptr, len: i64, cap: i64, owned: i64, val: i64);
    fn vyx_dict_str_i64_try_get(dict: rawptr, key: rawptr, len: i64, out: rawptr) -> i32;
}

/// Vyx Standard Library — HashMap<K, V>
///
/// Generic hash table. Thin wrapper around `Dict<K, V>`, added so user
/// code can spell the name most languages use ("HashMap"). Previously
/// this file carried a hand-optimised SwissTable specialised to
/// (i64, i64) plus a parallel `StringMap` — with Dict now fully
/// generic, two implementations is just debt.
///
/// Usage:
///   var m = HashMap::<string, i64>.new();
///   m.put("x", 42);
///   match (m.try_get("x")) { case Some(v) => {}  case None => {} }

class HashMap<K, V> where K: Hashable + Eq {
    public inner: Dict<K, V>;

    public static fn new() -> HashMap<K, V> {
        return HashMap { inner: Dict::<K, V>.new() };
    }

    public static fn with_capacity(min_cap: i64) -> HashMap<K, V> {
        return HashMap { inner: Dict::<K, V>.with_capacity(min_cap) };
    }

    public fn put_i64_i64_fast(key: i64, val: i64) {
        vyx_dict_i64_i64_put(to_rawptr(&self.inner), key, val);
    }

    public fn put_str_i64_fast(key: str, val: i64) {
        vyx_dict_str_i64_put(to_rawptr(&self.inner), key.c_str(), key.len, key.cap, key.owned, val);
    }

    public fn put(key: K, val: V) { self.inner.put(key, val); }
    public fn insert(key: K, val: V) { self.inner.put(key, val); }
    public fn set(key: K, val: V) { self.inner.put(key, val); }

    @[borrow_args]
    public fn get(key: K) -> V where V: Default { return self.inner.get(key); }
    @[borrow_args]
    public fn get_ptr(key: K) -> *V where V: Default { return self.inner.get_ptr(key); }
    @[borrow_args]
    public fn operator[](&mut self, key: K) -> &mut V where V: Default { let p = self.inner.get_ptr(key); return &mut p[0]; }
    @[borrow_args]
    public fn try_get_i64_i64_fast(key: i64) -> Option<i64> {
        var out: i64 = 0;
        if (vyx_dict_i64_i64_try_get(to_rawptr(&self.inner), key, to_rawptr(&out)) != 0) {
            return Some(out);
        }
        return None;
    }
    @[borrow_args]
    public fn try_get_str_i64_fast(key: str) -> Option<i64> {
        var out: i64 = 0;
        if (vyx_dict_str_i64_try_get(to_rawptr(&self.inner), key.c_str(), key.len, to_rawptr(&out)) != 0) {
            return Some(out);
        }
        return None;
    }
    @[borrow_args]
    public fn try_get(key: K) -> Option<V> { return self.inner.try_get(key); }
    @[borrow_args]
    public fn contains(key: K) -> bool { return self.inner.contains(key); }
    @[borrow_args]
    public fn contains_key(key: K) -> bool { return self.inner.contains(key); }

    @[borrow_args]
    public fn remove(key: K) -> bool { return self.inner.remove(key); }

    public fn len() -> i64 { return self.inner.len; }
    public fn size() -> i64 { return self.inner.len; }
    public fn count() -> i64 { return self.inner.len; }
    public fn isEmpty() -> bool { return self.inner.len == 0; }

    public fn clear() { self.inner.clear(); }
    public fn destroy() {
        if (to_rawptr(self) == null) { return; }
        self.inner.destroy();
    }
    /// SSS Drop — delegates to inner Dict, which is idempotent.
    public fn drop() {
        if (to_rawptr(self) == null) { return; }
        self.inner.drop();
    }

    /// Deep copy. Independent from `self`; mutating the result does
    /// not affect `self`. See std/clone.vyx Contract A.
    ///
    /// Delegates to the wrapped Dict's `clone()` so both the ctrl
    /// table and the key/value payloads are freshly allocated.
    /// Requires `K: Clone` AND `V: Clone` at call time. Tagged
    /// `@[lazy]`.
    @[lazy]
    public fn clone() -> HashMap<K, V> {
        return HashMap { inner: self.inner.clone() };
    }

    public fn keys() -> Vec<K> { return self.inner.keys(); }
    public fn values() -> Vec<V> { return self.inner.values_vec(); }
    public fn iter() -> DictEntryIterator { return self.inner.iter(); }
}

/// `StringMap` kept as a convenience alias for the most common case.
/// Prefer `HashMap::<string, V>` in new code.
class StringMap<V> {
    public inner: Dict<string, V>;

    public static fn new() -> StringMap<V> {
        return StringMap { inner: Dict::<string, V>.new() };
    }

    public fn put(key: string, val: V) { self.inner.put(key, val); }
    public fn set(key: string, val: V) { self.inner.put(key, val); }
    @[borrow_args]
    public fn get(key: string) -> V where V: Default { return self.inner.get(key); }
    @[borrow_args]
    public fn get_ptr(key: string) -> *V where V: Default { return self.inner.get_ptr(key); }
    @[borrow_args]
    public fn operator[](&mut self, key: string) -> &mut V where V: Default { let p = self.inner.get_ptr(key); return &mut p[0]; }
    @[borrow_args]
    public fn try_get(key: string) -> Option<V> { return self.inner.try_get(key); }
    @[borrow_args]
    public fn contains(key: string) -> bool { return self.inner.contains(key); }
    @[borrow_args]
    public fn remove(key: string) -> bool { return self.inner.remove(key); }
    public fn len() -> i64 { return self.inner.len; }
    public fn isEmpty() -> bool { return self.inner.len == 0; }
    public fn clear() { self.inner.clear(); }
    public fn destroy() {
        if (to_rawptr(self) == null) { return; }
        self.inner.destroy();
    }
    /// SSS Drop — delegates to inner Dict.
    public fn drop() {
        if (to_rawptr(self) == null) { return; }
        self.inner.drop();
    }
}

impl Default for HashMap<K, V> where K: Hashable + Eq {
    static fn default_value() -> HashMap<K, V> {
        return HashMap::<K, V>.new();
    }
}

impl Default for StringMap<V> {
    static fn default_value() -> StringMap<V> {
        return StringMap::<V>.new();
    }
}
