module std.collections;

use std.clone;

/// Vyx Standard Library — List<T>
/// Doubly-linked list with heap-allocated nodes.
///
/// Each node contains two native-width links followed by a T-aligned payload.
/// The node allocation honors alignof<T>; link and payload offsets are
/// computed from pointer width and element alignment.
///
/// API: new, push_back, push_front, pop_back, pop_front, len, isEmpty,
///      front, back, clear, destroy.

extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn memset(dst: rawptr, val: i32, n: i64) -> rawptr;
    fn vyx_aligned_alloc_abi(size: i64, alignment: i64) -> rawptr;
    fn vyx_aligned_free_abi(ptr: rawptr);
}

fn list_payload_offset<T>() -> i64 {
    let header = 2 * sizeof::<rawptr>();
    let alignment = alignof::<T>();
    return ((header + alignment - 1) / alignment) * alignment;
}

class List<T> {
    public head: rawptr;
    public tail: rawptr;
    public len: i64;
    public elem_size: i64;
    // Structural-mutation counter, same as Vec/Dict/Deque. Bumped by
    // push_*/pop_*/clear so live iterators can detect mid-iteration
    // mutation.
    public gen: i64;

    public static fn new() -> List<T> {
        let es = sizeof::<T>();
        return List::<T> { head: null, tail: null, len: 0, elem_size: es, gen: 0 };
    }

    fn _alloc_node(val: T) -> rawptr {
        let offset = list_payload_offset::<T>();
        let total = offset + self.elem_size;
        let n = vyx_aligned_alloc_abi(total, alignof::<T>());
        if (n == null) { panic("List: node allocation failed"); }
        memset(n, 0, offset);
        unsafe { *((n + offset) as *T) = val; }
        return n;
    }

    fn _node_prev(n: rawptr) -> rawptr {
        var p: rawptr = null;
        memcpy(to_rawptr(&p), n, sizeof::<rawptr>());
        return p;
    }

    fn _node_next(n: rawptr) -> rawptr {
        var p: rawptr = null;
        memcpy(to_rawptr(&p), n + sizeof::<rawptr>(), sizeof::<rawptr>());
        return p;
    }

    fn _set_prev(n: rawptr, p: rawptr) {
        memcpy(n, to_rawptr(&p), sizeof::<rawptr>());
    }

    fn _set_next(n: rawptr, p: rawptr) {
        memcpy(n + sizeof::<rawptr>(), to_rawptr(&p), sizeof::<rawptr>());
    }

    fn _node_data(n: rawptr) -> T {
        var out: T;
        memcpy(to_rawptr(&out), n + list_payload_offset::<T>(), self.elem_size);
        return out;
    }

    fn _node_at(idx: i64) -> rawptr {
        if (idx < 0 || idx >= self.len) { panic("List index out of bounds"); }
        var cur = self.head;
        var i: i64 = 0;
        while (i < idx) {
            cur = self._node_next(cur);
            i = i + 1;
        }
        return cur;
    }

    public fn push_back(val: T) {
        let n = self._alloc_node(val);
        if (self.tail == null) {
            self.head = n;
            self.tail = n;
        } else {
            self._set_prev(n, self.tail);
            self._set_next(self.tail, n);
            self.tail = n;
        }
        self.len = self.len + 1;
        self.gen = self.gen + 1;
    }

    public fn push_front(val: T) {
        let n = self._alloc_node(val);
        if (self.head == null) {
            self.head = n;
            self.tail = n;
        } else {
            self._set_next(n, self.head);
            self._set_prev(self.head, n);
            self.head = n;
        }
        self.len = self.len + 1;
        self.gen = self.gen + 1;
    }

    public fn pop_back() -> T {
        if (self.tail == null) { panic("List.pop_back from empty list"); }
        let n = self.tail;
        let out = self._node_data(n);
        let prev = self._node_prev(n);
        if (prev == null) {
            self.head = null;
            self.tail = null;
        } else {
            self._set_next(prev, null);
            self.tail = prev;
        }
        vyx_aligned_free_abi(n);
        self.len = self.len - 1;
        self.gen = self.gen + 1;
        return out;
    }

    public fn pop_front() -> T {
        if (self.head == null) { panic("List.pop_front from empty list"); }
        let n = self.head;
        let out = self._node_data(n);
        let nxt = self._node_next(n);
        if (nxt == null) {
            self.head = null;
            self.tail = null;
        } else {
            self._set_prev(nxt, null);
            self.head = nxt;
        }
        vyx_aligned_free_abi(n);
        self.len = self.len - 1;
        self.gen = self.gen + 1;
        return out;
    }

    @[lazy]
    public fn front(&self) -> T where T: Clone {
        if (self.head == null) { panic("List.front on empty list"); }
        return (*(self.get_ptr(0))).clone();
    }

    @[lazy]
    public fn back(&self) -> T where T: Clone {
        if (self.tail == null) { panic("List.back on empty list"); }
        return (*(self.get_ptr(self.len - 1))).clone();
    }

    @[lazy]
    public fn get(&self, idx: i64) -> T where T: Clone {
        return (*(self.get_ptr(idx))).clone();
    }

    public fn get_ptr(idx: i64) -> *T {
        return (self._node_at(idx) + list_payload_offset::<T>()) as *T;
    }

    public fn operator[](&mut self, idx: i64) -> &mut T {
        let p = self.get_ptr(idx);
        return &mut p[0];
    }

    public fn set(idx: i64, val: T) {
        var slot = self.get_ptr(idx);
        vec_drop_stored_value::<T>(slot);
        unsafe { *slot = val; }
    }

    public fn isEmpty() -> bool { return self.len == 0; }

    public fn clear() {
        var cur = self.head;
        while (cur != null) {
            let nxt = self._node_next(cur);
            vec_drop_stored_value::<T>((cur + list_payload_offset::<T>()) as *T);
            vyx_aligned_free_abi(cur);
            cur = nxt;
        }
        self.head = null;
        self.tail = null;
        self.len = 0;
        self.gen = self.gen + 1;
    }

    /// Walk from head to tail. Same iter-invalidation contract as
    /// Vec / Dict / Deque.
    public fn iter() -> ListIterator<T> {
        return ListIterator {
            cur:          self.head,
            elem_size:    self.elem_size,
            source_gen:   to_rawptr(&self.gen),
            gen_snapshot: self.gen
        };
    }

    public fn destroy() {
        self.clear();
    }

    /// SSS Drop — List's `clear()` walks nodes and frees them; if
    /// called a second time on an already-emptied list (head==null)
    /// it is a no-op, so `drop()` is naturally idempotent.
    public fn drop() { self.destroy(); }

    /// Deep copy. Independent from `self`; mutating the result does
    /// not affect `self`. See std/clone.vyx Contract A.
    ///
    /// Walks head→tail, pushing cloned element values onto a fresh
    /// List so node pointers are fully independent from the original.
    /// Requires `T: Clone` at call time. Tagged `@[lazy]` so
    /// List<T> stays usable for non-Clone payloads.
    @[lazy]
    public fn clone(&self) -> List<T> where T: Clone {
        var out = List::<T>.new();
        var cur = self.head;
        while (cur != null) {
            let slot = (cur + list_payload_offset::<T>()) as *T;
            out.push_back((*slot).clone());
            cur = self._node_next(cur);
        }
        return out;
    }
}

class ListIterator<T> {
    public cur: rawptr;
    public elem_size: i64;
    public source_gen: rawptr;
    public gen_snapshot: i64;

    public fn has_next() -> bool { return self.cur != null; }

    @[lazy]
    public fn next() -> Option<T> where T: Clone {
        if (self.source_gen != null) {
            var gen_cur: i64 = 0;
            memcpy(to_rawptr(&gen_cur), self.source_gen, 8);
            if (gen_cur != self.gen_snapshot) {
                panic("ListIterator invalidated: List was modified during iteration");
            }
        }
        if (self.cur == null) { return None; }
        let slot = (self.cur + list_payload_offset::<T>()) as *T;
        let out = (*slot).clone();
        // Advance to next node.
        var nxt: rawptr = null;
        memcpy(to_rawptr(&nxt), self.cur + sizeof::<rawptr>(), sizeof::<rawptr>());
        self.cur = nxt;
        return Some(out);
    }
}
