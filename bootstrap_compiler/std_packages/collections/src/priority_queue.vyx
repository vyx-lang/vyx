module std.collections;

use std.defaults;
use std.core;
use std.clone;
use std.hash;

/// Binary heap ordered by T's Ord implementation. New queues are min-heaps;
/// new_max() constructs an owned max-heap. as_max_heap()/as_min_heap() change
/// an existing queue in place and rebuild it, including when it is nonempty.
/// These setters return a mutable borrow, never a second owning buffer handle.
/// push/pop take O(log n), peek O(1) plus Clone, and changing order O(n).
class PriorityQueue<T> {
    public data: rawptr;
    public len: i64;
    public cap: i64;
    public elem_size: i64;
    public is_max: bool;
    public gen: i64;

    public static fn new() -> PriorityQueue<T> {
        return PriorityQueue::<T>.with_capacity(16);
    }

    public static fn new_max() -> PriorityQueue<T> {
        var result = PriorityQueue::<T>.new();
        result.is_max = true;
        return result;
    }

    public static fn with_capacity(cap: i64) -> PriorityQueue<T> {
        let es = sizeof::<T>();
        var count = cap;
        if (count < 4) { count = 4; }
        if (es > 0 && count > 9223372036854775807 / es) {
            panic("PriorityQueue: allocation size overflow");
        }
        let data = vyx_aligned_alloc_abi(count * es, alignof::<T>());
        if (data == null) { panic("PriorityQueue: allocation failed"); }
        return PriorityQueue::<T> { data: data, len: 0, cap: count, elem_size: es, is_max: false, gen: 0 };
    }

    fn _check_alive(&self) {
        if (self.data == null) { panic("PriorityQueue: use after destroy"); }
    }

    @[lazy]
    public fn as_max_heap(&mut self) -> &mut PriorityQueue<T> where T: Ord {
        self._check_alive();
        if (!self.is_max) { self.is_max = true; self._rebuild(); }
        return self;
    }

    @[lazy]
    public fn as_min_heap(&mut self) -> &mut PriorityQueue<T> where T: Ord {
        self._check_alive();
        if (self.is_max) { self.is_max = false; self._rebuild(); }
        return self;
    }

    public fn isEmpty(&self) -> bool { return self.len == 0; }
    public fn capacity(&self) -> i64 { return self.cap; }

    /// Destroy every live element while retaining capacity for reuse.
    public fn clear(&mut self) {
        while (self.len > 0) {
            self.len -= 1;
            vec_drop_stored_value::<T>((self.data + self.len * sizeof::<T>()) as *T);
        }
        self.gen += 1;
    }

    public fn destroy(&mut self) {
        self.clear();
        if (self.data != null) { vyx_aligned_free_abi(self.data); }
        self.data = null; self.len = 0; self.cap = 0;
    }
    public fn drop(&mut self) { self.destroy(); }

    /// Independent storage and independently cloned live elements.
    @[lazy]
    public fn clone(&self) -> PriorityQueue<T> where T: Clone {
        self._check_alive();
        var result = PriorityQueue::<T>.with_capacity(self.len);
        result.is_max = self.is_max;
        var i: i64 = 0;
        while (i < self.len) {
            let slot = (self.data + i * sizeof::<T>()) as *T;
            let value = (*slot).clone();
            unsafe { *((result.data + i * sizeof::<T>()) as *T) = value; }
            result.len += 1;
            i += 1;
        }
        return result;
    }

    fn ensure_capacity(min_cap: i64) {
        self._check_alive();
        if (min_cap < 0) { panic("PriorityQueue: capacity overflow"); }
        if (self.cap >= min_cap) { return; }
        var count = self.cap;
        while (count < min_cap) {
            if (count > 4611686018427387903) { panic("PriorityQueue: capacity overflow"); }
            count *= 2;
        }
        let es = sizeof::<T>();
        if (es > 0 && count > 9223372036854775807 / es) {
            panic("PriorityQueue: allocation size overflow");
        }
        let data = vyx_aligned_alloc_abi(count * es, alignof::<T>());
        if (data == null) { panic("PriorityQueue: allocation failed"); }
        memcpy(data, self.data, self.len * es);
        vyx_aligned_free_abi(self.data);
        self.data = data; self.cap = count;
    }

    // Relocate slot bytes without constructing temporary owning T values.
    fn _swap(a: i64, b: i64) {
        if (a == b) { return; }
        let left = self.data + a * sizeof::<T>();
        let right = self.data + b * sizeof::<T>();
        var offset: i64 = 0;
        while (offset + 8 <= sizeof::<T>()) {
            var temporary: i64 = 0;
            memcpy(to_rawptr(&temporary), left + offset, 8);
            memcpy(left + offset, right + offset, 8);
            memcpy(right + offset, to_rawptr(&temporary), 8);
            offset += 8;
        }
        while (offset < sizeof::<T>()) {
            var temporary: u8 = 0;
            memcpy(to_rawptr(&temporary), left + offset, 1);
            memcpy(left + offset, right + offset, 1);
            memcpy(right + offset, to_rawptr(&temporary), 1);
            offset += 1;
        }
    }

    @[lazy]
    fn _before(a: i64, b: i64) -> bool where T: Ord {
        let left = (self.data + a * sizeof::<T>()) as *T;
        let right = (self.data + b * sizeof::<T>()) as *T;
        let order = (*left).compare(*right);
        if (self.is_max) { return order > 0; }
        return order < 0;
    }

    @[lazy]
    fn _sift_up(start: i64) where T: Ord {
        var index = start;
        while (index > 0) {
            let parent = (index - 1) / 2;
            if (!self._before(index, parent)) { return; }
            self._swap(index, parent);
            index = parent;
        }
    }

    @[lazy]
    fn _sift_down(start: i64) where T: Ord {
        var index = start;
        while (index < self.len / 2) {
            var child = index * 2 + 1;
            if (child + 1 < self.len && self._before(child + 1, child)) { child += 1; }
            if (!self._before(child, index)) { return; }
            self._swap(index, child);
            index = child;
        }
    }

    @[lazy]
    fn _rebuild() where T: Ord {
        var parent = self.len / 2;
        while (parent > 0) { parent -= 1; self._sift_down(parent); }
        self.gen += 1;
    }

    @[lazy]
    public fn push(value: T) where T: Ord {
        self.ensure_capacity(self.len + 1);
        unsafe { *((self.data + self.len * sizeof::<T>()) as *T) = value; }
        self.len += 1;
        self._sift_up(self.len - 1);
        self.gen += 1;
    }

    /// peek clones; pop transfers the root's ownership to its caller.
    @[lazy]
    public fn peek(&self) -> Option<T> where T: Clone {
        self._check_alive();
        if (self.len == 0) { return None; }
        return Some((*(self.data as *T)).clone());
    }

    @[lazy]
    public fn pop() -> Option<T> where T: Ord {
        self._check_alive();
        if (self.len == 0) { return None; }
        let root = vec_take_stored_value::<T>(self.data as *T);
        self.len -= 1;
        if (self.len > 0) {
            memcpy(self.data, self.data + self.len * sizeof::<T>(), sizeof::<T>());
            self._sift_down(0);
        }
        self.gen += 1;
        return Some(root);
    }

    /// Borrows heap-array order, which is not sorted. Structural mutations
    /// invalidate the iterator; keep the queue alive while using it.
    public fn iter() -> Iterator<T> {
        self._check_alive();
        return Iterator::<T> { data: self.data, len: self.len, pos: 0,
            source_gen: to_rawptr(&self.gen), gen_snapshot: self.gen, owns_data: false };
    }
}

impl Default for PriorityQueue<T> {
    static fn default_value() -> PriorityQueue<T> { return PriorityQueue::<T>.new(); }
}
