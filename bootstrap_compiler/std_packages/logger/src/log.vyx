module std.log;

/// Opt-in `std:logger` package. Leveled logging through DCI + compiled spdlog.
///
///   logger = { path = "std:logger", target = "std_logger" }
///   use std.log;
///   log_info("server started on port ${port}");
///   set_log_level(log_level_warn());
///
/// Levels match spdlog::level::level_enum: TRACE < DEBUG < INFO < WARN < ERROR < FATAL.
/// Dependents see levels through `log_level_*()` (VYI does not re-export `let` values).
/// `--src=file` implicit std does not load this module (native link closure).

@[dci_import("../contracts/spdlog.dcib")]
@[cpp_include("spdlog_dci.hpp")]
extern "cpp" {
    class fmt.basic_string_view<char> {
        public data_: *i8;
        public size_: usize;
    };

    class spdlog.logger {
        virtual ~logger();
        public fn flush();
        public fn log(level: i32, msg: fmt.basic_string_view<char>);
    };

    fn dci_default_logger() -> *spdlog.logger;
    fn dci_drop_logger(logger: *spdlog.logger);
}

public let LOG_TRACE: i32 = 0;
public let LOG_DEBUG: i32 = 1;
public let LOG_INFO: i32 = 2;
public let LOG_WARN: i32 = 3;
public let LOG_ERROR: i32 = 4;
public let LOG_FATAL: i32 = 5;

public fn log_level_trace() -> i32 { return LOG_TRACE; }
public fn log_level_debug() -> i32 { return LOG_DEBUG; }
public fn log_level_info() -> i32 { return LOG_INFO; }
public fn log_level_warn() -> i32 { return LOG_WARN; }
public fn log_level_error() -> i32 { return LOG_ERROR; }
public fn log_level_fatal() -> i32 { return LOG_FATAL; }

var g_logger: *spdlog.logger = null;
var g_min_level: i32 = 2;

fn ensure_logger() -> *spdlog.logger {
    if (g_logger == null) {
        g_logger = dci_default_logger();
    }
    return g_logger;
}

fn emit(level: i32, msg: string) {
    if (level < g_min_level) {
        return;
    }
    let logger = ensure_logger();
    if (logger == null) {
        return;
    }
    var view: fmt.basic_string_view<char>;
    view.data_ = msg.c_str() as *i8;
    view.size_ = msg.len as usize;
    (*logger).log(level, view);
}

public fn set_log_level(level: i32) {
    g_min_level = level;
}

public fn log_flush() {
    let logger = ensure_logger();
    if (logger != null) {
        logger.flush();
    }
}

public fn log_trace(msg: string) {
    emit(LOG_TRACE, msg);
}

public fn log_debug(msg: string) {
    emit(LOG_DEBUG, msg);
}

public fn log_info(msg: string) {
    emit(LOG_INFO, msg);
}

public fn log_warn(msg: string) {
    emit(LOG_WARN, msg);
}

public fn log_error(msg: string) {
    emit(LOG_ERROR, msg);
}

public fn log_fatal(msg: string) {
    emit(LOG_FATAL, msg);
    panic("fatal error: " + msg);
}
