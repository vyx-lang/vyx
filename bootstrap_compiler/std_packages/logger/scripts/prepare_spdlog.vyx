// Package prebuild: clone spdlog, cmake-build libspdlog.a, emit contracts/spdlog.dcib.
// Invoked as `vyx: scripts/prepare_spdlog.vyx` (compiler --run=aot --src=file).
use std.fs;
use std.process;
use std.string;

fn join2(a: string, b: string) -> string {
    if (a.len == 0) { return b; }
    if (a.endsWith("/")) { return a + b; }
    return a + "/" + b;
}

fn sh(cmd: string) -> i32 {
    print("[std.logger] " + cmd);
    return exec(cmd);
}

fn env_cstr(name: string) -> string {
    let p = env(name);
    if (p == null) { return ""; }
    return from_cstr(p);
}

fn find_dci_py() -> string {
    var dir = ".";
    var i: i32 = 0;
    while (i < 8) {
        let hit = join2(dir, "tools/dci/dci.py");
        if (fileExists(hit)) { return hit; }
        if (dir == ".") {
            dir = "..";
        } else {
            dir = dir + "/..";
        }
        i = i + 1;
    }
    return "";
}

fn find_clangxx() -> string {
    var llvm = env_cstr("LLVM_ROOT");
    if (llvm.len == 0) { llvm = "/usr/lib/llvm-22"; }
    let cxx = join2(llvm, "bin/clang++");
    if (fileExists(cxx)) { return cxx; }
    return "clang++";
}

fn find_python() -> string {
    let configured = env_cstr("VYX_PYTHON");
    if (configured.len > 0) { return configured; }
    return "python3";
}

fn ensure_spdlog_src(src: string, tag: string) -> i32 {
    let hdr = join2(src, "include/spdlog/spdlog.h");
    if (fileExists(hdr)) { return 0; }
    let reuse = "../../../tests/projects/dci_spdlog/native/third_party/spdlog";
    if (fileExists(join2(reuse, "include/spdlog/spdlog.h"))) {
        if (sh("mkdir -p vendor") != 0) { return 1; }
        return sh("cp -a " + reuse + " " + src);
    }
    if (sh("mkdir -p vendor") != 0) { return 1; }
    return sh("git clone --depth 1 --branch " + tag
              + " https://github.com/gabime/spdlog.git " + src);
}

fn ensure_spdlog_lib(src: string, build: string, lib: string, cxx: string) -> i32 {
    if (fileExists(lib)) { return 0; }
    let cfg = "cmake -S " + src + " -B " + build + " -G \"Unix Makefiles\""
            + " -DCMAKE_BUILD_TYPE=Release"
            + " -DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            + " -DCMAKE_CXX_COMPILER=" + cxx
            + " -DCMAKE_POSITION_INDEPENDENT_CODE=ON"
            + " -DSPDLOG_BUILD_EXAMPLE=OFF"
            + " -DSPDLOG_BUILD_TESTS=OFF"
            + " -DSPDLOG_BUILD_SHARED=OFF";
    if (sh(cfg) != 0) { return 1; }
    return sh("cmake --build " + build + " --parallel $(nproc)");
}

fn ensure_dcib(src: string, build: string, dcib: string, cxx: string) -> i32 {
    if (fileExists(dcib) && fileSize(dcib) > 0) { return 0; }
    if (sh("mkdir -p contracts") != 0) { return 1; }
    let dci = find_dci_py();
    if (dci.len == 0) {
        print("error: tools/dci/dci.py not found; set VYX_DCI_TOOLS or run from the repo");
        return 1;
    }
    let inc = join2(src, "include");
    let cmd = find_python() + " " + dci
            + " adapter --language cpp"
            + " native/spdlog_dci.hpp"
            + " " + join2(inc, "spdlog/sinks/sink.h")
            + " " + join2(inc, "spdlog/details/log_msg.h")
            + " " + join2(inc, "spdlog/formatter.h")
            + " " + join2(inc, "spdlog/logger.h")
            + " --toolchain clang --cxx " + cxx
            + " --triplet linux_x64"
            + " --cmake_build_path " + build
            + " -o " + dcib;
    return sh(cmd);
}

fn main() -> i32 {
    var tag = env_cstr("SPDLOG_TAG");
    if (tag.len == 0) { tag = "v1.14.1"; }
    let src = "vendor/spdlog";
    let build = "vendor/build";
    let lib = join2(build, "libspdlog.a");
    let dcib = "contracts/spdlog.dcib";
    let cxx = find_clangxx();

    if (ensure_spdlog_src(src, tag) != 0) { return 1; }
    if (ensure_spdlog_lib(src, build, lib, cxx) != 0) { return 1; }
    if (ensure_dcib(src, build, dcib, cxx) != 0) { return 1; }
    print("[std.logger] spdlog ready lib=" + lib + " dcib=" + dcib);
    return 0;
}
