module std.benchmark;

extern "C" {
    fn vyx_bench_black_box(value: rawptr);
    fn vyx_bench_now_ns() -> i64;
}

/// Expose an input or result to an opaque memory barrier. Use on both sides
/// of pure computations whose work the optimizer could otherwise remove.
public fn black_box<T>(value: T) -> T {
    vyx_bench_black_box(to_rawptr(&value));
    return value;
}

/// Monotonic nanoseconds, or -1 if the platform clock failed.
public fn benchmark_clock_ns() -> i64 { return vyx_bench_now_ns(); }
