module std.miniz;

use std.core;

extern "C" {
    fn vyx_miniz_compress(source: rawptr, source_len: i64, level: i32, status: rawptr) -> rawptr;
    fn vyx_miniz_buffer_clone(buffer: rawptr) -> rawptr;
    fn vyx_miniz_buffer_len(buffer: rawptr) -> i64;
    fn vyx_miniz_buffer_original_len(buffer: rawptr) -> i64;
    fn vyx_miniz_buffer_release(buffer: rawptr);
    fn vyx_miniz_decompress_text(buffer: rawptr, max_output_len: i64,
                                 output_len: rawptr, status: rawptr) -> rawptr;
    fn vyx_miniz_free(value: rawptr);
    fn vyx_miniz_version() -> rawptr;
    fn vyx_miniz_crc32(data: rawptr, len: i64) -> i64;
    fn vyx_miniz_adler32(data: rawptr, len: i64) -> i64;
}

public fn miniz_error_invalid_argument() -> i32 { return 1; }
public fn miniz_error_allocation() -> i32 { return 2; }
public fn miniz_error_compress() -> i32 { return 3; }
public fn miniz_error_decompress() -> i32 { return 4; }
public fn miniz_error_output_too_small() -> i32 { return 5; }

public class MinizError {
    public code: i32;
    public message: string;
}

fn miniz_error(code: i32) -> MinizError {
    if (code == miniz_error_invalid_argument()) {
        return MinizError { code: code, message: "invalid compression argument" };
    }
    if (code == miniz_error_allocation()) {
        return MinizError { code: code, message: "compression allocation failed" };
    }
    if (code == miniz_error_compress()) {
        return MinizError { code: code, message: "compression failed" };
    }
    if (code == miniz_error_output_too_small()) {
        return MinizError { code: code, message: "decompression output limit is too small" };
    }
    return MinizError { code: miniz_error_decompress(), message: "decompression failed" };
}

public class CompressedData {
    private owner: rawptr;

    public fn valid() -> bool { return self.owner != null; }
    public fn len() -> i64 { return vyx_miniz_buffer_len(self.owner); }
    public fn original_len() -> i64 { return vyx_miniz_buffer_original_len(self.owner); }

    public fn try_clone() -> Result<CompressedData, MinizError> {
        if (!self.valid()) { return Err(miniz_error(miniz_error_invalid_argument())); }
        let copy = vyx_miniz_buffer_clone(self.owner);
        if (copy == null) { return Err(miniz_error(miniz_error_allocation())); }
        return Ok(CompressedData { owner: copy });
    }

    public fn clone() -> CompressedData {
        let copy = vyx_miniz_buffer_clone(self.owner);
        if (copy == null) { panic("CompressedData::clone allocation failed"); }
        return CompressedData { owner: copy };
    }

    public fn decompress_to_string(max_output_len: i64) -> Result<string, MinizError> {
        var output_len: i64 = 0;
        var status: i32 = 0;
        let output = vyx_miniz_decompress_text(self.owner, max_output_len,
                                               to_rawptr(&output_len), to_rawptr(&status));
        if (output == null) { return Err(miniz_error(status)); }
        let text = from_cstr_len(output, output_len);
        vyx_miniz_free(output);
        return Ok(text);
    }

    public fn destroy() { self.drop(); }

    public fn drop() {
        if (self.owner != null) {
            vyx_miniz_buffer_release(self.owner);
            self.owner = null;
        }
    }
}

public class Compressor {
    public static fn version() -> string { return from_cstr(vyx_miniz_version()); }

    public static fn compress(text: string) -> Result<CompressedData, MinizError> {
        return Compressor.compress_level(text, 6);
    }

    public static fn compress_level(text: string, level: i32) -> Result<CompressedData, MinizError> {
        var status: i32 = 0;
        let owner = vyx_miniz_compress(text.c_str(), text.len, level, to_rawptr(&status));
        if (owner == null) { return Err(miniz_error(status)); }
        return Ok(CompressedData { owner: owner });
    }

    public static fn crc32(text: string) -> i64 {
        return vyx_miniz_crc32(text.c_str(), text.len);
    }

    public static fn adler32(text: string) -> i64 {
        return vyx_miniz_adler32(text.c_str(), text.len);
    }
}
