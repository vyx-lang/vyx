module std.path;

// Vyx Standard Library: Path Module
// Path manipulation utilities

@[platform("windows")]
public fn path_separator() -> i32 {
    return 92;
}

@[platform("posix")]
public fn path_separator() -> i32 {
    return 47;
}

public fn is_absolute(path: string) -> i32 {
    if (path.len() >= 2) {
        let ch = path.charAt(1);
        if (ch == 58) { return 1; } // ':'
    }
    if (path.len() >= 1) {
        let ch = path.charAt(0);
        if (ch == 47 || ch == 92) { return 1; } // '/' or '\'
    }
    return 0;
}
