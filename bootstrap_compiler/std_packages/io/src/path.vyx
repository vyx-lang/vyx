module std.path;

// Lexical classification, independent of filesystem existence.

@[platform("windows")]
public fn path_separator() -> i32 {
    return 92;
}

@[platform("posix")]
public fn path_separator() -> i32 {
    return 47;
}

fn path_drive_letter(c: i32) -> bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122);
}
fn path_windows_separator(c: i32) -> bool { return c == 47 || c == 92; }
fn path_unc_root(path: string, start: i32) -> bool {
    var p = start;
    while (p < path.len() && !path_windows_separator(path.charAt(p))) { p = p + 1; }
    if (p == start || p + 1 >= path.len()) { return false; }
    return !path_windows_separator(path.charAt(p + 1));
}

/// A rooted Windows path can still depend on the current drive.
@[platform("windows")]
public fn is_rooted(path: string) -> i32 {
    if (path.len() > 0 && path_windows_separator(path.charAt(0))) { return 1; }
    if (path.len() >= 2 && path_drive_letter(path.charAt(0)) && path.charAt(1) == 58) { return 1; }
    return 0;
}

/// Absolute paths do not depend on a working directory or current drive.
@[platform("windows")]
public fn is_absolute(path: string) -> i32 {
    let n = path.len();
    if (n >= 3 && path_drive_letter(path.charAt(0)) && path.charAt(1) == 58 && path_windows_separator(path.charAt(2))) { return 1; }
    if (n < 3 || !path_windows_separator(path.charAt(0)) || !path_windows_separator(path.charAt(1))) { return 0; }
    if ((path.charAt(2) == 63 || path.charAt(2) == 46) && n >= 4 && path_windows_separator(path.charAt(3))) {
        // A drive designator in the Win32 device namespace still needs a root separator.
        if (n >= 6 && path_drive_letter(path.charAt(4)) && path.charAt(5) == 58) {
            if (n >= 7 && path_windows_separator(path.charAt(6))) { return 1; }
            return 0;
        }
        if (n >= 7 && (path.charAt(4) == 85 || path.charAt(4) == 117) && (path.charAt(5) == 78 || path.charAt(5) == 110) && (path.charAt(6) == 67 || path.charAt(6) == 99) && (n == 7 || path_windows_separator(path.charAt(7)))) {
            if (n == 7) { return 0; }
            if (path_unc_root(path, 8)) { return 1; }
            return 0;
        }
        if (n > 4 && !path_windows_separator(path.charAt(4))) { return 1; }
        return 0;
    }
    if (path_unc_root(path, 2)) { return 1; }
    return 0;
}

@[platform("posix")]
public fn is_absolute(path: string) -> i32 {
    if (path.len() > 0 && path.charAt(0) == 47) { return 1; }
    return 0;
}
@[platform("posix")]
public fn is_rooted(path: string) -> i32 { return is_absolute(path); }
