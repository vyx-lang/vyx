module std.env;

// Vyx Standard Library: Environment Module
// Command-line arguments and CLI parsing (Rust-style API)

use std.process_args;

/// Returns the number of command-line arguments
public fn args_count() -> i32 {
    return argCount();
}

/// Returns the command-line argument at the given index
public fn arg(index: i32) -> string {
    return getArg(index);
}

/// Check if a command-line flag exists (e.g., "--verbose")
public fn has_flag(flag: string) -> bool {
    let count = argCount();
    var i: i32 = 0;
    while (i < count) {
        let a = getArg(i);
        if (a == flag) {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// Get value of --key=value option, returns empty string if not found
public fn get_option(key: string) -> string {
    let prefix = key + "=";
    let count = argCount();
    var i: i32 = 0;
    while (i < count) {
        let a = getArg(i);
        if (a.startsWith(prefix)) {
            return a.substring(prefix.len, a.len);
        }
        if (a == key) {
            if (i + 1 < count) {
                return getArg(i + 1);
            }
        }
        i = i + 1;
    }
    return "";
}

/// Get nth positional argument (arguments not starting with -)
public fn get_positional(n: i32) -> string {
    let count = argCount();
    var posIdx: i32 = 0;
    var i: i32 = 1;
    while (i < count) {
        let a = getArg(i);
        if (!a.startsWith("-")) {
            if (posIdx == n) {
                return a;
            }
            posIdx = posIdx + 1;
        }
        i = i + 1;
    }
    return "";
}

/// Count positional arguments
public fn positional_count() -> i32 {
    let count = argCount();
    var result: i32 = 0;
    var i: i32 = 1;
    while (i < count) {
        let a = getArg(i);
        if (!a.startsWith("-")) {
            result = result + 1;
        }
        i = i + 1;
    }
    return result;
}
