module std.process;

/// std/process.vyx — Process execution

extern "C" {
    fn system(command: rawptr) -> i32;
    fn exit(code: i32);
    fn getenv(name: rawptr) -> rawptr;
}

/// Run a shell command, returns exit code
public fn exec(command: string) -> i32 {
    return std.process.system(command.c_str());
}

/// Exit the program
public fn quit(code: i32) {
    exit(code);
}

/// Get environment variable
public fn env(name: string) -> rawptr {
    return std.process.getenv(name.c_str());
}
