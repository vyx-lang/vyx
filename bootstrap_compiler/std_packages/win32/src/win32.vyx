module std.win32;

/// Win32 API High-Level Bindings for Vyx
/// Usage: import std::win32;
///
/// Example:
///   win_message_box("Hello", "Vyx says hi!");
///   let hwnd = win_create_window("My App", 800, 600);
///   // message loop...
///   win_destroy_window(hwnd);

@[platform("windows")]

extern "C" {
    fn vyx_bootstrap_cwd() -> rawptr;
    fn MessageBoxA(hWnd: rawptr, lpText: rawptr, lpCaption: rawptr, uType: u32) -> i32;
    fn MessageBoxW(hWnd: rawptr, lpText: rawptr, lpCaption: rawptr, uType: u32) -> i32;
    fn GetModuleHandleA(lpModuleName: rawptr) -> rawptr;
    fn CreateWindowExA(dwExStyle: u32, lpClassName: rawptr, lpWindowName: rawptr, dwStyle: u32, x: i32, y: i32, nWidth: i32, nHeight: i32, hWndParent: rawptr, hMenu: rawptr, hInstance: rawptr, lpParam: rawptr) -> rawptr;
    fn DestroyWindow(hWnd: rawptr) -> i32;
    fn ShowWindow(hWnd: rawptr, nCmdShow: i32) -> i32;
    fn UpdateWindow(hWnd: rawptr) -> i32;
    fn GetMessageA(lpMsg: rawptr, hWnd: rawptr, wMsgFilterMin: u32, wMsgFilterMax: u32) -> i32;
    fn TranslateMessage(lpMsg: rawptr) -> i32;
    fn DispatchMessageA(lpMsg: rawptr) -> rawptr;
    fn PostQuitMessage(nExitCode: i32);
    fn DefWindowProcA(hWnd: rawptr, Msg: u32, wParam: u64, lParam: i64) -> rawptr;
    fn RegisterClassExA(lpwcx: rawptr) -> u16;
    fn GetDC(hWnd: rawptr) -> rawptr;
    fn ReleaseDC(hWnd: rawptr, hDC: rawptr) -> i32;
    fn InvalidateRect(hWnd: rawptr, lpRect: rawptr, bErase: i32) -> i32;
    fn SetWindowTextA(hWnd: rawptr, lpString: rawptr) -> i32;
    fn GetClientRect(hWnd: rawptr, lpRect: rawptr) -> i32;
    fn MoveWindow(hWnd: rawptr, x: i32, y: i32, nWidth: i32, nHeight: i32, bRepaint: i32) -> i32;
    fn SetTimer(hWnd: rawptr, nIDEvent: u64, uElapse: u32, lpTimerFunc: rawptr) -> u64;
    fn KillTimer(hWnd: rawptr, uIDEvent: u64) -> i32;
    fn GetAsyncKeyState(vKey: i32) -> i16;
    fn GetCursorPos(lpPoint: rawptr) -> i32;
    fn SetCursorPos(x: i32, y: i32) -> i32;
    fn ShowCursor(bShow: i32) -> i32;
    fn Beep(dwFreq: u32, dwDuration: u32) -> i32;
    fn Sleep(dwMilliseconds: u32);
    fn GetTickCount64() -> u64;
    fn QueryPerformanceCounter(lpPerformanceCount: rawptr) -> i32;
    fn QueryPerformanceFrequency(lpFrequency: rawptr) -> i32;
    fn GetSystemMetrics(nIndex: i32) -> i32;
    fn SetWindowPos(hWnd: rawptr, hWndInsertAfter: rawptr, X: i32, Y: i32, cx: i32, cy: i32, uFlags: u32) -> i32;
    fn GetForegroundWindow() -> rawptr;
    fn SetForegroundWindow(hWnd: rawptr) -> i32;
    fn IsWindowVisible(hWnd: rawptr) -> i32;
    fn EnableWindow(hWnd: rawptr, bEnable: i32) -> i32;
    fn CloseHandle(hObject: rawptr) -> i32;
    fn GetLastError() -> u32;
    fn CreateFileA(lpFileName: rawptr, dwDesiredAccess: u32, dwShareMode: u32, lpSecurityAttributes: rawptr, dwCreationDisposition: u32, dwFlagsAndAttributes: u32, hTemplateFile: rawptr) -> rawptr;
    fn ReadFile(hFile: rawptr, lpBuffer: rawptr, nNumberOfBytesToRead: u32, lpNumberOfBytesRead: rawptr, lpOverlapped: rawptr) -> i32;
    fn WriteFile(hFile: rawptr, lpBuffer: rawptr, nNumberOfBytesToWrite: u32, lpNumberOfBytesWritten: rawptr, lpOverlapped: rawptr) -> i32;
    fn GetFileSize(hFile: rawptr, lpFileSizeHigh: rawptr) -> u32;
    fn CreateDirectoryA(lpPathName: rawptr, lpSecurityAttributes: rawptr) -> i32;
    fn DeleteFileA(lpFileName: rawptr) -> i32;
    fn CopyFileA(lpExistingFileName: rawptr, lpNewFileName: rawptr, bFailIfExists: i32) -> i32;
    fn GetEnvironmentVariableA(lpName: rawptr, lpBuffer: rawptr, nSize: u32) -> u32;
    fn SetEnvironmentVariableA(lpName: rawptr, lpValue: rawptr) -> i32;
    fn GetCurrentDirectoryA(nBufferLength: u32, lpBuffer: rawptr) -> u32;
    fn SetCurrentDirectoryA(lpPathName: rawptr) -> i32;
    fn ShellExecuteA(hwnd: rawptr, lpOperation: rawptr, lpFile: rawptr, lpParameters: rawptr, lpDirectory: rawptr, nShowCmd: i32) -> rawptr;
    fn CreateThread(lpThreadAttributes: rawptr, dwStackSize: u64, lpStartAddress: rawptr, lpParameter: rawptr, dwCreationFlags: u32, lpThreadId: rawptr) -> rawptr;
    fn WaitForSingleObject(hHandle: rawptr, dwMilliseconds: u32) -> u32;
    fn InitializeCriticalSection(lpCriticalSection: rawptr);
    fn EnterCriticalSection(lpCriticalSection: rawptr);
    fn LeaveCriticalSection(lpCriticalSection: rawptr);
    fn DeleteCriticalSection(lpCriticalSection: rawptr);
}

// ── Constants ─────────────────────────────────────────────

let MB_OK: u32 = 0;
let MB_OKCANCEL: u32 = 1;
let MB_YESNO: u32 = 4;
let MB_YESNOCANCEL: u32 = 3;
let MB_ICONINFO: u32 = 64;
let MB_ICONWARNING: u32 = 48;
let MB_ICONERROR: u32 = 16;
let MB_ICONQUESTION: u32 = 32;

let IDOK: i32 = 1;
let IDCANCEL: i32 = 2;
let IDYES: i32 = 6;
let IDNO: i32 = 7;

let WS_OVERLAPPEDWINDOW: u32 = 13565952;
let WS_VISIBLE: u32 = 268435456;
let SW_SHOW: i32 = 5;
let SW_HIDE: i32 = 0;
let SW_MAXIMIZE: i32 = 3;
let SW_MINIMIZE: i32 = 6;

let WM_DESTROY: u32 = 2;
let WM_PAINT: u32 = 15;
let WM_KEYDOWN: u32 = 256;
let WM_KEYUP: u32 = 257;
let WM_TIMER: u32 = 275;
let WM_CLOSE: u32 = 16;

let VK_ESCAPE: i32 = 27;
let VK_SPACE: i32 = 32;
let VK_RETURN: i32 = 13;
let VK_LEFT: i32 = 37;
let VK_UP: i32 = 38;
let VK_RIGHT: i32 = 39;
let VK_DOWN: i32 = 40;

let SM_CXSCREEN: i32 = 0;
let SM_CYSCREEN: i32 = 1;

// ── High-Level API ────────────────────────────────────────

public fn win_message_box(title: string, message: string) -> i32 {
    return MessageBoxA(null, message.c_str(), title.c_str(), MB_OK | MB_ICONINFO);
}

public fn win_confirm(title: string, message: string) -> bool {
    return MessageBoxA(null, message.c_str(), title.c_str(), MB_YESNO | MB_ICONQUESTION) == IDYES;
}

public fn win_error(title: string, message: string) {
    MessageBoxA(null, message.c_str(), title.c_str(), MB_OK | MB_ICONERROR);
}

public fn win_warning(title: string, message: string) {
    MessageBoxA(null, message.c_str(), title.c_str(), MB_OK | MB_ICONWARNING);
}

public fn win_beep(frequency: i32, duration: i32) {
    Beep(frequency as u32, duration as u32);
}

public fn win_sleep(ms: i32) {
    Sleep(ms as u32);
}

public fn win_ticks() -> i64 {
    return GetTickCount64() as i64;
}

public fn win_screen_width() -> i32 {
    return GetSystemMetrics(SM_CXSCREEN);
}

public fn win_screen_height() -> i32 {
    return GetSystemMetrics(SM_CYSCREEN);
}

public fn win_key_pressed(vk: i32) -> bool {
    return (GetAsyncKeyState(vk) as i32) < 0;
}

public fn win_open_url(url: string) {
    ShellExecuteA(null, "open".c_str(), url.c_str(), null, null, SW_SHOW);
}

public fn win_open_file(path: string) {
    ShellExecuteA(null, "open".c_str(), path.c_str(), null, null, SW_SHOW);
}

public fn win_get_env(name: string) -> string {
    var buf: [i8; 1024];
    let len = GetEnvironmentVariableA(name.c_str(), to_rawptr(&buf), 1024);
    if (len == 0) { return ""; }
    return from_cstr(to_rawptr(&buf));
}

public fn win_set_env(name: string, value: string) {
    SetEnvironmentVariableA(name.c_str(), value.c_str());
}

public fn win_cwd() -> string {
    let raw = vyx_bootstrap_cwd();
    if (raw == null) { return ""; }
    return from_cstr(raw);
}

public fn win_mkdir(path: string) -> bool {
    return CreateDirectoryA(path.c_str(), null) != 0;
}

public fn win_delete_file(path: string) -> bool {
    return DeleteFileA(path.c_str()) != 0;
}

public fn win_copy_file(src: string, dst: string) -> bool {
    return CopyFileA(src.c_str(), dst.c_str(), 0) != 0;
}

public fn win_last_error() -> i32 {
    return GetLastError() as i32;
}
