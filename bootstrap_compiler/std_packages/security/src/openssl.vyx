module std.security.openssl;

use std.core;
use std.string;

/// OpenSSL High-Level Bindings for Vyx
/// Usage: import std::security::openssl;
///
/// Example:
///   let hash = sha256("Hello, World!");
///   print(hash);
///
/// Requires: OpenSSL 3.x (link with -l ssl -l crypto)
///   Windows: vcpkg install openssl
///   Linux: apt install libssl-dev
///   macOS: brew install openssl

extern "C" {
    // Hash functions
    fn EVP_MD_CTX_new() -> rawptr;
    fn EVP_MD_CTX_free(ctx: rawptr);
    fn EVP_DigestInit_ex(ctx: rawptr, type_: rawptr, impl_: rawptr) -> i32;
    fn EVP_DigestUpdate(ctx: rawptr, data: rawptr, count: u64) -> i32;
    fn EVP_DigestFinal_ex(ctx: rawptr, md: rawptr, s: rawptr) -> i32;
    fn EVP_sha256() -> rawptr;
    fn EVP_sha512() -> rawptr;
    fn EVP_sha1() -> rawptr;
    fn EVP_md5() -> rawptr;

    // Cipher functions
    fn EVP_CIPHER_CTX_new() -> rawptr;
    fn EVP_CIPHER_CTX_free(ctx: rawptr);
    fn EVP_EncryptInit_ex(ctx: rawptr, type_: rawptr, impl_: rawptr, key: rawptr, iv: rawptr) -> i32;
    fn EVP_EncryptUpdate(ctx: rawptr, out: rawptr, outl: rawptr, in_: rawptr, inl: i32) -> i32;
    fn EVP_EncryptFinal_ex(ctx: rawptr, out: rawptr, outl: rawptr) -> i32;
    fn EVP_DecryptInit_ex(ctx: rawptr, type_: rawptr, impl_: rawptr, key: rawptr, iv: rawptr) -> i32;
    fn EVP_DecryptUpdate(ctx: rawptr, out: rawptr, outl: rawptr, in_: rawptr, inl: i32) -> i32;
    fn EVP_DecryptFinal_ex(ctx: rawptr, out: rawptr, outl: rawptr) -> i32;
    fn EVP_aes_128_cbc() -> rawptr;
    fn EVP_aes_256_cbc() -> rawptr;

    // Random
    fn RAND_bytes(buf: rawptr, num: i32) -> i32;

    // Base64
    fn EVP_EncodeBlock(out: rawptr, in_: rawptr, inl: i32) -> i32;
    fn EVP_DecodeBlock(out: rawptr, in_: rawptr, inl: i32) -> i32;

    // HMAC
    fn HMAC(evp_md: rawptr, key: rawptr, key_len: i32, data: rawptr, data_len: u64, md: rawptr, md_len: rawptr) -> rawptr;

    // Init
    fn OPENSSL_init_crypto(opts: u64, settings: rawptr) -> i32;

    // TLS client (libssl)
    fn OPENSSL_init_ssl(opts: u64, settings: rawptr) -> i32;
    fn TLS_client_method() -> rawptr;
    fn SSL_CTX_new(method: rawptr) -> rawptr;
    fn SSL_CTX_free(ctx: rawptr);
    fn SSL_new(ctx: rawptr) -> rawptr;
    fn SSL_free(ssl: rawptr);
    fn SSL_set_fd(ssl: rawptr, fd: i32) -> i32;
    fn SSL_connect(ssl: rawptr) -> i32;
    fn SSL_read(ssl: rawptr, buf: rawptr, num: i32) -> i32;
    fn SSL_write(ssl: rawptr, buf: rawptr, num: i32) -> i32;
    fn SSL_shutdown(ssl: rawptr) -> i32;

    // Helpers
    fn malloc(size: u64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
    fn sprintf(str: rawptr, format: rawptr) -> i32;
}

// OpenSSL return contracts: docs.openssl.org/3.0/man3/EVP_DigestInit/,
// docs.openssl.org/3.0/man3/RAND_bytes/ and docs.openssl.org/3.0/man3/HMAC/.
@[platform("windows")]
extern "C" {
    fn ERR_get_error() -> u32;
    fn SSL_ctrl(ssl: rawptr, command: i32, value: i32, ptr: rawptr) -> i32;
}
@[platform("posix")]
extern "C" {
    fn ERR_get_error() -> u64;
    fn SSL_ctrl(ssl: rawptr, command: i32, value: i64, ptr: rawptr) -> i64;
}

public class CryptoError {
    public code: i32;
    public native_code: u64;
    public message: string;
}
public fn crypto_error_allocation() -> i32 { return 1; }
public fn crypto_error_backend() -> i32 { return 2; }
public fn crypto_error_invalid_input() -> i32 { return 3; }

fn crypto_failure(code: i32, message: string) -> CryptoError {
    let native = if (code == crypto_error_backend()) { ERR_get_error() as u64 } else { 0 as u64 };
    return CryptoError { code: code, native_code: native, message: message };
}
fn crypto_require(result: Result<String, CryptoError>) -> String {
    match (result) {
        Ok(value) => { return value; }
        Err(failure) => { panic(failure.message); }
    }
}

@[borrow_args]
fn crypto_digest(data: string, algorithm: rawptr, expected_size: i32) -> Result<String, CryptoError> {
    if (algorithm == null) { return Err(crypto_failure(crypto_error_backend(), "OpenSSL digest unavailable")); }
    let context = EVP_MD_CTX_new();
    if (context == null) { return Err(crypto_failure(crypto_error_allocation(), "OpenSSL digest context allocation failed")); }
    defer EVP_MD_CTX_free(context);
    var hash: [u8; 64];
    var length: u32 = 0;
    if (EVP_DigestInit_ex(context, algorithm, null) != 1) {
        return Err(crypto_failure(crypto_error_backend(), "OpenSSL digest initialization failed"));
    }
    if (EVP_DigestUpdate(context, data.c_str(), data.len as u64) != 1) {
        return Err(crypto_failure(crypto_error_backend(), "OpenSSL digest update failed"));
    }
    if (EVP_DigestFinal_ex(context, to_rawptr(&hash), to_rawptr(&length)) != 1 || length != expected_size as u32) {
        return Err(crypto_failure(crypto_error_backend(), "OpenSSL digest finalization failed"));
    }
    return Ok(crypto_hex_owned(to_rawptr(&hash), expected_size));
}

@[borrow_args]
public fn try_sha256(data: string) -> Result<String, CryptoError> { return crypto_digest(data, EVP_sha256(), 32); }
@[borrow_args]
public fn try_sha512(data: string) -> Result<String, CryptoError> { return crypto_digest(data, EVP_sha512(), 64); }
@[borrow_args]
public fn try_sha1(data: string) -> Result<String, CryptoError> { return crypto_digest(data, EVP_sha1(), 20); }
@[borrow_args]
public fn try_md5(data: string) -> Result<String, CryptoError> { return crypto_digest(data, EVP_md5(), 16); }

// Compatibility text results are independent copies. Recoverable callers use
// the try_* APIs, which return an owned String and retain the backend error.
@[borrow_args]
public fn sha256(data: string) -> string {
    let value = crypto_require(try_sha256(data));
    return value.as_str().clone();
}
@[borrow_args]
public fn sha512(data: string) -> string {
    let value = crypto_require(try_sha512(data));
    return value.as_str().clone();
}
@[borrow_args]
public fn sha1(data: string) -> string {
    let value = crypto_require(try_sha1(data));
    return value.as_str().clone();
}
@[borrow_args]
public fn md5(data: string) -> string {
    let value = crypto_require(try_md5(data));
    return value.as_str().clone();
}

@[borrow_args]
public fn try_hmac_sha256(key: string, data: string) -> Result<String, CryptoError> {
    if (key.len > 2147483647) { return Err(crypto_failure(crypto_error_invalid_input(), "HMAC key is too long")); }
    var result: [u8; 32];
    var length: u32 = 0;
    let output = HMAC(EVP_sha256(), key.c_str(), key.len as i32,
                      data.c_str(), data.len as u64, to_rawptr(&result), to_rawptr(&length));
    if (output == null || length != 32 as u32) {
        return Err(crypto_failure(crypto_error_backend(), "OpenSSL HMAC failed"));
    }
    return Ok(crypto_hex_owned(to_rawptr(&result), 32));
}
@[borrow_args]
public fn hmac_sha256(key: string, data: string) -> string {
    let value = crypto_require(try_hmac_sha256(key, data));
    return value.as_str().clone();
}

/// Compatibility random_bytes returns hexadecimal text (two characters/byte).
/// The bounded Result API rejects lengths outside 0..256 and checks RAND_bytes.
public fn try_random_bytes(count: i32) -> Result<String, CryptoError> {
    if (count < 0 || count > 256) { return Err(crypto_failure(crypto_error_invalid_input(), "random byte count must be in 0..256")); }
    if (count == 0) { return Ok(String.from("")); }
    var bytes: [u8; 256];
    if (RAND_bytes(to_rawptr(&bytes), count) != 1) {
        return Err(crypto_failure(crypto_error_backend(), "OpenSSL random generation failed"));
    }
    return Ok(crypto_hex_owned(to_rawptr(&bytes), count));
}
public fn random_bytes(count: i32) -> string {
    let value = crypto_require(try_random_bytes(count));
    return value.as_str().clone();
}
public fn try_random_int() -> Result<i32, CryptoError> {
    var bytes: [u8; 4];
    if (RAND_bytes(to_rawptr(&bytes), 4) != 1) {
        return Err(crypto_failure(crypto_error_backend(), "OpenSSL random generation failed"));
    }
    let value = (bytes[0] as u32) | ((bytes[1] as u32) << 8) | ((bytes[2] as u32) << 16) | ((bytes[3] as u32) << 24);
    return Ok(value as i32);
}
public fn random_int() -> i32 {
    match (try_random_int()) {
        Ok(value) => { return value; }
        Err(failure) => { panic(failure.message); }
    }
}

// ── TLS client (single libssl binding surface) ────────────
// Consumers (std:network websockets, ...) reuse these primitives instead of
// re-declaring libssl externs. openssl.vyx is the only binding site.

public fn tls_init(opts: u64, settings: rawptr) -> i32 {
    return OPENSSL_init_ssl(opts, settings);
}

public fn tls_client_method() -> rawptr {
    return TLS_client_method();
}

public fn tls_ctx_new(method: rawptr) -> rawptr {
    return SSL_CTX_new(method);
}

public fn tls_ctx_free(ctx: rawptr) {
    SSL_CTX_free(ctx);
}

public fn tls_new(ctx: rawptr) -> rawptr {
    return SSL_new(ctx);
}

public fn tls_free(ssl: rawptr) {
    SSL_free(ssl);
}

public fn tls_set_fd(ssl: rawptr, fd: i32) -> i32 {
    return SSL_set_fd(ssl, fd);
}

public fn tls_set_hostname(ssl: rawptr, name: rawptr) -> i32 {
    return SSL_ctrl(ssl, 55, 0, name) as i32;
}

public fn tls_connect(ssl: rawptr) -> i32 {
    return SSL_connect(ssl);
}

public fn tls_read(ssl: rawptr, buf: rawptr, num: i32) -> i32 {
    return SSL_read(ssl, buf, num);
}

public fn tls_write(ssl: rawptr, buf: rawptr, num: i32) -> i32 {
    return SSL_write(ssl, buf, num);
}

public fn tls_shutdown(ssl: rawptr) -> i32 {
    return SSL_shutdown(ssl);
}

// ── Helpers ───────────────────────────────────────────────

fn crypto_hex_owned(data: rawptr, len: i32) -> String {
    if (len < 0 || (len > 0 && data == null)) { panic("invalid byte range for hexadecimal encoding"); }
    var output = StringBuilder.create();
    let digits = "0123456789abcdef";
    var i: i32 = 0;
    while (i < len) {
        var byte: u8 = 0;
        memcpy(to_rawptr(&byte), data + i, 1 as u64);
        let value = byte as i32;
        output.appendChar(digits.charAt((value >> 4) & 15));
        output.appendChar(digits.charAt(value & 15));
        i += 1;
    }
    return output.intoString();
}
public fn bytes_to_hex(data: rawptr, len: i32) -> string {
    let value = crypto_hex_owned(data, len);
    return value.as_str().clone();
}
