module std.security.crypto;

// Vyx Standard Library: Crypto Module
// Basic hash functions

public fn djb2_hash(s: string) -> i32 {
    var hash = 5381;
    for (var i = 0; i < s.len(); i++) {
        let c = s.charAt(i);
        hash = ((hash * 33) + c) % 2147483647;
    }
    hash;
}

public fn fnv1a_hash(s: string) -> i32 {
    var hash = 2166136261;
    for (var i = 0; i < s.len(); i++) {
        let c = s.charAt(i);
        hash = (hash ^ c) * 16777619;
        hash = hash % 2147483647;
    }
    hash;
}

public fn simple_checksum(s: string) -> i32 {
    var sum = 0;
    for (var i = 0; i < s.len(); i++) {
        sum += s.charAt(i);
    }
    sum;
}
