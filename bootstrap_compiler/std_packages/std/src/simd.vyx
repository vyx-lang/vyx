module std.simd;

// ============================================================
//  Vyx SIMD Module — Cross-Platform Vector Operations
//  Supports x86_64 (SSE/AVX) and ARM (NEON) via LLVM backend
// ============================================================
//
//  Types:
//    f32x4, f32x8     — 4/8-lane single-precision float vectors
//    f64x2, f64x4     — 2/4-lane double-precision float vectors
//    i32x4, i32x8     — 4/8-lane 32-bit integer vectors
//    i64x2, i64x4     — 2/4-lane 64-bit integer vectors
//
//  Constructors (built-in):
//    {type}_zero()                — all-zero vector
//    {type}_splat(val)            — broadcast scalar to all lanes
//    {type}_make(a, b, c, ...)    — construct from individual values
//
//  Arithmetic (operators):
//    a + b, a - b, a * b, a / b  — lane-wise operations
//
//  Reduction (built-in):
//    {type}_sum(vec)              — sum all lanes → scalar
//
//  Example:
//    let a = f32x4_make(1.0, 2.0, 3.0, 4.0);
//    let b = f32x4_splat(2.0);
//    let c = a * b;   // {2.0, 4.0, 6.0, 8.0}
//    let s = f32x4_sum(c);  // 20.0
// ============================================================
