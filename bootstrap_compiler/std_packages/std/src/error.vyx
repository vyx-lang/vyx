module std.error;

/// std/error.vyx — Error chain and context propagation, plus the
/// Rust-style `Error` marker trait.
///
/// Two complementary surfaces live here:
///
///   * `ErrorContext` (below) — value-type wrapper for structured
///     errors with origin / context propagation.  Pre-existing.
///
///   * `trait Error` (this section) — Rust-style marker trait that
///     any class / struct implements to participate in generic
///     error-handling code.  Mirrors `std::error::Error`: a single
///     `message()` method (the moral equivalent of `Display::fmt`)
///     plus implicit `Display` compatibility (any Error-impl can be
///     wrapped by `${}` interpolation through fmt's Display path).
///
/// Vyx already has the `error MyErr { Variant1, Variant2 }` enum form
/// plus the `fail` keyword for unwind-style propagation.  The `Error`
/// trait here covers the *struct / class* side of error handling —
/// e.g. `class ParseError : Error { ... }` — so user-defined errors
/// can be stored in `Box<dyn Error>` analogues and printed
/// uniformly.
///
/// MVP scope: trait definition + a baseline `impl Error for string`
/// that returns the string itself as its message.  This makes
/// `Result<T, string>` compatible with any code bounded
/// `where E: Error`, which in turn lets the `string`-typed errors
/// returned by `std.convert`'s FromStr / TryFrom flow into
/// generic error sinks without intermediate wrapping.

/// Marker trait for error types.  Implementors must provide
/// `message()`, returning a short human description.  Convention
/// matches Rust's `Error::description` (deprecated there but still
/// the simplest contract): one line, no trailing newline, lower-case
/// first letter, no period.
///
/// Display compatibility: any `impl Error for T` should also
/// `impl Display for T` so the `${err}` interpolation form prints
/// usefully.  We don't enforce that with a `: Display` supertrait
/// yet because the trait-supertrait machinery is still a one-way
/// shape (super → sub) in Vyx's resolver.
trait Error {
    fn message() -> string;
}

/// Baseline impl: a plain `string` is a valid Error whose message is
/// itself.  Lets `Result<T, string>` interop with `where E: Error`
/// generics for free, which is the common case for the conversion
/// errors emitted by `std.convert` / parse helpers.
impl Error for string {
    fn message() -> string { return self; }
}

public class ErrorContext {
    message: string
    source_file: string
    source_line: i32
    cause_text: string
    chain_depth: i32

    public static fn init(msg: string) -> ErrorContext {
        return ErrorContext {
            message: msg,
            source_file: "",
            source_line: 0,
            cause_text: "",
            chain_depth: 1
        };
    }

    public static fn with_file(msg: string, file: string, line: i32) -> ErrorContext {
        return ErrorContext {
            message: msg,
            source_file: file,
            source_line: line,
            cause_text: "",
            chain_depth: 1
        };
    }

    public static fn with_cause(msg: string, cause: ErrorContext) -> ErrorContext {
        return ErrorContext {
            message: msg,
            source_file: "",
            source_line: 0,
            cause_text: cause.display(),
            chain_depth: cause.chain_length() + 1
        };
    }

    public fn display() -> string {
        var result = "";
        if (self.source_file != "") {
            result = "Error: " + self.message + " at " + self.source_file + ":" + self.source_line.toString();
        } else {
            result = "Error: " + self.message;
        }
        if (self.cause_text.len > 0) {
            if (self.cause_text.endsWith("\n")) {
                return result + "\nCaused by:\n" + self.cause_text;
            }
            return result + "\nCaused by:\n" + self.cause_text + "\n";
        }
        return result + "\n";
    }

    public fn chain_length() -> i32 { return self.chain_depth; }
}

public trait ErrorTrait {
    fn message() -> string;
}

public fn context(msg: string) -> ErrorContext {
    return ErrorContext.init(msg);
}

public fn chain(msg: string, _cause: ErrorContext) -> ErrorContext {
    return ErrorContext.with_cause(msg, _cause);
}

/// Usage:
/// let err = context("file not found");
/// let wrapped = chain("failed to load config", err);
/// print(wrapped.display());
/// // Error: failed to load config
/// //   Caused by: Error: file not found
