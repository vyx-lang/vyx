module std.convert;

use std.core;
use std.collections;
use std.string;

/// Vyx Standard Library — Conversion traits
///
/// Mirrors Rust's `std::str::FromStr`.  Returns `Result<Self, string>`
/// — the error channel is a plain string for MVP rather than a
/// dedicated `ParseError` enum (the compiler's `error`-keyword ADT
/// machinery is fine, but a string message composes more naturally
/// with the `Error` trait added in std/error.vyx, which requires a
/// Display-compatible `message()` method).
///
/// ## Dispatch convention (2026-04-23)
///
/// Like `trait Default` in std/defaults.vyx, the `from_str` method has
/// no `self` parameter — it's a true static factory.  Vyx does not
/// (yet) support static trait method calls via `T::method()`; the
/// reflection member resolver fails with "unknown reflection member"
/// on anything outside the `{name, kind, fields, methods}` set.
/// Until static trait dispatch lands, the free-function form is the
/// recommended MVP call site:
///
///   let r: Result<i32, string> = i32_from_str("42");
///
/// The `impl FromStr for i32 { ... }` block still registers the
/// method against the primitive so generic bounds `where T: FromStr`
/// see the trait as satisfied.  When static trait dispatch lands, the
/// intended call site becomes `i32::from_str(s)` — no free-function
/// alias needed; the impl bodies in this file already match that
/// signature, so the migration is a call-site rename only.

// ============================================================
// C runtime imports.
//
// strtoll / strtod parse C strings with a writable end-pointer: on
// return, `*endp` points at the first character NOT consumed.  We use
// that to detect trailing garbage ("123x" → endp points at 'x',
// consumed < s.len → reject).  Leading whitespace IS skipped by both
// functions, which we accept for MVP (matches Rust's `str::parse::<i32>`
// — Rust is strict about trailing but tolerant of sign prefixes; full
// whitespace strictness is a future refinement).
// ============================================================

extern "C" {
    fn strtoll(str: rawptr, endp: rawptr, base: i32) -> i64;
    fn strtod(str: rawptr, endp: rawptr) -> f64;
}

// ============================================================
// FromStr trait
// ============================================================

/// Parse an instance of the implementing type from its string form.
/// Returns `Err(msg)` on malformed input; message is a short human
/// tag ("invalid integer", "invalid float", "invalid boolean", …)
/// rather than a full diagnostic.  Callers that need richer errors
/// should wrap the string in a `ParseError` class and implement
/// `Error` on it.
trait FromStr {
    fn from_str(s: string) -> Result<Self, string>;
}

// ============================================================
// Free-function parsers.
//
// These are the real implementations; the `impl FromStr for T`
// blocks below are thin wrappers that exist so generic bounds see
// the trait as satisfied.  Callers that don't care about generic
// dispatch should use the free functions directly — they're cheaper
// (no tag argument) and their names are searchable.
// ============================================================

/// Parse an i64 from its decimal string form.
///
/// * Empty string → `Err("empty")`.
/// * Non-digit garbage anywhere after the number → `Err("invalid integer")`.
/// * Out-of-range magnitudes are silently saturated by `strtoll`; we
///   don't distinguish that case here.
public fn i64_from_str(s: string) -> Result<i64, string> {
    if (s.len == 0) { return Err("empty"); }
    var endp: rawptr = null;
    let v = strtoll(s.ptr, to_rawptr(&endp), 10 as i32);
    var consumed: i64 = 0;
    unsafe { consumed = (endp - s.ptr) as i64; }
    if (consumed != s.len) { return Err("invalid integer"); }
    return Ok(v);
}

/// Parse an i32.  Delegates to `i64_from_str` and range-checks.
public fn i32_from_str(s: string) -> Result<i32, string> {
    let r = i64_from_str(s);
    match (r) {
        case Ok(v) => {
            let max_i32: i64 = 2147483647 as i64;
            let min_i32: i64 = (0 as i64) - (2147483648 as i64);
            if (v > max_i32 || v < min_i32) { return Err("integer out of range"); }
            return Ok(v as i32);
        }
        case Err(e) => { return Err(e); }
    }
}

/// Parse an f64.
public fn f64_from_str(s: string) -> Result<f64, string> {
    if (s.len == 0) { return Err("empty"); }
    var endp: rawptr = null;
    let v = strtod(s.ptr, to_rawptr(&endp));
    var consumed: i64 = 0;
    unsafe { consumed = (endp - s.ptr) as i64; }
    if (consumed != s.len) { return Err("invalid float"); }
    return Ok(v);
}

/// Parse an f32.  Delegates to `f64_from_str`; precision loss on the
/// f64 → f32 narrowing is silent (matches Rust's `as f32` and
/// `f32::from_str`).
public fn f32_from_str(s: string) -> Result<f32, string> {
    let r = f64_from_str(s);
    match (r) {
        case Ok(v) => { return Ok(v as f32); }
        case Err(e) => { return Err(e); }
    }
}

/// Parse a bool.  Strict: accepts exactly "true" or "false" (case-
/// sensitive, like Rust).  Whitespace-padded forms are rejected.
public fn bool_from_str(s: string) -> Result<bool, string> {
    if (str_equals(s, "true"))  { return Ok(true); }
    if (str_equals(s, "false")) { return Ok(false); }
    return Err("invalid boolean");
}

/// Trivial identity parser — useful as a generic endpoint so code
/// bounded `where T: FromStr` can bind T=string without special-casing.
public fn string_from_str(s: string) -> Result<string, string> {
    return Ok(s);
}

// ============================================================
// Primitive FromStr impls.
//
// Thin wrappers giving generic bounds `where T: FromStr` something
// to dispatch against.  Bodies forward to the free functions above
// so behaviour stays in one place.  Method signature matches the
// trait exactly (no `_impl` suffix etc.) — when static trait
// dispatch lands, `T::from_str(s)` resolves directly to these.
// ============================================================

impl FromStr for i64 {
    fn from_str(s: string) -> Result<i64, string> {
        return i64_from_str(s);
    }
}

impl FromStr for i32 {
    fn from_str(s: string) -> Result<i32, string> {
        return i32_from_str(s);
    }
}

impl FromStr for f64 {
    fn from_str(s: string) -> Result<f64, string> {
        return f64_from_str(s);
    }
}

impl FromStr for f32 {
    fn from_str(s: string) -> Result<f32, string> {
        return f32_from_str(s);
    }
}

impl FromStr for bool {
    fn from_str(s: string) -> Result<bool, string> {
        return bool_from_str(s);
    }
}

impl FromStr for string {
    fn from_str(s: string) -> Result<string, string> {
        return Ok(s);
    }
}

// ============================================================
// TryFrom<From> trait
// ============================================================

/// Fallible conversion from a source type `From` to `Self`.  Mirrors
/// Rust's `std::convert::TryFrom`.  The infallible counterpart
/// `From<T>` (Rust's `std::convert::From`) is omitted from the MVP
/// because Vyx doesn't need a trait-driven coercion system — direct
/// `as` casts cover the infallible cases.
///
/// Same dispatch caveat as FromStr: `try_from` takes no `self`, so
/// `T::try_from(v)` doesn't resolve through the reflection member
/// path until static trait dispatch lands.  Callers use the
/// free-function form (`i32_try_from_i64`, `i64_try_from_string`,
/// etc.) for now.
trait TryFrom<From> {
    fn try_from(value: From) -> Result<Self, string>;
}

// ============================================================
// Free-function fallible conversions.
//
// Naming convention: `<target>_try_from_<source>(v)` — mirrors the
// `<target>_from_str(s)` shape used by FromStr above.
// ============================================================

/// Narrow an i64 to i32.  Returns `Err("i64 too large for i32")` /
/// `Err("i64 too small for i32")` on overflow / underflow; otherwise
/// `Ok(v as i32)`.
public fn i32_try_from_i64(v: i64) -> Result<i32, string> {
    let max_i32: i64 = 2147483647 as i64;
    let min_i32: i64 = (0 as i64) - (2147483648 as i64);
    if (v > max_i32) { return Err("i64 too large for i32"); }
    if (v < min_i32) { return Err("i64 too small for i32"); }
    return Ok(v as i32);
}

/// Parse an i64 from a string.  This is the "TryFrom<string> for
/// i64" edge that Rust provides through the `FromStr` blanket impl.
/// Exposed under the TryFrom name as well so generic code bounded
/// on TryFrom<string> works uniformly.
public fn i64_try_from_string(s: string) -> Result<i64, string> {
    return i64_from_str(s);
}

/// i32 from string — mirrors `i64_try_from_string` for the narrower
/// type.
public fn i32_try_from_string(s: string) -> Result<i32, string> {
    return i32_from_str(s);
}

/// Narrow an f64 to f32.  Precision loss is silent (matches Rust's
/// `as f32`); infinity / NaN round-trip cleanly.  Always succeeds —
/// we keep the `Result`-returning signature for TryFrom uniformity.
public fn f32_try_from_f64(v: f64) -> Result<f32, string> {
    return Ok(v as f32);
}

/// Widen an f32 to f64.  Lossless; `Result` for uniformity.
public fn f64_try_from_f32(v: f32) -> Result<f64, string> {
    return Ok(v as f64);
}

// ============================================================
// Primitive TryFrom impls — deferred.
//
// TryFrom takes a *source* type parameter (`TryFrom<From>`), which
// Vyx trait impls don't yet bind cleanly on primitive targets — the
// generic resolver expects `Self` but not a second source-type slot
// in `impl Trait for T`.  Until that lands, TryFrom's generic
// machinery is a documentation anchor and callers route through the
// free functions (`i32_try_from_i64`, etc.).  The trait definition
// above is still useful as a contract other traits can name (e.g.
// the eventual `Error` trait's `From<E>` blanket impl).
// ============================================================
