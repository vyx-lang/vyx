module std.os;

// Vyx Standard Library: OS Module
// System information and process control

extern "C" {
    fn exit(code: i32);
    fn system(cmd: *u8) -> i32;
    fn getenv(name: *u8) -> *u8;
    fn clock() -> i32;
    fn time(t: rawptr) -> i32;
    fn srand(seed: i32);
    fn rand() -> i32;
}

@[platform("windows")]
extern "C" {
    fn Sleep(ms: i32);
}

@[platform("posix")]
extern "C" {
    fn usleep(usec: i32) -> i32;
}

// === Process Control ===

public fn os_exit(code: i32) {
    exit(code);
}

public fn os_system(cmd: string) -> i32 {
    system(cmd);
}

// === Random Numbers ===

public fn random_seed(seed: i32) {
    srand(seed);
}

public fn random_int() -> i32 {
    rand();
}

public fn random_range(min_val: i32, max_val: i32) -> i32 {
    let range = max_val - min_val + 1;
    let r = rand();
    var result = r % range;
    if (result < 0) { result = -result; }
    result + min_val;
}

// === Time ===

public fn clock_ticks() -> i32 {
    clock();
}

public fn current_time() -> i32 {
    time(null);
}

// === Environment ===

public fn env_get(name: string) -> rawptr {
    getenv(name);
}

// === Sleep ===

/// Sleep for the given number of milliseconds (cross-platform).
@[platform("windows")]
public fn sleep_ms(ms: i32) {
    Sleep(ms);
}

@[platform("posix")]
public fn sleep_ms(ms: i32) {
    usleep(ms * 1000);
}

// === Syscall (Linux x86_64 only) ===
// `syscall` + System V GPRs. Not valid on Windows, Android, macOS, or aarch64.

@[platform("linux")]
public fn syscall0(nr: i64) -> i64 {
    var result: i64 = 0;
    unsafe {
        asm("syscall", "={rax},{rax}", nr);
    }
    return result;
}

@[platform("linux")]
public fn syscall1(nr: i64, a1: i64) -> i64 {
    var result: i64 = 0;
    unsafe {
        asm("syscall", "={rax},{rax},{rdi}", nr, a1);
    }
    return result;
}

@[platform("linux")]
public fn syscall2(nr: i64, a1: i64, a2: i64) -> i64 {
    var result: i64 = 0;
    unsafe {
        asm("syscall", "={rax},{rax},{rdi},{rsi}", nr, a1, a2);
    }
    return result;
}

@[platform("linux")]
public fn syscall3(nr: i64, a1: i64, a2: i64, a3: i64) -> i64 {
    var result: i64 = 0;
    unsafe {
        asm("syscall", "={rax},{rax},{rdi},{rsi},{rdx}", nr, a1, a2, a3);
    }
    return result;
}
