module std.encoding;

use std.core;
use std.string;

public error EncodingError { InvalidLength, InvalidCharacter, InvalidPadding, NonCanonical }

/// Encoding — Base64 & Hex Encoding/Decoding for Vyx
/// Usage: import std::encoding;
///
/// Example:
///   let b64 = base64_encode("Hello, World!");
///   print(base64_decode(b64));
///   let hex = hex_encode("Hello");
///   print(hex_decode(hex));

// ── Base64 ───────────────────────────────────────────────

fn b64_char(i: i32) -> string {
    let table = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
    return table.substring(i, i + 1);
}

fn b64_val(c: string) -> i32 {
    let ch = c.charAt(0);
    if (ch >= 65 && ch <= 90)  { return ch - 65; }
    if (ch >= 97 && ch <= 122) { return ch - 97 + 26; }
    if (ch >= 48 && ch <= 57)  { return ch - 48 + 52; }
    if (ch == 43) { return 62; }
    if (ch == 47) { return 63; }
    return -1;
}

public fn base64_encode(input: string) -> string {
    var result = "";
    var i = 0;
    let n = input.len;
    while (i < n) {
        let b0 = input.charAt(i) & 255;
        let has1 = i + 1 < n;
        let has2 = i + 2 < n;
        let b1 = has1 ? (input.charAt(i + 1) & 255) : 0;
        let b2 = has2 ? (input.charAt(i + 2) & 255) : 0;
        result = result + b64_char((b0 >> 2) & 63);
        result = result + b64_char(((b0 & 3) << 4) | ((b1 >> 4) & 15));
        if (has1) { result = result + b64_char(((b1 & 15) << 2) | ((b2 >> 6) & 3)); }
        else { result = result + "="; }
        if (has2) { result = result + b64_char(b2 & 63); }
        else { result = result + "="; }
        i = i + 3;
    }
    return result;
}

public fn try_base64_decode(input: string) -> Result<string, EncodingError> {
    if (input.len % 4 != 0) { return Err(EncodingError.InvalidLength); }
    var result = StringBuilder.withCapacity(input.len);
    var i = 0;
    let n = input.len;
    while (i + 3 < n) {
        let c0 = input.substring(i, i + 1);
        let c1 = input.substring(i + 1, i + 2);
        let c2 = input.substring(i + 2, i + 3);
        let c3 = input.substring(i + 3, i + 4);
        let v0 = b64_val(c0);
        let v1 = b64_val(c1);
        if (v0 < 0 || v1 < 0) { return Err(EncodingError.InvalidCharacter); }
        result.appendChar((v0 << 2) | (v1 >> 4));
        if (c2 == "=") {
            if (c3 != "=" || i + 4 != n) { return Err(EncodingError.InvalidPadding); }
            if ((v1 & 15) != 0) { return Err(EncodingError.NonCanonical); }
        } else {
            let v2 = b64_val(c2);
            if (v2 < 0) { return Err(EncodingError.InvalidCharacter); }
            result.appendChar(((v1 & 15) << 4) | (v2 >> 2));
            if (c3 == "=") {
                if (i + 4 != n) { return Err(EncodingError.InvalidPadding); }
                if ((v2 & 3) != 0) { return Err(EncodingError.NonCanonical); }
            } else {
                let v3 = b64_val(c3);
                if (v3 < 0) { return Err(EncodingError.InvalidCharacter); }
                result.appendChar(((v2 & 3) << 6) | v3);
            }
        }
        i = i + 4;
    }
    let owned = result.intoString();
    return Ok(owned.as_str().clone());
}

/// Strict standard-alphabet Base64. Use try_base64_decode for recoverable errors.
public fn base64_decode(input: string) -> string {
    match (try_base64_decode(input)) {
        Ok(value) => { return value; }
        Err(_) => { panic("base64_decode: invalid or noncanonical Base64"); }
    }
}

// ── Hex ──────────────────────────────────────────────────

fn hex_digit(v: i32) -> string {
    let table = "0123456789abcdef";
    return table.substring(v & 15, (v & 15) + 1);
}

fn hex_val(c: i32) -> i32 {
    if (c >= 48 && c <= 57)  { return c - 48; }
    if (c >= 97 && c <= 102) { return c - 97 + 10; }
    if (c >= 65 && c <= 70)  { return c - 65 + 10; }
    return -1;
}

public fn hex_byte(b: i32) -> string {
    return hex_digit((b >> 4) & 15) + hex_digit(b & 15);
}

public fn hex_encode(input: string) -> string {
    var result = "";
    var i = 0;
    while (i < input.len) {
        result = result + hex_byte(input.charAt(i) & 255);
        i = i + 1;
    }
    return result;
}

public fn try_hex_decode(input: string) -> Result<string, EncodingError> {
    if (input.len % 2 != 0) { return Err(EncodingError.InvalidLength); }
    var result = StringBuilder.withCapacity(input.len / 2);
    var i = 0;
    while (i + 1 < input.len) {
        let hi = hex_val(input.charAt(i));
        let lo = hex_val(input.charAt(i + 1));
        if (hi < 0 || lo < 0) { return Err(EncodingError.InvalidCharacter); }
        result.appendChar((hi << 4) | lo);
        i = i + 2;
    }
    let owned = result.intoString();
    return Ok(owned.as_str().clone());
}

public fn hex_decode(input: string) -> string {
    match (try_hex_decode(input)) {
        Ok(value) => { return value; }
        Err(_) => { panic("hex_decode: invalid hexadecimal input"); }
    }
}

public fn hex_int(value: i32) -> string {
    if (value == 0) { return "0"; }
    var result = "";
    var v = value as u32;
    while (v != 0 as u32) { result = hex_digit((v & 15 as u32) as i32) + result; v = v >> 4; }
    return result;
}

public fn hex_i64(value: i64) -> string {
    if (value == 0) { return "0"; }
    var result = "";
    var v = value as u64;
    while (v != 0 as u64) { result = hex_digit((v & 15 as u64) as i32) + result; v = v >> 4; }
    return result;
}
