module std.uuid;

use std.core;
use std.string;
use std.collections;
use std.hash;
use std.clone;

public error UuidError { InvalidLength, InvalidFormat, EntropyUnavailable }

@[platform("windows")]
extern "C" { fn rand_s(value: *u32) -> i32; }
@[platform("posix")]
extern "C" {
    fn fopen(path: rawptr, mode: rawptr) -> rawptr;
    fn fread(buffer: rawptr, size: i64, count: i64, file: rawptr) -> i64;
    fn fclose(file: rawptr) -> i32;
    fn ferror(file: rawptr) -> i32;
    fn clearerr(file: rawptr);
}
@[platform("linux")]
extern "C" { fn __errno_location() -> *i32; }
@[platform("macos")]
extern "C" { fn __error() -> *i32; }
@[platform("android")]
extern "C" { fn __errno() -> *i32; }
@[platform("linux")]
fn uuid_errno() -> i32 { unsafe { return __errno_location()[0]; } }
@[platform("macos")]
fn uuid_errno() -> i32 { unsafe { return __error()[0]; } }
@[platform("android")]
fn uuid_errno() -> i32 { unsafe { return __errno()[0]; } }

fn uuid_hex_value(ch: i32) -> i32 {
    if (ch >= 48 && ch <= 57) { return ch - 48; }
    if (ch >= 65 && ch <= 70) { return ch - 55; }
    if (ch >= 97 && ch <= 102) { return ch - 87; }
    return -1;
}
@[platform("windows")]
fn uuid_entropy() -> Result<Vec<u8>, UuidError> {
    var bytes = Vec::<u8>.with_capacity(16);
    var i: i32 = 0;
    while (i < 4) {
        var word: u32 = 0;
        if (rand_s(&word) != 0) { return Err(UuidError.EntropyUnavailable); }
        var j: i32 = 0;
        while (j < 4) { bytes.push(((word >> (j * 8)) & 255) as u8); j += 1; }
        i += 1;
    }
    return Ok(bytes);
}
@[platform("posix")]
fn uuid_entropy() -> Result<Vec<u8>, UuidError> {
    var bytes = Vec::<u8>.with_capacity(16);
    var i: i32 = 0;
    while (i < 16) { bytes.push(0 as u8); i += 1; }
    let file = fopen("/dev/urandom".c_str(), "rb".c_str());
    if (file == null) { return Err(UuidError.EntropyUnavailable); }
    var used: i64 = 0;
    while (used < 16) {
        let count = fread(bytes.data + used, 1, 16 - used, file);
        if (count < 0 || count > 16 - used) { fclose(file); return Err(UuidError.EntropyUnavailable); }
        used += count;
        if (ferror(file) != 0) {
            if (uuid_errno() == 4) { clearerr(file); }
            else { fclose(file); return Err(UuidError.EntropyUnavailable); }
        } elif (count == 0) { fclose(file); return Err(UuidError.EntropyUnavailable); }
    }
    if (fclose(file) != 0) { return Err(UuidError.EntropyUnavailable); }
    return Ok(bytes);
}

/// RFC 9562 UUID in network byte order. No mutable random state or seed.
public class Uuid {
    high: u64;
    low: u64;
    public static fn nil() -> Uuid { return Uuid { high: 0 as u64, low: 0 as u64 }; }

    public static fn try_parse(text: string) -> Result<Uuid, UuidError> {
        if (text.len != 36) { return Err(UuidError.InvalidLength); }
        var high: u64 = 0;
        var low: u64 = 0;
        var i: i64 = 0;
        var digits: i32 = 0;
        while (i < 36) {
            if (i == 8 || i == 13 || i == 18 || i == 23) {
                if (text.charAt(i) != 45) { return Err(UuidError.InvalidFormat); }
            } else {
                let digit = uuid_hex_value(text.charAt(i));
                if (digit < 0) { return Err(UuidError.InvalidFormat); }
                if (digits < 16) { high = (high << 4) | digit as u64; }
                else { low = (low << 4) | digit as u64; }
                digits += 1;
            }
            i += 1;
        }
        return Ok(Uuid { high: high, low: low });
    }
    public static fn try_from_bytes(bytes: &Vec<u8>) -> Result<Uuid, UuidError> {
        if (bytes.len != 16) { return Err(UuidError.InvalidLength); }
        var high: u64 = 0;
        var low: u64 = 0;
        var i: i64 = 0;
        while (i < 16) {
            if (i < 8) { high = (high << 8) | bytes.get(i) as u64; }
            else { low = (low << 8) | bytes.get(i) as u64; }
            i += 1;
        }
        return Ok(Uuid { high: high, low: low });
    }
    public static fn try_new_v4() -> Result<Uuid, UuidError> {
        match (uuid_entropy()) {
            Err(failure) => { return Err(failure); }
            Ok(bytes) => {
                var value = Uuid.try_from_bytes(&bytes).unwrap();
                value.high = (value.high & 18446744073709490175 as u64) | 16384 as u64;
                value.low = (value.low & 4611686018427387903 as u64) | 9223372036854775808 as u64;
                return Ok(value);
            }
        }
    }
    public fn is_nil(&self) -> bool { return self.high == 0 as u64 && self.low == 0 as u64; }
    public fn version(&self) -> i32 { return ((self.high >> 12) & 15 as u64) as i32; }
    public fn variant_bits(&self) -> i32 { return (self.low >> 62) as i32; }
    public fn to_bytes(&self) -> Vec<u8> {
        var bytes = Vec::<u8>.with_capacity(16);
        var i: i32 = 7;
        while (i >= 0) { bytes.push(((self.high >> (i * 8)) & 255 as u64) as u8); i -= 1; }
        i = 7;
        while (i >= 0) { bytes.push(((self.low >> (i * 8)) & 255 as u64) as u8); i -= 1; }
        return bytes;
    }
    public fn toString(&self) -> String {
        var out = StringBuilder.create();
        let hex = "0123456789abcdef";
        var i: i32 = 0;
        while (i < 32) {
            if (i == 8 || i == 12 || i == 16 || i == 20) { out.append("-"); }
            let word = if (i < 16) { self.high } else { self.low };
            let digit = ((word >> ((15 - i % 16) * 4)) & 15 as u64) as i64;
            out.appendChar(hex.charAt(digit));
            i += 1;
        }
        return out.build();
    }
}
impl Copy for Uuid {}
impl Clone for Uuid { public fn clone(&self) -> Uuid { return Uuid { high: self.high, low: self.low }; } }
impl Eq for Uuid { public fn operator_eq(&self, other: Uuid) -> bool { return self.high == other.high && self.low == other.low; } }
impl Ord for Uuid {
    public fn compare(&self, other: Uuid) -> i32 {
        if (self.high < other.high) { return -1; }
        if (self.high > other.high) { return 1; }
        if (self.low < other.low) { return -1; }
        if (self.low > other.low) { return 1; }
        return 0;
    }
}
impl Hashable for Uuid { public fn hash(&self) -> i64 { return hash_i64((self.high ^ self.low) as i64); } }
/// Compatibility string API. Entropy errors are never replaced with a PRNG.
public fn uuid4() -> string {
    match (Uuid.try_new_v4()) {
        Ok(value) => { return value.toString().as_str().clone(); }
        Err(_) => { panic("std.uuid: system entropy unavailable"); }
    }
}
