module std.random;

use std.collections;
use std.time;

// Force Mono to cascade Vec<i32>.iter() → Iterator<i32>.
fn __random_force_iter_i32() {
    let _v = Vec::<i32>.new();
    let _it = _v.iter();
}

/// Random — Pseudorandom Number Generator for Vyx (PCG-XSH-RR)
/// Usage: import std::random;
///
/// Example:
///   let rng = Rng.create(42);           // seeded
///   let rng = Rng.auto();               // auto-seeded from clock
///   print(rng.nextInt());               // random i32
///   print(rng.range(1, 100));           // 1..100 inclusive
///   print(rng.nextFloat());             // 0.0..1.0
///   print(rng.choice(vec));             // random element

public class Rng {
    state: u64
    inc: u64

    public static fn create(seed: i64) -> Rng {
        var r = Rng { state: 0 as u64, inc: ((seed as u64) << 1) | 1 as u64 };
        r.step();
        r.state = r.state + seed as u64;
        r.step();
        return r;
    }

    public static fn auto() -> Rng {
        return Rng.create(cpu_clock_ticks() * 6364136223846793005 + 1);
    }

    fn step() {
        self.state = self.state * 6364136223846793005 as u64 + self.inc;
    }

    public fn nextU32() -> i32 {
        let old = self.state;
        self.step();
        let xor_shifted = (((old >> 18) ^ old) >> 27) as u32;
        let rot = (old >> 59) as i32;
        return ((xor_shifted >> rot) | (xor_shifted << ((32 - rot) & 31))) as i32;
    }

    public fn nextInt() -> i32 {
        return self.nextU32();
    }

    public fn nextI64() -> i64 {
        let hi = (self.nextU32() as u32) as u64;
        let lo = (self.nextU32() as u32) as u64;
        return ((hi << 32) | lo) as i64;
    }

    public fn nextFloat() -> f64 {
        let v = self.nextU32() as u32;
        return (v as f64) / 4294967296.0;
    }

    public fn range(min: i32, max: i32) -> i32 {
        if (min >= max) { return min; }
        let span = ((max as i64) - (min as i64) + 1) as u32;
        if (span == 0 as u32) { return self.nextU32(); }
        let threshold = (0 as u32 - span) % span;
        var value = self.nextU32() as u32;
        while (value < threshold) { value = self.nextU32() as u32; }
        return ((min as i64) + ((value % span) as i64)) as i32;
    }

    public fn rangeI64(min: i64, max: i64) -> i64 {
        if (min >= max) { return min; }
        let span = (max as u64) - (min as u64) + 1 as u64;
        if (span == 0 as u64) { return self.nextI64(); }
        let threshold = (0 as u64 - span) % span;
        var value = self.nextI64() as u64;
        while (value < threshold) { value = self.nextI64() as u64; }
        return ((min as u64) + value % span) as i64;
    }

    public fn nextBool() -> bool {
        return (self.nextU32() & 1) != 0;
    }

    @[borrow_args]
    public fn shuffle(vec: Vec<i32>) {
        var i = vec.len - 1;
        while (i > 0) {
            let j = self.rangeI64(0, i);
            let tmp = vec.get(i);
            vec.set(i, vec.get(j));
            vec.set(j, tmp);
            i = i - 1;
        }
    }
}
