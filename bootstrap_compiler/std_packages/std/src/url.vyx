module std.url;

use std.core;
use std.string;
use std.collections;
use std.clone;

public error UrlErrorKind { InvalidEscape, InvalidCharacter, InvalidScheme, UnsupportedScheme, InvalidAuthority, InvalidHost, InvalidPort, InvalidState }
public class UrlError {
    public kind: UrlErrorKind;
    public offset: i64;
    public message: string;
}

fn url_failure(kind: UrlErrorKind, offset: i64, message: string) -> UrlError {
    return UrlError { kind: kind, offset: offset, message: message };
}
fn url_digit(ch: i32) -> bool { return ch >= 48 && ch <= 57; }
fn url_alpha(ch: i32) -> bool { return (ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122); }
fn url_unreserved(ch: i32) -> bool { return url_alpha(ch) || url_digit(ch) || ch == 45 || ch == 46 || ch == 95 || ch == 126; }
fn url_hex(ch: i32) -> i32 {
    if (url_digit(ch)) { return ch - 48; }
    if (ch >= 65 && ch <= 70) { return ch - 55; }
    if (ch >= 97 && ch <= 102) { return ch - 87; }
    return -1;
}
fn url_subdelim(ch: i32) -> bool {
    return ch == 33 || ch == 36 || ch == 38 || ch == 39 || ch == 40 || ch == 41 || ch == 42 || ch == 43 || ch == 44 || ch == 59 || ch == 61;
}

fn url_encode_component(input: string, form: bool) -> string {
    var output = StringBuilder.withCapacity(input.len);
    let digits = "0123456789ABCDEF";
    var i: i64 = 0;
    while (i < input.len) {
        let ch = input.charAt(i);
        let safe = if (form) { url_alpha(ch) || url_digit(ch) || ch == 42 || ch == 45 || ch == 46 || ch == 95 } else { url_unreserved(ch) };
        if (safe) { output.appendChar(ch); }
        else if (form && ch == 32) { output.appendChar(43); }
        else {
            output.appendChar(37);
            output.appendChar(digits.charAt((ch >> 4) & 15));
            output.appendChar(digits.charAt(ch & 15));
        }
        i += 1;
    }
    let owned = output.intoString();
    return owned.as_str().clone();
}

fn url_decode_component(input: string, form: bool) -> Result<string, UrlError> {
    var output = StringBuilder.withCapacity(input.len);
    var i: i64 = 0;
    while (i < input.len) {
        let ch = input.charAt(i);
        if (ch == 37) {
            if (input.len - i < 3) { return Err(url_failure(UrlErrorKind.InvalidEscape, i, "incomplete percent escape")); }
            let hi = url_hex(input.charAt(i + 1));
            let lo = url_hex(input.charAt(i + 2));
            if (hi < 0 || lo < 0) { return Err(url_failure(UrlErrorKind.InvalidEscape, i, "invalid percent escape")); }
            output.appendChar((hi << 4) | lo);
            i += 3;
        } else {
            output.appendChar(if (form && ch == 43) { 32 } else { ch });
            i += 1;
        }
    }
    let owned = output.intoString();
    return Ok(owned.as_str().clone());
}

/// Byte codecs. URL decoding preserves '+', NUL and non-UTF-8 bytes.
public fn url_encode(input: string) -> string { return url_encode_component(input, false); }
public fn try_url_decode(input: string) -> Result<string, UrlError> { return url_decode_component(input, false); }
public fn url_decode(input: string) -> string {
    match (try_url_decode(input)) { Ok(value) => { return value; } Err(failure) => { panic("url_decode: ", failure.message, " at byte ", failure.offset); } }
}
/// Form alphabet: spaces become '+', literal '+' becomes %2B, '~' becomes %7E.
/// Decoding is strict about percent escapes; it does not replace invalid UTF-8.
public fn form_encode(input: string) -> string { return url_encode_component(input, true); }
public fn try_form_decode(input: string) -> Result<string, UrlError> { return url_decode_component(input, true); }
public fn form_decode(input: string) -> string {
    match (try_form_decode(input)) { Ok(value) => { return value; } Err(failure) => { panic("form_decode: ", failure.message, " at byte ", failure.offset); } }
}

// Component modes: 0 registered host; 1 userinfo; 2 path; 3 query/fragment.
fn url_bad_component(text: string, begin: i64, end: i64, mode: i32) -> i64 {
    var i = begin;
    while (i < end) {
        let ch = text.charAt(i);
        if (ch == 37) {
            if (end - i < 3 || url_hex(text.charAt(i + 1)) < 0 || url_hex(text.charAt(i + 2)) < 0) { return i; }
            i += 3;
        } else {
            let allowed = url_unreserved(ch) || url_subdelim(ch) || (mode >= 1 && ch == 58)
                || (mode >= 2 && (ch == 64 || ch == 47)) || (mode == 3 && ch == 63);
            if (!allowed) { return i; }
            i += 1;
        }
    }
    return -1;
}

fn url_ipv4(text: string, begin: i64, end: i64) -> bool {
    var i = begin;
    var parts: i32 = 0;
    while (parts < 4) {
        let start = i;
        var value: i32 = 0;
        while (i < end && url_digit(text.charAt(i))) {
            if (i - start >= 3) { return false; }
            value = value * 10 + text.charAt(i) - 48;
            i += 1;
        }
        if (i == start || value > 255 || (i - start > 1 && text.charAt(start) == 48)) { return false; }
        parts += 1;
        if (parts < 4) {
            if (i == end || text.charAt(i) != 46) { return false; }
            i += 1;
        }
    }
    return i == end;
}

// IPv6 only: one optional '::', eight 16-bit groups, optional dotted tail.
// IPvFuture and zone identifiers are explicitly outside this parser's scope.
fn url_ipv6(text: string, begin: i64, end: i64) -> bool {
    if (begin == end) { return false; }
    var i = begin;
    var groups: i32 = 0;
    var compressed = false;
    if (text.charAt(i) == 58) {
        if (end - i < 2 || text.charAt(i + 1) != 58) { return false; }
        compressed = true;
        i += 2;
        if (i == end) { return true; }
    }
    while (i < end) {
        let start = i;
        var dotted = false;
        while (i < end && text.charAt(i) != 58) {
            if (text.charAt(i) == 46) { dotted = true; }
            i += 1;
        }
        if (i == start) { return false; }
        if (dotted) {
            if (i != end || !url_ipv4(text, start, i)) { return false; }
            groups += 2;
        } else {
            if (i - start > 4) { return false; }
            var j = start;
            while (j < i) { if (url_hex(text.charAt(j)) < 0) { return false; } j += 1; }
            groups += 1;
        }
        if (groups > 8) { return false; }
        if (i < end) {
            i += 1;
            if (i < end && text.charAt(i) == 58) {
                if (compressed) { return false; }
                compressed = true;
                i += 1;
            } else if (i == end) { return false; }
        }
    }
    return if (compressed) { groups < 8 } else { groups == 8 };
}

/// Absolute HTTP(S)/WS(S) URLs using ASCII RFC 3986 component syntax.
/// host excludes IPv6 brackets. Delimiter flags retain empty ? / # / userinfo.
/// This is not a WHATWG normalizer, IDNA resolver or relative-URL resolver.
public class Url {
    public scheme: string;
    public host: string;
    public port: string;
    public path: string;
    public query: string;
    public fragment: string;
    public userinfo: string;
    public has_query: bool;
    public has_fragment: bool;
    public has_userinfo: bool;

    public static fn try_parse(raw: string) -> Result<Url, UrlError> {
        let colon = raw.indexOf(":");
        if (colon <= 0) { return Err(url_failure(UrlErrorKind.InvalidScheme, 0, "expected an absolute URL scheme")); }
        var i: i64 = 0;
        while (i < colon) {
            let ch = raw.charAt(i);
            if (!(url_alpha(ch) || (i > 0 && (url_digit(ch) || ch == 43 || ch == 45 || ch == 46)))) {
                return Err(url_failure(UrlErrorKind.InvalidScheme, i, "invalid URL scheme"));
            }
            i += 1;
        }
        let scheme = raw.substring(0, colon);
        let lower = scheme.toLower();
        if (!(lower == "http" || lower == "https" || lower == "ws" || lower == "wss")) {
            return Err(url_failure(UrlErrorKind.UnsupportedScheme, 0, "expected HTTP, HTTPS, WS or WSS"));
        }
        if (raw.len - colon < 3 || raw.charAt(colon + 1) != 47 || raw.charAt(colon + 2) != 47) {
            return Err(url_failure(UrlErrorKind.InvalidAuthority, colon + 1, "expected // after URL scheme"));
        }
        var begin = colon + 3;
        var end = begin;
        while (end < raw.len && raw.charAt(end) != 47 && raw.charAt(end) != 63 && raw.charAt(end) != 35) { end += 1; }
        var userinfo: string = "";
        var has_userinfo = false;
        i = begin;
        while (i < end) {
            if (raw.charAt(i) == 64) {
                if (has_userinfo) { return Err(url_failure(UrlErrorKind.InvalidAuthority, i, "multiple unescaped @ delimiters")); }
                let bad = url_bad_component(raw, begin, i, 1);
                if (bad >= 0) { return Err(url_failure(UrlErrorKind.InvalidCharacter, bad, "invalid userinfo byte or escape")); }
                userinfo = raw.substring(begin, i);
                has_userinfo = true;
                begin = i + 1;
            }
            i += 1;
        }
        if (begin == end) { return Err(url_failure(UrlErrorKind.InvalidHost, begin, "empty URL host")); }
        var host: string = "";
        var port_begin: i64 = -1;
        if (raw.charAt(begin) == 91) {
            i = begin + 1;
            while (i < end && raw.charAt(i) != 93) { i += 1; }
            if (i == end || !url_ipv6(raw, begin + 1, i)) {
                return Err(url_failure(UrlErrorKind.InvalidHost, begin, "invalid bracketed IPv6 address"));
            }
            host = raw.substring(begin + 1, i);
            if (i + 1 < end) {
                if (raw.charAt(i + 1) != 58) { return Err(url_failure(UrlErrorKind.InvalidAuthority, i + 1, "unexpected bytes after IPv6 host")); }
                port_begin = i + 2;
            }
        } else {
            i = begin;
            var numeric = true;
            var dotted = false;
            while (i < end && raw.charAt(i) != 58) {
                let ch = raw.charAt(i);
                if (ch == 46) { dotted = true; } else if (!url_digit(ch)) { numeric = false; }
                i += 1;
            }
            let bad = url_bad_component(raw, begin, i, 0);
            if (begin == i || bad >= 0 || (numeric && dotted && !url_ipv4(raw, begin, i))) {
                return Err(url_failure(UrlErrorKind.InvalidHost, if (bad >= 0) { bad } else { begin }, "invalid registered host or IPv4 address"));
            }
            host = raw.substring(begin, i);
            if (i < end) { port_begin = i + 1; }
        }
        var port: string = "";
        if (port_begin >= 0) {
            if (port_begin == end) { return Err(url_failure(UrlErrorKind.InvalidPort, port_begin, "empty URL port")); }
            var number: i32 = 0;
            i = port_begin;
            while (i < end) {
                if (!url_digit(raw.charAt(i))) { return Err(url_failure(UrlErrorKind.InvalidPort, i, "nondigit URL port")); }
                number = number * 10 + raw.charAt(i) - 48;
                if (number > 65535) { return Err(url_failure(UrlErrorKind.InvalidPort, i, "URL port exceeds 65535")); }
                i += 1;
            }
            port = raw.substring(port_begin, end);
        }
        i = end;
        while (i < raw.len && raw.charAt(i) != 63 && raw.charAt(i) != 35) { i += 1; }
        let bad_path = url_bad_component(raw, end, i, 2);
        if (bad_path >= 0) { return Err(url_failure(UrlErrorKind.InvalidCharacter, bad_path, "invalid URL path byte or escape")); }
        let path = raw.substring(end, i);
        var query: string = "";
        var fragment: string = "";
        var has_query = false;
        var has_fragment = false;
        if (i < raw.len && raw.charAt(i) == 63) {
            has_query = true;
            let start = i + 1;
            i = start;
            while (i < raw.len && raw.charAt(i) != 35) { i += 1; }
            let bad = url_bad_component(raw, start, i, 3);
            if (bad >= 0) { return Err(url_failure(UrlErrorKind.InvalidCharacter, bad, "invalid URL query byte or escape")); }
            query = raw.substring(start, i);
        }
        if (i < raw.len && raw.charAt(i) == 35) {
            has_fragment = true;
            let start = i + 1;
            let bad = url_bad_component(raw, start, raw.len, 3);
            if (bad >= 0) { return Err(url_failure(UrlErrorKind.InvalidCharacter, bad, "invalid URL fragment byte or escape")); }
            fragment = raw.substring(start, raw.len);
        }
        return Ok(Url { scheme: scheme, host: host, port: port, path: path, query: query, fragment: fragment,
            userinfo: userinfo, has_query: has_query, has_fragment: has_fragment, has_userinfo: has_userinfo });
    }

    public static fn parse(raw: string) -> Url {
        match (Url.try_parse(raw)) { Ok(value) => { return value; } Err(failure) => { panic("Url.parse: ", failure.message, " at byte ", failure.offset); } }
    }

    /// Reparse to check mutable public fields cannot inject other components.
    /// Error offsets are -1 here because there is no original input string.
    public fn try_to_string(&self) -> Result<string, UrlError> {
        var output = StringBuilder.create();
        output.append(self.scheme); output.append("://");
        if (self.has_userinfo) { output.append(self.userinfo); output.appendChar(64); }
        let ipv6 = self.host.indexOf(":") >= 0;
        if (ipv6) { output.appendChar(91); }
        output.append(self.host);
        if (ipv6) { output.appendChar(93); }
        if (self.port.len > 0) { output.appendChar(58); output.append(self.port); }
        output.append(self.path);
        if (self.has_query) { output.appendChar(63); output.append(self.query); }
        if (self.has_fragment) { output.appendChar(35); output.append(self.fragment); }
        let owned = output.intoString();
        let text = owned.as_str().clone();
        match (Url.try_parse(text)) {
            Err(failure) => { failure.offset = -1; return Err(failure); }
            Ok(parsed) => {
                if (parsed.scheme != self.scheme || parsed.host != self.host || parsed.port != self.port || parsed.path != self.path
                    || parsed.query != self.query || parsed.fragment != self.fragment || parsed.userinfo != self.userinfo
                    || parsed.has_query != self.has_query || parsed.has_fragment != self.has_fragment || parsed.has_userinfo != self.has_userinfo) {
                    return Err(url_failure(UrlErrorKind.InvalidState, -1, "URL fields disagree with their delimiters"));
                }
            }
        }
        return Ok(text);
    }
    public fn toString(&self) -> string {
        match (self.try_to_string()) { Ok(value) => { return value; } Err(failure) => { panic("Url.toString: ", failure.message); } }
    }
}

impl Clone for Url {
    public fn clone(&self) -> Url {
        return Url { scheme: self.scheme.clone(), host: self.host.clone(), port: self.port.clone(), path: self.path.clone(),
            query: self.query.clone(), fragment: self.fragment.clone(), userinfo: self.userinfo.clone(),
            has_query: self.has_query, has_fragment: self.has_fragment, has_userinfo: self.has_userinfo };
    }
}

public class QueryPair { public key: string; public value: string; }
impl Clone for QueryPair {
    public fn clone(&self) -> QueryPair { return QueryPair { key: self.key.clone(), value: self.value.clone() }; }
}

fn url_encode_pairs(pairs: &Vec<QueryPair>, form: bool) -> string {
    var output = StringBuilder.create();
    var i: i64 = 0;
    while (i < pairs.len) {
        if (i > 0) { output.appendChar(38); }
        let pair = pairs.get_ref(i);
        output.append(url_encode_component(pair.key, form)); output.appendChar(61);
        output.append(url_encode_component(pair.value, form));
        i += 1;
    }
    let owned = output.intoString();
    return owned.as_str().clone();
}
public fn query_encode_pairs(pairs: &Vec<QueryPair>) -> string { return url_encode_pairs(pairs, false); }
public fn form_query_encode(pairs: &Vec<QueryPair>) -> string { return url_encode_pairs(pairs, true); }

fn url_decode_pairs(input: string, form: bool) -> Result<Vec<QueryPair>, UrlError> {
    var pairs = Vec::<QueryPair>.new();
    var begin: i64 = 0;
    while (begin < input.len) {
        var end = begin;
        var equal: i64 = -1;
        while (end < input.len && input.charAt(end) != 38) {
            if (equal < 0 && input.charAt(end) == 61) { equal = end; }
            end += 1;
        }
        if (end > begin) {
            let key_end = if (equal < 0) { end } else { equal };
            let value_begin = if (equal < 0) { end } else { equal + 1 };
            var key: string = "";
            var value: string = "";
            match (url_decode_component(input.substring(begin, key_end), form)) {
                Ok(decoded) => { key = decoded; }
                Err(failure) => { failure.offset += begin; return Err(failure); }
            }
            match (url_decode_component(input.substring(value_begin, end), form)) {
                Ok(decoded) => { value = decoded; }
                Err(failure) => { failure.offset += value_begin; return Err(failure); }
            }
            pairs.push(QueryPair { key: key, value: value });
        }
        begin = end + 1;
    }
    return Ok(pairs);
}
/// Keep duplicate keys, empty names/values and order; skip empty '&' segments.
public fn try_query_decode(input: string) -> Result<Vec<QueryPair>, UrlError> { return url_decode_pairs(input, false); }
public fn try_form_query_decode(input: string) -> Result<Vec<QueryPair>, UrlError> { return url_decode_pairs(input, true); }

/// Canonical dictionary serialization: byte-sorted keys, RFC percent encoding.
@[borrow_args]
public fn query_encode(params: Dict<string, string>) -> string {
    var keys = params.keys();
    keys.sort();
    var output = StringBuilder.create();
    var i: i64 = 0;
    while (i < keys.len) {
        if (i > 0) { output.appendChar(38); }
        let key = keys.get_ref(i);
        output.append(url_encode(*key)); output.appendChar(61); output.append(url_encode(params.get(*key)));
        i += 1;
    }
    let owned = output.intoString();
    return owned.as_str().clone();
}
