module std.math;

// Vyx Standard Library: Math Module
// Mathematical functions and constants

extern "C" {
    fn abs(x: i32) -> i32;
    fn fabs(x: f64) -> f64;
    fn floor(x: f64) -> f64;
    fn ceil(x: f64) -> f64;
    fn round(x: f64) -> f64;
    fn trunc(x: f64) -> f64;
    fn sqrt(x: f64) -> f64;
    fn cbrt(x: f64) -> f64;
    fn pow(x: f64, y: f64) -> f64;
    fn exp(x: f64) -> f64;
    fn exp2(x: f64) -> f64;
    fn log(x: f64) -> f64;
    fn log2(x: f64) -> f64;
    fn log10(x: f64) -> f64;
    fn sin(x: f64) -> f64;
    fn cos(x: f64) -> f64;
    fn tan(x: f64) -> f64;
    fn asin(x: f64) -> f64;
    fn acos(x: f64) -> f64;
    fn atan(x: f64) -> f64;
    fn atan2(y: f64, x: f64) -> f64;
    fn sinh(x: f64) -> f64;
    fn cosh(x: f64) -> f64;
    fn tanh(x: f64) -> f64;
}

// === Basic Math ===

public fn max(a: i32, b: i32) -> i32 {
    if (a > b) { a; } else { b; }
}

public fn min(a: i32, b: i32) -> i32 {
    if (a < b) { a; } else { b; }
}

public fn clamp(val: i32, lo: i32, hi: i32) -> i32 {
    max(lo, min(val, hi));
}

public fn abs_val(x: i32) -> i32 {
    abs(x);
}

public fn abs_f64(x: f64) -> f64 {
    return fabs(x);
}

public fn pi() -> f64 {
    return 3.14159265358979323846;
}

public fn tau() -> f64 {
    return 6.28318530717958647692;
}

public fn e() -> f64 {
    return 2.71828182845904523536;
}

public fn sign(x: i32) -> i32 {
    if (x > 0) { return 1; }
    if (x < 0) { return -1; }
    return 0;
}

// === Powers and Roots ===

public fn power(base: i32, exp: i32) -> i32 {
    var result = 1;
    var b = base;
    var e = exp;
    while (e > 0) {
        if (e % 2 == 1) { result = result * b; }
        b = b * b;
        e = e / 2;
    }
    result;
}

public fn isqrt(n: i32) -> i32 {
    if (n <= 1) { return n; }
    var x = n;
    var y = (x + 1) / 2;
    while (y < x) {
        x = y;
        y = (x + n / x) / 2;
    }
    x;
}

// === Number Theory ===

public fn gcd(a: i32, b: i32) -> i32 {
    var x = a;
    var y = b;
    while (y != 0) {
        let t = y;
        y = x % y;
        x = t;
    }
    x;
}

public fn lcm(a: i32, b: i32) -> i32 {
    a * b / gcd(a, b);
}

public fn is_prime(n: i32) -> i32 {
    if (n < 2) { return 0; }
    if (n < 4) { return 1; }
    if (n % 2 == 0) { return 0; }
    var d = 3;
    while (d * d <= n) {
        if (n % d == 0) { return 0; }
        d += 2;
    }
    return 1;
}

public fn factorial(n: i32) -> i32 {
    if (n <= 1) { return 1; }
    n * factorial(n - 1);
}

public fn fibonacci(n: i32) -> i32 {
    if (n <= 0) { return 0; }
    if (n == 1) { return 1; }
    var a = 0;
    var b = 1;
    for (var i = 2; i <= n; i++) {
        let next = a + b;
        a = b;
        b = next;
    }
    b;
}

// === Digit Operations ===

public fn count_digits(n: i32) -> i32 {
    var num = n;
    if (num < 0) { num = -num; }
    if (num == 0) { return 1; }
    var count = 0;
    while (num > 0) { count += 1; num = num / 10; }
    count;
}

public fn reverse_digits(n: i32) -> i32 {
    var num = n;
    var result = 0;
    while (num > 0) {
        result = result * 10 + num % 10;
        num = num / 10;
    }
    result;
}

public fn is_palindrome(n: i32) -> i32 {
    if (n == reverse_digits(n)) { return 1; }
    return 0;
}

public fn digital_root(n: i32) -> i32 {
    var val = n;
    while (val >= 10) {
        var sum = 0;
        while (val > 0) { sum += val % 10; val = val / 10; }
        val = sum;
    }
    val;
}
