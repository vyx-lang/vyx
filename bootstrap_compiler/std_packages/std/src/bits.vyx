module std.bits;

/// Bits — Bit Manipulation Utilities for Vyx
/// Usage: import std::bits;
///
/// Example:
///   print(popcount(255));    // 8
///   print(clz(16));          // 27 (leading zeros)
///   print(bit_set(0, 3));    // 8
///   print(bit_test(8, 3));   // true
///   print(bit_reverse(1));   // 2147483648

public fn popcount(x: i32) -> i32 {
    var v = x;
    v = v - ((v >> 1) & 1431655765);
    v = (v & 858993459) + ((v >> 2) & 858993459);
    v = (v + (v >> 4)) & 252645135;
    return (v * 16843009) >> 24;
}

public fn clz(x: i32) -> i32 {
    if (x == 0) { return 32; }
    var n = 0;
    var v = x;
    if ((v & -65536) == 0)  { n = n + 16; v = v << 16; }
    if ((v & -16777216) == 0) { n = n + 8; v = v << 8; }
    if ((v & -268435456) == 0) { n = n + 4; v = v << 4; }
    if ((v & -1073741824) == 0) { n = n + 2; v = v << 2; }
    if (v >= 0) { n = n + 1; }
    return n;
}

public fn ctz(x: i32) -> i32 {
    if (x == 0) { return 32; }
    var n = 0;
    var v = x;
    if ((v & 65535) == 0)   { n = n + 16; v = v >> 16; }
    if ((v & 255) == 0)     { n = n + 8; v = v >> 8; }
    if ((v & 15) == 0)      { n = n + 4; v = v >> 4; }
    if ((v & 3) == 0)       { n = n + 2; v = v >> 2; }
    if ((v & 1) == 0)       { n = n + 1; }
    return n;
}

public fn bit_set(value: i32, bit: i32) -> i32 {
    return value | (1 << bit);
}

public fn bit_clear(value: i32, bit: i32) -> i32 {
    return value & (~(1 << bit));
}

public fn bit_toggle(value: i32, bit: i32) -> i32 {
    return value ^ (1 << bit);
}

public fn bit_test(value: i32, bit: i32) -> bool {
    return (value & (1 << bit)) != 0;
}

public fn next_pow2(x: i32) -> i32 {
    var v = x - 1;
    v = v | (v >> 1);
    v = v | (v >> 2);
    v = v | (v >> 4);
    v = v | (v >> 8);
    v = v | (v >> 16);
    return v + 1;
}

public fn is_pow2(x: i32) -> bool {
    return x > 0 && (x & (x - 1)) == 0;
}

public fn log2(x: i32) -> i32 {
    return 31 - clz(x);
}

public fn rotate_left(value: i32, amount: i32) -> i32 {
    let n = amount & 31;
    return (value << n) | ((value >> (32 - n)) & ((1 << n) - 1));
}

public fn rotate_right(value: i32, amount: i32) -> i32 {
    let n = amount & 31;
    return ((value >> n) & ((1 << (32 - n)) - 1)) | (value << (32 - n));
}

public fn byte_swap(x: i32) -> i32 {
    return ((x & 255) << 24) |
           (((x >> 8) & 255) << 16) |
           (((x >> 16) & 255) << 8) |
           ((x >> 24) & 255);
}
