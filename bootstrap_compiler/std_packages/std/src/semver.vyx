module std.semver;

use std.core;
use std.string;
use std.hash;
use std.clone;

public error SemVerErrorKind { InvalidCore, InvalidIdentifier, LeadingZero, Overflow }

/// offset is a byte position in try_parse's input (including end of input).
/// Value construction/validation/increment errors use -1 instead.
public class SemVerError {
    public kind: SemVerErrorKind;
    public offset: i64;
    public message: string;
}

fn semver_failure(kind: SemVerErrorKind, offset: i64, message: string) -> SemVerError {
    return SemVerError { kind: kind, offset: offset, message: message };
}

fn semver_digit(ch: i32) -> bool { return ch >= 48 && ch <= 57; }

fn semver_check_identifiers(text: string, start: i64, end: i64, prerelease: bool) -> Result<bool, SemVerError> {
    var begin = start;
    var numeric = true;
    var i = start;
    while (i <= end) {
        if (i == end || text.charAt(i) == 46) {
            if (i == begin) {
                return Err(semver_failure(SemVerErrorKind.InvalidIdentifier, i, "empty SemVer identifier"));
            }
            if (prerelease && numeric && i - begin > 1 && text.charAt(begin) == 48) {
                return Err(semver_failure(SemVerErrorKind.LeadingZero, begin, "numeric prerelease has a leading zero"));
            }
            begin = i + 1;
            numeric = true;
        } else {
            let ch = text.charAt(i);
            if (!semver_digit(ch)) {
                numeric = false;
                if (!((ch >= 65 && ch <= 90) || (ch >= 97 && ch <= 122) || ch == 45)) {
                    return Err(semver_failure(SemVerErrorKind.InvalidIdentifier, i, "invalid SemVer identifier byte"));
                }
            }
        }
        i += 1;
    }
    return Ok(true);
}

// Compare prerelease identifiers without integer conversion or substring
// allocation. Numeric identifiers may be longer than any native integer.
fn semver_prerelease_compare(left: string, right: string) -> i32 {
    if (left.len == 0 && right.len == 0) { return 0; }
    if (left.len == 0) { return 1; }
    if (right.len == 0) { return -1; }
    var a: i64 = 0;
    var b: i64 = 0;
    while (a < left.len && b < right.len) {
        var ae = a;
        var be = b;
        var an = true;
        var bn = true;
        while (ae < left.len && left.charAt(ae) != 46) {
            if (!semver_digit(left.charAt(ae))) { an = false; }
            ae += 1;
        }
        while (be < right.len && right.charAt(be) != 46) {
            if (!semver_digit(right.charAt(be))) { bn = false; }
            be += 1;
        }
        if (an && !bn) { return -1; }
        if (!an && bn) { return 1; }
        let al = ae - a;
        let bl = be - b;
        if (an && bn && al != bl) { return if (al < bl) { -1 } else { 1 }; }
        var i: i64 = 0;
        while (i < al && i < bl) {
            let ac = left.charAt(a + i);
            let bc = right.charAt(b + i);
            if (ac != bc) { return if (ac < bc) { -1 } else { 1 }; }
            i += 1;
        }
        if (al != bl) { return if (al < bl) { -1 } else { 1 }; }
        if (ae == left.len && be == right.len) { return 0; }
        if (ae == left.len) { return -1; }
        if (be == right.len) { return 1; }
        a = ae + 1;
        b = be + 1;
    }
    return 0;
}

/// SemVer 2.0 syntax and precedence, with checked i32 core components.
/// No whitespace trimming, v prefix, partial versions or range expressions.
public class SemVer {
    public major: i32;
    public minor: i32;
    public patch: i32;
    public prerelease: string;
    public build: string;

    public static fn try_create(major: i32, minor: i32, patch: i32) -> Result<SemVer, SemVerError> {
        if (major < 0 || minor < 0 || patch < 0) {
            return Err(semver_failure(SemVerErrorKind.InvalidCore, -1, "negative SemVer component"));
        }
        return Ok(SemVer { major: major, minor: minor, patch: patch, prerelease: "", build: "" });
    }

    public static fn create(major: i32, minor: i32, patch: i32) -> SemVer {
        match (SemVer.try_create(major, minor, patch)) {
            Ok(value) => { return value; }
            Err(failure) => { panic("SemVer.create: ", failure.message); }
        }
    }

    public static fn try_parse(version: string) -> Result<SemVer, SemVerError> {
        var major: i32 = 0;
        var minor: i32 = 0;
        var patch: i32 = 0;
        var i: i64 = 0;
        var part: i32 = 0;
        while (part < 3) {
            let begin = i;
            var value: i64 = 0;
            while (i < version.len && semver_digit(version.charAt(i))) {
                if (i > begin && version.charAt(begin) == 48) {
                    return Err(semver_failure(SemVerErrorKind.LeadingZero, begin, "SemVer core has a leading zero"));
                }
                value = value * 10 + (version.charAt(i) - 48) as i64;
                if (value > 2147483647) {
                    return Err(semver_failure(SemVerErrorKind.Overflow, i, "SemVer core exceeds i32"));
                }
                i += 1;
            }
            if (i == begin) {
                return Err(semver_failure(SemVerErrorKind.InvalidCore, i, "expected a SemVer core number"));
            }
            if (part == 0) { major = value as i32; }
            else if (part == 1) { minor = value as i32; }
            else { patch = value as i32; }
            if (part < 2) {
                if (i == version.len || version.charAt(i) != 46) {
                    return Err(semver_failure(SemVerErrorKind.InvalidCore, i, "expected a SemVer core dot"));
                }
                i += 1;
            }
            part += 1;
        }
        var prerelease: string = "";
        var build: string = "";
        if (i < version.len && version.charAt(i) == 45) {
            i += 1;
            let begin = i;
            while (i < version.len && version.charAt(i) != 43) { i += 1; }
            match (semver_check_identifiers(version, begin, i, true)) {
                Err(failure) => { return Err(failure); }
                Ok(_) => {}
            }
            prerelease = version.substring(begin, i);
        }
        if (i < version.len && version.charAt(i) == 43) {
            let begin = i + 1;
            match (semver_check_identifiers(version, begin, version.len, false)) {
                Err(failure) => { return Err(failure); }
                Ok(_) => {}
            }
            build = version.substring(begin, version.len);
            i = version.len;
        }
        if (i != version.len) {
            return Err(semver_failure(SemVerErrorKind.InvalidCore, i, "unexpected byte after SemVer core"));
        }
        return Ok(SemVer { major: major, minor: minor, patch: patch, prerelease: prerelease, build: build });
    }

    public static fn parse(version: string) -> SemVer {
        match (SemVer.try_parse(version)) {
            Ok(value) => { return value; }
            Err(failure) => { panic("SemVer.parse: ", failure.message, " at byte ", failure.offset); }
        }
    }

    /// Check public fields too: callers may have constructed/edited a value.
    public fn try_validate(&self) -> Result<bool, SemVerError> {
        if (self.major < 0 || self.minor < 0 || self.patch < 0) {
            return Err(semver_failure(SemVerErrorKind.InvalidCore, -1, "negative SemVer component"));
        }
        if (self.prerelease.len > 0) {
            match (semver_check_identifiers(self.prerelease, 0, self.prerelease.len, true)) {
                Err(failure) => { failure.offset = -1; return Err(failure); }
                Ok(_) => {}
            }
        }
        if (self.build.len > 0) {
            match (semver_check_identifiers(self.build, 0, self.build.len, false)) {
                Err(failure) => { failure.offset = -1; return Err(failure); }
                Ok(_) => {}
            }
        }
        return Ok(true);
    }

    public fn toString(&self) -> string {
        match (self.try_validate()) {
            Err(failure) => { panic("SemVer.toString: ", failure.message); }
            Ok(_) => {}
        }
        var text = format("%d.%d.%d", self.major, self.minor, self.patch);
        if (self.prerelease.len > 0) { text = text + "-" + self.prerelease; }
        if (self.build.len > 0) { text = text + "+" + self.build; }
        return text;
    }

    @[borrow_args]
    public fn try_compare(&self, other: SemVer) -> Result<i32, SemVerError> {
        match (self.try_validate()) { Err(failure) => { return Err(failure); } Ok(_) => {} }
        match (other.try_validate()) { Err(failure) => { return Err(failure); } Ok(_) => {} }
        if (self.major != other.major) { return Ok(if (self.major < other.major) { -1 } else { 1 }); }
        if (self.minor != other.minor) { return Ok(if (self.minor < other.minor) { -1 } else { 1 }); }
        if (self.patch != other.patch) { return Ok(if (self.patch < other.patch) { -1 } else { 1 }); }
        return Ok(semver_prerelease_compare(self.prerelease, other.prerelease));
    }

    /// Precedence equality/order ignores build metadata, as required by SemVer.
    @[borrow_args]
    public fn compareTo(&self, other: SemVer) -> i32 {
        match (self.try_compare(other)) {
            Ok(order) => { return order; }
            Err(failure) => { panic("SemVer.compareTo: ", failure.message); }
        }
    }

    @[borrow_args]
    public fn greaterThan(&self, other: SemVer) -> bool { return self.compareTo(other) > 0; }
    @[borrow_args]
    public fn lessThan(&self, other: SemVer) -> bool { return self.compareTo(other) < 0; }
    @[borrow_args]
    public fn equals(&self, other: SemVer) -> bool { return self.compareTo(other) == 0; }
    public fn isPrerelease(&self) -> bool { return self.prerelease.len > 0; }

    public fn try_bump_major(&self) -> Result<SemVer, SemVerError> {
        match (self.try_validate()) { Err(failure) => { return Err(failure); } Ok(_) => {} }
        if (self.major == 2147483647) { return Err(semver_failure(SemVerErrorKind.Overflow, -1, "SemVer major increment exceeds i32")); }
        return SemVer.try_create(self.major + 1, 0, 0);
    }
    public fn try_bump_minor(&self) -> Result<SemVer, SemVerError> {
        match (self.try_validate()) { Err(failure) => { return Err(failure); } Ok(_) => {} }
        if (self.minor == 2147483647) { return Err(semver_failure(SemVerErrorKind.Overflow, -1, "SemVer minor increment exceeds i32")); }
        return SemVer.try_create(self.major, self.minor + 1, 0);
    }
    public fn try_bump_patch(&self) -> Result<SemVer, SemVerError> {
        match (self.try_validate()) { Err(failure) => { return Err(failure); } Ok(_) => {} }
        if (self.patch == 2147483647) { return Err(semver_failure(SemVerErrorKind.Overflow, -1, "SemVer patch increment exceeds i32")); }
        return SemVer.try_create(self.major, self.minor, self.patch + 1);
    }
    public fn bumpMajor(&self) -> SemVer {
        match (self.try_bump_major()) { Ok(value) => { return value; } Err(failure) => { panic("SemVer.bumpMajor: ", failure.message); } }
    }
    public fn bumpMinor(&self) -> SemVer {
        match (self.try_bump_minor()) { Ok(value) => { return value; } Err(failure) => { panic("SemVer.bumpMinor: ", failure.message); } }
    }
    public fn bumpPatch(&self) -> SemVer {
        match (self.try_bump_patch()) { Ok(value) => { return value; } Err(failure) => { panic("SemVer.bumpPatch: ", failure.message); } }
    }
}

/// Legacy decimal helper, now checked instead of skipping invalid bytes.
public fn parse_int(text: string) -> i32 {
    if (text.len == 0) { panic("semver.parse_int: expected decimal digits"); }
    if (text.len > 1 && text.charAt(0) == 48) { panic("semver.parse_int: leading zero"); }
    var value: i64 = 0;
    var i: i64 = 0;
    while (i < text.len) {
        let ch = text.charAt(i);
        if (!semver_digit(ch)) { panic("semver.parse_int: expected decimal digits"); }
        value = value * 10 + (ch - 48) as i64;
        if (value > 2147483647) { panic("semver.parse_int: value exceeds i32"); }
        i += 1;
    }
    return value as i32;
}

/// Deep copy of both owned identifier strings.
impl Clone for SemVer {
    public fn clone(&self) -> SemVer {
        return SemVer { major: self.major, minor: self.minor, patch: self.patch,
            prerelease: self.prerelease.clone(), build: self.build.clone() };
    }
}

impl Eq for SemVer {
    @[borrow_args]
    public fn operator_eq(&self, other: SemVer) -> bool { return self.equals(other); }
}
impl Ord for SemVer {
    @[borrow_args]
    public fn compare(&self, other: SemVer) -> i32 { return self.compareTo(other); }
}
impl Hashable for SemVer {
    public fn hash(&self) -> i64 {
        match (self.try_validate()) {
            Err(failure) => { panic("SemVer.hash: ", failure.message); }
            Ok(_) => {}
        }
        var hash = hash_i64(self.major as i64);
        hash = hash_i64(hash ^ (self.minor as i64));
        hash = hash_i64(hash ^ (self.patch as i64));
        return hash_i64(hash ^ hash_string(self.prerelease));
    }
}
