module std.threading;

/// Vyx OS threads. Handles are opaque `rawptr` values from `vyx_th_spawn`
/// (Win32 CreateThread / POSIX pthread). This is not a C++ `std::thread` wrapper.

extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
    fn vyx_th_available_parallelism() -> i32;
    fn vyx_th_spawn(fn_ptr: rawptr, arg: rawptr, stack: u64, name: rawptr) -> rawptr;
    fn vyx_th_join(handle: rawptr, result_out: rawptr) -> i32;
    fn vyx_th_detach(handle: rawptr) -> i32;
    fn vyx_th_current_id() -> i64;
    fn vyx_th_yield();
    fn vyx_th_sleep_ns(ns: u64);
    fn vyx_th_thread_parker(handle: rawptr) -> rawptr;
    fn vyx_th_current_parker() -> rawptr;
    fn vyx_th_park();
    fn vyx_th_park_ns(ns: u64) -> i32;
    fn vyx_th_unpark(parker: rawptr);
}

/// Hardware threads the process may use (affinity-aware).
public fn thread_available_parallelism() -> i32 {
    let n = vyx_th_available_parallelism();
    if (n < 1) { return 1; }
    return n;
}

/// Spawn `fn_ptr(param)` on a new OS thread. `fn_ptr` is `fn(rawptr) -> i64`.
public fn thread_spawn(fn_ptr: rawptr, param: rawptr) -> rawptr {
    return vyx_th_spawn(fn_ptr, param, 0, null);
}

public fn thread_spawn_named(fn_ptr: rawptr, param: rawptr, name: string) -> rawptr {
    return vyx_th_spawn(fn_ptr, param, 0, name.c_str());
}

public fn thread_spawn_with(fn_ptr: rawptr, param: rawptr, stack: u64, name: string) -> rawptr {
    var name_ptr: rawptr = null;
    if (name.len > 0) { name_ptr = name.c_str(); }
    return vyx_th_spawn(fn_ptr, param, stack, name_ptr);
}

public fn thread_join(handle: rawptr) {
    if (handle == null) { return; }
    vyx_th_join(handle, null);
}

public fn thread_join_result(handle: rawptr) -> i64 {
    if (handle == null) { return 0; }
    var result: i64 = 0;
    vyx_th_join(handle, to_rawptr(&result));
    return result;
}

public fn thread_detach(handle: rawptr) {
    if (handle == null) { return; }
    vyx_th_detach(handle);
}

public fn thread_join_all(handles: rawptr, count: i64) {
    var i: i64 = 0;
    while (i < count) {
        var h: rawptr = null;
        unsafe { memcpy(to_rawptr(&h), handles + i * 8, 8); }
        thread_join(h);
        i = i + 1;
    }
}

public fn thread_id() -> i64 {
    return vyx_th_current_id();
}

public fn thread_yield() {
    vyx_th_yield();
}

public fn thread_sleep_ms(ms: i64) {
    var n = ms;
    if (n < 0) { n = 0; }
    vyx_th_sleep_ns((n as u64) * 1000000);
}

public fn thread_sleep_ns(ns: i64) {
    var n = ns;
    if (n < 0) { n = 0; }
    vyx_th_sleep_ns(n as u64);
}

public fn thread_park() {
    vyx_th_park();
}

/// 0 = notified, 1 = timeout.
public fn thread_park_ms(ms: i64) -> i32 {
    var n = ms;
    if (n < 0) { n = 0; }
    return vyx_th_park_ns((n as u64) * 1000000);
}

public fn thread_unpark(parker: rawptr) {
    vyx_th_unpark(parker);
}

public fn thread_parker(handle: rawptr) -> rawptr {
    return vyx_th_thread_parker(handle);
}

public fn thread_current_parker() -> rawptr {
    return vyx_th_current_parker();
}
