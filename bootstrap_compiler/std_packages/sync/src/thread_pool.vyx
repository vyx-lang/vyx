module std.thread_pool;

/// Work-stealing pool via oneTBB (`tbb::parallel_for` / `tbb::task_group`).
/// This module depends on TBB, not on wrapping C++ `std::thread`.
///
/// Job bodies are C-ABI callbacks: `@[no_mangle] fn body(ctx: rawptr, i: i64)`.
/// Pass the function by name, the same way a `cfn` slot accepts it. Vyx `fn`
/// values are fat pointers and cannot cross a C callback boundary, so there is
/// intentionally no `rawptr` overload — a bare pointer cannot be called back
/// safely.

extern "C" {
    fn vyx_tbb_max_concurrency() -> i32;
    fn vyx_tbb_parallel_for(n: i64, body: cfn(rawptr, i64) -> void, ctx: rawptr) -> i32;
    fn vyx_tbb_task_group_run_n(n: i64, body: cfn(rawptr, i64) -> void, ctx: rawptr) -> i32;
    fn vyx_tbb_arena_new(nthreads: i32) -> rawptr;
    fn vyx_tbb_arena_max_concurrency(arena: rawptr) -> i32;
    fn vyx_tbb_arena_parallel_for(arena: rawptr, n: i64, body: cfn(rawptr, i64) -> void, ctx: rawptr) -> i32;
    fn vyx_tbb_arena_free(arena: rawptr);
}

/// Hardware threads the TBB pool schedules on (affinity-aware, always >= 1).
public fn pool_max_concurrency() -> i32 {
    let n = vyx_tbb_max_concurrency();
    if (n < 1) { return 1; }
    return n;
}

/// Run `body(ctx, i)` for every `i` in `0..n` on the work-stealing pool.
/// Iterations are chunked automatically across threads; there is no ordering
/// guarantee and no implicit synchronization — writes must target disjoint
/// slots (e.g. `ctx + i * elem_size`).
///
/// ```vyx
/// @[no_mangle]
/// fn fill(ctx: rawptr, i: i64) {
///     var two: i64 = 2;
///     memcpy(ctx + i * 8, to_rawptr(&two), 8);
/// }
/// ...
/// parallel_for(4096, fill, buf);
/// ```
public fn parallel_for(n: i64, body: cfn(rawptr, i64) -> void, ctx: rawptr) {
    if (n <= 0) { return; }
    if (vyx_tbb_parallel_for(n, body, ctx) != 0) {
        panic("tbb parallel_for failed");
    }
}

/// One TBB task per index. Prefer this when the N bodies have uneven cost
/// (e.g. compile graph units); `parallel_for` chunks evenly instead.
public fn task_group_run(n: i64, body: cfn(rawptr, i64) -> void, ctx: rawptr) {
    if (n <= 0) { return; }
    if (vyx_tbb_task_group_run_n(n, body, ctx) != 0) {
        panic("tbb task_group failed");
    }
}

/// Bound the pool to at most `nthreads` workers (`tbb::task_arena`).
/// `nthreads <= 0` means "hardware concurrency".
public fn arena_new(nthreads: i32) -> rawptr {
    return vyx_tbb_arena_new(nthreads);
}

public fn arena_max_concurrency(arena: rawptr) -> i32 {
    return vyx_tbb_arena_max_concurrency(arena);
}

/// `parallel_for` restricted to a dedicated arena (limits nesting oversubscription).
public fn arena_parallel_for(arena: rawptr, n: i64, body: cfn(rawptr, i64) -> void, ctx: rawptr) {
    if (n <= 0) { return; }
    if (vyx_tbb_arena_parallel_for(arena, n, body, ctx) != 0) {
        panic("tbb arena parallel_for failed");
    }
}

public fn arena_free(arena: rawptr) {
    if (arena == null) { return; }
    vyx_tbb_arena_free(arena);
}
