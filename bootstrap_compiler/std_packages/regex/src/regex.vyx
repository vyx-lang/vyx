module std.regex;

use std.core;
use std.string;
use std.collections;

extern "C" {
    fn pcre2_compile_8(pattern: rawptr, length: u64, flags: u32, failure: *i32, offset: *u64, context: rawptr) -> rawptr;
    fn pcre2_code_free_8(code: rawptr);
    fn pcre2_pattern_info_8(code: rawptr, what: u32, output: rawptr) -> i32;
    fn pcre2_substring_number_from_name_8(code: rawptr, name: rawptr) -> i32;
    fn pcre2_get_error_message_8(code: i32, buffer: rawptr, size: u64) -> i32;
    fn pcre2_match_data_create_from_pattern_8(code: rawptr, context: rawptr) -> rawptr;
    fn pcre2_match_data_free_8(data: rawptr);
    fn pcre2_match_context_create_8(context: rawptr) -> rawptr;
    fn pcre2_match_context_free_8(context: rawptr);
    fn pcre2_set_match_limit_8(context: rawptr, limit: u32) -> i32;
    fn pcre2_set_depth_limit_8(context: rawptr, limit: u32) -> i32;
    fn pcre2_set_heap_limit_8(context: rawptr, limit: u32) -> i32;
    fn pcre2_match_8(code: rawptr, subject: rawptr, length: u64, start: u64, flags: u32, data: rawptr, context: rawptr) -> i32;
    fn pcre2_get_ovector_count_8(data: rawptr) -> u32;
    fn pcre2_get_ovector_pointer_8(data: rawptr) -> *u64;
}

// Own scratch in Vyx so every early return releases partially created state.
class RegexScratch {
    public data: rawptr;
    public context: rawptr;
    public fn drop() {
        if (self.data != null) { pcre2_match_data_free_8(self.data); self.data = null; }
        if (self.context != null) { pcre2_match_context_free_8(self.context); self.context = null; }
    }
}

public class RegexError {
    public code: i32;
    public offset: i64;
    public message: String;
    public fn drop() { self.message.destroy(); }
}
fn regex_failure(code: i32, offset: i64) -> RegexError {
    if (code == -1000) { return RegexError { code: code, offset: offset, message: String.from("regex input, pattern, capture count or resource limit exceeds supported range") }; }
    var buffer = Vec::<u8>.with_capacity(256);
    var i: i32 = 0;
    while (i < 256) { buffer.push(0 as u8); i += 1; }
    let length = pcre2_get_error_message_8(code, buffer.data, 256 as u64);
    let message = if (length >= 0) { String.fromBytes(buffer.data, length as i64) } else { String.from("unknown regex engine error") };
    return RegexError { code: code, offset: offset, message: message };
}

public class RegexOptions {
    public case_insensitive: bool;
    public multiline: bool;
    public dot_all: bool;
    public unicode: bool;
    public static fn defaults() -> RegexOptions { return RegexOptions { case_insensitive: false, multiline: false, dot_all: false, unicode: true }; }
}
public class RegexLimits {
    public steps: i64;
    public depth: i64;
    public heap_kib: i64;
    public static fn defaults() -> RegexLimits { return RegexLimits { steps: 1000000, depth: 1000, heap_kib: 8192 }; }
}

/// Immutable subject snapshot. Capture offsets are UTF-8 byte offsets;
/// None is an unmatched group, Some("") is a matched empty group.
public class RegexMatch {
    subject: String;
    spans: Vec<i64>;
    public fn start(&self) -> i64 { return self.spans.get(0); }
    public fn end(&self) -> i64 { return self.spans.get(1); }
    public fn group_count(&self) -> i64 { return self.spans.len / 2; }
    public fn group(&self, index: i64) -> Result<Option<String>, RegexError> {
        if (index < 0 || index >= self.group_count()) { return Err(regex_failure(-1000, index)); }
        let a = self.spans.get(index * 2);
        let b = self.spans.get(index * 2 + 1);
        if (a < 0) { return Ok(None); }
        return Ok(Some(String.fromBytes(self.subject.c_str() + a, b - a)));
    }
    public fn drop() { self.subject.destroy(); self.spans.destroy(); }
}

/// PCRE2 10.49 interpreter. JIT is disabled; each match has explicit
/// step, depth and heap limits. Compiled patterns are owned, move-only.
public class Regex {
    handle: rawptr;
    public static fn compile(pattern: string) -> Result<Regex, RegexError> { return Regex.compile_with(pattern, RegexOptions.defaults()); }
    public static fn compile_with(pattern: string, options: RegexOptions) -> Result<Regex, RegexError> {
        if (pattern.len > 65536) { return Err(regex_failure(-1000, -1)); }
        // PCRE2 public option constants; the library's own C header defines
        // their ABI. No generated wrapper or extra exported ABI is involved.
        var flags: u32 = 1048576 as u32; // PCRE2_NEVER_BACKSLASH_C
        if (options.case_insensitive) { flags |= 8 as u32; }
        if (options.multiline) { flags |= 1024 as u32; }
        if (options.dot_all) { flags |= 32 as u32; }
        if (options.unicode) { flags |= 655360 as u32; } // UTF | UCP
        var failure: i32 = 0;
        var offset: u64 = 0;
        let handle = pcre2_compile_8(pattern.ptr, pattern.len as u64, flags, &failure, &offset, null);
        if (handle == null) { return Err(regex_failure(failure, offset as i64)); }
        var count: u32 = 0;
        let status = pcre2_pattern_info_8(handle, 4 as u32, to_rawptr(&count));
        if (status != 0 || count > 256 as u32) {
            pcre2_code_free_8(handle);
            return Err(regex_failure(if (status != 0) { status } else { -1000 }, -1));
        }
        return Ok(Regex { handle: handle });
    }
    public fn group_number(&self, name: string) -> Result<i32, RegexError> {
        if (self.handle == null || name.len == 0 || name.indexOf("\0") >= 0) { return Err(regex_failure(-1000, -1)); }
        let index = pcre2_substring_number_from_name_8(self.handle, name.c_str());
        if (index < 0) { return Err(regex_failure(index, -1)); }
        return Ok(index);
    }
    public fn find(&self, text: string) -> Result<Option<RegexMatch>, RegexError> { return self.find_from(text, 0, false, RegexLimits.defaults()); }
    public fn full_match(&self, text: string) -> Result<Option<RegexMatch>, RegexError> { return self.find_from(text, 0, true, RegexLimits.defaults()); }
    public fn find_from(&self, text: string, start: i64, full: bool, limits: RegexLimits) -> Result<Option<RegexMatch>, RegexError> {
        if (self.handle == null || text.len > 16777216 || start < 0 || start > text.len
            || limits.steps < 1 || limits.steps > 4294967295
            || limits.depth < 1 || limits.depth > 4294967295
            || limits.heap_kib < 1 || limits.heap_kib > 65536) { return Err(regex_failure(-1000, start)); }
        var scratch = RegexScratch { data: null, context: null };
        scratch.data = pcre2_match_data_create_from_pattern_8(self.handle, null);
        scratch.context = pcre2_match_context_create_8(null);
        if (scratch.data == null || scratch.context == null) { return Err(regex_failure(-48, -1)); }
        pcre2_set_match_limit_8(scratch.context, limits.steps as u32);
        pcre2_set_depth_limit_8(scratch.context, limits.depth as u32);
        pcre2_set_heap_limit_8(scratch.context, limits.heap_kib as u32);
        let flags: u32 = if (full) { 2684354560 as u32 } else { 0 as u32 }; // ANCHORED | ENDANCHORED
        let result = pcre2_match_8(self.handle, text.ptr, text.len as u64, start as u64, flags, scratch.data, scratch.context);
        if (result == -1) { return Ok(None); }
        if (result < 0) { return Err(regex_failure(result, start)); }
        let groups = pcre2_get_ovector_count_8(scratch.data) as i64;
        var spans = Vec::<i64>.with_capacity(groups * 2);
        let vector = pcre2_get_ovector_pointer_8(scratch.data);
        var i: i64 = 0;
        while (i < groups * 2) {
            var position: u64 = 0;
            unsafe { position = vector[i]; }
            spans.push(if (position == 18446744073709551615 as u64) { -1 } else { position as i64 });
            i += 1;
        }
        return Ok(Some(RegexMatch { subject: String.from(text), spans: spans }));
    }
    public fn destroy() { self.drop(); }
    public fn drop() { if (self.handle != null) { pcre2_code_free_8(self.handle); self.handle = null; } }
}

/// Vyx Standard Library: Regex Module
/// Character classification, glob matching, and simple pattern matching.

extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, n: i64) -> rawptr;
}

// ── Character classification ──

public fn match_char(ch: i32, pattern_ch: i32) -> i32 {
    if (pattern_ch == 46) { return 1; }
    if (ch == pattern_ch) { return 1; }
    return 0;
}

public fn is_word_char(ch: i32) -> i32 {
    if (ch >= 65 && ch <= 90) { return 1; }
    if (ch >= 97 && ch <= 122) { return 1; }
    if (ch >= 48 && ch <= 57) { return 1; }
    if (ch == 95) { return 1; }
    return 0;
}

public fn is_digit_char(ch: i32) -> i32 {
    if (ch >= 48 && ch <= 57) { return 1; }
    return 0;
}

public fn is_hex_char(ch: i32) -> i32 {
    if (ch >= 48 && ch <= 57) { return 1; }
    if (ch >= 65 && ch <= 70) { return 1; }
    if (ch >= 97 && ch <= 102) { return 1; }
    return 0;
}

public fn is_whitespace(ch: i32) -> i32 {
    if (ch == 32 || ch == 9 || ch == 10 || ch == 13) { return 1; }
    return 0;
}

public fn is_upper(ch: i32) -> i32 {
    if (ch >= 65 && ch <= 90) { return 1; }
    return 0;
}

public fn is_lower(ch: i32) -> i32 {
    if (ch >= 97 && ch <= 122) { return 1; }
    return 0;
}

public fn is_alpha(ch: i32) -> i32 {
    if (is_upper(ch) == 1 || is_lower(ch) == 1) { return 1; }
    return 0;
}

public fn is_alnum(ch: i32) -> i32 {
    if (is_alpha(ch) == 1 || is_digit_char(ch) == 1) { return 1; }
    return 0;
}

public fn to_upper(ch: i32) -> i32 {
    if (is_lower(ch) == 1) { return ch - 32; }
    return ch;
}

public fn to_lower(ch: i32) -> i32 {
    if (is_upper(ch) == 1) { return ch + 32; }
    return ch;
}

// ── String scanning helpers ──

public fn scan_while_word(s: string, start: i64) -> i64 {
    if (start < 0 || start > s.len) { panic("scan_while_word: start outside string"); }
    var pos = start;
    while (pos < s.len) {
        var ch: i32 = 0;
        unsafe { memcpy(to_rawptr(&ch), s.ptr + pos, 1); }
        ch = ch & 255;
        if (is_word_char(ch) == 0) { break; }
        pos += 1;
    }
    return pos;
}

public fn scan_while_digit(s: string, start: i64) -> i64 {
    if (start < 0 || start > s.len) { panic("scan_while_digit: start outside string"); }
    var pos = start;
    while (pos < s.len) {
        var ch: i32 = 0;
        unsafe { memcpy(to_rawptr(&ch), s.ptr + pos, 1); }
        ch = ch & 255;
        if (is_digit_char(ch) == 0) { break; }
        pos += 1;
    }
    return pos;
}

public fn scan_while_ws(s: string, start: i64) -> i64 {
    if (start < 0 || start > s.len) { panic("scan_while_ws: start outside string"); }
    var pos = start;
    while (pos < s.len) {
        var ch: i32 = 0;
        unsafe { memcpy(to_rawptr(&ch), s.ptr + pos, 1); }
        ch = ch & 255;
        if (is_whitespace(ch) == 0) { break; }
        pos += 1;
    }
    return pos;
}

public fn char_at(s: string, idx: i64) -> i32 {
    if (idx < 0 || idx >= s.len) { return -1; }
    var ch: i32 = 0;
    unsafe { memcpy(to_rawptr(&ch), s.ptr + idx, 1); }
    return ch & 255;
}

// ── Glob matching (*, ?) ──

public fn glob_match(pattern: string, text: string) -> bool {
    var pi: i64 = 0;
    var ti: i64 = 0;
    var star_pi: i64 = -1;
    var star_ti: i64 = -1;

    while (ti < text.len) {
        let pc = char_at(pattern, pi);
        let tc = char_at(text, ti);
        if (pi < pattern.len && pc == 63) {
            pi += 1;
            ti += 1;
        } elif (pi < pattern.len && tc == pc && pc != 42) {
            pi += 1;
            ti += 1;
        } elif (pi < pattern.len && pc == 42) {
            star_pi = pi;
            star_ti = ti;
            pi += 1;
        } elif (star_pi >= 0) {
            pi = star_pi + 1;
            star_ti += 1;
            ti = star_ti;
        } else {
            return false;
        }
    }
    while (pi < pattern.len && char_at(pattern, pi) == 42) {
        pi += 1;
    }
    return pi == pattern.len;
}

// ── Simple wildcard search ──

public fn wildcard_find(text: string, pattern: string) -> i64 {
    var i: i64 = 0;
    while (i <= text.len - pattern.len) {
        var matched = true;
        var j: i64 = 0;
        while (j < pattern.len) {
            let pc = char_at(pattern, j);
            if (pc != 63 && match_char(char_at(text, i + j), pc) == 0) {
                matched = false;
                break;
            }
            j += 1;
        }
        if (matched) { return i; }
        i += 1;
    }
    return -1;
}
