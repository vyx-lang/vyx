module std.serde;

use std.collections;
use std.string;

/// std/serde.vyx — Serialization/Deserialization framework
///
/// Provides traits for converting between Vyx types and common formats.

public trait Serialize {
    fn serialize() -> string;
}

// `Deserialize` trait elided — `Self` as a return type is not yet
// representable in Vyx traits. Use an explicit concrete-type `from_json`
// method on each class instead.

public trait SerializeTo {
    fn serialize_json() -> string;
    fn serialize_toml() -> string;
}

public class JsonSerializer {
    public static fn encode_string(s: string) -> string {
        var result = "\"";
        for (i in 0..s.len) {
            // `charAt` yields the byte code (an indexed slice does too), so
            // compare numerically and rebuild the character via `substring`.
            let c = s.charAt(i);
            if (c == 34) { result = result + "\\\""; }
            else if (c == 92) { result = result + "\\\\"; }
            else if (c == 10) { result = result + "\\n"; }
            else if (c == 9) { result = result + "\\t"; }
            else if (c == 13) { result = result + "\\r"; }
            else { result = result + s.substring(i, i + 1); }
        }
        result = result + "\"";
        return result;
    }

    public static fn encode_int(v: i64) -> string {
        return v.toString();
    }

    public static fn encode_float(v: f64) -> string {
        return v.toString();
    }

    public static fn encode_bool(v: bool) -> string {
        if (v) { return "true"; }
        return "false";
    }

    public static fn encode_null() -> string {
        return "null";
    }

    public static fn encode_array(items: Vec<string>) -> string {
        var result = "[";
        for (i in 0..items.len) {
            if (i > 0) { result += ","; }
            result += items.get(i);
        }
        result += "]";
        return result;
    }

    public static fn encode_object(keys: Vec<string>, values: Vec<string>) -> string {
        var result = "{";
        for (i in 0..keys.len) {
            if (i > 0) { result += ","; }
            result += "\"" + keys.get(i) + "\":" + values.get(i);
        }
        result += "}";
        return result;
    }
}

public class JsonDeserializer {
    input: string
    pos: i64

    public static fn init(data: string) -> JsonDeserializer {
        return JsonDeserializer { input: data, pos: 0 };
    }

    public fn skip_whitespace() {
        while (self.pos < self.input.len) {
            let c = self.input.charAt(self.pos);
            if (c != 32 && c != 10 && c != 9 && c != 13) { return; }
            self.pos = self.pos + 1;
        }
    }

    public fn read_string() -> string {
        self.skip_whitespace();
        self.pos = self.pos + 1;
        var result = "";
        while (self.pos < self.input.len) {
            let c = self.input.charAt(self.pos);
            if (c == 34) { self.pos = self.pos + 1; return result; }
            if (c == 92 && self.pos + 1 < self.input.len) {
                let next = self.input.charAt(self.pos + 1);
                if (next == 34) { result += "\""; self.pos = self.pos + 2; }
                else if (next == 92) { result += "\\"; self.pos = self.pos + 2; }
                else if (next == 110) { result += "\n"; self.pos = self.pos + 2; }
                else if (next == 116) { result += "\t"; self.pos = self.pos + 2; }
                else if (next == 114) { result += "\r"; self.pos = self.pos + 2; }
                else {
                    result += self.input.substring(self.pos, self.pos + 1);
                    self.pos = self.pos + 1;
                }
            } else {
                result += self.input.substring(self.pos, self.pos + 1);
                self.pos = self.pos + 1;
            }
        }
        return result;
    }

    public fn read_number() -> i64 {
        self.skip_whitespace();
        var result = 0;
        var sign = 1;
        if (self.input.charAt(self.pos) == 45) {
            sign = -1;
            self.pos = self.pos + 1;
        }
        while (self.pos < self.input.len) {
            let c = self.input.charAt(self.pos);
            if (c < 48 || c > 57) { return result * sign; }
            result = result * 10 + (c - 48);
            self.pos = self.pos + 1;
        }
        return result * sign;
    }
}

// ============================================================
// Public entry points
//
// The class methods above are module-private.  These free functions are the
// supported surface, matching the style the other format modules use
// (`csv_parse`, `toml_*`, ...).
// ============================================================

/// Encode `s` as a JSON string literal, surrounding quotes included.
public fn json_encode_string(s: string) -> string {
    return JsonSerializer.encode_string(s);
}

/// Decode the JSON string literal at the front of `input` (leading
/// whitespace allowed) and return the text without the surrounding quotes.
public fn json_decode_string(input: string) -> string {
    var d = JsonDeserializer.init(input);
    return d.read_string();
}

/// Decode the JSON integer at the front of `input` (leading whitespace and an
/// optional leading `-` allowed).
public fn json_decode_int(input: string) -> i64 {
    var d = JsonDeserializer.init(input);
    return d.read_number();
}

/// @[derive(Serialize)] generates serialize() for structs
/// @[derive(Deserialize)] generates deserialize() for structs
