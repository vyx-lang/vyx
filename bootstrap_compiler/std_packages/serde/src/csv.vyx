module std.serde.csv;

use std.string;

use std.collections;
use std.core;

public class CsvError { public offset: i64; public message: string; }

fn csv_field_value(builder: &mut StringBuilder) -> string {
    let text = builder.build();
    builder.clear();
    return text.as_str().clone();
}

/// Parse records with comma delimiters, doubled quotes and CR/LF/CRLF record
/// separators. Newlines inside quoted fields are preserved byte for byte.
/// A terminal separator does not invent an extra row; a blank record has one
/// empty field. Malformed quoting returns its byte offset.
public fn csv_try_parse(text: string) -> Result<Vec<Vec<string>>, CsvError> {
    var rows = Vec::<Vec<string>>.new();
    var fields = Vec::<string>.new();
    var current = StringBuilder.create();
    // 0: beginning of field; 1: unquoted; 2: quoted; 3: after closing quote.
    var state: i32 = 0;
    var i: i64 = 0;
    var record_started = false;
    while (i < text.len) {
        let ch = text.charAt(i);
        if (state == 2) {
            if (ch == 34) { state = 3; }
            else { current.appendChar(ch); }
            record_started = true;
        } else if (state == 3 && ch == 34) {
            current.appendChar(34);
            state = 2;
        } else if (ch == 44 || ch == 10 || ch == 13) {
            fields.push(csv_field_value(&mut current));
            state = 0;
            record_started = true;
            if (ch != 44) {
                rows.push(fields);
                fields = Vec::<string>.new();
                record_started = false;
                if (ch == 13 && i + 1 < text.len && text.charAt(i + 1) == 10) { i += 1; }
            }
        } else if (ch == 34 && state == 0) {
            state = 2;
            record_started = true;
        } else if (state == 3 || ch == 34) {
            return Err(CsvError { offset: i, message: "unexpected byte in CSV field" });
        } else {
            current.appendChar(ch);
            state = 1;
            record_started = true;
        }
        i += 1;
    }
    if (state == 2) {
        return Err(CsvError { offset: i, message: "unterminated quoted CSV field" });
    }
    if (record_started) {
        fields.push(csv_field_value(&mut current));
        rows.push(fields);
    }
    return Ok(rows);
}

/// CSV — CSV Parsing & Generation for Vyx
/// Usage: import std::csv;
///
/// Example:
///   let rows = csv_parse("name,age\nAlice,30\nBob,25");
///   for (row in rows) {
///       print(csv_row_get(row, 0));  // name
///   }
///
///   let line = csv_row("Alice", "30", "NYC");
///   print(line);  // "Alice,30,NYC"

public fn csv_escape(field: string) -> string {
    var quoted = false;
    var i: i64 = 0;
    while (i < field.len) {
        let ch = field.charAt(i);
        if (ch == 44 || ch == 34 || ch == 10 || ch == 13) { quoted = true; break; }
        i += 1;
    }
    if (!quoted) { return field.clone(); }
    var output = StringBuilder.create();
    output.appendChar(34);
    i = 0;
    while (i < field.len) {
        let ch = field.charAt(i);
        output.appendChar(ch);
        if (ch == 34) { output.appendChar(34); }
        i += 1;
    }
    output.appendChar(34);
    let owned = output.intoString();
    return owned.as_str().clone();
}

public fn csv_row2(a: string, b: string) -> string {
    return csv_escape(a) + "," + csv_escape(b);
}

public fn csv_row3(a: string, b: string, c: string) -> string {
    return csv_escape(a) + "," + csv_escape(b) + "," + csv_escape(c);
}

public fn csv_row4(a: string, b: string, c: string, d: string) -> string {
    return csv_escape(a) + "," + csv_escape(b) + "," + csv_escape(c) + "," + csv_escape(d);
}

public fn csv_split_line(line: string) -> Vec<string> {
    if (line.len == 0) {
        var fields = Vec::<string>.new(); fields.push(""); return fields;
    }
    var rows = csv_parse(line);
    if (rows.len != 1) { panic("csv_split_line: expected one record"); }
    return rows.pop();
}

public fn csv_parse(text: string) -> Vec<Vec<string>> {
    match (csv_try_parse(text)) {
        Ok(rows) => { return rows; }
        Err(failure) => { panic(failure.message, " at byte ", failure.offset); }
    }
}
