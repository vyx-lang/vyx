module std.network.httpclient;

use std.network.curl;

/// Vyx HTTP Client
/// Clean API built on the std.network.curl bindings — this module declares
/// no FFI itself; every libcurl call goes through curl.vyx.
///
/// Usage:
///   let client = HttpClient.create();
///   let resp = client.get("https://api.example.com/data");
///   print("Status: ${resp.statusCode}");
///   print("Body: ${resp.body}");
///
///   let resp2 = client.postJson("https://api.example.com", "{\"key\":\"value\"}");
///   print(resp2.body);
///
/// Requires: libcurl (see std.network.curl)

/// HTTP response with status code and body
struct HttpResponse {
    statusCode: i32;
    body: string;
    ok: bool;
}

/// HTTP client with response capture
class HttpClient {
    private timeout: i32;
    private followRedirects: bool;

    /// Create a new HTTP client with default settings.
    public static fn create() -> HttpClient {
        http_init();
        return HttpClient { timeout: 30, followRedirects: true };
    }

    /// Set request timeout in seconds.
    public fn setTimeout(seconds: i32) -> HttpClient {
        self.timeout = seconds;
        return self;
    }

    /// Shared request path. `method` "" means method implied by libcurl
    /// (GET without body, POST with body). `nobody` issues a HEAD.
    fn request(url: string, method: string, body: string, json_header: bool, nobody: bool) -> HttpResponse {
        let handle = curl_new();
        if (handle == null) {
            return HttpResponse { statusCode: 0, body: "", ok: false };
        }
        curl_set(handle, CURLOPT_URL, url.c_str() as rawptr);
        if (method.len > 0) {
            curl_set(handle, CURLOPT_CUSTOMREQUEST, method.c_str() as rawptr);
        }
        if (body.len > 0) {
            curl_set(handle, CURLOPT_POSTFIELDS, body.c_str() as rawptr);
        }
        if (nobody) {
            curl_set(handle, CURLOPT_NOBODY, 1 as rawptr);
        }
        if (self.followRedirects) {
            curl_set(handle, CURLOPT_FOLLOWLOCATION, 1 as rawptr);
        }
        curl_set(handle, CURLOPT_TIMEOUT, self.timeout as rawptr);

        var headers: rawptr = null;
        if (json_header) {
            headers = curl_header(headers, "Content-Type: application/json");
            curl_set(handle, CURLOPT_HTTPHEADER, headers);
        }

        let sink = curl_sink();
        if (sink != null) { curl_set(handle, CURLOPT_WRITEDATA, sink); }
        let result = curl_perform(handle);
        let code = curl_status(handle);
        if (headers != null) { curl_header_free(headers); }
        curl_close(handle);

        var resp_body = "";
        if (sink != null) { resp_body = curl_sink_read(sink); }
        return HttpResponse { statusCode: code, body: resp_body, ok: result == 0 };
    }

    /// Perform a GET request and return the response.
    public fn get(url: string) -> HttpResponse {
        return self.request(url, "", "", false, false);
    }

    /// Perform a POST request with JSON body.
    public fn postJson(url: string, body: string) -> HttpResponse {
        return self.request(url, "", body, true, false);
    }

    /// Perform a PUT request.
    public fn put(url: string, body: string) -> HttpResponse {
        return self.request(url, "PUT", body, true, false);
    }

    /// Perform a PATCH request.
    public fn patch(url: string, body: string) -> HttpResponse {
        return self.request(url, "PATCH", body, true, false);
    }

    /// Perform a DELETE request.
    public fn delete(url: string) -> HttpResponse {
        return self.request(url, "DELETE", "", false, false);
    }

    /// Perform a HEAD request (returns status only, no body).
    public fn head(url: string) -> HttpResponse {
        return self.request(url, "", "", false, true);
    }
}
