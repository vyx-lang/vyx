module std.network.websockets;

use std.encoding;
use std.security.openssl;
use std.network.curl;
use std.time;

/// RFC 6455 text client. libcurl owns TCP, DNS, proxy and verified TLS setup.
/// Messages are limited to 16 MiB; binary messages/extensions are rejected.
extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
    fn memcpy(dest: rawptr, src: rawptr, n: i64) -> rawptr;
    fn RAND_bytes(buf: rawptr, len: i32) -> i32;
}

fn ws_state_connecting() -> i32 { return 0; }
fn ws_state_open() -> i32 { return 1; }
fn ws_state_closing() -> i32 { return 2; }
fn ws_state_closed() -> i32 { return 3; }

fn ws_read_u8(addr: rawptr) -> i32 {
    var out: u8 = 0;
    memcpy(to_rawptr(&out), addr, 1);
    return out as i32;
}

fn ws_write_u8(addr: rawptr, value: i32) {
    var b: u8 = (value & 255) as u8;
    memcpy(addr, to_rawptr(&b), 1);
}

fn ws_write_u16_be(addr: rawptr, value: i32) {
    ws_write_u8(addr, (value >> 8) & 255);
    ws_write_u8(addr + 1, value & 255);
}

fn ws_write_u64_be(addr: rawptr, value: i64) {
    var shift: i32 = 56;
    var i: i32 = 0;
    while (i < 8) {
        ws_write_u8(addr + i, ((value >> (shift as i64)) as i32) & 255);
        shift = shift - 8;
        i = i + 1;
    }
}

fn ws_read_u16_be(buf: rawptr) -> i32 {
    return ((ws_read_u8(buf) & 255) << 8) | (ws_read_u8(buf + 1) & 255);
}

fn ws_read_u64_be(buf: rawptr) -> i64 {
    var out: i64 = 0;
    var i: i32 = 0;
    while (i < 8) {
        out = (out << 8) | ((ws_read_u8(buf + i) & 255) as i64);
        i = i + 1;
    }
    return out;
}


fn ws_build_key() -> string {
    var nonce: [u8; 16];
    if (RAND_bytes(to_rawptr(&nonce), 16) != 1) { return ""; }
    return base64_encode(from_cstr_len(to_rawptr(&nonce), 16));
}

fn ws_expected_accept(key: string) -> string {
    let digest = sha1(key + "258EAFA5-E914-47DA-95CA-C5AB0DC85B11");
    if (digest.len != 40) { return ""; }
    var bytes: [u8; 20];
    var i: i32 = 0;
    while (i < 20) {
        // hex_decode is text-oriented; decode bytes directly to preserve NUL.
        let pair = digest.substring(i * 2, i * 2 + 2);
        var value: i32 = 0;
        var j: i32 = 0;
        while (j < 2) {
            let c = pair.charAt(j);
            let digit = c >= 97 ? c - 87 : c - 48;
            value = value * 16 + digit;
            j = j + 1;
        }
        bytes[i] = value as u8;
        i = i + 1;
    }
    return base64_encode(from_cstr_len(to_rawptr(&bytes), 20));
}

fn ws_header(headers: string, key: string) -> string {
    var start: i32 = 0;
    var i: i32 = 0;
    var value = "";
    while (i < headers.len) {
        if (headers.charAt(i) == 10) {
            let line = headers.substring(start, i).trim();
            let colon = line.indexOf(":");
            if (colon > 0 && line.substring(0, colon).toLower() == key) {
                if (value.len > 0) { value = value + ","; }
                value = value + line.substring(colon + 1, line.len).trim();
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return value;
}

fn ws_has_token(value: string, token: string) -> bool {
    var start: i32 = 0;
    var i: i32 = 0;
    while (i <= value.len) {
        if (i == value.len || value.charAt(i) == 44) {
            if (value.substring(start, i).trim().toLower() == token) { return true; }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

fn ws_valid_utf8(text: string) -> bool {
    var i: i32 = 0;
    while (i < text.len) {
        let b = text.charAt(i) & 255;
        var n: i32 = 0;
        var low: i32 = 128;
        var high: i32 = 191;
        if (b < 128) { i = i + 1; continue; }
        if (b >= 194 && b <= 223) { n = 1; }
        elif (b >= 224 && b <= 239) {
            n = 2;
            if (b == 224) { low = 160; }
            if (b == 237) { high = 159; }
        } elif (b >= 240 && b <= 244) {
            n = 3;
            if (b == 240) { low = 144; }
            if (b == 244) { high = 143; }
        } else { return false; }
        if (i + n >= text.len) { return false; }
        let second = text.charAt(i + 1) & 255;
        if (second < low || second > high) { return false; }
        var j: i32 = 2;
        while (j <= n) {
            let c = text.charAt(i + j) & 255;
            if (c < 128 || c > 191) { return false; }
            j = j + 1;
        }
        i = i + n + 1;
    }
    return true;
}

public class WebSocket {
    @[vis(self)] transport: rawptr;
    @[vis(self)] state: i32;
    @[vis(self)] authority: string;
    @[vis(self)] path: string;
    @[vis(self)] last_error: string;

    public static fn closed(message: string) -> WebSocket {
        return WebSocket { transport: null, state: ws_state_closed(),
                           authority: "", path: "/", last_error: message };
    }

    public static fn connect(url: string, ca_file: string = "") -> WebSocket {
        var rest = url;
        var scheme = "http://";
        if (url.startsWith("ws://")) { rest = url.substring(5, url.len); }
        elif (url.startsWith("wss://")) {
            rest = url.substring(6, url.len); scheme = "https://";
        } else { return WebSocket.closed("unsupported WebSocket URL scheme"); }
        if (rest.contains("\r") || rest.contains("\n") || rest.contains("#") || rest.contains("@")) {
            return WebSocket.closed("invalid WebSocket URL");
        }
        var path = "/";
        var authority = rest;
        var slash = rest.indexOf("/");
        let query = rest.indexOf("?");
        if (query >= 0 && (slash < 0 || query < slash)) { slash = query; }
        if (slash >= 0) {
            authority = rest.substring(0, slash);
            path = rest.substring(slash, rest.len);
            if (path.startsWith("?")) { path = "/" + path; }
        }
        if (authority.len == 0) { return WebSocket.closed("missing WebSocket host"); }
        http_init();
        var out = WebSocket { transport: curl_new(), state: ws_state_connecting(),
                              authority: authority, path: path, last_error: "" };
        if (out.transport == null) { return WebSocket.closed("could not create libcurl handle"); }
        let target = scheme + rest;
        var rc = curl_set(out.transport, CURLOPT_URL, target.c_str());
        rc = rc | curl_set(out.transport, CURLOPT_HTTP_VERSION, 2 as rawptr);
        rc = rc | curl_set(out.transport, CURLOPT_CONNECT_ONLY, 1 as rawptr);
        rc = rc | curl_set(out.transport, CURLOPT_TIMEOUT, 10 as rawptr);
        rc = rc | curl_set(out.transport, CURLOPT_NOSIGNAL, 1 as rawptr);
        if (ca_file.len > 0) { rc = rc | curl_set(out.transport, CURLOPT_CAINFO, ca_file.c_str()); }
        if (rc == 0) { rc = curl_perform(out.transport); }
        if (rc != 0) { out.last_error = http_error(rc); out.closeTransport(); return out; }
        if (!out.handshake()) { out.closeTransport(); return out; }
        out.state = ws_state_open();
        return out;
    }

    fn writeBytes(buf: rawptr, len: i32) -> i32 {
        let deadline = clock_ms() + 10000;
        while (clock_ms() < deadline) {
            var sent: u64 = 0;
            let rc = curl_send_bytes(self.transport, buf, len as u64, to_rawptr(&sent));
            if (rc == 0) { return sent as i32; }
            if (rc != 81) { self.last_error = http_error(rc); return -1; }
            sleep_ms(1);
        }
        self.last_error = "WebSocket write timed out";
        return -1;
    }

    fn readBytes(buf: rawptr, len: i32) -> i32 {
        let deadline = clock_ms() + 10000;
        while (clock_ms() < deadline) {
            var got: u64 = 0;
            let rc = curl_recv_bytes(self.transport, buf, len as u64, to_rawptr(&got));
            if (rc == 0) { return got as i32; }
            if (rc != 81) { self.last_error = http_error(rc); return -1; }
            sleep_ms(1);
        }
        self.last_error = "WebSocket read timed out";
        return -1;
    }

    fn writeAll(buf: rawptr, len: i32) -> bool {
        var sent: i32 = 0;
        while (sent < len) {
            let n = self.writeBytes(buf + sent, len - sent);
            if (n <= 0) { return false; }
            sent = sent + n;
        }
        return true;
    }

    fn readExact(buf: rawptr, len: i32) -> bool {
        var got: i32 = 0;
        while (got < len) {
            let n = self.readBytes(buf + got, len - got);
            if (n <= 0) { return false; }
            got = got + n;
        }
        return true;
    }

    fn handshake() -> bool {
        let key = ws_build_key();
        if (key.len == 0) { self.last_error = "WebSocket random source failed"; return false; }
        let request = "GET " + self.path + " HTTP/1.1\r\n"
            + "Host: " + self.authority + "\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
            + "Sec-WebSocket-Key: " + key + "\r\nSec-WebSocket-Version: 13\r\n\r\n";
        if (!self.writeAll(request.c_str(), request.len as i32)) {
            self.last_error = "WebSocket handshake write failed"; return false;
        }
        let response = self.readHeaders(16384);
        let first = response.indexOf("\r\n");
        if (first < 0) {
            if (self.last_error.len == 0) { self.last_error = "WebSocket handshake response missing"; }
            return false;
        }
        let status = response.substring(0, first);
        if (status != "HTTP/1.1 101" && !status.startsWith("HTTP/1.1 101 ")) {
            self.last_error = "WebSocket server did not return HTTP 101"; return false;
        }
        if (!ws_has_token(ws_header(response, "upgrade"), "websocket")
            || !ws_has_token(ws_header(response, "connection"), "upgrade")) {
            self.last_error = "WebSocket upgrade headers missing"; return false;
        }
        let accept = ws_expected_accept(key);
        if (accept.len == 0 || ws_header(response, "sec-websocket-accept") != accept) {
            self.last_error = "WebSocket accept key mismatch"; return false;
        }
        if (ws_header(response, "sec-websocket-extensions").len > 0
            || ws_header(response, "sec-websocket-protocol").len > 0) {
            self.last_error = "unsolicited WebSocket extension or subprotocol"; return false;
        }
        return true;
    }

    fn readHeaders(max_bytes: i32) -> string {
        var out = "";
        var buf: [u8; 1];
        var count: i32 = 0;
        while (count < max_bytes) {
            if (!self.readExact(to_rawptr(&buf), 1)) { return ""; }
            out = out + from_cstr_len(to_rawptr(&buf), 1);
            if (out.endsWith("\r\n\r\n")) { return out; }
            count = count + 1;
        }
        self.last_error = "WebSocket header block exceeded limit";
        return "";
    }

    fn sendFrame(opcode: i32, payload: string) -> bool {
        if (self.transport == null) { return false; }
        if (self.state != ws_state_open() && opcode != 8) { return false; }
        if (payload.len > 16777216 || (opcode >= 8 && payload.len > 125)) { return false; }
        let payload_len = payload.len as i64;
        var ext_len: i32 = 0;
        if (payload_len > 125 && payload_len <= 65535) { ext_len = 2; }
        if (payload_len > 65535) { ext_len = 8; }
        let frame_len = 2 + ext_len + 4 + (payload_len as i32);
        let frame = malloc(frame_len as i64);
        if (frame == null) { return false; }
        ws_write_u8(frame, 0x80 | opcode);
        var offset: i32 = 2;
        if (payload_len <= 125) { ws_write_u8(frame + 1, 0x80 | (payload_len as i32)); }
        elif (payload_len <= 65535) {
            ws_write_u8(frame + 1, 0x80 | 126);
            ws_write_u16_be(frame + offset, payload_len as i32); offset = offset + 2;
        } else {
            ws_write_u8(frame + 1, 0x80 | 127);
            ws_write_u64_be(frame + offset, payload_len); offset = offset + 8;
        }
        let mask = frame + offset;
        if (RAND_bytes(mask, 4) != 1) { free(frame); self.last_error = "WebSocket random source failed"; return false; }
        offset = offset + 4;
        var i: i32 = 0;
        while (i < payload_len) {
            ws_write_u8(frame + offset + i, (payload.charAt(i) & 255) ^ ws_read_u8(mask + (i % 4)));
            i = i + 1;
        }
        let ok = self.writeAll(frame, frame_len);
        free(frame);
        return ok;
    }

    public fn send(message: string) -> bool {
        if (!ws_valid_utf8(message)) { self.last_error = "invalid UTF-8 text"; return false; }
        if (!self.sendFrame(1, message)) { self.closeTransport(); return false; }
        return true;
    }

    fn protocolError(message: string) -> string {
        self.last_error = message;
        self.closeTransport();
        return "";
    }

    public fn recv() -> string {
        var message = "";
        var fragmented = false;
        while (self.state == ws_state_open()) {
            var hdr: [u8; 2];
            if (!self.readExact(to_rawptr(&hdr), 2)) { return self.protocolError("WebSocket peer closed or read failed"); }
            let b0 = hdr[0] as i32;
            let b1 = hdr[1] as i32;
            let opcode = b0 & 15;
            let fin = (b0 & 128) != 0;
            if ((b0 & 112) != 0 || (b1 & 128) != 0) { return self.protocolError("invalid RSV bits or masked server frame"); }
            if (opcode != 0 && opcode != 1 && opcode != 8 && opcode != 9 && opcode != 10) {
                return self.protocolError("unsupported WebSocket opcode");
            }
            var payload_len: i64 = (b1 & 127) as i64;
            if (opcode >= 8 && (!fin || payload_len > 125)) { return self.protocolError("invalid control frame"); }
            if (payload_len == 126) {
                var ext2: [u8; 2];
                if (!self.readExact(to_rawptr(&ext2), 2)) { return self.protocolError("truncated frame length"); }
                payload_len = ws_read_u16_be(to_rawptr(&ext2)) as i64;
                if (payload_len < 126) { return self.protocolError("nonminimal frame length"); }
            } elif (payload_len == 127) {
                var ext8: [u8; 8];
                if (!self.readExact(to_rawptr(&ext8), 8)) { return self.protocolError("truncated frame length"); }
                payload_len = ws_read_u64_be(to_rawptr(&ext8));
                if (payload_len < 65536) { return self.protocolError("invalid frame length"); }
            }
            if (payload_len > 16777216 || (opcode < 8 && payload_len + message.len > 16777216)) {
                return self.protocolError("WebSocket message exceeds 16 MiB");
            }
            let payload = malloc(payload_len + 1);
            if (payload == null) { return self.protocolError("payload allocation failed"); }
            if (!self.readExact(payload, payload_len as i32)) { free(payload); return self.protocolError("truncated frame payload"); }
            let data = from_cstr_len(payload, payload_len);
            free(payload);
            if (opcode == 8) {
                if (data.len == 1 || (data.len > 2 && !ws_valid_utf8(data.substring(2, data.len)))) {
                    return self.protocolError("invalid close payload");
                }
                if (data.len >= 2) {
                    let code = ((data.charAt(0) & 255) << 8) | (data.charAt(1) & 255);
                    if (code < 1000 || code >= 5000 || code == 1004 || code == 1005
                        || code == 1006 || (code >= 1015 && code < 3000)) {
                        return self.protocolError("invalid WebSocket close status");
                    }
                }
                self.sendFrame(8, data); self.closeTransport(); return "";
            }
            if (opcode == 9) {
                if (!self.sendFrame(10, data)) { return self.protocolError("pong write failed"); }
                continue;
            }
            if (opcode == 10) { continue; }
            if (opcode == 0 && !fragmented) { return self.protocolError("unexpected continuation"); }
            if (opcode == 1 && fragmented) { return self.protocolError("interleaved text message"); }
            message = message + data;
            if (fin) {
                if (!ws_valid_utf8(message)) { return self.protocolError("invalid UTF-8 text"); }
                return message;
            }
            fragmented = true;
        }
        return "";
    }

    public fn ping() -> bool { return self.sendFrame(9, ""); }
    public fn isOpen() -> bool { return self.state == ws_state_open(); }
    public fn lastError() -> string { return self.last_error; }
    fn closeTransport() {
        if (self.transport != null) { curl_close(self.transport); self.transport = null; }
        self.state = ws_state_closed();
    }
    public fn close() {
        if (self.state == ws_state_open()) { self.sendFrame(8, ""); }
        self.closeTransport();
    }
    public fn drop() { self.closeTransport(); }
}
