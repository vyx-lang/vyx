module std.console;

use std.fmt;
use std.string;

extern "C" {
    fn putchar(value: i32) -> i32;
    fn exit(code: i32);
}

/// Write a counted UTF-8 view, including embedded NUL bytes.
fn write_text(value: str) {
    var i: i64 = 0;
    while (i < value.len) {
        putchar(str_char_at(value, i));
        i = i + 1;
    }
}

/// Formatting is ordinary Display dispatch, including user implementations.
@[borrow_args]
@[lang_item("write")]
public fn write<...Ts>(...args: Ts) {
    for value in args {
        let rendered = value.display();
        write_text(rendered);
        str_drop(rendered);
    }
}

/// Both print and println append one newline, including an empty argument pack.
@[borrow_args]
@[lang_item("print")]
public fn print<...Ts>(...args: Ts) {
    write(args...);
    putchar(10);
}

@[borrow_args]
@[lang_item("println")]
public fn println<...Ts>(...args: Ts) { print(args...); }

@[borrow_args]
@[lang_item("panic")]
public fn panic<...Ts>(...args: Ts) {
    print(args...);
    exit(1);
}

@[lang_item("assert")]
public fn assert(condition: bool, message: str = "assert failed") {
    if (!condition) { panic(message); }
}

@[borrow_args]
@[lang_item("assert_eq")]
public fn assert_eq<T>(lhs: T, rhs: T) {
    if (lhs != rhs) { panic("assert_eq failed"); }
}
