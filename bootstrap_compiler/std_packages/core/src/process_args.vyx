module std.process_args;

extern "C" {
    fn vyx_process_arg_count_abi() -> i32;
    fn vyx_process_arg_ptr_abi(index: i32) -> rawptr;
    fn strlen(address: rawptr) -> i64;
}

@[lang_item("argCount")]
public fn argCount() -> i32 { return vyx_process_arg_count_abi(); }

/// A view into the process argument storage, valid for the process lifetime.
@[lang_item("getArg")]
public fn getArg(index: i64) -> str {
    if (index < 0 || index >= argCount() as i64) { return ""; }
    let address = vyx_process_arg_ptr_abi(index as i32);
    if (address == null) { return ""; }
    return from_cstr_view_len(address, strlen(address));
}
