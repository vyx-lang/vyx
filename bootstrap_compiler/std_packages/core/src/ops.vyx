module std.ops;

use std.string;

/// Vyx Standard Library — Operator traits
///
/// Mirrors Rust's `std::ops::{Add, Sub, Mul, Div, Rem, AddAssign,
/// SubAssign, ..., Neg, Not, BitAnd, BitOr, BitXor, Shl, Shr}` family.
/// Each trait gives an explicit
/// home to the existing `operator_*` method-name convention that Sema's
/// `analyzeBinaryOp` (src/Sema/SemaExprOps.cpp) routes `+ - * /` etc.
/// through when the left operand is a class / struct.
///
/// The method names (`operator_add`, `operator_sub`, ...) are KEPT --
/// they match the compiler's hardcoded dispatch table and every
/// existing user / stdlib class that overloads an operator.  The traits
/// introduced here just declare those names so generic bodies can
/// demand them via `where T: Add` and so `impl Add for MyType` is the
/// canonical way to spell "this type supports `+`".
///
/// Naming note: Rust spells its remainder trait `Rem`; Vyx spells it
/// `Mod` to match the `operator_mod` method name + `BinaryOp::Mod`
/// already in the codebase.  Semantics are identical (truncated-toward-
/// zero remainder for integers, IEEE `fmod` for floats -- whatever the
/// underlying primitive `%` operator does).

// ============================================================
// Arithmetic traits
// ============================================================

/// `a + b` -- addition for numbers, concatenation for strings.
trait Add { fn operator_add(other: Self) -> Self; }

/// `a - b` -- subtraction.
trait Sub { fn operator_sub(other: Self) -> Self; }

/// `a * b` -- multiplication.
trait Mul { fn operator_mul(other: Self) -> Self; }

/// `a / b` -- division.  Integer division truncates toward zero (C
/// semantics); float division follows IEEE-754.
trait Div { fn operator_div(other: Self) -> Self; }

/// `a % b` -- remainder (Rust's `Rem`; renamed to match Vyx's
/// existing `operator_mod` method name).
trait Mod { fn operator_mod(other: Self) -> Self; }

// ============================================================
// Compound-assignment traits
// ============================================================

/// `a += b` -- value-returning assignment addition.  For primitives this
/// is equivalent to `a + b`; for `string` it returns a concatenated value.
/// The compiler's statement-level `s += rhs` path may still reuse storage
/// when it stores the result back into the original string variable.
trait AddAssign { fn operator_add_assign(other: Self) -> Self; }

/// `a -= b`.
trait SubAssign { fn operator_sub_assign(other: Self) -> Self; }

/// `a *= b`.
trait MulAssign { fn operator_mul_assign(other: Self) -> Self; }

/// `a /= b`.
trait DivAssign { fn operator_div_assign(other: Self) -> Self; }

/// `a %= b`.
trait ModAssign { fn operator_mod_assign(other: Self) -> Self; }

/// `a &= b`.
trait BitAndAssign { fn operator_band_assign(other: Self) -> Self; }

/// `a |= b`.
trait BitOrAssign { fn operator_bor_assign(other: Self) -> Self; }

/// `a ^= b`.
trait BitXorAssign { fn operator_bxor_assign(other: Self) -> Self; }

/// `a <<= b`.
trait ShlAssign { fn operator_shl_assign(other: Self) -> Self; }

/// `a >>= b`.
trait ShrAssign { fn operator_shr_assign(other: Self) -> Self; }

// ============================================================
// Unary traits
// ============================================================

/// Unary `-a` -- arithmetic negation.
trait Neg { fn operator_neg() -> Self; }

/// Unary `!a` -- logical NOT (for bool).
trait Not { fn operator_not() -> Self; }

// ============================================================
// Bitwise traits -- integers only (impls below exclude floats).
// ============================================================

/// `a & b` -- bitwise AND.
trait BitAnd { fn operator_band(other: Self) -> Self; }

/// `a | b` -- bitwise OR.
trait BitOr  { fn operator_bor(other: Self) -> Self; }

/// `a ^ b` -- bitwise XOR.
trait BitXor { fn operator_bxor(other: Self) -> Self; }

/// `a << b` -- left shift.
trait Shl    { fn operator_shl(other: Self) -> Self; }

/// `a >> b` -- right shift (arithmetic for signed types, logical for
/// unsigned -- whatever the underlying primitive `>>` does).
trait Shr    { fn operator_shr(other: Self) -> Self; }

// ============================================================
// Primitive impls -- Add / Sub / Mul / Div / Mod for i32 / i64 / f32 / f64
// plus `Add` for string (concatenation).  Each impl body is a pass-
// through to the built-in operator; the trait just gives the method a
// nominal home for bounds-checking purposes.
//
// Dispatch plumbing: `impl Trait for <primitive>` registers the method
// in `Sema::primitiveMethodImpls_[(typeName, methodName)]` and records
// `primitiveTraitSatisfied_[(typeName, "Trait")]`, so generic bodies
// with `where T: Trait` that call `x.operator_add(y)` route through
// `<PrimitiveName>.operator_add` when T binds to a primitive.  See
// std/hash.vyx for the canonical precedent (Hashable / Eq / Ord).
// ============================================================

// ---- Add ----
impl Add for i32    { fn operator_add(other: i32)    -> i32    { return self + other; } }
impl Add for i64    { fn operator_add(other: i64)    -> i64    { return self + other; } }
impl Add for f32    { fn operator_add(other: f32)    -> f32    { return self + other; } }
impl Add for f64    { fn operator_add(other: f64)    -> f64    { return self + other; } }
impl Add for string { fn operator_add(other: string) -> string { return str_concat(self, other); } }

// ---- AddAssign ----
impl AddAssign for i32    { fn operator_add_assign(other: i32)    -> i32    { return self + other; } }
impl AddAssign for i64    { fn operator_add_assign(other: i64)    -> i64    { return self + other; } }
impl AddAssign for f32    { fn operator_add_assign(other: f32)    -> f32    { return self + other; } }
impl AddAssign for f64    { fn operator_add_assign(other: f64)    -> f64    { return self + other; } }
impl AddAssign for string { fn operator_add_assign(other: string) -> string { return str_concat(self, other); } }

// ---- Sub ----
impl Sub for i32 { fn operator_sub(other: i32) -> i32 { return self - other; } }
impl Sub for i64 { fn operator_sub(other: i64) -> i64 { return self - other; } }
impl Sub for f32 { fn operator_sub(other: f32) -> f32 { return self - other; } }
impl Sub for f64 { fn operator_sub(other: f64) -> f64 { return self - other; } }

// ---- SubAssign ----
impl SubAssign for i32 { fn operator_sub_assign(other: i32) -> i32 { return self - other; } }
impl SubAssign for i64 { fn operator_sub_assign(other: i64) -> i64 { return self - other; } }
impl SubAssign for f32 { fn operator_sub_assign(other: f32) -> f32 { return self - other; } }
impl SubAssign for f64 { fn operator_sub_assign(other: f64) -> f64 { return self - other; } }

// ---- Mul ----
impl Mul for i32 { fn operator_mul(other: i32) -> i32 { return self * other; } }
impl Mul for i64 { fn operator_mul(other: i64) -> i64 { return self * other; } }
impl Mul for f32 { fn operator_mul(other: f32) -> f32 { return self * other; } }
impl Mul for f64 { fn operator_mul(other: f64) -> f64 { return self * other; } }

// ---- MulAssign ----
impl MulAssign for i32 { fn operator_mul_assign(other: i32) -> i32 { return self * other; } }
impl MulAssign for i64 { fn operator_mul_assign(other: i64) -> i64 { return self * other; } }
impl MulAssign for f32 { fn operator_mul_assign(other: f32) -> f32 { return self * other; } }
impl MulAssign for f64 { fn operator_mul_assign(other: f64) -> f64 { return self * other; } }

// ---- Div ----
impl Div for i32 { fn operator_div(other: i32) -> i32 { return self / other; } }
impl Div for i64 { fn operator_div(other: i64) -> i64 { return self / other; } }
impl Div for f32 { fn operator_div(other: f32) -> f32 { return self / other; } }
impl Div for f64 { fn operator_div(other: f64) -> f64 { return self / other; } }

// ---- DivAssign ----
impl DivAssign for i32 { fn operator_div_assign(other: i32) -> i32 { return self / other; } }
impl DivAssign for i64 { fn operator_div_assign(other: i64) -> i64 { return self / other; } }
impl DivAssign for f32 { fn operator_div_assign(other: f32) -> f32 { return self / other; } }
impl DivAssign for f64 { fn operator_div_assign(other: f64) -> f64 { return self / other; } }

// ---- Mod ----
impl Mod for i32 { fn operator_mod(other: i32) -> i32 { return self % other; } }
impl Mod for i64 { fn operator_mod(other: i64) -> i64 { return self % other; } }
impl Mod for f32 { fn operator_mod(other: f32) -> f32 { return self % other; } }
impl Mod for f64 { fn operator_mod(other: f64) -> f64 { return self % other; } }

// ---- ModAssign ----
impl ModAssign for i32 { fn operator_mod_assign(other: i32) -> i32 { return self % other; } }
impl ModAssign for i64 { fn operator_mod_assign(other: i64) -> i64 { return self % other; } }
impl ModAssign for f32 { fn operator_mod_assign(other: f32) -> f32 { return self % other; } }
impl ModAssign for f64 { fn operator_mod_assign(other: f64) -> f64 { return self % other; } }

// ============================================================
// Unary impls
// ============================================================

// ---- Neg: arithmetic negation, signed + float only ----
impl Neg for i32 { fn operator_neg() -> i32 { return -self; } }
impl Neg for i64 { fn operator_neg() -> i64 { return -self; } }
impl Neg for f32 { fn operator_neg() -> f32 { return -self; } }
impl Neg for f64 { fn operator_neg() -> f64 { return -self; } }

// ---- Not: logical complement on bool ----
impl Not for bool { fn operator_not() -> bool { return !self; } }

// ============================================================
// Bitwise impls -- integers only.  `u32` / `u64` are accepted as
// impl targets (isPrimitiveTypeName whitelists the unsigned family)
// even though the lexer lacks a `u32`-literal suffix; the body reuses
// the underlying bitwise operator, which CodeGen routes through the
// same IR op for signed/unsigned integers of the same width.
// ============================================================

// ---- BitAnd ----
impl BitAnd for i32 { fn operator_band(other: i32) -> i32 { return self & other; } }
impl BitAnd for i64 { fn operator_band(other: i64) -> i64 { return self & other; } }
impl BitAnd for u32 { fn operator_band(other: u32) -> u32 { return self & other; } }
impl BitAnd for u64 { fn operator_band(other: u64) -> u64 { return self & other; } }

// ---- BitAndAssign ----
impl BitAndAssign for i32 { fn operator_band_assign(other: i32) -> i32 { return self & other; } }
impl BitAndAssign for i64 { fn operator_band_assign(other: i64) -> i64 { return self & other; } }
impl BitAndAssign for u32 { fn operator_band_assign(other: u32) -> u32 { return self & other; } }
impl BitAndAssign for u64 { fn operator_band_assign(other: u64) -> u64 { return self & other; } }

// ---- BitOr ----
impl BitOr for i32 { fn operator_bor(other: i32) -> i32 { return self | other; } }
impl BitOr for i64 { fn operator_bor(other: i64) -> i64 { return self | other; } }
impl BitOr for u32 { fn operator_bor(other: u32) -> u32 { return self | other; } }
impl BitOr for u64 { fn operator_bor(other: u64) -> u64 { return self | other; } }

// ---- BitOrAssign ----
impl BitOrAssign for i32 { fn operator_bor_assign(other: i32) -> i32 { return self | other; } }
impl BitOrAssign for i64 { fn operator_bor_assign(other: i64) -> i64 { return self | other; } }
impl BitOrAssign for u32 { fn operator_bor_assign(other: u32) -> u32 { return self | other; } }
impl BitOrAssign for u64 { fn operator_bor_assign(other: u64) -> u64 { return self | other; } }

// ---- BitXor ----
impl BitXor for i32 { fn operator_bxor(other: i32) -> i32 { return self ^ other; } }
impl BitXor for i64 { fn operator_bxor(other: i64) -> i64 { return self ^ other; } }
impl BitXor for u32 { fn operator_bxor(other: u32) -> u32 { return self ^ other; } }
impl BitXor for u64 { fn operator_bxor(other: u64) -> u64 { return self ^ other; } }

// ---- BitXorAssign ----
impl BitXorAssign for i32 { fn operator_bxor_assign(other: i32) -> i32 { return self ^ other; } }
impl BitXorAssign for i64 { fn operator_bxor_assign(other: i64) -> i64 { return self ^ other; } }
impl BitXorAssign for u32 { fn operator_bxor_assign(other: u32) -> u32 { return self ^ other; } }
impl BitXorAssign for u64 { fn operator_bxor_assign(other: u64) -> u64 { return self ^ other; } }

// ---- Shl ----
impl Shl for i32 { fn operator_shl(other: i32) -> i32 { return self << other; } }
impl Shl for i64 { fn operator_shl(other: i64) -> i64 { return self << other; } }
impl Shl for u32 { fn operator_shl(other: u32) -> u32 { return self << other; } }
impl Shl for u64 { fn operator_shl(other: u64) -> u64 { return self << other; } }

// ---- ShlAssign ----
impl ShlAssign for i32 { fn operator_shl_assign(other: i32) -> i32 { return self << other; } }
impl ShlAssign for i64 { fn operator_shl_assign(other: i64) -> i64 { return self << other; } }
impl ShlAssign for u32 { fn operator_shl_assign(other: u32) -> u32 { return self << other; } }
impl ShlAssign for u64 { fn operator_shl_assign(other: u64) -> u64 { return self << other; } }

// ---- Shr ----
impl Shr for i32 { fn operator_shr(other: i32) -> i32 { return self >> other; } }
impl Shr for i64 { fn operator_shr(other: i64) -> i64 { return self >> other; } }
impl Shr for u32 { fn operator_shr(other: u32) -> u32 { return self >> other; } }
impl Shr for u64 { fn operator_shr(other: u64) -> u64 { return self >> other; } }

// ---- ShrAssign ----
impl ShrAssign for i32 { fn operator_shr_assign(other: i32) -> i32 { return self >> other; } }
impl ShrAssign for i64 { fn operator_shr_assign(other: i64) -> i64 { return self >> other; } }
impl ShrAssign for u32 { fn operator_shr_assign(other: u32) -> u32 { return self >> other; } }
impl ShrAssign for u64 { fn operator_shr_assign(other: u64) -> u64 { return self >> other; } }
