module std.memory;

extern "C" {
    @[lang_item("malloc")]
    fn malloc(size: u64) -> rawptr;
    @[lang_item("realloc")]
    fn realloc(address: rawptr, size: u64) -> rawptr;
    @[lang_item("free")]
    fn free(address: rawptr);
    @[lang_item("memcpy")]
    fn memcpy(destination: rawptr, source: rawptr, size: u64) -> rawptr;
    @[lang_item("memmove")]
    fn memmove(destination: rawptr, source: rawptr, size: u64) -> rawptr;
    @[lang_item("memset")]
    fn memset(destination: rawptr, value: i32, size: u64) -> rawptr;
    @[lang_item("memcmp")]
    fn memcmp(lhs: rawptr, rhs: rawptr, size: u64) -> i32;
    @[lang_item("strlen")]
    fn strlen(address: rawptr) -> i64;
}

@[lang_item("alloc")]
public fn alloc(size: i64) -> rawptr {
    if (size < 0) { return null; }
    return malloc(size as u64);
}
@[lang_item("dealloc")]
public fn dealloc(address: rawptr) { free(address); }
