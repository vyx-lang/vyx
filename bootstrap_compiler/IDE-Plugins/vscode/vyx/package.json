{
  "name": "vyx",
  "displayName": "Vyx Language",
  "description": "Industrial Vyx language support: LSP, DAP, completion, diagnostics, code actions, and formatting.",
  "version": "0.2.1",
  "publisher": "vyxlang",
  "engines": {
    "vscode": "^1.110.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:vyx",
    "onDebugResolve:vyx",
    "workspaceContains:**/*.vyx",
    "workspaceContains:Vyx.toml"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@types/vscode": "^1.110.0",
    "typescript": "^5.9.2"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Formatters",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "vyx",
    "lsp",
    "dap",
    "debugger",
    "formatter"
  ],
  "contributes": {
    "configurationDefaults": {
      "files.associations": {
        "*.vyx": "vyx",
        "*.vyi": "vyx"
      },
      "[vyx]": {
        "editor.tabSize": 4,
        "editor.insertSpaces": true,
        "editor.detectIndentation": false,
        "editor.formatOnSave": true,
        "editor.formatOnPaste": false,
        "editor.defaultFormatter": "vyxlang.vyx",
        "editor.semanticHighlighting.enabled": true,
        "editor.suggest.snippetsPreventQuickSuggestions": false,
        "editor.codeActionsOnSave": {
          "source.fixAll": "never"
        },
        "editor.quickSuggestions": {
          "other": true,
          "comments": false,
          "strings": false
        },
        "editor.suggestOnTriggerCharacters": true,
        "editor.acceptSuggestionOnCommitCharacter": true
      }
    },
    "languages": [
      {
        "id": "vyx",
        "aliases": [
          "Vyx",
          "vyx"
        ],
        "extensions": [
          ".vyx",
          ".vyi"
        ],
        "filenames": [
          "Vyx.toml"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/vyx-file.png",
          "dark": "./icons/vyx-file.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "vyx",
        "scopeName": "source.vyx",
        "path": "./syntaxes/vyx.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "vyx",
        "path": "./snippets/vyx.json"
      }
    ],
    "commands": [
      {
        "command": "vyx.runFile",
        "title": "Vyx: Run Current File",
        "icon": "$(play)"
      },
      {
        "command": "vyx.buildProject",
        "title": "Vyx: Build Project",
        "icon": "$(tools)"
      },
      {
        "command": "vyx.testFile",
        "title": "Vyx: Run Tests"
      },
      {
        "command": "vyx.formatFile",
        "title": "Vyx: Format File"
      },
      {
        "command": "vyx.generateDocs",
        "title": "Vyx: Language Server Status"
      },
      {
        "command": "vyx.setCompilerPath",
        "title": "Vyx: Set Compiler Path"
      },
      {
        "command": "vyx.restartLanguageServer",
        "title": "Vyx: Restart Language Server"
      },
      {
        "command": "vyx.debugFile",
        "title": "Vyx: Debug Current File",
        "icon": "$(debug-alt)"
      },
      {
        "command": "vyx.debugExtensionStatus",
        "title": "Vyx: Debug Extension Status"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "vyx.runFile",
          "when": "resourceLangId == vyx",
          "group": "navigation@1"
        },
        {
          "command": "vyx.debugFile",
          "when": "resourceLangId == vyx",
          "group": "navigation@2"
        }
      ],
      "editor/context": [
        {
          "command": "vyx.runFile",
          "when": "resourceLangId == vyx",
          "group": "1_vyx@1"
        },
        {
          "command": "vyx.debugFile",
          "when": "resourceLangId == vyx",
          "group": "1_vyx@2"
        },
        {
          "command": "vyx.formatFile",
          "when": "resourceLangId == vyx",
          "group": "1_vyx@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vyx.runFile",
        "key": "ctrl+shift+r",
        "when": "resourceLangId == vyx"
      },
      {
        "command": "vyx.buildProject",
        "key": "ctrl+shift+b",
        "when": "resourceLangId == vyx"
      },
      {
        "command": "vyx.debugFile",
        "key": "ctrl+f5",
        "when": "resourceLangId == vyx"
      },
      {
        "command": "vyx.formatFile",
        "key": "shift+alt+f",
        "when": "resourceLangId == vyx && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Vyx",
      "properties": {
        "vyx.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to vyxc/boot. Empty = auto (extension sibling, workspace bootstrap_compiler/out, PATH)."
        },
        "vyx.lspPath": {
          "type": "string",
          "default": "",
          "description": "Path to vyxc-lsp. Empty = auto next to the compiler or on PATH."
        },
        "vyx.dapPath": {
          "type": "string",
          "default": "",
          "description": "Path to vyxc-dap. Empty = auto next to the compiler or on PATH."
        },
        "vyx.llvmRoot": {
          "type": "string",
          "default": "",
          "description": "LLVM SDK root (bin/clang). Empty = LLVM_ROOT env or workspace clang/."
        },
        "vyx.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace LSP traffic in the Vyx output channel."
        }
      }
    },
    "breakpoints": [
      {
        "language": "vyx"
      }
    ],
    "debuggers": [
      {
        "type": "vyx",
        "label": "Vyx Debug",
        "languages": [
          "vyx"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Compiled Vyx executable to debug."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": []
              },
              "cwd": {
                "type": "string",
                "default": "${workspaceFolder}"
              },
              "debuggerPath": {
                "type": "string",
                "description": "Optional CodeLLDB or LLDB-DAP executable override. The complete Vyx SDK supplies CodeLLDB. Older lldb CLI paths select the sibling lldb-dap.",
                "default": ""
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "Vyx: Launch",
            "description": "Launch a compiled Vyx program under vyxc-dap",
            "body": {
              "type": "vyx",
              "request": "launch",
              "name": "Debug Vyx Program",
              "program": "${workspaceFolder}/out/${input:programName}",
              "cwd": "${workspaceFolder}"
            }
          }
        ],
        "icon": "./images/vyx.png"
      }
    ],
    "taskDefinitions": [
      {
        "type": "vyx",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "description": "Logical Vyx task name (build, compile, run)."
          },
          "file": {
            "type": "string"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    ],
    "problemMatchers": [
      {
        "name": "vyx",
        "owner": "vyx",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(.*):(\\d+):(\\d+):\\s+(error|warning|note|fatal):\\s+((?:[EI]\\d{4}:\\s*)?.*)$",
            "file": 1,
            "line": 2,
            "column": 3,
            "severity": 4,
            "message": 5
          }
        ]
      }
    ]
  },
  "icon": "images/vyx.png"
}
