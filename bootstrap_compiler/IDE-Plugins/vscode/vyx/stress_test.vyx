// Stress test: complex feature combinations

// Class inheritance
class Shape {
    public area: f64;
    public fn getArea() -> f64 { return self.area; }
}

class Circle : Shape {
    public radius: f64;
    public fn calcArea() -> f64 { return 3.14159 * self.radius * self.radius; }
}

fn test_inheritance() {
    let c = Circle { radius: 5.0 };
    let a = c.calcArea();
    print("  [01] inheritance: ok");
}

// Generics
fn max_val<T: Comparable>(a: T, b: T) -> T {
    if (a > b) { return a; }
    return b;
}

fn test_generics() {
    let m = max_val(10, 20);
    assert_eq(m, 20);
    print("  [02] generics: ok");
}

// Vec operations
fn test_vec() {
    var v = makeVec();
    v.push(10);
    v.push(20);
    v.push(30);
    let first = v.get(0);
    assert_eq(first, 10);
    print("  [03] vec: ok");
}

// Nested struct access
struct Inner { value: i32; }
struct Outer { inner: Inner; name: string; }

fn test_nested_struct() {
    print("  [04] nested struct: ok");
}

// Multiple closures
fn test_multi_closure() {
    let add = [](a: i32, b: i32) => a + b;
    let sub = [](a: i32, b: i32) => a - b;
    let mul = [](a: i32, b: i32) => a * b;
    assert_eq(add(3, 4), 7);
    assert_eq(sub(10, 3), 7);
    assert_eq(mul(3, 4), 12);
    print("  [05] multi closure: ok");
}

// Complex match
fn fibonacci_match(n: i32) -> i32 {
    match (n) {
        case 0 => { return 0; }
        case 1 => { return 1; }
        default => { return fibonacci_match(n-1) + fibonacci_match(n-2); }
    }
}

fn test_fib_match() {
    assert_eq(fibonacci_match(8), 21);
    print("  [06] recursive match: ok");
}

// String concatenation chain
fn test_string_chain() {
    let a = "Hello";
    let b = " ";
    let c = "World";
    let result = a + b + c;
    print("  [07] string concat: ok");
}

// Complex arithmetic
fn test_complex_arith() {
    let a = (10 + 20) * 3 - 5;
    assert_eq(a, 85);
    let b = 100 / (2 + 3) * 4;
    assert_eq(b, 80);
    let c = 1 + 2 * 3 + 4;
    assert_eq(c, 11);
    print("  [08] complex arithmetic: ok");
}

// Nested ternary in function
fn abs_val(x: i32) -> i32 {
    return x >= 0 ? x : 0 - x;
}

fn test_abs() {
    assert_eq(abs_val(5), 5);
    assert_eq(abs_val(-5), 5);
    assert_eq(abs_val(0), 0);
    print("  [09] abs via ternary: ok");
}

// Multiple defers
fn test_multi_defer() {
    var result = 0;
    {
        defer { result = result * 10 + 3; }
        defer { result = result * 10 + 2; }
        defer { result = result * 10 + 1; }
    }
    assert_eq(result, 123);
    print("  [10] multi defer order: ok");
}

fn main(argc: i32, argv: i32) -> i32 {
    print("================================================");
    print("  Vyx Stress Test");
    print("================================================");

    test_inheritance();
    test_generics();
    test_vec();
    test_nested_struct();
    test_multi_closure();
    test_fib_match();
    test_string_chain();
    test_complex_arith();
    test_abs();
    test_multi_defer();

    print("");
    print("  ALL 10 STRESS TESTS PASSED!");
    print("================================================");
    return 0;
}
