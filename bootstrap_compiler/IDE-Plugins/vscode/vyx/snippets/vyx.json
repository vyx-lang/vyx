{
  "main": {
    "prefix": "main",
    "body": [
      "fn main(argc: i32, argv: i32) -> i32 {",
      "    $0",
      "    return 0;",
      "}"
    ],
    "description": "Insert a Vyx main function"
  },
  "fn": {
    "prefix": "fn",
    "body": [
      "fn ${1:name}(${2:arg}: ${3:i32}) -> ${4:i32} {",
      "    $0",
      "}"
    ],
    "description": "Insert a function"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "Insert an if statement"
  },
  "ifelse": {
    "prefix": "ifelse",
    "body": [
      "if (${1:condition}) {",
      "    ${2:// true branch}",
      "} else {",
      "    $0",
      "}"
    ],
    "description": "Insert an if/else statement"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (var ${1:i} = ${2:0}; ${1:i} < ${3:count}; ${1:i}++) {",
      "    $0",
      "}"
    ],
    "description": "Insert a C-style for loop"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while (${1:condition}) {",
      "    $0",
      "}"
    ],
    "description": "Insert a while loop"
  },
  "foreach": {
    "prefix": "foreach",
    "body": [
      "foreach (${1:item} in ${2:items}) {",
      "    $0",
      "}"
    ],
    "description": "Insert a foreach loop"
  },
  "match": {
    "prefix": "match",
    "body": [
      "match (${1:value}) {",
      "    case ${2:pattern} => {",
      "        $0",
      "    }",
      "    default => {",
      "    }",
      "}"
    ],
    "description": "Insert a match expression"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "struct ${1:Name} {",
      "    public ${2:field}: ${3:i32};",
      "};"
    ],
    "description": "Insert a struct definition"
  },
  "class": {
    "prefix": "class",
    "body": [
      "class ${1:Name} {",
      "    public ${2:value}: ${3:i32};",
      "    public fn init(${4:v}: ${3:i32}) { self.${2:value} = ${4:v}; }",
      "};"
    ],
    "description": "Insert a class definition"
  },
  "interface": {
    "prefix": "interface",
    "body": [
      "interface ${1:Name} {",
      "    fn ${2:method}() -> ${3:i32};",
      "}"
    ],
    "description": "Insert an interface definition"
  },
  "error": {
    "prefix": "error",
    "body": [
      "error ${1:AppError} { ${2:NotFound}, ${3:InvalidInput} }"
    ],
    "description": "Insert an error enum"
  },
  "extern": {
    "prefix": "extern",
    "body": [
      "extern \"C\" {",
      "    fn ${1:name}(${2:x}: ${3:i32}) -> ${4:i32};",
      "}"
    ],
    "description": "Insert an extern C block"
  },
  "trait": {
    "prefix": "trait",
    "body": [
      "trait ${1:Name} {",
      "    fn ${2:method}(self) -> ${3:i32};",
      "}"
    ],
    "description": "Insert a trait"
  },
  "impl": {
    "prefix": "impl",
    "body": [
      "impl ${1:Trait} for ${2:Type} {",
      "    fn ${3:method}(self) -> ${4:i32} {",
      "        $0",
      "    }",
      "}"
    ],
    "description": "Insert an impl block"
  },
  "use": {
    "prefix": "use",
    "body": [
      "use ${1:std.collections};"
    ],
    "description": "Insert a use declaration"
  },
  "option": {
    "prefix": "option",
    "body": [
      "match (${1:value}) {",
      "    case Some(${2:x}) => { $0 }",
      "    case None => { }",
      "}"
    ],
    "description": "Match an Option"
  },
  "result": {
    "prefix": "result",
    "body": [
      "match (${1:value}) {",
      "    case Ok(${2:x}) => { $0 }",
      "    case Err(${3:e}) => { return ${4:1}; }",
      "}"
    ],
    "description": "Match a Result"
  }
}
