{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Vyx",
  "scopeName": "source.vyx",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#namespaces" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#modifiers" },
    { "include": "#operators" },
    { "include": "#functions" },
    { "include": "#attributes" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.vyx", "match": "///.*$" },
        { "name": "comment.line.double-slash.vyx", "match": "//.*$" },
        { "name": "comment.block.vyx", "begin": "/\\*", "end": "\\*/", "patterns": [{ "include": "#comments" }] }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.vyx",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.vyx", "match": "\\\\." },
            { "name": "meta.embedded.expression.vyx", "begin": "\\$\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
          ]
        },
        { "name": "string.quoted.single.vyx", "match": "'(?:\\\\.|[^'\\\\])'" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.vyx", "match": "\\b0[xX][0-9a-fA-F]+\\b" },
        { "name": "constant.numeric.float.vyx", "match": "\\b\\d+\\.\\d+\\b" },
        { "name": "constant.numeric.integer.vyx", "match": "\\b\\d+\\b" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.vyx", "match": "\\b(if|elif|else|while|for|foreach|match|case|default|return|break|continue|yield|defer|await|try|catch|throw)\\b" },
        { "name": "keyword.declaration.vyx", "match": "\\b(fn|let|var|struct|class|interface|enum|error|module|use|import|export|extern|type|concept|comptime|bench|task|impl|trait)\\b" },
        { "name": "keyword.other.vyx", "match": "\\b(as|in|where|requires|override|static_assert|fail|unsafe|box|ref)\\b" }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "name": "entity.name.namespace.vyx",
          "match": "(?<=\\b(?:module|use)\\s+)[a-zA-Z_][a-zA-Z0-9_]*(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)*"
        }
      ]
    },
    "types": {
      "patterns": [
        { "name": "storage.type.primitive.vyx", "match": "\\b(i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|bool|char|string|wstring|isize|usize|rawptr|void|Self)\\b" },
        { "name": "storage.type.generic.vyx", "match": "\\b(Vec|Dict|Set|Stack|Queue|Option|Result|Ref|Scope|Weak|Channel|Mutex|Event|Delegate|Buffer)\\b" }
      ]
    },
    "constants": {
      "patterns": [
        { "name": "constant.language.vyx", "match": "\\b(true|false|null|self|none)\\b" }
      ]
    },
    "modifiers": {
      "patterns": [
        { "name": "storage.modifier.vyx", "match": "\\b(public|private|mut|const|static|async|export|unsafe)\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.comparison.vyx", "match": "==|!=|<=|>=|<|>" },
        { "name": "keyword.operator.logical.vyx", "match": "&&|\\|\\||!" },
        { "name": "keyword.operator.arrow.vyx", "match": "->|=>" },
        { "name": "keyword.operator.assignment.vyx", "match": "\\+=|-=|\\*=|/=|%=|<<=|>>=|&=|\\|=|\\^=" },
        { "name": "keyword.operator.range.vyx", "match": "\\.\\." }
      ]
    },
    "functions": {
      "patterns": [
        { "name": "entity.name.function.vyx", "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()" },
        { "name": "entity.name.function.builtin.vyx", "match": "\\b(print|assert|assert_eq|panic|typeinfo|makeVec|makeDict|makeSet|makeRef|makeScope|makeEvent|makeChannel|makeMutex|from_cstr|to_rawptr|spawn|sleep_ms|startThread|WaitForSeconds)\\b" }
      ]
    },
    "attributes": {
      "patterns": [
        { "name": "meta.attribute.vyx", "match": "@\\[[^\\]]+\\]" }
      ]
    }
  }
}