<templateSet group="Vyx">
    <template name="fn" value="fn $NAME$($PARAMS$) -&gt; $RETURN$ {&#10;    $END$&#10;}" description="Function declaration" toReformat="true" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="myFunction" alwaysStopAt="true"/>
        <variable name="PARAMS" expression="" defaultValue="" alwaysStopAt="true"/>
        <variable name="RETURN" expression="" defaultValue="i32" alwaysStopAt="true"/>
        <context><option name="VYX" value="true"/></context>
    </template>
    <template name="main" value="fn main(argc: i32, argv: i32) -&gt; i32 {&#10;    $END$&#10;    return 0;&#10;}" description="Main function" toReformat="true" toShortenFQNames="false">
        <context><option name="VYX" value="true"/></context>
    </template>
    <template name="struct" value="struct $NAME$ {&#10;    $FIELD$: $TYPE$&#10;}" description="Struct declaration" toReformat="true" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="MyStruct" alwaysStopAt="true"/>
        <variable name="FIELD" expression="" defaultValue="value" alwaysStopAt="true"/>
        <variable name="TYPE" expression="" defaultValue="i32" alwaysStopAt="true"/>
        <context><option name="VYX" value="true"/></context>
    </template>
    <template name="class" value="class $NAME$ {&#10;    private $FIELD$: $TYPE$&#10;&#10;    public fn $METHOD$() {&#10;        $END$&#10;    }&#10;}" description="Class declaration" toReformat="true" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="MyClass" alwaysStopAt="true"/>
        <variable name="FIELD" expression="" defaultValue="value" alwaysStopAt="true"/>
        <variable name="TYPE" expression="" defaultValue="i32" alwaysStopAt="true"/>
        <variable name="METHOD" expression="" defaultValue="doSomething" alwaysStopAt="true"/>
        <context><option name="VYX" value="true"/></context>
    </template>
    <template name="iface" value="interface $NAME$ {&#10;    fn $METHOD$($PARAMS$) -&gt; $RETURN$;&#10;}" description="Interface declaration" toReformat="true" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="IMyInterface" alwaysStopAt="true"/>
        <variable name="METHOD" expression="" defaultValue="doWork" alwaysStopAt="true"/>
        <variable name="PARAMS" expression="" defaultValue="" alwaysStopAt="true"/>
        <variable name="RETURN" expression="" defaultValue="i32" alwaysStopAt="true"/>
        <context><option name="VYX" value="true"/></context>
    </template>
    <template name="for" value="foreach ($VAR$ in $COLLECTION$) {&#10;    $END$&#10;}" description="Foreach loop" toReformat="true" toShortenFQNames="false">
        <variable name="VAR" expression="" defaultValue="item" alwaysStopAt="true"/>
        <variable name="COLLECTION" expression="" defaultValue="items" alwaysStopAt="true"/>
        <context><option name="VYX" value="true"/></context>
    </template>
    <template name="match" value="match ($EXPR$) {&#10;    case $PATTERN$ =&gt; {&#10;        $END$&#10;    }&#10;    default =&gt; {}&#10;}" description="Match expression" toReformat="true" toShortenFQNames="false">
        <variable name="EXPR" expression="" defaultValue="value" alwaysStopAt="true"/>
        <variable name="PATTERN" expression="" defaultValue="0" alwaysStopAt="true"/>
        <context><option name="VYX" value="true"/></context>
    </template>
    <template name="test" value="@[test]&#10;fn test_$NAME$() {&#10;    $END$&#10;}" description="Test function" toReformat="true" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="something" alwaysStopAt="true"/>
        <context><option name="VYX" value="true"/></context>
    </template>
    <template name="import" value="import $MODULE$;" description="Import statement" toReformat="true" toShortenFQNames="false">
        <variable name="MODULE" expression="" defaultValue="std::io" alwaysStopAt="true"/>
        <context><option name="VYX" value="true"/></context>
    </template>
    <template name="enum" value="enum $NAME$ {&#10;    $VARIANT1$;&#10;    $VARIANT2$;&#10;}" description="Enum declaration" toReformat="true" toShortenFQNames="false">
        <variable name="NAME" expression="" defaultValue="MyEnum" alwaysStopAt="true"/>
        <variable name="VARIANT1" expression="" defaultValue="First" alwaysStopAt="true"/>
        <variable name="VARIANT2" expression="" defaultValue="Second" alwaysStopAt="true"/>
        <context><option name="VYX" value="true"/></context>
    </template>
</templateSet>
