<idea-plugin>
    <id>com.vyx.plugin</id>
    <name>Vyx</name>
    <vendor>VyxLan</vendor>
    <description><![CDATA[
        Vyx language support for the JetBrains IDE family:<br/>
        <ul>
          <li>New Project templates: Binary (app), Library (static), Library (shared)</li>
          <li>Auto-created Run configurations after New Project</li>
          <li>Toolchain Settings (Languages and Frameworks - Vyx) shared with New Project defaults</li>
          <li>Syntax highlighting for .vyx / .vyi</li>
          <li>Keyword completion, and `use std.` package-registry completion (prefix match)</li>
          <li>LSP: diagnostics (Exxxx), completion, hover, definition, references, rename, symbols, signature help, semantic tokens, folding, format, code actions</li>
          <li>DAP: line breakpoints, stack, scopes, variables, stepping, evaluate</li>
          <li>Format Document / Reformat Code uses vyxc-lsp, with a local indent engine as fallback</li>
        </ul>
        Tool resolution: <b>Settings -&gt; project SDK -&gt; bundled toolchain -&gt; environment/PATH</b>.
    ]]></description>

    <dependencies>
        <plugin id="com.intellij.modules.platform"/>
        <module name="intellij.platform.dap" namespace="jetbrains"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <fileType
            name="Vyx"
            implementationClass="com.vyx.plugin.VyxFileType"
            fieldName="INSTANCE"
            language="Vyx"
            extensions="vyx;vyi"/>

        <lang.parserDefinition
            language="Vyx"
            implementationClass="com.vyx.plugin.VyxParserDefinition"/>

        <lang.syntaxHighlighterFactory
            language="Vyx"
            implementationClass="com.vyx.plugin.VyxSyntaxHighlighterFactory"/>

        <colorSettingsPage implementation="com.vyx.plugin.VyxColorSettingsPage"/>

        <lang.braceMatcher
            language="Vyx"
            implementationClass="com.vyx.plugin.VyxBraceMatcher"/>

        <lang.commenter
            language="Vyx"
            implementationClass="com.vyx.plugin.VyxCommenter"/>

        <completion.contributor
            language="Vyx"
            implementationClass="com.vyx.plugin.VyxCompletionContributor"/>

        <enterBetweenBracesDelegate
            language="Vyx"
            implementationClass="com.vyx.plugin.VyxEnterBetweenBracesHandler"/>

        <directoryProjectGenerator implementation="com.vyx.plugin.VyxProjectGenerator"/>

        <configurationType implementation="com.vyx.plugin.VyxConfigurationType"/>

        <programRunner implementation="com.vyx.plugin.VyxProgramRunner"/>

        <xdebugger.breakpointType implementation="com.vyx.plugin.VyxLineBreakpointType"/>
        <xdebugger.breakpointType implementation="com.vyx.plugin.VyxExceptionBreakpointType"/>

        <platform.dap.debugAdapterSupportProvider
            implementation="com.vyx.plugin.VyxDebugAdapterSupportProvider"/>

        <platform.dap.launchArgumentsProvider
            implementation="com.vyx.plugin.VyxDapLaunchArgumentsProvider"/>

        <projectConfigurable
            instance="com.vyx.plugin.VyxSettingsConfigurable"
            displayName="Vyx"
            id="vyx.settings"
            parentId="language"/>

        <platform.lsp.serverSupportProvider
            implementation="com.vyx.plugin.VyxLspServerSupportProvider"/>

        <defaultLiveTemplates file="/liveTemplates/Vyx.xml"/>
        <liveTemplateContext
            implementation="com.vyx.plugin.VyxLiveTemplateContext"
            contextId="VYX"/>

        <problemFileHighlightFilter
            implementation="com.vyx.plugin.VyxProblemFilter"/>

        <externalFormatProcessor implementation="com.vyx.plugin.VyxExternalFormatProcessor"/>
    </extensions>

    <actions>
        <group id="VyxMenu" text="Vyx" popup="true">
            <add-to-group group-id="MainMenu" anchor="before" relative-to-action="HelpMenu"/>
            <action id="Vyx.RunFile" class="com.vyx.plugin.VyxRunFileAction" text="Run Current File"
                    description="Compile and run the current .vyx file (vyxc --src=file --run=aot)">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift R"/>
            </action>
            <action id="Vyx.Build" class="com.vyx.plugin.VyxBuildAction" text="Build Project"
                    description="Build with vyxc build">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift B"/>
            </action>
            <separator/>
            <action id="Vyx.Test" class="com.vyx.plugin.VyxTestAction" text="Run Tests"
                    description="Run TOML scripts via vyxc run test">
                <keyboard-shortcut keymap="$default" first-keystroke="ctrl shift T"/>
            </action>
            <action id="Vyx.Format" class="com.vyx.plugin.VyxFmtAction" text="Format File"
                    description="Reformat with Vyx indent / LSP formatter"/>
            <action id="Vyx.Doc" class="com.vyx.plugin.VyxDocAction" text="Generate Docs"
                    description="Generate API documentation"/>
        </group>
        <group id="VyxEditorPopup" text="Vyx">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>
            <action id="Vyx.RunPopup" class="com.vyx.plugin.VyxRunFileAction" text="Run This Vyx File"/>
            <action id="Vyx.FmtPopup" class="com.vyx.plugin.VyxFmtAction" text="Format Vyx File"/>
        </group>
    </actions>
</idea-plugin>
