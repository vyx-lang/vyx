module myBench.containers;

use std.collections;
use std.string;

extern "C" {
    fn GetTickCount64() -> u64;
}

fn now_ms() -> i64 {
    return GetTickCount64() as i64;
}

const N_PUSH: i64 = 100000000;
const N_GET: i64 = 100000000;
const N_SORT: i64 = 10000000;
const N_MAP_PUT: i64 = 10000000;
const N_MAP_GET: i64 = 10000000;
const N_STR_APPEND: i64 = 2000000;
const N_UPPER: i64 = 200000;

fn expected_xor(n: i64) -> i64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    while (i < n) { acc = acc ^ i; i = i + 1; }
    return acc;
}

fn bench_vec_push_pop() -> i64 {
    let t0 = now_ms();
    var v = Vec::<i64>.with_capacity(N_PUSH);
    var i: i64 = 0;
    while (i < N_PUSH) { v.push_unchecked(i); i = i + 1; }
    var sum: i64 = 0;
    var k: i64 = 0;
    while (k < N_PUSH) { sum = sum ^ v.pop(); k = k + 1; }
    if (sum != expected_xor(N_PUSH)) { panic("vec push/pop checksum mismatch"); }
    v.destroy();
    return now_ms() - t0;
}

fn bench_vec_get_set() -> i64 {
    var v = Vec::<i64>.with_capacity(N_GET);
    var fill: i64 = 0;
    while (fill < N_GET) { v.push_unchecked(fill); fill = fill + 1; }
    let t0 = now_ms();
    var sum: u64 = 0;
    var k: i64 = 0;
    while (k < N_GET) {
        let idx = (k * 2654435761) % N_GET;
        sum = sum + (v.get_unchecked(idx) as u64);
        k = k + 1;
    }
    if (sum == 1) { print("impossible"); } // defeat DCE: consume the sum
    let ms = now_ms() - t0;
    v.destroy();
    return ms;
}

fn xorshift(state: i64) -> i64 {
    var s = state;
    s = s ^ (s << 13);
    s = s ^ (s >> 7);
    s = s ^ (s << 17);
    return s;
}

fn bench_vec_sort() -> i64 {
    var rng: i64 = -7046029254386353131;
    var v = Vec::<i64>.with_capacity(N_SORT);
    var i: i64 = 0;
    while (i < N_SORT) {
        rng = xorshift(rng);
        v.push_unchecked(rng);
        i = i + 1;
    }
    let t0 = now_ms();
    v.sort();
    let first = v.get_unchecked(0);
    let last = v.get_unchecked(N_SORT - 1);
    if (first > last) { panic("vec sort did not sort"); }
    v.destroy();
    return now_ms() - t0;
}

fn bench_map_put() -> i64 {
    var m = Dict::<i64, i64>.with_capacity(N_MAP_PUT);
    let t0 = now_ms();
    var i: i64 = 0;
    while (i < N_MAP_PUT) { m.put(i * 2654435761, i); i = i + 1; }
    let ms = now_ms() - t0;
    m.destroy();
    return ms;
}

fn bench_map_get() -> i64 {
    var m = Dict::<i64, i64>.with_capacity(N_MAP_PUT);
    var i: i64 = 0;
    while (i < N_MAP_PUT) { m.put(i * 2654435761, i); i = i + 1; }
    let t0 = now_ms();
    var sink: i64 = 0;
    var k: i64 = 0;
    while (k < N_MAP_GET) {
        sink = sink ^ m.get(k * 2654435761);
        k = k + 1;
    }
    if (sink == 1) { print("impossible"); } // defeat DCE: consume the sink
    let ms = now_ms() - t0;
    m.destroy();
    return ms;
}

fn bench_string_append() -> i64 {
    let frag: str = "abcdefgh01234567";
    let t0 = now_ms();
    var s = String.withCapacity(1024);
    var i: i64 = 0;
    while (i < N_STR_APPEND) { s.append(frag); i = i + 1; }
    if (s.length() != N_STR_APPEND * 16) { panic("string append length mismatch"); }
    s.destroy();
    return now_ms() - t0;
}

fn bench_string_upper() -> i64 {
    let base: str = "the quick brown fox jumps over the lazy dog 0123456789!abcdefgh";
    var sink: i64 = 0;
    let t0 = now_ms();
    var i: i64 = 0;
    while (i < N_UPPER) {
        let up = base.toUpper();
        sink = sink + up.length();
        up.destroy();
        i = i + 1;
    }
    return now_ms() - t0;
}

fn report(name: str, ms: i64) {
    var s = String.withCapacity(64);
    s.append(name);
    s.appendI64(ms);
    s.append(" ms");
    print(s.raw());
    s.destroy();
}

fn main() -> i32 {
    print("=== Vyx container baseline ===");
    report("vec   push+pop x1e8      : ", bench_vec_push_pop());
    report("vec   random get  x1e8    : ", bench_vec_get_set());
    report("vec   sort x1e7           : ", bench_vec_sort());
    report("map   put       x1e7      : ", bench_map_put());
    report("map   get hit   x1e7      : ", bench_map_get());
    report("str   append x2e6(16B)    : ", bench_string_append());
    report("str   to_upper x2e5(64B)  : ", bench_string_upper());
    return 0;
}
