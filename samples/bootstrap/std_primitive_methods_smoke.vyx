use std.hash;
use std.clone;

fn main() -> i32 {
    let x: i64 = 7;
    let hx: i64 = x.hash();
    let cx: i64 = x.clone();
    if (!x.operator_eq(cx)) { return 1; }
    if (hx == 0) { return 2; }

    let s: string = "vyx";
    let cs: string = s.clone();
    if (!s.operator_eq(cs)) { return 3; }
    if (s.hash() == 0) { return 4; }
    return 0;
}
