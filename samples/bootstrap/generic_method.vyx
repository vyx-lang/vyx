module sample_generic_method;

class MethodBox {
    public seed: i32;

    public fn id<T>(self, value: T) -> T {
        return value;
    }
}

fn main() -> i32 {
    let n: i32 = argCount();
    let box = MethodBox { seed: n };
    let got: i32 = box.id::<i32>(n + 23);
    let n64: i64 = n as i64;
    let wide: i64 = box.id::<i64>(n64 + 29i64);
    return (got - (n + 23)) + ((wide - (n64 + 29i64)) as i32);
}
