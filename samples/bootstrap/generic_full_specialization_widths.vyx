module sample_generic_full_specialization_widths;

fn marker<T>(x: T) -> i32 {
    return 0;
}

fn marker<i8>(x: i8) -> i32 {
    return (x as i32) + 11;
}

fn marker<i16>(x: i16) -> i32 {
    return (x as i32) + 13;
}

fn marker<u8>(x: u8) -> i32 {
    return (x as i32) + 17;
}

fn marker<u16>(x: u16) -> i32 {
    return (x as i32) + 19;
}

fn marker<char>(x: char) -> i32 {
    return x + 23;
}

fn marker<rawptr>(x: rawptr) -> i32 {
    if (x == null) { return 29; }
    return 31;
}

fn main() -> i32 {
    let a: i8 = 7i8;
    if (marker::<i8>(a) != 18) { return 1; }

    let b: i16 = 9i16;
    if (marker::<i16>(b) != 22) { return 2; }

    let c: u8 = 5u8;
    if (marker::<u8>(c) != 22) { return 3; }

    let d: u16 = 6u16;
    if (marker::<u16>(d) != 25) { return 4; }

    if (marker::<char>('A') != 88) { return 5; }
    if (marker::<rawptr>(null) != 29) { return 6; }

    return 0;
}
