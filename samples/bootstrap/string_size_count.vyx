module sample.string_size_count;

use std.string;

fn main() -> i32 {
    let s: string = "alpha" + " beta";
    if (s.size() != 10) { return 1; }
    if (s.count() != 10) { return 2; }

    let empty: string = "";
    if (empty.size() != 0) { return 3; }
    if (empty.count() != 0) { return 4; }

    let tiny: string = "xy";
    if (tiny.size() != 2) { return 5; }
    if (tiny.count() != 2) { return 6; }
    return 0;
}
