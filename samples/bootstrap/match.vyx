module sample_match;
use std.string;

use std.io;

fn classify(x: i32) -> i32 {
    match (x) {
        case 0 => { return 0; }
        case 1 => { return 10; }
        case 2 => { return 20; }
        default => { return 99; }
    }
}

fn main() -> i32 {
    let a: i32 = classify(0);
    let b: i32 = classify(2);
    let c: i32 = classify(5);
    print("classify(0) = ");
    println(a.toString());
    print("classify(2) = ");
    println(b.toString());
    print("classify(5) = ");
    println(c.toString());
    return 0;
}
