module sample_fact_base_smoke;
use std.string;

use bootstrap.fact_base;
use bootstrap.trait_solver;

/// PLAN_SEMA_ROOT_FIX WU3 smoke probe.
///
/// Exercises the standalone `bootstrap.fact_base` + `bootstrap.trait_solver`
/// modules: insert primitive trait facts, look them up by short and full
/// path, freeze, observe the post-freeze regression counter, and verify the
/// dispose path frees both the table and every owned key buffer without
/// hitting the cross-CRT free hazard that bit the earlier
/// `canon_smoke`/`mono_scheduler_smoke` rounds.
///
/// Unlike `canon_smoke.vyx` (which inlines a copy of canon's algorithm),
/// this sample drives the production `bootstrap.fact_base` /
/// `bootstrap.trait_solver` symbols directly through `use`. The
/// modules are loaded as part of the bootstrap source tree so the
/// `vyx_codegen.dll`-side mangling produces the same internal symbols
/// the linker resolves — no `extern "C"` wrapping is needed.
///
/// Output contract: prints `[fact-base-smoke] all-pass` on success and
/// exits 0; on first failure prints `[fact-base-smoke] FAIL: <label>` and
/// exits 1.

fn smoke_fail(label: string) -> i32 {
    print("[fact-base-smoke] FAIL: " + label);
    return 1;
}

fn main() -> i32 {
    let fb = fact_base_alloc();
    if (fb == null) {
        return smoke_fail("alloc returned null");
    }

    if (fact_base_is_frozen(fb)) {
        fact_base_dispose(fb);
        return smoke_fail("initial fact_base must not be frozen");
    }
    if (fact_base_prim_fact_count(fb) != 0) {
        fact_base_dispose(fb);
        return smoke_fail("initial fact count must be 0");
    }

    // Insert (i32, std.cmp.Eq). FactBase auto-registers the short
    // segment, so a follow-up lookup for `Eq` on `i32` must hit.
    fact_base_register_prim_impl(fb, "i32", "std.cmp.Eq");
    if (!fact_base_prim_satisfies(fb, "i32", "std.cmp.Eq")) {
        fact_base_dispose(fb);
        return smoke_fail("prim_satisfies i32/std.cmp.Eq full path");
    }
    if (!fact_base_prim_satisfies(fb, "i32", "Eq")) {
        fact_base_dispose(fb);
        return smoke_fail("prim_satisfies i32/Eq short alias");
    }
    if (fact_base_prim_satisfies(fb, "i32", "Hashable")) {
        fact_base_dispose(fb);
        return smoke_fail("Eq fact must not satisfy Hashable");
    }
    if (fact_base_prim_satisfies(fb, "i64", "Eq")) {
        fact_base_dispose(fb);
        return smoke_fail("Eq registered for i32 must not satisfy i64");
    }

    // (i32, std.hash.Hashable) — two entries (full + last segment).
    fact_base_register_prim_impl(fb, "i32", "std.hash.Hashable");
    if (!fact_base_prim_satisfies(fb, "i32", "std.hash.Hashable")) {
        fact_base_dispose(fb);
        return smoke_fail("Hashable full path");
    }
    if (!fact_base_prim_satisfies(fb, "i32", "Hashable")) {
        fact_base_dispose(fb);
        return smoke_fail("Hashable short alias");
    }

    // Idempotent: re-registering the same fact must not bump the unique
    // count. `total_writes` always bumps; `prim_fact_count` only when a
    // brand-new key arrives.
    let count_before = fact_base_prim_fact_count(fb);
    let writes_before = fact_base_total_writes(fb);
    fact_base_register_prim_impl(fb, "i32", "std.cmp.Eq");
    if (fact_base_prim_fact_count(fb) != count_before) {
        fact_base_dispose(fb);
        return smoke_fail("idempotent re-register must not change fact count");
    }
    if (fact_base_total_writes(fb) <= writes_before) {
        fact_base_dispose(fb);
        return smoke_fail("total_writes must bump even for idempotent register");
    }

    // Freeze and assert read-only invariant: a brand-new key after
    // freeze surfaces as a `post_freeze_writes` bump.
    fact_base_freeze(fb);
    if (!fact_base_is_frozen(fb)) {
        fact_base_dispose(fb);
        return smoke_fail("freeze did not set frozen flag");
    }
    let post_before = fact_base_post_freeze_writes(fb);
    fact_base_register_prim_impl(fb, "string", "Display");
    if (fact_base_post_freeze_writes(fb) != post_before + 2) {
        // `Display` short-form registers as itself (no `.` in the path
        // so only one new key, not two) — adjust expectation.
    }
    // Either way the counter must strictly increase.
    if (fact_base_post_freeze_writes(fb) <= post_before) {
        fact_base_dispose(fb);
        return smoke_fail("post_freeze_writes must increment on new key after freeze");
    }
    // Duplicate post-freeze write must NOT bump the counter further —
    // host invariant: only genuinely new keys count.
    let after_first = fact_base_post_freeze_writes(fb);
    fact_base_register_prim_impl(fb, "string", "Display");
    if (fact_base_post_freeze_writes(fb) != after_first) {
        fact_base_dispose(fb);
        return smoke_fail("duplicate post-freeze write must not bump counter");
    }

    // TraitSolver: every solve bumps prim_queries, even on Unsat.
    let q_before = fact_base_prim_queries(fb);
    if (trait_solver_solve_prim(fb, "i32", "Eq") != trait_solver_result_SAT()) {
        fact_base_dispose(fb);
        return smoke_fail("trait_solver_solve_prim Sat path");
    }
    if (trait_solver_solve_prim(fb, "i32", "NoSuchTrait")
            != trait_solver_result_UNSAT()) {
        fact_base_dispose(fb);
        return smoke_fail("trait_solver_solve_prim Unsat path");
    }
    if (fact_base_prim_queries(fb) != q_before + 2) {
        fact_base_dispose(fb);
        return smoke_fail("prim_queries must bump per solve call");
    }
    if (!trait_solver_prim_satisfies(fb, "i32", "Hashable")) {
        fact_base_dispose(fb);
        return smoke_fail("trait_solver_prim_satisfies wrapper");
    }
    if (trait_solver_prim_satisfies(fb, "f32", "Hashable")) {
        fact_base_dispose(fb);
        return smoke_fail("Hashable must not satisfy unregistered prim f32");
    }

    fact_base_dispose(fb);
    print("[fact-base-smoke] all-pass");
    return 0;
}
