module bootstrap;

extern "C" {
    fn malloc(size: u64) -> rawptr;
    fn free(p: rawptr) -> void;
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
    fn to_rawptr(p: rawptr) -> rawptr;
}

class Cg {
    public mod: rawptr;
    public error_count: i32;
    public static fn create(name: string) -> Cg {
        return Cg { mod: null, error_count: 0 };
    }
    public fn run(self, unit: rawptr) {
        self.error_count = self.error_count + 1;
    }
}

fn vyx_rt_module_free(m: rawptr) {
}

public fn emit_unit_test(unit: rawptr, mod_name: string) -> rawptr {
    let cg = Cg.create(mod_name);
    if (unit != null) {
        cg.run(unit);
    }
    if (cg.error_count > 0) {
        vyx_rt_module_free(cg.mod);
        return null;
    }
    let handle = malloc(8);
    if (handle == null) { return null; }
    var mod_local: rawptr = cg.mod;
    memcpy(handle, to_rawptr(&mod_local), 8);
    return handle;
}

fn main() -> i32 {
    let r = emit_unit_test(null, "test");
    if (r != null) { free(r); }
    return 0;
}
