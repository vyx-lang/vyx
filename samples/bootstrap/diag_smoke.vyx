module sample_diag_smoke;

/// Stand-alone smoke test for the WU1 diagnostics engine.
///
/// Designed to compile cleanly through `boot_a --emit-ir` so the fixpoint
/// sample sweep does NOT regress. To exercise the engine end-to-end use
/// `boot_a --stop-after-sema tests/bootstrap/diag_smoke.vyx`,
/// which deliberately triggers five distinct host-aligned codes — see
/// `bootstrap_compiler/scripts/test_diag_smoke.ps1` for the assertion.
///
/// What this file demonstrates statically:
///   * Five different `error[<CODE>]` lines (printed in this comment
///     header as the expected diag-renderer output shape) showcase the
///     `<file>:<line>:<col>: <level>[<CODE>]: <msg>` prefix shape that
///     mirrors `vyx::DiagnosticsEngine::printDiagnostic` in
///     `src/Common/Diagnostics.cpp`.
///   * The runtime body keeps every name unique and well-typed so Sema
///     produces zero diagnostics during the fixpoint sweep.
///
/// Expected diag prefixes when `tests/diag_smoke.vyx` is run through
/// the smoke driver (line numbers match that companion file):
///   tests/diag_smoke.vyx:6:1:   error[SEMA-001]: class name 'Box' is reserved …
///   tests/diag_smoke.vyx:11:1:  error[SEMA-002-Duplicate]: duplicate function dup_fn
///   tests/diag_smoke.vyx:15:5:  error[SEMA-005-TypeMismatch]: let/var bad: type mismatch …
///   tests/diag_smoke.vyx:16:5:  error[SEMA-008-Undefined]: undefined function 'undefined_smoke_target'
///   tests/diag_smoke.vyx:17:5:  error[SEMA-009-ControlFlow]: break/continue outside of loop

fn diag_smoke_path() -> i32 {
    var seen: i32 = 0;
    let path = "tests/bootstrap/diag_smoke.vyx";
    if (path.len > 0) { seen = seen + 1; }
    return seen;
}

fn main() -> i32 {
    return diag_smoke_path();
}
