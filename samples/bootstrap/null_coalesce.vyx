module sample.null_coalesce;

fn choose_ptr(a: rawptr, b: rawptr) -> rawptr {
    return a ?? b;
}

fn main() -> i32 {
    let first = malloc(4);
    let second = malloc(4);
    ptr_write_i32(first, 77);
    ptr_write_i32(second, 88);

    let from_second = choose_ptr(null, second);
    if (ptr_read_i32(from_second) != 88) { return 1; }

    let from_first = choose_ptr(first, second);
    if (ptr_read_i32(from_first) != 77) { return 2; }

    let chained = null ?? null ?? first;
    if (ptr_read_i32(chained) != 77) { return 3; }

    return 0;
}
