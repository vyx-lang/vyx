use std.hash;
use std.clone;
use std.fmt;

@[derive(Eq, Clone, Hashable, Ord, Debug, Display)]
class Pair {
    public x: i64;
    public y: i64;
}

fn main() -> i32 {
    let a: Pair = Pair { x: 7, y: 9 };
    let b: Pair = a.clone();
    if (!a.operator_eq(b)) { return 1; }
    if (a.hash() == 0) { return 2; }
    if (a.compare(b) != 0) { return 3; }
    if (!a.debug().contains("x=7")) { return 4; }
    if (!a.display().contains("7")) { return 5; }
    return 0;
}
