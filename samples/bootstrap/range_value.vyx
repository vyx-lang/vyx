module sample.range_value;

fn make_span() -> Range {
    return 2..5;
}

fn main() -> i32 {
    let saved: Range = make_span();
    var total: i64 = 0;
    for (i in saved) {
        total = total + i;
    }
    if (total != 9) { return 1; }

    var inclusive_total: i64 = 0;
    for (j in 2..=4) {
        inclusive_total = inclusive_total + j;
    }
    if (inclusive_total != 9) { return 2; }

    var reassigned: Range = 0..0;
    reassigned = 4..6;
    var reassigned_total: i64 = 0;
    for (k in reassigned) {
        reassigned_total = reassigned_total + k;
    }
    if (reassigned_total != 9) { return 3; }

    return 0;
}
