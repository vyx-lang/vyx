module sample_decl_metadata;

/// Free function metadata is retained on the Decl node.
@[inline]
public fn annotated_value(x: i32) -> i32 {
    return x + 1;
}

/// Class metadata is retained without changing same-module lowering.
@[layout(C)]
internal class AnnotatedBox {
    /// Public field metadata is retained on the member Decl.
    @[slot(0)]
    public value: i32;

    protected extra: i32;

    @[fast]
    public fn get(self) -> i32 {
        return self.value + self.extra;
    }
}

private fn hidden_value(x: i32) -> i32 {
    return x;
}

fn main() -> i32 {
    let n: i32 = argCount();
    let b = AnnotatedBox { value: n, extra: 5 };
    return (b.get() - (n + 5)) + (annotated_value(5) - 6) + hidden_value(0);
}
