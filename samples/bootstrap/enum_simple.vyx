module sample_enum_simple;
use std.string;

use std.io;

enum Color {
    Red,
    Green,
    Blue
}

fn color_name(c: Color) -> void {
    match (c) {
        case 0 => { print("Red"); }
        case 1 => { print("Green"); }
        case 2 => { print("Blue"); }
        default => { print("Unknown"); }
    }
}

fn main() -> i32 {
    var r: Color = Color::Red();
    var g: Color = Color::Green();
    var b: Color = Color::Blue();

    print("r = ");
    color_name(r);
    println("");

    print("g = ");
    color_name(g);
    println("");

    print("b = ");
    color_name(b);
    println("");

    println(r.toString());
    println(g.toString());
    println(b.toString());

    return 0;
}
