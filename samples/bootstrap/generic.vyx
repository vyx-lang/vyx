module sample_generic;
use std.string;

use std.io;

fn identity<T>(x: T) -> T {
    return x;
}

fn add<T>(a: T, b: T) -> T {
    return a + b;
}

fn main() -> i32 {
    let r1 = identity::<i32>(42);
    println(r1.toString());

    let r2 = add::<i32>(10, 20);
    println(r2.toString());

    let r3 = identity::<i64>(100);
    println(r3.toString());

    return 0;
}
