module sample_scope_type_cache;

class I32Box {
    public value: i32;

    public fn get(self) -> i32 {
        return self.value;
    }
}

class I64Box {
    public value: i64;

    public fn get(self) -> i64 {
        return self.value;
    }
}

fn main() -> i32 {
    let n: i32 = argCount();
    let box = I32Box { value: n + 1 };
    {
        let box = I64Box { value: (n as i64) + 9i64 };
        if (box.get() != ((n as i64) + 9i64)) {
            return 1;
        }
    }
    return box.get() - (n + 1);
}
