module sample_generic_class_full_specialization;

class SpecializedBox<T> {
    public value: T;

    public fn total(self) -> i32 {
        return 0;
    }
}

class SpecializedBox<i32> {
    public value: i32;
    public bonus: i32;

    public fn total(self) -> i32 {
        return self.value + self.bonus;
    }
}

class SpecializedBox<i64> {
    public value: i64;

    public fn total(self) -> i32 {
        return (self.value - 5i64) as i32;
    }
}

fn main() -> i32 {
    let n: i32 = argCount();

    let small = SpecializedBox::<i32> { value: n + 10, bonus: 32 };
    if (small.bonus != 32) { return 1; }
    if (small.total() != n + 42) { return 2; }

    let wide = SpecializedBox::<i64> { value: (n as i64) + 48i64 };
    if (wide.total() != n + 43) { return 3; }

    return 0;
}
