module sample.string_trim;

use std.collections;

fn main() -> i32 {
    let padded: string = "  alpha beta  ";
    let clean: string = padded.trim();
    if (!clean.equals("alpha beta")) { return 1; }
    if (!"plain".trim().equals("plain")) { return 2; }
    if (!"   ".trim().isEmpty()) { return 3; }
    return 0;
}
