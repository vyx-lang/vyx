module sample.i16_memcpy_return;

extern "C" {
    fn memcpy(dst: rawptr, src: rawptr, n: u64) -> rawptr;
}

public fn read_i16(ptr: rawptr, offset: i32) -> i16 {
    var out: i16 = 0 as i16;
    memcpy(to_rawptr(&out), ptr + offset as i64, 2);
    return out;
}

class E {
    public v: i32;

    public static fn empty() -> E {
        return E { v: 0 };
    }
}

fn decode(ptr: rawptr) -> E {
    var ev = E.empty();
    ev.v = read_i16(ptr, 0) as i32;
    return ev;
}

fn main() -> i32 {
    var src: i16 = -1234 as i16;
    let ev = decode(to_rawptr(&src));
    if (ev.v != -1234) { return 1; }
    return 0;
}
