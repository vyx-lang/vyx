module sample_ternary;
use std.string;

use std.io;

fn main() -> i32 {
    let x: i32 = 7;
    let y: i32 = 5;
    let max: i32 = x > y ? x : y;
    let min: i32 = x < y ? x : y;
    println(max.toString());
    println(min.toString());

    let flag: bool = true;
    let s: string = flag ? "yes" : "no";
    println(s);

    return 0;
}
