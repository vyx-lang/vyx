module sample_drop_smoke;

use std.string;

/// W2 owned-class Drop auto-injection smoke probe.
///
/// Verifies that `bootstrap.codegen` injects `.drop(self)` calls for
/// every owned local across all four scope-exit paths:
///   * natural block end          (`scope_natural_exit`)
///   * early `return`             (`scope_return`)
///   * `break` out of a loop      (`scope_break`)
///   * `continue` skipping a body (`scope_continue`)
///   * `fail` raising an error    (`scope_fail`)
///
/// The owned class is `Counter` — a user-defined class with an explicit
/// `drop(self)` method that bumps a process-global counter. Each path
/// asserts the expected drop count after running, so a regression that
/// skips a scope exit fails fast at runtime (non-zero process exit).

extern "C" {
    fn malloc(size: u64) -> rawptr;
    fn free(ptr: rawptr);
    fn memset(dst: rawptr, val: i32, n: u64) -> rawptr;
}

var g_drop_count: i32 = 0;

class Counter {
    public tag: i32

    public static fn create(tag: i32) -> Counter {
        let buf = malloc(16);
        memset(buf, 0, 16);
        return Counter { tag: tag };
    }

    public fn drop(self) {
        g_drop_count = g_drop_count + 1;
    }
}

fn scope_natural_exit() {
    let a = Counter.create(1);
    let b = Counter.create(2);
}

fn scope_return(flag: i32) -> i32 {
    let a = Counter.create(11);
    if (flag != 0) {
        let b = Counter.create(12);
        return 1;
    }
    return 0;
}

fn scope_break(n: i32) {
    var i: i32 = 0;
    while (i < n) {
        let a = Counter.create(21);
        if (i == 1) {
            let b = Counter.create(22);
            break;
        }
        i = i + 1;
    }
}

fn scope_continue(n: i32) {
    var i: i32 = 0;
    while (i < n) {
        let a = Counter.create(31);
        i = i + 1;
        if (i == 2) {
            let b = Counter.create(32);
            continue;
        }
    }
}

error SmokeErr {
    Boom,
}

fn scope_fail(flag: i32) -> i32 {
    let a = Counter.create(41);
    if (flag != 0) {
        let b = Counter.create(42);
        return fail SmokeErr.Boom;
    }
    return 0;
}

fn check(label: string, expected: i32) -> i32 {
    if (g_drop_count != expected) {
        print(label + ": expected " + expected.toString()
              + " drops, got " + g_drop_count.toString());
        return 1;
    }
    g_drop_count = 0;
    return 0;
}

fn main() -> i32 {
    var rc: i32 = 0;

    g_drop_count = 0;
    scope_natural_exit();
    rc = rc + check("natural_exit", 2);

    g_drop_count = 0;
    let _r1 = scope_return(1);
    rc = rc + check("return_true", 2);
    g_drop_count = 0;
    let _r0 = scope_return(0);
    rc = rc + check("return_false", 1);

    g_drop_count = 0;
    scope_break(5);
    // Iterations: i=0 (a only), i=1 (a+b then break)
    rc = rc + check("break", 3);

    g_drop_count = 0;
    scope_continue(3);
    // i=0,1,2 → each iter pushes a; on i=1 second iter (i becomes 2) push b then continue
    rc = rc + check("continue", 4);

    g_drop_count = 0;
    let _f1 = scope_fail(1);
    rc = rc + check("fail_true", 2);
    g_drop_count = 0;
    let _f0 = scope_fail(0);
    rc = rc + check("fail_false", 1);

    return rc;
}
