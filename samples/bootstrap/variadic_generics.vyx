module sample_variadic_generics;

fn sum_all<...Ts>(...args: Ts) -> i64 {
    return args...+;
}

fn product_all<...Ts>(...args: Ts) -> i64 {
    return args...*;
}

fn all_true<...Bs>(...flags: Bs) -> bool {
    return flags...&&;
}

fn main() -> i32 {
    let s = sum_all(1, 2, 3, 4);
    if (s != 10) { return 1; }

    let p = product_all(2, 3, 4);
    if (p != 24) { return 2; }

    if (!all_true(true, true, true)) { return 3; }
    return 0;
}
