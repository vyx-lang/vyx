module sample_float;

use std.io;

// Float literals (`.` / `e` / `E`) → vyx_rt_const_real → bitcast to i64
// for f64 slots (lower_type still maps f64→i64). Real fp arithmetic needs
// fadd/fmul lowering separately.
fn main() -> i32 {
    let x: f64 = 3.14;
    let y: f64 = 2.0;
    let big: f64 = 1e10;
    println("float lit OK");
    return 0;
}
