module sample.string_clone;

use std.collections;

fn main() -> i32 {
    let s: string = "alpha" + " beta";
    let c: string = s.clone();
    if (!c.equals(s)) { return 1; }
    let c_ptr: i64 = c.c_str() as i64;
    let s_ptr: i64 = s.c_str() as i64;
    if (c_ptr == s_ptr) { return 2; }

    let lit: string = "plain";
    let lit_clone: string = lit.clone();
    if (!lit_clone.equals("plain")) { return 3; }
    let lit_clone_ptr: i64 = lit_clone.c_str() as i64;
    let lit_ptr: i64 = lit.c_str() as i64;
    if (lit_clone_ptr == lit_ptr) { return 4; }

    let empty: string = "";
    let empty_clone: string = empty.clone();
    if (!empty_clone.isEmpty()) { return 5; }
    let empty_clone_ptr: i64 = empty_clone.c_str() as i64;
    let empty_ptr: i64 = empty.c_str() as i64;
    if (empty_clone_ptr == empty_ptr) { return 6; }
    return 0;
}
