module sample.string_replace;

use std.collections;

fn main() -> i32 {
    let s: string = "hello world hello";
    let r: string = s.replace("hello", "bye");
    if (!r.equals("bye world bye")) { return 1; }

    let s2: string = "aaa";
    let r2: string = s2.replace("a", "bb");
    if (!r2.equals("bbbbbb")) { return 2; }

    let s3: string = "no match here";
    let r3: string = s3.replace("xyz", "abc");
    if (!r3.equals("no match here")) { return 3; }

    let dyn: string = "red " + "red";
    if (!dyn.replace("red", "blue").equals("blue blue")) { return 4; }
    if (!dyn.replace("", "x").equals("red red")) { return 5; }
    return 0;
}
