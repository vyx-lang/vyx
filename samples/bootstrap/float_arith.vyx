module sample_float_arith;
use std.string;

use std.io;

fn main() -> i32 {
    let x: f64 = 1.5;
    let y: f64 = 2.5;
    let sum: f64 = x + y;
    let diff: f64 = y - x;
    let prod: f64 = x * y;
    let quot: f64 = y / x;
    println(sum.toString());
    println(diff.toString());
    println(prod.toString());
    println(quot.toString());

    return 0;
}
