module sample_generic_mono;

fn identity<T>(x: T) -> T {
    return x;
}

fn add<T>(a: T, b: T) -> T {
    return a + b;
}

fn main() -> i32 {
    let n: i32 = argCount();
    let x = identity::<i32>(n);
    let y = add::<i32>(x, 2);
    let n64: i64 = n as i64;
    let z = add::<i64>(n64, 3i64);
    return (y - (n + 2)) + ((z - (n64 + 3i64)) as i32);
}
