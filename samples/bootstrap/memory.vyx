module sample_memory;
use std.string;

use std.io;

fn take_ref(x: &i32) -> i32 {
    return ptr_read_i32(x);
}

fn take_mutref(x: &mut i32) -> i32 {
    return ptr_read_i32(x);
}

fn main() -> i32 {
    let x: i32 = 42;
    let r: &i32 = &x;
    let v1 = take_ref(r);
    println(v1.toString());

    let y: i32 = 100;
    let mr: &mut i32 = &y;
    let v2 = take_mutref(mr);
    println(v2.toString());

    // Box heap allocation
    let p = malloc(4 as u64);
    ptr_write_i32(p, 999);
    let loaded = ptr_read_i32(p);
    println(loaded.toString());
    free(p);

    return 0;
}
