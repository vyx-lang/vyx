module sample_coverage_smoke;

/// W5 coverage smoke probe.
///
/// Compiled with `--coverage`, the bootstrap codegen instruments every
/// function entry and every nested `emit_block` with an i64 counter
/// named `__vyx_cov_<fn>_<region>`. We expose three nested if/loop
/// regions inside `nest3` so the coverage dump reports at least 4
/// regions for that function (entry + 3 block bodies; for-loop bodies
/// also push a block scope, padding the count further).
///
/// Run via:
///   boot_a coverage_smoke.vyx --coverage -o coverage_smoke.exe
///   ./coverage_smoke.exe
///
/// Expected stdout at compile time:
///   [coverage] regions=N hits=__vyx_cov_main_0=0,__vyx_cov_nest3_0=0,...
/// where N>=4.

fn nest3(n: i32) -> i32 {
    var sum: i32 = 0;
    if (n > 0) {
        var i: i32 = 0;
        while (i < n) {
            if ((i & 1) == 0) {
                sum = sum + i;
            } else {
                sum = sum - i;
            }
            i = i + 1;
        }
    }
    return sum;
}

fn main() -> i32 {
    let r = nest3(4);
    // r = (0 - 1 + 2 - 3) = -2
    if (r != -2) {
        return 1;
    }
    return 0;
}
