module sample_cast_basic;

use std.io;

fn main() -> i32 {
    let a32: i32 = 7;
    let a64: i64 = a32 as i64;

    let b64: i64 = 999;
    let b32: i32 = b64 as i32;

    let flag: bool = true;
    let flag_i: i32 = flag as i32;

    let p = malloc(8 as u64);
    let pi: i64 = p as i64;
    let pp: rawptr = pi as rawptr;

    let bits: i64 = 1;
    let f: f64 = bits as f64;

    free(p);
    return 0;
}
