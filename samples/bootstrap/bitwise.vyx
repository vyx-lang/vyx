module sample_bitwise;
use std.string;

use std.io;

fn main() -> i32 {
    let a: i32 = 255;
    let b: i32 = 15;
    let c: i32 = a & b;
    let d: i32 = a | b;
    let e: i32 = a ^ b;
    print("a & b = ");
    println(c.toString());
    print("a | b = ");
    println(d.toString());
    print("a ^ b = ");
    println(e.toString());

    var x: i32 = 0xF0;
    x &= 0x33;
    println(x.toString());
    x |= 0x04;
    println(x.toString());
    x ^= 0x10;
    println(x.toString());
    x <<= 1;
    println(x.toString());
    x >>= 2;
    println(x.toString());

    return 0;
}
