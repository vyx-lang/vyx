module sample_closure;
use std.string;

use std.io;

fn apply(f: rawptr, x: i32) -> i32 {
    return f(x);
}

fn main() -> i32 {
    let add_one = |x: i32| -> i32 { return x + 1; };
    let double = |x: i32| -> i32 { return x * 2; };

    let r1 = add_one(10);
    println(r1.toString());

    let r2 = double(5);
    println(r2.toString());

    return 0;
}
