module sample_lang_items_smoke;
use std.string;

use bootstrap.lang_items;

extern "C" {
    fn malloc(size: u64) -> rawptr;
}

/// PLAN_SEMA_ROOT_FIX WU5 smoke probe.
///
/// Exercises `bootstrap.lang_items`: register a handful of fake
/// decl pointers under the curated slot names, look them up, verify
/// duplicate registrations are first-wins (silent), exercise the
/// `prelude_active` bit mask, and confirm `dispose` releases every
/// owned key buffer without tripping the cross-CRT free hazard.
///
/// The "decl pointers" handed to `lang_items_register` are
/// freshly-`malloc`'d sentinel addresses — we never deref them, the
/// registry stores them opaquely. Output contract:
/// prints `[lang-items-smoke] all-pass` on success and exits 0;
/// on first failure prints `[lang-items-smoke] FAIL: <label>`
/// and exits 1.

fn smoke_fail(label: string) -> i32 {
    print("[lang-items-smoke] FAIL: " + label);
    return 1;
}

fn main() -> i32 {
    let reg = lang_items_alloc();
    if (reg == null) {
        return smoke_fail("alloc returned null");
    }
    if (lang_items_slot_count(reg) != 0) {
        lang_items_dispose(reg);
        return smoke_fail("initial slot count must be 0");
    }

    let opt_decl    = malloc(8);
    let res_decl    = malloc(8);
    let string_decl = malloc(8);
    let vec_decl    = malloc(8);

    if (!lang_items_register(reg, "option", opt_decl)) {
        lang_items_dispose(reg);
        return smoke_fail("register option");
    }
    if (!lang_items_register(reg, "result", res_decl)) {
        lang_items_dispose(reg);
        return smoke_fail("register result");
    }
    if (!lang_items_register(reg, "string", string_decl)) {
        lang_items_dispose(reg);
        return smoke_fail("register string");
    }
    if (!lang_items_register(reg, "vec", vec_decl)) {
        lang_items_dispose(reg);
        return smoke_fail("register vec");
    }
    if (lang_items_slot_count(reg) != 4) {
        lang_items_dispose(reg);
        return smoke_fail("slot count after 4 registers");
    }

    if (lang_items_find(reg, "option") != opt_decl) {
        lang_items_dispose(reg);
        return smoke_fail("find option");
    }
    if (lang_items_find(reg, "result") != res_decl) {
        lang_items_dispose(reg);
        return smoke_fail("find result");
    }
    if (lang_items_find(reg, "string") != string_decl) {
        lang_items_dispose(reg);
        return smoke_fail("find string");
    }
    if (lang_items_find(reg, "vec") != vec_decl) {
        lang_items_dispose(reg);
        return smoke_fail("find vec");
    }
    if (lang_items_find(reg, "missing") != null) {
        lang_items_dispose(reg);
        return smoke_fail("find missing slot must return null");
    }

    // First-wins: duplicate register returns false, find still
    // resolves to the original decl pointer.
    let opt_decl_dup = malloc(8);
    if (lang_items_register(reg, "option", opt_decl_dup)) {
        lang_items_dispose(reg);
        return smoke_fail("duplicate register must return false");
    }
    if (lang_items_find(reg, "option") != opt_decl) {
        lang_items_dispose(reg);
        return smoke_fail("first-wins: option must still resolve to original");
    }
    if (lang_items_slot_count(reg) != 4) {
        lang_items_dispose(reg);
        return smoke_fail("slot count must not change on duplicate");
    }

    // Prelude-active bitmask: each bit independently settable, idempotent.
    if (lang_items_prelude_mask(reg) != 0) {
        lang_items_dispose(reg);
        return smoke_fail("initial prelude mask must be 0");
    }
    lang_items_prelude_set(reg, lang_items_prelude_bit_std_core());
    if (!lang_items_prelude_has(reg, lang_items_prelude_bit_std_core())) {
        lang_items_dispose(reg);
        return smoke_fail("prelude std_core bit after set");
    }
    if (lang_items_prelude_has(reg, lang_items_prelude_bit_std_io())) {
        lang_items_dispose(reg);
        return smoke_fail("prelude std_io must NOT be set");
    }
    lang_items_prelude_set(reg, lang_items_prelude_bit_std_io());
    lang_items_prelude_set(reg, lang_items_prelude_bit_std_io());
    let expect_mask = lang_items_prelude_bit_std_core()
                    | lang_items_prelude_bit_std_io();
    if (lang_items_prelude_mask(reg) != expect_mask) {
        lang_items_dispose(reg);
        return smoke_fail("prelude mask after core+io|io");
    }

    // Clear blanks everything but leaves the registry usable.
    lang_items_clear(reg);
    if (lang_items_slot_count(reg) != 0) {
        lang_items_dispose(reg);
        return smoke_fail("slot count after clear");
    }
    if (lang_items_prelude_mask(reg) != 0) {
        lang_items_dispose(reg);
        return smoke_fail("prelude mask after clear");
    }
    let post = malloc(8);
    if (!lang_items_register(reg, "scope", post)) {
        lang_items_dispose(reg);
        return smoke_fail("register after clear");
    }
    if (lang_items_find(reg, "scope") != post) {
        lang_items_dispose(reg);
        return smoke_fail("find after clear+register");
    }

    lang_items_dispose(reg);
    print("[lang-items-smoke] all-pass");
    return 0;
}
