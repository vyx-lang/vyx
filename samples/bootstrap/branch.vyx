module sample.branch;
fn main() -> i32 {
    let x: i32 = 7;
    let y: i32 = 5;
    if (x > y && y > 0) {
        if (x == 7) { print("branch ok"); return 0; }
        elif (x == 8) { print("branch fail"); return 1; }
        else { print("branch fail"); return 1; }
    } elif (x < y) { print("branch fail"); return 1; }
    else { print("branch fail"); return 1; }
    return 1;
}
