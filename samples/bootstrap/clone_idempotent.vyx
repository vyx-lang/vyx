module sample_clone_idempotent;

/// AST deep-clone idempotency probe (WU6-Fix-Sample).
///
/// Exercises the bootstrap monomorphisation path that the new
/// sema_env_* / sema_clone_*_env helpers serve: a single generic
/// class is instantiated twice with the same concrete argument and
/// the two instantiations must produce identical observable
/// behaviour. If the deep-clone path (or any future TypeEnv-aware
/// substitution) leaks state between instantiations, the field-load
/// values diverge and main returns a non-zero exit code.
///
/// Avoids the integer-literal width suffix (e.g. `41i64`) because the
/// bootstrap lexer presently does not absorb `consume_int_suffix`
/// after `scan_number_rest`, so `41i64` inside a struct-init field is
/// tokenised as `INT(41) IDENT(i64)` and the struct-init parser then
/// reports `expect field name in struct init got 'i64'`. Each i64
/// value is materialised through an explicit `as i64` cast or an
/// annotated `let` before it reaches the struct literal.
///
/// `ast_hash_*` (the FNV-1a deterministic AST fingerprint added in
/// sema.vyx) cannot be invoked from a sample because `bootstrap.sema`
/// is the compiler module, not a runtime library; it stays exposed as
/// a public sema-side API for future drivers and regressions. The
/// runtime equality + the strict A/B/C self-host fixpoint together
/// cover clone determinism end-to-end.

class CloneBox<T> {
    public value: T;

    public fn get(self) -> T {
        return self.value;
    }
}

fn main() -> i32 {
    let n: i32 = argCount();

    let a = CloneBox::<i32> { value: n + 7 };
    let b = CloneBox::<i32> { value: n + 7 };
    if (a.get() != b.get()) { return 1; }
    if (a.get() != n + 7) { return 2; }

    let n64:  i64 = n as i64;
    let bias: i64 = 41 as i64;
    let v_i64: i64 = n64 + bias;

    let c = CloneBox::<i64> { value: v_i64 };
    let d = CloneBox::<i64> { value: v_i64 };
    if (c.get() != d.get()) { return 3; }
    if (c.get() != v_i64) { return 4; }

    print("[clone-idempotent] all-pass");
    return 0;
}
