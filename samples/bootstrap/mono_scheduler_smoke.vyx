module sample_mono_scheduler_smoke;

/// PLAN_SEMA_ROOT_FIX WU8 smoke probe.
///
/// Exercises each `record_*` path the bootstrap MonoScheduler ledger
/// observes in `sema.resolve_unit` so `host_analyze_dump_mono_scheduler_stats`
/// prints a `[S4 mono-sched]` line with `classes`, `free_fns`, `methods`
/// all > 0.
///
/// Suffix-free integer literals only — the boot_a lexer's `scan_number_rest`
/// does not invoke `consume_int_suffix`, so any `21i32` / `100i64` would
/// split into two tokens and trip the parser. Use type annotations or
/// `as i32` / `as i64` casts when a specific width matters; otherwise
/// every untyped int defaults to `i64` per `infer_int_suffix` fallback.

class Holder {
    public seed: i32

    /// Generic instance method — turbofish callsite at `h.pass::<i32>(…)`
    /// pumps the `methods` counter via `resolve_member`.
    public fn pass<U>(self, x: U) -> U {
        return x;
    }
}

/// Generic free function — turbofish callsite at `wrap::<i32>(…)`
/// pumps the `free_fns` counter via `resolve_call`.
fn wrap<T>(x: T) -> T {
    return x;
}

fn main() -> i32 {
    let h = Holder { seed: 0 };
    let n: i32 = h.pass::<i32>(5);
    let m: i32 = wrap::<i32>(n);
    // `Some::<i32>` is handled in `resolve_call`'s `cargs.len > 0` branch:
    // it short-circuits to `tref_create_class("Option::<i32>")` and pumps
    // the `classes` counter via `record_class_request_named`.
    let _opt = Some::<i32>(m);
    return m - 5;
}
