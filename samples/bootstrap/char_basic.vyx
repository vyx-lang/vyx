module sample_char_basic;

use std.io;

fn main() -> i32 {
    let c1: i32 = 'A';
    let c2: i32 = 'z';
    if (c1 == 65) { println("char A ok"); }
    else { println("char A fail"); return 1; }
    if (c2 == 122) { println("char z ok"); }
    else { println("char z fail"); return 1; }
    return 0;
}
