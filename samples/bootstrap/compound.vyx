module sample_compound;
use std.string;

use std.io;

class Counter {
    public value: i32;
    public flags: i32;
}

fn main() -> i32 {
    var x: i32 = 10 as i32;
    x += 5;
    println(x.toString());
    x -= 3;
    println(x.toString());
    x *= 4;
    println(x.toString());
    x /= 2;
    println(x.toString());
    x %= 7;
    println(x.toString());

    var arr: [i32; 4] = [1 as i32, 2 as i32, 3 as i32, 4 as i32];
    arr[0] += 100 as i32;
    arr[1] -= 1 as i32;
    arr[2] *= 5 as i32;
    arr[3] /= 2 as i32;
    println(arr[0].toString());
    println(arr[1].toString());
    println(arr[2].toString());
    println(arr[3].toString());

    var bits: [i32; 3] = [0xFF as i32, 0x0F as i32, 0x03 as i32];
    bits[0] &= 0x33 as i32;
    bits[1] |= 0x40 as i32;
    bits[2] ^= 0x01 as i32;
    println(bits[0].toString());
    println(bits[1].toString());
    println(bits[2].toString());

    var c: Counter = Counter { value: 50 as i32, flags: 0xFF as i32 };
    c.value += 7 as i32;
    c.value *= 2 as i32;
    c.flags &= 0x0F as i32;
    c.flags |= 0x80 as i32;
    c.flags <<= 1 as i32;
    println(c.value.toString());
    println(c.flags.toString());

    return 0 as i32;
}
