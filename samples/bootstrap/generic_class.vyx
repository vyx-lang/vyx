module sample_generic_class;

class Pair<T> {
    public value: T;
}

fn main() -> i32 {
    let n: i32 = argCount();
    let p = Pair::<i32> { value: n };
    let v = p.value;
    let n64: i64 = n as i64;
    let q = Pair::<i64> { value: n64 + 5i64 };
    let w = q.value;
    return (v - n) + ((w - (n64 + 5i64)) as i32);
}
