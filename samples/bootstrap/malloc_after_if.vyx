module bootstrap;

extern "C" {
    fn malloc(size: u64) -> rawptr;
}

class Foo {
    public counter: i32;
    public static fn create() -> Foo {
        return Foo { counter: 0 };
    }
    public fn run(self) {
        self.counter = self.counter + 1;
    }
}

fn check(unit: rawptr) -> rawptr {
    let cg = Foo.create();
    if (unit != null) {
        cg.run();
    }
    if (cg.counter > 0) {
        return null;
    }
    let handle = malloc(8);
    if (handle == null) { return null; }
    return handle;
}

fn main() -> i32 {
    let p: rawptr = null;
    let r = check(p);
    if (r == null) { return 1; }
    return 0;
}
