module sample_generic_enum_payload;

enum Maybe<T> {
    Some(T),
    None
}

fn main() -> i32 {
    let n: i32 = argCount();
    let a: Maybe<i32> = Some::<i32>(n + 41);
    let b: Maybe<i32> = None::<i32>();

    var first: i32 = 100;
    match (a) {
        case Some(v) => { first = v - (n + 41); }
        default => { first = 1; }
    }
    if (first != 0) { return 1; }

    var second: i32 = 100;
    match (b) {
        case Some(v2) => { second = v2; }
        case None => { second = 0; }
        default => { second = 2; }
    }
    if (second != 0) { return 2; }

    return 0;
}
