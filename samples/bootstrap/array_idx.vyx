module sample_array_idx;

fn main() -> i32 {
    let arr: [i64; 5] = [10, 20, 30, 40, 50];
    let x: i64 = arr[0];
    let y: i64 = arr[2];
    let z: i64 = arr[4];
    // x should be 10, y should be 30, z should be 50
    // Use arithmetic to verify without needing int_to_string
    let check: i64 = x + y + z;  // 10 + 30 + 50 = 90
    return 0;
}
