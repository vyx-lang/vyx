module sample.cls;

class Point {
    public x: i32
    public y: i32
    public static fn make(a: i32, b: i32) -> Point {
        return Point { x: a, y: b };
    }
    public fn sum_xy(self) -> i32 {
        return self.x + self.y;
    }
}

fn main() -> i32 {
    let p = Point.make(3, 7);
    let s = p.sum_xy();
    if (s == 10) { print("class ok"); return 0; }
    return 1;
}
