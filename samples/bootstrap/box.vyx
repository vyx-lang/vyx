module sample_box;

class ValueBox {
    public value: i32

    public static fn make(v: i32) -> ValueBox {
        return ValueBox { value: v };
    }
}

fn main() -> i32 {
    {
        let p = ValueBox.make(42);
        let p2 = ValueBox.make(999);
        if (p.value != 42 || p2.value != 999) { return 1; }

        var p3 = ValueBox.make(7);
        if (p3.value != 7) { return 2; }
        p3 = ValueBox.make(8);
        if (p3.value != 8) { return 3; }
    }

    var i = 0;
    var seen = 0;
    while (i < 4) {
        let loop_box = ValueBox.make(i + 10);
        i = i + 1;
        if (loop_box.value == 10) {
            seen = seen + 1;
            continue;
        }
        if (loop_box.value == 11) {
            seen = seen + 10;
            break;
        }
        seen = seen + 100;
    }
    if (seen != 11) { return 4; }
    return 0;
}
