module sample_generic_structural_types;

fn inc32(x: i32) -> i32 {
    return x + 1;
}

fn inc64(x: i64) -> i64 {
    return x + 1i64;
}

fn apply_twice<T>(f: fn(T) -> T, x: T) -> T {
    return f(f(x));
}

fn make_pair<T>(a: T, b: T) -> (T, T) {
    return (a, b);
}

fn second<T>(p: (T, T)) -> T {
    return p.1;
}

class FnBox<T> {
    public f: fn(T) -> T;
    public seed: T;

    public fn run(self) -> T {
        return self.f(self.seed);
    }
}

fn main() -> i32 {
    let n: i32 = argCount();
    let twice32: i32 = apply_twice::<i32>(inc32, n);
    if (twice32 != n + 2) { return 1; }

    let n64: i64 = n as i64;
    let twice64: i64 = apply_twice::<i64>(inc64, n64);
    if (twice64 != n64 + 2i64) { return 2; }

    let p = make_pair::<i32>(n, n + 5);
    let got: i32 = second::<i32>(p);
    if (got != n + 5) { return 3; }

    let boxed = FnBox::<i32> { f: inc32, seed: n + 9 };
    if (boxed.run() != n + 10) { return 4; }
    return 0;
}
