module sample_struct_tostring;

use std.collections;
use std.string;

struct Point {
    x: i32;
    y: i32;
}

struct Person {
    name: string;
    age: i32;
    active: bool;
}

impl Point {
    public fn toString(self) -> string {
        return "Point{x: " + self.x.toString()
            + ", y: " + self.y.toString()
            + "}";
    }
}

impl Person {
    public fn toString(self) -> string {
        var active_text: string = "0";
        if (self.active) { active_text = "1"; }
        return "Person{name: " + self.name
            + ", age: " + self.age.toString()
            + ", active: " + active_text
            + "}";
    }
}

fn main() -> i32 {
    let p = Point { x: 10, y: 20 };
    let ps: string = p.toString();
    if (ps != "Point{x: 10, y: 20}") { return 1; }

    let q = Person { name: "Ada", age: 37, active: true };
    let qs: string = q.toString();
    if (qs != "Person{name: Ada, age: 37, active: 1}") { return 2; }
    return 0;
}
