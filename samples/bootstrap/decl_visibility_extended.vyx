module sample_decl_visibility_extended;

public type Count = i32;
public newtype CountBox = i32;

public concept HasValue<T> {
    fn value(self) -> Count;
}

public class VisibleBox {
    public inner: Count;

    public fn value(self) -> Count {
        return self.inner;
    }
}

fn read_value<T>(x: T) -> Count where T: HasValue {
    return x.value();
}

fn main() -> i32 {
    let n: Count = argCount() + 19;
    let wrapped: CountBox = n;
    let box = VisibleBox { inner: n };
    return (read_value::<VisibleBox>(box) - n) + (wrapped - n);
}
