fn pack(a: i8, b: i16, c: u32, d: u64) -> i64 {
    let aa: i8 = a;
    let bb: i16 = b;
    let cc: u32 = c;
    let dd: u64 = d;
    return (aa as i64) + (bb as i64) + (cc as i64) + (dd as i64);
}

fn main() -> i32 {
    let a: i8 = 1;
    let b: i16 = 2;
    let c: u32 = 3;
    let d: u64 = 4;
    let total: i64 = pack(a, b, c, d);
    print("int widths ok");
    return (total as i32) - 10;
}
