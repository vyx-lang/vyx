fn classify(x: i32) -> i32 {
    match (x) {
        case 1 if x < 0 => { return 10; }
        case 1 => { return 11; }
        default => { return 99; }
    }
}

fn main() -> i32 {
    if (classify(1) != 11) {
        return 1;
    }
    if (classify(0) != 99) {
        return 2;
    }
    return 0;
}
