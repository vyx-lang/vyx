module sample_impl_method;

class ImplBox {
    public value: i32;
}

impl ImplBox {
    public fn get(self) -> i32 {
        return self.value;
    }
}

fn main() -> i32 {
    let n: i32 = argCount();
    let box = ImplBox { value: n + 37 };
    let got: i32 = box.get();
    return got - (n + 37);
}
