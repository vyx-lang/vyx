module sample_generic_full_specialization;

fn marker<T>(x: T) -> i32 {
    return 0;
}

fn marker<i32>(x: i32) -> i32 {
    return x + 19;
}

fn marker<i64>(x: i64) -> i32 {
    return (x - 7i64) as i32;
}

fn main() -> i32 {
    let n: i32 = argCount();
    let got32 = marker::<i32>(n + 23);
    if (got32 != n + 42) { return 1; }

    let got64 = marker::<i64>((n as i64) + 50i64);
    if (got64 != n + 43) { return 2; }

    return 0;
}
