module sample.string_find;

use std.string;

fn main() -> i32 {
    let s: string = "alpha beta";
    let dyn: string = "ha " + "be";

    if (s.find("alpha") != 0) { return 1; }
    if (s.indexOf("beta") != 6) { return 2; }
    if (s.find("omega") != -1) { return 3; }
    if (s.indexOf(dyn) != 3) { return 4; }
    return 0;
}
