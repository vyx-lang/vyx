module sample.string_predicates;

use std.collections;

fn main() -> i32 {
    let s: string = "alpha beta";
    let dyn: string = "alpha " + "beta";
    let empty: string = "";

    if (!s.contains("pha")) { return 1; }
    if (s.contains("omega")) { return 2; }
    if (!s.startsWith("alpha")) { return 3; }
    if (s.startsWith("beta")) { return 4; }
    if (!s.endsWith("beta")) { return 5; }
    if (s.endsWith("alpha")) { return 6; }
    if (!s.equals("alpha beta")) { return 7; }
    if (s.equals("alpha")) { return 8; }
    if (!empty.isEmpty()) { return 9; }
    if (s.isEmpty()) { return 10; }
    if (!s.equals(dyn)) { return 11; }
    if (!dyn.contains("ha b")) { return 12; }
    if (!empty.is_empty()) { return 13; }
    return 0;
}
