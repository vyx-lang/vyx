error TryFailError {
    Bad,
    Worse,
}

fn might_fail(x: i32) -> i32 {
    if (x < 0) {
        return fail TryFailError.Bad;
    }
    return x;
}

fn prefix_try(x: i32) -> i32 {
    let v = try might_fail(x);
    return v + 1;
}

fn postfix_try(x: i32) -> i32 {
    let v = might_fail(x)?;
    return v + 2;
}

fn await_passthrough(x: i32) -> i32 {
    let y = await x;
    return y;
}

fn fail_code() -> i32 {
    return fail TryFailError.Worse;
}

fn main() -> i32 {
    if (prefix_try(3) != 4) { return 1; }
    if (postfix_try(2) != 4) { return 2; }
    if (prefix_try(-1) != -100) { return 3; }
    if (postfix_try(-1) != -100) { return 4; }
    if (await_passthrough(7) != 7) { return 5; }
    if (fail_code() != -101) { return 6; }
    return 0;
}
