module sample_compound_bit;
use std.string;

use std.io;

fn main() -> i32 {
    let a: i32 = 0xFF;
    a &= 0x0F;
    println(a.toString());
    a |= 0x30;
    println(a.toString());
    a ^= 0x0A;
    println(a.toString());
    a <<= 2;
    println(a.toString());
    a >>= 1;
    println(a.toString());

    return 0;
}
