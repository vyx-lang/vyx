module sample_generic_where;

interface HasId {
    fn id(self) -> i32;
}

class StructuralBox {
    public value: i32;

    public fn id(self) -> i32 {
        return self.value;
    }
}

fn read_id<T>(x: T) -> i32 where T: HasId {
    return x.id();
}

fn main() -> i32 {
    let n: i32 = argCount();
    let box = StructuralBox { value: n + 7 };
    return read_id::<StructuralBox>(box) - (n + 7);
}
