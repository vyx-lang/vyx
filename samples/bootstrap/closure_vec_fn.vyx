use std.collections;

fn step_inc(x: i64) -> i64 { return x + 1; }
fn step_dbl(x: i64) -> i64 { return x * 2; }
fn step_sub(x: i64) -> i64 { return x - 3; }

fn main() -> i32 {
    var fns = Vec::<fn(i64) -> i64>.new();
    fns.push(step_inc);
    fns.push(step_dbl);
    fns.push(step_sub);
    let f0 = fns.get(0);
    let f1 = fns.get(1);
    let f2 = fns.get(2);
    let total = f0(10) + f1(10) + f2(10);
    if (total != 38i64) { return 1; }
    return 0;
}
