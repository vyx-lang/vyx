module sample_closure_capture_explicit;

fn make_adder(x: i64) -> fn(i64) -> i64 {
    return |a: i64| -> i64 { return a + x; };
}

fn main() -> i32 {
    let add7 = make_adder(7);
    let add100 = make_adder(100);
    if (add7(0) != (7 as i64)) { return 1; }
    if (add7(5) != (12 as i64)) { return 2; }
    if (add100(5) != (105 as i64)) { return 3; }
    return 0;
}
