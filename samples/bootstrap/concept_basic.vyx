module sample_concept_basic;

concept HasId<T> {
    fn id(self) -> i32;
}

class ConceptBox {
    public value: i32;

    public fn id(self) -> i32 {
        return self.value;
    }
}

fn read_concept<T>(x: T) -> i32 where T: HasId {
    return x.id();
}

fn main() -> i32 {
    let n: i32 = argCount();
    let box = ConceptBox { value: n + 11 };
    return read_concept::<ConceptBox>(box) - (n + 11);
}
