module sample.vulkan_slice_struct;

extern "C" {
    fn vkDestroyBuffer(device: rawptr, buffer: rawptr, allocator: rawptr);
    fn vkFreeMemory(device: rawptr, memory: rawptr, allocator: rawptr);
}

var g_vk_device: rawptr = null;

struct VkBuffer {
    handle: i64;
    memory: i64;
    size: u64;
}

fn vk_buffer_destroy(buf: VkBuffer) {
    if (buf.handle != 0) {
        vkDestroyBuffer(g_vk_device, buf.handle as rawptr, null);
    }
    if (buf.memory != 0) {
        vkFreeMemory(g_vk_device, buf.memory as rawptr, null);
    }
}

fn main() -> i32 {
    let b = VkBuffer { handle: 0, memory: 0, size: 0 };
    vk_buffer_destroy(b);
    return 0;
}
