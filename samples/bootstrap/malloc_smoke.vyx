module sample_malloc_smoke;

extern "C" {
    fn malloc(n: u64) -> rawptr;
    fn free(p: rawptr);
}

fn alloc_block() -> rawptr {
    let handle = malloc(8);
    if (handle == null) { return null; }
    return handle;
}

fn main() -> i32 {
    let p = alloc_block();
    if (p != null) { free(p); }
    return 0;
}
