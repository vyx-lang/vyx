module sample.name_mangling;

class foo_bar {
    public tag: i32
}

class foo {
    public tag: i32
}

class bar {
    public tag: i32
}

fn collide<T>(x: T) -> i32 {
    return 11;
}

fn collide<U, V>(x: U, y: V) -> i32 {
    return 22;
}

fn collide<foo_bar>(x: foo_bar) -> i32 {
    return x.tag + 110;
}

fn collide<foo, bar>(x: foo, y: bar) -> i32 {
    return x.tag + y.tag + 200;
}

fn main() -> i32 {
    let a = foo_bar { tag: 1 };
    let b = foo { tag: 2 };
    let c = bar { tag: 3 };

    let one = collide::<foo_bar>(a);
    if (one != 111) { return 1; }

    let two = collide::<foo, bar>(b, c);
    if (two != 205) { return 2; }

    return 0;
}
