module sample_generic_class_method;

class Holder<T> {
    public value: T;

    public fn get(self) -> T {
        return self.value;
    }
}

fn main() -> i32 {
    let n: i32 = argCount();
    let h = Holder::<i32> { value: n + 7 };
    let got: i32 = h.get();
    let n64: i64 = n as i64;
    let wide = Holder::<i64> { value: n64 + 13i64 };
    let got64: i64 = wide.get();
    return (got - (n + 7)) + ((got64 - (n64 + 13i64)) as i32);
}
