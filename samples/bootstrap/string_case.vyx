module sample.string_case;

use std.collections;
use std.string;

fn main() -> i32 {
    let mixed: string = "Abc xyZ 123!";
    let upper: string = mixed.toUpper();
    let lower: string = mixed.toLower();
    if (!upper.equals("ABC XYZ 123!")) { return 1; }
    if (!lower.equals("abc xyz 123!")) { return 2; }
    if (!mixed.equals("Abc xyZ 123!")) { return 3; }

    let dyn: string = "Ab" + "C";
    if (!dyn.toLower().equals("abc")) { return 4; }
    if (!dyn.toUpper().equals("ABC")) { return 5; }
    if (!"".toUpper().isEmpty()) { return 6; }
    if (!"".toLower().isEmpty()) { return 7; }
    return 0;
}
