fn main() -> i32 {
    let i: i32 = 5;
    for (var i: i32 = 0; i < 2; i = i + 1) {
        if (i < 0) {
            return 10;
        }
    }
    if (i != 5) {
        return 20;
    }

    for (i in 0..2) {
        if (i < 0) {
            return 30;
        }
    }
    if (i != 5) {
        return 40;
    }
    return 0;
}
