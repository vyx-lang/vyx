use App = Zyn.App.App;
use AppTimeline = Zyn.App.AppTimeline;
use AppRuntime = Zyn.App.AppRuntime;
use AppWorld = Zyn.App.AppWorld;
use Button = Zyn.App.Button;
use ChoiceGroup = Zyn.App.ChoiceGroup;
use Column = Zyn.App.Column;
use DataGrid = Zyn.App.DataGrid;
use Disclosure = Zyn.App.Disclosure;
use EmptyState = Zyn.App.EmptyState;
use FormField = Zyn.App.FormField;
use SearchBar = Zyn.App.SearchBar;
use StatelessComponent = Zyn.App.StatelessComponent;
use Text = Zyn.App.Text;
use UiTheme = Zyn.UI.UiTheme;
use View = Zyn.App.View;
use Md3Surface = Zyn.App.MD3.Md3Surface;
use Panel = Zyn.App.Panel;
use std.collections;

class SmokeComponent : StatelessComponent {
    public static fn create() -> SmokeComponent { return SmokeComponent { component_id: "smoke" }; }

    public fn configure(world: AppWorld) -> AppWorld {
        return world.setIntResource("smoke.count", 0)
            .setBoolResource("smoke.expanded", false)
            .setStringResource("smoke.query", "")
            .setStringResource("smoke.error", "")
            .registerIntDeltaCommand("smoke.bump", "smoke.count", 1)
            .registerBoolToggleCommand("smoke.toggle", "smoke.expanded")
            .registerStringSetCommand("smoke.query.set", "smoke.query")
            .registerStringSetCommand("smoke.clear", "smoke.query");
    }

    public fn view(world: AppWorld) -> View {
        var labels = Vec::<string>.new();
        labels.push("One"); labels.push("Two");
        var actions = Vec::<string>.new();
        actions.push("smoke.bump"); actions.push("smoke.toggle");
        var headers = Vec::<string>.new();
        headers.push("Name"); headers.push("Value");
        var cells = Vec::<string>.new();
        cells.push("Counter"); cells.push(format("%d", world.intResource("smoke.count", 0) as i64));
        let content = Column.create().id("smoke.content")
            .child(FormField.text("smoke.field", "Query", "Search", "smoke.query", "smoke.query.set", "smoke.error"))
            .child(SearchBar.create("smoke.search", "Filter", "smoke.query", "smoke.query.set", "smoke.clear"))
            .child(Disclosure.create("smoke.details", "Details", "smoke.expanded", "smoke.toggle", world,
                Text.body("Expanded content").id("smoke.expanded.content")))
            .child(EmptyState.create("smoke.empty", "No results", "Add a first item", "Add", "smoke.bump"))
            .child(ChoiceGroup.create("smoke.choices", labels, actions, 0))
            .child(DataGrid.create("smoke.grid", headers, cells))
            .child(Button.filledAction("smoke.bump.button", "Increment", "smoke.bump"));
        return content;
    }
}

fn selfTest() -> i32 {
    let component = SmokeComponent.create();
    var world = component.configure(AppWorld.create());
    var root = component.view(world);
    var initial = AppRuntime.create(root, world, UiTheme.md3(), 800.0, 600.0);
    var recorded = initial.dup().startRecording();
    recorded = recorded.dispatchViewAction("smoke.bump.button").applyAllCommands();
    var timeline = recorded.recordedTimeline();
    if (timeline.count() != 1) { return 1; }
    match (timeline.exportTo("target/smoke.zyns")) {
        case Ok(_) => {}
        case Err(_) => { return 2; }
    }
    match (AppTimeline.load("target/smoke.zyns")) {
        case Ok(loaded) => {
            match (initial.replyTimeline(loaded, 2)) {
                case Ok(count) => { if (count != 2) { return 3; } }
                case Err(_) => { return 4; }
            }
        }
        case Err(_) => { return 5; }
    }
    world = world.dispatchNamed("smoke.toggle").applyAllCommands();
    var expanded = component.view(world);
    var disclosure = expanded.childAt(2);
    if (disclosure.childCount() != 2) { return 6; }
    disclosure.destroy();
    expanded.destroy();

    // Cards use the renderer-backed elevation path.  This keeps the modern
    // surface style a real composable property instead of a documentation-only
    // convention.
    var card = Md3Surface.card("modern.card")
        .child(Text.body("Elevated content").id("modern.card.body"));
    var card_tree = card.toUiTree(800.0, 600.0, UiTheme.md3());
    let card_index = card_tree.find("modern.card");
    if (card_index < 0 || card_tree.nodeAt(card_index).elevation <= 0.0) { return 11; }
    card_tree.destroy();
    card.destroy();

    // Panel padding is applied by its container exactly once.  A child that
    // starts at x=12 demonstrates that the retained tree stays composable
    // when a surface is nested inside another layout.
    var padded = Panel.create().id("padding.panel").padding(12.0)
        .child(Text.body("Padded").id("padding.panel.body"));
    var padded_tree = padded.toUiTree(320.0, 160.0, UiTheme.md3());
    let padded_child_index = padded_tree.find("padding.panel.body");
    if (padded_child_index < 0 || padded_tree.nodeAt(padded_child_index).bounds.x != 12.0) { return 12; }
    padded_tree.destroy();
    padded.destroy();

    // Composite controls measure their children when no height is supplied.
    // The following form must leave room for its label, input and validation
    // line before the sibling button is placed.
    var measure_world = AppWorld.create();
    var measured = Column.create().id("measure.host")
        .child(FormField.text("measure.form", "Query", "Search", "measure.query", "measure.query.set", "measure.error"))
        .child(Button.filled("After").id("measure.after").height(40.0));
    var measured_tree = measured.toUiTreeWithWorld(400.0, 300.0, UiTheme.md3(), measure_world);
    let form_index = measured_tree.find("measure.form.label");
    let after_index = measured_tree.find("measure.after");
    if (form_index < 0 || after_index < 0
        || measured_tree.nodeAt(after_index).bounds.y < measured_tree.nodeAt(form_index).bounds.y + 100.0) { return 13; }
    measured_tree.destroy();
    measured.destroy();
    measure_world.destroy();

    // Explicit height and fillHeight remain opt-in compatibility controls.
    var fixed_view = Panel.create().id("fixed.panel").height(64.0)
        .child(Text.body("Fixed").id("fixed.body"));
    var fixed_host = Column.create().child(fixed_view);
    var fixed_tree = fixed_host.toUiTree(320.0, 180.0, UiTheme.md3());
    let fixed_index = fixed_tree.find("fixed.panel");
    if (fixed_index < 0 || fixed_tree.nodeAt(fixed_index).bounds.height < 63.9
        || fixed_tree.nodeAt(fixed_index).bounds.height > 64.1
        || fixed_view.fill_height_value) { return 16; }
    fixed_tree.destroy();
    fixed_host.destroy();
    fixed_view.destroy();
    var fill_view = Panel.create().id("fill.panel").fillHeight()
        .child(Text.body("Fill").id("fill.body"));
    var fill_host = Column.create().id("fill.host").child(fill_view);
    var fill_tree = fill_host.toUiTree(320.0, 180.0, UiTheme.md3());
    let fill_index = fill_tree.find("fill.panel");
    if (fill_index < 0 || fill_tree.nodeAt(fill_index).bounds.height < 179.9
        || fill_tree.nodeAt(fill_index).bounds.height > 180.1
        || !fill_view.fill_height_value || fill_view.auto_height_value) { return 17; }
    fill_tree.destroy();
    fill_host.destroy();
    fill_view.destroy();

    // List actions, accessibility and retained nodes all use the same stable
    // business key instead of falling back to the row index.
    var list_labels = Vec::<string>.new();
    list_labels.push("Alpha"); list_labels.push("Beta");
    var list_keys = Vec::<string>.new();
    list_keys.push("row-a"); list_keys.push("row-b");
    var list_world = AppWorld.create()
        .setStringListResource("rows", list_labels)
        .setStringListResource("rows.keys", list_keys);
    var keyed = View.list("rows")
        .id("rows")
        .keyResource("rows.keys")
        .itemActionPrefix("rows.toggle.");
    var keyed_tree = keyed.toUiTreeWithWorld(320.0, 180.0, UiTheme.md3(), list_world);
    let keyed_index = keyed_tree.find("rows.row-b");
    if (keyed_index < 0 || keyed_tree.find("rows.1") >= 0) { return 14; }
    let bound_list_world = keyed.bindActions(list_world);
    if (bound_list_world.actionNameForViewId("rows.row-b") != "rows.toggle.row-b") { return 15; }
    keyed_tree.destroy();

    // Insertion and reordering keep the business key in the retained tree and
    // in the action table; no index-derived node is introduced.
    var reordered_labels = Vec::<string>.new();
    reordered_labels.push("Beta"); reordered_labels.push("Alpha"); reordered_labels.push("Gamma");
    var reordered_keys = Vec::<string>.new();
    reordered_keys.push("row-b"); reordered_keys.push("row-a"); reordered_keys.push("row-c");
    list_world = list_world
        .setStringListResource("rows", reordered_labels)
        .setStringListResource("rows.keys", reordered_keys);
    var reordered_tree = keyed.toUiTreeWithWorld(320.0, 180.0, UiTheme.md3(), list_world);
    if (reordered_tree.find("rows.row-a") < 0 || reordered_tree.find("rows.row-b") < 0
        || reordered_tree.find("rows.row-c") < 0 || reordered_tree.find("rows.0") >= 0) { return 18; }
    let reordered_world = keyed.bindActions(list_world);
    if (reordered_world.actionNameForViewId("rows.row-a") != "rows.toggle.row-a"
        || reordered_world.actionNameForViewId("rows.row-c") != "rows.toggle.row-c") { return 19; }
    reordered_tree.destroy();
    keyed.destroy();
    list_world.destroy();

    // The same 432 x 768 layout must be hit at the same logical point on
    // screens with different physical pixel counts and display densities.
    var tap_view = Button.filledAction("density.tap", "Tap", "smoke.bump");
    var tap_world = AppWorld.create().setIntResource("smoke.count", 0)
        .registerIntDeltaCommand("smoke.bump", "smoke.count", 1);
    var dense = AppRuntime.create(tap_view, tap_world, UiTheme.md3(), 432.0, 768.0)
        .syncViewportFromDisplay(1080.0, 1920.0, 1080.0, 1920.0, 2.5);
    var sparse = AppRuntime.create(tap_view, tap_world, UiTheme.md3(), 432.0, 768.0)
        .syncViewportFromDisplay(540.0, 960.0, 540.0, 960.0, 1.25);
    if (dense.viewportWidth() != 432.0 || sparse.viewportWidth() != 432.0
        || dense.viewportHeight() != 768.0 || sparse.viewportHeight() != 768.0
        || dense.renderScale() != 2.5 || sparse.renderScale() != 1.25) { return 7; }
    var tap_tree = dense.toUiTree();
    let tap_index = tap_tree.find("density.tap");
    if (tap_index < 0) { return 8; }
    let tap_node = tap_tree.nodeAt(tap_index);
    let tap_x = tap_node.bounds.x + tap_node.bounds.width * 0.5;
    let tap_y = tap_node.bounds.y + tap_node.bounds.height * 0.5;
    let dense_point = dense.mapNormalizedTouchPoint(tap_x / 432.0, tap_y / 768.0);
    let sparse_point = sparse.mapNormalizedTouchPoint(tap_x / 432.0, tap_y / 768.0);
    dense = dense.handleTap(dense_point).applyAllCommands();
    sparse = sparse.handleTap(sparse_point).applyAllCommands();
    if (dense.intResource("smoke.count", 0) != 1 || sparse.intResource("smoke.count", 0) != 1) { return 9; }
    if (dense.uiXToWindow(216.0) != 540 || sparse.uiXToWindow(216.0) != 270) { return 10; }
    tap_tree.destroy();
    dense.destroy();
    sparse.destroy();
    tap_view.destroy();
    tap_world.destroy();
    timeline.destroy();
    recorded.destroy();
    initial.destroy();
    root.destroy();
    world.destroy();
    return 0;
}

fn main() -> i32 {
    if (has_flag("--self-test")) { return selfTest(); }
    return App.manifestFromArgs().run(SmokeComponent.create());
}
