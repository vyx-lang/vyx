use Platform = Zyn.Platform.Platform.Platform;
use PlatformWindowHandle = Zyn.Platform.Window.PlatformWindowHandle;
use Window = Zyn.Platform.Window.Window;
use WindowDesc = Zyn.Platform.Window.WindowDesc;
use Renderer = Zyn.Nut.Renderer.Renderer;
use RendererDesc = Zyn.Nut.Renderer.RendererDesc;
use std.cacao;

// These checks validate typed handle shape, not GPU availability on another OS.
fn check_handle_shapes() -> i32 {
    if (PlatformWindowHandle.empty().isValid()) { return 1; }
    if (PlatformWindowHandle.win32(1, 0).isValid()) { return 2; }
    if (!PlatformWindowHandle.win32(1, 2).isValid()) { return 3; }
    if (PlatformWindowHandle.android(0).isValid()) { return 4; }
    if (PlatformWindowHandle.android(3).android_native_window != 3 as u64) { return 5; }
    if (PlatformWindowHandle.wayland(1, 0).isValid()) { return 6; }
    if (!PlatformWindowHandle.wayland(1, 2).isValid()) { return 7; }
    if (PlatformWindowHandle.x11(0, 2).isValid()) { return 8; }
    if (!PlatformWindowHandle.x11(1, 2).isValid()) { return 9; }
    if (PlatformWindowHandle.metal(0).isValid()) { return 10; }
    if (!PlatformWindowHandle.metal(3).isValid()) { return 11; }
    return 0;
}

fn check_native_surface(window: Window) -> i32 {
    let native = window.nativeHandle();
    if (!native.isValid()) { print("SDL did not provide a supported native window"); return 20; }
    var handle = NativeWindowHandle.empty();
    handle.hwnd = native.hwnd;
    handle.hinstance = native.hinstance;
    handle.android_native_window = native.android_native_window;
    handle.wayland_display = native.wayland_display;
    handle.wayland_surface = native.wayland_surface;
    handle.x11_display = native.x11_display;
    handle.x11_window = native.x11_window;
    handle.metal_layer = native.metal_layer;
    var instance: Instance;
    match (Instance.create(InstanceDesc.create(backend_auto(), "Zyn native surface smoke", 1).addFeature(instance_feature_surface()))) {
        case Ok(value) => { instance = value; }
        case Err(e) => { print(e.message); return 21; }
    }
    var surface: Surface;
    match (instance.createNativeSurface(handle)) {
        case Ok(value) => { surface = value; }
        case Err(e) => { print(e.message); instance.destroy(); return 22; }
    }
    surface.destroy();
    surface.destroy();
    instance.destroy();
    var renderer: Renderer;
    match (Renderer.create(window, RendererDesc.create("Native surface recreation", 64, 64).setShaderPath("target/nut/solid.slang"))) {
        case Ok(value) => { renderer = value; }
        case Err(e) => { print(e.message); return 24; }
    }
    match (renderer.renderFrame()) {
        case Ok(_) => {}
        case Err(e) => { print(e.message); renderer.destroy(); return 25; }
    }
    // Same handle and dimensions: recreation must not take the resize no-op.
    match (renderer.recreateSurface(window)) {
        case Ok(_) => {}
        case Err(e) => { print(e.message); renderer.destroy(); return 26; }
    }
    match (renderer.renderFrame()) {
        case Ok(_) => {}
        case Err(e) => { print(e.message); renderer.destroy(); return 27; }
    }
    renderer.destroy();
    return 0;
}

fn main() -> i32 {
    let shapes = check_handle_shapes();
    if (shapes != 0) { return shapes; }
    match (Platform.init()) {
        case Ok(_) => {}
        case Err(e) => { print(e.message); return 12; }
    }
    var window: Window;
    match (Window.create(WindowDesc.create("Zyn native surface smoke", 64, 64).hidden())) {
        case Ok(value) => { window = value; }
        case Err(e) => { print(e.message); Platform.quit(); return 13; }
    }
    let result = check_native_surface(window);
    window.destroy();
    window.destroy();
    if (window.nativeHandle().isValid()) { Platform.quit(); return 23; }
    Platform.quit();
    if (result != 0) { return result; }
    print("zyn native surface smoke: OK");
    return 0;
}
