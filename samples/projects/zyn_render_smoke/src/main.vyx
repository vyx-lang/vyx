use Zyn;
use std.cacao;
use Platform = Zyn.Platform.Platform.Platform;
use Window = Zyn.Platform.Window.Window;
use WindowDesc = Zyn.Platform.Window.WindowDesc;
use EventLoop = Zyn.Platform.Event.EventLoop;
use Clock = Zyn.Platform.Clock.Clock;
use Color = Zyn.Nut.Types.Color;
use Point = Zyn.Nut.Types.Point;
use Rectangle = Zyn.Nut.Types.Rectangle;
use Quad = Zyn.Nut.Types.Quad;
use Transform2D = Zyn.Nut.Types.Transform2D;
use LinearGradient = Zyn.Nut.Types.LinearGradient;
use Canvas = Zyn.Nut.Canvas.Canvas;
use RenderGraph = Zyn.Nut.RenderGraph.RenderGraph;
use RenderPlan = Zyn.Nut.RenderPlan.RenderPlan;
use SolidVertex = Zyn.Nut.Batch.SolidVertex;
use TexturedVertex = Zyn.Nut.Batch.TexturedVertex;
use Renderer = Zyn.Nut.Renderer.Renderer;
use RendererDesc = Zyn.Nut.Renderer.RendererDesc;
use CustomPipelineDesc = Zyn.Nut.Renderer.CustomPipelineDesc;
use rendererBackendFeatureDepthStencilClipMask = Zyn.Nut.Renderer.rendererBackendFeatureDepthStencilClipMask;
use rendererBackendFeatureLayerTargets = Zyn.Nut.Renderer.rendererBackendFeatureLayerTargets;
use rendererBackendRequiredFeatureMask = Zyn.Nut.Renderer.rendererBackendRequiredFeatureMask;
use rendererAdapterFeatureBit = Zyn.Nut.Renderer.rendererAdapterFeatureBit;
use rendererAdapterFeatureCount = Zyn.Nut.Renderer.rendererAdapterFeatureCount;
use rendererFrameErrorKindDeviceLost = Zyn.Nut.Renderer.rendererFrameErrorKindDeviceLost;
use rendererFrameErrorKindPresentFailed = Zyn.Nut.Renderer.rendererFrameErrorKindPresentFailed;
use rendererFrameErrorKindSubmitFailed = Zyn.Nut.Renderer.rendererFrameErrorKindSubmitFailed;
use rendererFrameErrorKindWaitIdleFailed = Zyn.Nut.Renderer.rendererFrameErrorKindWaitIdleFailed;
use rendererRecoveryActionRetryFrame = Zyn.Nut.Renderer.rendererRecoveryActionRetryFrame;
use rendererCustomPipelineVertexLayoutSolid = Zyn.Nut.Renderer.rendererCustomPipelineVertexLayoutSolid;
use rendererCustomPipelineVertexLayoutTextured = Zyn.Nut.Renderer.rendererCustomPipelineVertexLayoutTextured;
use Path = Zyn.Nut.Path.Path;
use Atlas = Zyn.Nut.Atlas.Atlas;
use AtlasRegion = Zyn.Nut.Atlas.AtlasRegion;
use AtlasSet = Zyn.Nut.Atlas.AtlasSet;
use Sprite = Zyn.Nut.Atlas.Sprite;

fn cleanup_fail(window: Window, code: i32) -> i32 {
    window.destroy();
    Platform.quit();
    return code;
}

fn smokeFormatRg32Float() -> u32 {
    return 35 as u32;
}

fn smokeFormatRgba32Float() -> u32 {
    return 41 as u32;
}

@[borrow_args]
fn clip_mask_metrics_ok(renderer: Renderer) -> bool {
    let mask_vertices = renderer.lastFrameClipMaskVertexCount();
    if (mask_vertices <= 0) { return false; }
    return renderer.lastFrameClipMaskUploadedBytes() == ((mask_vertices as u64) * (sizeof::<SolidVertex>() as u64));
}

fn main() -> i32 {
    match (Platform.init()) {
        case Ok(_) => {}
        case Err(_) => { return 1; }
    }

    let desc = WindowDesc.create("Zyn render smoke", 960, 540)
        .resizable()
        .highPixelDensity();

    var window: Window;
    match (Window.create(desc)) {
        case Ok(v) => { window = v; }
        case Err(_) => { Platform.quit(); return 2; }
    }

    match (window.show()) {
        case Ok(_) => {}
        case Err(_) => { return cleanup_fail(window, 3); }
    }

    var icon_atlas = Atlas.create(1024, 1024, 0);
    let icon_region = icon_atlas.add("icon", 1024, 1024);
    if (!icon_region.isValid() || icon_region.u0() != 0.0 || icon_region.v0() != 0.0 || icon_region.u1() != 1.0 || icon_region.v1() != 1.0) {
        icon_atlas.destroy();
        return cleanup_fail(window, 19);
    }

    let renderer_desc = RendererDesc.create("ZynRenderSmoke", 960 as u32, 540 as u32)
        .setClearColor(Color.rgba(0.02, 0.16, 0.30, 1.0))
        .setShaderPath("target/nut/solid.slang")
        .setSpriteAtlasPath("../../../Zyn/icon.png");
    let backend_probe_desc = RendererDesc.create("BackendProbe", 1 as u32, 1 as u32).setBackendName("DX12");
    if (backend_probe_desc.backend != backend_d3d12()) {
        icon_atlas.destroy();
        return cleanup_fail(window, 156);
    }

    var renderer: Renderer;
    match (Renderer.create(window, renderer_desc)) {
        case Ok(v) => { renderer = v; }
        case Err(e) => {
            print("Renderer.create failed");
            print(e.message);
            icon_atlas.destroy();
            return cleanup_fail(window, 100 + e.code);
        }
    }
    if (renderer.backendType() == backend_auto() || renderer.backendName() == "auto" || renderer.backendName() == "unknown") {
        renderer.destroy();
        icon_atlas.destroy();
        return cleanup_fail(window, 157);
    }
    if (!renderer.backendMatchesRequest() || renderer.backendFallbackActive() || renderer.requestedBackendName() != "auto") {
        renderer.destroy();
        icon_atlas.destroy();
        return cleanup_fail(window, 157);
    }
    let backend_profile = renderer.backendProfile();
    if (backend_profile.backend != renderer.backendType() || backend_profile.name != renderer.backendName() || !backend_profile.known || !backend_profile.is_explicit || backend_profile.feature_mask != rendererBackendRequiredFeatureMask() || backend_profile.missing_required_mask != 0 as u32 || !backend_profile.satisfiesRequiredFeatures() || !renderer.backendSatisfiesRequiredFeatures() || renderer.backendMissingRequiredFeatureMask() != 0 as u32 || renderer.backendFeatureMask() != rendererBackendRequiredFeatureMask()) {
        renderer.destroy();
        icon_atlas.destroy();
        return cleanup_fail(window, 158);
    }
    if (!renderer.backendHasFeature(rendererBackendFeatureDepthStencilClipMask()) || !renderer.backendHasFeature(rendererBackendFeatureLayerTargets())) {
        renderer.destroy();
        icon_atlas.destroy();
        return cleanup_fail(window, 159);
    }
    let pipeline_stats_feature = device_feature_pipeline_statistics();
    let pipeline_stats_bit = rendererAdapterFeatureBit(pipeline_stats_feature);
    if (renderer.adapterFeatureQueryCount() != rendererAdapterFeatureCount() || renderer.adapterFeatureSupportedCount() < 0 || renderer.adapterFeatureQueryFailedCount() < 0 || renderer.adapterFeatureSupportedCount() + renderer.adapterFeatureQueryFailedCount() > renderer.adapterFeatureQueryCount() || rendererAdapterFeatureBit(99 as u32) != 0 as u32 || renderer.adapterSupportsFeature(99 as u32) || renderer.adapterSupportsFeature(pipeline_stats_feature) != ((renderer.adapterFeatureMask() & pipeline_stats_bit) != 0 as u32)) {
        renderer.destroy();
        icon_atlas.destroy();
        return cleanup_fail(window, 187);
    }
    let adapter_identity_score = (renderer.adapterName().len as u64) + (renderer.adapterDeviceId() as u64) + (renderer.adapterVendorId() as u64) + (renderer.adapterType() as u64) + renderer.adapterDedicatedVideoMemory();
    if (adapter_identity_score == 0 as u64 && renderer.adapterFeatureQueryFailedCount() == renderer.adapterFeatureQueryCount()) {
        renderer.destroy();
        icon_atlas.destroy();
        return cleanup_fail(window, 188);
    }
    if (renderer.spriteTextureWidth() != 1024 as u32 || renderer.spriteTextureHeight() != 1024 as u32 || renderer.spriteTextureLayers() != 1 as u32 || renderer.spriteTextureUploadBytes() != 4194304 as u64 || renderer.spriteTextureUploadReallocCount() != 0 || renderer.spriteTextureUpdateKind() != 1 || renderer.spriteTextureUpdatePageCount() != 1) {
        renderer.destroy();
        icon_atlas.destroy();
        return cleanup_fail(window, 24);
    }
    if (renderer.resizeCount() != 0 || renderer.swapchainGeneration() != 1 || renderer.frameRecoveryCount() != 0 || renderer.frameRecoveryAttemptCount() != 0 || renderer.lastFrameErrorCode() != 0 || renderer.lastFrameRecovered() || renderer.lastRecoveryErrorCode() != 0 || renderer.lastRecoveryAttempted() || renderer.lastRecoveryResizeSucceeded() || renderer.lastRecoveryRetrySucceeded() || renderer.lastRecoveryResizeWasNoop() || renderer.lastRecoveryResizeErrorCode() != 0 || renderer.lastRecoveryRetryErrorCode() != 0 || renderer.lastRecoveryPurgedTransientCount() != 0 || renderer.lastRecoveryPurgedTransientBytes() != 0 as u64 || renderer.layerTargetPurgeCount() != 0 || renderer.layerTargetTrimmedCount() != 0 || renderer.layerTargetPeakCount() != 0 || renderer.layerTargetPeakBytes() != 0 as u64 || renderer.frameVertexReallocCount() != 0 || renderer.frameTexturedVertexReallocCount() != 0 || renderer.cachedClipMaskVertexCapacity() != 0 || renderer.clipMaskVertexReallocCount() != 0) {
        renderer.destroy();
        icon_atlas.destroy();
        return cleanup_fail(window, 55);
    }
    if (renderer.frameRecoverySuccessfulFrameCount() != 0 || renderer.frameRecoveryConsecutiveFailureCount() != 0 || renderer.frameRecoveryMaxConsecutiveFailureCount() != 0 || renderer.lastRecoveryAction() != 0 || renderer.lastRecoveryActionName() != "none" || renderer.lastRecoveryDeviceRecreateRecommended() || renderer.lastRecoveryRetryAttemptCount() != 0 || renderer.lastRecoveryFullResetRequired() || renderer.transientResourcePartialFailureCount() != 0 || renderer.transientResourcePartialCleanupCount() != 0 || renderer.transientResourcePartialCleanupBytes() != 0 as u64) {
        renderer.destroy();
        icon_atlas.destroy();
        return cleanup_fail(window, 256);
    }
    if (renderer.layerTargetAllocationCount() != 0 || renderer.layerTargetReuseCount() != 0 || renderer.layerTargetRecreateCount() != 0 || renderer.lastFrameLayerTargetAllocatedCount() != 0 || renderer.lastFrameLayerTargetReusedCount() != 0 || renderer.lastFrameLayerTargetRecreatedCount() != 0) {
        renderer.destroy();
        icon_atlas.destroy();
        return cleanup_fail(window, 177);
    }

    var frames: i32 = 0;
    var stable_vertex_capacity: i32 = 0;
    while (frames < 180) {
        EventLoop.pump();
        var canvas = Canvas.create();
        canvas = canvas.clear(Color.rgba(0.02, 0.16, 0.30, 1.0));
        canvas = canvas.drawShadowRect(Rectangle.xywh(120.0, 90.0, 320.0, 180.0), 14.0, 18.0, 20.0, Color.rgba(0.0, 0.0, 0.0, 0.32));
        canvas = canvas.drawRect(Rectangle.xywh(120.0, 90.0, 320.0, 180.0), Color.rgba(0.90, 0.20, 0.18, 1.0));
        canvas = canvas.drawRect(Rectangle.xywh(360.0, 260.0, 280.0, 160.0), Color.rgba(0.12, 0.70, 0.95, 0.85));
        canvas = canvas.strokeRect(Rectangle.xywh(92.0, 62.0, 376.0, 236.0), 6.0, Color.rgba(0.95, 0.95, 0.92, 0.90));
        canvas = canvas.pushClipRect(Rectangle.xywh(560.0, 300.0, 160.0, 90.0));
        canvas = canvas.drawRect(Rectangle.xywh(520.0, 280.0, 260.0, 140.0), Color.rgba(0.65, 0.30, 0.95, 0.95));
        canvas = canvas.popClip();
        canvas = canvas.drawCircle(Point.xy(720.0, 160.0), 72.0, Color.rgba(1.0, 0.82, 0.18, 1.0));
        canvas = canvas.drawTriangle(Point.xy(700.0, 330.0), Point.xy(850.0, 330.0), Point.xy(780.0, 450.0), Color.rgba(0.20, 1.0, 0.55, 1.0));
        canvas = canvas.fillGradientRect(Rectangle.xywh(720.0, 40.0, 160.0, 60.0), LinearGradient.horizontal(Color.rgba(1.0, 0.15, 0.35, 1.0), Color.rgba(0.15, 0.35, 1.0, 1.0)));
        canvas = canvas.pushTransform(Transform2D.translation(70.0, -30.0).multiply(Transform2D.scale(0.75, 0.75)));
        canvas = canvas.fillQuad(Quad.fromRect(Rectangle.xywh(700.0, 420.0, 120.0, 80.0)), Color.rgba(0.95, 0.45, 0.15, 1.0));
        canvas = canvas.drawRect(Rectangle.xywh(500.0, 430.0, 130.0, 70.0), Color.rgba(0.25, 0.95, 0.80, 0.90));
        canvas = canvas.popTransform();
        var path = Path.create()
            .moveTo(Point.xy(90.0, 340.0))
            .lineTo(Point.xy(180.0, 320.0))
            .lineTo(Point.xy(260.0, 360.0))
            .lineTo(Point.xy(220.0, 430.0))
            .lineTo(Point.xy(110.0, 430.0))
            .close();
        canvas = canvas.fillPath(path, Color.rgba(0.95, 0.80, 0.20, 0.95));
        canvas = canvas.strokePath(path, 4.0, Color.rgba(0.12, 0.08, 0.03, 1.0));
        var curved_path = Path.create()
            .moveTo(Point.xy(330.0, 90.0))
            .quadraticTo(Point.xy(470.0, 20.0), Point.xy(610.0, 95.0), 3)
            .cubicTo(Point.xy(650.0, 160.0), Point.xy(530.0, 210.0), Point.xy(640.0, 260.0), 3);
        canvas = canvas.strokePath(curved_path, 5.0, Color.rgba(1.0, 0.72, 0.20, 1.0));
        var rounded_path = Path.roundedRect(Rectangle.xywh(60.0, 36.0, 160.0, 78.0), 22.0, 2);
        canvas = canvas.fillPath(rounded_path, Color.rgba(0.18, 0.92, 0.55, 0.80));
        canvas = canvas.pushLayer(0.65);
        canvas = canvas.drawSprite(Sprite.create(icon_region, Rectangle.xywh(780.0, 86.0, 142.0, 142.0), Color.rgba(0.98, 0.98, 1.0, 0.95)));
        canvas = canvas.popLayer();
        canvas = canvas.pushTransform(Transform2D.translation(-32.0, 18.0).multiply(Transform2D.scale(1.5, 1.5)));
        canvas = canvas.drawSprite(Sprite.create(icon_region, Rectangle.xywh(590.0, 78.0, 44.0, 44.0), Color.rgba(1.0, 0.96, 0.42, 0.9)));
        canvas = canvas.popTransform();
        canvas = canvas.pushClipRect(Rectangle.xywh(790.0, 380.0, 44.0, 36.0));
        canvas = canvas.drawSprite(Sprite.create(icon_region, Rectangle.xywh(760.0, 360.0, 128.0, 128.0), Color.rgba(1.0, 0.55, 0.45, 0.85)));
        canvas = canvas.popClip();
        canvas = canvas.drawLine(Point.xy(150.0, 460.0), Point.xy(810.0, 410.0), 10.0, Color.rgba(0.88, 0.95, 1.0, 1.0));
        if (canvas.commandCount() != 57 || canvas.drawCommandCount() != 46) {
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 6);
        }
        let graph = canvas.build();
        if (!graph.hasClear() || graph.commandCount() != 57 || graph.drawCommandCount() != 46 || graph.estimatedVertexCount() != 342) {
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 7);
        }
        if (!graph.isBalanced()) {
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 18);
        }
        var plan: RenderPlan;
        match (RenderPlan.build(graph)) {
            case Ok(v) => { plan = v; }
            case Err(_) => {
                graph.destroy();
                icon_atlas.destroy();
                rounded_path.destroy();
                curved_path.destroy();
                path.destroy();
                renderer.destroy();
                return cleanup_fail(window, 25);
            }
        }
        if (plan.passCount() != 3) {
            print("plan passCount mismatch");
            plan.destroy();
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 26);
        }
        if (plan.draw_count != 46) {
            print("plan draw_count mismatch");
            plan.destroy();
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 26);
        }
        if (plan.estimatedVertexCount() != 348) {
            print("plan estimatedVertexCount mismatch");
            plan.destroy();
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 26);
        }
        if (plan.layer_change_count != 2) {
            print("plan layer_change_count mismatch");
            plan.destroy();
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 26);
        }
        if (plan.segment_count != 8) {
            print("plan segment_count mismatch");
            plan.destroy();
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 26);
        }
        if (plan.solid_segment_count != 4) {
            print("plan solid_segment_count mismatch");
            plan.destroy();
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 26);
        }
        if (plan.textured_segment_count != 4) {
            print("plan textured_segment_count mismatch");
            plan.destroy();
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 26);
        }
        plan.destroy();
        if (renderer.framebufferWidth() == 0 as u32 || renderer.framebufferHeight() == 0 as u32) {
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 8);
        }
        match (renderer.renderGraph(graph)) {
            case Ok(_) => {}
            case Err(e) => {
                print("Renderer.renderGraph failed");
                print(e.message);
                graph.destroy();
                icon_atlas.destroy();
                rounded_path.destroy();
                curved_path.destroy();
                path.destroy();
                renderer.destroy();
                return cleanup_fail(window, 5);
            }
        }
        if (renderer.lastFrameVertexCount() != (graph.estimatedVertexCount() + 6)) {
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 11);
        }
        if (renderer.lastFrameDrawCommandCount() != graph.drawCommandCount()) {
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 17);
        }
        if (renderer.lastFrameTexturedVertexCount() != 24) {
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 12);
        }
        if (renderer.lastFrameSegmentCount() != 8) {
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 20);
        }
        let expected_solid_bytes = (324 as u64) * (sizeof::<SolidVertex>() as u64);
        let expected_textured_bytes = (24 as u64) * (sizeof::<TexturedVertex>() as u64);
        if (renderer.lastFrameSolidUploadedBytes() != expected_solid_bytes) {
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 13);
        }
        if (renderer.lastFrameTexturedUploadedBytes() != expected_textured_bytes) {
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 21);
        }
        if (renderer.lastFrameUploadedBytes() != (expected_solid_bytes + expected_textured_bytes)) {
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 22);
        }
        if (renderer.lastFrameLayerTargetCount() != 1) {
            print("layer target count mismatch");
            print(renderer.lastFrameLayerTargetCount());
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 54);
        }
        if (renderer.lastFrameLayerTargetBytes() == 0 as u64) {
            print("layer target bytes mismatch");
            print(renderer.lastFrameLayerTargetBytes());
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 54);
        }
        let expected_layer_cache_bytes = (renderer.framebufferWidth() as u64) * (renderer.framebufferHeight() as u64) * (4 as u64);
        if (renderer.lastFrameLayerCacheCount() != 1 || renderer.lastFrameLayerCacheBytes() != expected_layer_cache_bytes || renderer.layerTargetCacheCount() != 1 || renderer.layerTargetCacheBytes() != expected_layer_cache_bytes || renderer.layerTargetPeakCount() != 1 || renderer.layerTargetPeakBytes() != expected_layer_cache_bytes || renderer.lastFrameLayerPassCount() != 1 || renderer.lastFrameLayerCompositeCount() != 1 || renderer.lastFrameMainDrawCount() != 45 || renderer.lastFrameLayerDrawCount() != 1) {
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 58);
        }
        if (renderer.cachedVertexCapacity() < graph.estimatedVertexCount()) {
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 9);
        }
        if (renderer.cachedTexturedVertexCapacity() < renderer.lastFrameTexturedVertexCount()) {
            graph.destroy();
            icon_atlas.destroy();
            rounded_path.destroy();
            curved_path.destroy();
            path.destroy();
            renderer.destroy();
            return cleanup_fail(window, 23);
        }
        if (frames == 0) {
            stable_vertex_capacity = renderer.cachedVertexCapacity();
            if (renderer.frameVertexReallocCount() != 1 || renderer.frameTexturedVertexReallocCount() != 1) {
                graph.destroy();
                icon_atlas.destroy();
                rounded_path.destroy();
                curved_path.destroy();
                path.destroy();
                renderer.destroy();
                return cleanup_fail(window, 92);
            }
        } else {
            if (renderer.cachedVertexCapacity() != stable_vertex_capacity || renderer.frameVertexReallocCount() != 1 || renderer.frameTexturedVertexReallocCount() != 1) {
                graph.destroy();
                icon_atlas.destroy();
                rounded_path.destroy();
                curved_path.destroy();
                path.destroy();
                renderer.destroy();
                return cleanup_fail(window, 10);
            }
        }
        graph.destroy();
        rounded_path.destroy();
        curved_path.destroy();
        path.destroy();
        canvas.destroy();
        Clock.delay(16 as u32);
        frames = frames + 1;
    }

    var clip_path = Path.create()
        .moveTo(Point.xy(80.0, 80.0))
        .lineTo(Point.xy(180.0, 90.0))
        .lineTo(Point.xy(130.0, 180.0))
        .close();
    var clip_canvas = Canvas.create();
    clip_canvas = clip_canvas.pushClipPath(&clip_path);
    clip_canvas = clip_canvas.drawRect(Rectangle.xywh(40.0, 40.0, 180.0, 180.0), Color.rgba(0.8, 0.2, 0.9, 1.0));
    clip_canvas = clip_canvas.popClip();
    let clip_graph = clip_canvas.build();
    match (renderer.renderGraph(clip_graph)) {
        case Ok(_) => {
            let expected_clip_stencil_bytes = (renderer.framebufferWidth() as u64) * (renderer.framebufferHeight() as u64) * (4 as u64);
            if (renderer.lastFrameDrawCommandCount() != 1 || renderer.lastFrameSegmentCount() != 1 || renderer.lastFrameClipPathCount() != 1 || renderer.lastFrameClipPathBoundsFallbackCount() != 0 || renderer.lastFrameClipStencilTargetCount() != 1 || renderer.lastFrameClipStencilTargetBytes() != expected_clip_stencil_bytes || !clip_mask_metrics_ok(renderer) || renderer.cachedClipMaskVertexCapacity() < renderer.lastFrameClipMaskVertexCount() || renderer.clipMaskVertexReallocCount() != 1 || renderer.lastFrameVertexCount() != 3) {
                clip_graph.destroy();
                clip_canvas.destroy();
                clip_path.destroy();
                renderer.destroy();
                icon_atlas.destroy();
                return cleanup_fail(window, 70);
            }
        }
        case Err(e) => {
            print("Renderer ClipPath render failed");
            print(e.message);
            clip_graph.destroy();
            clip_canvas.destroy();
            clip_path.destroy();
            renderer.destroy();
            icon_atlas.destroy();
