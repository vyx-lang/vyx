use std.cacao;

class UploadVertex {
    public x: f32;
    public y: f32;
}

fn main() -> i32 {
    let version = abiVersion();
    if (version == 0) { return 1; }

    let desc = InstanceDesc.create(backend_vulkan(), "vyx-cacao-smoke", 1);
    var instance: Instance;
    match (Instance.create(desc)) {
        case Ok(v) => { instance = v; }
        case Err(_) => { return 2; }
    }

    var adapter: Adapter;
    match (instance.firstAdapter()) {
        case Ok(v) => { adapter = v; }
        case Err(_) => { instance.destroy(); return 3; }
    }

    var props: AdapterProperties;
    match (adapter.properties()) {
        case Ok(v) => { props = v; }
        case Err(_) => { adapter.destroy(); instance.destroy(); return 4; }
    }
    if (props.vendor_id == 0 && props.device_id == 0) {
        adapter.destroy();
        instance.destroy();
        return 5;
    }
    if (props.name.len == 0) {
        adapter.destroy();
        instance.destroy();
        return 6;
    }
    if (result_ok() != 0 || status_timeout() != 1 || status_error() != 6 || error_invalid_argument() != -1 || error_unknown() != -100) {
        adapter.destroy();
        instance.destroy();
        return 7;
    }
    if (instance_feature_bindless_descriptors() != 22 || shader_stage_all_mesh_shading() != 12288 || format_undefined() != 67) {
        adapter.destroy();
        instance.destroy();
        return 7;
    }

    let compute_queue = QueueRequest.compute().setCount(1).setPriority(0.5);
    if (compute_queue.queue_type != queue_compute() || compute_queue.count != 1) {
        adapter.destroy();
        instance.destroy();
        return 8;
    }
    let transfer_queue = QueueRequest.transfer();
    if (transfer_queue.queue_type != queue_transfer()) {
        adapter.destroy();
        instance.destroy();
        return 9;
    }
    let present_queue = QueueRequest.present();
    if (present_queue.queue_type != queue_present()) {
        adapter.destroy();
        instance.destroy();
        return 10;
    }

    var device: Device;
    match (adapter.createDevice(DeviceDesc.createDefault())) {
        case Ok(v) => { device = v; }
        case Err(_) => { adapter.destroy(); instance.destroy(); return 11; }
    }

    let buffer_desc = BufferDesc.create(16, buffer_usage_vertex() | buffer_usage_transfer_dst(), memory_cpu_to_gpu(), "vertex-upload");
    var buffer: Buffer;
    match (device.createBuffer(buffer_desc)) {
        case Ok(v) => { buffer = v; }
        case Err(_) => { device.destroy(); adapter.destroy(); instance.destroy(); return 12; }
    }

    let vertex = UploadVertex { x: 1.0, y: 2.0 };
    let n = sizeof::<UploadVertex>();
    if (buffer_desc.size < n as u64) {
        buffer.destroy();
        device.destroy();
        adapter.destroy();
        instance.destroy();
        return 13;
    }

    match (buffer.write(vertex, 0)) {
        case Ok(_) => {}
        case Err(_) => { buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 14; }
    }
    match (buffer.writeMapped(vertex, 0)) {
        case Ok(_) => {}
        case Err(_) => { buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 15; }
    }
    var read_back: UploadVertex;
    match (buffer.read::<UploadVertex>(0)) {
        case Ok(v) => { read_back = v; }
        case Err(_) => { buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 16; }
    }
    if (read_back.x != 1.0 || read_back.y != 2.0) {
        buffer.destroy();
        device.destroy();
        adapter.destroy();
        instance.destroy();
        return 17;
    }

    buffer.destroy();
    device.destroy();
    adapter.destroy();
    instance.destroy();
    return 0;
}
