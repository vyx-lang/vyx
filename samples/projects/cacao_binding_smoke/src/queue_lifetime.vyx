use std.cacao;

fn main() -> i32 {
    let instance_desc = InstanceDesc.create(backend_d3d12(), "vyx-cacao-queue-lifetime", 1);
    var instance: Instance;
    match (Instance.create(instance_desc)) {
        case Ok(v) => { instance = v; }
        case Err(_) => { return 1; }
    }

    var adapter: Adapter;
    match (instance.firstAdapter()) {
        case Ok(v) => { adapter = v; }
        case Err(_) => { instance.destroy(); return 2; }
    }

    var device: Device;
    match (adapter.createDevice(DeviceDesc.createDefault())) {
        case Ok(v) => { device = v; }
        case Err(_) => { adapter.destroy(); instance.destroy(); return 3; }
    }

    var queue: DeviceQueue;
    match (device.getQueue(queue_graphics(), 0)) {
        case Ok(v) => {
            if (!v.isValid()) { device.destroy(); adapter.destroy(); instance.destroy(); return 15; }
            queue = v;
            if (!queue.isValid()) { device.destroy(); adapter.destroy(); instance.destroy(); return 16; }
        }
        case Err(_) => { device.destroy(); adapter.destroy(); instance.destroy(); return 4; }
    }
    if (!queue.isValid()) { device.destroy(); adapter.destroy(); instance.destroy(); return 5; }

    var cmd: CommandEncoder;
    match (device.createCommandEncoder(command_buffer_primary())) {
        case Ok(v) => { cmd = v; }
        case Err(_) => { queue.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 6; }
    }
    if (!cmd.isValid()) { queue.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 7; }

    match (cmd.reset()) { case Ok(_) => {} case Err(_) => { cmd.destroy(); queue.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 8; } }
    match (cmd.begin(true, false)) { case Ok(_) => {} case Err(_) => { cmd.destroy(); queue.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 9; } }
    match (cmd.end()) { case Ok(_) => {} case Err(_) => { cmd.destroy(); queue.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 10; } }

    if (!queue.isValid()) { cmd.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 11; }
    if (!cmd.isValid()) { queue.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 12; }
    match (queue.submitSimple(cmd.clone())) {
        case Ok(_) => {}
        case Err(_) => { cmd.destroy(); queue.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 13; }
    }

    match (queue.waitIdle()) { case Ok(_) => {} case Err(_) => { cmd.destroy(); queue.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 14; } }
    cmd.destroy();
    queue.destroy();
    device.destroy();
    adapter.destroy();
    instance.destroy();
    return 0;
}
