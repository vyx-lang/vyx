use std.cacao;
use std.collections;

class DrawArgs {
    public vertex_count: u32;
    public instance_count: u32;
    public first_vertex: u32;
    public first_instance: u32;
}

class CountArgs {
    public count: u32;
}

fn main() -> i32 {
    let version = abiVersion();
    if (version == 0) { return 1; }

    let instance_desc = InstanceDesc.create(backend_vulkan(), "vyx-cacao-query-sync-binding-smoke", 1);
    var instance: Instance;
    match (Instance.create(instance_desc)) {
        case Ok(v) => { instance = v; }
        case Err(_) => { return 2; }
    }

    var adapter: Adapter;
    match (instance.firstAdapter()) {
        case Ok(v) => { adapter = v; }
        case Err(_) => { instance.destroy(); return 3; }
    }

    match (adapter.adapterType()) {
        case Ok(_) => {}
        case Err(_) => { adapter.destroy(); instance.destroy(); return 4; }
    }
    match (adapter.isFeatureSupported(device_feature_draw_indirect_count())) {
        case Ok(_) => {}
        case Err(_) => { adapter.destroy(); instance.destroy(); return 5; }
    }
    match (adapter.findQueueFamilyIndex(queue_compute())) {
        case Ok(_) => {}
        case Err(_) => { adapter.destroy(); instance.destroy(); return 6; }
    }

    var device: Device;
    match (adapter.createDevice(DeviceDesc.createDefault())) {
        case Ok(v) => { device = v; }
        case Err(_) => { adapter.destroy(); instance.destroy(); return 7; }
    }

    var timeline: TimelineSemaphore;
    match (device.createTimelineSemaphore(0)) {
        case Ok(v) => { timeline = v; }
        case Err(_) => { device.destroy(); adapter.destroy(); instance.destroy(); return 8; }
    }
    match (timeline.signal(1)) {
        case Ok(_) => {}
        case Err(_) => { timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 9; }
    }
    match (timeline.wait(1, 1000000000)) {
        case Ok(_) => {}
        case Err(_) => { timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 10; }
    }
    match (timeline.value()) {
        case Ok(v) => { if (v < 1) { timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 11; } }
        case Err(_) => { timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 12; }
    }

    var query_pool: QueryPool;
    match (device.createQueryPool(QueryPoolDesc.timestamp(2))) {
        case Ok(v) => { query_pool = v; }
        case Err(_) => { timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 13; }
    }
    match (query_pool.queryType()) {
        case Ok(v) => { if (v != query_type_timestamp()) { query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 14; } }
        case Err(_) => { query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 15; }
    }
    match (query_pool.count()) {
        case Ok(v) => { if (v != 2) { query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 16; } }
        case Err(_) => { query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 17; }
    }

    let draw_args = DrawArgs { vertex_count: 0, instance_count: 0, first_vertex: 0, first_instance: 0 };
    var indirect: Buffer;
    match (device.createBufferWithData(draw_args, buffer_usage_indirect(), memory_cpu_to_gpu(), "query-sync-indirect")) {
        case Ok(v) => { indirect = v; }
        case Err(_) => { query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 18; }
    }
    let count_args = CountArgs { count: 0 };
    var counts: Buffer;
    match (device.createBufferWithData(count_args, buffer_usage_indirect(), memory_cpu_to_gpu(), "query-sync-count")) {
        case Ok(v) => { counts = v; }
        case Err(_) => { indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 19; }
    }

    match (indirect.usage()) {
        case Ok(v) => { if ((v & buffer_usage_indirect()) == 0) { counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 20; } }
        case Err(_) => { counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 21; }
    }
    match (indirect.memoryUsage()) {
        case Ok(v) => { if (v != memory_cpu_to_gpu()) { counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 22; } }
        case Err(_) => { counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 23; }
    }
    match (indirect.deviceAddress()) {
        case Ok(_) => {}
        case Err(_) => { counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 24; }
    }

    let tex_desc = TextureDesc.create2D(8, 8, format_rgba8_unorm(), texture_usage_sampled() | texture_usage_transfer_dst(), "query-sync-view")
        .setInitialState(resource_shader_read())
        .setMipLevels(1)
        .setSampleCount(1);
    var texture: Texture;
    match (device.createTexture(tex_desc)) {
        case Ok(v) => { texture = v; }
        case Err(_) => { counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 25; }
    }
    match (texture.depth()) { case Ok(v) => { if (v != 1) { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 26; } } case Err(_) => { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 27; } }
    match (texture.mipLevels()) { case Ok(v) => { if (v != 1) { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 28; } } case Err(_) => { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 29; } }
    match (texture.arrayLayers()) { case Ok(v) => { if (v != 1) { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 30; } } case Err(_) => { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 31; } }
    match (texture.textureType()) { case Ok(v) => { if (v != texture_type_2d()) { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 32; } } case Err(_) => { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 33; } }
    match (texture.sampleCount()) { case Ok(v) => { if (v != 1) { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 34; } } case Err(_) => { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 35; } }
    match (texture.usage()) { case Ok(v) => { if ((v & texture_usage_sampled()) == 0) { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 36; } } case Err(_) => { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 37; } }
    match (texture.currentState()) { case Ok(_) => {} case Err(_) => { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 38; } }

    var view: TextureView;
    match (texture.createView(TextureViewDesc.color2D(format_rgba8_unorm(), "query-sync-view-explicit"))) {
        case Ok(v) => { view = v; }
        case Err(_) => { texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 39; }
    }
    match (view.desc()) {
        case Ok(v) => { if (v.view_type != texture_type_2d() || v.aspect != image_aspect_color()) { view.destroy(); texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 40; } }
        case Err(_) => { view.destroy(); texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 41; }
    }

    var encoder: CommandEncoder;
    match (device.createCommandEncoder(command_graphics())) {
        case Ok(v) => { encoder = v; }
        case Err(_) => { view.destroy(); texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 42; }
    }
    match (encoder.begin(true, false)) { case Ok(_) => {} case Err(_) => { encoder.destroy(); view.destroy(); texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 43; } }
    match (encoder.beginDebugLabel("query-sync", 0.1, 0.2, 0.3, 1.0)) { case Ok(_) => {} case Err(_) => { encoder.destroy(); view.destroy(); texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 44; } }
    match (encoder.insertDebugLabel("mid", 0.4, 0.5, 0.6, 1.0)) { case Ok(_) => {} case Err(_) => { encoder.destroy(); view.destroy(); texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 45; } }
    match (encoder.resetQueryPool(query_pool.clone(), 0, 2)) { case Ok(_) => {} case Err(_) => { encoder.destroy(); view.destroy(); texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 46; } }
    match (encoder.writeTimestamp(query_pool.clone(), 0)) { case Ok(_) => {} case Err(_) => { encoder.destroy(); view.destroy(); texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 47; } }
    match (encoder.drawIndirect(indirect.clone(), 0, 1, sizeof::<DrawArgs>() as u32)) { case Ok(_) => {} case Err(_) => { encoder.destroy(); view.destroy(); texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 48; } }
    match (encoder.pipelineBarrier(sync_scope_all_commands(), sync_scope_all_commands(), Vec::<MemoryBarrier>.new(), Vec::<BufferBarrier>.new(), Vec::<TextureBarrier>.new())) { case Ok(_) => {} case Err(_) => { encoder.destroy(); view.destroy(); texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 49; } }
    match (encoder.endDebugLabel()) { case Ok(_) => {} case Err(_) => { encoder.destroy(); view.destroy(); texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 50; } }
    match (encoder.end()) { case Ok(_) => {} case Err(_) => { encoder.destroy(); view.destroy(); texture.destroy(); counts.destroy(); indirect.destroy(); query_pool.destroy(); timeline.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 51; } }

    encoder.destroy();
    view.destroy();
    texture.destroy();
    counts.destroy();
    indirect.destroy();
    query_pool.destroy();
    timeline.destroy();
    device.destroy();
    adapter.destroy();
    instance.destroy();
    return 0;
}
