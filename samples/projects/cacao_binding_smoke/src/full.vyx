use std.cacao;
use std.collections;

class Vertex {
    public x: f32;
    public y: f32;
    public r: f32;
    public g: f32;
    public b: f32;
}

fn main() -> i32 {
    let version = abiVersion();
    if (version == 0) { return 1; }

    let instance_desc = InstanceDesc.create(backend_vulkan(), "vyx-cacao-full-binding-smoke", 1);
    var instance: Instance;
    match (Instance.create(instance_desc)) {
        case Ok(v) => { instance = v; }
        case Err(_) => { return 2; }
    }

    var adapter: Adapter;
    match (instance.firstAdapter()) {
        case Ok(v) => { adapter = v; }
        case Err(_) => { instance.destroy(); return 3; }
    }

    var device: Device;
    match (adapter.createDevice(DeviceDesc.createDefault())) {
        case Ok(v) => { device = v; }
        case Err(_) => { adapter.destroy(); instance.destroy(); return 4; }
    }

    let vertex = Vertex { x: 0.0, y: 0.5, r: 1.0, g: 0.0, b: 0.0 };
    var buffer: Buffer;
    match (device.createBufferWithData(vertex, buffer_usage_vertex() | buffer_usage_transfer_dst(), memory_cpu_to_gpu(), "full-binding-vertex")) {
        case Ok(v) => { buffer = v; }
        case Err(_) => { device.destroy(); adapter.destroy(); instance.destroy(); return 5; }
    }

    let color_desc = TextureDesc.create2DArray(64, 64, 2, format_rgba8_unorm(), texture_usage_color_attachment() | texture_usage_sampled(), "full-binding-color-array").setMipLevels(1).setSampleCount(1).setInitialState(resource_render_target());
    var color_texture: Texture;
    match (device.createTexture(color_desc)) {
        case Ok(v) => { color_texture = v; }
        case Err(_) => { buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 6; }
    }

    let depth_desc = TextureDesc.create2D(64, 64, format_d24_unorm_s8_uint(), texture_usage_depth_stencil_attachment(), "full-binding-depth").setInitialState(resource_depth_write());
    var depth_texture: Texture;
    match (device.createTexture(depth_desc)) {
        case Ok(v) => { depth_texture = v; }
        case Err(_) => { color_texture.destroy(); buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 7; }
    }

    let sampler_desc = SamplerDesc.nearestClamp("full-binding-nearest").setAddressMode(sampler_address_clamp_to_border(), sampler_address_clamp_to_edge(), sampler_address_repeat()).setCompare(false, compare_always()).setLod(0.0, 4.0, 0.0);
    var sampler: Sampler;
    match (device.createSampler(sampler_desc)) {
        case Ok(v) => { sampler = v; }
        case Err(_) => { depth_texture.destroy(); color_texture.destroy(); buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 8; }
    }

    var layout_desc = DescriptorSetLayoutDesc.empty();
    layout_desc.addBinding(0, descriptor_uniform_buffer(), 1, shader_stage_vertex());
    var set_layout: DescriptorSetLayout;
    match (device.createDescriptorSetLayout(layout_desc)) {
        case Ok(v) => { set_layout = v; }
        case Err(_) => { sampler.destroy(); depth_texture.destroy(); color_texture.destroy(); buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 9; }
    }

    var pool_desc = DescriptorPoolDesc.create(1);
    pool_desc.addSize(descriptor_uniform_buffer(), 1);
    var pool: DescriptorPool;
    match (device.createDescriptorPool(pool_desc)) {
        case Ok(v) => { pool = v; }
        case Err(_) => { set_layout.destroy(); sampler.destroy(); depth_texture.destroy(); color_texture.destroy(); buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 10; }
    }

    var set: DescriptorSet;
    match (pool.allocate(set_layout.clone())) {
        case Ok(v) => { set = v; }
        case Err(_) => { pool.destroy(); set_layout.destroy(); sampler.destroy(); depth_texture.destroy(); color_texture.destroy(); buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 11; }
    }
    match (set.writeBufferElement(0, buffer.clone(), 0, 0, sizeof::<Vertex>() as u64, descriptor_uniform_buffer(), 0)) {
        case Ok(_) => {}
        case Err(_) => { set.destroy(); pool.destroy(); set_layout.destroy(); sampler.destroy(); depth_texture.destroy(); color_texture.destroy(); buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 12; }
    }

    var pipeline_layout_desc = PipelineLayoutDesc.empty();
    pipeline_layout_desc.addSetLayout(set_layout.clone());
    pipeline_layout_desc.addPushConstants(shader_stage_vertex(), 0, 16);
    var pipeline_layout: PipelineLayout;
    match (device.createPipelineLayout(pipeline_layout_desc)) {
        case Ok(v) => { pipeline_layout = v; }
        case Err(_) => { set.destroy(); pool.destroy(); set_layout.destroy(); sampler.destroy(); depth_texture.destroy(); color_texture.destroy(); buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 13; }
    }

    var pipeline_desc = GraphicsPipelineDesc.create(pipeline_layout.clone())
        .setTopology(topology_triangle_strip())
        .setPrimitiveRestart(false)
        .setPolygonMode(polygon_fill())
        .setCullMode(cull_none())
        .setFrontFace(front_face_clockwise())
        .setLineWidth(1.0)
        .setDepthTest(true, true)
        .setDepthCompare(compare_less_or_equal())
        .setStencilReplace(3 as u32)
        .setDepthStencilFormat(format_d24_unorm_s8_uint())
        .setSampleCount(1)
        .addColorAttachmentDefault()
        .addColorFormat(format_rgba8_unorm());
    if (pipeline_desc.sample_count != 1 || pipeline_desc.depth_stencil_format != format_d24_unorm_s8_uint() || !pipeline_desc.stencil_test_enable || pipeline_desc.stencil_front.reference != 3 as u32) {
        pipeline_layout.destroy();
        set.destroy();
        pool.destroy();
        set_layout.destroy();
        sampler.destroy();
        depth_texture.destroy();
        color_texture.destroy();
        buffer.destroy();
        device.destroy();
        adapter.destroy();
        instance.destroy();
        return 14;
    }

    let render_area = Rect2D.create(0, 0, 640, 480);
    var render_info = RenderingInfo.create(render_area)
        .addColorAttachment(RenderingAttachmentInfo.color(color_texture.clone(), 0.1, 0.2, 0.3, 1.0).setLoadOp(load_op_clear()).setStoreOp(store_op_store()))
        .setDepthAttachment(RenderingAttachmentInfo.depth(depth_texture.clone(), 1.0))
        .setStencilAttachment(RenderingAttachmentInfo.stencil(depth_texture.clone(), 0 as u32))
        .setLayerCount(1);
    if (!render_info.has_depth_attachment || !render_info.has_stencil_attachment || render_info.layer_count != 1) {
        render_info.color_attachments.destroy();
        pipeline_desc.shaders.destroy();
        pipeline_desc.vertex_bindings.destroy();
        pipeline_desc.vertex_attributes.destroy();
        pipeline_desc.color_blend_attachments.destroy();
        pipeline_desc.color_attachment_formats.destroy();
        pipeline_layout.destroy();
        set.destroy();
        pool.destroy();
        set_layout.destroy();
        sampler.destroy();
        depth_texture.destroy();
        color_texture.destroy();
        buffer.destroy();
        device.destroy();
        adapter.destroy();
        instance.destroy();
        return 15;
    }
    var region_list = Vec::<BufferImageCopy>.new();
    region_list.push(BufferImageCopy.fullColor2D(640, 480));

    pipeline_desc.shaders.destroy();
    pipeline_desc.vertex_bindings.destroy();
    pipeline_desc.vertex_attributes.destroy();
    pipeline_desc.color_blend_attachments.destroy();
    pipeline_desc.color_attachment_formats.destroy();
    pipeline_layout.destroy();
    set.destroy();
    pool.destroy();
    set_layout.destroy();
    sampler.destroy();
    depth_texture.destroy();
    color_texture.destroy();
    buffer.destroy();
    device.destroy();
    adapter.destroy();
    instance.destroy();
    render_info.color_attachments.destroy();
    region_list.destroy();
    return 0;
}
