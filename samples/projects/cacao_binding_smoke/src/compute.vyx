use std.cacao;
use std.collections;

class PushData {
    public value: u32;
}

fn main() -> i32 {
    let version = abiVersion();
    if (version == 0) { return 1; }

    let instance_desc = InstanceDesc.create(backend_vulkan(), "vyx-cacao-compute-binding-smoke", 1);
    var instance: Instance;
    match (Instance.create(instance_desc)) {
        case Ok(v) => { instance = v; }
        case Err(_) => { return 2; }
    }

    var adapter: Adapter;
    match (instance.firstAdapter()) {
        case Ok(v) => { adapter = v; }
        case Err(_) => { instance.destroy(); return 3; }
    }

    var device: Device;
    match (adapter.createDevice(DeviceDesc.createDefault())) {
        case Ok(v) => { device = v; }
        case Err(_) => { adapter.destroy(); instance.destroy(); return 4; }
    }

    var layout_desc = PipelineLayoutDesc.empty();
    layout_desc.addPushConstants(shader_stage_compute(), 0, sizeof::<PushData>() as u32);
    var layout: PipelineLayout;
    match (device.createPipelineLayout(layout_desc)) {
        case Ok(v) => { layout = v; }
        case Err(_) => { device.destroy(); adapter.destroy(); instance.destroy(); return 5; }
    }

    var compiler: ShaderCompiler;
    match (instance.createShaderCompiler()) {
        case Ok(v) => { compiler = v; }
        case Err(_) => { layout.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 6; }
    }

    let shader_desc = ShaderDesc { source_path: "src/compute_smoke.slang", entry_point: "Main", stage: shader_stage_compute(), profile: "cs_6_5" };
    var shader: ShaderModule;
    match (compiler.compileOrLoad(device.clone(), shader_desc)) {
        case Ok(v) => { shader = v; }
        case Err(_) => { compiler.destroy(); layout.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 7; }
    }

    var pipeline: ComputePipeline;
    match (device.createComputePipeline(ComputePipelineDesc.create(shader.clone(), layout.clone()))) {
        case Ok(v) => { pipeline = v; }
        case Err(_) => { shader.destroy(); compiler.destroy(); layout.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 8; }
    }

    var encoder: CommandEncoder;
    match (device.createCommandEncoder(command_compute())) {
        case Ok(v) => { encoder = v; }
        case Err(_) => { pipeline.destroy(); shader.destroy(); compiler.destroy(); layout.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 9; }
    }

    let indirect_args = BufferDesc.create(12, buffer_usage_indirect(), memory_cpu_to_gpu(), "compute-dispatch-indirect-args");
    var indirect: Buffer;
    match (device.createBuffer(indirect_args)) {
        case Ok(v) => { indirect = v; }
        case Err(_) => { encoder.destroy(); pipeline.destroy(); shader.destroy(); compiler.destroy(); layout.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 10; }
    }

    let push = PushData { value: 42 };
    match (encoder.begin(true, false)) {
        case Ok(_) => {}
        case Err(_) => { indirect.destroy(); encoder.destroy(); pipeline.destroy(); shader.destroy(); compiler.destroy(); layout.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 11; }
    }
    match (encoder.bindComputePipeline(pipeline.clone())) {
        case Ok(_) => {}
        case Err(_) => { indirect.destroy(); encoder.destroy(); pipeline.destroy(); shader.destroy(); compiler.destroy(); layout.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 12; }
    }
    match (encoder.bindComputeDescriptorSets(pipeline.clone(), 0, Vec::<DescriptorSet>.new())) {
        case Ok(_) => {}
        case Err(_) => { indirect.destroy(); encoder.destroy(); pipeline.destroy(); shader.destroy(); compiler.destroy(); layout.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 13; }
    }
    match (encoder.computePushConstants(pipeline.clone(), shader_stage_compute(), 0, push)) {
        case Ok(_) => {}
        case Err(_) => { indirect.destroy(); encoder.destroy(); pipeline.destroy(); shader.destroy(); compiler.destroy(); layout.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 14; }
    }
    match (encoder.dispatch(1, 1, 1)) {
        case Ok(_) => {}
        case Err(_) => { indirect.destroy(); encoder.destroy(); pipeline.destroy(); shader.destroy(); compiler.destroy(); layout.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 15; }
    }
    match (encoder.dispatchIndirect(indirect.clone(), 0)) {
        case Ok(_) => {}
        case Err(_) => { indirect.destroy(); encoder.destroy(); pipeline.destroy(); shader.destroy(); compiler.destroy(); layout.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 16; }
    }
    match (encoder.end()) {
        case Ok(_) => {}
        case Err(_) => { indirect.destroy(); encoder.destroy(); pipeline.destroy(); shader.destroy(); compiler.destroy(); layout.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 17; }
    }

    indirect.destroy();
    encoder.destroy();
    pipeline.destroy();
    shader.destroy();
    compiler.destroy();
    layout.destroy();
    device.destroy();
    adapter.destroy();
    instance.destroy();
    return 0;
}
