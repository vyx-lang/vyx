use std.cacao;
use std.collections;

class RtVertex {
    public px: f32;
    public py: f32;
    public pz: f32;
    public nx: f32;
    public ny: f32;
    public nz: f32;
}

fn main() -> i32 {
    let version = abiVersion();
    if (version == 0) { return 1; }

    let instance_desc = InstanceDesc.create(backend_d3d12(), "vyx-cacao-rt-binding-smoke", 1).addFeature(instance_feature_validation_layer());
    var instance: Instance;
    match (Instance.create(instance_desc)) {
        case Ok(v) => { instance = v; }
        case Err(_) => { return 2; }
    }

    var adapter: Adapter;
    match (instance.firstAdapter()) {
        case Ok(v) => { adapter = v; }
        case Err(_) => { instance.destroy(); return 3; }
    }

    var device_desc = DeviceDesc.createDefault();
    device_desc.addFeature(device_feature_ray_tracing_pipeline());
    device_desc.addFeature(device_feature_acceleration_structure());
    var device: Device;
    match (adapter.createDevice(device_desc)) {
        case Ok(v) => { device = v; }
        case Err(_) => { adapter.destroy(); instance.destroy(); return 4; }
    }

    let buffer_usage = buffer_usage_storage() | buffer_usage_shader_device_address() | buffer_usage_acceleration_structure();
    let vertex = RtVertex { px: 0.0, py: 0.0, pz: 0.0, nx: 0.0, ny: 1.0, nz: 0.0 };
    var vertex_buffer: Buffer;
    match (device.createBufferWithData(vertex, buffer_usage, memory_cpu_to_gpu(), "rt-smoke-vb")) {
        case Ok(v) => { vertex_buffer = v; }
        case Err(_) => { device.destroy(); adapter.destroy(); instance.destroy(); return 5; }
    }

    let index0: u32 = 0;
    var index_buffer: Buffer;
    match (device.createBufferWithData(index0, buffer_usage, memory_cpu_to_gpu(), "rt-smoke-ib")) {
        case Ok(v) => { index_buffer = v; }
        case Err(_) => { vertex_buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 6; }
    }

    var blas_desc = AccelerationStructureDesc.bottomLevel();
    blas_desc.addGeometry(AccelerationStructureGeometryDesc.triangles(vertex_buffer.clone(), sizeof::<RtVertex>() as u32, 1, format_rgb32_float(), index_buffer.clone(), 1, index_type_u32()));
    var blas: AccelerationStructure;
    match (device.createAccelerationStructure(blas_desc)) {
        case Ok(v) => { blas = v; }
        case Err(_) => { index_buffer.destroy(); vertex_buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 7; }
    }

    var blas_address: u64 = 0;
    match (blas.deviceAddress()) {
        case Ok(v) => { blas_address = v; }
        case Err(_) => { blas.destroy(); index_buffer.destroy(); vertex_buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 8; }
    }

    var tlas_desc = AccelerationStructureDesc.topLevel();
    tlas_desc.addInstance(AccelerationStructureInstance.identity(blas_address));
    var tlas: AccelerationStructure;
    match (device.createAccelerationStructure(tlas_desc)) {
        case Ok(v) => { tlas = v; }
        case Err(_) => { blas.destroy(); index_buffer.destroy(); vertex_buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 9; }
    }

    var set_layout_desc = DescriptorSetLayoutDesc.empty();
    set_layout_desc.addBinding(0, descriptor_acceleration_structure(), 1, shader_stage_all_ray_tracing());
    var set_layout: DescriptorSetLayout;
    match (device.createDescriptorSetLayout(set_layout_desc)) {
        case Ok(v) => { set_layout = v; }
        case Err(_) => { tlas.destroy(); blas.destroy(); index_buffer.destroy(); vertex_buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 10; }
    }

    var pool_desc = DescriptorPoolDesc.create(1);
    pool_desc.addSize(descriptor_acceleration_structure(), 1);
    var pool: DescriptorPool;
    match (device.createDescriptorPool(pool_desc)) {
        case Ok(v) => { pool = v; }
        case Err(_) => { set_layout.destroy(); tlas.destroy(); blas.destroy(); index_buffer.destroy(); vertex_buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 11; }
    }

    var set: DescriptorSet;
    match (pool.allocate(set_layout.clone())) {
        case Ok(v) => { set = v; }
        case Err(_) => { pool.destroy(); set_layout.destroy(); tlas.destroy(); blas.destroy(); index_buffer.destroy(); vertex_buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 12; }
    }
    match (set.writeAccelerationStructure(0, tlas.clone(), descriptor_acceleration_structure())) {
        case Ok(_) => {}
        case Err(_) => { set.destroy(); pool.destroy(); set_layout.destroy(); tlas.destroy(); blas.destroy(); index_buffer.destroy(); vertex_buffer.destroy(); device.destroy(); adapter.destroy(); instance.destroy(); return 13; }
    }

    set.destroy();
    pool.destroy();
    set_layout.destroy();
    tlas.destroy();
    blas.destroy();
    index_buffer.destroy();
    vertex_buffer.destroy();
    device.destroy();
    adapter.destroy();
    instance.destroy();
    return 0;
}
