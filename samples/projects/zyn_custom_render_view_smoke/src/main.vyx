use AppHost = Zyn.App.AppHost;
use AppRunOptions = Zyn.App.AppRunOptions;
use AppRuntime = Zyn.App.AppRuntime;
use AppSpec = Zyn.App.AppSpec;
use AppRendererSpec = Zyn.App.AppRendererSpec;
use AppWorld = Zyn.App.AppWorld;
use appDefaultFontPath = Zyn.App.appDefaultFontPath;
use Button = Zyn.App.Button;
use Column = Zyn.App.Column;
use CustomRenderView = Zyn.App.CustomRenderView;
use Scroll = Zyn.App.Scroll;
use Text = Zyn.App.Text;
use Renderer = Zyn.Nut.Renderer.Renderer;
use CustomRenderHandler = Zyn.Nut.CustomRender.CustomRenderHandler;
use Error = Zyn.Nut.Types.Error;
use Device = std.cacao.Device;
use CommandEncoder = std.cacao.CommandEncoder;
use ShaderCompiler = std.cacao.ShaderCompiler;
use Texture = std.cacao.Texture;
use Rect2D = std.cacao.Rect2D;
use RenderingInfo = std.cacao.RenderingInfo;
use RenderingAttachmentInfo = std.cacao.RenderingAttachmentInfo;
use ShaderDesc = std.cacao.ShaderDesc;
use ShaderModule = std.cacao.ShaderModule;
use PipelineLayout = std.cacao.PipelineLayout;
use PipelineLayoutDesc = std.cacao.PipelineLayoutDesc;
use GraphicsPipeline = std.cacao.GraphicsPipeline;
use GraphicsPipelineDesc = std.cacao.GraphicsPipelineDesc;
use Point = Zyn.Nut.Types.Point;
use std.args;
use std.fs;

class TriangleResources {
    public vertex_shader: ShaderModule;
    public fragment_shader: ShaderModule;
    public layout: PipelineLayout;
    public pipeline: GraphicsPipeline;

    public static fn create(device: &Device, compiler: &ShaderCompiler) -> Result<TriangleResources, Error> {
        var vertex_shader: ShaderModule;
        match (compiler.compileOrLoad(device, ShaderDesc { source_path: "assets/shaders/triangle.slang", entry_point: "mainVS", stage: shader_stage_vertex(), profile: "" })) {
            case Ok(v) => { vertex_shader = v; }
            case Err(e) => { return Err(Error.create(11, e.message)); }
        }
        var fragment_shader: ShaderModule;
        match (compiler.compileOrLoad(device, ShaderDesc { source_path: "assets/shaders/triangle.slang", entry_point: "mainPS", stage: shader_stage_fragment(), profile: "" })) {
            case Ok(v) => { fragment_shader = v; }
            case Err(e) => { vertex_shader.destroy(); return Err(Error.create(12, e.message)); }
        }
        var layout: PipelineLayout;
        match (device.createPipelineLayout(PipelineLayoutDesc.empty())) {
            case Ok(v) => { layout = v; }
            case Err(e) => { fragment_shader.destroy(); vertex_shader.destroy(); return Err(Error.create(13, e.message)); }
        }
        var desc = GraphicsPipelineDesc.create(&layout);
        desc = desc.addShader(&vertex_shader);
        desc = desc.addShader(&fragment_shader);
        desc = desc.setCullMode(cull_none());
        desc = desc.addColorAttachmentDefault();
        desc = desc.addColorFormat(format_rgba8_unorm());
        var pipeline: GraphicsPipeline;
        match (device.createGraphicsPipeline(desc)) {
            case Ok(v) => { pipeline = v; }
            case Err(e) => { layout.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); return Err(Error.create(14, e.message)); }
        }
        return Ok(TriangleResources { vertex_shader: vertex_shader, fragment_shader: fragment_shader, layout: layout, pipeline: pipeline });
    }

    public fn draw(&self, encoder: &mut CommandEncoder, output: &Texture, width: u32, height: u32) -> Result<i32, Error> {
        var info = RenderingInfo.create(Rect2D.create(0, 0, width, height));
        info = info.addColorAttachment(RenderingAttachmentInfo.color(output, 0.04, 0.07, 0.13, 1.0));
        match (encoder.beginRendering(&info)) {
            case Ok(_) => {}
            case Err(e) => { info.color_attachments.destroy(); return Err(Error.create(20, e.message)); }
        }
        var failure = Error.create(0, "");
        match (encoder.setViewport(0.0, 0.0, width as f32, height as f32, 0.0, 1.0)) {
            case Ok(_) => {}
            case Err(e) => { failure = Error.create(21, e.message); }
        }
        if (failure.code == 0) {
            match (encoder.setScissor(Rect2D.create(0, 0, width, height))) {
                case Ok(_) => {}
                case Err(e) => { failure = Error.create(22, e.message); }
            }
        }
        if (failure.code == 0) {
            match (encoder.bindGraphicsPipeline(&self.pipeline)) {
                case Ok(_) => {}
                case Err(e) => { failure = Error.create(23, e.message); }
            }
        }
        if (failure.code == 0) {
            match (encoder.draw(3 as u32, 1 as u32, 0 as u32, 0 as u32)) {
                case Ok(_) => {}
                case Err(e) => { failure = Error.create(25, e.message); }
            }
        }
        match (encoder.endRendering()) {
            case Ok(_) => {}
            case Err(e) => { if (failure.code == 0) { failure = Error.create(26, e.message); } }
        }
        info.color_attachments.destroy();
        if (failure.code != 0) { return Err(failure); }
        return Ok(0);
    }

    public fn destroy(&mut self) {
        self.pipeline.destroy();
        self.layout.destroy();
        self.fragment_shader.destroy();
        self.vertex_shader.destroy();
    }
}

class TriangleRenderHandler : CustomRenderHandler {
    public id: i32;
    public resources: Box<TriangleResources>;

    public static fn create(id: i32) -> TriangleRenderHandler {
        return TriangleRenderHandler { id: id, resources: Box { data: null } };
    }

    public fn render(&mut self, device: &Device, compiler: &ShaderCompiler, encoder: &mut CommandEncoder,
                     output: &Texture, width: u32, height: u32) -> Result<i32, Error> {
        if (self.resources.data == null) {
            match (TriangleResources.create(device, compiler)) {
                case Ok(v) => { self.resources = Box::<TriangleResources>.new(v); }
                case Err(e) => { return Err(e); }
            }
        }
        let resources = self.resources.deref();
        let result = resources.draw(encoder, output, width, height);
        if (self.id == 1) { writeFile("target/custom_render_1.txt", "triangle"); }
        if (self.id == 2) { writeFile("target/custom_render_2.txt", "triangle"); }
        return result;
    }

    public fn release(&mut self) {
        if (self.resources.data == null) { return; }
        var resources = self.resources.deref();
        resources.destroy();
        self.resources.drop();
    }
}

fn setupRenderer(renderer: &mut Renderer) -> i32 {
    match (renderer.registerCustomRender(1, Box::<dyn CustomRenderHandler>.new(TriangleRenderHandler.create(1)))) {
        case Ok(_) => {}
        case Err(e) => { return e.codeValue(); }
    }
    match (renderer.registerCustomRender(2, Box::<dyn CustomRenderHandler>.new(TriangleRenderHandler.create(2)))) {
        case Ok(_) => { return 0; }
        case Err(e) => { return e.codeValue(); }
    }
}

fn main() -> i32 {
    if (makeDir("target") != 0) { return 11; }
    deleteFile("target/custom_render_1.txt");
    deleteFile("target/custom_render_2.txt");
    let spec = AppSpec.create("Custom Render View", "dev.vyx.zyn.custom_render_view", 640, 720)
        .setRenderer(AppRendererSpec.create(640 as u32, 720 as u32).setFontPath(appDefaultFontPath()))
        .setRendererSetup(setupRenderer);
    let root = Column.create().id("root").alignStart()
        .child(Text.title("Embedded Cacao output"))
        .child(CustomRenderView.create("gpu.preview", 1).size(420.0, 150.0))
        .child(Button.filled("Continue").id("action").width(420.0).cornerRadius(0.0))
        .child(Scroll.create().id("gpu.scroll").size(220.0, 54.0).cornerRadius(0.0)
            .child(CustomRenderView.create("gpu.preview.small", 2).size(220.0, 90.0).onClick("preview.tap")));
    let world = AppWorld.create();
    var runtime = AppRuntime.create(root, world, spec.theme, 640.0, 720.0);
    var tree = runtime.toUiTree();
    let button_index = tree.find("action");
    let large_index = tree.find("gpu.preview");
    let small_index = tree.find("gpu.preview.small");
    let scroll_index = tree.find("gpu.scroll");
    if (button_index < 0 || large_index < 0 || small_index < 0 || scroll_index < 0) {
        tree.destroy(); runtime.destroy(); return 6;
    }
    let button_bounds = tree.nodeAt(button_index).bounds;
    if (tree.hitTest(Point.xy(button_bounds.x + 8.0, button_bounds.y + 8.0)) != button_index) {
        tree.destroy(); runtime.destroy(); return 7;
    }
    let scroll_bounds = tree.nodeAt(scroll_index).bounds;
    if (tree.hitTest(Point.xy(scroll_bounds.x + 8.0, scroll_bounds.y + 8.0)) != small_index) {
        tree.destroy(); runtime.destroy(); return 9;
    }
    if (tree.hitTest(Point.xy(scroll_bounds.x + 8.0, scroll_bounds.y + scroll_bounds.height + 8.0)) == small_index) {
        tree.destroy(); runtime.destroy(); return 10;
    }
    tree.destroy();
    runtime.destroy();
    var frames = 3;
    if (has_flag("--visible")) { frames = 100000; }
    match (AppHost.runRootWithOptions(spec, root, world, AppRunOptions.frames(frames))) {
        case Ok(report) => {
            if (report.rendered_frames < 1 || report.draw_commands < 1) { return 3; }
            if (readFile("target/custom_render_1.txt") != "triangle") { return 5; }
            if (readFile("target/custom_render_2.txt") != "triangle") { return 8; }
            print("zyn_custom_render_view_smoke OK");
            return 0;
        }
        case Err(e) => { print(e.message); return 4; }
    }
}
