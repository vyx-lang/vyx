use std.collections;
use Zyn.App;

class CountingComponent : Component {
    public name: string;
    public updates: i32;

    public fn id(&self) -> string { return self.name; }

    public fn configure(&self, world: AppWorld) -> AppWorld {
        return world.setStringResource("order", world.stringResource("order", "") + self.name);
    }

    public fn update(&mut self, event: AppEvent, world: AppWorld) -> AppWorld {
        self.updates = self.updates + 1;
        return world.setIntResource(self.name, self.updates);
    }

    public fn view(&self, world: AppWorld) -> View {
        return Text.body(self.name).id(self.name);
    }
}

fn main() -> i32 {
    var first = CountingComponent { name: "first", updates: 0 };
    var second = CountingComponent { name: "second", updates: 0 };
    var items = Vec::<dyn Component>.new();
    items.push(first);
    items.push(second);
    var components = Components.column("root").children(items);
    if (components.count() != 2) { return 1; }

    var world = AppWorld.create();
    world = components.configure(world);
    if (world.stringResource("order", "") != "firstsecond") { return 2; }
    world = components.update(AppEvent.frame(1 as u64, 0 as u64), world);
    world = components.update(AppEvent.frame(2 as u64, 0 as u64), world);
    if (world.intResource("first", 0) != 2 || world.intResource("second", 0) != 2) { return 3; }

    var host = ComponentHost.empty("scene");
    host = components.mountInto(host).finish();
    if (host.componentCount() != 2 || host.componentIdAt(0) != "first"
        || host.componentIdAt(1) != "second") { return 4; }
    var snapshot = host.viewAt(0);
    host.destroy();
    if (snapshot.nodeId("") != "first") { return 5; }
    snapshot.destroy();
    components.destroy();
    world.destroy();

    var editor = AppTextEditState.withText("Aé");
    editor = editor.backspace();
    if (editor.text != "A") { return 6; }
    editor = editor.undo();
    if (editor.text != "Aé") { return 7; }
    editor = editor.redo();
    if (editor.text != "A") { return 8; }
    editor = editor.insert("Z");
    if (editor.text != "AZ" || editor.caret != 2) { return 9; }
    editor.destroy();
    print("zyn_container_ownership_smoke: OK");
    return 0;
}
