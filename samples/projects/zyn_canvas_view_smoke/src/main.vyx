use AppAction = Zyn.App.AppAction;
use AppRuntime = Zyn.App.AppRuntime;
use AppWorld = Zyn.App.AppWorld;
use CanvasPointer = Zyn.App.CanvasPointer;
use CanvasView = Zyn.App.CanvasView;
use Column = Zyn.App.Column;
use View = Zyn.App.View;
use CustomView = Zyn.UI.CustomView;
use UiTheme = Zyn.UI.UiTheme;
use Color = Zyn.Nut.Types.Color;
use Point = Zyn.Nut.Types.Point;
use Rectangle = Zyn.Nut.Types.Rectangle;
use Paint = Zyn.Nut.Scene.Paint;
use SceneBuilder = Zyn.Nut.Scene.SceneBuilder;

class MeterView : CustomView {
    public fraction: f32;

    public static fn create(fraction: f32) -> MeterView {
        return MeterView { fraction: fraction };
    }

    public fn paint(&self, scene: SceneBuilder, bounds: Rectangle) -> SceneBuilder {
        return scene.drawRect(
            Rectangle.xywh(bounds.x, bounds.y, bounds.width * self.fraction, bounds.height),
            Paint.fill(Color.rgba(0.2, 0.7, 0.9, 1.0))
        );
    }

    public fn dup(&self) -> Box<dyn CustomView> {
        return Box::<dyn CustomView>.new(MeterView.create(self.fraction));
    }
}

fn recordPointer(action: AppAction, world: AppWorld) -> AppWorld {
    let pointer = CanvasPointer.fromAction(action);
    if (!pointer.valid) { return world; }
    return world.setIntResource("meter.local_x", pointer.x as i32);
}

fn recordClick(action: AppAction, world: AppWorld) -> AppWorld {
    let pointer = CanvasPointer.fromAction(action);
    if (!pointer.valid) { return world; }
    return world.setIntResource("meter.click_x", pointer.x as i32);
}

fn main() -> i32 {
    var root = Column.create().id("root").alignStart().child(
        CanvasView.create("meter", Box::<dyn CustomView>.new(MeterView.create(0.5)))
            .size(160.0, 80.0)
            .onPointerDown("meter.pointer")
            .onPointerDrag("meter.pointer")
            .onClick("meter.click")
            .accessibility("button", "Level meter", "")
    );
    var world = AppWorld.create()
        .registerBehavior("meter.pointer", recordPointer)
        .registerBehavior("meter.click", recordClick);
    var runtime = AppRuntime.create(root, world, UiTheme.dark(), 200.0, 120.0);
    root.destroy();
    world.destroy();

    var tree = runtime.toUiTree();
    let index = tree.find("meter");
    if (index < 0) { tree.destroy(); runtime.destroy(); return 1; }
    let bounds = tree.nodeAt(index).bounds;
    if (bounds.width != 160.0 || bounds.height != 80.0) {
        tree.destroy(); runtime.destroy(); return 8;
    }
    let point = Point.xy(bounds.x + 20.0, bounds.y + 20.0);
    if (tree.hitTest(point) != index) { tree.destroy(); runtime.destroy(); return 2; }
    if (tree.hitTest(Point.xy(bounds.x + bounds.width + 10.0, bounds.y + 20.0)) == index) {
        tree.destroy(); runtime.destroy(); return 9;
    }

    var scene = SceneBuilder.create();
    scene = tree.render(scene);
    if (scene.drawCommandCount() < 1) {
        scene.destroy(); tree.destroy(); runtime.destroy(); return 3;
    }
    scene.destroy();
    tree.destroy();

    runtime = runtime.queuePointerDown(point).runInteractionSystems().applyAllCommands();
    var snapshot = runtime.worldSnapshot();
    if (snapshot.intResource("meter.local_x", -1) != 20) {
        snapshot.destroy(); runtime.destroy(); return 4;
    }
    snapshot.destroy();

    runtime = runtime.queuePointerDragged(point, 2.0, 0.0).runInteractionSystems().applyAllCommands();
    snapshot = runtime.worldSnapshot();
    if (snapshot.intResource("meter.local_x", -1) != 20) {
        snapshot.destroy(); runtime.destroy(); return 5;
    }
    snapshot.destroy();
    runtime = runtime.handleTap(point).applyAllCommands();
    snapshot = runtime.worldSnapshot();
    if (snapshot.intResource("meter.click_x", -1) != 20) {
        snapshot.destroy(); runtime.destroy(); return 6;
    }
    snapshot.destroy();
    if (CanvasPointer.fromPayload("invalid").valid) { runtime.destroy(); return 7; }
    runtime.destroy();
    print("zyn_canvas_view_smoke OK");
    return 0;
}
