let SDL_INIT_VIDEO: u32 = 32;
let SDL_INIT_GAMEPAD: u32 = 8192;
let SDL_WINDOW_RESIZABLE: u64 = 32;
let SDL_WINDOW_MINIMIZED: u64 = 64;
let SDL_WINDOW_HIGH_PIXEL_DENSITY: u64 = 8192;
let SDL_WINDOW_VULKAN: u64 = 268435456;
let SDL_EVENT_QUIT: u32 = 256;
let SDL_EVENT_WINDOW_CLOSE_REQUESTED: u32 = 528;

let ST_APPLICATION_INFO: u32 = 0;
let ST_INSTANCE_CREATE_INFO: u32 = 1;
let ST_DEVICE_QUEUE_CREATE_INFO: u32 = 2;
let ST_DEVICE_CREATE_INFO: u32 = 3;
let ST_SUBMIT_INFO: u32 = 4;
let ST_COMMAND_BUFFER_BEGIN_INFO: u32 = 42;
let ST_RENDER_PASS_BEGIN_INFO: u32 = 43;
let ST_PRESENT_INFO_KHR: u32 = 1000001001;

let VK_API_VERSION_1_0: u32 = 4194304;
let VK_SUCCESS: i32 = 0;
let VK_SUBOPTIMAL_KHR: i32 = 1000001003;
let VK_ERROR_OUT_OF_DATE_KHR: i32 = -1000001004;
let VK_TRUE: u32 = 1;
let WAIT_NS_ONE_SEC: u64 = 1000000000;
let COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT: u32 = 1;
let PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT: u32 = 1024;
let SUBPASS_CONTENTS_INLINE: u32 = 0;
let VK_SAMPLE_COUNT_1_BIT: u32 = 1;

let VK_FORMAT_UNDEFINED: u32 = 0;
let FORMAT_B8G8R8A8_UNORM: u32 = 44;
let COLORSPACE_SRGB_NONLINEAR_KHR: u32 = 0;
let PRESENT_MODE_FIFO_KHR: u32 = 2;
let VK_ATTACHMENT_LOAD_OP_CLEAR: u32 = 1;
let VK_ATTACHMENT_LOAD_OP_DONT_CARE: u32 = 2;
let VK_ATTACHMENT_STORE_OP_STORE: u32 = 0;
let VK_ATTACHMENT_STORE_OP_DONT_CARE: u32 = 1;
let VK_IMAGE_LAYOUT_UNDEFINED: u32 = 0;
let VK_IMAGE_LAYOUT_PRESENT_SRC_KHR: u32 = 1000001002;

let IMGUI_WINDOW_FLAGS_NONE: i32 = 0;
let IMGUI_COLOR_EDIT_FLAGS_NONE: i32 = 0;

let WIN_W: i32 = 1280;
let WIN_H: i32 = 800;
let MIN_IMAGE_COUNT: u32 = 2;

var g_swapchain_dirty: bool = false;
var show_demo_window: bool = true;
var show_metrics: bool = true;

fn vk_check(label: string, rc: i32) -> bool {
    if (rc != VK_SUCCESS) {
        print("[sdl3_imgui_vulkan] Vulkan error ${label} rc=${rc}");
        return false;
    }
    return true;
}

fn color_wave01(frame: i32, offset: i32, period: i32) -> f32 {
    var x: i32 = (frame + offset) % period;
    if (x < 0) { x = x + period; }
    let half: i32 = period / 2;
    if (x <= half) { return (x as f32) / (half as f32); }
    return ((period - x) as f32) / (half as f32);
}

fn pulse01(x: f64) -> f32 {
    return ((sin(x) + 1.0) * 0.5) as f32;
}

fn null_vector() -> ImVectorRaw {
    return ImVectorRaw { Size: 0, Capacity: 0, Data: null };
}

fn null_pipeline_rendering_info() -> VkPipelineRenderingCreateInfoKHR {
    return VkPipelineRenderingCreateInfoKHR {
        sType: 0,
        pNext: null,
        viewMask: 0,
        colorAttachmentCount: 0,
        pColorAttachmentFormats: null,
        depthAttachmentFormat: 0,
        stencilAttachmentFormat: 0
    };
}

fn null_shader_module_create_info() -> VkShaderModuleCreateInfo {
    return VkShaderModuleCreateInfo {
        sType: 0,
        pNext: null,
        flags: 0,
        codeSize: 0,
        pCode: null
    };
}

fn null_pipeline_info() -> ImGuiVulkanPipelineInfo {
    return ImGuiVulkanPipelineInfo {
        RenderPass: null,
        Subpass: 0,
        MSAASamples: 0,
        ExtraDynamicStates: null_vector(),
        PipelineRenderingCreateInfo: null_pipeline_rendering_info(),
        SwapChainImageUsage: 0
    };
}

fn default_attachment_desc() -> VkAttachmentDescription {
    return VkAttachmentDescription {
        flags: 0,
        format: VK_FORMAT_UNDEFINED,
        samples: VK_SAMPLE_COUNT_1_BIT,
        loadOp: VK_ATTACHMENT_LOAD_OP_CLEAR,
        storeOp: VK_ATTACHMENT_STORE_OP_STORE,
        stencilLoadOp: VK_ATTACHMENT_LOAD_OP_DONT_CARE,
        stencilStoreOp: VK_ATTACHMENT_STORE_OP_DONT_CARE,
        initialLayout: VK_IMAGE_LAYOUT_UNDEFINED,
        finalLayout: VK_IMAGE_LAYOUT_PRESENT_SRC_KHR
    };
}

fn make_imgui_window(surface: rawptr) -> ImGuiVulkanWindow {
    return ImGuiVulkanWindow {
        UseDynamicRendering: 0,
        Surface: surface,
        SurfaceFormat: VkSurfaceFormatKHR { format: FORMAT_B8G8R8A8_UNORM, colorSpace: COLORSPACE_SRGB_NONLINEAR_KHR },
        PresentMode: PRESENT_MODE_FIFO_KHR,
        AttachmentDesc: default_attachment_desc(),
        ClearValue: VkClearValue { r: 0.10, g: 0.18, b: 0.30, a: 1.0 },
        Width: 0,
        Height: 0,
        Swapchain: null,
        RenderPass: null,
        FrameIndex: 0,
        ImageCount: 0,
        SemaphoreCount: 0,
        SemaphoreIndex: 0,
        Frames: null_vector(),
        FrameSemaphores: null_vector()
    };
}

fn create_sdl_window() -> rawptr {
    let flags = SDL_WINDOW_VULKAN | SDL_WINDOW_RESIZABLE | SDL_WINDOW_HIGH_PIXEL_DENSITY;
    let window = SDL_CreateWindow("Vyx . SDL3 + ImGui + Vulkan".c_str(), WIN_W, WIN_H, flags);
    if (window == null) {
        print("[sdl3_imgui_vulkan] SDL_CreateWindow failed");
        return null;
    }
    SDL_ShowWindow(window);
    return window;
}

fn create_instance_from_sdl() -> rawptr {
    var ext_count: u32 = 0;
    let ext_names = SDL_Vulkan_GetInstanceExtensions(to_rawptr(&ext_count));
    if (ext_names == null || ext_count == 0) {
        print("[sdl3_imgui_vulkan] SDL_Vulkan_GetInstanceExtensions failed");
        return null;
    }

    var ai = VkApplicationInfo {
        sType: ST_APPLICATION_INFO,
        pNext: null,
        pApplicationName: "VyxSDL3ImguiVulkan".c_str(),
        applicationVersion: 1,
        pEngineName: "VyxLan".c_str(),
        engineVersion: 1,
        apiVersion: VK_API_VERSION_1_0
    };

    var ici = VkInstanceCreateInfo {
        sType: ST_INSTANCE_CREATE_INFO,
        pNext: null,
        flags: 0,
        pApplicationInfo: to_rawptr(&ai),
        enabledLayerCount: 0,
        ppEnabledLayerNames: null,
        enabledExtensionCount: ext_count,
        ppEnabledExtensionNames: ext_names
    };

    var instance: rawptr = null;
    let rc = vkCreateInstance(to_rawptr(&ici), null, to_rawptr(&instance));
    if (!vk_check("vkCreateInstance", rc)) { return null; }
    return instance;
}

fn create_sdl_surface(window: rawptr, instance: rawptr) -> rawptr {
    var surface: rawptr = null;
    if (!SDL_Vulkan_CreateSurface(window, instance, null, to_rawptr(&surface))) {
        print("[sdl3_imgui_vulkan] SDL_Vulkan_CreateSurface failed");
        return null;
    }
    return surface;
}

fn pick_physical_device(instance: rawptr) -> rawptr {
    var count: u32 = 0;
    vkEnumeratePhysicalDevices(instance, to_rawptr(&count), null);
    if (count == 0) {
        print("[sdl3_imgui_vulkan] no Vulkan physical devices");
        return null;
    }
    if (count > 8) { count = 8; }
    var devices: [rawptr; 8];
    var i: i64 = 0;
    while (i < 8) {
        devices[i] = null;
        i = i + 1;
    }
    vkEnumeratePhysicalDevices(instance, to_rawptr(&count), to_rawptr(&devices));
    return devices[0];
}

fn find_graphics_present_family(phys: rawptr, surface: rawptr) -> i32 {
    var qf_count: u32 = 0;
    vkGetPhysicalDeviceQueueFamilyProperties(phys, to_rawptr(&qf_count), null);
    if (qf_count == 0) { return -1; }
    if (qf_count > 16) { qf_count = 16; }
    var qfp: [VkQueueFamilyProperties; 16];
    vkGetPhysicalDeviceQueueFamilyProperties(phys, to_rawptr(&qf_count), to_rawptr(&qfp));
    var i: i64 = 0;
    var found: i32 = -1;
    while ((i as u32) < qf_count && found < 0) {
        var present: u32 = 0;
        vkGetPhysicalDeviceSurfaceSupportKHR(phys, i as u32, surface, to_rawptr(&present));
        if ((qfp[i].queueFlags & 1) != 0 && present != 0) { found = i as i32; }
        i = i + 1;
    }
    return found;
}

fn create_logical_device(phys: rawptr, qfi: u32) -> rawptr {
    var prio: f32 = 1.0;
    var qci = VkDeviceQueueCreateInfo {
        sType: ST_DEVICE_QUEUE_CREATE_INFO,
        pNext: null,
        flags: 0,
        queueFamilyIndex: qfi,
        queueCount: 1,
        pQueuePriorities: to_rawptr(&prio)
    };

    var dev_exts: [rawptr; 1];
    dev_exts[0] = "VK_KHR_swapchain".c_str();

    var dci = VkDeviceCreateInfo {
        sType: ST_DEVICE_CREATE_INFO,
        pNext: null,
        flags: 0,
        queueCreateInfoCount: 1,
        pQueueCreateInfos: to_rawptr(&qci),
        enabledLayerCount: 0,
        ppEnabledLayerNames: null,
        enabledExtensionCount: 1,
        ppEnabledExtensionNames: to_rawptr(&dev_exts),
        pEnabledFeatures: null
    };

    var dev: rawptr = null;
    let rc = vkCreateDevice(phys, to_rawptr(&dci), null, to_rawptr(&dev));
    if (!vk_check("vkCreateDevice", rc)) { return null; }
    return dev;
}

fn choose_surface_format(phys: rawptr, surface: rawptr) -> VkSurfaceFormatKHR {
    var count: u32 = 0;
    if (!vk_check("vkGetPhysicalDeviceSurfaceFormatsKHR.count", vkGetPhysicalDeviceSurfaceFormatsKHR(phys, surface, to_rawptr(&count), null))) {
        return VkSurfaceFormatKHR { format: FORMAT_B8G8R8A8_UNORM, colorSpace: COLORSPACE_SRGB_NONLINEAR_KHR };
    }
    if (count == 0) {
        return VkSurfaceFormatKHR { format: FORMAT_B8G8R8A8_UNORM, colorSpace: COLORSPACE_SRGB_NONLINEAR_KHR };
    }
    if (count > 32) { count = 32; }
    var formats: [VkSurfaceFormatKHR; 32];
    if (!vk_check("vkGetPhysicalDeviceSurfaceFormatsKHR", vkGetPhysicalDeviceSurfaceFormatsKHR(phys, surface, to_rawptr(&count), to_rawptr(&formats)))) {
        return VkSurfaceFormatKHR { format: FORMAT_B8G8R8A8_UNORM, colorSpace: COLORSPACE_SRGB_NONLINEAR_KHR };
    }

    var chosen = formats[0];
    if (count == 1 && chosen.format == VK_FORMAT_UNDEFINED) {
        return VkSurfaceFormatKHR { format: FORMAT_B8G8R8A8_UNORM, colorSpace: COLORSPACE_SRGB_NONLINEAR_KHR };
    }

    var i: i64 = 0;
    var found: bool = false;
    while ((i as u32) < count && !found) {
        if (formats[i].format == FORMAT_B8G8R8A8_UNORM && formats[i].colorSpace == COLORSPACE_SRGB_NONLINEAR_KHR) {
            chosen = formats[i];
            found = true;
        }
        i = i + 1;
    }
    return chosen;
}

fn setup_imgui_window(wd: ImGuiVulkanWindow, instance: rawptr, phys: rawptr, dev: rawptr, surface: rawptr, qfi: u32, w: i32, h: i32) -> ImGuiVulkanWindow {
    wd.Surface = surface;
    wd.SurfaceFormat = choose_surface_format(phys, surface);
    wd.PresentMode = PRESENT_MODE_FIFO_KHR;
    if (wd.AttachmentDesc.samples == 0) {
        wd.AttachmentDesc = default_attachment_desc();
    }
    ImGui_ImplVulkanH_CreateOrResizeWindow(instance, phys, dev, to_rawptr(&wd), qfi, null, w, h, MIN_IMAGE_COUNT, 0);
    return wd;
}

fn setup_imgui_renderer(window: rawptr, instance: rawptr, phys: rawptr, dev: rawptr, queue: rawptr, qfi: u32, wd: ImGuiVulkanWindow) -> bool {
    igCreateContext(null);
    igStyleColorsDark(null);
    if (!ImGui_ImplSDL3_InitForVulkan(window)) {
        print("[sdl3_imgui_vulkan] ImGui_ImplSDL3_InitForVulkan failed");
        igDestroyContext(null);
        return false;
    }

    var info = ImGuiVulkanInitInfo {
        ApiVersion: VK_API_VERSION_1_0,
        Instance: instance,
        PhysicalDevice: phys,
        Device: dev,
        QueueFamily: qfi,
        Queue: queue,
        DescriptorPool: null,
        DescriptorPoolSize: 16,
        MinImageCount: MIN_IMAGE_COUNT,
        ImageCount: wd.ImageCount,
        PipelineCache: null,
        PipelineInfoMain: null_pipeline_info(),
        PipelineInfoForViewports: null_pipeline_info(),
        UseDynamicRendering: 0,
        Allocator: null,
        CheckVkResultFn: null,
        MinAllocationSize: 0,
        CustomShaderVertCreateInfo: null_shader_module_create_info(),
        CustomShaderFragCreateInfo: null_shader_module_create_info()
    };
    info.PipelineInfoMain.RenderPass = wd.RenderPass;
    info.PipelineInfoMain.Subpass = 0;
    info.PipelineInfoMain.MSAASamples = VK_SAMPLE_COUNT_1_BIT;

    let ok = ImGui_ImplVulkan_Init(to_rawptr(&info));
    if (!ok) {
        print("[sdl3_imgui_vulkan] ImGui_ImplVulkan_Init failed");
        ImGui_ImplSDL3_Shutdown();
        igDestroyContext(null);
    }
    return ok;
}

fn load_frame(wd: ImGuiVulkanWindow, index: u32) -> ImGuiVulkanFrame {
    var frame: ImGuiVulkanFrame;
    let stride = sizeof::<ImGuiVulkanFrame>();
    let ptr = wd.Frames.Data + ((index as i32) * (stride as i32));
    memcpy(to_rawptr(&frame), ptr, stride as u64);
    return frame;
}

fn load_frame_semaphores(wd: ImGuiVulkanWindow, index: u32) -> ImGuiVulkanFrameSemaphores {
    var sem: ImGuiVulkanFrameSemaphores;
    let stride = sizeof::<ImGuiVulkanFrameSemaphores>();
    let ptr = wd.FrameSemaphores.Data + ((index as i32) * (stride as i32));
    memcpy(to_rawptr(&sem), ptr, stride as u64);
    return sem;
}

fn render_imgui_frame(dev: rawptr, queue: rawptr, wd: ImGuiVulkanWindow, draw_data: rawptr) -> RenderResult {
    let sem = load_frame_semaphores(wd, wd.SemaphoreIndex);
    var image_index: u32 = 0;
    let acquire_rc = vkAcquireNextImageKHR(dev, wd.Swapchain, WAIT_NS_ONE_SEC, sem.ImageAcquiredSemaphore, null, to_rawptr(&image_index));
    if (acquire_rc == VK_ERROR_OUT_OF_DATE_KHR || acquire_rc == VK_SUBOPTIMAL_KHR) {
        g_swapchain_dirty = true;
        return RenderResult { ok: true, window: wd };
    }
    if (!vk_check("vkAcquireNextImageKHR", acquire_rc)) {
        return RenderResult { ok: false, window: wd };
    }
    wd.FrameIndex = image_index;

    let fd = load_frame(wd, image_index);
    var fence_arr: [rawptr; 1];
    fence_arr[0] = fd.Fence;
    if (!vk_check("vkWaitForFences", vkWaitForFences(dev, 1, to_rawptr(&fence_arr), VK_TRUE, WAIT_NS_ONE_SEC))) {
        return RenderResult { ok: false, window: wd };
    }
    if (!vk_check("vkResetFences", vkResetFences(dev, 1, to_rawptr(&fence_arr)))) {
        return RenderResult { ok: false, window: wd };
    }
    if (!vk_check("vkResetCommandPool", vkResetCommandPool(dev, fd.CommandPool, 0))) {
        return RenderResult { ok: false, window: wd };
    }

    var begin = VkCommandBufferBeginInfo {
        sType: ST_COMMAND_BUFFER_BEGIN_INFO,
        pNext: null,
        flags: COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT,
        pInheritanceInfo: null
    };
    if (!vk_check("vkBeginCommandBuffer", vkBeginCommandBuffer(fd.CommandBuffer, to_rawptr(&begin)))) {
        return RenderResult { ok: false, window: wd };
    }

    var rp = VkRenderPassBeginInfo {
        sType: ST_RENDER_PASS_BEGIN_INFO,
        pNext: null,
        renderPass: wd.RenderPass,
        framebuffer: fd.Framebuffer,
        renderArea: VkRect2D {
            offset: VkOffset2D { x: 0, y: 0 },
            extent: VkExtent2D { width: wd.Width as u32, height: wd.Height as u32 }
        },
        clearValueCount: 1,
        pClearValues: to_rawptr(&wd.ClearValue)
    };
    vkCmdBeginRenderPass(fd.CommandBuffer, to_rawptr(&rp), SUBPASS_CONTENTS_INLINE);
    ImGui_ImplVulkan_RenderDrawData(draw_data, fd.CommandBuffer, null);
    vkCmdEndRenderPass(fd.CommandBuffer);

    if (!vk_check("vkEndCommandBuffer", vkEndCommandBuffer(fd.CommandBuffer))) {
        return RenderResult { ok: false, window: wd };
    }

    var wait_stage: u32 = PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
    var wait_arr: [rawptr; 1];
    wait_arr[0] = sem.ImageAcquiredSemaphore;
    var sig_arr: [rawptr; 1];
    sig_arr[0] = sem.RenderCompleteSemaphore;
    var cb_arr: [rawptr; 1];
    cb_arr[0] = fd.CommandBuffer;

    var submit = VkSubmitInfo {
        sType: ST_SUBMIT_INFO,
        pNext: null,
        waitSemaphoreCount: 1,
        pWaitSemaphores: to_rawptr(&wait_arr),
        pWaitDstStageMask: to_rawptr(&wait_stage),
        commandBufferCount: 1,
        pCommandBuffers: to_rawptr(&cb_arr),
        signalSemaphoreCount: 1,
        pSignalSemaphores: to_rawptr(&sig_arr)
    };
    if (!vk_check("vkQueueSubmit", vkQueueSubmit(queue, 1, to_rawptr(&submit), fd.Fence))) {
        return RenderResult { ok: false, window: wd };
    }

    var swap_arr: [rawptr; 1];
    swap_arr[0] = wd.Swapchain;
    var present = VkPresentInfoKHR {
        sType: ST_PRESENT_INFO_KHR,
        pNext: null,
        waitSemaphoreCount: 1,
        pWaitSemaphores: to_rawptr(&sig_arr),
        swapchainCount: 1,
        pSwapchains: to_rawptr(&swap_arr),
        pImageIndices: to_rawptr(&image_index),
        pResults: null
    };
    let prc = vkQueuePresentKHR(queue, to_rawptr(&present));
    if (prc == VK_ERROR_OUT_OF_DATE_KHR || prc == VK_SUBOPTIMAL_KHR) {
        g_swapchain_dirty = true;
        return RenderResult { ok: true, window: wd };
    }
    if (!vk_check("vkQueuePresentKHR", prc)) {
        return RenderResult { ok: false, window: wd };
    }

    if (wd.SemaphoreCount > 0) {
        wd.SemaphoreIndex = (wd.SemaphoreIndex + 1) % wd.SemaphoreCount;
    }
    return RenderResult { ok: true, window: wd };
}

fn poll_sdl_events(window: rawptr) -> bool {
    var event: SdlEvent;
    var alive: bool = true;
    while (SDL_PollEvent(to_rawptr(&event))) {
        ImGui_ImplSDL3_ProcessEvent(to_rawptr(&event));
        if (event.kind == SDL_EVENT_QUIT) {
            alive = false;
        }
        if (event.kind == SDL_EVENT_WINDOW_CLOSE_REQUESTED && SDL_GetWindowFromEvent(to_rawptr(&event)) == window) {
            alive = false;
        }
    }
    return alive;
}

fn read_window_size(window: rawptr, w: rawptr, h: rawptr) -> bool {
    if (!SDL_GetWindowSize(window, w, h)) {
        print("[sdl3_imgui_vulkan] SDL_GetWindowSize failed");
        return false;
    }
    return true;
}

fn rebuild_swapchain_if_needed(window: rawptr, instance: rawptr, phys: rawptr, dev: rawptr, surface: rawptr, qfi: u32, wd: ImGuiVulkanWindow) -> RenderResult {
    var w: i32 = 0;
    var h: i32 = 0;
    if (!read_window_size(window, to_rawptr(&w), to_rawptr(&h))) {
        return RenderResult { ok: false, window: wd };
    }
    if (w <= 0 || h <= 0) {
        return RenderResult { ok: true, window: wd };
    }
    if (g_swapchain_dirty || wd.Width != w || wd.Height != h) {
        vkDeviceWaitIdle(dev);
        ImGui_ImplVulkan_SetMinImageCount(MIN_IMAGE_COUNT);
        wd = setup_imgui_window(wd, instance, phys, dev, surface, qfi, w, h);
        wd.FrameIndex = 0;
        g_swapchain_dirty = false;
    }
    return RenderResult { ok: true, window: wd };
}

fn update_clear_color(frame: i32) -> VkClearValue {
    let t = (frame as f64) * 0.035;
    return VkClearValue {
        r: 0.10 as f32 + 0.70 as f32 * pulse01(t),
        g: 0.16 as f32 + 0.55 as f32 * pulse01(t + 2.09439510239),
        b: 0.20 as f32 + 0.70 as f32 * pulse01(t + 4.18879020479),
        a: 1.0
    };
}

fn draw_vyx_ui(frame: i32, width: i32, height: i32, slider_ptr: rawptr, color_ptr: rawptr) {
    if (show_demo_window) {
        igShowDemoWindow(to_rawptr(&show_demo_window));
    }

    igBegin("Vyx SDL3 + Vulkan".c_str(), null, IMGUI_WINDOW_FLAGS_NONE);
    igText("Vyx owns the app object; SDL3 and Vulkan sit behind a thin Vyx facade.".c_str());
    igText("std.math drives the color pulse; drop() owns cleanup.".c_str());
    igText("Frame %d   framebuffer %d x %d".c_str(), frame, width, height);
    igSeparator();
    igCheckbox("Show Dear ImGui demo".c_str(), to_rawptr(&show_demo_window));
    igCheckbox("Show runtime metrics".c_str(), to_rawptr(&show_metrics));
    igSliderFloat("Vyx slider".c_str(), slider_ptr, 0.0 as f32, 1.0 as f32, "%.3f".c_str(), 0);
    igColorEdit4("Animated clear color".c_str(), color_ptr, IMGUI_COLOR_EDIT_FLAGS_NONE);
    if (show_metrics) {
        let fps: f64 = 60.0;
        var slider_value_copy: f32 = 0.0;
        memcpy(to_rawptr(&slider_value_copy), slider_ptr, 4);
        igText("slider=%.3f target_fps=%.1f".c_str(), slider_value_copy as f64, fps);
    }
    igSameLine(0.0 as f32, 12.0 as f32);
    igText("Vyx varargs FFI: %d %.2f".c_str(), 42, 3.14159);
    igEnd();
}

class Sdl3VulkanApp {
    window: rawptr;
    instance: rawptr;
    surface: rawptr;
    phys: rawptr;
    dev: rawptr;
    queue: rawptr;
    qfi: u32;
    wd: ImGuiVulkanWindow;
    frame: i32;
    slider_value: f32;
    clear_color: VkClearValue;
    renderer_ready: bool;

    public static fn create() -> Result<Sdl3VulkanApp, i32> {
        var app = Sdl3VulkanApp {
            window: null,
            instance: null,
            surface: null,
            phys: null,
            dev: null,
            queue: null,
            qfi: 0,
            wd: make_imgui_window(null),
            frame: 0,
            slider_value: 0.35,
            clear_color: VkClearValue { r: 0.10, g: 0.18, b: 0.30, a: 1.0 },
            renderer_ready: false
        };
        let init_code = app.init();
        if (init_code != 0) {
            return Err(init_code);
        }
        return Ok(app);
    }

    public fn init() -> i32 {
        if (!SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMEPAD)) {
            print("[sdl3_imgui_vulkan] SDL_Init failed");
            return 10;
        }

        self.window = create_sdl_window();
        if (self.window == null) {
            return 11;
        }

        self.instance = create_instance_from_sdl();
        if (self.instance == null) {
            return 12;
        }

        self.surface = create_sdl_surface(self.window, self.instance);
        if (self.surface == null) {
            return 13;
        }

        self.phys = pick_physical_device(self.instance);
        if (self.phys == null) {
            return 14;
        }

        let qfi_i = find_graphics_present_family(self.phys, self.surface);
        if (qfi_i < 0) {
            print("[sdl3_imgui_vulkan] no graphics+present queue family");
            return 15;
        }
        self.qfi = qfi_i as u32;

        self.dev = create_logical_device(self.phys, self.qfi);
        if (self.dev == null) {
            return 16;
        }

        vkGetDeviceQueue(self.dev, self.qfi, 0, to_rawptr(&self.queue));

        var initial_w: i32 = WIN_W;
        var initial_h: i32 = WIN_H;
        read_window_size(self.window, to_rawptr(&initial_w), to_rawptr(&initial_h));

        self.wd = make_imgui_window(self.surface);
        self.wd = setup_imgui_window(self.wd,
                                     self.instance,
                                     self.phys,
                                     self.dev,
                                     self.surface,
                                     self.qfi,
                                     initial_w,
                                     initial_h);
        if (!setup_imgui_renderer(self.window,
                                  self.instance,
                                  self.phys,
                                  self.dev,
                                  self.queue,
                                  self.qfi,
                                  self.wd)) {
            return 17;
        }

        self.renderer_ready = true;
        return 0;
    }

    public fn run() -> i32 {
        var alive: bool = true;
        while (alive) {
            if (!poll_sdl_events(self.window)) { alive = false; }

            if (alive && (SDL_GetWindowFlags(self.window) & SDL_WINDOW_MINIMIZED) != 0) {
                SDL_Delay(10);
            } else if (alive) {
                let rebuild = rebuild_swapchain_if_needed(self.window,
                                                           self.instance,
                                                           self.phys,
                                                           self.dev,
                                                           self.surface,
                                                           self.qfi,
                                                           self.wd);
                self.wd = rebuild.window;
                if (!rebuild.ok) {
                    alive = false;
                } else {
                    self.clear_color = update_clear_color(self.frame);
                    self.wd.ClearValue = self.clear_color;
                    ImGui_ImplVulkan_NewFrame();
                    ImGui_ImplSDL3_NewFrame();
                    igNewFrame();
                    draw_vyx_ui(self.frame,
                                self.wd.Width,
                                self.wd.Height,
                                to_rawptr(&self.slider_value),
                                to_rawptr(&self.clear_color));
                    igRender();

                    let rendered = render_imgui_frame(self.dev, self.queue, self.wd, igGetDrawData());
                    self.wd = rendered.window;
                    if (!rendered.ok) {
                        alive = false;
                    }
                    self.frame = self.frame + 1;
                }
            }
        }

        return 0;
    }

    public fn drop() {
        if (self.renderer_ready) {
            vkDeviceWaitIdle(self.dev);
            ImGui_ImplVulkan_Shutdown();
            ImGui_ImplSDL3_Shutdown();
            igDestroyContext(null);
            self.renderer_ready = false;
        }
        if (self.instance != null && self.dev != null) {
            ImGui_ImplVulkanH_DestroyWindow(self.instance, self.dev, to_rawptr(&self.wd), null);
        }
        if (self.dev != null) {
            vkDestroyDevice(self.dev, null);
            self.dev = null;
        }
        if (self.instance != null && self.surface != null) {
            SDL_Vulkan_DestroySurface(self.instance, self.surface, null);
            self.surface = null;
        }
        if (self.instance != null) {
            vkDestroyInstance(self.instance, null);
            self.instance = null;
        }
        if (self.window != null) {
            SDL_DestroyWindow(self.window);
            self.window = null;
        }
        SDL_Quit();
    }
}

fn main() -> i32 {
    match (Sdl3VulkanApp.create()) {
        case Ok(app) => { return app.run(); }
        case Err(code) => { return code; }
    }
}
