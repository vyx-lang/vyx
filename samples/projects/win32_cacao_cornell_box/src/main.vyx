            match (swapchain.present(&graphics_queue, &sync, FRAME_INDEX)) { case Ok(_) => {} case Err(e) => { back_buffer.destroy(); return fail_cacao(window, 64, e); } }
            match (graphics_queue.waitIdle()) { case Ok(_) => {} case Err(_) => {} }

            back_buffer.destroy();
            total_frames = total_frames + 1;
            }
        }
    }
    set.destroy();
    pool.destroy();
    camera_buffer.destroy();
    output_view.destroy();
    output_texture.destroy();
    sbt.destroy();
    rt_pipeline.destroy();
    pipeline_layout.destroy();
    set_layout.destroy();
    closest_hit_shader.destroy();
    miss_shader.destroy();
    ray_gen_shader.destroy();
    compiler.destroy();
    tlas.destroy();
    blas.destroy();
    color_buffer.destroy();
    index_buffer.destroy();
    vertex_buffer.destroy();
    geometry.destroy();
    build_cmd.destroy();
    cmd.destroy();
    sync.destroy();
    swapchain.destroy();
    graphics_queue.destroy();
