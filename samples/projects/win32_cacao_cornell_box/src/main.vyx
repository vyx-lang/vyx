        if (running) {
            if ((SDL_GetWindowFlags(window) & SDL_WINDOW_MINIMIZED) != 0) {
                SDL_Delay(10);
            } else {
            match (sync.waitForFrame(FRAME_INDEX)) { case Ok(_) => {} case Err(e) => { return fail_cacao(window, 50, e); } }
