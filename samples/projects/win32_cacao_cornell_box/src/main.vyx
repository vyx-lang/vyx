            post_barriers.push(TextureBarrier.fullColor(&output_texture, resource_copy_source(), resource_unordered_access()));
            post_barriers.push(TextureBarrier.fullColor(&back_buffer, resource_copy_dest(), resource_present()));
            match (cmd.pipelineBarrierTextures(sync_scope_all_commands(), sync_scope_all_commands(), post_barriers)) {
                case Ok(_) => {}
                case Err(e) => { back_buffer.destroy(); return fail_cacao(window, 61, e); }
            }
            match (cmd.end()) { case Ok(_) => {} case Err(e) => { back_buffer.destroy(); return fail_cacao(window, 62, e); } }

