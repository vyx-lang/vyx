    match (set.writeBufferElement(3, &vertex_buffer, 0, sizeof::<Vertex>() as u64, (geometry.vertices.len * sizeof::<Vertex>()) as u64, descriptor_storage_buffer(), 0)) { case Ok(_) => {} case Err(e) => { return fail_cacao(window, 48, e); } }
