        case Err(e) => { set_layout.destroy(); closest_hit_shader.destroy(); miss_shader.destroy(); ray_gen_shader.destroy(); compiler.destroy(); tlas.destroy(); blas.destroy(); color_buffer.destroy(); index_buffer.destroy(); vertex_buffer.destroy(); geometry.destroy(); build_cmd.destroy(); cmd.destroy(); sync.destroy(); swapchain.destroy(); graphics_queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return fail_cacao(window, 34, e); }
