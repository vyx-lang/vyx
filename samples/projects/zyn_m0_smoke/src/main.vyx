// M0 acceptance: the interaction and runtime closed loop that every later
// component depends on. Every assertion drives AppRuntime the way the host does
// and inspects the resulting world, so a regression fails without a window.
//
//   ZC-01  one keyboard/pointer/touch route with a single set of focus rules
//   ZC-02  focus scopes and overlay layers
//   ZC-03  scroll offset closed loop
//   ZC-04  change set drives local rebuilds
//   ZC-05  semantic tree and the platform bridge boundary
//   ZC-06  effect boundary: cancel, timeout, bounded commit
use App = Zyn.App.App;
use AppAction = Zyn.App.AppAction;
use AppKeyShortcut = Zyn.App.AppKeyShortcut;
use AppLayer = Zyn.App.AppLayer;
use AppInteractionEvent = Zyn.App.AppInteractionEvent;
use AppRuntime = Zyn.App.AppRuntime;
use AppWorld = Zyn.App.AppWorld;
use Button = Zyn.App.Button;
use Column = Zyn.App.Column;
use ListView = Zyn.App.ListView;
use Md3Dialog = Zyn.App.MD3.Md3Dialog;
use StatelessComponent = Zyn.App.StatelessComponent;
use TextField = Zyn.App.TextField;
use UiTheme = Zyn.UI.UiTheme;
use View = Zyn.App.View;
use KeyCode = Zyn.Platform.Input.KeyCode;
use KeyModifier = Zyn.Platform.Input.KeyModifier;
use std.collections;

fn m0EffectBehavior(action: AppAction, world: AppWorld) -> AppWorld {
    if (action.name == "effect.kb.done") {
        return world.incrementIntResource("kb.effects.done", 1);
    }
    return world;
}

class M0Component : StatelessComponent {
    public static fn create() -> M0Component {
        return M0Component { component_id: "kb" };
    }

    public fn configure(world: AppWorld) -> AppWorld {
        var out = world
            .setStringResource("kb.input", "")
            .setIntResource("kb.adds", 0)
            .setIntResource("kb.capture.count", 0)
            .setIntResource("kb.bubble.count", 0)
            .setIntResource("kb.shortcut.hits", 0)
            .setIntResource("kb.effects.done", 0)
            .setBoolResource("kb.secondary", true)
            .setBoolResource("kb.dialog", false)
            .setStringResource("kb.error", "")
            .setFloatResource("kb.scroll", 0.0)
            .registerStringSetCommand("kb.input.set", "kb.input")
            .registerIntDeltaCommand("kb.add", "kb.adds", 1)
            .registerIntDeltaCommand("kb.capture", "kb.capture.count", 1)
            .registerIntDeltaCommand("kb.bubble", "kb.bubble.count", 1)
            .registerIntDeltaCommand("kb.shortcut", "kb.shortcut.hits", 1)
            .registerBehaviorPrefix("effect.", m0EffectBehavior)
            .registerKeyShortcut(AppKeyShortcut.create(KeyCode.enter(), KeyModifier.ctrl(), "kb.shortcut"));
        out = out.appendStringListResource("kb.items", "Alpha")
            .appendBoolListResource("kb.items:checked", false);
        out = out.appendStringListResource("kb.items", "Beta")
            .appendBoolListResource("kb.items:checked", false);
        out = out.appendStringListResource("kb.items", "Gamma")
            .appendBoolListResource("kb.items:checked", false);
        return out;
    }

    public fn view(world: AppWorld) -> View {
        var content = Column.create()
            .gap(10.0)
            .child(TextField.bound("kb.input", "Task", "kb.input", "kb.input.set").height(48.0))
            .child(Button.filledAction("kb.add.button", "Add", "kb.add")
                .height(44.0)
                .captureAction("kb.capture")
                .bubbleAction("kb.bubble"));
        if (world.boolResource("kb.secondary", true)) {
            content = content.child(Button.filledAction("kb.remove.button", "Remove", "kb.add").height(44.0));
        }
        content = content.child(Button.filledAction("kb.tail.button", "Tail", "kb.add").height(44.0));
        content = content.child(ListView.bound("kb.list", "kb.items", "kb.items:checked", "kb.toggle.")
            .height(120.0)
            .itemHeight(40.0)
            .scrollOffset("kb.scroll", 400.0));
        if (world.boolResource("kb.dialog", false)) {
            var actions = Vec::<View>.new();
            actions.push(Button.outlinedAction("kb.dialog.cancel", "Cancel", "kb.cancel"));
            actions.push(Button.filledAction("kb.dialog.ok", "OK", "kb.confirm"));
            content = content.child(Md3Dialog.modal("kb.dialog.panel", "kb.dialog", "Confirm", "Proceed?", actions));
            actions.destroy();
        }
        return content;
    }
}

// Mirrors what the session does before handling a key: the focus order is
// re-derived from the live tree, then the key enters the shared route.
fn prime(runtime: AppRuntime) -> AppRuntime {
    var tree = runtime.toUiTree();
    var out = runtime.syncFocusOrderFromTree(tree);
    tree.destroy();
    return out;
}

fn press(runtime: AppRuntime, key: i32, modifiers: u32) -> AppRuntime {
    var out = prime(runtime);
    out = out.queueKeyDown(key, modifiers, false);
    out = out.runInteractionSystems();
    return out.applyAllCommands();
}

fn rebuild(runtime: AppRuntime, component: M0Component) -> AppRuntime {
    var world = runtime.worldSnapshot();
    var root = component.view(world);
    var out = runtime.replaceRoot(root);
    root.destroy();
    world.destroy();
    return out;
}

fn hideSecondary(runtime: AppRuntime, component: M0Component) -> AppRuntime {
    return rebuild(runtime.setBoolResource("kb.secondary", false), component);
}

fn openDialog(runtime: AppRuntime, component: M0Component) -> AppRuntime {
    var out = runtime.setBoolResource("kb.dialog", true);
    // Opening the layer first captures the focus that must be restored later.
    out = out.openLayer(AppLayer.dialog("kb.dialog"));
    return rebuild(out, component);
}

// Wheel input, injected on the same route the pointer would produce.
fn wheel(runtime: AppRuntime, route: string, dy: f32) -> AppRuntime {
    var out = runtime.queueInteractionEvent(
        AppInteractionEvent.pointerScrolled("kb.list", "", 0.0, 0.0, 0.0, dy, 0 as u64).withRoute(route)
    );
    out = out.runInteractionSystems();
    return out.applyAllCommands();
}

fn tabSequence(runtime: AppRuntime, steps: i32) -> Vec<string> {
    var out = runtime;
    var seen = Vec::<string>.new();
    var i: i32 = 0;
    while (i < steps) {
        out = press(out, KeyCode.tab(), 0 as u32);
        seen.push(out.focusedId());
        i = i + 1;
    }
    return seen;
}

fn containsId(ids: Vec<string>, id: string) -> bool {
    var i: i32 = 0;
    while (i < (ids.len as i32)) {
        if (ids.get(i as i64) == id) { return true; }
        i = i + 1;
    }
    return false;
}

fn zc01KeyboardRouting(component: M0Component, runtime: AppRuntime) -> i32 {
    var rt = runtime;

    // nothing is focused before the first interaction
    if (rt.focusedId() != "") { return 1; }

    // Tab walks the focus order in tree order
    rt = press(rt, KeyCode.tab(), 0 as u32);
    if (rt.focusedId() != "kb.input") { return 2; }
    rt = press(rt, KeyCode.tab(), 0 as u32);
    if (rt.focusedId() != "kb.add.button") { return 3; }

    // Shift+Tab walks backwards
    rt = press(rt, KeyCode.tab(), KeyModifier.shift());
    if (rt.focusedId() != "kb.input") { return 4; }

    // an unbound key neither fires an action nor moves focus
    rt = press(rt, 65, 0 as u32);
    if (rt.intResource("kb.adds", -1) != 0) { return 5; }
    if (rt.focusedId() != "kb.input") { return 6; }

    // Enter activates the focused button exactly once per press
    rt = press(rt, KeyCode.tab(), 0 as u32);
    let cap_before = rt.intResource("kb.capture.count", -1);
    let bub_before = rt.intResource("kb.bubble.count", -1);
    rt = press(rt, KeyCode.enter(), 0 as u32);
    if (rt.intResource("kb.adds", -1) != 1) { return 7; }
    if (rt.intResource("kb.capture.count", -1) != cap_before + 1) { return 9; }
    if (rt.intResource("kb.bubble.count", -1) != bub_before + 1) { return 10; }
    rt = press(rt, KeyCode.enter(), 0 as u32);
    if (rt.intResource("kb.adds", -1) != 2) { return 8; }

    // Space is equivalent to Enter
    rt = press(rt, KeyCode.space(), 0 as u32);
    if (rt.intResource("kb.adds", -1) != 3) { return 11; }

    // arrow keys move focus
    rt = press(rt, KeyCode.down(), 0 as u32);
    if (rt.focusedId() != "kb.remove.button") { return 12; }
    rt = press(rt, KeyCode.up(), 0 as u32);
    if (rt.focusedId() != "kb.add.button") { return 13; }

    // a focused text field keeps Enter for editing instead of activating
    rt = press(rt, KeyCode.tab(), KeyModifier.shift());
    if (rt.focusedId() != "kb.input") { return 14; }
    rt = press(rt, KeyCode.enter(), 0 as u32);
    if (rt.intResource("kb.adds", -1) != 3) { return 15; }

    // a window shortcut beats the focused node
    rt = press(rt, KeyCode.tab(), 0 as u32);
    rt = press(rt, KeyCode.enter(), KeyModifier.ctrl());
    if (rt.intResource("kb.shortcut.hits", -1) != 1) { return 16; }
    if (rt.intResource("kb.adds", -1) != 3) { return 17; }

    // Esc clears focus when no layer is open
    rt = press(rt, KeyCode.escape(), 0 as u32);
    if (rt.focusedId() != "") { return 18; }

    // a removed node can never be reached by Tab again
    rt = press(rt, KeyCode.tab(), 0 as u32);
    rt = press(rt, KeyCode.tab(), 0 as u32);
    rt = press(rt, KeyCode.tab(), 0 as u32);
    if (rt.focusedId() != "kb.remove.button") { return 19; }
    rt = hideSecondary(rt, component);
    var seen = tabSequence(rt, 10);
    if (containsId(seen, "kb.remove.button")) {
        seen.destroy();
        return 20;
    }
    seen.destroy();

    rt.destroy();
    return 0;
}

fn zc02Layers(component: M0Component, runtime: AppRuntime) -> i32 {
    var rt = runtime;

    // focus the button that will be restored after the dialog closes
    rt = press(rt, KeyCode.tab(), 0 as u32);
    rt = press(rt, KeyCode.tab(), 0 as u32);
    if (rt.focusedId() != "kb.add.button") { return 1; }

    rt = openDialog(rt, component);
    if (rt.layerCount() != 1) { return 2; }
    if (rt.topModalLayerId() != "kb.dialog") { return 3; }

    // Tab stays inside the dialog: no node behind it may be reached
    var seen = tabSequence(rt, 8);
    if (containsId(seen, "kb.add.button") || containsId(seen, "kb.input")
        || containsId(seen, "kb.tail.button") || containsId(seen, "kb.list.0")) {
        seen.destroy();
        return 4;
    }
    var inside: bool = false;
    var i: i32 = 0;
    while (i < (seen.len as i32)) {
        let id = seen.get(i as i64);
        if (id == "kb.dialog.ok" || id == "kb.dialog.cancel") { inside = true; }
        i = i + 1;
    }
    seen.destroy();
    if (!inside) { return 5; }

    // Esc dismisses the layer and restores the focus that opened it
    rt = press(rt, KeyCode.escape(), 0 as u32);
    if (rt.layerCount() != 0) { return 6; }
    if (rt.focusedId() != "kb.add.button") { return 7; }

    rt.destroy();
    return 0;
}

fn zc03Scroll(component: M0Component, runtime: AppRuntime) -> i32 {
    var rt = prime(runtime);
    let route = "kb.list";

    // viewport is measured from the laid-out node: 400 content over 120 viewport
    rt = wheel(rt, route, 50.0);
    if (rt.worldSnapshot().scrollOffsetForViewId("kb.list") != 50.0) { rt.destroy(); return 1; }

    // clamped at the bottom edge
    rt = wheel(rt, route, 1000.0);
    if (rt.worldSnapshot().scrollOffsetForViewId("kb.list") != 280.0) { rt.destroy(); return 2; }

    // clamped at the top edge
    rt = wheel(rt, route, -1000.0);
    if (rt.worldSnapshot().scrollOffsetForViewId("kb.list") != 0.0) { rt.destroy(); return 3; }

    // the offset survives a rebuild: the position is state, not a transient
    rt = wheel(rt, route, 80.0);
    rt = rebuild(rt, component);
    rt = prime(rt);
    if (rt.worldSnapshot().scrollOffsetForViewId("kb.list") != 80.0) { rt.destroy(); return 4; }

    // keyboard scrolling acts on the container around the focused node
    var i: i32 = 0;
    while (i < 4) {
        rt = press(rt, KeyCode.tab(), 0 as u32);
        i = i + 1;
    }
    let before = rt.worldSnapshot().scrollOffsetForViewId("kb.list");
    rt = press(rt, KeyCode.pageDown(), 0 as u32);
    if (rt.worldSnapshot().scrollOffsetForViewId("kb.list") <= before) { rt.destroy(); return 5; }
    rt = press(rt, KeyCode.home(), 0 as u32);
    if (rt.worldSnapshot().scrollOffsetForViewId("kb.list") != 0.0) { rt.destroy(); return 6; }
    rt = press(rt, KeyCode.end(), 0 as u32);
    if (rt.worldSnapshot().scrollOffsetForViewId("kb.list") != 280.0) { rt.destroy(); return 7; }

    rt.destroy();
    return 0;
}

fn zc04ChangeSet(component: M0Component, runtime: AppRuntime) -> i32 {
    var rt = runtime;

    // an unrelated namespace must not rebuild this component
    rt = rt.setStringResource("other.flag", "1");
    if (rt.componentNeedsRebuild("kb")) { rt.destroy(); return 1; }

    // anything in the component's own namespace must
    rt = rt.setStringResource("kb.input", "x");
    if (!rt.componentNeedsRebuild("kb")) { rt.destroy(); return 2; }

    // declaring a watch prefix replaces the default namespace
    rt = rt.addComponentWatchPrefix("kb", "kb.input");
    rt = rt.clearDirtyResources();
    rt = rt.setIntResource("kb.adds", 5);
    if (rt.componentNeedsRebuild("kb")) { rt.destroy(); return 3; }
    rt = rt.setStringResource("kb.input", "y");
    if (!rt.componentNeedsRebuild("kb")) { rt.destroy(); return 4; }

    rt.destroy();
    return 0;
}

fn zc05SemanticTree(component: M0Component, runtime: AppRuntime) -> i32 {
    var rt = runtime;

    let button = rt.accessibilityNodeForId("kb.add.button");
    if (button.role != "button") { rt.destroy(); return 1; }
    if (button.label != "Add") { rt.destroy(); return 2; }
    if (!button.hasAction("kb.add")) { rt.destroy(); return 3; }
    if (!button.isInteractive()) { rt.destroy(); return 4; }

    // hierarchy: the dialog panel and its buttons are related by parent
    rt = openDialog(rt, component);
    let ok_node = rt.accessibilityNodeForId("kb.dialog.ok");
    if (ok_node.role != "button") { rt.destroy(); return 5; }
    if (ok_node.parent_id.len == 0) { rt.destroy(); return 6; }

    // focus is derived at read time
    rt = press(rt, KeyCode.tab(), 0 as u32);
    let focused = rt.accessibilityFocusedNode();
    if (focused.id.len == 0) { rt.destroy(); return 7; }
    if (!focused.focused) { rt.destroy(); return 8; }

    // list rows carry role, state and level
    let row = rt.accessibilityNodeForId("kb.list.0");
    if (row.role != "checkbox") { rt.destroy(); return 9; }
    if (row.level != 1) { rt.destroy(); return 10; }
    if (!row.hasState("unchecked")) { rt.destroy(); return 11; }

    // the snapshot is the assertion surface a bridge would publish
    let text = rt.accessibilitySnapshotText();
    if (!text.contains("button kb.add.button")) { rt.destroy(); return 12; }
    if (rt.accessibilityRevision() == 0 as u64) { rt.destroy(); return 13; }

    rt.destroy();
    return 0;
}

fn zc06Effects(component: M0Component, runtime: AppRuntime) -> i32 {
    var rt = runtime;

    // a request is owned and rate limited
    rt = rt.requestEffect(1, "kb", "kb.done", "payload", 100 as u64);
    if (rt.effectInFlightCount() != 1) { rt.destroy(); return 1; }
    let id = rt.lastEffectRequestId();
    if (id == 0 as u64) { rt.destroy(); return 2; }

    // a completion only queues; the UI scheduler commits it as an action
    rt = rt.completeEffect(id, true, "ok", "");
    if (rt.effectCompletionCount() != 1) { rt.destroy(); return 3; }
    rt = rt.runInteractionSystems();
    rt = rt.applyAllCommands();
    if (rt.effectResultCount() != 1) { rt.destroy(); return 4; }
    if (rt.intResource("kb.effects.done", -1) != 1) { rt.destroy(); return 5; }

    // failure is recorded instead of being swallowed
    rt = rt.requestEffect(2, "kb", "kb.fail", "p", 100 as u64);
    let fail_id = rt.lastEffectRequestId();
    rt = rt.completeEffect(fail_id, false, "", "network down");
    rt = rt.runInteractionSystems();
    rt = rt.applyAllCommands();
    if (rt.unhandledEffectErrorCount() != 1) { rt.destroy(); return 6; }
    if (rt.stringResource("effect.error", "") != "network down") { rt.destroy(); return 7; }

    // a request past its deadline fails with an explicit error
    rt = rt.requestEffect(3, "kb", "kb.slow", "p", 1 as u64);
    rt = rt.runInteractionSystems();
    rt = rt.runInteractionSystems();
    rt = rt.runInteractionSystems();
    if (rt.effectInFlightCount() != 0) { rt.destroy(); return 8; }
    if (rt.unhandledEffectErrorCount() != 2) { rt.destroy(); return 9; }

    // leaving a page cancels its work
    rt = rt.requestEffect(1, "kb", "kb.owned", "p", 0 as u64);
    if (rt.effectInFlightCount() != 1) { rt.destroy(); return 10; }
    rt = rt.cancelEffectsOwnedBy("kb");
    if (rt.effectInFlightCount() != 0) { rt.destroy(); return 11; }

    // a result whose owner is gone is dropped, not written anywhere
    rt = rt.requestEffect(1, "ghost", "kb.orphan", "p", 0 as u64);
    let orphan_id = rt.lastEffectRequestId();
    let dropped_before = rt.effectDroppedCount();
    rt = rt.completeEffect(orphan_id, true, "late", "");
    rt = rt.runInteractionSystems();
    rt = rt.applyAllCommands();
    if (rt.effectDroppedCount() <= dropped_before) { rt.destroy(); return 12; }

    rt.destroy();
    return 0;
}

fn selfTest() -> i32 {
    let component = M0Component.create();
    var world = component.configure(AppWorld.create());
    var root = component.view(world);
    var rt = AppRuntime.create(root, world, UiTheme.md3(), 800.0, 600.0);

    let zc01 = zc01KeyboardRouting(component, rt);
    if (zc01 != 0) { rt.destroy(); return 100 + zc01; }

    rt = AppRuntime.create(root, world, UiTheme.md3(), 800.0, 600.0);
    let zc02 = zc02Layers(component, rt);
    if (zc02 != 0) { rt.destroy(); return 200 + zc02; }

    rt = AppRuntime.create(root, world, UiTheme.md3(), 800.0, 600.0);
    let zc03 = zc03Scroll(component, rt);
    if (zc03 != 0) { rt.destroy(); return 300 + zc03; }

    rt = AppRuntime.create(root, world, UiTheme.md3(), 800.0, 600.0);
    let zc04 = zc04ChangeSet(component, rt);
    if (zc04 != 0) { rt.destroy(); return 400 + zc04; }

    rt = AppRuntime.create(root, world, UiTheme.md3(), 800.0, 600.0);
    let zc05 = zc05SemanticTree(component, rt);
    if (zc05 != 0) { rt.destroy(); return 500 + zc05; }

    rt = AppRuntime.create(root, world, UiTheme.md3(), 800.0, 600.0);
    let zc06 = zc06Effects(component, rt);
    if (zc06 != 0) { rt.destroy(); return 600 + zc06; }

    rt.destroy();
    root.destroy();
    world.destroy();
    return 0;
}

fn main() -> i32 {
    if (has_flag("--self-test")) { return selfTest(); }
    return App.manifestFromArgs().run(M0Component.create());
}
