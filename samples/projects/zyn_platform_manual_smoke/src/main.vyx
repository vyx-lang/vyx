use Clock = Zyn.Platform.Clock.Clock;
use EventKind = Zyn.Platform.Event.EventKind;
use EventLoop = Zyn.Platform.Event.EventLoop;
use Gamepad = Zyn.Platform.Input.Gamepad;
use GamepadAxis = Zyn.Platform.Input.GamepadAxis;
use GamepadButton = Zyn.Platform.Input.GamepadButton;
use MessageBoxFlags = Zyn.Platform.Platform.MessageBoxFlags;
use OS = Zyn.Platform.Platform.OS;
use Platform = Zyn.Platform.Platform.Platform;
use PlatformInit = Zyn.Platform.Platform.PlatformInit;
use Rect = Zyn.Platform.Window.Rect;
use Touch = Zyn.Platform.Input.Touch;
use Window = Zyn.Platform.Window.Window;
use WindowDesc = Zyn.Platform.Window.WindowDesc;
use std.string;

fn cleanup(window: Window, code: i32) -> i32 {
    window.stopTextInput();
    window.destroy();
    Platform.quit();
    return code;
}

fn check_url_and_message_box() -> i32 {
    print("opening URL through SDL_OpenURL");
    match (OS.openUrl("https://example.com/?zyn_platform_manual_smoke=1")) {
        case Ok(_) => {}
        case Err(e) => {
            print("openUrl failed: " + e.message);
            return 20;
        }
    }

    print("showing SDL message box; click OK to continue");
    match (OS.showMessageBox(
        "Zyn Platform Manual Smoke",
        "URL should be open. Connect a gamepad, focus the Zyn window, move the mouse, press a keyboard key, type text, and move/press the gamepad. Click OK to start event capture.",
        MessageBoxFlags.information())) {
        case Ok(_) => {}
        case Err(e2) => {
            print("message box failed: " + e2.message);
            return 21;
        }
    }
    return 0;
}

fn check_gamepad_device() -> i32 {
    match (Gamepad.init()) {
        case Ok(_) => {}
        case Err(e) => {
            print("gamepad init failed: " + e.message);
            return 30;
        }
    }

    Gamepad.update();
    let count = Gamepad.count();
    print("gamepad count: " + count.toString());
    if (count <= 0) { return 31; }

    let id = Gamepad.idAt(0);
    if (id == 0 as u32) { return 32; }

    match (Gamepad.infoAt(0)) {
        case Some(info) => {
            print("gamepad id: " + info.id.toString());
            print("gamepad name: " + info.name);
            print("gamepad type: " + info.type_id.toString());
        }
        case None => { return 33; }
    }

    match (Gamepad.open(id)) {
        case Ok(gp) => {
            if (!gp.isValid()) { gp.close(); return 34; }
            if (!gp.connected()) { gp.close(); return 35; }
            print("opened gamepad: " + gp.name());
            let axis_value = gp.axis(GamepadAxis.leftX());
            print("leftX axis: " + (axis_value as i32).toString());
            gp.button(GamepadButton.south());
            gp.close();
            gp.close();
        }
        case Err(e2) => {
            print("gamepad open failed: " + e2.message);
            return 36;
        }
    }

    return 0;
}

fn wait_for_real_events(gamepad: Gamepad) -> i32 {
    print("capture started for 20 seconds");
    print("move both sticks and press X/A/B/Y during capture");
    print("required: mouse motion/button, keyboard key or text, gamepad axis or button input");
    print("optional if present: touch/finger event");

    let touch_count = Touch.count();
    print("touch count: " + touch_count.toString());

    var saw_mouse = false;
    var saw_key_or_text = false;
    var saw_gamepad_axis = false;
    var saw_gamepad_button = false;
    var saw_touch = false;
    var saw_gamepad_device = false;
    var axis0 = gamepad.axis(0);
    var axis1 = gamepad.axis(1);
    var axis2 = gamepad.axis(2);
    var axis3 = gamepad.axis(3);
    var axis4 = gamepad.axis(4);
    var axis5 = gamepad.axis(5);
    var button0 = gamepad.button(0);
    var button1 = gamepad.button(1);
    var button2 = gamepad.button(2);
    var button3 = gamepad.button(3);
    var button4 = gamepad.button(4);
    var button5 = gamepad.button(5);
    var button6 = gamepad.button(6);
    var button7 = gamepad.button(7);
    var button8 = gamepad.button(8);
    var button9 = gamepad.button(9);
    var button10 = gamepad.button(10);
    var button11 = gamepad.button(11);
    var button12 = gamepad.button(12);
    var button13 = gamepad.button(13);
    var button14 = gamepad.button(14);
    var axis_events: i32 = 0;
    var button_events: i32 = 0;
    var polled_axis_changes: i32 = 0;
    var polled_button_changes: i32 = 0;

    let start = Clock.ticks();
    while ((Clock.ticks() - start) < 20000 as u64) {
        Gamepad.update();

        let p_axis0 = gamepad.axis(0);
        if ((p_axis0 as i32) != (axis0 as i32)) {
            print("poll axis 0: " + (p_axis0 as i32).toString());
            axis0 = p_axis0;
            polled_axis_changes = polled_axis_changes + 1;
            saw_gamepad_axis = true;
        }
        let p_axis1 = gamepad.axis(1);
        if ((p_axis1 as i32) != (axis1 as i32)) {
            print("poll axis 1: " + (p_axis1 as i32).toString());
            axis1 = p_axis1;
            polled_axis_changes = polled_axis_changes + 1;
            saw_gamepad_axis = true;
        }
        let p_axis2 = gamepad.axis(2);
        if ((p_axis2 as i32) != (axis2 as i32)) {
            print("poll axis 2: " + (p_axis2 as i32).toString());
            axis2 = p_axis2;
            polled_axis_changes = polled_axis_changes + 1;
            saw_gamepad_axis = true;
        }
        let p_axis3 = gamepad.axis(3);
        if ((p_axis3 as i32) != (axis3 as i32)) {
            print("poll axis 3: " + (p_axis3 as i32).toString());
            axis3 = p_axis3;
            polled_axis_changes = polled_axis_changes + 1;
            saw_gamepad_axis = true;
        }
        let p_axis4 = gamepad.axis(4);
        if ((p_axis4 as i32) != (axis4 as i32)) {
            print("poll axis 4: " + (p_axis4 as i32).toString());
            axis4 = p_axis4;
            polled_axis_changes = polled_axis_changes + 1;
            saw_gamepad_axis = true;
        }
        let p_axis5 = gamepad.axis(5);
        if ((p_axis5 as i32) != (axis5 as i32)) {
            print("poll axis 5: " + (p_axis5 as i32).toString());
            axis5 = p_axis5;
            polled_axis_changes = polled_axis_changes + 1;
            saw_gamepad_axis = true;
        }

        let p_button0 = gamepad.button(0);
        if (p_button0 != button0) {
            print("poll button 0: " + p_button0.toString());
            button0 = p_button0;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button1 = gamepad.button(1);
        if (p_button1 != button1) {
            print("poll button 1: " + p_button1.toString());
            button1 = p_button1;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button2 = gamepad.button(2);
        if (p_button2 != button2) {
            print("poll button 2: " + p_button2.toString());
            button2 = p_button2;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button3 = gamepad.button(3);
        if (p_button3 != button3) {
            print("poll button 3: " + p_button3.toString());
            button3 = p_button3;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button4 = gamepad.button(4);
        if (p_button4 != button4) {
            print("poll button 4: " + p_button4.toString());
            button4 = p_button4;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button5 = gamepad.button(5);
        if (p_button5 != button5) {
            print("poll button 5: " + p_button5.toString());
            button5 = p_button5;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button6 = gamepad.button(6);
        if (p_button6 != button6) {
            print("poll button 6: " + p_button6.toString());
            button6 = p_button6;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button7 = gamepad.button(7);
        if (p_button7 != button7) {
            print("poll button 7: " + p_button7.toString());
            button7 = p_button7;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button8 = gamepad.button(8);
        if (p_button8 != button8) {
            print("poll button 8: " + p_button8.toString());
            button8 = p_button8;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button9 = gamepad.button(9);
        if (p_button9 != button9) {
            print("poll button 9: " + p_button9.toString());
            button9 = p_button9;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button10 = gamepad.button(10);
        if (p_button10 != button10) {
            print("poll button 10: " + p_button10.toString());
            button10 = p_button10;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button11 = gamepad.button(11);
        if (p_button11 != button11) {
            print("poll button 11: " + p_button11.toString());
            button11 = p_button11;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button12 = gamepad.button(12);
        if (p_button12 != button12) {
            print("poll button 12: " + p_button12.toString());
            button12 = p_button12;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button13 = gamepad.button(13);
        if (p_button13 != button13) {
            print("poll button 13: " + p_button13.toString());
            button13 = p_button13;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }
        let p_button14 = gamepad.button(14);
        if (p_button14 != button14) {
            print("poll button 14: " + p_button14.toString());
            button14 = p_button14;
            polled_button_changes = polled_button_changes + 1;
            saw_gamepad_button = true;
        }

        match (EventLoop.waitTimeout(16)) {
            case Some(ev) => {
                if (ev.raw_type == EventKind.mouseMotion().value
                    || ev.raw_type == EventKind.mouseButtonDown().value
                    || ev.raw_type == EventKind.mouseButtonUp().value
                    || ev.raw_type == EventKind.mouseWheel().value) {
                    if (!saw_mouse) { print("mouse event observed"); }
                    saw_mouse = true;
                }

                if (ev.raw_type == EventKind.keyDown().value
                    || ev.raw_type == EventKind.keyUp().value
                    || ev.raw_type == EventKind.textInput().value
                    || ev.raw_type == EventKind.textEditing().value) {
                    if (!saw_key_or_text) { print("keyboard/text event observed"); }
                    saw_key_or_text = true;
                }

                if (ev.raw_type == EventKind.gamepadAxisMotion().value) {
                    print("event axis " + ev.gamepad_axis.toString() + ": " + ev.gamepad_axis_value.toString());
                    axis_events = axis_events + 1;
                    saw_gamepad_axis = true;
                } else if (ev.raw_type == EventKind.gamepadButtonDown().value
                    || ev.raw_type == EventKind.gamepadButtonUp().value) {
                    print("event button " + ev.gamepad_button.toString() + ": " + ev.gamepad_button_down.toString());
                    button_events = button_events + 1;
                    saw_gamepad_button = true;
                } else if (ev.isGamepad()) {
                    if (!saw_gamepad_device) {
                        print("gamepad non-input event observed: " + ev.raw_type.toString());
                    }
                    saw_gamepad_device = true;
                }

                if (ev.isTouch()) {
                    if (!saw_touch) { print("touch event observed"); }
                    saw_touch = true;
                }
            }
            case None => {}
        }
    }

    print("axis events: " + axis_events.toString());
    print("button events: " + button_events.toString());
    print("polled axis changes: " + polled_axis_changes.toString());
    print("polled button changes: " + polled_button_changes.toString());

    if (!saw_mouse) { return 40; }
    if (!saw_key_or_text) { return 41; }
    if (!saw_gamepad_axis && !saw_gamepad_button) { return 42; }
    if (touch_count > 0 && !saw_touch) { return 43; }
    return 0;
}

fn main() -> i32 {
    match (Platform.setMetadata("Zyn Manual Platform Smoke", "0.1.0", "dev.vyx.zyn.platform_manual_smoke")) {
        case Ok(_) => {}
        case Err(e) => {
            print("metadata failed: " + e.message);
            return 1;
        }
    }

    match (Platform.initWithFlags(PlatformInit.app())) {
        case Ok(_) => {}
        case Err(e2) => {
            print("platform init failed: " + e2.message);
            return 2;
        }
    }

    let desc = WindowDesc.create("Zyn Manual Platform Smoke", 720, 420)
        .resizable()
        .highPixelDensity();

    var window: Window;
    match (Window.create(desc)) {
        case Ok(v) => { window = v; }
        case Err(e3) => {
            print("window create failed: " + e3.message);
            Platform.quit();
            return 3;
        }
    }

    match (window.show()) {
        case Ok(_) => {}
        case Err(e4) => {
            print("window show failed: " + e4.message);
            return cleanup(window, 4);
        }
    }
    match (window.raise()) {
        case Ok(_) => {}
        case Err(e5) => {
            print("window raise failed: " + e5.message);
            return cleanup(window, 5);
        }
    }
    match (window.startTextInput()) {
        case Ok(_) => {}
        case Err(e6) => {
            print("text input start failed: " + e6.message);
            return cleanup(window, 6);
        }
    }
    match (window.setTextInputArea(Rect.create(16, 16, 320, 32), 0)) {
        case Ok(_) => {}
        case Err(e7) => {
            print("text input area failed: " + e7.message);
            return cleanup(window, 7);
        }
    }

    let ui_code = check_url_and_message_box();
    if (ui_code != 0) { return cleanup(window, ui_code); }

    let gamepad_code = check_gamepad_device();
    if (gamepad_code != 0) { return cleanup(window, gamepad_code); }

    print("draining startup events");
    var drain_until = Clock.ticks() + 500 as u64;
    while (Clock.ticks() < drain_until) {
        match (EventLoop.waitTimeout(1)) {
            case Some(_) => {}
            case None => {}
        }
    }

    var capture_gamepad: Gamepad;
    Gamepad.update();
    let capture_gamepad_id = Gamepad.idAt(0);
    if (capture_gamepad_id == 0 as u32) {
        print("gamepad reopen failed: no gamepad id at index 0");
        return cleanup(window, 37);
    }
    match (Gamepad.open(capture_gamepad_id)) {
        case Ok(v) => { capture_gamepad = v; }
        case Err(e8) => {
            print("gamepad reopen failed: " + e8.message);
            return cleanup(window, 37);
        }
    }

    let event_code = wait_for_real_events(capture_gamepad);
    capture_gamepad.close();
    if (event_code != 0) {
        print("manual event capture failed with code " + event_code.toString());
        return cleanup(window, event_code);
    }

    print("manual platform smoke passed");
    return cleanup(window, 0);
}
