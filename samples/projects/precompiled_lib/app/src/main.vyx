use mathlib;

fn main() -> i32 {
    let sum = add(3, 4);
    let prod = multiply(5, 6);
    let fact = factorial(5);

    let v = Vec2.new(3, 4);
    let len_sq = v.length_squared();

    print("add(3,4) = ${sum}");
    print("multiply(5,6) = ${prod}");
    print("factorial(5) = ${fact}");
    print("Vec2(3,4).length_squared() = ${len_sq}");

    if (sum != 7) { return 1; }
    if (prod != 30) { return 2; }
    if (fact != 120) { return 3; }
    if (len_sq != 25) { return 4; }
    print("OK all tests passed");
    return 0;
}
