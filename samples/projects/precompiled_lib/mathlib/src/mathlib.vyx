module mathlib;

// Public API
public fn add(a: i32, b: i32) -> i32 {
    return a + b;
}

public fn multiply(a: i32, b: i32) -> i32 {
    return a * b;
}

public fn factorial(n: i32) -> i64 {
    if (n <= 1) { return 1; }
    return (n as i64) * factorial(n - 1);
}

public class Vec2 {
    public x: i32;
    public y: i32;

    public static fn new(x: i32, y: i32) -> Vec2 {
        return Vec2 { x: x, y: y };
    }

    public fn length_squared() -> i32 {
        return self.x * self.x + self.y * self.y;
    }
}

// Internal helper — should NOT appear in .vyi
internal fn _unused_helper() -> i32 {
    return 42;
}
