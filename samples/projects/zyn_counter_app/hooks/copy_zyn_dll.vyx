use std.fs;

fn main() -> i32 {
    // Stage the full Zyn runtime (Zyn + SDL3 + Cacao + slang + transitive deps).
    // copyFilesWithExtension returns the number of files copied, -1 on failure.
    let n = copyFilesWithExtension("../../../Zyn/out", "target", ".dll");
    if (n < 0) { return 1; }
    if (makeDir("target/nut") != 0) { return 2; }
    if (copyFile("../../../Zyn/out/nut/solid.slang", "target/nut/solid.slang") != 0) { return 3; }
    return 0;
}
