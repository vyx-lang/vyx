use AppHost = Zyn.App.AppHost;
use AppProfile = Zyn.App.AppProfile;
use AppSurface = Zyn.App.AppSurface;
use AppWorld = Zyn.App.AppWorld;
use Button = Zyn.App.Button;
use Column = Zyn.App.Column;
use Color = Zyn.Nut.Types.Color;
use Panel = Zyn.App.Panel;
use Row = Zyn.App.Row;
use SceneBuilder = Zyn.Nut.Scene.SceneBuilder;
use StatelessComponent = Zyn.App.StatelessComponent;
use Text = Zyn.App.Text;
use UiTheme = Zyn.UI.UiTheme;
use View = Zyn.App.View;
use f32FromInt = Zyn.Nut.Types.f32FromInt;
use typesLoadF32 = Zyn.Nut.Types.typesLoadF32;
use std.args;
use std.fs;

class CounterComponent : StatelessComponent {
    public value_resource: string;
    public increment_action: string;
    public decrement_action: string;

    public static fn create() -> CounterComponent {
        return CounterComponent {
            component_id: "counter",
            value_resource: "counter.value",
            increment_action: "counter.increment",
            decrement_action: "counter.decrement"
        };
    }

    public fn configure(world: AppWorld) -> AppWorld {
        return world
            .setIntResource(self.value_resource, 0)
            .setStringResource(self.value_resource, "0")
            .registerIntDeltaCommand(self.increment_action, self.value_resource, 1)
            .registerIntDeltaCommand(self.decrement_action, self.value_resource, -1);
    }

    public fn view(world: AppWorld) -> View {
        return Panel::create()
            .id("counter.panel")
            .anchorCenter()
            .size(352.0, 372.0)
            .padding(28.0)
            .gap(16.0)
            .background(Color::rgba(1.0, 1.0, 0.99, 1.0))
            .stroke(1.0, Color::rgba(0.74, 0.80, 0.77, 1.0))
            .cornerRadius(8.0)
            .child(
                Column::create()
                    .gap(16.0)
                    .alignCenter()
                    .child(
                        Text::title("Tide Counter")
                            .id("counter.title")
                            .height(38.0)
                            .textCenter()
                    )
                    .child(
                        Text::body("Keep the rhythm steady.")
                            .id("counter.subtitle")
                            .height(30.0)
                            .textCenter()
                    )
                    .child(
                        Text::title("0")
                            .id("counter.value.view")
                            .bindText(self.value_resource)
                            .width(160.0)
                            .height(68.0)
                            .textCenter()
                            .foreground(Color::rgba(0.05, 0.20, 0.18, 1.0))
                            .accessibilityLabel("Counter value")
                    )
                    .child(
                        Row::create()
                            .id("counter.controls")
                            .width(168.0)
                            .height(48.0)
                            .gap(24.0)
                            .alignCenter()
                            .mainCenter()
                            .child(
                                Button::tonal("-")
                                    .id("counter.controls.decrement")
                                    .action(self.decrement_action)
                                    .size(72.0, 48.0)
                                    .accessibility("button", "Decrement", "Subtracts one")
                            )
                            .child(
                                Button::filled("+")
                                    .id("counter.controls.increment")
                                    .action(self.increment_action)
                                    .size(72.0, 48.0)
                                    .accessibility("button", "Increment", "Adds one")
                            )
                    )
                    .child(
                        Text::body("Tap either side.")
                            .id("counter.note")
                            .width(288.0)
                            .height(30.0)
                            .textCenter()
                    )
            );
    }
}

fn main() -> i32 {
    var profile = AppProfile.fromManifest();
    if (has_flag("--visible")) {
        profile = profile.visibleUntilClose();
    } else {
        profile = profile.hiddenFrames(2);
    }
    profile = profile.expectRender(8, 4);

    var comp = CounterComponent.create();
    var world = AppWorld.create();
    world = comp.configure(world);
    let content = comp.view(world);
    let root = AppSurface.stage("counter.root", content);
    let wtest = f32FromInt(1280);
    var diag = "content_w=" + (content.width_value as i32).toString()
        + " content_h=" + (content.height_value as i32).toString()
        + " content_children=" + content.childCount().toString()
        + " root_children=" + root.childCount().toString()
        + " f32from=" + (wtest as i32).toString();
    writeFile("target/counter_diag.txt", diag);
    var tree = root.dup().toUiTreeWithWorld(1280.0, 720.0, UiTheme.md3(), world.dup());
    diag = diag + " tree=" + tree.nodeCount().toString();
    var ni: i32 = 0;
    while (ni < tree.nodeCount()) {
        let node = tree.nodeAt(ni);
        let rb = to_rawptr(&node.bounds);
        diag = diag + "\n" + ni.toString() + ":" + node.id
            + " w=" + (node.bounds.width as i32).toString()
            + " bits_w=" + (typesLoadF32(rb + 8) as i32).toString()
            + " h=" + (node.bounds.height as i32).toString()
            + " bits_h=" + (typesLoadF32(rb + 12) as i32).toString()
            + " a=" + (typesLoadF32(to_rawptr(&node.color) + 12) as i32).toString()
            + " sw=" + (node.stroke_width as i32).toString()
            + " text=" + node.text;
        ni = ni + 1;
    }
    var scene = SceneBuilder.create().clear(Color.rgba(1.0, 1.0, 1.0, 1.0));
    scene = tree.render(scene);
    diag = diag + "\ndraws=" + scene.drawCommandCount().toString();
    writeFile("target/counter_diag.txt", diag);
    scene.destroy();
    tree.destroy();

    if (!has_flag("--visible") && !has_flag("--gpu")) {
        return 0;
    }

    match (AppHost.runRootWithOptions(profile.toSpec(), root, world, profile.options())) {
        case Ok(report) => {
            print("frames=" + report.frames.toString()
                + " rendered=" + report.rendered_frames.toString()
                + " nodes=" + report.node_count.toString()
                + " draws=" + report.draw_commands.toString());
            let code = profile.validateReport(report);
            if (code != 0) {
                print("validate=" + code.toString());
            }
            return code;
        }
        case Err(e) => {
            print(e.message);
            return 40 + e.code;
        }
    }
}
