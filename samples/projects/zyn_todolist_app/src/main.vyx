use App = Zyn.App.App;
use AppAction = Zyn.App.AppAction;
use AppCommandHandler = Zyn.App.AppCommandHandler;
use AppRuntime = Zyn.App.AppRuntime;
use AppSurface = Zyn.App.AppSurface;
use AppTimeline = Zyn.App.AppTimeline;
use AppWorld = Zyn.App.AppWorld;
use Button = Zyn.App.Button;
use Column = Zyn.App.Column;
use ListView = Zyn.App.ListView;
use Row = Zyn.App.Row;
use StatelessComponent = Zyn.App.StatelessComponent;
use Text = Zyn.App.Text;
use TextField = Zyn.App.TextField;
use View = Zyn.App.View;
use app_parse_i32_or = Zyn.App.app_parse_i32_or;
use Color = Zyn.Nut.Types.Color;
use UiTheme = Zyn.UI.UiTheme;

class AddTaskCommand : AppCommandHandler {
    public action_name: string;
    public input_resource: string;
    public items_resource: string;
    public checked_resource: string;
    public error_resource: string;

    public static fn create(action_name: string, input_resource: string, items_resource: string, checked_resource: string, error_resource: string) -> AddTaskCommand {
        return AddTaskCommand {
            action_name: action_name,
            input_resource: input_resource,
            items_resource: items_resource,
            checked_resource: checked_resource,
            error_resource: error_resource
        };
    }

    public fn matches(&self, action: AppAction) -> bool {
        return action.name == self.action_name;
    }

    public fn execute(&self, action: AppAction, world: AppWorld) -> AppWorld {
        let title = world.stringResource(self.input_resource, "").trim();
        if (title.len == 0) {
            return world.setStringResource(self.error_resource, "Enter a task first.");
        }

        return world
            .appendStringListResource(self.items_resource, title)
            .appendBoolListResource(self.checked_resource, false)
            .setStringResource(self.input_resource, "")
            .setStringResource(self.error_resource, "");
    }

    public fn dup(&self) -> Box<dyn AppCommandHandler> {
        return Box::<dyn AppCommandHandler>.new(AddTaskCommand.create(
            self.action_name, self.input_resource, self.items_resource,
            self.checked_resource, self.error_resource
        ));
    }
}

fn toggleTask(action: AppAction, world: AppWorld) -> AppWorld {
    let prefix = "tasks.toggle.";
    let suffix = action.name.substring(prefix.len, action.name.len);
    let index = app_parse_i32_or(suffix, -1);
    if (index < 0 || suffix != index.toString() || index >= world.stringListResourceCount("tasks.items")) { return world; }
    return world.toggleBoolListResourceAt("tasks.items:checked", index);
}

class TodoComponent : StatelessComponent {
    public static fn create() -> TodoComponent {
        return TodoComponent { component_id: "tasks" };
    }

    public fn configure(world: AppWorld) -> AppWorld {
        var out = world
            .setStringResource("tasks.input", "")
            .setStringResource("tasks.error", "")
            .registerStringSetCommand("tasks.input.set", "tasks.input")
            .registerCommandHandler(Box::<dyn AppCommandHandler>.new(AddTaskCommand.create(
                "tasks.add", "tasks.input", "tasks.items", "tasks.items:checked", "tasks.error"
            )))
            .registerBehaviorPrefix("tasks.toggle.", toggleTask);
        if (out.stringListResourceCount("tasks.items") == 0) {
            out = out.appendStringListResource("tasks.items", "Write Zyn docs")
                .appendBoolListResource("tasks.items:checked", true);
        }
        return out;
    }

    public fn view(world: AppWorld) -> View {
        let content = Column.create()
            .gap(12.0)
            .child(Text.title("Task Deck")
                .id("tasks.title")
                .height(40.0))
            .child(Text.muted("Plan the next useful thing.")
                .id("tasks.subtitle")
                .height(26.0))
            .child(Row.create()
                .id("tasks.entry")
                .gap(10.0)
                .height(52.0)
                .child(TextField.bound("tasks.input", "Task name", "tasks.input", "tasks.input.set")
                    .expanded()
                    .minWidth(260.0)
                    .height(48.0))
                .child(Button.filledAction("tasks.add.button", "Add", "tasks.add")
                    .size(92.0, 48.0)))
            .child(Text.mutedBound("tasks.error", "")
                .id("tasks.error.view")
                .height(22.0)
                .foreground(Color.rgba(0.70, 0.08, 0.12, 1.0)))
            .child(ListView.bound("tasks.list", "tasks.items", "tasks.items:checked", "tasks.toggle.")
                .height(176.0)
                .itemHeight(42.0))
            .child(Text.muted("Checked items stay in place.")
                .id("tasks.note")
                .height(28.0));
        return AppSurface.card("tasks.panel", 520.0, 420.0)
            .padding(18.0)
            .gap(14.0)
            .child(content);
    }
}

fn timelineSelfTest() -> i32 {
    let component = TodoComponent.create();
    var world = component.configure(AppWorld.create());
    var root = component.view(world);
    var initial = AppRuntime.create(root, world, UiTheme.md3(), 800.0, 600.0);
    var recorded = initial.dup().startRecording();

    recorded = recorded.handleTextInput("tasks.input", "Review changes").applyAllCommands();
    recorded = recorded.dispatchViewAction("tasks.add.button").applyAllCommands();
    recorded = recorded.frame();
    recorded = recorded.dispatchViewAction("tasks.list.1").applyAllCommands();

    var result: i32 = 0;
    if (recorded.stringListResourceCount("tasks.items") != 2
        || recorded.stringListResourceAt("tasks.items", 1) != "Review changes"
        || !recorded.boolListResourceAt("tasks.items:checked", 1)) { result = 10; }

    var timeline = recorded.recordedTimeline();
    if (result == 0 && timeline.count() != 3) { result = 11; }
    if (result == 0) {
        let input_step = timeline.stepAt(0);
        let add_step = timeline.stepAt(1);
        let toggle_step = timeline.stepAt(2);
        if (input_step.action.name != "tasks.input.set"
            || add_step.action.name != "tasks.add"
            || toggle_step.action.name != "tasks.toggle.1") { result = 12; }
    }

    if (result == 0) {
        match (timeline.exportTo("target/todo_self_test.zyns")) {
            case Ok(_) => {}
            case Err(_) => { result = 13; }
        }
    }
    if (result == 0) {
        match (AppTimeline.load("target/todo_self_test.zyns")) {
            case Ok(loaded) => {
                if (loaded.serialize() != timeline.serialize()) { result = 14; }
                if (result == 0) {
                    match (initial.replyTimeline(loaded, 3)) {
                        case Ok(count) => { if (count != 9) { result = 15; } }
                        case Err(_) => { result = 16; }
                    }
                }
                var mismatched = initial.dup().setStringResource("tasks.input", "different");
                if (result == 0) {
                    match (mismatched.replyTimeline(loaded, 1)) {
                        case Ok(_) => { result = 17; }
                        case Err(e) => { if (e.code != 89) { result = 18; } }
                    }
                }
                mismatched.destroy();
                var owned_loaded = loaded;
                owned_loaded.destroy();
            }
            case Err(_) => { result = 19; }
        }
    }

    timeline.destroy();
    recorded.destroy();
    initial.destroy();
    root.destroy();
    world.destroy();
    return result;
}

fn selfTest() -> i32 {
    let component = TodoComponent.create();
    var configured = component.configure(AppWorld.create());
    var world = configured.dup();
    configured.destroy();
    var view = component.view(world);
    world = view.bindActions(world);

    world = world.dispatchViewAction("tasks.add.button").applyAllCommands();
    if (world.stringResource("tasks.error", "") != "Enter a task first.") { return 1; }

    world = world.setStringResource("tasks.input", "Review changes");
    world = world.dispatchViewAction("tasks.add.button").applyAllCommands();
    if (world.stringListResourceCount("tasks.items") != 2) { return 2; }
    if (world.stringListResourceAt("tasks.items", 1) != "Review changes") { return 3; }
    if (world.stringResource("tasks.input", "not cleared") != "") { return 4; }

    world = view.bindActions(world);
    world = world.dispatchViewAction("tasks.list.1").applyAllCommands();
    if (!world.boolListResourceAt("tasks.items:checked", 1)) { return 5; }
    world = world.dispatchNamed("tasks.toggle.invalid").applyAllCommands();
    if (world.boolListResourceAt("tasks.items:checked", 0) != true) { return 6; }
    view.destroy();
    world.destroy();
    return timelineSelfTest();
}

fn main() -> i32 {
    if (has_flag("--self-test")) { return selfTest(); }
    return App.manifestFromArgs().run(TodoComponent.create());
}
