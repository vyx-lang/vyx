// M2/M3 services acceptance: every ZC-17..ZC-21 public type is driven here at
// least once, headlessly, so none of them is "finished" only in the abstract.
//
//   ZC-17  errors, logging and diagnostics
//   ZC-18  platform capability matrix and the release it gates
//   ZC-19  release spec, upgrade plan and the crash-safe upgrade state machine
//   ZC-20  templates, component catalog, API samples, semantic tree,
//          deprecation cycle and version compatibility
//   ZC-21  performance budgets, baselines, regression comparison and the four
//          stability scenarios
//
// Each section returns a distinct non-zero code so a failure names itself
// without a debugger. Nothing here opens a window: every assertion drives the
// service layer directly and inspects the resulting world.

use AppWorld = Zyn.App.AppWorld;
use AccessibilityNode = Zyn.App.AccessibilityNode;

// ZC-17
use AppDiagnostic = Zyn.App.AppDiagnostic;
use AppDiagList = Zyn.App.AppDiagList;
use AppDiagText = Zyn.App.AppDiagText;
use AppBreadcrumb = Zyn.App.AppBreadcrumb;
use AppEffectDiagnostics = Zyn.App.AppEffectDiagnostics;
use AppCrashContext = Zyn.App.AppCrashContext;
use AppLogEntry = Zyn.App.AppLogEntry;
use AppMemoryLogSink = Zyn.App.AppMemoryLogSink;
use AppLogConfig = Zyn.App.AppLogConfig;
use AppTraceSpan = Zyn.App.AppTraceSpan;
use AppPerfTrace = Zyn.App.AppPerfTrace;
use AppPerfCounter = Zyn.App.AppPerfCounter;
use AppRetryQueue = Zyn.App.AppRetryQueue;
use AppErrorPresenter = Zyn.App.AppErrorPresenter;
use AppDevInspector = Zyn.App.AppDevInspector;
use appSeverityError = Zyn.App.appSeverityError;
use appSeverityWarning = Zyn.App.appSeverityWarning;
use appRetryManual = Zyn.App.appRetryManual;
use appDiagPersistence = Zyn.App.appDiagPersistence;
use appDiagCodeEffectFailed = Zyn.App.appDiagCodeEffectFailed;
use appLogError = Zyn.App.appLogError;

// ZC-18
use AppCapabilityEntry = Zyn.App.AppCapabilityEntry;
use AppPlatformMatrix = Zyn.App.AppPlatformMatrix;
use appPlatformWindows = Zyn.App.appPlatformWindows;
use appPlatformIOS = Zyn.App.appPlatformIOS;
use appCapIme = Zyn.App.appCapIme;
use appCapFilePicker = Zyn.App.appCapFilePicker;
use appCapabilityVerified = Zyn.App.appCapabilityVerified;

// ZC-19
use AppVersion = Zyn.App.AppVersion;
use AppSigningConfig = Zyn.App.AppSigningConfig;
use AppReleaseArtifact = Zyn.App.AppReleaseArtifact;
use AppReleaseSpec = Zyn.App.AppReleaseSpec;
use AppReleaseManifest = Zyn.App.AppReleaseManifest;
use AppUpgradeStep = Zyn.App.AppUpgradeStep;
use AppUpgradePlan = Zyn.App.AppUpgradePlan;
use AppUpgradeState = Zyn.App.AppUpgradeState;
use AppReleaseHistory = Zyn.App.AppReleaseHistory;
use appArtifactBinary = Zyn.App.appArtifactBinary;
use appReleaseChannelStable = Zyn.App.appReleaseChannelStable;
use appReleaseChannelBeta = Zyn.App.appReleaseChannelBeta;

// ZC-20
use AppTemplateFile = Zyn.App.AppTemplateFile;
use AppProjectTemplate = Zyn.App.AppProjectTemplate;
use AppComponentEntry = Zyn.App.AppComponentEntry;
use AppComponentCatalog = Zyn.App.AppComponentCatalog;
use AppSampleLibrary = Zyn.App.AppSampleLibrary;
use AppSemanticTree = Zyn.App.AppSemanticTree;
use AppDeprecation = Zyn.App.AppDeprecation;
use AppDeprecationRegistry = Zyn.App.AppDeprecationRegistry;
use AppApiSurface = Zyn.App.AppApiSurface;
use AppCompatChange = Zyn.App.AppCompatChange;
use AppCompatChecker = Zyn.App.AppCompatChecker;
use appComponentInput = Zyn.App.appComponentInput;
use appTemplateFileSource = Zyn.App.appTemplateFileSource;
use appDeprecationWarning = Zyn.App.appDeprecationWarning;
use appCatalogBaselineVersion = Zyn.App.appCatalogBaselineVersion;

// ZC-21
use AppMachineProfile = Zyn.App.AppMachineProfile;
use AppCorpus = Zyn.App.AppCorpus;
use AppPerfSample = Zyn.App.AppPerfSample;
use AppPerfSeries = Zyn.App.AppPerfSeries;
use AppPerfBudget = Zyn.App.AppPerfBudget;
use AppPerfVerdict = Zyn.App.AppPerfVerdict;
use AppPerfBaseline = Zyn.App.AppPerfBaseline;
use AppStabilityRun = Zyn.App.AppStabilityRun;
use AppStabilityGate = Zyn.App.AppStabilityGate;
use AppPerfSuite = Zyn.App.AppPerfSuite;
use appPerfScrollFrame = Zyn.App.appPerfScrollFrame;
use appPerfUnitForMetric = Zyn.App.appPerfUnitForMetric;
use appPerfStartup = Zyn.App.appPerfStartup;
use appPerfScenarioScroll = Zyn.App.appPerfScenarioScroll;
use appPerfScenarioIdle = Zyn.App.appPerfScenarioIdle;
use appPerfScenarioGpuLoss = Zyn.App.appPerfScenarioGpuLoss;
use appPerfScenarioBackgroundRestore = Zyn.App.appPerfScenarioBackgroundRestore;
use appPerfMinSamples = Zyn.App.appPerfMinSamples;
use appPerfGrade = Zyn.App.appPerfGrade;
use appPerfCompare = Zyn.App.appPerfCompare;

use View = Zyn.App.View;
use std.collections;

fn expect(ok: bool, label: string) -> i32 {
    if (ok) { return 0; }
    print("  FAIL " + label);
    return 1;
}

// ---------------------------------------------------------------------------
// ZC-17 errors, logging and diagnostics
// ---------------------------------------------------------------------------

fn checkDiagnostics() -> i32 {
    var world = AppWorld.create();

    // A diagnostic round-trips through the record form without losing anything.
    var diag = AppDiagnostic.create(appDiagCodeEffectFailed(), "sync failed");
    diag = diag.withSeverity(appSeverityError());
    diag = diag.withDetail("https returned 503");
    diag = diag.withRetry(appRetryManual());
    let round = AppDiagnostic.parse(diag.serialize());
    if (expect(round.code == appDiagCodeEffectFailed(), "diagnostic code survives serialize")) { return 1; }
    if (expect(round.message == "sync failed", "diagnostic message survives serialize")) { return 2; }
    if (expect(round.detail == "https returned 503", "diagnostic detail survives serialize")) { return 3; }

    // The field helper is the thing every record below depends on.
    if (expect(AppDiagText.fieldCount("a|b|c", AppDiagText.pipe()) == 3, "fieldCount")) { return 4; }
    if (expect(AppDiagText.fieldAt("a|b|c", AppDiagText.pipe(), 1) == "b", "fieldAt")) { return 5; }

    // Resource-backed list: record, then read back by index and by filter.
    world = AppDiagList.record(world, "page", diag);
    var info = AppDiagnostic.of(4100, appDiagPersistence(), "cache miss");
    info = info.withSeverity(appSeverityWarning());
    world = AppDiagList.record(world, "page", info);
    if (expect(AppDiagList.count(world, "page") == 2, "diag list count")) { return 6; }
    if (expect(AppDiagList.errorCount(world, "page") == 1, "diag list errorCount")) { return 7; }
    if (expect(AppDiagList.last(world, "page").code == 4100, "diag list last")) { return 8; }

    // Breadcrumbs are the "what was happening" half a diagnostic cannot carry.
    world = AppBreadcrumb.note(world, "page", "open", "opened detail");
    if (expect(AppBreadcrumb.count(world, "page") == 1, "breadcrumb count")) { return 9; }
    if (expect(AppBreadcrumb.labelAt(world, "page", 0) == "opened detail", "breadcrumb label")) { return 10; }

    // Effect diagnostics summarise the whole effect plane without arguments.
    if (expect(AppEffectDiagnostics.summary(world).len > 0, "effect diagnostics summary")) { return 11; }

    // Crash context must round-trip and must be verifiable, because it is the
    // payload that gets shipped from a machine nobody can attach a debugger to.
    let report = AppCrashContext.report(world, "dev.vyx.zyn.services", "0.9.0", "page");
    if (expect(AppCrashContext.reportIsValid(report), "crash context self-verifies")) { return 12; }
    let redacted = AppCrashContext.reportRedacted(world, "dev.vyx.zyn.services", "0.9.0", "page", "topsecret");
    if (expect(AppCrashContext.reportIsValid(redacted), "redacted crash context is still valid")) { return 13; }
    if (expect(!redacted.contains("topsecret"), "redaction removed the secret")) { return 14; }

    // Logging: config, sink and entry are three separate objects on purpose -
    // redaction belongs to the sink so it cannot be bypassed by a caller.
    let leveled = AppLogConfig.create().withLevel(appLogError()).addSecret("topsecret");
    if (expect(leveled.secrets == "topsecret", "log config carries secrets")) { return 15; }
    world = AppMemoryLogSink.setSecrets(world, "page", "topsecret");
    let entry = AppLogEntry.create(appLogError(), "page", "sync", "failed with topsecret");
    if (expect(AppLogEntry.parse(entry.serialize()).message == "failed with topsecret", "log entry round-trip")) { return 16; }

    // Trace: begin/end must nest and must close.
    world = AppPerfTrace.begin(world, "page", "outer");
    world = AppPerfTrace.begin(world, "page", "inner");
    world = AppPerfTrace.end(world, "page", "inner");
    world = AppPerfTrace.end(world, "page", "outer");
    if (expect(!AppPerfTrace.isActive(world, "page", "outer"), "trace closes")) { return 17; }
    let span = AppTraceSpan.create("outer", 0 as u64);
    if (expect(AppTraceSpan.parse(span.serialize()).name == "outer", "trace span round-trip")) { return 18; }

    world = AppPerfCounter.bump(world, "page", "frames", 7);
    if (expect(AppPerfCounter.value(world, "page", "frames") == 7, "perf counter")) { return 19; }

    // The retry queue is what turns a failure into something a user can retry.
    world = AppRetryQueue.schedule(world, "page", "sync.retry", diag);
    if (expect(AppRetryQueue.hasPending(world, "page"), "retry queue has work")) { return 20; }
    if (expect(AppRetryQueue.actionAt(world, "page", 0) == "sync.retry", "retry queue action")) { return 21; }

    // Presentation is derived from the diagnostic, so a new category cannot
    // silently ship without a title.
    if (expect(AppErrorPresenter.title(diag).len > 0, "error presenter title")) { return 22; }
    if (expect(AppErrorPresenter.present(diag).retry_label.len > 0, "error presenter retry label")) { return 23; }

    if (expect(AppDevInspector.summary(world, "page").len > 0, "dev inspector summary")) { return 24; }
    let panel = AppDevInspector.panel(world, "page");

    diag.destroy();
    info.destroy();
    round.destroy();
    panel.destroy();
    world.destroy();
    return 0;
}

// ---------------------------------------------------------------------------
// ZC-18 platform capability matrix
// ---------------------------------------------------------------------------

fn checkPlatformMatrix() -> i32 {
    var world = AppWorld.create();

    // The default table must already know where it stands: Windows verified for
    // IME, iOS not publishable, and the file picker unsupported everywhere.
    if (expect(AppPlatformMatrix.statusOf(world, appPlatformWindows(), appCapIme()) == appCapabilityVerified(),
        "windows ime is verified by default")) { return 1; }
    if (expect(AppPlatformMatrix.statusOf(world, appPlatformIOS(), appCapFilePicker()) != appCapabilityVerified(),
        "ios file picker is not verified")) { return 2; }
    if (expect(AppPlatformMatrix.isPublishable(world, appPlatformWindows()), "windows is publishable")) { return 3; }
    if (expect(!AppPlatformMatrix.isPublishable(world, appPlatformIOS()), "ios is not publishable")) { return 4; }

    // Marking a cell verified without evidence must be refused. This is the
    // one rule that keeps the matrix honest over years.
    match (AppPlatformMatrix.markVerified(world, appPlatformIOS(), appCapIme(), "")) {
        case Ok(_w) => { return 5; }
        case Err(_e) => { }
    }

    match (AppPlatformMatrix.releaseGate(world, appPlatformWindows())) {
        case Ok(_ok) => { }
        case Err(e) => { print("  " + e.message); return 6; }
    }
    match (AppPlatformMatrix.releaseGate(world, appPlatformIOS())) {
        case Ok(_ok) => { return 7; }
        case Err(e) => { if (expect(e.message.len > 0, "ios gate explains itself")) { return 8; } }
    }

    // An entry must round-trip: it is what gets shipped alongside a release.
    let entry = AppPlatformMatrix.entryOf(world, appPlatformWindows(), appCapIme());
    if (expect(entry.status == appCapabilityVerified(), "capability entry status")) { return 9; }
    let restored = AppCapabilityEntry.parse(entry.serialize());
    if (expect(restored.status == entry.status, "capability entry round-trip")) { return 10; }

    world.destroy();
    return 0;
}

// ---------------------------------------------------------------------------
// ZC-19 release and upgrade
// ---------------------------------------------------------------------------

fn checkRelease() -> i32 {
    var world = AppWorld.create();

    // Version ordering is numeric: "0.10.0" is newer than "0.9.0".
    let nine = AppVersion.parse("0.9.0");
    let ten = AppVersion.parse("0.10.0");
    if (expect(ten.isNewerThan(nine), "numeric version ordering")) { return 1; }
    if (expect(nine.toText() == "0.9.0", "version round-trip")) { return 2; }

    // A stable release needs real signing; beta does not.
    let signing = AppSigningConfig.unsigned().withKeyRef("keystore/release.jks");
    if (expect(signing.key_ref == "keystore/release.jks", "signing config key ref")) { return 3; }

    let spec = AppReleaseSpec.create("dev.vyx.zyn.services", AppVersion.parse("1.0.0"), appPlatformWindows());
    spec = spec.withChannel(appReleaseChannelStable());
    spec = spec.addArtifact(AppReleaseArtifact.create(appArtifactBinary(), "target/app.exe"));
    spec = spec.withSigning(signing);
    if (expect(spec.artifactCount() == 1, "release spec artifact count")) { return 4; }
    match (spec.validateForChannel()) {
        case Ok(_ok) => { return 5; }
        case Err(_e) => { }
    }
    if (expect(spec.digest().len > 0, "release digest")) { return 6; }

    // The manifest is what actually travels; it must decode back to the spec.
    let text = AppReleaseManifest.encode(spec);
    let decoded = AppReleaseManifest.decode(text);
    if (expect(decoded.digest() == spec.digest(), "manifest round-trip")) { return 7; }
    if (expect(AppReleaseManifest.platformOfName("windows-x64") == appPlatformWindows(), "platform name inverse")) { return 8; }

    // Upgrade: a forward step that migrates data is not a no-op, and the same
    // pair of versions must combine into a complete chain.
    let from = AppVersion.parse("1.0.0");
    let to = AppVersion.parse("1.1.0");
    let step = AppUpgradeStep.create(from, to, 1, 2, "schema bump");
    var plan = AppUpgradePlan.between(from, to, 1, 2);
    plan = plan.addStep(step);
    if (expect(plan.stepCount() == 1, "upgrade plan has one step")) { return 9; }
    if (expect(!plan.isNoop(), "forward upgrade is not a no-op")) { return 10; }
    if (expect(plan.requiresDataMigration(), "schema change migrates data")) { return 11; }
    if (expect(plan.isComplete(), "upgrade chain is connected")) { return 12; }

    // The crash-safe state machine: staging is not applying, and an interrupted
    // stage must be recoverable rather than left half-applied.
    match (AppUpgradeState.stage(world, "services", plan, from)) {
        case Ok(next) => { world = next; }
        case Err(e) => { print("  " + e.message); return 13; }
    }
    if (expect(AppUpgradeState.state(world, "services") != 0, "upgrade staged")) { return 14; }
    let recovered = AppUpgradeState.recoverIfInterrupted(world, "services");
    if (expect(recovered.intResource(AppUpgradeState.stateKey("services"), 0) != 0, "upgrade recoverable")) { return 15; }
    world = recovered;

    world = AppReleaseHistory.record(world, "services", to, appReleaseChannelBeta(), spec.digest());
    if (expect(AppReleaseHistory.count(world, "services") == 1, "release history records")) { return 16; }

    spec.destroy();
    decoded.destroy();
    plan.destroy();
    world.destroy();
    return 0;
}

// ---------------------------------------------------------------------------
// ZC-20 developer experience and compatibility
// ---------------------------------------------------------------------------

fn checkDevKit() -> i32 {
    var world = AppWorld.create();

    // Templates are data, so they can be asserted on without touching disk.
    let template = AppProjectTemplate.application("Demo");
    match (template.validate()) {
        case Ok(_ok) => { }
        case Err(e) => { print("  " + e.message); return 1; }
    }
    if (expect(template.fileCount() >= 2, "template has files")) { return 2; }
    if (expect(template.hasFile("Vyx.toml"), "template ships a manifest")) { return 3; }
    if (expect(template.countByRole(appTemplateFileSource()) == 1, "template ships one source file")) { return 4; }
    let reloaded = AppProjectTemplate.parse(template.serialize());
    if (expect(reloaded.fileCount() == template.fileCount(), "template round-trip")) { return 5; }
    if (expect(AppTemplateFile.parse(template.fileAt(0).serialize()).path == template.fileAt(0).path,
        "template file round-trip")) { return 6; }
    reloaded.destroy();
    template.destroy();

    // The catalog is the public surface; a library of samples must cover it in
    // both directions, and that check is enforced rather than documented.
    var catalog = AppComponentCatalog.defaultCatalog();
    var library = AppSampleLibrary.defaultLibrary();
    if (expect(catalog.count() > 0, "catalog is populated")) { return 7; }
    if (expect(catalog.documentedRatioMilli() == 1000, "every catalog entry is documented")) { return 8; }
    if (expect(catalog.indexOf("View") >= 0, "catalog contains View")) { return 9; }
    match (library.verify(catalog)) {
        case Ok(_n) => { }
        case Err(e) => { print("  " + e.message); return 10; }
    }
    if (expect(library.coverageRatioMilli(catalog) == 1000, "every component has a sample")) { return 11; }

    // Round-trip through the catalog, and confirm a duplicate is refused.
    let reparsed = AppComponentCatalog.parse(catalog.serialize());
    if (expect(reparsed.count() == catalog.count(), "catalog round-trip")) { return 12; }
    reparsed.destroy();
    var duplicate = catalog.dup();
    match (duplicate.registerOrFail(AppComponentEntry.create("View", "Zyn.App", appComponentInput(), appCatalogBaselineVersion(), "duplicate"))) {
        case Ok(_ok) => { return 13; }
        case Err(_e) => { }
    }
    duplicate.destroy();
    let entry = AppComponentEntry.parse(catalog.at(0).serialize());
    if (expect(entry.name == catalog.at(0).name, "catalog entry round-trip")) { return 14; }

    // The semantic tree parses the same text a headless test asserts on.
    world = world.registerAccessibility(AccessibilityNode.create("toolbar", "toolbar", "Toolbar", ""));
    world = world.registerAccessibility(AccessibilityNode.create("save", "button", "Save", "")
        .withParent("toolbar").withActions("click").withLevel(1));
    let count = AppSemanticTree.capture(world, "detail");
    if (expect(count == 2, "semantic tree captured both nodes")) { return 15; }
    if (expect(AppSemanticTree.indexOfId(world, "detail", "save") >= 0, "semantic tree finds by id")) { return 16; }
    if (expect(AppSemanticTree.interactiveCount(world, "detail") == 1, "semantic tree counts interactive nodes")) { return 17; }
    if (expect(AppSemanticTree.outlineText(world, "detail").len > 0, "semantic tree outline")) { return 18; }
    let node = AppSemanticTree.findById(world, "detail", "save");
    if (expect(node.parent_id == "toolbar", "semantic node parent survives parse")) { return 19; }
    if (expect(node.hasAction("click"), "semantic node action survives parse")) { return 20; }
    let panel = AppSemanticTree.panel(world, "detail");
    panel.destroy();

    // A parse of a hand-written descriptor must match what the world emits,
    // because that is the text tests are written against.
    let parsed = AppSemanticTree.parseLine("button save \"Save order\" state=enabled actions=click parent=toolbar level=1 focused");
    if (expect(parsed.role == "button", "descriptor role")) { return 21; }
    if (expect(parsed.id == "save", "descriptor id")) { return 22; }
    if (expect(parsed.label == "Save order", "descriptor label with spaces")) { return 23; }
    if (expect(parsed.parent_id == "toolbar", "descriptor parent")) { return 24; }
    if (expect(parsed.level == 1, "descriptor level")) { return 25; }
    if (expect(parsed.focused, "descriptor focused flag")) { return 26; }

    // Deprecation must state a replacement and a window, both enforced.
    var registry = AppDeprecationRegistry.empty();
    match (registry.declare(AppDeprecation.create("AppOldGrid", "0.9.0", "", "AppNewGrid"))) {
        case Ok(_ok) => { return 27; }
        case Err(_e) => { }
    }
    match (registry.declare(AppDeprecation.create("AppOldGrid", "0.9.0", "1.1.0", "AppNewGrid").withStage(appDeprecationWarning()))) {
        case Ok(_ok) => { }
        case Err(e) => { print("  " + e.message); return 28; }
    }
    let now = AppVersion.parse("1.1.0");
    if (expect(registry.expiredCount(now) == 1, "overdue deprecation detected")) { return 29; }
    match (registry.gate(now)) {
        case Ok(_n) => { return 30; }
        case Err(_e) => { }
    }
    let earlier = AppVersion.parse("1.0.0");
    match (registry.gate(earlier)) {
        case Ok(_n) => { }
        case Err(_e) => { return 31; }
    }
    registry.destroy();

    // Version compatibility: additions are fine, removals and signature
    // changes are not, and the roll-up says which.
    var baseline = AppApiSurface.fromCatalog(catalog);
    var current = baseline.dup();
    current = current.add("Zyn.App.AppNewThing", "members=4");
    let report = AppCompatChecker.compare(baseline, current);
    if (expect(report.addedCount() == 1, "new symbol counted as added")) { return 32; }
    if (expect(!report.isBreaking(), "an addition is not breaking")) { return 33; }
    match (report.gate("0.9.0", "0.10.0")) {
        case Ok(_n) => { }
        case Err(e) => { print("  " + e.message); return 34; }
    }
    report.destroy();

    // Removing one flips the verdict and fails the gate without a major bump.
    var shrunk = AppApiSurface.create(appCatalogBaselineVersion());
    shrunk = shrunk.add("Zyn.App.SomethingElse", "members=1");
    let removal = AppCompatChecker.compare(baseline, shrunk);
    if (expect(removal.isBreaking(), "removals are breaking")) { return 35; }
    match (removal.gate("0.9.0", "0.9.1")) {
        case Ok(_n) => { return 36; }
        case Err(_e) => { }
    }
    removal.destroy();
    shrunk.destroy();
    if (expect(AppCompatChange.parse(AppCompatChange.create("Zyn.App.X", 2).serialize()).symbol == "Zyn.App.X",
        "compat change round-trip")) { return 37; }

    baseline.destroy();
    current.destroy();
    library.destroy();
    catalog.destroy();
    world.destroy();
    return 0;
}

// ---------------------------------------------------------------------------
// ZC-21 performance and stability gate
// ---------------------------------------------------------------------------

fn checkPerfGate() -> i32 {
    var world = AppWorld.create();
    let machine = AppMachineProfile.create("ci-01", "windows", "ryzen", "d3d12", "qpc");
    let corpus = AppCorpus.combined();

    var suite = AppPerfSuite.create("services-smoke").withIdentity(machine, corpus);
    suite = suite.withBudget(AppPerfBudget.scrollFrame());

    // A representative run inside budget passes.
    var series = suite.seriesFor(0);
    series = series.withIdentity(machine, corpus);
    var i: i32 = 0;
    while (i < appPerfMinSamples() + 10) {
        world = series.record(world, 10000);
        i = i + 1;
    }
    if (expect(series.isRepresentative(world), "series is representative")) { return 1; }
    let verdict = appPerfGrade(series, suite.budgetAt(0), world);
    if (expect(verdict.isPass(), "in-budget series passes")) { return 2; }
    if (expect(verdict.sample_count == appPerfMinSamples() + 10, "verdict reports its sample count")) { return 3; }
    if (expect(AppPerfVerdict.parse(verdict.serialize()).observed_value == verdict.observed_value,
        "verdict round-trip")) { return 4; }

    // Too few samples fails rather than passing on three lucky frames.
    world = series.clear(world);
    i = 0;
    while (i < 3) {
        world = series.record(world, 1000);
        i = i + 1;
    }
    let thin = appPerfGrade(series, suite.budgetAt(0), world);
    if (expect(thin.isFail(), "a thin series fails instead of passing")) { return 5; }

    // Restore a real run and snapshot it as the baseline to compare against.
    world = series.clear(world);
    i = 0;
    while (i < appPerfMinSamples() + 10) {
        world = series.record(world, 10000);
        i = i + 1;
    }
    let baseline = AppPerfBaseline.of(series, world, "services-smoke", "0.9.0");
    if (expect(baseline.p95_value == series.p95(world), "baseline snapshots p95")) { return 6; }
    if (expect(AppPerfBaseline.parse(baseline.serialize()).p95_value == baseline.p95_value,
        "baseline round-trip")) { return 7; }

    // Same machine, same corpus => comparable, and unchanged is not a win.
    match (appPerfCompare(baseline, series, world)) {
        case Ok(cmp) => {
            if (expect(!cmp.isRegression(), "identical series is not a regression")) { return 8; }
            if (expect(!cmp.isImprovement(), "identical series is not an improvement")) { return 9; }
        }
        case Err(e) => { print("  " + e.message); return 10; }
    }

    // A different machine must be refused, not silently compared.
    let other_machine = AppMachineProfile.create("ci-02", "windows", "threadripper", "d3d12", "qpc");
    var moved = AppPerfSeries.create(appPerfScrollFrame(), appPerfScenarioScroll());
    moved = moved.withIdentity(other_machine, corpus);
    i = 0;
    while (i < appPerfMinSamples() + 10) {
        world = moved.record(world, 40000);
        i = i + 1;
    }
    match (appPerfCompare(baseline, moved, world)) {
        case Ok(_c) => { return 11; }
        case Err(_e) => { }
    }

    // A real regression is caught.
    var slower = AppPerfSeries.create(appPerfScrollFrame(), appPerfScenarioScroll());
    slower = slower.withIdentity(machine, corpus);
    i = 0;
    while (i < appPerfMinSamples() + 10) {
        world = slower.record(world, 40000);
        i = i + 1;
    }
    match (appPerfCompare(baseline, slower, world)) {
        case Ok(cmp) => {
            if (expect(cmp.isRegression(), "a 4x slowdown is a regression")) { return 12; }
        }
        case Err(_e) => { return 13; }
    }

    // The four stability scenarios, each with its own assertion.
    var idle = AppStabilityRun.create(appPerfScenarioIdle());
    idle.duration_us = 3600000000;
    idle.start_bytes = 100000000;
    idle.end_bytes = 100000000;
    if (expect(AppStabilityGate.check(idle).isOk(), "a non-growing idle run passes")) { return 14; }
    idle.end_bytes = 100000000 + AppStabilityGate.idleGrowthBudgetBytesPerHour();
    if (expect(AppStabilityGate.check(idle).isErr(), "an idle leak fails")) { return 15; }

    var gpu = AppStabilityRun.create(appPerfScenarioGpuLoss());
    gpu.recovered = true;
    gpu.frames = 120;
    if (expect(AppStabilityGate.check(gpu).isOk(), "a recovered gpu loss passes")) { return 16; }
    gpu.recovered = false;
    if (expect(AppStabilityGate.check(gpu).isErr(), "an unrecovered gpu loss fails")) { return 17; }

    var restore = AppStabilityRun.create(appPerfScenarioBackgroundRestore());
    restore.recovered = true;
    restore.state_revision_before = 100 as u64;
    restore.state_revision_after = 110 as u64;
    if (expect(AppStabilityGate.check(restore).isOk(), "a continuous restore passes")) { return 18; }
    restore.state_revision_after = 0 as u64;
    if (expect(AppStabilityGate.check(restore).isErr(), "a restarted session fails")) { return 19; }

    if (expect(AppStabilityRun.parse(idle.serialize()).scenario == appPerfScenarioIdle(),
        "stability run round-trip")) { return 20; }

    // The whole suite gate, now that every budget has real data behind it.
    suite = suite.withRun(AppStabilityRun.create(appPerfScenarioIdle()));
    if (expect(suite.runCount() == 1, "suite holds the run")) { return 21; }
    if (expect(suite.summaryText(world).len > 0, "suite summary")) { return 22; }
    if (expect(suite.reportText(world).len > 0, "suite report")) { return 23; }

    // Budget identity: the startup budget is the one that must not be graded
    // against a memory unit.
    if (expect(AppPerfBudget.startup().unit == 1, "startup budget is a latency budget")) { return 24; }
    if (expect(appPerfUnitForMetric(appPerfStartup()) == 1, "startup metric is measured in microseconds")) { return 25; }

    let sample = AppPerfSample.create(appPerfScrollFrame(), appPerfScenarioScroll(), 16600);
    if (expect(AppPerfSample.parse(sample.serialize()).value == 16600, "sample round-trip")) { return 26; }

    // A baseline is a plain record of numbers, so it has nothing to release;
    // only the suite - which owns two collection fields - needs destroying.
    suite.destroy();
    world.destroy();
    return 0;
}

fn main() -> i32 {
    print("zyn_services_smoke");

    let zc17 = checkDiagnostics();
    if (zc17 != 0) { return 100 + zc17; }

    let zc18 = checkPlatformMatrix();
    if (zc18 != 0) { return 200 + zc18; }

    let zc19 = checkRelease();
    if (zc19 != 0) { return 300 + zc19; }

    let zc20 = checkDevKit();
    if (zc20 != 0) { return 400 + zc20; }

    let zc21 = checkPerfGate();
    if (zc21 != 0) { return 500 + zc21; }

    print("all service checks passed");
    return 0;
}
