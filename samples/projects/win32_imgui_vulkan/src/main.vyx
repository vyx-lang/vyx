    fn igBegin(name: rawptr, p_open: rawptr, flags: i32) -> bool;
    fn igEnd();
    fn igSeparator();
    fn igSameLine(offset_from_start_x: f32, spacing: f32);
    fn igText(fmt: rawptr, ...args: rawptr);
    fn igCheckbox(label: rawptr, v: rawptr) -> bool;
    fn igSliderFloat(label: rawptr, v: rawptr, v_min: f32, v_max: f32, format: rawptr, flags: i32) -> bool;
    fn igColorEdit4(label: rawptr, col: rawptr, flags: i32) -> bool;
    fn ImGuiIO_AddMousePosEvent(io: rawptr, x: f32, y: f32);
    fn ImGuiIO_AddMouseButtonEvent(io: rawptr, button: i32, down: bool);
    fn ImGuiIO_AddFocusEvent(io: rawptr, focused: bool);

    fn ImGui_ImplVulkanH_CreateOrResizeWindow(instance: rawptr, physical_device: rawptr, device: rawptr, wd: rawptr, queue_family: u32, allocator: rawptr, w: i32, h: i32, min_image_count: u32, image_usage: u32);
    fn ImGui_ImplVulkanH_DestroyWindow(instance: rawptr, device: rawptr, wd: rawptr, allocator: rawptr);
    fn ImGui_ImplVulkan_Init(info: rawptr) -> bool;
    fn ImGui_ImplVulkan_NewFrame();
    fn ImGui_ImplVulkan_RenderDrawData(draw_data: rawptr, command_buffer: rawptr, pipeline: rawptr);
    fn ImGui_ImplVulkan_SetMinImageCount(min_image_count: u32);
    fn ImGui_ImplVulkan_Shutdown();
}

let PM_REMOVE: u32 = 1;
let WM_QUIT: u32 = 18;
let WM_SIZE: u32 = 5;
let SIZE_MINIMIZED: u64 = 1;
let VK_LBUTTON: i32 = 1;
let VK_RBUTTON: i32 = 2;
let VK_MBUTTON: i32 = 4;

let ST_APPLICATION_INFO: u32 = 0;
let ST_INSTANCE_CREATE_INFO: u32 = 1;
let ST_DEVICE_QUEUE_CREATE_INFO: u32 = 2;
let ST_DEVICE_CREATE_INFO: u32 = 3;
let ST_SUBMIT_INFO: u32 = 4;
let ST_COMMAND_BUFFER_BEGIN_INFO: u32 = 42;
let ST_RENDER_PASS_BEGIN_INFO: u32 = 43;
let ST_WIN32_SURFACE_CREATE_INFO_KHR: u32 = 1000009000;
let ST_PRESENT_INFO_KHR: u32 = 1000001001;

let VK_API_VERSION_1_0: u32 = 4194304;
let VK_SUCCESS: i32 = 0;
let VK_SUBOPTIMAL_KHR: i32 = 1000001003;
let VK_ERROR_OUT_OF_DATE_KHR: i32 = -1000001004;
let VK_TRUE: u32 = 1;
let WAIT_NS_ONE_SEC: u64 = 1000000000;
let COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT: u32 = 1;
let PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT: u32 = 1024;
let SUBPASS_CONTENTS_INLINE: u32 = 0;
let VK_SAMPLE_COUNT_1_BIT: u32 = 1;

let FORMAT_B8G8R8A8_UNORM: u32 = 44;
let COLORSPACE_SRGB_NONLINEAR_KHR: u32 = 0;
let PRESENT_MODE_FIFO_KHR: u32 = 2;

let IMGUI_WINDOW_FLAGS_NONE: i32 = 0;
let IMGUI_CONFIG_FLAGS_NONE: i32 = 0;
let IMGUI_COLOR_EDIT_FLAGS_NONE: i32 = 0;

let WIN_W: i32 = 1280;
let WIN_H: i32 = 800;
let MIN_IMAGE_COUNT: u32 = 2;

var g_resize_pending: bool = false;
var g_resize_w: i32 = WIN_W;
var g_resize_h: i32 = WIN_H;

var show_demo_window: bool = true;
var show_metrics: bool = true;
var click_count: i32 = 0;

fn p_off(p: rawptr, off: i64) -> rawptr {
    return p + (off as i32);
}

fn zalloc(n: i64) -> rawptr {
    let p = malloc(n as u64);
    if (p != null) { memset(p, 0, n as u64); }
    return p;
}

fn w_u32(p: rawptr, off: i64, v: u32) {
    var x: u32 = v;
    memcpy(p_off(p, off), to_rawptr(&x), 4);
}

fn w_i32(p: rawptr, off: i64, v: i32) {
    var x: i32 = v;
    memcpy(p_off(p, off), to_rawptr(&x), 4);
}

fn w_u64(p: rawptr, off: i64, v: u64) {
    var x: u64 = v;
    memcpy(p_off(p, off), to_rawptr(&x), 8);
}

fn w_f32(p: rawptr, off: i64, v: f32) {
    var x: f32 = v;
    memcpy(p_off(p, off), to_rawptr(&x), 4);
}

fn w_ptr(p: rawptr, off: i64, v: rawptr) {
    var x: rawptr = v;
    memcpy(p_off(p, off), to_rawptr(&x), 8);
}

fn r_i32(p: rawptr, off: i64) -> i32 {
    var x: i32 = 0;
    memcpy(to_rawptr(&x), p_off(p, off), 4);
    return x;
}

fn r_u32(p: rawptr, off: i64) -> u32 {
    var x: u32 = 0;
    memcpy(to_rawptr(&x), p_off(p, off), 4);
    return x;
}

fn r_f32(p: rawptr, off: i64) -> f32 {
    var x: f32 = 0.0;
    memcpy(to_rawptr(&x), p_off(p, off), 4);
    return x;
}

fn r_ptr(p: rawptr, off: i64) -> rawptr {
    var x: rawptr = null;
    memcpy(to_rawptr(&x), p_off(p, off), 8);
    return x;
}

fn vk_check(label: string, rc: i32) -> bool {
    if (rc != VK_SUCCESS) {
        print("[win32_imgui_vulkan] Vulkan error ${label} rc=${rc}");
        return false;
    }
    return true;
}

fn color_wave01(frame: i32, offset: i32, period: i32) -> f32 {
    var x: i32 = (frame + offset) % period;
    if (x < 0) { x = x + period; }
    let half: i32 = period / 2;
    if (x <= half) { return (x as f32) / (half as f32); }
    return ((period - x) as f32) / (half as f32);
}

fn win_proc(hwnd: rawptr, msg: u32, wparam: u64, lparam: i64) -> rawptr {
    if (msg == WM_SIZE) {
        if (wparam != SIZE_MINIMIZED) {
            g_resize_w = (lparam & 65535) as i32;
            g_resize_h = ((lparam >> 16) & 65535) as i32;
            if (g_resize_w > 0 && g_resize_h > 0) {
                g_resize_pending = true;
            }
        }
        return null;
    }
    if (msg == WM_DESTROY) {
        PostQuitMessage(0);
        return null;
    }
    if (msg == WM_CLOSE) {
        DestroyWindow(hwnd);
        return null;
    }
    return DefWindowProcA(hwnd, msg, wparam, lparam);
}

fn make_window(hinstance: rawptr, title: string, w: i32, h: i32) -> rawptr {
    let class_name = "VyxImguiVulkanCls";
    let wc = zalloc(80);
    w_u32(wc, 0, 80);
    w_ptr(wc, 8, win_proc as rawptr);
    w_ptr(wc, 24, hinstance);
    w_ptr(wc, 64, class_name.c_str());

    let atom = RegisterClassExA(wc);
    free(wc);
    if (atom == 0) {
        print("[win32_imgui_vulkan] RegisterClassExA failed");
        return null;
    }

    let hwnd = CreateWindowExA(
        0,
        class_name.c_str(),
        title.c_str(),
        WS_OVERLAPPEDWINDOW | WS_VISIBLE,
        100, 100, w, h,
        null, null, hinstance, null);
    if (hwnd == null) {
        print("[win32_imgui_vulkan] CreateWindowExA failed");
        return null;
    }
    ShowWindow(hwnd, SW_SHOW);
    UpdateWindow(hwnd);
    return hwnd;
}

fn pump_messages() -> bool {
    let msg = zalloc(48);
    var alive: bool = true;
    var done: bool = false;
    while (!done) {
        let r = PeekMessageA(msg, null, 0, 0, PM_REMOVE);
        if (r == 0) {
            done = true;
        } else {
            let m = r_u32(msg, 8);
            if (m == WM_QUIT) { alive = false; }
            TranslateMessage(msg);
            DispatchMessageA(msg);
        }
    }
    free(msg);
    return alive;
}

fn create_instance() -> rawptr {
    let ai = zalloc(48);
    w_u32(ai, 0, ST_APPLICATION_INFO);
    w_ptr(ai, 16, "VyxImguiVulkan".c_str());
    w_u32(ai, 24, 1);
    w_ptr(ai, 32, "VyxLan".c_str());
    w_u32(ai, 40, 1);
    w_u32(ai, 44, VK_API_VERSION_1_0);

    var ext_names: [rawptr; 2];
    ext_names[0] = "VK_KHR_surface".c_str();
    ext_names[1] = "VK_KHR_win32_surface".c_str();

    let ici = zalloc(64);
    w_u32(ici, 0, ST_INSTANCE_CREATE_INFO);
    w_ptr(ici, 24, ai);
    w_u32(ici, 48, 2);
    w_ptr(ici, 56, to_rawptr(&ext_names));

    var instance: rawptr = null;
    let rc = vkCreateInstance(ici, null, to_rawptr(&instance));
    free(ai);
    free(ici);
    if (!vk_check("vkCreateInstance", rc)) { return null; }
    return instance;
}

fn create_win32_surface(instance: rawptr, hinstance: rawptr, hwnd: rawptr) -> rawptr {
    let ci = zalloc(40);
    w_u32(ci, 0, ST_WIN32_SURFACE_CREATE_INFO_KHR);
    w_ptr(ci, 24, hinstance);
    w_ptr(ci, 32, hwnd);
    var surface: rawptr = null;
    let rc = vkCreateWin32SurfaceKHR(instance, ci, null, to_rawptr(&surface));
    free(ci);
    if (!vk_check("vkCreateWin32SurfaceKHR", rc)) { return null; }
    return surface;
}

fn pick_physical_device(instance: rawptr) -> rawptr {
    var count: u32 = 0;
    vkEnumeratePhysicalDevices(instance, to_rawptr(&count), null);
    if (count == 0) {
        print("[win32_imgui_vulkan] no Vulkan physical devices");
        return null;
    }
    if (count > 8) { count = 8; }
    var devices: [rawptr; 8];
    var i: i64 = 0;
    while (i < 8) {
        devices[i] = null;
        i = i + 1;
    }
    vkEnumeratePhysicalDevices(instance, to_rawptr(&count), to_rawptr(&devices));
    return devices[0];
}

fn find_graphics_present_family(phys: rawptr, surface: rawptr) -> i32 {
    var qf_count: u32 = 0;
    vkGetPhysicalDeviceQueueFamilyProperties(phys, to_rawptr(&qf_count), null);
    if (qf_count == 0) { return -1; }
    if (qf_count > 16) { qf_count = 16; }
    let qfp = zalloc((qf_count as i64) * 24);
    vkGetPhysicalDeviceQueueFamilyProperties(phys, to_rawptr(&qf_count), qfp);
    var i: i32 = 0;
    var found: i32 = -1;
    while ((i as u32) < qf_count && found < 0) {
        let flags = r_u32(qfp, (i as i64) * 24);
        var present: u32 = 0;
        vkGetPhysicalDeviceSurfaceSupportKHR(phys, i as u32, surface, to_rawptr(&present));
        if ((flags & 1) != 0 && present != 0) { found = i; }
        i = i + 1;
    }
    free(qfp);
    return found;
}

fn create_logical_device(phys: rawptr, qfi: u32) -> rawptr {
    var prio: f32 = 1.0;
    let qci = zalloc(40);
    w_u32(qci, 0, ST_DEVICE_QUEUE_CREATE_INFO);
    w_u32(qci, 20, qfi);
    w_u32(qci, 24, 1);
    w_ptr(qci, 32, to_rawptr(&prio));

    var dev_exts: [rawptr; 1];
    dev_exts[0] = "VK_KHR_swapchain".c_str();

    let dci = zalloc(72);
    w_u32(dci, 0, ST_DEVICE_CREATE_INFO);
    w_u32(dci, 20, 1);
    w_ptr(dci, 24, qci);
    w_u32(dci, 48, 1);
    w_ptr(dci, 56, to_rawptr(&dev_exts));

    var dev: rawptr = null;
    let rc = vkCreateDevice(phys, dci, null, to_rawptr(&dev));
    free(qci);
    free(dci);
    if (!vk_check("vkCreateDevice", rc)) { return null; }
    return dev;
}

fn setup_imgui_io(io: rawptr, hwnd: rawptr, width: i32, height: i32, dt: f32) {
    w_i32(io, 0, IMGUI_CONFIG_FLAGS_NONE);
    w_f32(io, 8, width as f32);
    w_f32(io, 12, height as f32);
    w_f32(io, 16, 1.0);
    w_f32(io, 20, 1.0);
    w_f32(io, 24, dt);
    w_ptr(io, 32, null);

    let pt = zalloc(8);
    if (GetCursorPos(pt) != 0) {
        ScreenToClient(hwnd, pt);
        ImGuiIO_AddMousePosEvent(io, r_i32(pt, 0) as f32, r_i32(pt, 4) as f32);
    }
    free(pt);
    ImGuiIO_AddMouseButtonEvent(io, 0, (GetAsyncKeyState(VK_LBUTTON) as i32) < 0);
    ImGuiIO_AddMouseButtonEvent(io, 1, (GetAsyncKeyState(VK_RBUTTON) as i32) < 0);
    ImGuiIO_AddMouseButtonEvent(io, 2, (GetAsyncKeyState(VK_MBUTTON) as i32) < 0);
    ImGuiIO_AddFocusEvent(io, GetForegroundWindow() == hwnd);
}

fn setup_imgui_window(wd: rawptr, instance: rawptr, phys: rawptr, dev: rawptr, surface: rawptr, qfi: u32, w: i32, h: i32) {
    w_ptr(wd, 8, surface);
    w_u32(wd, 16, FORMAT_B8G8R8A8_UNORM);
    w_u32(wd, 20, COLORSPACE_SRGB_NONLINEAR_KHR);
    w_u32(wd, 24, PRESENT_MODE_FIFO_KHR);
    ImGui_ImplVulkanH_CreateOrResizeWindow(instance, phys, dev, wd, qfi, null, w, h, MIN_IMAGE_COUNT, 0);
}

fn setup_imgui_renderer(instance: rawptr, phys: rawptr, dev: rawptr, queue: rawptr, qfi: u32, wd: rawptr) -> bool {
    igCreateContext(null);
    igStyleColorsDark(null);

    let info = zalloc(352);
    w_u32(info, 0, VK_API_VERSION_1_0);
    w_ptr(info, 8, instance);
    w_ptr(info, 16, phys);
    w_ptr(info, 24, dev);
    w_u32(info, 32, qfi);
    w_ptr(info, 40, queue);
    w_ptr(info, 48, null);
    w_u32(info, 56, 16);
    w_u32(info, 60, MIN_IMAGE_COUNT);
    w_u32(info, 64, r_u32(wd, 108));
    w_ptr(info, 72, null);
    w_ptr(info, 80, r_ptr(wd, 96));
    w_u32(info, 88, 0);
    w_u32(info, 92, VK_SAMPLE_COUNT_1_BIT);
    w_u32(info, 240, 0);
    w_ptr(info, 248, null);
    w_ptr(info, 256, null);
    w_u64(info, 264, 0);

    let ok = ImGui_ImplVulkan_Init(info);
    free(info);
    if (!ok) { print("[win32_imgui_vulkan] ImGui_ImplVulkan_Init failed"); }
    return ok;
}

fn frame_ptr(wd: rawptr, index: u32) -> rawptr {
    let frames_data = r_ptr(wd, 128);
    return p_off(frames_data, (index as i64) * 48);
}

fn frame_sem_ptr(wd: rawptr, index: u32) -> rawptr {
    let sem_data = r_ptr(wd, 144);
    return p_off(sem_data, (index as i64) * 16);
}

fn render_imgui_frame(dev: rawptr, queue: rawptr, wd: rawptr, draw_data: rawptr) -> bool {
    let sem_index = r_u32(wd, 116);
    let sem = frame_sem_ptr(wd, sem_index);
    let image_acquired = r_ptr(sem, 0);
    let render_complete = r_ptr(sem, 8);
    let swap = r_ptr(wd, 88);

    let acquire_rc = vkAcquireNextImageKHR(dev, swap, WAIT_NS_ONE_SEC, image_acquired, null, p_off(wd, 104));
    if (acquire_rc == VK_ERROR_OUT_OF_DATE_KHR || acquire_rc == VK_SUBOPTIMAL_KHR) {
        g_resize_pending = true;
        return false;
    }
    if (!vk_check("vkAcquireNextImageKHR", acquire_rc)) { return false; }

    let image_index = r_u32(wd, 104);
    let fd = frame_ptr(wd, image_index);
    let command_pool = r_ptr(fd, 0);
    let command_buffer = r_ptr(fd, 8);
    let fence = r_ptr(fd, 16);

    var fence_arr: [rawptr; 1];
    fence_arr[0] = fence;
    if (!vk_check("vkWaitForFences", vkWaitForFences(dev, 1, to_rawptr(&fence_arr), VK_TRUE, WAIT_NS_ONE_SEC))) { return false; }
    if (!vk_check("vkResetFences", vkResetFences(dev, 1, to_rawptr(&fence_arr)))) { return false; }
    if (!vk_check("vkResetCommandPool", vkResetCommandPool(dev, command_pool, 0))) { return false; }

    let begin = zalloc(32);
    w_u32(begin, 0, ST_COMMAND_BUFFER_BEGIN_INFO);
    w_u32(begin, 16, COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT);
    let brc = vkBeginCommandBuffer(command_buffer, begin);
    free(begin);
    if (!vk_check("vkBeginCommandBuffer", brc)) { return false; }

    let rp = zalloc(64);
    w_u32(rp, 0, ST_RENDER_PASS_BEGIN_INFO);
    w_ptr(rp, 16, r_ptr(wd, 96));
    w_ptr(rp, 24, r_ptr(fd, 40));
    w_i32(rp, 32, 0);
    w_i32(rp, 36, 0);
    w_u32(rp, 40, r_u32(wd, 80));
    w_u32(rp, 44, r_u32(wd, 84));
    w_u32(rp, 48, 1);
    w_ptr(rp, 56, p_off(wd, 64));
    vkCmdBeginRenderPass(command_buffer, rp, SUBPASS_CONTENTS_INLINE);
    free(rp);

    ImGui_ImplVulkan_RenderDrawData(draw_data, command_buffer, null);
    vkCmdEndRenderPass(command_buffer);

    if (!vk_check("vkEndCommandBuffer", vkEndCommandBuffer(command_buffer))) { return false; }

    var wait_stage: u32 = PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
    var wait_arr: [rawptr; 1];
    wait_arr[0] = image_acquired;
    var sig_arr: [rawptr; 1];
    sig_arr[0] = render_complete;
    var cb_arr: [rawptr; 1];
    cb_arr[0] = command_buffer;

    let submit = zalloc(72);
    w_u32(submit, 0, ST_SUBMIT_INFO);
    w_u32(submit, 16, 1);
    w_ptr(submit, 24, to_rawptr(&wait_arr));
    w_ptr(submit, 32, to_rawptr(&wait_stage));
    w_u32(submit, 40, 1);
    w_ptr(submit, 48, to_rawptr(&cb_arr));
    w_u32(submit, 56, 1);
    w_ptr(submit, 64, to_rawptr(&sig_arr));
    let src = vkQueueSubmit(queue, 1, submit, fence);
    free(submit);
    if (!vk_check("vkQueueSubmit", src)) { return false; }

    var swap_arr: [rawptr; 1];
    swap_arr[0] = swap;
    var present_idx: u32 = image_index;
    let present = zalloc(64);
    w_u32(present, 0, ST_PRESENT_INFO_KHR);
    w_u32(present, 16, 1);
    w_ptr(present, 24, to_rawptr(&sig_arr));
    w_u32(present, 32, 1);
    w_ptr(present, 40, to_rawptr(&swap_arr));
    w_ptr(present, 48, to_rawptr(&present_idx));
    let prc = vkQueuePresentKHR(queue, present);
    free(present);
    if (prc == VK_ERROR_OUT_OF_DATE_KHR || prc == VK_SUBOPTIMAL_KHR) {
        g_resize_pending = true;
        return true;
    }
    if (!vk_check("vkQueuePresentKHR", prc)) { return false; }

    let sem_count = r_u32(wd, 112);
    if (sem_count > 0) {
        w_u32(wd, 116, (sem_index + 1) % sem_count);
    }
    return true;
}

fn update_clear_color(color: rawptr, frame: i32) {
    w_f32(color, 0, (0.10 as f32) + (0.70 as f32) * color_wave01(frame, 0, 240));
    w_f32(color, 4, (0.16 as f32) + (0.55 as f32) * color_wave01(frame, 80, 240));
    w_f32(color, 8, (0.20 as f32) + (0.70 as f32) * color_wave01(frame, 160, 240));
    w_f32(color, 12, 1.0);
}

fn draw_vyx_ui(frame: i32, width: i32, height: i32, slider_ptr: rawptr, color_ptr: rawptr) {
    if (show_demo_window) {
        igShowDemoWindow(to_rawptr(&show_demo_window));
    }

    igBegin("Vyx native ImGui/Vulkan".c_str(), null, IMGUI_WINDOW_FLAGS_NONE);
    igText("All app state and frame logic are running in Vyx.".c_str());
    igText("Frame %d   framebuffer %d x %d".c_str(), frame, width, height);
    igSeparator();
    igCheckbox("Show Dear ImGui demo".c_str(), to_rawptr(&show_demo_window));
    igCheckbox("Show runtime metrics".c_str(), to_rawptr(&show_metrics));
    igSliderFloat("Vyx slider".c_str(), slider_ptr, 0.0 as f32, 1.0 as f32, "%.3f".c_str(), 0);
    igColorEdit4("Clear color".c_str(), color_ptr, IMGUI_COLOR_EDIT_FLAGS_NONE);
    if (show_metrics) {
        let fps: f64 = 60.0;
        igText("counter=%d slider=%.3f target_fps=%.1f".c_str(), click_count, r_f32(slider_ptr, 0) as f64, fps);
    }
    igSameLine(0.0 as f32, 12.0 as f32);
    igText("Vyx varargs FFI: %d %.2f".c_str(), 42, 3.14159);
    igEnd();
}

fn main() -> i32 {
    var slider_value: f32 = 0.35;
    var clear_color: [f32; 4];
    clear_color[0] = 0.10;
    clear_color[1] = 0.18;
    clear_color[2] = 0.30;
    clear_color[3] = 1.0;

    print("[win32_imgui_vulkan] starting Vyx-owned app");
    let hinstance = GetModuleHandleA(null);
    let hwnd = make_window(hinstance, "Vyx . ImGui + Vulkan", WIN_W, WIN_H);
    if (hwnd == null) { return 10; }

    let instance = create_instance();
    if (instance == null) { DestroyWindow(hwnd); return 11; }

    let surface = create_win32_surface(instance, hinstance, hwnd);
    if (surface == null) {
        vkDestroyInstance(instance, null);
        DestroyWindow(hwnd);
        return 12;
    }

    let phys = pick_physical_device(instance);
    if (phys == null) {
        vkDestroySurfaceKHR(instance, surface, null);
        vkDestroyInstance(instance, null);
        DestroyWindow(hwnd);
        return 13;
    }

    let qfi_i = find_graphics_present_family(phys, surface);
    if (qfi_i < 0) {
        print("[win32_imgui_vulkan] no graphics+present queue family");
        vkDestroySurfaceKHR(instance, surface, null);
        vkDestroyInstance(instance, null);
        DestroyWindow(hwnd);
        return 14;
    }
    let qfi = qfi_i as u32;
    let dev = create_logical_device(phys, qfi);
    if (dev == null) {
        vkDestroySurfaceKHR(instance, surface, null);
        vkDestroyInstance(instance, null);
        DestroyWindow(hwnd);
        return 15;
    }

    var queue: rawptr = null;
    vkGetDeviceQueue(dev, qfi, 0, to_rawptr(&queue));

    let wd = zalloc(152);
    setup_imgui_window(wd, instance, phys, dev, surface, qfi, WIN_W, WIN_H);
    if (!setup_imgui_renderer(instance, phys, dev, queue, qfi, wd)) {
        ImGui_ImplVulkanH_DestroyWindow(instance, dev, wd, null);
        free(wd);
        vkDestroyDevice(dev, null);
        vkDestroySurfaceKHR(instance, surface, null);
        vkDestroyInstance(instance, null);
        DestroyWindow(hwnd);
        return 16;
    }

    var frame: i32 = 0;
    var alive: bool = true;
    while (alive) {
        if (!pump_messages()) { alive = false; }
        if (alive && win_key_pressed(VK_ESCAPE)) { alive = false; }

        if (alive && g_resize_pending) {
            vkDeviceWaitIdle(dev);
            ImGui_ImplVulkan_SetMinImageCount(MIN_IMAGE_COUNT);
            setup_imgui_window(wd, instance, phys, dev, surface, qfi, g_resize_w, g_resize_h);
            w_u32(wd, 104, 0);
            g_resize_pending = false;
        }

        if (alive) {
            let width = r_u32(wd, 80) as i32;
            let height = r_u32(wd, 84) as i32;
            setup_imgui_io(igGetIO_Nil(), hwnd, width, height, 0.0166667);
            update_clear_color(to_rawptr(&clear_color), frame);

            ImGui_ImplVulkan_NewFrame();
            igNewFrame();
            draw_vyx_ui(frame, width, height, to_rawptr(&slider_value), to_rawptr(&clear_color));
            igRender();

            w_f32(wd, 64, clear_color[0]);
            w_f32(wd, 68, clear_color[1]);
            w_f32(wd, 72, clear_color[2]);
            w_f32(wd, 76, clear_color[3]);

            if (!render_imgui_frame(dev, queue, wd, igGetDrawData())) {
                alive = false;
            }
            frame = frame + 1;
        }
    }

    print("[win32_imgui_vulkan] frames rendered = ${frame}");
    vkDeviceWaitIdle(dev);
    ImGui_ImplVulkan_Shutdown();
    igDestroyContext(null);
    ImGui_ImplVulkanH_DestroyWindow(instance, dev, wd, null);
    free(wd);
    vkDestroyDevice(dev, null);
    vkDestroySurfaceKHR(instance, surface, null);
    vkDestroyInstance(instance, null);
    DestroyWindow(hwnd);
    print("[win32_imgui_vulkan] clean exit");
    return 0;
}
