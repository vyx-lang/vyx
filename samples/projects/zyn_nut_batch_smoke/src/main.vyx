        .fillRect(Rectangle.xywh(0.0, 0.0, 100.0, 100.0), red)
        .pushClipRect(Rectangle.xywh(20.0, 20.0, 40.0, 40.0))
        .fillRect(Rectangle.xywh(0.0, 0.0, 100.0, 100.0), blue)
        .popClip()
        .pushTransform(Transform2D.translation(100.0, 0.0))
        .fillCircle(Circle.xy(20.0, 20.0, 10.0), red)
        .popTransform()
        .strokeRect(Rectangle.xywh(200.0, 20.0, 40.0, 40.0), 4.0, blue);
    if (hit_graph.hitTest(Point.xy(30.0, 30.0)) != 2) { hit_graph.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 104; }
    if (hit_graph.hitTest(Point.xy(10.0, 10.0)) != 0) { hit_graph.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 105; }
    if (hit_graph.hitTest(Point.xy(120.0, 20.0)) != 5) { hit_graph.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 106; }
    if (hit_graph.hitTest(Point.xy(220.0, 40.0)) != -1) { hit_graph.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 107; }
    if (hit_graph.hitTest(Point.xy(200.0, 40.0)) != 7 || !hit_graph.containsPoint(Point.xy(30.0, 30.0))) { hit_graph.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 108; }
    hit_graph.destroy();

    let first = graph.commandAt(1);
    if (!first.kind.equals(RenderCommandKind.fillRect())) { graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 7; }

    var batch = SolidBatch.create(graph.estimatedVertexCount());
    var i: i32 = 0;
    while (i < graph.commandCount()) {
        let command = graph.commandAt(i);
        if (command.kind.equals(RenderCommandKind.fillRect())) {
            batch.addRect(command.rect, command.color, 200.0, 100.0);
        }
        if (command.kind.equals(RenderCommandKind.fillCircle())) {
            batch.addCircle(command.circle, command.color, 200.0, 100.0);
        }
        if (command.kind.equals(RenderCommandKind.fillTriangle())) {
            batch.addTriangle(command.triangle.a, command.triangle.b, command.triangle.c, command.color, 200.0, 100.0);
        }
        if (command.kind.equals(RenderCommandKind.fillQuad())) {
            batch.addQuad(command.quad, command.color, 200.0, 100.0);
        }
        if (command.kind.equals(RenderCommandKind.fillGradientRect())) {
            batch.addGradientRect(command.rect, command.gradient, 200.0, 100.0);
        }
        if (command.kind.equals(RenderCommandKind.drawSprite())) {
            batch.addQuad(command.sprite.quad(), command.sprite.tint, 200.0, 100.0);
        }
        if (command.kind.equals(RenderCommandKind.strokeLine())) {
            batch.addLine(command.line, command.color, 200.0, 100.0);
        }
        if (command.kind.equals(RenderCommandKind.strokeRect())) {
            batch.addStrokeRect(command.rect, command.stroke_width, command.color, 200.0, 100.0);
        }
        i = i + 1;
    }

    if (batch.hasOverflowed()) { batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 8; }
    if (batch.vertexCount() != graph.estimatedVertexCount()) { batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 9; }

    let v0 = batch.vertexAt(0);
    if (!near(v0.x, -1.0) || !near(v0.y, -1.0)) { batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 10; }
    if (!near(v0.r, red.r) || !near(v0.g, red.g) || !near(v0.b, red.b) || !near(v0.a, red.a)) {
        batch.destroy();
        graph.destroy();
        atlas.destroy();
        concave.destroy();
        rounded.destroy();
        curve.destroy();
        path.destroy();
        canvas.destroy();
        return 11;
    }

    let v5 = batch.vertexAt(5);
    if (!near(v5.x, 0.0) || !near(v5.y, 0.0)) { batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 12; }

    var textured = TexturedBatch.create(6);
    textured.addSprite(Sprite.create(icon, Rectangle.xywh(0.0, 0.0, 64.0, 64.0), Color.rgba(1.0, 0.8, 0.3, 0.8)), Quad.fromRect(Rectangle.xywh(0.0, 0.0, 64.0, 64.0)), 128.0, 128.0);
    if (textured.hasOverflowed() || textured.vertexCount() != 6) { textured.destroy(); batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 43; }
    let tv0 = textured.vertexAt(0);
    let tv2 = textured.vertexAt(2);
    if (!near(tv0.x, -1.0) || !near(tv0.y, -1.0) || !near(tv0.u, icon.u1()) || !near(tv0.v, icon.v0())) { textured.destroy(); batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 44; }
    if (!near(tv2.x, 0.0) || !near(tv2.y, 0.0) || !near(tv2.u, icon.u0()) || !near(tv2.v, icon.v1()) || !near(tv2.layer, icon.atlas_id as f32)) { textured.destroy(); batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 45; }
    if (!near(tv2.r, 1.0) || !near(tv2.g, 0.8) || !near(tv2.b, 0.3) || !near(tv2.a, 0.8)) { textured.destroy(); batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 46; }

    var tiny = SolidBatch.create(6);
    tiny.addRect(Rectangle.xywh(0.0, 0.0, 20.0, 20.0), red, 200.0, 100.0);
    tiny.addRect(Rectangle.xywh(30.0, 30.0, 20.0, 20.0), red, 200.0, 100.0);
    if (!tiny.hasOverflowed()) { tiny.destroy(); batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 13; }
    if (tiny.vertexCount() != 6) { tiny.destroy(); batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 14; }

    var partial = SolidBatch.create(6);
    partial.addCircle(Circle.xy(40.0, 40.0, 16.0), blue, 200.0, 100.0);
    if (!partial.hasOverflowed()) { partial.destroy(); tiny.destroy(); batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 15; }
    if (partial.vertexCount() != 0) { partial.destroy(); tiny.destroy(); batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 16; }

    var partial_rect = SolidBatch.create(18);
    partial_rect.addStrokeRect(Rectangle.xywh(0.0, 0.0, 40.0, 30.0), 2.0, red, 200.0, 100.0);
    if (!partial_rect.hasOverflowed()) { partial_rect.destroy(); partial.destroy(); tiny.destroy(); batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 17; }
    if (partial_rect.vertexCount() != 0) { partial_rect.destroy(); partial.destroy(); tiny.destroy(); batch.destroy(); graph.destroy(); atlas.destroy(); concave.destroy(); rounded.destroy(); curve.destroy(); path.destroy(); canvas.destroy(); return 18; }

    partial_rect.destroy();
    textured.destroy();
    atlas.destroy();
    concave.destroy();
    rounded.destroy();
    curve.destroy();
    path.destroy();
    partial.destroy();
    tiny.destroy();
    batch.destroy();
    graph.destroy();
    canvas.destroy();
    return 0;
}
