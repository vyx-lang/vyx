fn near(a: f32, b: f32) -> bool {
    let d = a - b;
    if (d < -0.0001) { return false; }
    if (d > 0.0001) { return false; }
    return true;
}

fn smoke_scene_api() -> i32 {
    var builder = PathBuilder.create()
        .moveTo(Point.xy(12.0, 16.0))
        .lineTo(Point.xy(74.0, 20.0))
        .lineTo(Point.xy(38.0, 80.0))
        .close();
    let path = builder.build();
    if (builder.pointCount() != 3) {
        path.destroy();
        builder.destroy();
        return 410;
    }
    if (path.pointCount() != 3) {
        path.destroy();
        builder.destroy();
        return 414;
    }
    if (!path.isClosed()) {
        path.destroy();
        builder.destroy();
        return 415;
    }

    let gradient_paint = Paint.fillGradient(LinearGradient.horizontal(
        Color.rgba(0.2, 0.8, 1.0, 1.0),
        Color.rgba(1.0, 0.35, 0.45, 1.0)));
    let fill_paint = Paint.fill(Color.rgba(0.95, 0.90, 0.25, 1.0));

    var scene = SceneBuilder.create();
    scene = scene.clear(Color.rgba(0.02, 0.03, 0.04, 1.0));
    scene = scene.save();
    scene = scene.translate(10.0, 6.0);
    scene = scene.clipRect(Rectangle.xywh(0.0, 0.0, 128.0, 128.0));
    scene = scene.drawRect(Rectangle.xywh(8.0, 8.0, 96.0, 48.0), gradient_paint);
    scene = scene.drawPath(path, fill_paint);
    scene = scene.restore();
    if (scene.stateDepth() != 0) {
        scene.destroy();
        path.destroy();
        builder.destroy();
        return 411;
    }
    let scene_draw_count = scene.drawCommandCount();
    if (scene_draw_count < 2) {
        scene.destroy();
        path.destroy();
        builder.destroy();
        return 416;
    }
    if (scene_draw_count > 2) {
        scene.destroy();
        path.destroy();
        builder.destroy();
        return 417;
    }
    let graph = scene.buildGraph();
    if (!graph.isBalanced() || graph.drawCommandCount() != 2 || graph.maxTransformDepth() != 1 || graph.maxClipDepth() != 1) {
        graph.destroy();
        scene.destroy();
        path.destroy();
        builder.destroy();
        return 412;
    }
    graph.destroy();
    scene = scene.reset();

    scene = scene.save();
    scene = scene.layer(0.5);
    let dashed_paint = Paint.dashedStroke(Color.rgba(1.0, 1.0, 1.0, 1.0), 4.0, 10.0, 5.0, 0.0);
    let line_start = Point.xy(0.0, 0.0);
    let line_end = Point.xy(60.0, 0.0);
    scene = scene.drawLine(line_start, line_end, dashed_paint);
    scene = scene.restore();
    let dashed_graph = scene.buildGraph();
    if (!dashed_graph.isBalanced() || dashed_graph.maxLayerDepth() != 1 || dashed_graph.drawCommandCount() <= 0) {
        dashed_graph.destroy();
        scene.destroy();
        path.destroy();
        builder.destroy();
        return 413;
    }
    dashed_graph.destroy();
    scene.destroy();
    path.destroy();
    builder.destroy();
    return 0;
}

fn smoke_app_ui_toolchain_api() -> i32 {
    let identity = AppIdentity.create("Zyn Declarative Smoke", "dev.vyx.zyn.declarative_smoke")
        .setVersion("0.1.0")
        .setOrganization("vyx");
    let window = AppWindowSpec.create("Zyn Declarative Smoke", 640, 360).hidden();
    let renderer = AppRendererSpec.create(640 as u32, 360 as u32)
        .setBackendName("auto")
        .setClearColor(Color.rgba(0.04, 0.05, 0.06, 1.0))
        .setShaderPath("target/nut/solid.slang");
    let spec = AppSpec.create("Zyn Declarative Smoke", "dev.vyx.zyn.declarative_smoke", 640, 360)
        .setIdentity(identity)
        .setWindow(window)
        .setRenderer(renderer)
        .setTargetFps(60);
    if (spec.windowDesc().title != "Zyn Declarative Smoke") { return 701; }
    if (spec.renderer.backend_name != "auto") { return 702; }

    var tree = UiTree.create(640.0, 360.0);
    let theme = UiTheme.md3Light();
    let dark_theme = UiTheme.md3Dark();
    if (theme.shape_medium != 12.0 || theme.shape_large != 16.0 || theme.shape_full != 20.0 || theme.control_height != 40.0 || theme.spacing_lg != 24.0) {
        tree.destroy();
        return 713;
    }
    if (theme.primary.a != 1.0 || theme.on_primary.a != 1.0 || theme.primary_container.a != 1.0 || dark_theme.background.a != 1.0 || dark_theme.primary.a != 1.0) {
        tree.destroy();
        return 714;
    }
    var layout = UiLayoutSpec.vertical(Rectangle.xywh(24.0, 24.0, 592.0, 312.0), 24.0, 16.0);
    let shell_bounds = Rectangle.xywh(24.0, 24.0, 592.0, 312.0);
    tree = tree.addSurface(0, "shell", shell_bounds, theme);
    tree = tree.addTitle(1, "title", "Declarative Zyn", layout.next(240.0, 32.0), theme);
    tree = tree.addFilledButton(1, "publish", "Publish", layout.next(160.0, theme.control_height), theme);
    tree = tree.addTonalButton(1, "preview", "Preview", layout.next(160.0, theme.control_height), theme);
    tree = tree.addOutlinedButton(1, "cancel", "Cancel", layout.next(160.0, theme.control_height), theme);
    if (tree.nodeCount() != 6) {
        tree.destroy();
        return 703;
    }
    if (tree.find("publish") != 3) {
        tree.destroy();
        return 704;
    }
    if (tree.hitTest(Point.xy(64.0, 128.0)) != 3) {
        tree.destroy();
        return 705;
    }
    if (tree.nodeAt(1).corner_radius != theme.shape_large || tree.nodeAt(3).corner_radius != theme.shape_full || tree.nodeAt(3).text_color.r != theme.on_primary.r || tree.nodeAt(5).stroke_width != 1.0) {
        tree.destroy();
        return 715;
    }
    let remaining = layout.remaining();
    if (remaining.width <= 0.0 || remaining.height <= 0.0) {
        tree.destroy();
        return 711;
    }
    var scene = SceneBuilder.create();
    scene = tree.render(scene);
    if (scene.drawCommandCount() <= 12) {
        scene.destroy();
        tree.destroy();
        return 706;
    }
    scene.destroy();
    tree.destroy();

    let app = PublishApp.create("zyn_declarative_smoke", "dev.vyx.zyn.declarative_smoke")
        .setVersion("0.1.0")
        .setEntry("src/main.vyx");
    var manifest = PublishManifest.create(app)
        .addTarget(PublishTarget.windowsX64())
        .addTarget(PublishTarget.androidArm64().setArtifactName("zyn_declarative_smoke.apk"));
    match (manifest.validateForHost(publishHostWindows())) {
        case Ok(plan) => {
            if (plan.targetCount() != 2) {
                plan.destroy();
                manifest.destroy();
                return 707;
            }
            if (plan.targetAt(1).platform != publishPlatformAndroid()) {
                plan.destroy();
                manifest.destroy();
                return 708;
            }
            let summary = plan.summary();
            if (!summary.contains("android-arm64")) {
                plan.destroy();
                manifest.destroy();
                return 709;
            }
            if (!summary.contains("Android Gradle")) {
                plan.destroy();
                manifest.destroy();
                return 712;
            }
            plan.destroy();
        }
        case Err(_) => {
            manifest.destroy();
            return 710;
        }
    }
    manifest.destroy();
    return 0;
}

fn main() -> i32 {
    let scene_smoke = smoke_scene_api();
    if (scene_smoke != 0) { return scene_smoke; }
    let app_smoke = smoke_app_ui_toolchain_api();
    if (app_smoke != 0) { return app_smoke; }

    if (!rendererBackendKnown(backend_auto()) || !rendererBackendKnown(backend_vulkan()) || !rendererBackendKnown(backend_d3d12()) || !rendererBackendKnown(backend_d3d11()) || !rendererBackendKnown(backend_metal()) || !rendererBackendKnown(backend_opengl()) || !rendererBackendKnown(backend_opengles()) || !rendererBackendKnown(backend_webgpu()) || rendererBackendKnown(rendererBackendInvalid())) {
        return 238;
    }
    if (rendererBackendIsExplicit(backend_auto()) || !rendererBackendIsExplicit(backend_vulkan()) || !rendererBackendIsExplicit(backend_d3d12()) || rendererBackendIsExplicit(rendererBackendInvalid())) {
        return 239;
    }
    if (rendererBackendFromName("default") != backend_auto() || rendererBackendFromName("VK") != backend_vulkan() || rendererBackendFromName("directx12") != backend_d3d12() || rendererBackendFromName("DX11") != backend_d3d11() || rendererBackendFromName("mtl") != backend_metal() || rendererBackendFromName("GL") != backend_opengl() || rendererBackendFromName("gles") != backend_opengles() || rendererBackendFromName("wgpu") != backend_webgpu() || rendererBackendFromName("not-a-backend") != rendererBackendInvalid()) {
        return 240;
    }
    if (rendererBackendName(backend_auto()) != "auto" || rendererBackendName(backend_vulkan()) != "vulkan" || rendererBackendName(backend_d3d12()) != "d3d12" || rendererBackendName(backend_d3d11()) != "d3d11" || rendererBackendName(backend_metal()) != "metal" || rendererBackendName(backend_opengl()) != "opengl" || rendererBackendName(backend_opengles()) != "opengles" || rendererBackendName(backend_webgpu()) != "webgpu" || rendererBackendName(rendererBackendInvalid()) != "unknown") {
        return 241;
    }
    if (!rendererBackendMatchesRequest(backend_auto(), backend_d3d12()) || !rendererBackendMatchesRequest(backend_d3d12(), backend_d3d12()) || rendererBackendMatchesRequest(backend_d3d12(), backend_vulkan()) || rendererBackendMatchesRequest(rendererBackendInvalid(), backend_d3d12()) || rendererBackendMatchesRequest(backend_auto(), backend_auto())) {
        return 242;
    }
    if (rendererBackendFallbackActive(backend_auto(), backend_d3d12()) || rendererBackendFallbackActive(backend_d3d12(), backend_d3d12()) || !rendererBackendFallbackActive(backend_d3d12(), backend_vulkan()) || rendererBackendFallbackActive(rendererBackendInvalid(), backend_vulkan()) || rendererBackendFallbackActive(backend_d3d12(), backend_auto())) {
        return 243;
    }
    let required_features = rendererBackendRequiredFeatureMask();
    if (required_features != 63 as u32) {
        return 250;
    }
    if (!rendererBackendFeatureKnown(rendererBackendFeatureSwapchainColor()) || !rendererBackendFeatureKnown(rendererBackendFeatureSampledTextureArray()) || !rendererBackendFeatureKnown(rendererBackendFeatureDynamicRendering()) || !rendererBackendFeatureKnown(rendererBackendFeatureDepthStencilClipMask()) || !rendererBackendFeatureKnown(rendererBackendFeatureCustomPipelines()) || !rendererBackendFeatureKnown(rendererBackendFeatureLayerTargets()) || rendererBackendFeatureKnown(8192 as u32)) {
        return 251;
    }
    if (rendererBackendFeatureName(rendererBackendFeatureSwapchainColor()) != "swapchain-color" || rendererBackendFeatureName(rendererBackendFeatureSampledTextureArray()) != "sampled-texture-array" || rendererBackendFeatureName(rendererBackendFeatureDynamicRendering()) != "dynamic-rendering" || rendererBackendFeatureName(rendererBackendFeatureDepthStencilClipMask()) != "depth-stencil-clip-mask" || rendererBackendFeatureName(rendererBackendFeatureCustomPipelines()) != "custom-pipelines" || rendererBackendFeatureName(rendererBackendFeatureLayerTargets()) != "layer-targets" || rendererBackendFeatureName(8192 as u32) != "unknown") {
        return 252;
    }
    if (rendererBackendSupportedFeatureMask(backend_auto()) != 0 as u32 || rendererBackendMissingRequiredFeatureMask(backend_auto()) != required_features || rendererBackendSatisfiesRequiredFeatures(backend_auto()) || rendererBackendHasFeature(backend_auto(), rendererBackendFeatureSwapchainColor())) {
        return 253;
    }
    if (rendererBackendSupportedFeatureMask(rendererBackendInvalid()) != 0 as u32 || rendererBackendMissingRequiredFeatureMask(rendererBackendInvalid()) != required_features || rendererBackendSatisfiesRequiredFeatures(rendererBackendInvalid()) || rendererBackendHasFeature(backend_d3d12(), 8192 as u32)) {
        return 254;
    }
    let vulkan_profile = RendererBackendProfile.create(backend_vulkan());
    if (vulkan_profile.backend != backend_vulkan() || vulkan_profile.name != "vulkan" || !vulkan_profile.known || !vulkan_profile.is_explicit || vulkan_profile.feature_mask != required_features || vulkan_profile.required_mask != required_features || vulkan_profile.missing_required_mask != 0 as u32 || !vulkan_profile.satisfiesRequiredFeatures()) {
        return 255;
    }
    if (!vulkan_profile.hasFeature(rendererBackendFeatureLayerTargets()) || !vulkan_profile.hasFeature(rendererBackendFeatureDepthStencilClipMask()) || vulkan_profile.hasFeature(8192 as u32)) {
        return 256;
    }
    if (!rendererBackendSatisfiesRequiredFeatures(backend_vulkan()) || !rendererBackendSatisfiesRequiredFeatures(backend_d3d12()) || !rendererBackendSatisfiesRequiredFeatures(backend_d3d11()) || !rendererBackendSatisfiesRequiredFeatures(backend_metal()) || !rendererBackendSatisfiesRequiredFeatures(backend_opengl()) || !rendererBackendSatisfiesRequiredFeatures(backend_opengles()) || !rendererBackendSatisfiesRequiredFeatures(backend_webgpu())) {
        return 257;
    }
    if (rendererBackendSupportedFeatureMask(backend_d3d12()) != required_features || rendererBackendMissingRequiredFeatureMask(backend_metal()) != 0 as u32 || !rendererBackendHasFeature(backend_webgpu(), rendererBackendFeatureCustomPipelines()) || !rendererBackendHasFeature(backend_opengl(), rendererBackendFeatureSampledTextureArray())) {
        return 258;
    }

    match (TextBackend.probe()) {
        case Ok(info) => {
            if (!info.isValid()) { return 60; }
        }
        case Err(_) => { return 61; }
    }
    let system_font = "C:/Windows/Fonts/msyh.ttc";
    if (!fileExists(system_font)) { return 69; }
    match (FontFace.open(system_font, 32)) {
        case Ok(font) => {
            if (!font.hasCodepoint(0x6587 as u32) || font.hasCodepoint(0x10ffff as u32)) {
                font.close();
                return 109;
            }
            match (font.glyphIndex(0x6587 as u32)) {
                case Ok(index) => { if (index == 0 as u32) { font.close(); return 110; } }
                case Err(_) => { font.close(); return 111; }
            }
            match (font.shapeCount("Zyn 文本")) {
                case Ok(count) => { if (count != 6) { font.close(); return 62; } }
                case Err(_) => { font.close(); return 63; }
            }
            var glyph_cache = GlyphCache.create(128, 128, 1, Color.rgba(1.0, 1.0, 1.0, 1.0));
            match (glyph_cache.cacheGlyph(font, 0x6587 as u32)) {
                case Ok(glyph) => {
                    if (!glyph.region.isValid() || glyph.advance_x <= 0 || glyph_cache.glyphCount() != 1) {
                        glyph_cache.destroy();
                        font.close();
                        return 64;
                    }
                    var nonzero_pixel = false;
                    var gy: i32 = 0;
                    while (gy < glyph.region.height && !nonzero_pixel) {
                        var gx: i32 = 0;
                        while (gx < glyph.region.width && !nonzero_pixel) {
                            if (glyph_cache.atlas.pixelAt(glyph.region.x + gx, glyph.region.y + gy) != 0 as u32) {
                                nonzero_pixel = true;
                            }
                            gx = gx + 1;
                        }
                        gy = gy + 1;
                    }
                    if (!nonzero_pixel) {
                        glyph_cache.destroy();
                        font.close();
                        return 65;
                    }
                    if (glyph_cache.cacheRequestCount() != 1 || glyph_cache.cacheMissCount() != 1 || glyph_cache.cacheHitCount() != 0 || glyph_cache.generationCacheRequestCount() != 1 || glyph_cache.generationCacheMissCount() != 1 || glyph_cache.generationCacheHitCount() != 0 || glyph_cache.cacheHitRatePermille() != 0 || glyph_cache.generationCacheHitRatePermille() != 0) {
                        glyph_cache.destroy();
                        font.close();
                        return 69;
                    }
                }
                case Err(_) => {
                    glyph_cache.destroy();
                    font.close();
                    return 66;
                }
            }
            match (glyph_cache.cacheGlyph(font, 0x6587 as u32)) {
                case Ok(_) => {
                    if (glyph_cache.glyphCount() != 1 || glyph_cache.cacheRequestCount() != 2 || glyph_cache.cacheMissCount() != 1 || glyph_cache.cacheHitCount() != 1 || glyph_cache.generationCacheRequestCount() != 2 || glyph_cache.generationCacheMissCount() != 1 || glyph_cache.generationCacheHitCount() != 1 || glyph_cache.cacheHitRatePermille() != 500 || glyph_cache.generationCacheHitRatePermille() != 500) {
                        glyph_cache.destroy();
                        font.close();
                        return 70;
                    }
                }
                case Err(_) => {
                    glyph_cache.destroy();
                    font.close();
                    return 68;
                }
            }
            var block_cache = GlyphCache.create(512, 256, 1, Color.rgba(1.0, 1.0, 1.0, 1.0));
            var block: TextBlock;
            match (block_cache.cacheTextBlock(font, "Zyn 文本换行和字形缓存覆盖中文路径", TextLayoutOptions.wrapWidth(150).setLineHeight(38))) {
                case Ok(v) => { block = v; }
                case Err(_) => {
                    block_cache.destroy();
                    glyph_cache.destroy();
                    font.close();
                    return 78;
                }
            }
            let drawable_block_glyphs = block_cache.cachedDrawableGlyphsForBlock(block);
            if (block.lineCount() < 2 || block.width <= 0 || block.width > 150 || block.height != block.lineCount() * 38 || drawable_block_glyphs <= 0) {
                block.destroy();
                block_cache.destroy();
                glyph_cache.destroy();
                font.close();
                return 79;
            }
            let block_visual_bounds = block_cache.blockVisualBounds(block, 12.0, 34.0);
            if (!block_visual_bounds.isDrawable() || block_visual_bounds.width <= 0.0 || block_visual_bounds.height <= 0.0) {
                block.destroy();
                block_cache.destroy();
                glyph_cache.destroy();
                font.close();
                return 171;
            }
            block.destroy();
            match (font.layoutText("", TextLayoutOptions.singleLine().setLineHeight(38))) {
                case Ok(empty_block) => {
                    if (empty_block.lineCount() != 1 || empty_block.glyphCount() != 0 || empty_block.height != 38) {
                        empty_block.destroy();
                        block_cache.destroy();
                        glyph_cache.destroy();
                        font.close();
                        return 80;
                    }
                    empty_block.destroy();
                }
                case Err(_) => {
                    block_cache.destroy();
                    glyph_cache.destroy();
                    font.close();
                    return 81;
                }
            }
            var centered_block: TextBlock;
            match (font.layoutText("Zyn", TextLayoutOptions.wrapWidth(220).setLineHeight(38).setAlign(TextAlign.center()))) {
                case Ok(v) => { centered_block = v; }
                case Err(_) => {
                    block_cache.destroy();
                    glyph_cache.destroy();
                    font.close();
                    return 113;
                }
            }
            var right_block: TextBlock;
            match (font.layoutText("Zyn", TextLayoutOptions.wrapWidth(220).setLineHeight(38).alignRight())) {
                case Ok(v) => { right_block = v; }
                case Err(_) => {
                    centered_block.destroy();
                    block_cache.destroy();
                    glyph_cache.destroy();
                    font.close();
                    return 114;
                }
            }
            let centered_offset = centered_block.lineOffsetX(centered_block.lineAt(0));
            let right_offset = right_block.lineOffsetX(right_block.lineAt(0));
            if (centered_offset <= 0 || right_offset <= centered_offset || centered_block.align.value != TextAlign.center().value || right_block.align.value != TextAlign.right().value) {
                right_block.destroy();
                centered_block.destroy();
                block_cache.destroy();
                glyph_cache.destroy();
                font.close();
                return 115;
            }
            right_block.destroy();
            centered_block.destroy();
            var space_cache = GlyphCache.create(16, 16, 1, Color.rgba(1.0, 1.0, 1.0, 1.0));
            var space_layout: TextLayout;
            match (font.shape(" ")) {
                case Ok(v) => { space_layout = v; }
                case Err(_) => {
                    space_cache.destroy();
                    block_cache.destroy();
                    glyph_cache.destroy();
                    font.close();
                    return 93;
                }
            }
            match (space_cache.cacheLayout(font, space_layout)) {
                case Ok(_) => {}
                case Err(_) => {
                    space_layout.destroy();
                    space_cache.destroy();
                    block_cache.destroy();
                    glyph_cache.destroy();
                    font.close();
                    return 94;
                }
            }
            let space_cached_count = space_cache.glyphCount();
            match (space_cache.cacheLayout(font, space_layout)) {
