use Zyn;
use Platform = Zyn.Platform.Platform.Platform;
use Window = Zyn.Platform.Window.Window;
use WindowDesc = Zyn.Platform.Window.WindowDesc;
use EventLoop = Zyn.Platform.Event.EventLoop;
use Clock = Zyn.Platform.Clock.Clock;
use Color = Zyn.Nut.Types.Color;
use Rectangle = Zyn.Nut.Types.Rectangle;
use Canvas = Zyn.Nut.Canvas.Canvas;
use RenderPlan = Zyn.Nut.RenderPlan.RenderPlan;
use SolidVertex = Zyn.Nut.Batch.SolidVertex;
use TexturedVertex = Zyn.Nut.Batch.TexturedVertex;
use Renderer = Zyn.Nut.Renderer.Renderer;
use RendererDesc = Zyn.Nut.Renderer.RendererDesc;
use TextBackend = Zyn.Nut.Text.TextBackend;
use FontFace = Zyn.Nut.Text.FontFace;
use FontStack = Zyn.Nut.Text.FontStack;
use GlyphCache = Zyn.Nut.Text.GlyphCache;
use TextLayout = Zyn.Nut.Text.TextLayout;
use TextBlock = Zyn.Nut.Text.TextBlock;
use TextLayoutOptions = Zyn.Nut.Text.TextLayoutOptions;
use TextBoundaryMap = Zyn.Nut.Text.TextBoundaryMap;
use TextVisualMap = Zyn.Nut.Text.TextVisualMap;
use std.fs;

fn cleanup_fail(window: Window, code: i32) -> i32 {
    print("zyn_text_render_smoke failed");
    print(code);
    window.destroy();
    Platform.quit();
    return code;
}

fn main() -> i32 {
    match (TextBackend.probe()) {
        case Ok(info) => {
            if (!info.isValid() || info.icu_major <= 0) { return 1; }
        }
        case Err(_) => { return 2; }
    }

    match (Platform.init()) {
        case Ok(_) => {}
        case Err(_) => { return 3; }
    }

    let desc = WindowDesc.create("Zyn text render smoke", 960, 360)
        .resizable()
        .highPixelDensity();

    var window: Window;
    match (Window.create(desc)) {
        case Ok(v) => { window = v; }
        case Err(_) => { Platform.quit(); return 4; }
    }

    match (window.show()) {
        case Ok(_) => {}
        case Err(_) => { return cleanup_fail(window, 5); }
    }

    let system_font = "C:/Windows/Fonts/msyh.ttc";
    if (!fileExists(system_font)) { return cleanup_fail(window, 6); }
    var font: FontFace;
    match (FontFace.open(system_font, 40)) {
        case Ok(v) => { font = v; }
        case Err(_) => { return cleanup_fail(window, 6); }
    }

    let text = "Zyn 文本引擎换行稳定\n微软雅黑字形 atlas 局部上传";
    let options = TextLayoutOptions.wrapWidth(320).setLineHeight(52);
    var glyph_cache = GlyphCache.create(1024, 512, 1, Color.rgba(1.0, 1.0, 1.0, 1.0));
    var layout: TextLayout;
    match (glyph_cache.cacheText(font, "ZynNutText")) {
        case Ok(v) => { layout = v; }
        case Err(_) => {
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 7);
        }
    }

    var block: TextBlock;
    match (glyph_cache.cacheTextBlock(font, text, options)) {
        case Ok(v) => { block = v; }
        case Err(_) => {
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 17);
        }
    }

    let block_drawable_glyphs = glyph_cache.cachedDrawableGlyphsForBlock(block);
    if (layout.glyphCount() != 10 || layout.advance_x <= 0 || glyph_cache.glyphCount() <= 0 || glyph_cache.glyphCount() > (layout.glyphCount() + block.glyphCount()) || !glyph_cache.atlas.hasPixels()) {
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 8);
    }
    let layout_first_cluster = layout.glyphAt(0).cluster;
    let layout_first_start = layout.clusterStartX(layout_first_cluster);
    let layout_first_end = layout.clusterEndX(layout_first_cluster);
    if (layout_first_start != 0 || layout_first_end <= layout_first_start || layout.clusterAdvanceWidth(layout_first_cluster) != layout_first_end - layout_first_start || layout.caretXForCluster(layout_first_cluster, false) != layout_first_start || layout.caretXForCluster(layout_first_cluster, true) != layout_first_end || layout.nearestCaretX(layout_first_start) != layout_first_start || layout.nearestClusterForX(layout_first_start) != layout_first_cluster) {
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 78);
    }
    if (block.lineCount() < 3 || block.width <= 0 || block.width > options.max_width || block.height != block.lineCount() * options.line_height || block_drawable_glyphs <= 0) {
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 8);
    }
    var order_canvas = Canvas.create();
    match (order_canvas.drawTextLayout(glyph_cache, layout, 10.0, 80.0, Color.rgba(1.0, 1.0, 1.0, 1.0))) {
        case Ok(v) => { order_canvas = v; }
        case Err(_) => {
            order_canvas.destroy();
            block.destroy();
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 27);
        }
    }
    let order_graph = order_canvas.build();
    if (order_graph.drawCommandCount() != layout.glyphCount()) {
        order_graph.destroy();
        order_canvas.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 28);
    }
    let first_text_sprite = order_graph.commandAt(0).sprite.dest;
    let last_text_sprite = order_graph.commandAt(order_graph.drawCommandCount() - 1).sprite.dest;
    if (first_text_sprite.x >= last_text_sprite.x) {
        print("text layout source x order did not advance in normal backend coordinates");
        print(first_text_sprite.x);
        print(last_text_sprite.x);
        order_graph.destroy();
        order_canvas.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 29);
    }
    order_graph.destroy();
    order_canvas.destroy();

    let renderer_desc = RendererDesc.create("ZynTextRenderSmoke", 960 as u32, 360 as u32)
        .setClearColor(Color.rgba(0.02, 0.16, 0.30, 1.0))
        .setShaderPath("target/nut/solid.slang")
        .setSpriteAtlasPixels(glyph_cache.atlas.width, glyph_cache.atlas.height, glyph_cache.atlas.pixels);

    var renderer: Renderer;
    match (Renderer.create(window, renderer_desc)) {
        case Ok(v) => { renderer = v; }
        case Err(e) => {
            print("Renderer.create failed");
            print(e.message);
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 100 + e.code);
        }
    }

    if (renderer.spriteTextureWidth() != 1024 as u32 || renderer.spriteTextureHeight() != 512 as u32 || renderer.spriteTextureUploadBytes() != 2097152 as u64) {
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 9);
    }
    glyph_cache.atlas = glyph_cache.atlas.clearDirty();
    if (glyph_cache.atlas.hasDirtyPixels()) {
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 20);
    }

    let dynamic_text = "动态 atlas 上传：零一二三四五六七八九 XYZ";
    let glyph_count_before_dynamic = glyph_cache.glyphCount();
    var dynamic_block: TextBlock;
    match (glyph_cache.cacheTextBlock(font, dynamic_text, TextLayoutOptions.wrapWidth(520).setLineHeight(52))) {
        case Ok(v) => { dynamic_block = v; }
        case Err(_) => {
            renderer.destroy();
            block.destroy();
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 18);
        }
    }
    if (!glyph_cache.atlas.hasDirtyPixels()) {
        print("dynamic glyph cache did not dirty atlas");
        print(glyph_count_before_dynamic);
        print(glyph_cache.glyphCount());
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 21);
    }
    let dirty_x = glyph_cache.atlas.dirty_x;
    let dirty_y = glyph_cache.atlas.dirty_y;
    let dirty_width = glyph_cache.atlas.dirty_width;
    let dirty_height = glyph_cache.atlas.dirty_height;
    let expected_partial_upload_bytes = ((((dirty_width * 4) + 255) / 256) * 256 * dirty_height) as u64;
    if (expected_partial_upload_bytes == 0 as u64 || expected_partial_upload_bytes >= 2097152 as u64) {
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 22);
    }
    match (renderer.updateSpriteAtlas(glyph_cache.atlas)) {
        case Ok(_) => {}
        case Err(e) => {
            print("Renderer.updateSpriteAtlas failed");
            print(e.message);
            dynamic_block.destroy();
            renderer.destroy();
            block.destroy();
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 19);
        }
    }
    if (renderer.spriteTextureUploadBytes() != expected_partial_upload_bytes) {
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 23);
    }
    glyph_cache.atlas = glyph_cache.atlas.clearDirty();
    if (glyph_cache.atlas.hasDirtyPixels()) {
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 24);
    }

    let dynamic_drawable_glyphs = glyph_cache.cachedDrawableGlyphsForBlock(dynamic_block);
    let expected_textured_vertices = (block_drawable_glyphs + dynamic_drawable_glyphs) * 6;
    var frames: i32 = 0;
    while (frames < 180) {
        EventLoop.pump();
        var canvas = Canvas.create();
        canvas = canvas.clear(Color.rgba(0.02, 0.16, 0.30, 1.0));
        canvas = canvas.drawRect(Rectangle.xywh(56.0, 42.0, 820.0, 260.0), Color.rgba(0.08, 0.12, 0.18, 0.95));
        match (canvas.drawTextBlock(glyph_cache, block, 80.0, 64.0, Color.rgba(0.98, 0.98, 1.0, 1.0))) {
            case Ok(v) => { canvas = v; }
            case Err(_) => {
                canvas.destroy();
                dynamic_block.destroy();
                renderer.destroy();
                block.destroy();
                layout.destroy();
                glyph_cache.destroy();
                font.close();
                return cleanup_fail(window, 10);
            }
        }
        match (canvas.drawTextBlock(glyph_cache, dynamic_block, 80.0, 225.0, Color.rgba(0.58, 0.90, 1.0, 1.0))) {
            case Ok(v) => { canvas = v; }
            case Err(_) => {
                canvas.destroy();
                dynamic_block.destroy();
                renderer.destroy();
                block.destroy();
                layout.destroy();
                glyph_cache.destroy();
                font.close();
                return cleanup_fail(window, 10);
            }
        }

        let graph = canvas.build();
        if (!graph.isBalanced() || graph.drawCommandCount() != (1 + block_drawable_glyphs + dynamic_drawable_glyphs) || graph.estimatedVertexCount() != (6 + expected_textured_vertices)) {
            graph.destroy();
            canvas.destroy();
            dynamic_block.destroy();
            renderer.destroy();
            block.destroy();
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 11);
        }
        var plan: RenderPlan;
        match (RenderPlan.build(graph)) {
            case Ok(v) => { plan = v; }
            case Err(_) => {
                graph.destroy();
                canvas.destroy();
                dynamic_block.destroy();
                renderer.destroy();
                block.destroy();
                layout.destroy();
                glyph_cache.destroy();
                font.close();
                return cleanup_fail(window, 12);
            }
        }
        if (plan.solid_draw_count != 1) {
            print("solid_draw_count mismatch");
            print(plan.solid_draw_count);
            print(1);
            plan.destroy();
            graph.destroy();
            canvas.destroy();
            dynamic_block.destroy();
            renderer.destroy();
            block.destroy();
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 13);
        }
        if (plan.textured_draw_count != (block_drawable_glyphs + dynamic_drawable_glyphs)) {
            print("textured_draw_count mismatch");
            print(plan.textured_draw_count);
            print(block_drawable_glyphs + dynamic_drawable_glyphs);
            plan.destroy();
            graph.destroy();
            canvas.destroy();
            dynamic_block.destroy();
            renderer.destroy();
            block.destroy();
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 13);
        }
        if (plan.estimated_textured_vertices != expected_textured_vertices) {
            print("estimated_textured_vertices mismatch");
            print(plan.estimated_textured_vertices);
            print(expected_textured_vertices);
            plan.destroy();
            graph.destroy();
            canvas.destroy();
            dynamic_block.destroy();
            renderer.destroy();
            block.destroy();
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 13);
        }
        if (plan.clip_path_count != 0 || plan.clip_path_bounds_fallback_count != 0) {
            plan.destroy();
            graph.destroy();
            canvas.destroy();
            dynamic_block.destroy();
            renderer.destroy();
            block.destroy();
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 13);
        }
        plan.destroy();

        match (renderer.renderGraph(graph)) {
            case Ok(_) => {}
            case Err(e) => {
                print("Renderer.renderGraph failed");
                print(e.message);
                graph.destroy();
                canvas.destroy();
                dynamic_block.destroy();
                renderer.destroy();
                block.destroy();
                layout.destroy();
                glyph_cache.destroy();
                font.close();
                return cleanup_fail(window, 14);
            }
        }
        if (renderer.lastFrameTexturedVertexCount() != expected_textured_vertices) {
            graph.destroy();
            canvas.destroy();
            dynamic_block.destroy();
            renderer.destroy();
            block.destroy();
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 15);
        }
        let expected_solid_bytes = (6 as u64) * (sizeof::<SolidVertex>() as u64);
        let expected_textured_bytes = (expected_textured_vertices as u64) * (sizeof::<TexturedVertex>() as u64);
        if (renderer.lastFrameSolidUploadedBytes() != expected_solid_bytes || renderer.lastFrameTexturedUploadedBytes() != expected_textured_bytes) {
            graph.destroy();
            canvas.destroy();
            dynamic_block.destroy();
            renderer.destroy();
            block.destroy();
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 16);
        }

        graph.destroy();
        canvas.destroy();
        Clock.delay(16 as u32);
        frames = frames + 1;
    }

    match (renderer.updateSpriteAtlasPixels(glyph_cache.atlas.width, glyph_cache.atlas.height, glyph_cache.atlas.pixels)) {
        case Ok(_) => {}
        case Err(e) => {
            print("Renderer.updateSpriteAtlasPixels after partial update failed");
            print(e.message);
            dynamic_block.destroy();
            renderer.destroy();
            block.destroy();
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 25);
        }
    }
    if (renderer.spriteTextureUploadBytes() != 2097152 as u64) {
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 26);
    }

    let latin_font = "C:/Windows/Fonts/consola.ttf";
    if (!fileExists(latin_font)) {
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 30);
    }
    var font_stack: FontStack;
    match (FontStack.open(latin_font, 38)) {
        case Ok(v) => { font_stack = v; }
        case Err(_) => {
            dynamic_block.destroy();
            renderer.destroy();
            block.destroy();
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 31);
        }
    }
    let latin_only_diag = font_stack.diagnostics("AZ 中文 B");
    if (latin_only_diag.canShape() || latin_only_diag.missing_codepoint_count != 2 || latin_only_diag.first_missing_codepoint != 0x4e2d as u32 || latin_only_diag.missing_run_count != 1 || latin_only_diag.max_missing_run_length != 2 || latin_only_diag.font_run_count != 2 || latin_only_diag.max_font_run_length != 3 || latin_only_diag.fallback_run_count != 0 || latin_only_diag.max_fallback_run_length != 0) {
        font_stack.destroy();
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 60);
    }
    match (font_stack.addPath(system_font, 38)) {
        case Ok(v) => { font_stack = v; }
        case Err(_) => {
            font_stack.destroy();
            dynamic_block.destroy();
            renderer.destroy();
            block.destroy();
            layout.destroy();
            glyph_cache.destroy();
            font.close();
            return cleanup_fail(window, 32);
        }
    }
    if (font_stack.chooseFontIndex(0x41 as u32) != 0 || font_stack.chooseFontIndex(0x6587 as u32) != 1) {
        font_stack.destroy();
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 33);
    }
    if (font_stack.firstFallbackCodepoint("Á 文 B 中文") != 0x6587 as u32 || font_stack.fallbackRunCount("Á 文 B 中文") != 2 || font_stack.fontSwitchCount("Á 文 B 中文") != 3 || font_stack.firstFallbackCodepoint("Á") != 0 as u32 || font_stack.fallbackRunCount("Á") != 0 || font_stack.fontSwitchCount("Á") != 0) {
        font_stack.destroy();
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 47);
    }
    let stack_sample = "Á 文 B 中文";
    if (font_stack.fontRunCount(stack_sample) != 4 || font_stack.shapingRunCount(stack_sample) != 4 || font_stack.fontRunCountForIndex(0, stack_sample) != 2 || font_stack.fontRunCountForIndex(1, stack_sample) != 2 || font_stack.fontCodepointCount(0, stack_sample) != 6 || font_stack.fontCodepointCount(1, stack_sample) != 3) {
        font_stack.destroy();
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 53);
    }
    let stack_diag = font_stack.diagnostics(stack_sample);
    if (!stack_diag.canShape() || !stack_diag.usesFallback() || !stack_diag.hasExtensions() || stack_diag.codepoint_count != 9 || stack_diag.primary_codepoint_count != 6 || stack_diag.fallback_codepoint_count != 3 || stack_diag.missing_codepoint_count != 0 || stack_diag.first_missing_codepoint != 0 as u32 || stack_diag.missing_run_count != 0 || stack_diag.max_missing_run_length != 0 || stack_diag.first_fallback_codepoint != 0x6587 as u32 || stack_diag.font_run_count != 4 || stack_diag.fallback_run_count != 2 || stack_diag.font_switch_count != 3 || stack_diag.extension_codepoint_count != 1 || stack_diag.leading_extension_count != 0 || stack_diag.max_font_run_length != 3 || stack_diag.max_fallback_run_length != 2) {
        font_stack.destroy();
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 57);
    }
    let accent_diag = font_stack.diagnostics("Á");
    if (!accent_diag.canShape() || accent_diag.usesFallback() || !accent_diag.hasExtensions() || accent_diag.codepoint_count != 2 || accent_diag.primary_codepoint_count != 2 || accent_diag.fallback_codepoint_count != 0 || accent_diag.font_run_count != 1 || font_stack.shapingRunCount("Á") != 1 || accent_diag.font_switch_count != 0 || accent_diag.extension_codepoint_count != 1 || accent_diag.leading_extension_count != 0 || accent_diag.max_font_run_length != 2 || accent_diag.max_fallback_run_length != 0) {
        font_stack.destroy();
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 58);
    }
    let leading_diag = font_stack.diagnostics("́Leading mark 中文 fallback");
    if (!leading_diag.canShape() || !leading_diag.usesFallback() || !leading_diag.hasExtensions() || leading_diag.leading_extension_count != 1 || leading_diag.extension_codepoint_count != 1 || leading_diag.fallback_run_count != 1 || leading_diag.font_switch_count != 2 || leading_diag.max_fallback_run_length != 2 || leading_diag.first_fallback_codepoint != 0x4e2d as u32) {
        font_stack.destroy();
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 59);
    }
    let arabic_diag = font_stack.diagnostics("سلام عربي");
    if (!arabic_diag.hasRtl() || !arabic_diag.hasArabic() || !arabic_diag.hasComplexClusterHints() || arabic_diag.arabic_codepoint_count < 8 || arabic_diag.rtl_codepoint_count < arabic_diag.arabic_codepoint_count || arabic_diag.script_run_count < 1 || arabic_diag.max_script_run_length < 4) {
        font_stack.destroy();
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 61);
    }
    let indic_diag = font_stack.diagnostics("नमस्ते भारत");
    if (!indic_diag.hasIndic() || !indic_diag.hasComplexClusterHints() || indic_diag.indic_codepoint_count < 9 || indic_diag.combining_mark_count < 3 || indic_diag.script_run_count < 1 || indic_diag.max_script_run_length < 5) {
        font_stack.destroy();
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 62);
    }
    let emoji_diag = font_stack.diagnostics("👩‍💻 emoji ❤️");
    if (!emoji_diag.hasEmoji() || !emoji_diag.hasComplexClusterHints() || emoji_diag.emoji_codepoint_count < 3 || emoji_diag.joiner_codepoint_count < 1 || emoji_diag.variation_selector_count < 1 || emoji_diag.extension_codepoint_count < 2 || emoji_diag.script_run_count < 2 || emoji_diag.max_script_run_length < 3) {
        font_stack.destroy();
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 63);
    }
    // Contains U+200C zero-width non-joiner between Arabic letters.
    let zwnj_diag = font_stack.diagnostics("می‌خواهم");
    if (!zwnj_diag.hasRtl() || !zwnj_diag.hasArabic() || !zwnj_diag.hasComplexClusterHints() || zwnj_diag.joiner_codepoint_count != 1 || zwnj_diag.extension_codepoint_count < 1 || zwnj_diag.script_run_count != 1 || zwnj_diag.max_script_run_length < 7) {
        font_stack.destroy();
        dynamic_block.destroy();
        renderer.destroy();
        block.destroy();
        layout.destroy();
        glyph_cache.destroy();
        font.close();
        return cleanup_fail(window, 64);
    }
    let bidi_sample = "Á 👩‍💻 سلام";
    var boundary_map = TextBoundaryMap.analyze(bidi_sample);
    if (boundary_map.byte_count <= 0
