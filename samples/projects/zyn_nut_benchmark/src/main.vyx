use Platform = Zyn.Platform.Platform.Platform;
use PlatformInit = Zyn.Platform.Platform.PlatformInit;
use Clock = Zyn.Platform.Clock.Clock;
use Color = Zyn.Nut.Types.Color;
use Circle = Zyn.Nut.Types.Circle;
use Point = Zyn.Nut.Types.Point;
use Rectangle = Zyn.Nut.Types.Rectangle;
use Transform2D = Zyn.Nut.Types.Transform2D;
use LinearGradient = Zyn.Nut.Types.LinearGradient;
use Canvas = Zyn.Nut.Canvas.Canvas;
use RenderGraph = Zyn.Nut.RenderGraph.RenderGraph;
use RenderPlan = Zyn.Nut.RenderPlan.RenderPlan;
use RenderResourceKind = Zyn.Nut.RenderPlan.RenderResourceKind;
use Path = Zyn.Nut.Path.Path;
use Atlas = Zyn.Nut.Atlas.Atlas;
use AtlasSet = Zyn.Nut.Atlas.AtlasSet;
use Image = Zyn.Nut.Image.Image;
use FontFace = Zyn.Nut.Text.FontFace;
use FontStack = Zyn.Nut.Text.FontStack;
use GlyphCache = Zyn.Nut.Text.GlyphCache;
use TextLayoutOptions = Zyn.Nut.Text.TextLayoutOptions;
use std.fs;

fn elapsed_us(start: u64, stop: u64) -> u64 {
    let freq = Clock.performanceFrequency();
    if (freq == 0 as u64) { return 0 as u64; }
    return ((stop - start) * 1000000 as u64) / freq;
}

fn bench_canvas(iterations: i32) -> i32 {
    var total_commands: i32 = 0;
    var i: i32 = 0;
    while (i < iterations) {
        var canvas = Canvas.create();
        canvas = canvas.clear(Color.rgba(0.02, 0.03, 0.04, 1.0));
        var j: i32 = 0;
        while (j < 160) {
            let x = ((j % 40) * 18) as f32;
            let y = ((j / 40) * 24) as f32;
            if ((j % 16) == 0) {
                canvas = canvas.drawShadowRect(Rectangle.xywh(x, y, 14.0, 18.0), 3.0, 4.0, 5.0, Color.rgba(0.0, 0.0, 0.0, 0.22));
            }
            canvas = canvas.drawRect(Rectangle.xywh(x, y, 14.0, 18.0), Color.rgba(0.2, 0.4, 0.9, 0.8));
            canvas = canvas.fillGradientRect(Rectangle.xywh(x + 4.0, y + 3.0, 10.0, 12.0), LinearGradient.vertical(Color.rgba(1.0, 0.2, 0.1, 1.0), Color.rgba(0.1, 0.8, 0.3, 1.0)));
            j = j + 1;
        }
        var path = Path.create()
            .moveTo(Point.xy(12.0, 12.0))
            .lineTo(Point.xy(92.0, 20.0))
            .lineTo(Point.xy(120.0, 86.0))
            .lineTo(Point.xy(20.0, 112.0))
            .close();
        canvas = canvas.drawShadowPath(path, 6.0, 8.0, 4.0, Color.rgba(0.0, 0.0, 0.0, 0.28));
        canvas = canvas.fillPath(path, Color.rgba(0.9, 0.7, 0.2, 1.0));
        let graph = canvas.build();
        let command_count = graph.commandCount();
        total_commands = total_commands + command_count;
        match (RenderPlan.build(graph)) {
            case Ok(plan) => {
                total_commands = total_commands + plan.segment_count + plan.resourceCount();
                plan.destroy();
            }
            case Err(_) => {
                graph.destroy();
                path.destroy();
                canvas.destroy();
                return -1;
            }
        }
        graph.destroy();
        path.destroy();
        canvas.destroy();
        i = i + 1;
    }
    return total_commands;
}

fn bench_atlas(count: i32) -> i32 {
    var atlas = Atlas.create(2048, 2048, 1);
    var ok_count: i32 = 0;
    var i: i32 = 0;
    while (i < count) {
        let w = 8 + (i % 31);
        let h = 8 + ((i * 7) % 29);
        let region = atlas.add("bench", w, h);
        if (region.isValid()) {
            atlas.fillRegion(region, 0xffffffff as u32);
            ok_count = ok_count + 1;
        }
        i = i + 1;
    }
    atlas.destroy();
    return ok_count;
}

fn bench_atlas_growth(count: i32) -> i32 {
    var atlas = Atlas.create(32, 32, 1);
    var ok_count: i32 = 0;
    var i: i32 = 0;
    while (i < count) {
        let w = 6 + (i % 37);
        let h = 6 + ((i * 5) % 41);
        match (atlas.ensureCanAdd(w, h)) {
            case Ok(_) => {}
            case Err(_) => {
                atlas.destroy();
                return -1;
            }
        }
        let region = atlas.add("grow", w, h);
        if (!region.isValid()) {
            atlas.destroy();
            return -1;
        }
        atlas.fillRegion(region, 0xffaaccee as u32);
        ok_count = ok_count + 1;
        i = i + 1;
    }
    let score = ok_count + atlas.width + atlas.height;
    atlas.destroy();
    return score;
}

fn bench_atlas_set(count: i32) -> i32 {
    var atlas_set = AtlasSet.create(256, 256, 1);
    var score: i32 = 0;
    var i: i32 = 0;
    while (i < count) {
        let w = 24 + (i % 17);
        let h = 18 + ((i * 3) % 19);
        match (atlas_set.add("page", w, h)) {
            case Ok(region) => {
                if (!region.isValid()) {
                    atlas_set.destroy();
                    return -1;
                }
                score = score + region.atlas_id + region.width + region.height;
            }
            case Err(_) => {
                atlas_set.destroy();
                return -1;
            }
        }
        i = i + 1;
    }
    score = score + atlas_set.pageCount() + atlas_set.totalRegionCount();
    atlas_set.destroy();
    return score;
}

fn bench_hit_test(iterations: i32) -> i32 {
    var graph = RenderGraph.create()
        .pushClipRect(Rectangle.xywh(16.0, 16.0, 720.0, 320.0));
    var i: i32 = 0;
    while (i < 240) {
        let x = ((i % 40) * 18) as f32;
        let y = ((i / 40) * 24) as f32;
        graph = graph.fillRect(Rectangle.xywh(x, y, 15.0, 19.0), Color.rgba(0.2, 0.6, 0.9, 1.0));
        i = i + 1;
    }
    graph = graph.popClip()
        .pushTransform(Transform2D.translation(120.0, 32.0))
        .fillCircle(Circle.xy(80.0, 80.0, 48.0), Color.rgba(0.8, 0.2, 0.3, 1.0))
        .popTransform();

    var score: i32 = 0;
    var j: i32 = 0;
    while (j < iterations) {
        let p = Point.xy(((j * 13) % 760) as f32, ((j * 17) % 360) as f32);
        score = score + graph.hitTest(p) + 1;
        j = j + 1;
    }
    graph.destroy();
    return score;
}

fn bench_path_metrics(iterations: i32) -> i32 {
    var score: i32 = 0;
    var path = Path.roundedRect(Rectangle.xywh(12.0, 18.0, 220.0, 140.0), 24.0, 8);
    var i: i32 = 0;
    while (i < iterations) {
        let sample = path.pointAtDistance(((i * 17) % 720) as f32);
        if (path.containsPoint(sample)) {
            score = score + 1;
        }
        if (path.area() > (0.0 as f32) && path.length() > (0.0 as f32)) {
            score = score + path.winding();
        }
        i = i + 1;
    }
    let reversed = path.reversed();
    score = score - reversed.winding();
    reversed.destroy();
    path.destroy();
    return score;
}

fn bench_clip_plan(iterations: i32) -> i32 {
    var score: i32 = 0;
    var clip_outer = Path.create()
        .moveTo(Point.xy(8.0, 8.0))
        .lineTo(Point.xy(248.0, 12.0))
        .lineTo(Point.xy(232.0, 176.0))
        .lineTo(Point.xy(16.0, 188.0))
        .close();
    var clip_inner = Path.roundedRect(Rectangle.xywh(32.0, 28.0, 164.0, 112.0), 18.0, 6);
    var i: i32 = 0;
    while (i < iterations) {
        var canvas = Canvas.create();
        canvas = canvas.pushClipPath(&clip_outer);
        canvas = canvas.pushLayer(0.72);
        canvas = canvas.pushClipPath(&clip_inner);
        canvas = canvas.drawRect(Rectangle.xywh(0.0, 0.0, 260.0, 200.0), Color.rgba(0.2, 0.7, 0.9, 1.0));
        canvas = canvas.fillGradientRect(Rectangle.xywh(28.0, 22.0, 180.0, 144.0), LinearGradient.horizontal(Color.rgba(1.0, 0.2, 0.1, 1.0), Color.rgba(0.1, 0.8, 0.3, 1.0)));
        canvas = canvas.popClip();
        canvas = canvas.popLayer();
        canvas = canvas.popClip();
        let graph = canvas.build();
        match (RenderPlan.build(graph)) {
            case Ok(plan) => {
                if (!plan.requiresClipStencil() || plan.resourceCountByKind(RenderResourceKind.clipStencilTarget()) != 1 || plan.resourceCountByKind(RenderResourceKind.clipMaskVertexBuffer()) != 1) {
                    plan.destroy();
                    graph.destroy();
                    canvas.destroy();
                    clip_inner.destroy();
                    clip_outer.destroy();
                    return -1;
                }
                score = score + plan.clip_path_count + plan.layer_pass_count + plan.resourceCount() + plan.dependencyCount() + plan.clip_mask_vertex_capacity_estimate;
                plan.destroy();
            }
            case Err(_) => {
                graph.destroy();
                canvas.destroy();
                clip_inner.destroy();
                clip_outer.destroy();
                return -1;
            }
        }
        graph.destroy();
        canvas.destroy();
        i = i + 1;
    }
    clip_inner.destroy();
    clip_outer.destroy();
    return score;
}

fn bench_image_decode(count: i32) -> i64 {
    var total_bytes: i64 = 0;
    var i: i32 = 0;
    while (i < count) {
        match (Image.loadRgba("../../../Zyn/icon.png")) {
            case Ok(image) => {
                total_bytes = total_bytes + image.byteSize() as i64;
                image.destroy();
            }
            case Err(_) => { return -1; }
        }
        i = i + 1;
    }
    return total_bytes;
}

fn bench_glyph_cache(count: i32) -> i32 {
    var cached: i32 = 0;
    let system_font = "C:/Windows/Fonts/msyh.ttc";
    if (!fileExists(system_font)) { return -2; }
    match (FontFace.open(system_font, 32)) {
        case Ok(font) => {
            var cache = GlyphCache.create(512, 512, 1, Color.rgba(1.0, 1.0, 1.0, 1.0));
            var i: i32 = 0;
            while (i < count) {
                let cp = (33 + (i % 90)) as u32;
                match (cache.cacheGlyph(font, cp)) {
                    case Ok(_) => { cached = cached + 1; }
                    case Err(_) => {
                        cache.destroy();
                        font.close();
                        return -1;
                    }
                }
                i = i + 1;
            }
            cache.destroy();
            font.close();
        }
        case Err(_) => { return -2; }
    }
    return cached;
}

fn bench_text_blocks(count: i32) -> i32 {
    var total_lines: i32 = 0;
    let system_font = "C:/Windows/Fonts/msyh.ttc";
    if (!fileExists(system_font)) { return -2; }
    match (FontFace.open(system_font, 28)) {
        case Ok(font) => {
            var cache = GlyphCache.create(1024, 512, 1, Color.rgba(1.0, 1.0, 1.0, 1.0));
            let options = TextLayoutOptions.wrapWidth(360).setLineHeight(36).alignCenter();
            var i: i32 = 0;
            while (i < count) {
                match (cache.cacheTextBlock(font, "Zyn 文本布局换行并缓存中文字形用于 renderer 上传", options)) {
                    case Ok(block) => {
                        let bounds = cache.blockVisualBounds(block, 0.0, 0.0);
                        if (!bounds.isDrawable()) {
                            block.destroy();
                            cache.destroy();
                            font.close();
                            return -1;
                        }
                        total_lines = total_lines + block.lineCount() + cache.cachedDrawableGlyphsForBlock(block) + (bounds.width as i32);
                        block.destroy();
                    }
                    case Err(_) => {
                        cache.destroy();
                        font.close();
                        return -1;
                    }
                }
                i = i + 1;
            }
            cache.destroy();
            font.close();
        }
        case Err(_) => { return -2; }
    }
    return total_lines;
}

fn bench_font_stack(count: i32) -> i32 {
    var total_glyphs: i32 = 0;
    let latin_font = "C:/Windows/Fonts/consola.ttf";
    let system_font = "C:/Windows/Fonts/msyh.ttc";
    if (!fileExists(latin_font) || !fileExists(system_font)) { return -2; }
    var stack: FontStack;
    match (FontStack.open(latin_font, 30)) {
        case Ok(v) => { stack = v; }
        case Err(_) => { return -2; }
    }
    match (stack.addPath(system_font, 30)) {
        case Ok(v) => { stack = v; }
        case Err(_) => {
            stack.destroy();
            return -2;
        }
    }
    var cache = GlyphCache.create(1024, 512, 1, Color.rgba(1.0, 1.0, 1.0, 1.0));
    let options = TextLayoutOptions.wrapWidth(420).setLineHeight(38).alignCenter();
    var i: i32 = 0;
    while (i < count) {
        match (cache.cacheTextBlockWithStack(stack, "Consolas ASCII mixed with 微软雅黑中文 glyph stack path", options)) {
            case Ok(block) => {
                let bounds = cache.blockVisualBounds(block, 0.0, 0.0);
                if (!bounds.isDrawable()) {
                    block.destroy();
                    cache.destroy();
                    stack.destroy();
                    return -1;
                }
                total_glyphs = total_glyphs + cache.cachedDrawableGlyphsForBlock(block) + block.lineCount() + (bounds.width as i32);
                block.destroy();
            }
            case Err(_) => {
                cache.destroy();
                stack.destroy();
                return -1;
            }
        }
        i = i + 1;
    }
    cache.destroy();
    stack.destroy();
    return total_glyphs;
}

fn main() -> i32 {
    match (Platform.initWithFlags(PlatformInit.events())) {
        case Ok(_) => {}
        case Err(_) => { return 1; }
    }

    let t0 = Clock.performanceCounter();
    let commands = bench_canvas(180);
    let t1 = Clock.performanceCounter();
    let atlas_regions = bench_atlas(9000);
    let t2 = Clock.performanceCounter();
    let atlas_growth = bench_atlas_growth(1400);
    let t3 = Clock.performanceCounter();
    let atlas_set = bench_atlas_set(1800);
    let t_atlas_set = Clock.performanceCounter();
    let hit_score = bench_hit_test(8000);
    let t4 = Clock.performanceCounter();
    let path_metrics = bench_path_metrics(6000);
    let t_path = Clock.performanceCounter();
    let clip_plan = bench_clip_plan(900);
    let t_clip = Clock.performanceCounter();
    let decoded_bytes = bench_image_decode(8);
    let t5 = Clock.performanceCounter();
    let glyphs = bench_glyph_cache(900);
    let t6 = Clock.performanceCounter();
    let text_blocks = bench_text_blocks(120);
    let t7 = Clock.performanceCounter();
    let font_stack = bench_font_stack(90);
    let t8 = Clock.performanceCounter();

    Platform.quit();

    if (commands <= 0 || atlas_regions <= 0 || atlas_growth <= 0 || atlas_set <= 0 || hit_score <= 0 || path_metrics <= 0 || clip_plan <= 0 || decoded_bytes <= 0 || glyphs <= 0 || text_blocks <= 0 || font_stack <= 0) { return 2; }
    print("nut bench canvas_commands=${commands} us=${elapsed_us(t0, t1)}");
    print("nut bench atlas_regions=${atlas_regions} us=${elapsed_us(t1, t2)}");
    print("nut bench atlas_growth_score=${atlas_growth} us=${elapsed_us(t2, t3)}");
    print("nut bench atlas_set_score=${atlas_set} us=${elapsed_us(t3, t_atlas_set)}");
    print("nut bench hit_score=${hit_score} us=${elapsed_us(t_atlas_set, t4)}");
    print("nut bench path_metrics_score=${path_metrics} us=${elapsed_us(t4, t_path)}");
    print("nut bench clip_plan_score=${clip_plan} us=${elapsed_us(t_path, t_clip)}");
    print("nut bench decoded_bytes=${decoded_bytes} us=${elapsed_us(t_clip, t5)}");
    print("nut bench glyph_requests=${glyphs} us=${elapsed_us(t5, t6)}");
    print("nut bench text_block_score=${text_blocks} us=${elapsed_us(t6, t7)}");
    print("nut bench font_stack_score=${font_stack} us=${elapsed_us(t7, t8)}");
    print("nut bench total_us=${elapsed_us(t0, t8)}");
    return 0;
}
