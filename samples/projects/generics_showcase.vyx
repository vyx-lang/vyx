// VyxLan Generics — current syntax showcase (2026-04-20)
// Exercises every feature stabilized through R1→R4 + a2/a3 fix series,
// using real std collections / iterators / Option / Result end-to-end.
//
// Compile: vyxc samples/projects/generics_showcase.vyx -o /tmp/showcase.exe

use std.collections;

// ─────────────────────────────────────────────────────────────────────
// 1. Const-generic class with static factory  (a2_01)
//    Mixed type+const turbofish on the type, then `.method()`.
// ─────────────────────────────────────────────────────────────────────
class Buffer<T, const N: i64> {
    public size: i64;
    public static fn make() -> Buffer<T, N> {
        return Buffer { size: N };
    }
}

// ─────────────────────────────────────────────────────────────────────
// 2. Where-clause: const arithmetic predicates joined with `+`
//    Beyond C++26: arbitrary const expressions in constraints.
// ─────────────────────────────────────────────────────────────────────
fn capacity<T, const N: i64>() -> i64
    where N > 0 + N * 2 <= 32 + N % 4 == 0 {
    return N;
}

// ─────────────────────────────────────────────────────────────────────
// 3. typeof(expr) — compile-time canonical type name
// ─────────────────────────────────────────────────────────────────────
fn type_label<T>(v: T) -> string {
    return typeof(v);
}

// ─────────────────────────────────────────────────────────────────────
// 4. Variadic generics + pack folds
//    Empty pack folds to identity (0 for +, 1 for *, true for &&).
// ─────────────────────────────────────────────────────────────────────
fn sum_all<...Ts>(...args: Ts) -> i64    { return args...+; }
fn prod_all<...Ts>(...args: Ts) -> i64   { return args...*; }
fn all_of<...Bs>(...flags: Bs) -> bool   { return flags...&&; }

// ─────────────────────────────────────────────────────────────────────
// 5. Multi-trait inheritance + where T: A + B
// ─────────────────────────────────────────────────────────────────────
interface Named { fn name() -> string; }
interface Countable { fn count() -> i64; }

class Dog : Named + Countable {
    public fn name() -> string { return "dog"; }
    public fn count() -> i64 { return 4; }
}

fn describe<T>(v: T) -> string where T: Named + Countable {
    return v.name();
}

// ─────────────────────────────────────────────────────────────────────
// 6. Interface with default method body (self-dispatch through vtable)
// ─────────────────────────────────────────────────────────────────────
interface Greeter {
    fn greet() -> string;
    fn hello() -> string { return "hello " + self.greet(); }
}

class En : Greeter {
    public fn greet() -> string { return "world"; }
}

// ─────────────────────────────────────────────────────────────────────
// 7. Class-level T + method-level U (double-level generic + turbofish)
// ─────────────────────────────────────────────────────────────────────
fn dbl(x: i64) -> i64 { return x * 2; }

// ─────────────────────────────────────────────────────────────────────
// 8. std.Vec end-to-end: push / get / iter for-loop with manual filter+map
// ─────────────────────────────────────────────────────────────────────
fn vec_pipeline() -> i64 {
    var v = Vec::<i64>.new();
    v.push(1);
    v.push(2);
    v.push(3);
    v.push(4);
    v.push(5);

    // sum of squares of even values: 2² + 4² = 20
    var total: i64 = 0;
    for (x in v.iter()) {
        if (x % 2 == 0) { total = total + x * x; }
    }
    return total;
}

// ─────────────────────────────────────────────────────────────────────
// 9. std.Dict<string, i64> — string-keyed map (post backend-name unification)
// ─────────────────────────────────────────────────────────────────────
fn dict_lookup() -> i64 {
    var d = Dict::<string, i64>.new();
    d.put("one", 1);
    d.put("two", 2);
    d.put("three", 3);

    let hit = d.try_get("two");
    let miss = d.try_get("missing");

    var a: i64 = -1;
    var b: i64 = -1;
    match (hit)  { case Some(v) => { a = v; } default => { } }
    match (miss) { case Some(v) => { b = v; } default => { } }
    return a * 100 + b;          // 2*100 + (-1) = 199
}

// ─────────────────────────────────────────────────────────────────────
// 10. Option<T>.map::<U>(f) — enum method-level generic via Mono synthetic
//     FunctionDecl + tagged-union dispatch wired through `currentClassName_`
//     in CodeGen. The body's `match (self) { case Some(v) => Some(f(v)) }`
//     correctly unwraps the __Result payload as T, calls f, re-wraps in
//     Option<U>.
// ─────────────────────────────────────────────────────────────────────
fn option_demo() -> i64 {
    let some_val: Option<i64> = Some(7);
    let mapped = some_val.map::<i64>(dbl);   // Some(14)
    match (mapped) {
        case Some(v) => { return v; }        // 14
        default => { return -1; }
    }
}

// ─────────────────────────────────────────────────────────────────────
// 11. Nested generics — Vec<Vec<T>>  (a3_03)
// ─────────────────────────────────────────────────────────────────────
fn nested_vec() -> i64 {
    let outer = Vec::<Vec<i32>>.new();
    return outer.len;
}

// ─────────────────────────────────────────────────────────────────────
// 12. Dict<string, i64>.keys() returns Vec<string> — transitive Mono cascade
//     The keys() body type-references Vec<K=string>; Mono's scanForRequests
//     enqueues Vec<string> automatically once the string-mangling alignment
//     (commit 7b4a98c) lets canonical names line up across CodeGen/Mono.
// ─────────────────────────────────────────────────────────────────────
fn dict_keys_demo() -> i64 {
    var d = Dict::<string, i64>.new();
    d.put("a", 1);
    d.put("b", 2);
    d.put("c", 3);
    let ks = d.keys();
    return ks.len;                   // 3
}

// ─────────────────────────────────────────────────────────────────────
// Driver — every section returns 0 on success
// ─────────────────────────────────────────────────────────────────────
fn main() -> i32 {
    let b = Buffer::<i32, 16>.make();
    if (b.size != 16) { return 1; }

    if (capacity::<i64, 8>() != 8) { return 2; }

    let x: i32 = 42;
    if (type_label::<i32>(x) != "i32") { return 3; }

    if (sum_all(1, 2, 3, 4, 5) != 15) { return 4; }
    if (prod_all() != 1) { return 41; }
    if (prod_all(3, 4) != 12) { return 42; }
    if (!all_of(true, true, true)) { return 43; }
    if (all_of(true, false)) { return 44; }

    let d = Dog {};
    if (describe::<Dog>(d) != "dog") { return 5; }

    let e = En {};
    if (e.hello() != "hello world") { return 6; }

    if (vec_pipeline() != 20) { return 8; }
    if (dict_lookup() != 199) { return 9; }
    if (option_demo() != 14) { return 10; }
    if (nested_vec() != 0) { return 11; }
    if (dict_keys_demo() != 3) { return 12; }

    return 0;
}
