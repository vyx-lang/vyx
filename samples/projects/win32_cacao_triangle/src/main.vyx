module sample.win32_cacao_triangle;

use std.win32;
use std.cacao;
use std.collections;

extern "C" {
    fn malloc(size: u64) -> rawptr;
    fn free(p: rawptr);
    fn memcpy(d: rawptr, s: rawptr, n: u64) -> rawptr;
    fn memset(d: rawptr, v: i32, n: u64) -> rawptr;
    fn PeekMessageA(lpMsg: rawptr, hWnd: rawptr, wMsgFilterMin: u32, wMsgFilterMax: u32, wRemoveMsg: u32) -> i32;
}

let WIN_W: i32 = 800;
let WIN_H: i32 = 600;
let PM_REMOVE: u32 = 1;
let WM_QUIT: u32 = 18;
let FRAME_INDEX: u32 = 0;

class Vertex {
    public x: f32;
    public y: f32;
    public r: f32;
    public g: f32;
    public b: f32;
}

class TriangleVertices {
    public v0: Vertex;
    public v1: Vertex;
    public v2: Vertex;
}

fn p_off(p: rawptr, off: i64) -> rawptr { return p + (off as i32); }

fn zalloc(n: i64) -> rawptr {
    let p = malloc(n as u64);
    if (p != null) { memset(p, 0, n as u64); }
    return p;
}

fn w_u32(p: rawptr, off: i64, v: u32) {
    var x: u32 = v;
    memcpy(p_off(p, off), to_rawptr(&x), 4);
}

fn w_i32(p: rawptr, off: i64, v: i32) {
    var x: i32 = v;
    memcpy(p_off(p, off), to_rawptr(&x), 4);
}

fn w_ptr(p: rawptr, off: i64, v: rawptr) {
    var x: rawptr = v;
    memcpy(p_off(p, off), to_rawptr(&x), 8);
}

fn r_u32(p: rawptr, off: i64) -> u32 {
    var x: u32 = 0;
    memcpy(to_rawptr(&x), p_off(p, off), 4);
    return x;
}

fn win_proc(hwnd: rawptr, msg: u32, wparam: u64, lparam: i64) -> rawptr {
    if (msg == WM_DESTROY) {
        PostQuitMessage(0);
        return null;
    }
    if (msg == WM_CLOSE) {
        DestroyWindow(hwnd);
        return null;
    }
    return DefWindowProcA(hwnd, msg, wparam, lparam);
}

fn make_window(hinstance: rawptr, title: string, w: i32, h: i32) -> rawptr {
    let class_name = "VyxCacaoTriangleCls";
    let wc = zalloc(80);
    w_u32(wc, 0, 80);
    w_u32(wc, 4, 0);
    w_ptr(wc, 8, win_proc as rawptr);
    w_i32(wc, 16, 0);
    w_i32(wc, 20, 0);
    w_ptr(wc, 24, hinstance);
    w_ptr(wc, 32, null);
    w_ptr(wc, 40, null);
    w_ptr(wc, 48, null);
    w_ptr(wc, 56, null);
    w_ptr(wc, 64, class_name.c_str());
    w_ptr(wc, 72, null);

    let atom = RegisterClassExA(wc);
    free(wc);
    if (atom == 0) { return null; }

    let hwnd = CreateWindowExA(
        0,
        class_name.c_str(),
        title.c_str(),
        WS_OVERLAPPEDWINDOW | WS_VISIBLE,
        100, 100, w, h,
        null, null, hinstance, null);
    if (hwnd == null) { return null; }
    ShowWindow(hwnd, SW_SHOW);
    UpdateWindow(hwnd);
    return hwnd;
}

fn pump_messages() -> bool {
    let msg = zalloc(48);
    var alive: bool = true;
    var done: bool = false;
    while (!done) {
        let r = PeekMessageA(msg, null, 0, 0, PM_REMOVE);
        if (r == 0) { done = true; }
        else {
            let m = r_u32(msg, 8);
            if (m == WM_QUIT) { alive = false; }
            TranslateMessage(msg);
            DispatchMessageA(msg);
        }
    }
    free(msg);
    return alive;
}

fn fail_window(hwnd: rawptr, code: i32) -> i32 {
    if (hwnd != null) { DestroyWindow(hwnd); }
    return code;
}

fn main() -> i32 {
    let hinstance = GetModuleHandleA(null);
    let hwnd = make_window(hinstance, "Vyx Cacao Triangle", WIN_W, WIN_H);
    if (hwnd == null) { return 1; }
    pump_messages();

    let instance_desc = InstanceDesc.create(backend_vulkan(), "VyxCacaoTriangle", 1).addFeature(instance_feature_validation_layer()).addFeature(instance_feature_surface());
    var instance: Instance;
    match (Instance.create(instance_desc)) {
        case Ok(v) => { instance = v; }
        case Err(_) => { return fail_window(hwnd, 2); }
    }
    var adapter: Adapter;
    match (instance.firstAdapter()) {
        case Ok(v) => { adapter = v; }
        case Err(_) => { instance.destroy(); return fail_window(hwnd, 3); }
    }
    var surface: Surface;
    match (instance.createSurface(Win32WindowHandle.create(hwnd as u64, hinstance as u64))) {
        case Ok(v) => { surface = v; }
        case Err(_) => { adapter.destroy(); instance.destroy(); return fail_window(hwnd, 4); }
    }
    var device: Device;
    match (adapter.createDevice(DeviceDesc.forSurface(&surface))) {
        case Ok(v) => { device = v; }
        case Err(_) => { surface.destroy(); adapter.destroy(); instance.destroy(); return fail_window(hwnd, 5); }
    }
    var graphics_queue: DeviceQueue;
    match (device.getQueue(queue_graphics(), 0)) {
        case Ok(v) => { graphics_queue = v; }
        case Err(_) => { device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return fail_window(hwnd, 6); }
    }

    var caps: SurfaceCapabilities;
    match (surface.capabilities(&adapter)) {
        case Ok(v) => { caps = v; }
        case Err(_) => { graphics_queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return fail_window(hwnd, 8); }
    }
    var image_count = caps.min_image_count + 1;
    if (caps.max_image_count != 0 && image_count > caps.max_image_count) { image_count = caps.max_image_count; }
    var swap_desc = SwapchainDesc.create(caps.current_extent.width, caps.current_extent.height, format_bgra8_unorm(), swapchain_usage_color_attachment());
    swap_desc = swap_desc.setPresentMode(present_mode_fifo());
    swap_desc = swap_desc.setMinImageCount(image_count);
    var swapchain: Swapchain;
    match (device.createSwapchain(&surface, swap_desc)) {
        case Ok(v) => { swapchain = v; }
        case Err(_) => { graphics_queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return fail_window(hwnd, 8); }
    }
    var sync: Synchronization;
    match (device.createSynchronization(1)) {
        case Ok(v) => { sync = v; }
        case Err(_) => { swapchain.destroy(); graphics_queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return fail_window(hwnd, 9); }
    }

    var cmd: CommandEncoder;
    match (device.createCommandEncoder(command_buffer_primary())) {
        case Ok(v) => { cmd = v; }
        case Err(_) => { sync.destroy(); swapchain.destroy(); graphics_queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return fail_window(hwnd, 10); }
    }

    let verts = TriangleVertices {
        v0: Vertex { x: 0.0, y: 0.5, r: 1.0, g: 0.0, b: 0.0 },
        v1: Vertex { x: -0.5, y: -0.5, r: 0.0, g: 1.0, b: 0.0 },
        v2: Vertex { x: 0.5, y: -0.5, r: 0.0, g: 0.0, b: 1.0 }
    };
    var vertex_buffer: Buffer;
    match (device.createBufferWithData(verts, buffer_usage_vertex(), memory_cpu_to_gpu(), "TriangleVB")) {
        case Ok(v) => { vertex_buffer = v; }
        case Err(_) => { cmd.destroy(); sync.destroy(); swapchain.destroy(); graphics_queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return fail_window(hwnd, 11); }
    }
    var compiler: ShaderCompiler;
    match (instance.createShaderCompiler()) {
        case Ok(v) => { compiler = v; }
        case Err(_) => { vertex_buffer.destroy(); cmd.destroy(); sync.destroy(); swapchain.destroy(); graphics_queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return fail_window(hwnd, 12); }
    }
    match (compiler.setCacheDirectory("shader_cache_triangle_vyx")) {
        case Ok(_) => {}
        case Err(_) => { compiler.destroy(); vertex_buffer.destroy(); cmd.destroy(); sync.destroy(); swapchain.destroy(); graphics_queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return fail_window(hwnd, 13); }
    }

    let shader_path = "E:/Dev/C++/Cacao/demos/hello_triangle.slang";
    var vertex_shader: ShaderModule;
    match (compiler.compileOrLoad(&device, ShaderDesc { source_path: shader_path, entry_point: "mainVS", stage: shader_stage_vertex(), profile: "" })) {
        case Ok(v) => { vertex_shader = v; }
        case Err(_) => { compiler.destroy(); vertex_buffer.destroy(); cmd.destroy(); sync.destroy(); swapchain.destroy(); graphics_queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return fail_window(hwnd, 14); }
    }
    var fragment_shader: ShaderModule;
    match (compiler.compileOrLoad(&device, ShaderDesc { source_path: shader_path, entry_point: "mainPS", stage: shader_stage_fragment(), profile: "" })) {
        case Ok(v) => { fragment_shader = v; }
        case Err(_) => { vertex_shader.destroy(); compiler.destroy(); vertex_buffer.destroy(); cmd.destroy(); sync.destroy(); swapchain.destroy(); graphics_queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return fail_window(hwnd, 15); }
    }
    var pipeline_layout: PipelineLayout;
    match (device.createPipelineLayout(PipelineLayoutDesc.empty())) {
        case Ok(v) => { pipeline_layout = v; }
        case Err(_) => { fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); vertex_buffer.destroy(); cmd.destroy(); sync.destroy(); swapchain.destroy(); graphics_queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy(); return fail_window(hwnd, 16); }
    }

    var swap_format: u32 = format_bgra8_unorm();
    match (swapchain.format()) {
        case Ok(v) => { if (v <= 66) { swap_format = v; } }
        case Err(_) => {}
    }
    var pipeline_desc = GraphicsPipelineDesc.create(&pipeline_layout);
    pipeline_desc = pipeline_desc.addShader(&vertex_shader);
    pipeline_desc = pipeline_desc.addShader(&fragment_shader);
    pipeline_desc = pipeline_desc.addVertexBinding(0, sizeof::<Vertex>() as u32);
    pipeline_desc = pipeline_desc.addVertexAttribute(0, 0, format_rg32_float(), 0, "POSITION", 0);
    pipeline_desc = pipeline_desc.addVertexAttribute(1, 0, format_rgb32_float(), 8, "COLOR", 0);
    pipeline_desc = pipeline_desc.setCullMode(cull_none());
    pipeline_desc = pipeline_desc.addColorAttachmentDefault();
    pipeline_desc = pipeline_desc.addColorFormat(swap_format);

    var pipeline: GraphicsPipeline;
    match (device.createGraphicsPipeline(pipeline_desc)) {
        case Ok(v) => { pipeline = v; }
        case Err(e) => {
            print("createGraphicsPipeline: " + e.message);
            pipeline_layout.destroy(); fragment_shader.destroy(); vertex_shader.destroy(); compiler.destroy(); vertex_buffer.destroy(); cmd.destroy(); sync.destroy(); swapchain.destroy(); graphics_queue.destroy(); device.destroy(); surface.destroy(); adapter.destroy(); instance.destroy();
            return fail_window(hwnd, 17);
        }
    }

    match (sync.waitForFrame(FRAME_INDEX)) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 18); } }
    var image_index: u32 = 0;
    match (swapchain.acquireNextImage(&sync, FRAME_INDEX)) {
        case Ok(v) => { image_index = v; }
        case Err(_) => { return fail_window(hwnd, 19); }
    }
    match (sync.resetFrameFence(FRAME_INDEX)) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 20); } }

    var back_buffer: Texture;
    match (swapchain.backBuffer(image_index)) {
        case Ok(v) => { back_buffer = v; }
        case Err(_) => { return fail_window(hwnd, 21); }
    }

    match (cmd.reset()) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 22); } }
    match (cmd.begin(true, false)) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 23); } }
    match (cmd.transitionImage(&back_buffer, image_transition_undefined_to_color_attachment())) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 24); } }

    var render_extent: Extent2D;
    match (swapchain.extent()) {
        case Ok(v) => { render_extent = v; }
        case Err(_) => { return fail_window(hwnd, 25); }
    }
    var render_info = RenderingInfo.create(Rect2D.create(0, 0, render_extent.width, render_extent.height));
    render_info = render_info.addColorAttachment(RenderingAttachmentInfo.color(&back_buffer, 0.1, 0.1, 0.12, 1.0));
    match (cmd.beginRendering(&render_info)) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 25); } }
    match (cmd.setViewport(0.0, 0.0, render_extent.width as f32, render_extent.height as f32, 0.0, 1.0)) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 26); } }
    match (cmd.setScissor(Rect2D.create(0, 0, render_extent.width, render_extent.height))) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 27); } }
    match (cmd.bindGraphicsPipeline(&pipeline)) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 28); } }
    match (cmd.bindVertexBuffer(0, &vertex_buffer, 0)) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 29); } }
    match (cmd.draw(3, 1, 0, 0)) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 30); } }
    match (cmd.endRendering()) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 31); } }
    match (cmd.transitionImage(&back_buffer, image_transition_color_attachment_to_present())) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 32); } }
    match (cmd.end()) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 33); } }

    match (graphics_queue.submit(&cmd, &sync, FRAME_INDEX)) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 34); } }
    match (swapchain.present(&graphics_queue, &sync, FRAME_INDEX)) { case Ok(_) => {} case Err(_) => { return fail_window(hwnd, 35); } }
    match (graphics_queue.waitIdle()) { case Ok(_) => {} case Err(_) => {} }

    back_buffer.destroy();
    pipeline.destroy();
    pipeline_layout.destroy();
    fragment_shader.destroy();
    vertex_shader.destroy();
    compiler.destroy();
    vertex_buffer.destroy();
    cmd.destroy();
    sync.destroy();
    swapchain.destroy();
    graphics_queue.destroy();
    device.destroy();
    surface.destroy();
    adapter.destroy();
    instance.destroy();
    DestroyWindow(hwnd);
    return 0;
}
