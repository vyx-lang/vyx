@[dci_import("../dci/cacao-cpp-bridge.dcib")]
extern "C" {
    fn malloc(size: i64) -> rawptr;
    fn free(ptr: rawptr);
}

extern "dci" {
    fn cacao_dci_bridge_abi_version() -> u32;
    class cacao_dci.TriangleApp {
        TriangleApp(width: u32, height: u32);
        ~TriangleApp();
        public fn ready() const -> bool;
        public fn draw_frame() -> i32;
        public fn run_frames(frame_count: u32) -> i32;
        public fn run() -> i32;
        public fn close();
    };
}

fn smoke_mode() -> bool {
    let count = argCount();
    var index: i32 = 1;
    while (index < count) {
        if (getArg(index) == "--smoke") { return true; }
        index = index + 1;
    }
    return false;
}

fn main() -> i32 {
    if (cacao_dci_bridge_abi_version() != 1) { return 1; }
    var app = cacao_dci.TriangleApp(800, 600);
    if (!app.ready()) { return 2; }
    if (smoke_mode()) {
        if (app.run_frames(120) != 0) { return 3; }
        print("cacao C++ DCI triangle OK");
        return 0;
    }
    return app.run();
}
