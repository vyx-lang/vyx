use SystemTheme = Zyn.Platform.Platform.SystemTheme;
use SystemCursorKind = Zyn.Platform.Input.SystemCursorKind;
use Touch = Zyn.Platform.Input.Touch;
use Window = Zyn.Platform.Window.Window;
use WindowDesc = Zyn.Platform.Window.WindowDesc;
use WindowFlags = Zyn.Platform.Window.WindowFlags;

fn fail_window(window: Window, code: i32) -> i32 {
    window.destroy();
    Platform.quit();
    return code;
}

fn check_window_basics(window: Window) -> i32 {
    if (!window.isValid()) { return 3; }

    if (window.id() == 0 as u32) { return 4; }

    match (window.size()) {
        case Ok(sz) => {
            if (sz.width <= 0 || sz.height <= 0) { return 5; }
        }
        case Err(_) => { return 6; }
    }

    match (window.pixelSize()) {
        case Ok(sz) => {
            if (sz.width <= 0 || sz.height <= 0) { return 7; }
        }
        case Err(_) => { return 8; }
    }

    match (window.setTitle("Zyn SDL3 platform smoke updated")) {
        case Ok(_) => {}
        case Err(_) => { return 9; }
    }

    match (window.setSize(360, 260)) {
        case Ok(_) => {}
        case Err(_) => { return 10; }
    }

    match (window.setPosition(32, 32)) {
        case Ok(_) => {}
        case Err(_) => { return 22; }
    }

    match (window.position()) {
        case Ok(pos) => {
            if (pos.x < -32768 || pos.y < -32768) { return 23; }
        }
        case Err(_) => { return 24; }
    }

    match (window.setFullscreen(false)) {
        case Ok(_) => {}
        case Err(_) => { return 25; }
    }

    match (window.raise()) {
        case Ok(_) => {}
        case Err(_) => { return 125; }
    }

    match (window.restore()) {
        case Ok(_) => {}
        case Err(_) => { return 126; }
    }

    match (window.setMinimumSize(160, 120)) {
        case Ok(_) => {}
        case Err(_) => { return 60; }
    }

    match (window.setMaximumSize(1920, 1080)) {
        case Ok(_) => {}
        case Err(_) => { return 61; }
    }

    if (window.displayScale() <= 0.0) { return 62; }
    let display_id = window.displayId();
    if (display_id == 0 as u32) { return 63; }
    let display = Display.fromId(display_id);
    if (display.id != display_id) { return 64; }
    if (display.contentScale() <= 0.0) { return 164; }

    let native = window.nativeHandle();
    if (native.hwnd == 0 as u64 && native.hinstance != 0 as u64) { return 127; }
    if (native.hwnd != 0 as u64 && native.hinstance == 0 as u64) { return 128; }

    let primary = Display.primary();
    if (primary.id == 0 as u32) { return 66; }
    let display_count = Display.count();
    if (display_count <= 0) { return 165; }
    match (Display.at(0)) {
        case Some(first_display) => {
            if (first_display.id == 0 as u32) { return 166; }
        }
        case None => { return 167; }
    }

    match (primary.bounds()) {
        case Ok(bounds) => {
            if (bounds.width <= 0 || bounds.height <= 0) { return 70; }
        }
        case Err(_) => { return 71; }
    }

    match (primary.usableBounds()) {
        case Ok(bounds) => {
            if (bounds.width <= 0 || bounds.height <= 0) { return 72; }
        }
        case Err(_) => { return 73; }
    }

    match (window.safeArea()) {
        case Ok(area) => {
            if (area.width <= 0 || area.height <= 0) { return 168; }
        }
        case Err(_) => { return 169; }
    }

    let flags = window.flags();
    if (!flags.has(WindowFlags.hidden())) { return 26; }

    match (window.show()) {
        case Ok(_) => {}
        case Err(_) => { return 27; }
    }

    match (window.hide()) {
        case Ok(_) => {}
        case Err(_) => { return 28; }
    }

    match (window.setRelativeMouseMode(false)) {
        case Ok(_) => {}
        case Err(_) => { return 29; }
    }
    if (window.relativeMouseMode()) { return 30; }

    match (window.clearComposition()) {
        case Ok(_) => {}
        case Err(_) => { return 31; }
    }

    return 0;
}

fn check_events(window: Window) -> i32 {
    EventLoop.pump();

    let empty = Event.empty();
    if (empty.raw_type != 0 as u32) { return 32; }
    if (empty.isQuit()) { return 33; }
    if (empty.isWindowCloseRequested()) { return 34; }
    if (empty.isWindowResized()) { return 35; }
    if (empty.isGamepad()) { return 117; }
    if (empty.isTouch()) { return 118; }
    if (empty.isLifecycle()) { return 170; }
    if (empty.isDisplay()) { return 171; }
    if (empty.isClipboard()) { return 172; }
    if (empty.isDrop()) { return 173; }
    if (empty.isRenderDevice()) { return 174; }
    if (empty.isBackgroundTransition()) { return 175; }
    if (empty.isForegroundTransition()) { return 176; }
    if (empty.gamepad_id != 0 as u32) { return 119; }
    if (empty.gamepad_axis_value != 0) { return 120; }
    if (empty.gamepad_button_down) { return 121; }
    if (empty.touch_id != 0 as u64) { return 122; }
    if (empty.finger_id != 0 as u64) { return 123; }
    if (empty.pressure != 0.0) { return 124; }
    if (empty.display_id != 0 as u32 || empty.drop_source.len != 0 || empty.drop_data.len != 0 || empty.clipboard_owned || empty.mime_type_count != 0) { return 177; }

    if (EventKind.quit().value == 0 as u32) { return 36; }
    if (EventKind.lifecycle().value == 0 as u32) { return 178; }
    if (EventKind.display().value == 0 as u32) { return 179; }
    if (EventKind.clipboard().value != 0x900 as u32) { return 180; }
    if (EventKind.dropEvent().value != 0x1002 as u32) { return 181; }
    if (EventKind.renderDevice().value != 0x2000 as u32) { return 182; }
    if (EventKind.keyDown().value == 0 as u32) { return 37; }
    if (EventKind.keyUp().value == 0 as u32) { return 38; }
    if (EventKind.textInput().value == 0 as u32) { return 39; }
    if (EventKind.textEditing().value == 0 as u32) { return 40; }
    if (EventKind.mouseMotion().value == 0 as u32) { return 41; }
    if (EventKind.mouseButtonDown().value == 0 as u32) { return 42; }
    if (EventKind.mouseButtonUp().value == 0 as u32) { return 43; }
    if (EventKind.mouseWheel().value == 0 as u32) { return 44; }
    if (EventKind.gamepadAxisMotion().value != 0x650 as u32) { return 109; }
    if (EventKind.gamepadAdded().value != 0x653 as u32) { return 110; }
    if (EventKind.fingerDown().value != 0x700 as u32) { return 111; }
    if (EventKind.fingerCanceled().value != 0x703 as u32) { return 112; }
    if (EventKind.gamepadButtonDown().value != 0x651 as u32) { return 129; }
    if (EventKind.gamepadButtonUp().value != 0x652 as u32) { return 130; }
    if (EventKind.gamepadRemoved().value != 0x654 as u32) { return 131; }
    if (EventKind.fingerUp().value != 0x701 as u32) { return 132; }
    if (EventKind.fingerMotion().value != 0x702 as u32) { return 133; }
    if (LifecycleEventKind.terminating() != 0x101 as u32) { return 183; }
    if (LifecycleEventKind.lowMemory() != 0x102 as u32) { return 184; }
    if (LifecycleEventKind.willEnterBackground() != 0x103 as u32) { return 185; }
    if (LifecycleEventKind.didEnterForeground() != 0x106 as u32) { return 186; }
    if (LifecycleEventKind.systemThemeChanged() != 0x108 as u32) { return 187; }
    if (DisplayEventKind.orientation() != 0x151 as u32) { return 188; }
    if (DisplayEventKind.usableBoundsChanged() != 0x158 as u32) { return 189; }
    if (DropEventKind.file() != 0x1000 as u32) { return 190; }
    if (DropEventKind.position() != 0x1004 as u32) { return 191; }
    if (RenderDeviceEventKind.targetsReset() != 0x2000 as u32) { return 192; }
    if (RenderDeviceEventKind.deviceLost() != 0x2002 as u32) { return 193; }

    let maybe_event = EventLoop.poll();
    match (maybe_event) {
        case Some(ev) => {
            if (ev.raw_type == 0 as u32) { return 11; }
        }
        case None => {}
    }

    let maybe_wait = EventLoop.waitTimeout(0);
    match (maybe_wait) {
        case Some(ev) => {
            if (ev.raw_type == 0 as u32) { return 45; }
        }
        case None => {}
    }

    return 0;
}

fn check_input() -> i32 {
    let mouse = InputState.mouse();
    if (mouse.buttons > 4294967295 as u32) { return 12; }
    if (mouse.hasButton(0 as u32)) { return 46; }

    let global_mouse = InputState.globalMouse();
    if (global_mouse.buttons > 4294967295 as u32) { return 47; }

    let relative_mouse = InputState.relativeMouse();
    if (relative_mouse.buttons > 4294967295 as u32) { return 48; }

    let keyboard = InputState.keyboard();
    if (keyboard.hasModifier(KeyModifier.none())) { return 49; }
    if (keyboard.isScancodeDown(-1)) { return 67; }
    if (InputState.isScancodeDown(-1)) { return 68; }

    if (MouseButton.mask(MouseButton.left()) == 0 as u32) { return 69; }
    if (MouseButton.mask(MouseButton.middle()) != 2 as u32) { return 134; }
    if (MouseButton.mask(MouseButton.right()) != 4 as u32) { return 135; }
    if (MouseButton.mask(MouseButton.x1()) != 8 as u32) { return 136; }
    if (MouseButton.mask(MouseButton.x2()) != 16 as u32) { return 137; }

    if (KeyModifier.shift() != (KeyModifier.leftShift() | KeyModifier.rightShift())) { return 138; }
    if (KeyModifier.ctrl() != (KeyModifier.leftCtrl() | KeyModifier.rightCtrl())) { return 139; }
    if (KeyModifier.alt() != (KeyModifier.leftAlt() | KeyModifier.rightAlt())) { return 140; }

    let key_name = InputState.keyName(13);
    if (key_name.len == 0) { return 13; }

    if (!InputState.captureMouse(false)) { return 50; }
    if (!InputState.showCursor()) { return 51; }
    if (!InputState.cursorVisible()) { return 52; }
    if (!InputState.hideCursor()) { return 53; }
    if (InputState.cursorVisible()) { return 54; }
    if (!InputState.showCursor()) { return 55; }

    var cursor: Cursor;
    match (Cursor.fromSystem(SystemCursorKind.pointer())) {
        case Ok(v) => { cursor = v; }
        case Err(_) => { return 113; }
    }
    if (!cursor.isValid()) { cursor.destroy(); return 114; }
    match (cursor.set()) {
        case Ok(_) => {}
        case Err(_) => { cursor.destroy(); return 115; }
    }
    cursor.destroy();
    cursor.destroy();

    if (SystemCursorKind.defaultCursor() != 0) { return 141; }
    if (SystemCursorKind.text() != 1) { return 142; }
    if (SystemCursorKind.wait() != 2) { return 143; }
    if (SystemCursorKind.notAllowed() != 10) { return 144; }

    return 0;
}

fn check_clock() -> i32 {
    let t0 = Clock.ticksNS();
    Clock.delay(1 as u32);
    let t1 = Clock.ticksNS();
    if (t1 < t0) { return 14; }

    if (Clock.performanceFrequency() == 0 as u64) { return 15; }
    if (Clock.performanceCounter() == 0 as u64) { return 56; }
    if (Clock.ticks() == 0 as u64) { return 57; }

    var frame_clock = FrameClock.start();
    Clock.delay(1 as u32);
    frame_clock = frame_clock.tick();
    if (frame_clock.frameIndex() != 1 as u64) { return 76; }
    if (frame_clock.deltaNS() == 0 as u64) { return 77; }
    if (frame_clock.deltaSeconds() <= 0.0) { return 78; }

    var scheduler = FrameScheduler.create(240);
    scheduler = scheduler.beginFrame();
    if (scheduler.frameIndex() != 1 as u64) { return 79; }
    scheduler = scheduler.sleepUntilNextFrame();
    if (scheduler.frameIndex() != 1 as u64) { return 145; }

    var fallback_scheduler = FrameScheduler.create(0);
    fallback_scheduler = fallback_scheduler.beginFrame();
    if (fallback_scheduler.frameIndex() != 1 as u64) { return 146; }

    return 0;
}

fn check_ime(window: Window) -> i32 {
    match (window.startTextInput()) {
        case Ok(_) => {}
        case Err(_) => { return 16; }
    }
    if (!window.textInputActive()) { return 17; }
    match (window.setTextInputArea(Rect.create(0, 0, 120, 24), 0)) {
        case Ok(_) => {}
        case Err(_) => { return 18; }
    }
    match (window.textInputArea()) {
        case Ok(area) => {
            if (area.width < 0 || area.height < 0) { return 147; }
        }
        case Err(_) => { return 148; }
    }
    match (window.clearComposition()) {
        case Ok(_) => {}
        case Err(_) => { return 58; }
    }
    match (window.stopTextInput()) {
        case Ok(_) => {}
        case Err(_) => { return 19; }
    }
    return 0;
}

fn check_clipboard() -> i32 {
    match (Clipboard.setText("zyn-sdl3-smoke")) {
        case Ok(_) => {
            if (!Clipboard.hasText()) { return 20; }
            let text = Clipboard.getText();
            if (text != "zyn-sdl3-smoke") { return 21; }
        }
        case Err(_) => {}
    }
    return 0;
}

fn check_app_paths() -> i32 {
    let base = AppPaths.basePath();
    if (base.len == 0) { return 74; }

    let pref = AppPaths.prefPath("vyx", "zyn_platform_smoke");
    if (pref.len == 0) { return 75; }

    return 0;
}

fn check_filesystem() -> i32 {
    let pref = AppPaths.prefPath("vyx", "zyn_platform_smoke");
    let path_a = FileSystem.joinPath(pref, "platform_fs_smoke.txt");
    let path_b = FileSystem.joinPath(pref, "platform_fs_smoke_renamed.txt");

    if (FileSystem.exists(path_a)) {
        match (FileSystem.remove(path_a)) { case Ok(_) => {} case Err(_) => { return 80; } }
    }
    if (FileSystem.exists(path_b)) {
        match (FileSystem.remove(path_b)) { case Ok(_) => {} case Err(_) => { return 81; } }
    }

    match (FileSystem.writeText(path_a, "zyn-fs")) {
        case Ok(_) => {}
        case Err(_) => { return 82; }
    }
    if (!FileSystem.exists(path_a)) { return 83; }
    if (!FileSystem.isFile(path_a)) { return 84; }
    if (FileSystem.isDir(path_a)) { return 149; }
    if (!FileSystem.isDir(pref)) { return 150; }
    match (FileSystem.size(path_a)) {
        case Ok(n) => { if (n != 6) { return 85; } }
        case Err(_) => { return 86; }
    }
    match (FileSystem.appendText(path_a, "-ok")) {
        case Ok(_) => {}
        case Err(_) => { return 87; }
    }
    match (FileSystem.readText(path_a)) {
        case Ok(text) => { if (text != "zyn-fs-ok") { return 88; } }
        case Err(_) => { return 89; }
    }
    match (FileSystem.rename(path_a, path_b)) {
        case Ok(_) => {}
        case Err(_) => { return 90; }
    }
    if (FileSystem.exists(path_a)) { return 91; }
    if (!FileSystem.exists(path_b)) { return 92; }
    match (FileSystem.remove(path_b)) {
        case Ok(_) => {}
        case Err(_) => { return 93; }
    }
    if (FileSystem.exists(path_b)) { return 94; }

    let normalized = FileSystem.normalizePath("a\\b\\c.txt");
    if (normalized != "a/b/c.txt") { return 95; }

    return 0;
}

fn check_gamepad_touch() -> i32 {
    match (Gamepad.init()) {
        case Ok(_) => {
            Gamepad.update();
            let count = Gamepad.count();
            if (count < 0) { return 96; }
            if (count > 0) {
                let id = Gamepad.idAt(0);
                if (id == 0 as u32) { return 97; }
                match (Gamepad.infoAt(0)) {
                    case Some(info) => {
                        if (info.id != id) { return 98; }
                        if (info.type_id < 0) { return 99; }
                    }
                    case None => { return 100; }
                }
                match (Gamepad.open(id)) {
                    case Ok(gamepad) => {
                        if (!gamepad.isValid()) { gamepad.close(); return 151; }
                        if (gamepad.id() != id) { gamepad.close(); return 152; }
                        if (!gamepad.connected()) { gamepad.close(); return 153; }
                        if (gamepad.name().len == 0) { gamepad.close(); return 154; }
                        let axis_value = gamepad.axis(GamepadAxis.leftX());
                        if ((axis_value as i32) < -32768 || (axis_value as i32) > 32767) { gamepad.close(); return 155; }
                        gamepad.button(GamepadButton.south());
                        gamepad.close();
                        gamepad.close();
                    }
                    case Err(e2) => {
                        if (e2.message.len == 0) { return 156; }
                    }
                }
            }
        }
        case Err(e) => {
            if (e.message.len == 0) { return 108; }
        }
    }

    let touch_count = Touch.count();
    if (touch_count < 0) { return 101; }
    if (touch_count > 0) {
        let tid = Touch.idAt(0);
        if (tid == 0 as u64) { return 102; }
        match (Touch.infoAt(0)) {
            case Some(info) => {
                if (info.id != tid) { return 103; }
                if (info.type_id < 0) { return 104; }
            }
            case None => { return 105; }
        }
    }

    if (GamepadButton.south() != 0) { return 106; }
    if (GamepadButton.east() != 1) { return 157; }
    if (GamepadButton.dpadRight() != 14) { return 158; }
    if (GamepadAxis.leftX() != 0) { return 159; }
    if (GamepadAxis.rightTrigger() != 5) { return 107; }

    return 0;
}

fn main() -> i32 {
    if (PlatformInit.videoEvents() != (PlatformInit.video() | PlatformInit.events())) { return 160; }
    if (PlatformInit.app() != (PlatformInit.videoEvents() | PlatformInit.gamepad())) { return 161; }
    if (MessageBoxFlags.errorBox() == MessageBoxFlags.warning()) { return 162; }
    if (MessageBoxFlags.information() == 0 as u32) { return 163; }
    if (SystemTheme.unknown() != 0 || SystemTheme.light() != 1 || SystemTheme.dark() != 2) { return 194; }

    match (Platform.setMetadata("Zyn Platform Smoke", "0.1.0", "dev.vyx.zyn.platform_smoke")) {
        case Ok(_) => {}
        case Err(_) => { return 116; }
    }

    match (Platform.init()) {
        case Ok(_) => {}
        case Err(_) => { return 1; }
    }

    Platform.clearError();
    let initial_error = Platform.lastError();
    if (initial_error.len > 0) {
        Platform.quit();
        return 59;
    }

    let info = PlatformInfo.current();
    if (info.name.len == 0 || info.cpu_count <= 0 || info.ram_mb <= 0 || info.page_size <= 0) {
        Platform.quit();
        return 195;
    }
    if (info.system_theme != SystemTheme.unknown() && info.system_theme != SystemTheme.light() && info.system_theme != SystemTheme.dark()) {
        Platform.quit();
        return 196;
    }

    let desc = WindowDesc.create("Zyn SDL3 platform smoke", 320, 240)
        .hidden()
        .resizable()
        .highPixelDensity();

    var window: Window;
    match (Window.create(desc)) {
        case Ok(v) => { window = v; }
        case Err(_) => { Platform.quit(); return 2; }
    }

    let window_code = check_window_basics(window);
    if (window_code != 0) { return fail_window(window, window_code); }

    let event_code = check_events(window);
    if (event_code != 0) { return fail_window(window, event_code); }

    let input_code = check_input();
    if (input_code != 0) { return fail_window(window, input_code); }

    let clock_code = check_clock();
    if (clock_code != 0) { return fail_window(window, clock_code); }

    let ime_code = check_ime(window);
    if (ime_code != 0) { return fail_window(window, ime_code); }

    let clipboard_code = check_clipboard();
    if (clipboard_code != 0) { return fail_window(window, clipboard_code); }

    let paths_code = check_app_paths();
    if (paths_code != 0) { return fail_window(window, paths_code); }

    let fs_code = check_filesystem();
    if (fs_code != 0) { return fail_window(window, fs_code); }

    let device_code = check_gamepad_touch();
    if (device_code != 0) { return fail_window(window, device_code); }

    window.destroy();
    window.destroy();
    Platform.quit();
    return 0;
}
